#!/usr/bin/env python3
"""
tools/pynytprofdiff
===================
PyNYTProf 差分プロファイル HTML レポート生成専用ランチャー。
使用例:
    ./tools/pynytprofdiff --before base.out --after test.out -d ./diff_report
"""

import os
import sys

workspace_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
src_dir = os.path.join(workspace_dir, "src")
for p in (src_dir, workspace_dir):
    if p not in sys.path:
        sys.path.insert(0, p)

from src.core.profiler.cli import main

if __name__ == "__main__":
    args = ["diff"] + sys.argv[1:]
    sys.exit(main(args))
