# Arithmetic Calculator Grammar
# CPython PEG (PEP 617 / python.gram) compliant syntax
grammar Calc

expr:
    | ws left=term rest=(op=add_op right=term)* {
        val = left
        for o, r in rest:
            val = val + r if o == "+" else val - r
        return val
    }

term:
    | ws left=factor rest=(op=mul_op right=factor)* {
        val = left
        for o, r in rest:
            val = val * r if o == "*" else val // r
        return val
    }

factor:
    | "(" ws e=expr ")" ws { return e }
    | n=number { return n }

number:
    | raw=[0-9]+ ws { return int("".join(raw)) }

add_op:
    | op=[+-] ws { return op }

mul_op:
    | op=[*/] ws { return op }

ws:
    | [ \t\r\n]*
