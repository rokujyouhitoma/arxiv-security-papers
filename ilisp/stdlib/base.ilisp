;;; ILISP (Intelligence LISP) Standard Library - Base Module
;;; (scheme base) subset and core syntax macros adhering to R7RS-small.

;;; -------------------------------------------------------------
;;; 1. Core Control Syntax Macros
;;; -------------------------------------------------------------

;; when: (when test expr ...)
(define-macro (when test . body)
  (cons 'if
        (cons test
              (cons (cons 'begin body)
                    '()))))

;; unless: (unless test expr ...)
(define-macro (unless test . body)
  (cons 'if
        (cons test
              (cons '()
                    (cons (cons 'begin body)
                          '())))))

;; Helper functions for let macro expansion
(define (_ilisp_extract_vars bindings)
  (if (null? bindings)
      '()
      (cons (car (car bindings))
            (_ilisp_extract_vars (cdr bindings)))))

(define (_ilisp_extract_vals bindings)
  (if (null? bindings)
      '()
      (cons (car (cdr (car bindings)))
            (_ilisp_extract_vals (cdr bindings)))))

;; let: (let ((var val) ...) body ...) or Named let: (let name ((var val) ...) body ...)
(define-macro (let arg1 . rest)
  (if (symbol? arg1)
      ;; Named let: (let name ((var val) ...) body ...)
      (cons 'letrec
            (cons (cons (cons arg1
                              (cons (cons 'lambda (cons (_ilisp_extract_vars (car rest)) (cdr rest)))
                                    '()))
                        '())
                  (cons (cons arg1 (_ilisp_extract_vals (car rest)))
                        '())))
      ;; Standard let: (let ((var val) ...) body ...)
      (cons (cons 'lambda
                  (cons (_ilisp_extract_vars arg1)
                        rest))
            (_ilisp_extract_vals arg1))))

;; let*: (let* ((var val) ...) body ...)
(define-macro (let* bindings . body)
  (if (null? bindings)
      (cons 'begin body)
      (cons 'let
            (cons (cons (car bindings) '())
                  (cons (cons 'let* (cons (cdr bindings) body))
                        '())))))

;; Helpers for letrec and letrec*
(define (_ilisp_make_undef_bindings bindings)
  (if (null? bindings)
      '()
      (cons (cons (car (car bindings)) (cons ''() '()))
            (_ilisp_make_undef_bindings (cdr bindings)))))

(define (_ilisp_make_set_list bindings)
  (if (null? bindings)
      '()
      (cons (cons 'set! (cons (car (car bindings)) (cdr (car bindings))))
            (_ilisp_make_set_list (cdr bindings)))))

;; letrec*: (letrec* ((var val) ...) body ...)
(define-macro (letrec* bindings . body)
  (if (null? bindings)
      (cons 'begin body)
      (cons 'let
            (cons (_ilisp_make_undef_bindings bindings)
                  (append (_ilisp_make_set_list bindings) body)))))

;; letrec: (letrec ((var val) ...) body ...)
(define-macro (letrec bindings . body)
  (if (null? bindings)
      (cons 'begin body)
      (cons 'letrec*
            (cons bindings body))))

;; Helpers for do iteration macro
(define (_ilisp_do_vars var_clauses)
  (if (null? var_clauses)
      '()
      (cons (car (car var_clauses))
            (_ilisp_do_vars (cdr var_clauses)))))

(define (_ilisp_do_inits var_clauses)
  (if (null? var_clauses)
      '()
      (cons (car (cdr (car var_clauses)))
            (_ilisp_do_inits (cdr var_clauses)))))

(define (_ilisp_do_steps var_clauses)
  (if (null? var_clauses)
      '()
      (cons (if (null? (cdr (cdr (car var_clauses))))
                (car (car var_clauses))
                (car (cdr (cdr (car var_clauses)))))
            (_ilisp_do_steps (cdr var_clauses)))))

;; do: (do ((<var> <init> [<step>]) ...) (<test> [<expr> ...]) <command> ...)
(define-macro (do var_clauses test_clause . commands)
  (cons 'letrec
        (cons (cons (cons '__do_loop
                          (cons (cons 'lambda
                                      (cons (_ilisp_do_vars var_clauses)
                                            (cons (cons 'if
                                                        (cons (car test_clause)
                                                              (cons (if (null? (cdr test_clause))
                                                                        ''()
                                                                        (cons 'begin (cdr test_clause)))
                                                                    (cons (cons 'begin
                                                                                (append commands
                                                                                        (cons (cons '__do_loop (_ilisp_do_steps var_clauses)) '())))
                                                                          '()))))
                                                  '())))
                                '()))
                    '())
              (cons (cons '__do_loop (_ilisp_do_inits var_clauses)) '()))))

;; cond: (cond (test expr ...) ... (else expr ...))
;; Supports R7RS 4.2.1 (test => recipient) and (test)
(define-macro (cond . clauses)
  (if (null? clauses)
      '()
      (let ((first_clause (car clauses))
            (rest_clauses (cdr clauses)))
        (let ((test_expr (car first_clause))
              (body_exprs (cdr first_clause)))
          (if (eq? test_expr 'else)
              (if (and (pair? body_exprs) (eq? (car body_exprs) '=>))
                  (cons (car (cdr body_exprs)) '())
                  (cons 'begin body_exprs))
              (if (null? body_exprs)
                  (let ((t_var '__cond_test))
                    (cons 'let
                          (cons (cons (cons t_var (cons test_expr '())) '())
                                (cons (cons 'if
                                            (cons t_var
                                                  (cons t_var
                                                        (cons (cons 'cond rest_clauses)
                                                              '()))))
                                      '()))))
                  (if (eq? (car body_exprs) '=>)
                      (let ((t_var '__cond_test))
                        (cons 'let
                              (cons (cons (cons t_var (cons test_expr '())) '())
                                    (cons (cons 'if
                                                (cons t_var
                                                      (cons (cons (car (cdr body_exprs)) (cons t_var '()))
                                                            (cons (cons 'cond rest_clauses)
                                                                  '()))))
                                          '()))))
                      (cons 'if
                            (cons test_expr
                                  (cons (cons 'begin body_exprs)
                                        (cons (cons 'cond rest_clauses)
                                              '())))))))))))

;; and: (and expr ...) short-circuit boolean AND
(define-macro (and . exprs)
  (if (null? exprs)
      #t
      (if (null? (cdr exprs))
          (car exprs)
          (cons 'if
                (cons (car exprs)
                      (cons (cons 'and (cdr exprs))
                            (cons #f '())))))))

;; or: (or expr ...) short-circuit boolean OR
(define-macro (or . exprs)
  (if (null? exprs)
      #f
      (if (null? (cdr exprs))
          (car exprs)
          (cons 'let
                (cons (cons (cons '__or_val (cons (car exprs) '())) '())
                      (cons (cons 'if
                                  (cons '__or_val
                                        (cons '__or_val
                                              (cons (cons 'or (cdr exprs))
                                                    '()))))
                            '()))))))

;; case: (case key ((val ...) expr ...) ... (else expr ...))
;; Supports R7RS 4.2.1 ((val ...) => recipient) and (else => recipient)
(define-macro (case key . clauses)
  (let ((k_var '__case_key))
    (define (_ilisp_expand_case cls)
      (if (null? cls)
          '()
          (let ((first_cl (car cls))
                (rest_cl (cdr cls)))
            (let ((datums (car first_cl))
                  (exprs (cdr first_cl)))
              (if (eq? datums 'else)
                  (if (and (pair? exprs) (eq? (car exprs) '=>))
                      (cons (car (cdr exprs)) (cons k_var '()))
                      (cons 'begin exprs))
                  (let ((action (if (and (pair? exprs) (eq? (car exprs) '=>))
                                    (cons (car (cdr exprs)) (cons k_var '()))
                                    (cons 'begin exprs))))
                    (cons 'if
                          (cons (cons 'member (cons k_var (cons (cons 'quote (cons datums '())) '())))
                                (cons action
                                      (cons (_ilisp_expand_case rest_cl) '()))))))))))
    (cons 'let
          (cons (cons (cons k_var (cons key '())) '())
                (cons (_ilisp_expand_case clauses) '())))))

;; guard: (guard (var (test expr ...) ...) body ...)
(define-macro (guard spec . body)
  (let ((var (car spec))
        (clauses (cdr spec)))
    (cons 'call/cc
          (cons (cons 'lambda
                      (cons (cons '__guard_exit '())
                            (cons (cons 'with-exception-handler
                                        (cons (cons 'lambda
                                                    (cons (cons var '())
                                                          (cons (cons '__guard_exit
                                                                      (cons (cons 'cond clauses) '()))
                                                                '())))
                                              (cons (cons 'lambda
                                                          (cons '()
                                                                body))
                                                    '())))
                                  '())))
                '()))))

;; let-values: (let-values (((var ...) expr) ...) body ...)
(define-macro (let-values bindings . body)
  (if (null? bindings)
      (cons 'begin body)
      (let ((first_b (car bindings))
            (rest_b (cdr bindings)))
        (let ((vars (car first_b))
              (producer_expr (car (cdr first_b))))
          (cons 'call-with-values
                (cons (cons 'lambda (cons '() (cons producer_expr '())))
                      (cons (cons 'lambda
                                  (cons vars
                                        (cons (cons 'let-values (cons rest_b body))
                                              '())))
                            '())))))))

;; let*-values: (let*-values (((var ...) expr) ...) body ...)
(define-macro (let*-values bindings . body)
  (if (null? bindings)
      (cons 'begin body)
      (cons 'let-values
            (cons (cons (car bindings) '())
                  (cons (cons 'let*-values (cons (cdr bindings) body))
                        '())))))

;; parameterize: (parameterize ((param val) ...) body ...)
(define-macro (parameterize bindings . body)
  (if (null? bindings)
      (cons 'begin body)
      (let ((first_b (car bindings))
            (rest_b (cdr bindings)))
        (let ((param_expr (car first_b))
              (val_expr (car (cdr first_b))))
          (let ((p_sym '__param_obj)
                (val_sym '__new_val)
                (old_sym '__old_val))
            (cons 'let
                  (cons (cons (cons p_sym (cons param_expr '()))
                              (cons (cons val_sym (cons val_expr '()))
                                    '()))
                        (cons (cons 'let
                                    (cons (cons (cons old_sym (cons (cons p_sym '()) '()))
                                                '())
                                          (cons (cons 'dynamic-wind
                                                      (cons (cons 'lambda (cons '() (cons (cons p_sym (cons val_sym '())) '())))
                                                            (cons (cons 'lambda
                                                                        (cons '()
                                                                              (cons (cons 'parameterize (cons rest_b body))
                                                                                    '())))
                                                                  (cons (cons 'lambda (cons '() (cons (cons p_sym (cons old_sym '())) '())))
                                                                        '()))))
                                                '())))
                              '()))))))))


;;; -------------------------------------------------------------
;;; 2. Pair and List Accessors & Utilities
;;; -------------------------------------------------------------

(define (caar p) (car (car p)))
(define (cadr p) (car (cdr p)))
(define (cdar p) (cdr (car p)))
(define (cddr p) (cdr (cdr p)))

(define (length lst)
  (define (loop l acc)
    (if (null? l)
        acc
        (loop (cdr l) (+ acc 1))))
  (loop lst 0))

(define (reverse lst)
  (define (loop l acc)
    (if (null? l)
        acc
        (loop (cdr l) (cons (car l) acc))))
  (loop lst '()))

(define (_append2 l1 l2)
  (if (null? l1)
      l2
      (cons (car l1) (_append2 (cdr l1) l2))))

(define (append . lists)
  (define (loop ls)
    (if (null? ls)
        '()
        (if (null? (cdr ls))
            (car ls)
            (_append2 (car ls) (loop (cdr ls))))))
  (loop lists))

;;; -------------------------------------------------------------
;;; 3. Higher-Order Functions
;;; -------------------------------------------------------------

(define (map proc lst)
  (if (null? lst)
      '()
      (cons (proc (car lst))
            (map proc (cdr lst)))))

(define (filter pred lst)
  (if (null? lst)
      '()
      (if (pred (car lst))
          (cons (car lst) (filter pred (cdr lst)))
          (filter pred (cdr lst)))))

(define (fold-left proc init lst)
  (if (null? lst)
      init
      (fold-left proc (proc init (car lst)) (cdr lst))))

(define (for-each proc lst)
  (if (null? lst)
      '()
      (begin
        (proc (car lst))
        (for-each proc (cdr lst)))))

;;; -------------------------------------------------------------
;;; 4. Searching and Association Lists (Alist)
;;; -------------------------------------------------------------

(define (memq item lst)
  (if (null? lst)
      #f
      (if (eq? item (car lst))
          lst
          (memq item (cdr lst)))))

(define (member item lst)
  (if (null? lst)
      #f
      (if (eqv? item (car lst))
          lst
          (member item (cdr lst)))))

(define (memv item lst)
  (if (null? lst)
      #f
      (if (eqv? item (car lst))
          lst
          (memv item (cdr lst)))))

(define (assq key alist)
  (if (null? alist)
      #f
      (if (eq? key (car (car alist)))
          (car alist)
          (assq key (cdr alist)))))

(define (assoc key alist)
  (if (null? alist)
      #f
      (if (eqv? key (car (car alist)))
          (car alist)
          (assoc key (cdr alist)))))

;;; -------------------------------------------------------------
;;; 5. Record-Type Definitions (R7RS 5.5)
;;; -------------------------------------------------------------

(define (_ilisp_extract_all_fields field-specs)
  (if (null? field-specs)
      '()
      (cons (car (car field-specs))
            (_ilisp_extract_all_fields (cdr field-specs)))))

(define (_ilisp_expand_field_specs type-name field-specs)
  (if (null? field-specs)
      '()
      (let* ((fspec (car field-specs))
             (fname (car fspec))
             (acc-name (car (cdr fspec)))
             (acc-def (list 'define acc-name (list 'record-accessor type-name (list 'quote fname))))
             (rest-defs (_ilisp_expand_field_specs type-name (cdr field-specs))))
        (if (null? (cdr (cdr fspec)))
            (cons acc-def rest-defs)
            (let ((mod-name (car (cdr (cdr fspec)))))
              (cons acc-def
                    (cons (list 'define mod-name (list 'record-modifier type-name (list 'quote fname)))
                          rest-defs)))))))

(define-macro (define-record-type type-name ctor-spec pred-name . field-specs)
  (let ((all-fields (_ilisp_extract_all_fields field-specs))
        (ctor-name (car ctor-spec))
        (ctor-fields (cdr ctor-spec)))
    (cons 'begin
          (cons (list 'define type-name (list 'make-record-type (list 'quote type-name) (list 'quote all-fields)))
                (cons (list 'define pred-name (list 'record-predicate type-name))
                      (cons (list 'define ctor-name (list 'record-constructor type-name (list 'quote ctor-fields)))
                            (_ilisp_expand_field_specs type-name field-specs)))))))

;;; -------------------------------------------------------------
;;; 6. Delayed Evaluation & Case-Lambda (R7RS 4.2.5 & 4.2.9)
;;; -------------------------------------------------------------

;; delay: (delay expr)
(define-macro (delay expr)
  (list '__make-promise-from-thunk (list 'lambda '() expr)))

;; delay-force: (delay-force expr)
(define-macro (delay-force expr)
  (list '__make-promise-from-thunk (list 'lambda '() expr)))

;; Helpers for case-lambda arity inspection
(define (_ilisp_formals_min_arity formals)
  (if (null? formals)
      0
      (if (symbol? formals)
          0
          (if (symbol? (cdr formals))
              1
              (+ 1 (_ilisp_formals_min_arity (cdr formals)))))))

(define (_ilisp_formals_has_rest formals)
  (if (null? formals)
      #f
      (if (symbol? formals)
          #t
          (if (symbol? (cdr formals))
              #t
              (_ilisp_formals_has_rest (cdr formals))))))

(define (_ilisp_expand_case_lambda_clauses clauses args-var n-var)
  (if (null? clauses)
      (list (list 'else (list 'error "case-lambda: no matching clause for arguments" args-var)))
      (let* ((cl (car clauses))
             (formals (car cl))
             (body (cdr cl))
             (min-a (_ilisp_formals_min_arity formals))
             (is-rest (_ilisp_formals_has_rest formals))
             (test-cond (if is-rest
                            (list '>= n-var min-a)
                            (list '= n-var min-a)))
             (action (list 'apply (cons 'lambda (cons formals body)) args-var)))
        (cons (list test-cond action)
              (_ilisp_expand_case_lambda_clauses (cdr clauses) args-var n-var)))))

;; case-lambda: (case-lambda (formals body ...) ...)
(define-macro (case-lambda . clauses)
  (let ((args-var '__case_lambda_args)
        (n-var '__case_lambda_n))
    (list 'lambda args-var
          (list 'let (list (list n-var (list 'length args-var)))
                (cons 'cond (_ilisp_expand_case_lambda_clauses clauses args-var n-var))))))

