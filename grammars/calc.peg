# Arithmetic Calculator Grammar
grammar Calc

expr = left:term rest:(op:add_op right:term)* {
    val = left
    for o, r in rest:
        val = val + r if o == "+" else val - r
    return val
}

term = left:factor rest:(op:mul_op right:factor)* {
    val = left
    for o, r in rest:
        val = val * r if o == "*" else val // r
    return val
}

factor = "(" e:expr ")" { return e }
       / n:number { return n }

number = raw:/[0-9]+/ { return int(raw) }
add_op = op:/[+-]/ { return op }
mul_op = op:/[*\/]/ { return op }
