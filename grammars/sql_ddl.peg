# SQL DDL (Data Definition Language) Grammar Specification
# Conforms to Bryan Ford POPL '04 Packrat PEG Specification.
# Generates strongly-typed DDL AST nodes.

grammar SQLDDL

@header {
import re
from typing import Any, List, Optional, Tuple

try:
    from .ast import (
        AlterTableAction,
        AlterTableStatement,
        ColumnDef,
        CreateIndexStatement,
        CreateTableStatement,
        CreateTriggerStatement,
        CreateViewStatement,
        CreateVirtualTableStatement,
        DropIndexStatement,
        DropTableStatement,
        DropTriggerStatement,
        DropViewStatement,
        ForeignKeyDef,
        ReindexStatement,
        SQLCommandType,
    )
    from .dql_parser import parse_dql
except (ImportError, ValueError):
    from database.sql.ast import (
        AlterTableAction,
        AlterTableStatement,
        ColumnDef,
        CreateIndexStatement,
        CreateTableStatement,
        CreateTriggerStatement,
        CreateViewStatement,
        CreateVirtualTableStatement,
        DropIndexStatement,
        DropTableStatement,
        DropTriggerStatement,
        DropViewStatement,
        ForeignKeyDef,
        ReindexStatement,
        SQLCommandType,
    )
    from database.sql.dql_parser import parse_dql

ALLOWED_STRICT_TYPES = {"INT", "INTEGER", "REAL", "TEXT", "BLOB", "ANY"}

_ALLOWED_ENGINES: set[str] = {
    "binary_vdb",
    "json_lines",
    "json_table",
    "file_plain_text",
    "fts5",
    "csv_table",
    "csv",
}


def _validate_storage_engine(engine: Optional[str]) -> Optional[str]:
    if not engine:
        return None
    from database.sql.parser import SQLParseError

    clean = engine.strip().lower()
    if clean not in _ALLOWED_ENGINES:
        allowed = ", ".join(sorted(_ALLOWED_ENGINES))
        raise SQLParseError(
            f"Unsupported storage engine: '{engine}'. Allowed: [{allowed}]"
        )
    return clean


def _validate_strict_columns(columns: List[ColumnDef]) -> None:
    from database.sql.parser import SQLParseError

    for col in columns:
        dt = col.data_type.strip().upper()
        if dt not in ALLOWED_STRICT_TYPES:
            raise SQLParseError(
                f"Unknown datatype for {col.name} in STRICT table: {col.data_type}"
            )


def _extract_col_nullability_and_keys(
    upper_c: str,
) -> Tuple[bool, bool, bool]:
    is_pk = bool(re.search(r"\bPRIMARY\s+KEY\b", upper_c))
    is_unique = bool(re.search(r"\bUNIQUE\b", upper_c))
    is_nullable = True
    if re.search(r"\bNOT\s+NULL\b", upper_c):
        is_nullable = False
    elif is_pk:
        is_nullable = False
    return is_pk, is_unique, is_nullable


def _extract_collate_from_raw(cleaned: str) -> Optional[str]:
    m_collate = re.search(r"\bCOLLATE\s+([a-zA-Z0-9_]+)\b", cleaned, re.IGNORECASE)
    return m_collate.group(1).upper() if m_collate else None


def _extract_generated_from_raw(
    cleaned: str, c_name: str
) -> Tuple[Optional[str], bool]:
    from database.sql.parser import SQLParseError

    gen_pattern = r"(?:GENERATED\s+ALWAYS\s+)?AS\s*\((.*?)\)(?:\s+(STORED|VIRTUAL))?"
    m_gen = re.search(gen_pattern, cleaned, re.IGNORECASE)
    if not m_gen:
        return None, False
    gen_expr = m_gen.group(1).strip()
    if re.search(rf"\b{re.escape(c_name)}\b", gen_expr):
        raise SQLParseError(f"Generated column '{c_name}' cannot refer to itself")
    is_stored = bool(m_gen.group(2) and m_gen.group(2).upper() == "STORED")
    return gen_expr, is_stored


def _is_null_default(raw_val: Optional[str]) -> bool:
    if raw_val is None:
        return True
    return raw_val.upper() == "NULL"


def _is_numeric_default(raw_val: str) -> Tuple[bool, Any]:
    if re.match(r"^-?\d+$", raw_val):
        return True, int(raw_val)
    if re.match(r"^-?\d+\.\d+$", raw_val):
        return True, float(raw_val)
    return False, raw_val


def _resolve_raw_default_val(raw_val: Optional[str]) -> Any:
    if _is_null_default(raw_val):
        return None
    assert raw_val is not None
    is_num, val = _is_numeric_default(raw_val)
    if is_num:
        return val
    return raw_val


def _extract_default_from_raw(cleaned: str) -> Any:
    m_def = re.search(
        r"\s+DEFAULT\s+('([^']*)'|\"([^\"]*)\"|([a-zA-Z0-9_\.\-]+))",
        cleaned,
        re.IGNORECASE,
    )
    if not m_def:
        return None
    raw_val = m_def.group(2) or m_def.group(3) or m_def.group(4)
    return _resolve_raw_default_val(raw_val)


def _extract_fk_actions_from_rest(rest: str) -> Tuple[str, str]:
    on_del = "NO ACTION"
    on_upd = "NO ACTION"
    m_del = re.search(
        r"\bON\s+DELETE\s+(CASCADE|SET\s+NULL|RESTRICT|NO\s+ACTION|SET\s+DEFAULT)\b",
        rest,
        re.IGNORECASE,
    )
    if m_del:
        on_del = m_del.group(1).upper()
    m_upd = re.search(
        r"\bON\s+UPDATE\s+(CASCADE|SET\s+NULL|RESTRICT|NO\s+ACTION|SET\s+DEFAULT)\b",
        rest,
        re.IGNORECASE,
    )
    if m_upd:
        on_upd = m_upd.group(1).upper()
    return on_del, on_upd


def _extract_fk_from_raw(
    cleaned: str, c_name: str
) -> Tuple[Optional[ForeignKeyDef], str]:
    pattern = r"\bREFERENCES\s+([a-zA-Z0-9_.]+)(?:\s*\(([a-zA-Z0-9_]+)\))?(.*?)$"
    m = re.search(pattern, cleaned, re.IGNORECASE)
    if not m:
        return None, cleaned

    ref_table = m.group(1).strip()
    ref_col = m.group(2).strip() if m.group(2) else c_name
    rest = m.group(3) or ""
    on_del, on_upd = _extract_fk_actions_from_rest(rest)

    fk = ForeignKeyDef(
        child_column=c_name,
        parent_table=ref_table,
        parent_column=ref_col,
        on_delete=on_del,
        on_update=on_upd,
    )
    cleaned_wo_fk = cleaned[: m.start()].strip()
    return fk, cleaned_wo_fk


def _is_table_level_constraint(upper_c: str) -> bool:
    return bool(
        upper_c.startswith("FOREIGN KEY")
        or upper_c.startswith("PRIMARY KEY")
        or upper_c.startswith("UNIQUE")
        or upper_c.startswith("CHECK")
        or upper_c.startswith("CONSTRAINT")
    )


def _parse_single_column_def(col_str: str) -> Optional[ColumnDef]:
    cleaned = col_str.strip()
    if not cleaned:
        return None
    upper_c = cleaned.upper()
    if _is_table_level_constraint(upper_c):
        return None

    parts = cleaned.split(None, 2)
    c_name = parts[0].strip("`\"'")
    c_type = parts[1].upper() if len(parts) > 1 else "TEXT"

    is_pk, is_uniq, is_null = _extract_col_nullability_and_keys(upper_c)
    collate = _extract_collate_from_raw(cleaned)
    gen_expr, is_stored = _extract_generated_from_raw(cleaned, c_name)
    fk, cleaned_wo_fk = _extract_fk_from_raw(cleaned, c_name)
    default_val = _extract_default_from_raw(cleaned_wo_fk)

    return ColumnDef(
        name=c_name,
        data_type=c_type,
        is_primary_key=is_pk,
        is_nullable=is_null,
        default_value=default_val,
        is_unique=is_uniq,
        collate=collate,
        foreign_key=fk,
        generated_expr=gen_expr,
        is_stored=is_stored,
    )


def _clean_csv_cols(raw_cols: str) -> List[str]:
    res: List[str] = []
    for c in raw_cols.split(","):
        stripped = c.strip().strip("`\"'")
        if stripped:
            res.append(stripped)
    return res


def _extract_table_fk_def(chunk: str) -> Optional[ForeignKeyDef]:
    cleaned = chunk.strip()
    fk_pattern = (
        r"^(?:CONSTRAINT\s+[a-zA-Z0-9_]+\s+)?FOREIGN\s+KEY\s*\((.*?)\)\s*"
        r"REFERENCES\s+([a-zA-Z0-9_]+)\s*\((.*?)\)(.*)$"
    )
    m = re.search(fk_pattern, cleaned, re.IGNORECASE)
    if not m:
        return None
    cols = _clean_csv_cols(m.group(1))
    ref_tbl = m.group(2).strip().strip("`\"'")
    ref_cols = _clean_csv_cols(m.group(3))
    rest = m.group(4) or ""
    on_del, on_upd = _extract_fk_actions_from_rest(rest)
    return ForeignKeyDef(
        child_column=cols[0] if cols else "",
        parent_table=ref_tbl,
        parent_column=ref_cols[0] if ref_cols else "",
        on_delete=on_del,
        on_update=on_upd,
    )


def _split_comma_top_level(text: str) -> List[str]:
    from database.sql.parser import _split_comma_expressions
    return _split_comma_expressions(text)


def _handle_table_chunk(
    ch: str, cols: List[ColumnDef], fks: List[ForeignKeyDef]
) -> None:
    tbl_fk = _extract_table_fk_def(ch)
    if tbl_fk is not None:
        fks.append(tbl_fk)
        return
    c_def = _parse_single_column_def(ch)
    if c_def is not None:
        cols.append(c_def)
        if c_def.foreign_key is not None:
            fks.append(c_def.foreign_key)


def _split_table_items(body: str) -> Tuple[List[ColumnDef], List[ForeignKeyDef]]:
    cols: List[ColumnDef] = []
    fks: List[ForeignKeyDef] = []
    for chunk in _split_comma_top_level(body):
        ch = chunk.strip()
        if ch:
            _handle_table_chunk(ch, cols, fks)
    return cols, fks


def _extract_table_tail_opts(
    tail_str: str,
) -> Tuple[bool, Optional[str], Optional[str]]:
    strict = bool(re.search(r"\bSTRICT\b", tail_str, re.IGNORECASE))
    m_loc = re.search(r"\bLOCATION\s+['\"](.*?)['\"]", tail_str, re.IGNORECASE)
    location = m_loc.group(1).strip() if m_loc else None
    m_eng = re.search(r"\bUSING\s+([a-zA-Z0-9_]+)\b", tail_str, re.IGNORECASE)
    raw_engine = m_eng.group(1).strip() if m_eng else None
    return strict, location, raw_engine


def _assemble_create_table_stmt(
    tbl: str,
    body: str,
    tail: Optional[str],
    if_not: bool,
) -> CreateTableStatement:
    clean_body = body.strip()[1:-1]
    tail_str = tail.strip() if tail else ""
    strict, location, raw_engine = _extract_table_tail_opts(tail_str)
    engine = _validate_storage_engine(raw_engine)
    cols, fks = _split_table_items(clean_body)
    if strict:
        _validate_strict_columns(cols)
    return CreateTableStatement(
        command_type=SQLCommandType.CREATE_TABLE,
        raw_sql="",
        table_name=tbl,
        columns=cols,
        if_not_exists=if_not,
        storage_engine=engine,
        location=location,
        strict=strict,
        foreign_keys=fks,
    )
}

# -------------------------------------------------------------
# Top-Level Root Rule
# -------------------------------------------------------------
root <- opt_ws ddl:ddl_stmt opt_ws {
    return ddl
}

ddl_stmt <-
    create_virtual_table_stmt
    / create_table_stmt
    / create_index_stmt
    / create_view_stmt
    / create_trigger_stmt
    / alter_table_stmt
    / drop_stmt
    / reindex_stmt

# -------------------------------------------------------------
# CREATE TABLE Statement
# -------------------------------------------------------------
create_table_stmt <-
    create_kw
    (ws (temp_kw / temporary_kw))?
    ws table_kw
    if_not:opt_if_not_exists
    ws tbl:ident
    opt_ws body:paren_chunk
    tail:(ws t:rest_of_line { return t })? {
        return _assemble_create_table_stmt(tbl, body, tail, if_not)
    }

# -------------------------------------------------------------
# CREATE VIRTUAL TABLE Statement
# -------------------------------------------------------------
create_virtual_table_stmt <-
    create_kw ws virtual_kw ws table_kw
    if_not:opt_if_not_exists
    ws tbl:ident
    ws using_kw ws module:ident
    args_paren:(opt_ws p:paren_chunk { return p })? {
        args_raw = args_paren.strip()[1:-1] if args_paren else ""
        args = [a.strip() for a in _split_comma_top_level(args_raw) if a.strip()]

        return CreateVirtualTableStatement(
            command_type=SQLCommandType.CREATE_VIRTUAL_TABLE,
            raw_sql="",
            table_name=tbl,
            module_name=module,
            module_args=args,
            if_not_exists=if_not,
        )
    }

# -------------------------------------------------------------
# CREATE INDEX Statement
# -------------------------------------------------------------
create_index_stmt <-
    create_kw
    (ws unique_kw)?
    ws index_kw
    opt_if_not_exists
    ws idx:ident
    ws on_kw ws tbl:ident
    opt_ws cols_paren:paren_chunk
    idx_type_opt:(ws using_kw ws it:ident { return it })? {
        cols_body = cols_paren.strip()[1:-1].strip()
        idx_t = idx_type_opt.upper() if idx_type_opt else "HNSW"

        return CreateIndexStatement(
            command_type=SQLCommandType.CREATE_INDEX,
            raw_sql="",
            index_name=idx,
            table_name=tbl,
            column_name=cols_body,
            index_type=idx_t,
        )
    }

# -------------------------------------------------------------
# CREATE VIEW Statement
# -------------------------------------------------------------
create_view_stmt <-
    create_kw
    (ws (temp_kw / temporary_kw))?
    ws view_kw
    if_not:opt_if_not_exists
    ws vw:ident
    ws as_kw ws select_raw:rest_of_line {
        sub_select = parse_dql(select_raw.strip())
        return CreateViewStatement(
            command_type=SQLCommandType.CREATE_VIEW,
            raw_sql="",
            view_name=vw,
            select_stmt=sub_select,
            if_not_exists=if_not,
        )
    }

# -------------------------------------------------------------
# CREATE TRIGGER Statement
# -------------------------------------------------------------
create_trigger_stmt <-
    create_kw
    (ws (temp_kw / temporary_kw))?
    ws trigger_kw
    opt_if_not_exists
    ws trg:ident
    ws timing:trigger_timing
    ws event:trigger_event
    ws on_kw ws tbl:ident
    (ws for_kw ws each_kw ws row_kw)?
    ws begin_kw ws body_raw:trigger_body opt_ws end_kw {
        body_sqls = [s.strip() for s in body_raw.split(";") if s.strip()]
        return CreateTriggerStatement(
            command_type=SQLCommandType.CREATE_TRIGGER,
            raw_sql="",
            trigger_name=trg,
            timing=timing,
            event=event,
            table_name=tbl,
            body_sqls=body_sqls,
        )
    }

trigger_timing <-
    before_kw { return "BEFORE" }
    / after_kw { return "AFTER" }
    / instead_kw ws of_kw { return "INSTEAD OF" }

trigger_event <-
    insert_kw { return "INSERT" }
    / update_kw { return "UPDATE" }
    / delete_kw { return "DELETE" }

trigger_body <- raw:/(?is).*?(?=\bEND\b)/ {
    return raw
}

# -------------------------------------------------------------
# ALTER TABLE Statement
# -------------------------------------------------------------
alter_table_stmt <-
    alter_kw ws table_kw ws tbl:ident ws action:alter_action {
        return action(tbl)
    }

alter_action <-
    rename_table_action
    / rename_column_action
    / add_column_action
    / drop_column_action

rename_table_action <- rename_kw ws to_kw ws new_tbl:ident {
    return lambda tbl: AlterTableStatement(
        command_type=SQLCommandType.ALTER_TABLE,
        raw_sql="",
        table_name=tbl,
        action=AlterTableAction.RENAME_TABLE,
        new_table_name=new_tbl,
    )
}

rename_column_action <- rename_kw (ws column_kw)? ws old_c:ident ws to_kw ws new_c:ident {
    return lambda tbl: AlterTableStatement(
        command_type=SQLCommandType.ALTER_TABLE,
        raw_sql="",
        table_name=tbl,
        action=AlterTableAction.RENAME_COLUMN,
        old_column_name=old_c,
        new_column_name=new_c,
    )
}

add_column_action <- add_kw (ws column_kw)? ws raw_col:rest_of_line {
    c_def = _parse_single_column_def(raw_col.strip())
    def_val = c_def.default_value if c_def else None
    return lambda tbl: AlterTableStatement(
        command_type=SQLCommandType.ALTER_TABLE,
        raw_sql="",
        table_name=tbl,
        action=AlterTableAction.ADD_COLUMN,
        column_def=c_def,
        default_value=def_val,
    )
}

drop_column_action <- drop_kw (ws column_kw)? ws drop_c:ident {
    return lambda tbl: AlterTableStatement(
        command_type=SQLCommandType.ALTER_TABLE,
        raw_sql="",
        table_name=tbl,
        action=AlterTableAction.DROP_COLUMN,
        drop_column_name=drop_c,
    )
}

# -------------------------------------------------------------
# DROP Statement
# -------------------------------------------------------------
drop_stmt <-
    drop_kw ws kind:drop_kind if_ex:opt_if_exists ws target:ident {
        if kind == "TABLE":
            return DropTableStatement(
                command_type=SQLCommandType.DROP_TABLE,
                raw_sql="",
                table_name=target,
                if_exists=if_ex,
            )
        elif kind == "INDEX":
            return DropIndexStatement(
                command_type=SQLCommandType.DROP_INDEX,
                raw_sql="",
                index_name=target,
                if_exists=if_ex,
            )
        elif kind == "VIEW":
            return DropViewStatement(
                command_type=SQLCommandType.DROP_VIEW,
                raw_sql="",
                view_name=target,
                if_exists=if_ex,
            )
        else:
            return DropTriggerStatement(
                command_type=SQLCommandType.DROP_TRIGGER,
                raw_sql="",
                trigger_name=target,
                if_exists=if_ex,
            )
    }

drop_kind <-
    table_kw { return "TABLE" }
    / index_kw { return "INDEX" }
    / view_kw { return "VIEW" }
    / trigger_kw { return "TRIGGER" }

# -------------------------------------------------------------
# REINDEX Statement
# -------------------------------------------------------------
reindex_stmt <- reindex_kw target:(ws t:ident { return t })? {
    return ReindexStatement(
        command_type=SQLCommandType.REINDEX,
        raw_sql="",
        target_name=target,
    )
}

# -------------------------------------------------------------
# Identifiers & Helper Rules
# -------------------------------------------------------------
opt_if_not_exists <- flag:(ws if_kw ws not_kw ws exists_kw)? {
    return bool(flag)
}

opt_if_exists <- flag:(ws if_kw ws exists_kw)? {
    return bool(flag)
}

paren_chunk <- raw:/\((?:[^()]|\([^()]*\))*\)/ {
    return raw
}

rest_of_line <- raw:/[^\r\n;]+/ {
    return raw
}

ident <-
    plain:ident_pattern { return plain }
    / backtick:backtick_pattern { return backtick }
    / double_quote:double_quote_pattern { return double_quote }
    / bracket:bracket_pattern { return bracket }

ident_pattern <- raw:/[a-zA-Z_][a-zA-Z0-9_]*(\.[a-zA-Z_][a-zA-Z0-9_]*)?/ {
    return raw
}

backtick_pattern <- raw:/`[^`]*`/ {
    return raw[1:-1]
}

double_quote_pattern <- raw:/"[^"]*"/ {
    return raw[1:-1]
}

bracket_pattern <- raw:/\[[^\]]*\]/ {
    return raw[1:-1]
}

# -------------------------------------------------------------
# SQL Keywords (Case-Insensitive)
# -------------------------------------------------------------
create_kw <- /(?i)\bCREATE\b/
table_kw <- /(?i)\bTABLE\b/
temp_kw <- /(?i)\bTEMP\b/
temporary_kw <- /(?i)\bTEMPORARY\b/
virtual_kw <- /(?i)\bVIRTUAL\b/
index_kw <- /(?i)\bINDEX\b/
unique_kw <- /(?i)\bUNIQUE\b/
view_kw <- /(?i)\bVIEW\b/
trigger_kw <- /(?i)\bTRIGGER\b/
alter_kw <- /(?i)\bALTER\b/
drop_kw <- /(?i)\bDROP\b/
reindex_kw <- /(?i)\bREINDEX\b/
rename_kw <- /(?i)\bRENAME\b/
to_kw <- /(?i)\bTO\b/
add_kw <- /(?i)\bADD\b/
column_kw <- /(?i)\bCOLUMN\b/
using_kw <- /(?i)\bUSING\b/
on_kw <- /(?i)\bON\b/
as_kw <- /(?i)\bAS\b/
before_kw <- /(?i)\bBEFORE\b/
after_kw <- /(?i)\bAFTER\b/
instead_kw <- /(?i)\bINSTEAD\b/
of_kw <- /(?i)\bOF\b/
insert_kw <- /(?i)\bINSERT\b/
update_kw <- /(?i)\bUPDATE\b/
delete_kw <- /(?i)\bDELETE\b/
for_kw <- /(?i)\bFOR\b/
each_kw <- /(?i)\bEACH\b/
row_kw <- /(?i)\bROW\b/
begin_kw <- /(?i)\bBEGIN\b/
end_kw <- /(?i)\bEND\b/
if_kw <- /(?i)\bIF\b/
not_kw <- /(?i)\bNOT\b/
exists_kw <- /(?i)\bEXISTS\b/

ws <- /[ \t\r\n]+|#[^\r\n]*|--[^\r\n]*/
opt_ws <- /[ \t\r\n]*|#[^\r\n]*|--[^\r\n]*/
