;;; =======================================================================
;;; ULisp C99 Compiler Driver & Host Linker Integration
;;; Conforms to DSN-33-32 §5.1/§6.1, DSN-33-11, DSN-33-13 & Issue #917
;;; Orchestrates:
;;;   CPP (#914) -> Parser (#915) -> Sema/Lower (#916)
;;;   -> Pass 133 LIR Peephole (-O1/-O2) -> Pass 140/144a (x86-64 ELF .o)
;;;   or Pass 160 (Portable C) -> Host cc/ld Linking (Step S2-S5 J2)
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Driver Options Record & CWE-78 Security Path/Arg Validation
;;; -----------------------------------------------------------------------

(define-record-type <c-driver-options>
  (%make-c-driver-options mode target opt-level output inputs
                          include-dirs system-include-dirs
                          defines undefs lib-dirs libs
                          ld-flags sanitize-bounds? verbose? pch-file)
  c-driver-options?
  (mode                c-drv-mode                c-drv-mode-set!)
  (target              c-drv-target              c-drv-target-set!)
  (opt-level           c-drv-opt-level           c-drv-opt-level-set!)
  (output              c-drv-output              c-drv-output-set!)
  (inputs              c-drv-inputs              c-drv-inputs-set!)
  (include-dirs        c-drv-include-dirs        c-drv-include-dirs-set!)
  (system-include-dirs c-drv-system-include-dirs c-drv-system-include-dirs-set!)
  (defines             c-drv-defines             c-drv-defines-set!)
  (undefs              c-drv-undefs              c-drv-undefs-set!)
  (lib-dirs            c-drv-lib-dirs            c-drv-lib-dirs-set!)
  (libs                c-drv-libs                c-drv-libs-set!)
  (ld-flags            c-drv-ld-flags            c-drv-ld-flags-set!)
  (sanitize-bounds?    c-drv-sanitize-bounds?    c-drv-sanitize-bounds-set!)
  (verbose?            c-drv-verbose?            c-drv-verbose-set!)
  (pch-file            c-drv-pch-file            c-drv-pch-file-set!))

(define (make-default-c-driver-options)
  (%make-c-driver-options 'link 'x86_64 0 #f '() '() '() '() '() '() '() '() #f #f #f))

(define (%c-drv-error! code msg fname)
  (let* ((sp (make-source-span fname 1 1 1 1 #f (next-source-span-id!)))
         (diag (make-diagnostic 'error code sp msg)))
    (report-diagnostic diag)
    (raise (list 'c99-driver-error code msg fname))))

;; Strict CWE-78 CLI argument validator (blocks control chars & shell metachars)
(define (c99-safe-cli-arg? str)
  (and (string? str)
       (> (string-length str) 0)
       (let ((len (string-length str)))
         (let loop ((i 0))
           (if (>= i len)
               #t
               (let* ((c (string-ref str i))
                      (code (char->integer c)))
                 (if (or (< code 32)
                         (= code 127)
                         (memv c '(#\; #\& #\| #\` #\$ #\< #\> #\( #\) #\{ #\} #\* #\? #\!)))
                     #f
                     (loop (+ i 1)))))))))

(define (c99-assert-safe-arg! arg flag-name)
  (if (not (c99-safe-cli-arg? arg))
      (%c-drv-error! "C99-DRV-002"
                     (string-append "Unsafe or invalid argument for " flag-name ": " arg)
                     "<c-driver>"))
  arg)

;;; -----------------------------------------------------------------------
;;; 2. CLI Option Parser
;;; -----------------------------------------------------------------------

(define (%c-drv-starts-with? str prefix)
  (let ((slen (string-length str))
        (plen (string-length prefix)))
    (and (>= slen plen)
         (string=? (substring str 0 plen) prefix))))

(define (%c-drv-ends-with? str suffix)
  (let ((slen (string-length str))
        (xlen (string-length suffix)))
    (and (>= slen xlen)
         (string=? (substring str (- slen xlen) slen) suffix))))

(define (%c-drv-strip-ext path)
  (let ((n (string-length path)))
    (let loop ((i (- n 1)))
      (cond
        ((< i 0) path)
        ((char=? (string-ref path i) #\.)
         (if (= i 0) path (substring path 0 i)))
        ((char=? (string-ref path i) #\/) path)
        (else (loop (- i 1)))))))

(define (%c-drv-basename path)
  (let ((n (string-length path)))
    (let loop ((i (- n 1)))
      (cond
        ((< i 0) path)
        ((char=? (string-ref path i) #\/)
         (substring path (+ i 1) n))
        (else (loop (- i 1)))))))

(define (parse-c-driver-args argv)
  (let* ((opts (make-default-c-driver-options))
         (clean-argv (if (and (pair? argv) (string=? (car argv) "--"))
                         (cdr argv)
                         argv))
         (req-val (lambda (flag rest)
                    (if (or (null? rest) (not (string? (car rest))))
                        (%c-drv-error! "C99-DRV-002"
                                       (string-append "Missing argument after option " flag)
                                       "<c-driver>"))
                    (c99-assert-safe-arg! (car rest) flag))))
    (let loop ((xs clean-argv)
               (inputs '())
               (inc-dirs '())
               (sys-dirs '())
               (defs '())
               (undefs '())
               (lib-dirs '())
               (libs '())
               (ld-flags '()))
      (if (null? xs)
          (begin
            (c-drv-inputs-set! opts (reverse inputs))
            (c-drv-include-dirs-set! opts (reverse inc-dirs))
            (c-drv-system-include-dirs-set! opts (reverse sys-dirs))
            (c-drv-defines-set! opts (reverse defs))
            (c-drv-undefs-set! opts (reverse undefs))
            (c-drv-lib-dirs-set! opts (reverse lib-dirs))
            (c-drv-libs-set! opts (reverse libs))
            (c-drv-ld-flags-set! opts (reverse ld-flags))
            opts)
          (let ((arg (car xs))
                (rest (cdr xs)))
            (cond
              ((string=? arg "-E")
               (c-drv-mode-set! opts 'preprocess)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "-S")
               (c-drv-mode-set! opts 'asm)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "-c")
               (c-drv-mode-set! opts 'compile)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "-emit-pch")
               (c-drv-mode-set! opts 'emit-pch)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "-include-pch")
               (let ((val (req-val "-include-pch" rest)))
                 (c-drv-pch-file-set! opts val)
                 (loop (cdr rest) inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags)))
              ((%c-drv-starts-with? arg "-include-pch=")
               (let ((val (c99-assert-safe-arg! (substring arg 13 (string-length arg)) "-include-pch")))
                 (c-drv-pch-file-set! opts val)
                 (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags)))
              ((string=? arg "-v")
               (c-drv-verbose-set! opts #t)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "--sanitize-bounds")
               (c-drv-sanitize-bounds-set! opts #t)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "-O0")
               (c-drv-opt-level-set! opts 0)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((or (string=? arg "-O1") (string=? arg "-O"))
               (c-drv-opt-level-set! opts 1)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((or (string=? arg "-O2") (string=? arg "-O3"))
               (c-drv-opt-level-set! opts 2)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((or (string=? arg "-g") (string=? arg "-g0") (string=? arg "-g1")
                   (string=? arg "-g2") (string=? arg "-g3")
                   (%c-drv-starts-with? arg "-W"))
               (if (string=? arg "-Wl,")
                   (%c-drv-error! "C99-DRV-002" "Empty -Wl, linker flag" "<c-driver>")
                   (if (%c-drv-starts-with? arg "-Wl,")
                       (begin
                         (c99-assert-safe-arg! arg "-Wl,")
                         (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs (cons arg ld-flags)))
                       (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))))
              ((string=? arg "-rdynamic")
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs (cons "-rdynamic" ld-flags)))
              ((or (string=? arg "-std=c89") (string=? arg "-std=c90")
                   (string=? arg "-std=c99") (string=? arg "-std=c11")
                   (string=? arg "-std=gnu89") (string=? arg "-std=gnu90")
                   (string=? arg "-std=gnu99") (string=? arg "-std=gnu11"))
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "--target=x86_64")
               (c-drv-target-set! opts 'x86_64)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "--target=x86-64")
               (c-drv-target-set! opts 'x86_64)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "--target=c")
               (c-drv-target-set! opts 'c)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "--target=vm")
               (c-drv-target-set! opts 'vm)
               (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))
              ((string=? arg "-o")
               (let ((val (req-val "-o" rest)))
                 (c-drv-output-set! opts val)
                 (loop (cdr rest) inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags)))
              ((and (%c-drv-starts-with? arg "-o") (> (string-length arg) 2))
               (let ((val (c99-assert-safe-arg! (substring arg 2 (string-length arg)) "-o")))
                 (c-drv-output-set! opts val)
                 (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags)))
              ((string=? arg "-I")
               (let ((val (req-val "-I" rest)))
                 (loop (cdr rest) inputs (cons val inc-dirs) sys-dirs defs undefs lib-dirs libs ld-flags)))
              ((and (%c-drv-starts-with? arg "-I") (> (string-length arg) 2))
               (let ((val (c99-assert-safe-arg! (substring arg 2 (string-length arg)) "-I")))
                 (loop rest inputs (cons val inc-dirs) sys-dirs defs undefs lib-dirs libs ld-flags)))
              ((string=? arg "-isystem")
               (let ((val (req-val "-isystem" rest)))
                 (loop (cdr rest) inputs inc-dirs (cons val sys-dirs) defs undefs lib-dirs libs ld-flags)))
              ((string=? arg "-D")
               (let ((val (req-val "-D" rest)))
                 (loop (cdr rest) inputs inc-dirs sys-dirs (cons val defs) undefs lib-dirs libs ld-flags)))
              ((and (%c-drv-starts-with? arg "-D") (> (string-length arg) 2))
               (let ((val (c99-assert-safe-arg! (substring arg 2 (string-length arg)) "-D")))
                 (loop rest inputs inc-dirs sys-dirs (cons val defs) undefs lib-dirs libs ld-flags)))
              ((string=? arg "-U")
               (let ((val (req-val "-U" rest)))
                 (loop (cdr rest) inputs inc-dirs sys-dirs defs (cons val undefs) lib-dirs libs ld-flags)))
              ((and (%c-drv-starts-with? arg "-U") (> (string-length arg) 2))
               (let ((val (c99-assert-safe-arg! (substring arg 2 (string-length arg)) "-U")))
                 (loop rest inputs inc-dirs sys-dirs defs (cons val undefs) lib-dirs libs ld-flags)))
              ((string=? arg "-L")
               (let ((val (req-val "-L" rest)))
                 (loop (cdr rest) inputs inc-dirs sys-dirs defs undefs (cons val lib-dirs) libs ld-flags)))
              ((and (%c-drv-starts-with? arg "-L") (> (string-length arg) 2))
               (let ((val (c99-assert-safe-arg! (substring arg 2 (string-length arg)) "-L")))
                 (loop rest inputs inc-dirs sys-dirs defs undefs (cons val lib-dirs) libs ld-flags)))
              ((string=? arg "-l")
               (let ((val (req-val "-l" rest)))
                 (loop (cdr rest) inputs inc-dirs sys-dirs defs undefs lib-dirs (cons val libs) ld-flags)))
              ((and (%c-drv-starts-with? arg "-l") (> (string-length arg) 2))
               (let ((val (c99-assert-safe-arg! (substring arg 2 (string-length arg)) "-l")))
                 (loop rest inputs inc-dirs sys-dirs defs undefs lib-dirs (cons val libs) ld-flags)))
              ((%c-drv-starts-with? arg "-")
               (%c-drv-error! "C99-DRV-002"
                              (string-append "Unknown or unsupported C driver option: " arg)
                              "<c-driver>"))
              (else
               (c99-assert-safe-arg! arg "input")
               (loop rest (cons arg inputs) inc-dirs sys-dirs defs undefs lib-dirs libs ld-flags))))))))

;;; -----------------------------------------------------------------------
;;; 3. File I/O & Pipeline Helpers
;;; -----------------------------------------------------------------------

(define (%c-drv-write-text-file! path text)
  (let ((p (open-output-file path)))
    (write-string text p)
    (close-output-port p)))

(define (%c-drv-write-bytes-file! path bv)
  (let ((p (open-binary-output-file path)))
    (write-bytevector bv p)
    (close-output-port p)))

(define (%c-drv-capture-lines thunk)
  (let ((acc-box (vector '())))
    (with-emit-line-sink
      (lambda (line)
        (vector-set! acc-box 0 (cons line (vector-ref acc-box 0))))
      thunk)
    (let loop ((lines (reverse (vector-ref acc-box 0))) (parts '()))
      (if (null? lines)
          (apply string-append (reverse parts))
          (loop (cdr lines) (cons "\n" (cons (car lines) parts)))))))

(define (c-driver-build-cpp-context opts)
  (let ((ctx (make-default-cpp-context)))
    (for-each (lambda (d) (cpp-add-include-path! ctx d #f))
              (c-drv-include-dirs opts))
    (for-each (lambda (d) (cpp-add-include-path! ctx d #t))
              (c-drv-system-include-dirs opts))
    (for-each (lambda (d) (cpp-define-string! ctx d))
              (c-drv-defines opts))
    (for-each (lambda (u) (cpp-undef! ctx (string->symbol u)))
              (c-drv-undefs opts))
    ctx))

(define (%c-drv-optimize-lir lir opts)
  (let ((lvl (c-drv-opt-level opts)))
    (cond
      ((<= lvl 0) lir)
      ((= lvl 1) (optimize-peephole-fixpoint lir))
      (else (run-c99-o2-fixpoint-pipeline lir)))))

(define *c99-pch-memory-cache* (cons '() '()))
(define *c99-pch-batch-mode* (cons #f '()))

(define (c99-clear-pch-memory-cache!)
  (set-car! *c99-pch-memory-cache* '()))

(define (c99-with-pch-batch-cache thunk)
  (let ((prev (car *c99-pch-batch-mode*)))
    (c99-clear-pch-memory-cache!)
    (set-car! *c99-pch-batch-mode* #t)
    (guard (ex (else
                (set-car! *c99-pch-batch-mode* prev)
                (c99-clear-pch-memory-cache!)
                (raise ex)))
      (let ((res (thunk)))
        (set-car! *c99-pch-batch-mode* prev)
        (c99-clear-pch-memory-cache!)
        res))))

(define (%c-drv-pch-warn! code msg fname)
  (let ((sp (make-source-span fname 0 0 0 0 #f (next-source-span-id!))))
    (emit-diagnostic-warning
     code sp msg
     "Regenerate the .sbi precompiled header with -emit-pch; falling back to full compilation")))

(define (%c-drv-pch-error! code msg fname)
  (let ((sp (make-source-span fname 0 0 0 0 #f (next-source-span-id!))))
    (emit-diagnostic-error
     code sp msg
     "Ensure the .sbi file exists and was generated cleanly via -emit-pch")
    (raise (list 'c99-driver-error code msg fname))))

(define (%c-drv-pch-options-signature opts)
  (let ((p (open-output-string)))
    (write (list 'c99-pch-opts-v1 (c-drv-defines opts) (c-drv-undefs opts)) p)
    (sbi-sha256-hex (get-output-string p))))

(define (%c-drv-valid-pch-snapshot? snap)
  (and (pair? snap)
       (eq? (car snap) 'c99-pch-snapshot-v1)
       (list? (cdr snap))
       (assq 'schema-version (cdr snap))
       (assq 'defines-sig (cdr snap))
       (assq 'cpp-state (cdr snap))
       (assq 'parse-state (cdr snap))
       (assq 'sema-state (cdr snap))
       #t))

(define (%c-drv-filter-pch-dep-paths paths header-file)
  (let ((all-cands (let ((nh (%cpp-normalize-path header-file)))
                     (if (member nh paths) paths (cons nh paths)))))
    (let loop ((xs all-cands) (acc '()))
      (if (null? xs)
          (reverse acc)
          (let ((p (car xs)))
            (if (and (string? p)
                     (sbi-safe-dep-path? p)
                     (file-exists? p)
                     (not (member p acc)))
                (loop (cdr xs) (cons p acc))
                (loop (cdr xs) acc)))))))

(define (c99-emit-pch-file header-file out-sbi opts)
  (if (not (file-exists? header-file))
      (%c-drv-error! "C99-DRV-001"
                     (string-append "Input header file does not exist: " header-file)
                     header-file))
  (c99-assert-safe-arg! out-sbi "-o")
  (if (not (sbi-safe-dep-path? out-sbi))
      (%c-drv-error! "C99-DRV-002"
                     (string-append "Unsafe PCH output path: " out-sbi)
                     out-sbi))
  (let* ((ctx (c-driver-build-cpp-context opts))
         (pp-toks (cpp-preprocess-file header-file ctx))
         (parse-pair (parse-c99-tokens-capturing-pch pp-toks header-file))
         (ast (car parse-pair))
         (parse-pch-sx (cdr parse-pair))
         (sema-pch-sx (c99-analyze-header-for-pch ast))
         (cpp-pch-sx (cpp-context->pch-sexpr ctx header-file))
         (dep-paths (%c-drv-filter-pch-dep-paths (cpp-ctx-included-files ctx) header-file))
         (snapshot (list 'c99-pch-snapshot-v1
                         (cons 'schema-version 1)
                         (cons 'header-file (%cpp-normalize-path header-file))
                         (cons 'defines-sig (%c-drv-pch-options-signature opts))
                         (cons 'cpp-state cpp-pch-sx)
                         (cons 'parse-state parse-pch-sx)
                         (cons 'sema-state sema-pch-sx))))
    (sbi-write-file out-sbi snapshot 'pch dep-paths)
    out-sbi))

(define (%c-drv-load-pch-for-opts opts)
  (let ((pch-path (c-drv-pch-file opts)))
    (if (not pch-path)
        #f
        (let* ((opts-sig (%c-drv-pch-options-signature opts))
               (batch? (car *c99-pch-batch-mode*))
               (cache-entry (and batch? (assoc pch-path (car *c99-pch-memory-cache*)))))
          (if cache-entry
              (let ((snap (cdr cache-entry)))
                (if (and (%c-drv-valid-pch-snapshot? snap)
                         (equal? (cdr (assq 'schema-version (cdr snap))) 1)
                         (string=? (cdr (assq 'defines-sig (cdr snap))) opts-sig))
                    snap
                    (begin
                      (%c-drv-pch-warn!
                       "C99-PCH-001"
                       (string-append "PCH macro definitions or version differ from invocation options: " pch-path)
                       pch-path)
                      #f)))
              (let ((res (sbi-read-pch-validated pch-path)))
                (cond
                  ((eq? (car res) 'error)
                   (%c-drv-pch-error! "C99-PCH-002" (caddr res) pch-path))
                  ((eq? (car res) 'stale)
                   (%c-drv-pch-warn!
                    "C99-PCH-001"
                    (string-append "PCH header dependencies are out of date or missing: " pch-path)
                    pch-path)
                   #f)
                  (else
                   (let ((snap (cadr res)))
                     (if (not (%c-drv-valid-pch-snapshot? snap))
                         (%c-drv-pch-error!
                          "C99-PCH-002"
                          (string-append "Invalid C99 PCH snapshot payload structure in " pch-path)
                          pch-path)
                         (let ((ver (cdr (assq 'schema-version (cdr snap))))
                               (sig (cdr (assq 'defines-sig (cdr snap)))))
                           (if (not (and (equal? ver 1) (string? sig) (string=? sig opts-sig)))
                               (begin
                                 (%c-drv-pch-warn!
                                  "C99-PCH-001"
                                  (string-append "PCH compiler -D/-U flags or schema mismatch: " pch-path)
                                  pch-path)
                                 #f)
                               (begin
                                 (if batch?
                                     (set-car! *c99-pch-memory-cache*
                                               (cons (cons pch-path snap) (car *c99-pch-memory-cache*))))
                                 snap)))))))))))))

(define (c99-compile-file-to-lir src-file opts)
  (if (not (file-exists? src-file))
      (%c-drv-error! "C99-DRV-001"
                     (string-append "Input source file does not exist: " src-file)
                     src-file))
  (let* ((pch-snap (%c-drv-load-pch-for-opts opts))
         (ctx (c-driver-build-cpp-context opts))
         (typed
          (if pch-snap
              (let ((alist (cdr pch-snap)))
                (cpp-restore-context-from-pch! ctx (cdr (assq 'cpp-state alist)))
                (let* ((pp-toks (cpp-preprocess-file src-file ctx))
                       (tu-ast (parse-c99-tokens-with-pch pp-toks (cdr (assq 'parse-state alist)) src-file)))
                  (c99-analyze-program-with-pch tu-ast (cdr (assq 'sema-state alist)))))
              (let* ((pp-toks (cpp-preprocess-file src-file ctx))
                     (ast (parse-c99-tokens pp-toks src-file)))
                (c99-analyze-program ast))))
         (lir (c99-lower-to-lir typed))
         (opt-lir (%c-drv-optimize-lir lir opts)))
    (if (not (and (L_lir_core? opt-lir) (validate-core-lir opt-lir)))
        (%c-drv-error! "C99-DRV-003"
                       (string-append "Core LIR verification failed for " src-file)
                       src-file))
    opt-lir))

;; Rename string literal labels in a TU when tu-idx > 0 to avoid C static collisions
(define (c99-rename-tu-strings tu-idx strs)
  (if (or (= tu-idx 0) (null? strs))
      (cons strs '())
      (let loop ((xs strs) (s-idx 0) (new-strs '()) (rename-map '()))
        (if (null? xs)
            (cons (reverse new-strs) (reverse rename-map))
            (let* ((entry (car xs))
                   (old-lbl (car entry))
                   (str-val (if (pair? (cdr entry)) (cadr entry) (cdr entry)))
                   (new-lbl (string->symbol
                             (string-append ".L_cstr_tu"
                                            (number->string tu-idx)
                                            "_"
                                            (number->string s-idx)))))
              (loop (cdr xs)
                    (+ s-idx 1)
                    (cons (list new-lbl str-val) new-strs)
                    (cons (cons old-lbl new-lbl) rename-map)))))))

(define (c99-rewrite-str-refs insts str-map)
  (if (null? str-map)
      insts
      (map (lambda (inst)
             (if (and (pair? inst)
                      (eq? (car inst) '%str-ref)
                      (pair? (cdr inst))
                      (pair? (cddr inst)))
                 (let ((hit (assq (caddr inst) str-map)))
                   (if hit
                       (list '%str-ref (cadr inst) (cdr hit))
                       inst))
                 inst))
           insts)))

(define (c99-tu-local-data-label? sym)
  (let ((s (symbol->string sym)))
    (and (>= (string-length s) 13)
         (string=? (substring s 0 13) ".L_c99_static")
         (not (and (>= (string-length s) 17)
                   (string=? (substring s 0 17) ".L_c99_static_fn_"))))))

(define (c99-tu-local-fn-label? sym)
  (let ((s (symbol->string sym)))
    (and (>= (string-length s) 17)
         (string=? (substring s 0 17) ".L_c99_static_fn_"))))

(define (c99-rename-tu-static-fns tu-idx fns)
  (if (= tu-idx 0)
      (cons fns '())
      (let loop ((fs fns) (acc-fns '()) (rmap '()))
        (if (null? fs)
            (cons (reverse acc-fns) (reverse rmap))
            (let* ((fn (car fs))
                   (sym (cadr fn)))
              (if (c99-tu-local-fn-label? sym)
                  (let* ((new-sym (string->symbol
                                   (string-append ".L_c99_static_fn_tu"
                                                  (number->string tu-idx)
                                                  "_"
                                                  (substring (symbol->string sym) 17 (string-length (symbol->string sym))))))
                         (new-fn (cons (car fn) (cons new-sym (cddr fn)))))
                    (loop (cdr fs) (cons new-fn acc-fns) (cons (cons sym new-sym) rmap)))
                  (loop (cdr fs) (cons fn acc-fns) rmap)))))))

(define (c99-rewrite-static-fn-refs insts fn-map)
  (if (null? fn-map)
      insts
      (map (lambda (inst)
             (if (not (pair? inst))
                 inst
                 (case (car inst)
                   ((%block)
                    (append (list (car inst) (cadr inst) (caddr inst))
                            (c99-rewrite-static-fn-refs (cdddr inst) fn-map)))
                   ((%direct-call)
                    (let ((hit (assq (cadr inst) fn-map)))
                      (if hit
                          (append (list '%direct-call (cdr hit)) (cddr inst))
                          inst)))
                   ((%code-ref)
                    (let ((hit (and (pair? (cddr inst)) (assq (caddr inst) fn-map))))
                      (if hit
                          (list '%code-ref (cadr inst) (cdr hit))
                          inst)))
                   (else inst))))
           insts)))

(define (c99-rename-tu-data tu-idx data-entries)
  (if (or (= tu-idx 0) (null? data-entries))
      (cons data-entries '())
      (let loop ((xs data-entries) (d-idx 0) (new-entries '()) (rename-map '()))
        (if (null? xs)
            (cons (reverse new-entries) (reverse rename-map))
            (let* ((entry (car xs))
                   (old-lbl (cadr entry)))
              (if (c99-tu-local-data-label? old-lbl)
                  (let ((new-lbl (string->symbol
                                  (string-append ".L_c99_static_tu"
                                                 (number->string tu-idx)
                                                 "_"
                                                 (number->string d-idx)))))
                    (loop (cdr xs)
                          (+ d-idx 1)
                          (cons (cons (car entry) (cons new-lbl (cddr entry))) new-entries)
                          (cons (cons old-lbl new-lbl) rename-map)))
                  (loop (cdr xs)
                        d-idx
                        (cons entry new-entries)
                        rename-map)))))))

(define (c99-rewrite-global-addrs insts data-map)
  (if (null? data-map)
      insts
      (map (lambda (inst)
             (if (and (pair? inst)
                      (eq? (car inst) '%global-addr)
                      (pair? (cdr inst))
                      (pair? (cddr inst)))
                 (let ((hit (assq (caddr inst) data-map)))
                   (if hit
                       (list '%global-addr (cadr inst) (cdr hit))
                       inst))
                 inst))
           insts)))

(define (c99-rewrite-data-relocs data-entries str-map data-map fn-map)
  (if (and (null? str-map) (null? data-map) (null? fn-map))
      data-entries
      (map (lambda (de)
             (if (eq? (car de) 'bytes)
                 (let ((new-chunks
                        (map (lambda (ch)
                               (if (and (pair? ch) (eq? (car ch) 'reloc))
                                   (let* ((tgt (cadr ch))
                                          (hit (or (assq tgt str-map) (assq tgt data-map) (assq tgt fn-map))))
                                     (if hit
                                         (list 'reloc (cdr hit) (caddr ch))
                                         ch))
                                   ch))
                             (cdddr de))))
                   (cons 'bytes (cons (cadr de) (cons (caddr de) new-chunks))))
                 de))
           data-entries)))

(define (c99-merge-data-entry! de merged-rev)
  (let ((lbl (cadr de)))
    (let loop ((xs merged-rev) (found? #f) (acc '()))
      (if (null? xs)
          (if found? (reverse acc) (cons de merged-rev))
          (let ((cur (car xs)))
            (if (eq? (cadr cur) lbl)
                (let ((chosen (if (and (eq? (car cur) 'bss) (eq? (car de) 'bytes)) de cur)))
                  (loop (cdr xs) #t (cons chosen acc)))
                (loop (cdr xs) found? (cons cur acc))))))))

(define (c99-rewrite-merged-calls insts defined-fn-syms)
  (if (null? defined-fn-syms)
      insts
      (let loop ((xs insts) (acc '()))
        (if (null? xs)
            (reverse acc)
            (let ((inst (car xs)))
              (cond
                ((and (pair? inst) (eq? (car inst) '%block))
                 (let ((rewritten (append (list (car inst) (cadr inst) (caddr inst))
                                          (c99-rewrite-merged-calls (cdddr inst) defined-fn-syms))))
                   (loop (cdr xs) (cons rewritten acc))))
                ((and (pair? inst)
                      (memq (car inst) '(%c-call %call-foreign))
                      (pair? (cdr inst))
                      (pair? (cddr inst)))
                 (let* ((fn-name (cadr inst))
                        (fn-sym (if (symbol? fn-name)
                                    fn-name
                                    (string->symbol fn-name)))
                        (al-val (if (pair? (cdddr inst)) (cadddr inst) #f)))
                   (if (memq fn-sym defined-fn-syms)
                       (let ((acc1 (if (number? al-val)
                                       (cons (list '%mov '%rax al-val) acc)
                                       acc)))
                         (loop (cdr xs) (cons (list '%direct-call fn-sym (caddr inst)) acc1)))
                       (loop (cdr xs) (cons inst acc)))))
                (else
                 (loop (cdr xs) (cons inst acc)))))))))

(define (c99-rewrite-fn-body fn transform-insts)
  (let ((header (list (car fn) (cadr fn)))
        (clauses (map (lambda (clause)
                        (if (and (pair? clause) (eq? (car clause) 'body))
                            (cons 'body (transform-insts (cdr clause)))
                            clause))
                      (cddr fn))))
    (append header clauses)))

;; Merge multiple C translation unit %lir-program ASTs (used for multi-file --target=c)
(define (c99-merge-lir-programs lirs)
  (let loop ((xs lirs)
             (tu-idx 0)
             (strs '())
             (data-acc '())
             (fns '())
             (inits '())
             (has-main? #f))
    (if (null? xs)
        (let* ((all-fns-raw
                (let dloop ((xs (reverse fns)) (seen-builtins '()) (acc '()))
                  (if (null? xs)
                      (reverse acc)
                      (let* ((fn (car xs))
                             (sym (cadr fn)))
                        (if (memq sym '(__ulisp_setjmp __ulisp_longjmp))
                            (if (memq sym seen-builtins)
                                (dloop (cdr xs) seen-builtins acc)
                                (dloop (cdr xs) (cons sym seen-builtins) (cons fn acc)))
                            (dloop (cdr xs) seen-builtins (cons fn acc)))))))
               (defined-fn-syms (map cadr all-fns-raw))
               (all-fns (map (lambda (fn)
                               (c99-rewrite-fn-body
                                fn
                                (lambda (body)
                                  (c99-rewrite-merged-calls body defined-fn-syms))))
                             all-fns-raw))
               (tail (if has-main?
                         '((%mov %rdi 0) (%mov %rsi 0) (%direct-call main 8) (%return %rax))
                         '((%mov %rax 0) (%return %rax))))
               (main-body (c99-rewrite-merged-calls (append (reverse inits) tail)
                                                    defined-fn-syms))
               (merged-data (reverse data-acc)))
          (if (pair? merged-data)
              (list '%lir-program
                    (list 'strings (reverse strs))
                    (list 'data merged-data)
                    '(stackmaps ())
                    (cons '%lir-functions all-fns)
                    (list '%lir-main '(frame-size 16) (cons 'body main-body)))
              (list '%lir-program
                    (list 'strings (reverse strs))
                    '(stackmaps ())
                    (cons '%lir-functions all-fns)
                    (list '%lir-main '(frame-size 16) (cons 'body main-body)))))
        (let* ((p (car xs))
               (s-clause (assq 'strings (cdr p)))
               (raw-strs (if (and s-clause (pair? (cdr s-clause))) (cadr s-clause) '()))
               (renamed (c99-rename-tu-strings tu-idx raw-strs))
               (p-strs (car renamed))
               (str-map (cdr renamed))
               (d-clause (assq 'data (cdr p)))
               (raw-data (if (and d-clause (pair? (cdr d-clause))) (cadr d-clause) '()))
               (d-renamed (c99-rename-tu-data tu-idx raw-data))
               (p-data-renamed (car d-renamed))
               (data-map (cdr d-renamed))
               (f-clause (assq '%lir-functions (cdr p)))
               (raw-fns (if f-clause (cdr f-clause) '()))
               (f-renamed (c99-rename-tu-static-fns tu-idx raw-fns))
               (p-fns-renamed (car f-renamed))
               (fn-map (cdr f-renamed))
               (p-data (c99-rewrite-data-relocs p-data-renamed str-map data-map fn-map))
               (p-fns (map (lambda (fn)
                             (c99-rewrite-fn-body
                              fn
                              (lambda (body)
                                (c99-rewrite-static-fn-refs
                                 (c99-rewrite-global-addrs
                                  (c99-rewrite-str-refs body str-map)
                                  data-map)
                                 fn-map))))
                           p-fns-renamed))
               (m-clause (assq '%lir-main (cdr p)))
               (m-body (if m-clause (cdr (assq 'body (cdr m-clause))) '()))
               (p-inits (c99-rewrite-static-fn-refs
                         (c99-rewrite-global-addrs
                          (c99-rewrite-str-refs (c99-extract-global-init-insts m-body) str-map)
                          data-map)
                         fn-map))
               (p-has-main? (let fl ((fs p-fns))
                              (cond ((null? fs) #f)
                                    ((eq? (cadar fs) 'main) #t)
                                    (else (fl (cdr fs)))))))
          (loop (cdr xs)
                (+ tu-idx 1)
                (let sl ((ss p-strs) (acc strs))
                  (if (null? ss) acc (sl (cdr ss) (cons (car ss) acc))))
                (let dl ((ds p-data) (acc data-acc))
                  (if (null? ds) acc (dl (cdr ds) (c99-merge-data-entry! (car ds) acc))))
                (let fl ((fs p-fns) (acc fns))
                  (if (null? fs) acc (fl (cdr fs) (cons (car fs) acc))))
                (let il ((is p-inits) (acc inits))
                  (if (null? is) acc (il (cdr is) (cons (car is) acc))))
                (or has-main? p-has-main?))))))

;;; -----------------------------------------------------------------------
;;; 4. Translation Unit Compilation & Host Linker Integration
;;; -----------------------------------------------------------------------

(define (c-compile-translation-unit src-file out-path opts)
  (if (not (file-exists? src-file))
      (%c-drv-error! "C99-DRV-001"
                     (string-append "Input source file does not exist: " src-file)
                     src-file))
  (let ((mode (c-drv-mode opts))
        (target (c-drv-target opts)))
    (cond
      ((eq? mode 'preprocess)
       (let* ((ctx (c-driver-build-cpp-context opts))
              (pp-toks (cpp-preprocess-file src-file ctx))
              (pp-text (string-append (c-tokens->source-string pp-toks) "\n")))
         (if out-path
             (%c-drv-write-text-file! out-path pp-text)
             (display pp-text))
         out-path))
      ((eq? target 'vm)
       (let ((lir (c99-compile-file-to-lir src-file opts)))
         (eval-lir-program lir)))
      ((eq? mode 'asm)
       (let* ((lir (c99-compile-file-to-lir src-file opts))
              (text (%c-drv-capture-lines
                     (lambda ()
                       (if (eq? target 'c)
                           (emit-c lir 'c-tu)
                           (emit-x86-64 lir 'c-tu))))))
         (if out-path
             (%c-drv-write-text-file! out-path text)
             (display text))
         out-path))
      (else
       ;; Default: compile to ELF64 ET_REL object file (or C source under --target=c)
       (let ((lir (c99-compile-file-to-lir src-file opts)))
         (if (eq? target 'c)
             (let ((c-text (%c-drv-capture-lines (lambda () (emit-c lir 'c-tu)))))
               (%c-drv-write-text-file! out-path c-text)
               out-path)
             (let ((obj-bv (build-x86-64-elf-obj lir 'c-tu)))
               (%c-drv-write-bytes-file! out-path obj-bv)
               out-path)))))))

(cond-expand
  (gauche
   (define (process-exec argv)
     (let ((p (run-process argv :wait #t)))
       (sys-wait-exit-status (process-exit-status p)))))
  (else))

(define (%c-drv-find-host-cc)
  (let ((env-cc (get-environment-variable "CC")))
    (cond
      ((and (string? env-cc) (> (string-length env-cc) 0) (c99-safe-cli-arg? env-cc))
       env-cc)
      ((file-exists? "/usr/bin/cc") "/usr/bin/cc")
      ((file-exists? "/usr/bin/gcc") "/usr/bin/gcc")
      (else "cc"))))

(define (c-link-objects obj-files out-file opts)
  (if (null? obj-files)
      (%c-drv-error! "C99-DRV-001" "No object files provided to linker" "<c-driver>"))
  (for-each (lambda (p) (c99-assert-safe-arg! p "link-input")) obj-files)
  (c99-assert-safe-arg! out-file "-o")
  (for-each (lambda (d) (c99-assert-safe-arg! d "-L")) (c-drv-lib-dirs opts))
  (for-each (lambda (l) (c99-assert-safe-arg! l "-l")) (c-drv-libs opts))
  (let* ((cc (%c-drv-find-host-cc))
         (ldir-args (map (lambda (d) (string-append "-L" d)) (c-drv-lib-dirs opts)))
         (lib-args  (map (lambda (l) (string-append "-l" l)) (c-drv-libs opts)))
         (argv (append (list cc "-no-pie")
                       (append (c-drv-ld-flags opts)
                               (append obj-files
                                       (append ldir-args
                                               (append lib-args (list "-o" out-file)))))))
         (rc (process-exec argv)))
    (if (not (= rc 0))
        (%c-drv-error! "C99-DRV-003"
                       (string-append "Host linker failed with exit code "
                                      (number->string rc)
                                      " while linking "
                                      out-file)
                       out-file))
    rc))

(define (%c-drv-is-c-source? path)
  (%c-drv-ends-with? path ".c"))

(define (c-driver-main argv)
  (let* ((opts (parse-c-driver-args argv))
         (inputs (c-drv-inputs opts))
         (mode (c-drv-mode opts))
         (target (c-drv-target opts))
         (out (c-drv-output opts)))
    (if (null? inputs)
        (%c-drv-error! "C99-DRV-001" "No input files specified" "<c-driver>"))
    (for-each (lambda (f)
                (if (not (file-exists? f))
                    (%c-drv-error! "C99-DRV-001"
                                   (string-append "Input file not found: " f)
                                   f)))
              inputs)
    (c99-with-pch-batch-cache
     (lambda ()
       (cond
         ((eq? mode 'emit-pch)
          (if (not (= (length inputs) 1))
              (%c-drv-error! "C99-DRV-002" "-emit-pch requires exactly one header input file" "<c-driver>"))
          (let* ((hdr (car inputs))
                 (out-dir? (and out
                                (> (string-length out) 0)
                                (char=? (string-ref out (- (string-length out) 1)) #\/)))
                 (tgt-out (cond
                            (out-dir? (string-append out (%c-drv-basename hdr) ".sbi"))
                            (out out)
                            (else (string-append hdr ".sbi")))))
            (c99-emit-pch-file hdr tgt-out opts))
          0)

         ((or (eq? mode 'preprocess) (eq? mode 'asm))
       (if (and out (> (length inputs) 1))
           (%c-drv-error! "C99-DRV-002" "Cannot specify -o with multiple inputs in -E/-S mode" "<c-driver>"))
       (for-each
        (lambda (src)
          (let ((tgt-out (if out
                             out
                             (if (eq? mode 'preprocess)
                                 #f
                                 (string-append (%c-drv-strip-ext (%c-drv-basename src))
                                                (if (eq? target 'c) ".c" ".s"))))))
            (c-compile-translation-unit src tgt-out opts)))
        inputs)
       0)

      ((eq? mode 'compile)
       (let ((out-dir? (and out
                            (> (string-length out) 0)
                            (char=? (string-ref out (- (string-length out) 1)) #\/))))
         (if (and out (not out-dir?) (> (length inputs) 1))
             (%c-drv-error! "C99-DRV-002" "Cannot specify -o with multiple inputs in -c mode" "<c-driver>"))
         (for-each
          (lambda (src)
            (let ((tgt-out (cond
                             (out-dir?
                              (string-append out (%c-drv-strip-ext (%c-drv-basename src)) ".o"))
                             (out out)
                             (else
                              (string-append (%c-drv-strip-ext (%c-drv-basename src)) ".o")))))
              (if (eq? target 'c)
                  (let* ((tmp-c (string-append tgt-out ".tmp_c99.c"))
                         (lir (c99-compile-file-to-lir src opts))
                         (c-text (%c-drv-capture-lines (lambda () (emit-c lir 'c-tu)))))
                    (%c-drv-write-text-file! tmp-c c-text)
                    (let ((rc (process-exec (list (%c-drv-find-host-cc) "-c" "-O1" tmp-c "-o" tgt-out))))
                      (if (file-exists? tmp-c) (delete-file tmp-c))
                      (if (not (= rc 0))
                          (%c-drv-error! "C99-DRV-003" "Portable C object compilation failed" tgt-out))))
                  (c-compile-translation-unit src tgt-out opts))))
          inputs)
         0))

      ((eq? target 'vm)
       (if (> (length inputs) 1)
           (let ((lirs (map (lambda (f) (c99-compile-file-to-lir f opts)) inputs)))
             (eval-lir-program (c99-merge-lir-programs lirs)))
           (c-compile-translation-unit (car inputs) #f opts)))

      ((eq? target 'c)
       (let* ((out-bin (if out out "a.out"))
              (c-inputs (let loop ((xs inputs) (acc '()))
                          (cond ((null? xs) (reverse acc))
                                ((%c-drv-is-c-source? (car xs)) (loop (cdr xs) (cons (car xs) acc)))
                                (else (loop (cdr xs) acc)))))
              (other-inputs (let loop ((xs inputs) (acc '()))
                              (cond ((null? xs) (reverse acc))
                                    ((%c-drv-is-c-source? (car xs)) (loop (cdr xs) acc))
                                    (else (loop (cdr xs) (cons (car xs) acc)))))))
         (if (null? c-inputs)
             (c-link-objects other-inputs out-bin opts)
             (let* ((tmp-c (string-append out-bin ".tmp_c99.c"))
                    (lirs (map (lambda (f) (c99-compile-file-to-lir f opts)) c-inputs))
                    (merged (if (= (length lirs) 1) (car lirs) (c99-merge-lir-programs lirs)))
                    (c-text (%c-drv-capture-lines (lambda () (emit-c merged 'c-tu))))
                    (ldir-args (map (lambda (d) (string-append "-L" d)) (c-drv-lib-dirs opts)))
                    (lib-args  (map (lambda (l) (string-append "-l" l)) (c-drv-libs opts)))
                    (opt-flag  (cond ((>= (c-drv-opt-level opts) 2) "-O2")
                                     ((= (c-drv-opt-level opts) 1) "-O1")
                                     (else "-O0"))))
               (%c-drv-write-text-file! tmp-c c-text)
               (let ((rc (process-exec
                          (append (list (%c-drv-find-host-cc) opt-flag tmp-c)
                                  (append (c-drv-ld-flags opts)
                                          (append other-inputs
                                                  (append ldir-args
                                                          (append lib-args (list "-o" out-bin)))))))))
                 (if (file-exists? tmp-c) (delete-file tmp-c))
                 (if (not (= rc 0))
                     (%c-drv-error! "C99-DRV-003" "Portable C backend build/link failed" out-bin))
                 0)))))

      (else
       ;; Native x86-64 ELF compilation + host cc/ld linking
       (let* ((out-bin (if out out "a.out"))
              (temps-box (cons '() '()))
              (objs
               (let loop ((xs inputs) (idx 0) (acc '()))
                 (if (null? xs)
                     (reverse acc)
                     (let ((f (car xs)))
                       (if (%c-drv-is-c-source? f)
                           (let ((tmp-o (string-append out-bin ".tmp_" (number->string idx) ".o")))
                             (c-compile-translation-unit f tmp-o opts)
                             (set-car! temps-box (cons tmp-o (car temps-box)))
                             (loop (cdr xs) (+ idx 1) (cons tmp-o acc)))
                           (loop (cdr xs) (+ idx 1) (cons f acc))))))))
         (guard (ex (else
                     (for-each (lambda (t) (if (file-exists? t) (delete-file t))) (car temps-box))
                     (raise ex)))
           (c-link-objects objs out-bin opts))
         (for-each (lambda (t) (if (file-exists? t) (delete-file t))) (car temps-box))
         0)))))))

(define (c-driver-cli-main argv)
  (guard (ex
          ((and (pair? ex) (memq (car ex) '(c99-driver-error c99-sema-error c99-parse-error c99-cpp-error)))
           1)
          (else
           (display "ulisp-cc: error: " (current-error-port))
           (write ex (current-error-port))
           (newline (current-error-port))
           1))
    (c-driver-main argv)))
