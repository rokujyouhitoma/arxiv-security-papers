;;; ULisp Compiler Pass 8: Compilation Driver & CLI Entrypoint
;;; Conforms to DSN-33 Architecture Specification & Issue #504
;;; =======================================================================


;;; -----------------------------------------------------------------------
;;; Debug-mode source line tracking (Issue #619)
;;; Reads whole stdin text, scans top-level datum start lines, and wraps each
;;; datum as (%source-loc file line col datum).
;;; -----------------------------------------------------------------------
(define (read-all-chars-to-string)
  (let loop ((acc '()))
    (let ((c (read-char)))
      (if (eof-object? c)
          (list->string (reverse acc))
          (loop (cons c acc))))))

;; Returns list of (line . col) for the start of each top-level datum.
(define (scan-toplevel-datum-starts text)
  (let ((len (string-length text)))
    (let loop ((i 0) (line 1) (col 1) (depth 0) (in-str #f) (in-cmt #f) (in-atom #f) (acc '()))
      (if (>= i len)
          (reverse acc)
          (let* ((c (string-ref text i))
                 (nl? (char=? c #\newline))
                 (nline (if nl? (+ line 1) line))
                 (ncol (if nl? 1 (+ col 1))))
            (cond
              (in-cmt (loop (+ i 1) nline ncol depth #f (not nl?) #f acc))
              (in-str
               (cond ((char=? c #\\) (loop (+ i 2) line (+ col 2) depth #t #f #f acc))
                     ((char=? c #\") (loop (+ i 1) nline ncol depth #f #f #f acc))
                     (else (loop (+ i 1) nline ncol depth #t #f #f acc))))
              ((char=? c #\;) (loop (+ i 1) nline ncol depth #f #t #f acc))
              ((char=? c #\")
               (loop (+ i 1) nline ncol depth #t #f #f
                     (if (and (= depth 0) (not in-atom)) (cons (cons line col) acc) acc)))
              ((or (char=? c #\space) (char=? c #\tab) (char=? c #\newline) (char=? c (integer->char 13)))
               (loop (+ i 1) nline ncol depth #f #f #f acc))
              ((char=? c #\()
               (loop (+ i 1) nline ncol (+ depth 1) #f #f #f
                     (if (and (= depth 0) (not in-atom)) (cons (cons line col) acc) acc)))
              ((char=? c #\))
               (loop (+ i 1) nline ncol (if (> depth 0) (- depth 1) 0) #f #f #f acc))
              ((and (char=? c #\#) (< (+ i 2) len) (char=? (string-ref text (+ i 1)) #\\))
               ;; character literal: skip '#\x'
               (loop (+ i 3) line (+ col 3) depth #f #f (= depth 0)
                     (if (and (= depth 0) (not in-atom)) (cons (cons line col) acc) acc)))
              (else
               (loop (+ i 1) nline ncol depth #f #f (and (= depth 0) #t)
                     (if (and (= depth 0) (not in-atom)) (cons (cons line col) acc) acc)))))))))

(define (wrap-forms-with-locs forms starts file)
  (let loop ((fs forms) (ss starts) (acc '()))
    (cond
      ((null? fs) (reverse acc))
      ((null? ss) (loop (cdr fs) ss (cons (car fs) acc)))
      (else (loop (cdr fs) (cdr ss)
                  (cons (list '%source-loc file (car (car ss)) (cdr (car ss)) (car fs)) acc))))))

(define *form-loc-table* (cons '() '()))

(define (rewrap-forms-with-locs forms)
  (map (lambda (f)
         (let ((e (if (pair? f) (assq f (car *form-loc-table*)) #f)))
           (if e (cdr e) f)))
       forms))

(define (read-all-forms)
  (let loop ((acc '()))
    (let ((expr (read)))
      (if (eof-object? expr)
          (reverse acc)
          (loop (cons (sanitize-reader-form expr) acc))))))

(define (detect-bench-passes-env)
  (let ((v (sys-getenv "ULISP_BENCH_PASSES")))
    (if (and (string? v) (or (string=? v "1") (string=? v "true")))
        #t
        #f)))

(define (extract-directives-and-forms raw-forms)
  (if (detect-bench-passes-env)
      (enable-pipeline-time-passes!))
  (let ((initial-gc 'all))
    (let loop ((forms raw-forms)
               (target 'x86_64)
               (gc-mode initial-gc)
               (verify #f)
               (trace #f)
               (debug #f))
      (if (null? forms)
          (list target gc-mode '() verify trace debug)
          (let ((first (car forms)))
            (cond
              ;; Source-loc wrapped datum (debug mode): unwrap, remember location
              ((source-loc? first)
               (let ((inner (source-loc-form first)))
                 (if (pair? inner)
                     (set-car! *form-loc-table* (cons (cons inner first) (car *form-loc-table*))))
                 (loop (cons inner (cdr forms)) target gc-mode verify trace debug)))
              ;; Target directives
              ((or (eq? first '--target-lir)
                   (and (pair? first) (eq? (car first) '!target) (pair? (cdr first)) (eq? (cadr first) 'lir)))
               (set-current-target-arch! 'lir)
               (loop (cdr forms) 'lir gc-mode verify trace debug))
              ((or (eq? first '--target-elf)
                   (and (pair? first) (eq? (car first) '!target) (pair? (cdr first)) (eq? (cadr first) 'elf)))
               (set-current-target-arch! 'elf)
               (loop (cdr forms) 'elf gc-mode verify trace debug))
              ((or (eq? first '--target-obj)
                   (and (pair? first) (eq? (car first) '!target) (pair? (cdr first))
                        (or (eq? (cadr first) 'obj) (eq? (cadr first) 'elf-obj))))
               (set-current-target-arch! 'obj)
               (loop (cdr forms) 'obj gc-mode verify trace debug))
              ((or (eq? first '--target-asm)
                   (and (pair? first) (eq? (car first) '!target) (pair? (cdr first)) (eq? (cadr first) 'asm)))
               (set-current-target-arch! 'x86_64)
               (loop (cdr forms) 'x86_64 gc-mode verify trace debug))
              ((and (pair? first) (eq? (car first) '!target) (pair? (cdr first)))
               (set-current-target-arch! (cadr first))
               (loop (cdr forms) (cadr first) gc-mode verify trace debug))
              ;; Extern symbol directives
              ((or (eq? first '--allow-extern)
                   (eq? first '!allow-extern)
                   (and (pair? first) (or (eq? (car first) '!allow-extern) (eq? (car first) '--allow-extern))))
               (set-allow-extern-symbols! #t)
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; Module compilation directives with module id
              ((and (pair? first)
                    (or (eq? (car first) '!module-name)
                        (eq? (car first) '--module-name)
                        (and (eq? (car first) '!module) (pair? (cdr first)) (not (boolean? (cadr first))))))
               (set-module-mode! #t)
               (set-allow-extern-symbols! #t)
               (set-current-module-id! (cadr first))
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; Module compilation directives (general)
              ((or (eq? first '--module)
                   (eq? first '!module)
                   (and (pair? first) (or (eq? (car first) '!module) (eq? (car first) '--module))))
               (set-module-mode! #t)
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; Import SBI directive
              ((and (pair? first)
                    (or (eq? (car first) '!import-sbi)
                        (eq? (car first) '--import-sbi))
                    (pair? (cdr first)))
               (let* ((path (cadr first))
                      (imported-forms (slurp-single-file (if (symbol? path) (symbol->string path) path))))
                 (loop (append imported-forms (cdr forms)) target gc-mode verify trace debug)))
              ;; Emit SBI directive
              ((and (pair? first)
                    (or (eq? (car first) '!emit-sbi)
                        (eq? (car first) '--emit-sbi)))
               (display ";;; ULisp Compiler SBI (Scheme Binary Interface)\n")
               (display "(define-syntax newline (syntax-rules () ((newline) (port-newline *stdout-port*)) ((newline p) (port-newline p))))\n")
               (display "(define-syntax display (syntax-rules () ((display val) (port-display val *stdout-port*)) ((display val p) (port-display val p))))\n")
               (display "(define-syntax write (syntax-rules () ((write val) (port-write val *stdout-port*)) ((write val p) (port-write val p))))\n")
               (display "(define-syntax read (syntax-rules () ((read) (port-read *stdin-port*)) ((read p) (port-read p))))\n")
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; GC directives
              ((and (pair? first) (eq? (car first) '!gc) (pair? (cdr first)))
               (loop (cdr forms) target (cadr first) verify trace debug))
              ((or (eq? first '--gc-stress) (eq? first '!gc-stress))
               (loop (cdr forms) target 'stress verify trace debug))
              ;; Optimization level directives (-O0, -O1, -O2)
              ((or (eq? first '-O0) (eq? first '!-O0))
               (set-pipeline-opt-level! 0)
               (loop (cdr forms) target gc-mode verify trace debug))
              ((or (eq? first '-O1) (eq? first '!-O1))
               (set-pipeline-opt-level! 1)
               (loop (cdr forms) target gc-mode verify trace debug))
              ((or (eq? first '-O2) (eq? first '!-O2))
               (set-pipeline-opt-level! 2)
               (loop (cdr forms) target gc-mode verify trace debug))
              ((and (pair? first) (eq? (car first) '!opt) (pair? (cdr first)))
               (set-pipeline-opt-level! (cadr first))
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; Verification directives
              ((and (pair? first) (eq? (car first) '!verify))
               (let ((vmode (if (pair? (cdr first)) (cadr first) #t)))
                 (loop (cdr forms) target gc-mode vmode trace debug)))
              ;; Pass timing / profiling directives
              ((or (eq? first '--time-passes)
                   (eq? first '!time-passes)
                   (and (pair? first) (or (eq? (car first) '!time-passes) (eq? (car first) '--time-passes))))
               (enable-pipeline-time-passes!)
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; IR Dump directives
              ((or (eq? first '--print-after-all)
                   (eq? first '!print-after-all)
                   (and (pair? first) (or (eq? (car first) '!print-after-all) (eq? (car first) '--print-after-all))))
               (enable-pipeline-print-after-all!)
               (loop (cdr forms) target gc-mode verify trace debug))
              ((and (pair? first) (eq? (car first) '!dump-ir) (pair? (cdr first)))
               (set-pipeline-dump-ir! (cadr first))
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; Pass disable directives
              ((and (pair? first) (eq? (car first) '!disable-pass) (pair? (cdr first)))
               (disable-pass! (cadr first))
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; Tracing and debugging directives
              ((or (eq? first '--trace-passes) (eq? first '!trace))
               (loop (cdr forms) target gc-mode verify #t debug))
              ((and (pair? first) (eq? (car first) '!trace))
               (loop (cdr forms) target gc-mode verify #t debug))
              ((or (eq? first '--debug) (eq? first '!debug))
               (loop (cdr forms) target gc-mode verify trace #t))
              ((and (pair? first) (eq? (car first) '!debug))
               (loop (cdr forms) target gc-mode verify trace #t))
              ;; DWARF debug symbol directives (Issue #619)
              ((or (eq? first '-g)
                   (eq? first '--debug-symbols)
                   (eq? first '!debug-symbols)
                   (and (pair? first) (or (eq? (car first) '!debug-symbols) (eq? (car first) '--debug-symbols))))
               (enable-debug-symbols!)
               (loop (cdr forms) target gc-mode verify trace debug))
              ;; String/Symbol prefix directives (--dump-ir=..., --disable-pass=...)
              ((symbol? first)
               (let ((str (symbol->string first)))
                 (cond
                   ((string-starts-with? str "--dump-ir=")
                    (let ((pname (string->symbol (substring str 10 (string-length str)))))
                      (set-pipeline-dump-ir! pname)
                      (loop (cdr forms) target gc-mode verify trace debug)))
                   ((string-starts-with? str "--disable-pass=")
                    (let ((pname (string->symbol (substring str 15 (string-length str)))))
                      (disable-pass! pname)
                      (loop (cdr forms) target gc-mode verify trace debug)))
                   ((string-starts-with? str "--module-name=")
                    (let ((mname (substring str 14 (string-length str))))
                      (set-module-mode! #t)
                      (set-allow-extern-symbols! #t)
                      (set-current-module-id! mname)
                      (loop (cdr forms) target gc-mode verify trace debug)))
                   ((string-starts-with? str "--import-sbi=")
                    (let* ((sbipath (substring str 13 (string-length str)))
                           (imported-forms (slurp-single-file sbipath)))
                      (loop (append imported-forms (cdr forms)) target gc-mode verify trace debug)))
                   (else
                    (list target gc-mode forms verify trace debug)))))
              (else
               (list target gc-mode forms verify trace debug))))))))

(define (extract-target-and-forms raw-forms)
  (let ((res (extract-directives-and-forms raw-forms)))
    (cons (car res) (caddr res))))

;;; -----------------------------------------------------------------------
;;; Two-Layer Compiler Pipeline API (Frontend/LIR & Backend)
;;; Conforms to DSN-33 Architecture Specification & Issue #590, #598
;;; -----------------------------------------------------------------------

(define (compile-to-lir forms verify-mode trace-mode)
  (run-pass-pipeline forms verify-mode trace-mode))

(define (compile-backend lir-ast target gc-mode)
  (let* ((c-target? (or (eq? target 'c) (eq? target 'c-windows) (eq? target 'c-win)))
         (tgt-str (cond (c-target? "c")
                        ((eq? target 'aarch64) "aarch64")
                        ((eq? target 'elf) "elf")
                        ((or (eq? target 'obj) (eq? target 'elf-obj)) "elf-obj")
                        (else "x86-64")))
         (pass-id (cond (c-target? 'pass-160-backend-c)
                        ((eq? target 'aarch64) 'pass-150-backend-aarch64)
                        ((eq? target 'elf) 'pass-144-backend-x86-elf)
                        ((or (eq? target 'obj) (eq? target 'elf-obj)) 'pass-144-backend-x86-elf-obj)
                        (else 'pass-140-backend-x86-64)))
         (pass-name (string-append "Backend Code Generation (" tgt-str ")")))
    (set-current-pass! pass-id)
    (with-call-frame pass-id lir-ast
      (lambda ()
        (if (pipeline-time-passes?)
            (let* ((t0 (current-time-monotonic-us))
                   (m0 (current-heap-alloc-bytes))
                   (res (cond
                          (c-target?
                           (emit-c lir-ast gc-mode))
                          ((eq? target 'aarch64)
                           (emit-aarch64 lir-ast gc-mode))
                          ((eq? target 'elf)
                           (emit-x86-64-elf lir-ast gc-mode))
                          ((or (eq? target 'obj) (eq? target 'elf-obj))
                           (emit-x86-64-elf-obj lir-ast gc-mode))
                          (else
                           (emit-x86-64 lir-ast gc-mode))))
                   (t1 (current-time-monotonic-us))
                   (m1 (current-heap-alloc-bytes))
                   (elapsed-us (let ((d (- t1 t0))) (if (< d 0) 0 d)))
                   (alloc-bytes (let ((d (- m1 m0))) (if (< d 0) 0 d))))
              (record-pass-timing! pass-id pass-name elapsed-us alloc-bytes)
              res)
            (cond
              (c-target?
               (emit-c lir-ast gc-mode))
              ((eq? target 'aarch64)
               (emit-aarch64 lir-ast gc-mode))
              ((eq? target 'elf)
               (emit-x86-64-elf lir-ast gc-mode))
              ((or (eq? target 'obj) (eq? target 'elf-obj))
               (emit-x86-64-elf-obj lir-ast gc-mode))
              (else
               (emit-x86-64 lir-ast gc-mode))))))))

;;; -----------------------------------------------------------------------
;;; Canonical LIR S-expression Serializer
;;; Resolves compiled quotation symbols under native AOT without '?' masking
;;; -----------------------------------------------------------------------

(define *lir-known-symbols*
  '((%lir-program . "%lir-program")
    (%lir-functions . "%lir-functions")
    (%lir-function . "%lir-function")
    (%lir-main . "%lir-main")
    (strings . "strings")
    (stackmaps . "stackmaps")
    (frame-size . "frame-size")
    (body . "body")
    (params . "params")
    (%mov . "%mov")
    (%load . "%load")
    (%store . "%store")
    (%add . "%add")
    (%sub . "%sub")
    (%mul . "%mul")
    (%div . "%div")
    (%cmp . "%cmp")
    (%jump . "%jump")
    (%jump-cond . "%jump-cond")
    (%label . "%label")
    (%call . "%call")
    (%call-closure . "%call-closure")
    (%return . "%return")
    (%alloc . "%alloc")
    (%safepoint . "%safepoint")
    (%rax . "%rax")
    (%rbx . "%rbx")
    (%rcx . "%rcx")
    (%rdx . "%rdx")
    (%rsi . "%rsi")
    (%rdi . "%rdi")
    (%rbp . "%rbp")
    (%rsp . "%rsp")
    (%r8 . "%r8")
    (%r9 . "%r9")
    (%r10 . "%r10")
    (%r11 . "%r11")
    (%r12 . "%r12")
    (%r13 . "%r13")
    (%r14 . "%r14")
    (%r15 . "%r15")
    (%al . "%al")
    (equal . "equal")
    (not-equal . "not-equal")
    (less . "less")
    (less-equal . "less-equal")
    (greater . "greater")
    (greater-equal . "greater-equal")
    (zero . "zero")
    (not-zero . "not-zero")))

(define (lir-symbol->string sym)
  (let ((entry (assq sym *lir-known-symbols*)))
    (if entry
        (cdr entry)
        (let ((s (symbol->string sym)))
          (if (string=? s "?")
              "?"
              s)))))

(define (dump-lir-token val)
  (cond
    ((symbol? val)
     (display (lir-symbol->string val)))
    ((number? val)
     (display val))
    ((string? val)
     (write val))
    ((boolean? val)
     (display (if val "#t" "#f")))
    ((null? val)
     (display "()"))
    ((pair? val)
     (display "(")
     (let loop ((curr val) (first? #t))
       (cond
         ((null? curr)
          (display ")"))
         ((pair? curr)
          (if (not first?) (display " "))
          (dump-lir-token (car curr))
          (loop (cdr curr) #f))
         (else
          (display " . ")
          (dump-lir-token curr)
          (display ")")))))
    (else
     (write val))))

(define (dump-lir-ast lir-ast)
  (dump-lir-token lir-ast)
  (newline))

(define (print-compiler-help)
  (display "Usage: ulisp [OPTIONS] [FILE]\n\n")
  (display "Options:\n")
  (display "  -o <file>             Write output to <file> instead of standard output\n")
  (display "  -e <expr>             Compile Scheme expression string directly to target output\n")
  (display "  -S                    Emit assembly code (default for native backends)\n")
  (display "  -c, --target-obj      Compile to ELF64 relocatable object file (.o, ET_REL)\n")
  (display "  --as [--64]           Assemble x86-64 Intel-syntax assembly (.s) to ELF64 object (.o)\n")
  (display "  --ld                  Static linker: link multiple ELF64 objects (.o) into executable\n")
  (display "  --target-elf          Emit standalone ELF64 static executable directly\n")
  (display "  -g                    Generate minimal DWARF debug information for GDB / perf\n")
  (display "  -b, --target <tgt>    Specify compilation target (x86_64, obj, elf, c, aarch64, lir)\n")
  (display "  -O0, -O1, -O2         Optimization level (0: minimal, 1: standard, 2: aggressive)\n")
  (display "  -v, --verbose         Enable verbose diagnostic messages to stderr\n")
  (display "  -q, --quiet           Suppress warning and non-essential messages\n")
  (display "  --time-passes         Print execution time and memory report for passes to stderr\n")
  (display "  --dump-ir[=<pass>]    Dump intermediate representations to stderr\n")
  (display "  --allow-extern        Allow external unresolved symbols in module linking\n")
  (display "  --module-name <name>  Specify compilation module name\n")
  (display "  --nostdlib            Disable automatic standard library prelude and linking\n")
  (display "  -h, --help            Display this help information and exit\n")
  (display "  -V, --version         Display compiler version and target information and exit\n\n")
  (display "Arguments:\n")
  (display "  FILE                  Input Scheme source file (defaults to standard input or '-')\n"))

(define (print-compiler-version)
  (display "ULisp AOT Native Compiler 2.0 (x86-64 / AArch64 / C)\n")
  (display "Copyright (c) 2026 The ULisp Authors.\n"))

(define (parse-cli-arguments args)
  (let loop ((rest args)
             (in-file #f)
             (in-files '())
             (out-file #f)
             (inline-expr #f)
             (target #f)
             (entry-sym #f)
             (opt-level #f)
             (verbose #f)
             (quiet #f)
             (time-passes #f)
             (dump-ir #f)
             (allow-extern #f)
             (module-name #f)
             (nostdlib #f))
    (if (null? rest)
        (list in-file out-file inline-expr target opt-level verbose quiet time-passes dump-ir allow-extern module-name (reverse in-files) entry-sym nostdlib)
        (let ((arg (car rest)))
          (cond
            ((or (string=? arg "-h") (string=? arg "--help"))
             (print-compiler-help)
             (exit 0))
            ((or (string=? arg "-V") (string=? arg "--version"))
             (print-compiler-version)
             (exit 0))
            ((string=? arg "--nostdlib")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name #t))
            ((string=? arg "-o")
             (if (pair? (cdr rest))
                 (loop (cddr rest) in-file in-files (cadr rest) inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib)
                 (begin
                   (display-stderr "ulisp: error: -o requires an argument\n")
                   (exit 1))))
            ((and (> (string-length arg) 2) (string-starts-with? arg "-o"))
             (loop (cdr rest) in-file in-files (substring arg 2 (string-length arg)) inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string-starts-with? arg "--output=")
             (loop (cdr rest) in-file in-files (substring arg 9 (string-length arg)) inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "--ld")
             (loop (cdr rest) in-file in-files out-file inline-expr 'ld-mode entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "-static") (string=? arg "-s"))
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "-m")
             (if (pair? (cdr rest))
                 (loop (cddr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib)
                 (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib)))
            ((and (> (string-length arg) 2) (string-starts-with? arg "-m") (not (string-starts-with? arg "--module")))
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "-e") (string=? arg "--entry"))
             (if (pair? (cdr rest))
                 (if (eq? target 'ld-mode)
                     (loop (cddr rest) in-file in-files out-file inline-expr target (cadr rest) opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib)
                     (loop (cddr rest) in-file in-files out-file (cadr rest) target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
                 (begin
                   (display-stderr "ulisp: error: -e requires an argument\n")
                   (exit 1))))
            ((string-starts-with? arg "--entry=")
             (loop (cdr rest) in-file in-files out-file inline-expr target (substring arg 8 (string-length arg)) opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string-starts-with? arg "--eval=")
             (loop (cdr rest) in-file in-files out-file (substring arg 7 (string-length arg)) target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "--target-elf") (string=? arg "-elf"))
             (loop (cdr rest) in-file in-files out-file inline-expr 'elf entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "-c") (string=? arg "--target-obj") (string=? arg "-obj"))
             (loop (cdr rest) in-file in-files out-file inline-expr 'obj entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "--as")
             (loop (cdr rest) in-file in-files out-file inline-expr 'as-mode entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "--64")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "--target-asm") (string=? arg "-S"))
             (loop (cdr rest) in-file in-files out-file inline-expr 'x86_64 entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "-g") (string=? arg "--debug-symbols") (string=? arg "-gline-tables-only"))
             (enable-debug-symbols!)
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "--target-lir")
             (loop (cdr rest) in-file in-files out-file inline-expr 'lir entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "-b") (string=? arg "-t") (string=? arg "--target"))
             (if (pair? (cdr rest))
                 (loop (cddr rest) in-file in-files out-file inline-expr (string->symbol (cadr rest)) entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib)
                 (begin
                   (display-stderr "ulisp: error: target option requires an argument\n")
                   (exit 1))))
            ((string-starts-with? arg "--target=")
             (loop (cdr rest) in-file in-files out-file inline-expr (string->symbol (substring arg 9 (string-length arg))) entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "-O0")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym 0 verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "-O1")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym 1 verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "-O2")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym 2 verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "-v") (string=? arg "--verbose"))
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level #t quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((or (string=? arg "-q") (string=? arg "--quiet"))
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose #t time-passes dump-ir allow-extern module-name nostdlib))
            ((string=? arg "--time-passes")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet #t dump-ir allow-extern module-name nostdlib))
            ((string=? arg "--dump-ir")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes #t allow-extern module-name nostdlib))
            ((string-starts-with? arg "--dump-ir=")
             (let ((pname (string->symbol (substring arg 10 (string-length arg)))))
               (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes pname allow-extern module-name nostdlib)))
            ((string=? arg "--allow-extern")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir #t module-name nostdlib))
            ((string=? arg "--module-name")
             (if (pair? (cdr rest))
                 (loop (cddr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern (cadr rest) nostdlib)
                 (begin
                   (display-stderr "ulisp: error: --module-name requires an argument\n")
                   (exit 1))))
            ((string-starts-with? arg "--module-name=")
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern (substring arg 14 (string-length arg)) nostdlib))
            ((string=? arg "-")
             (loop (cdr rest) "-" (cons "-" in-files) out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            ((not (string-starts-with? arg "-"))
             (loop (cdr rest) arg (cons arg in-files) out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib))
            (else
             (loop (cdr rest) in-file in-files out-file inline-expr target entry-sym opt-level verbose quiet time-passes dump-ir allow-extern module-name nostdlib)))))))

(define (ensure-forms-source-loc forms file)
  (if (or (not file) (string=? file "-") (eq? file 'none))
      forms
      (let loop ((fs forms) (line 1) (acc '()))
        (if (null? fs)
            (reverse acc)
            (let ((f (car fs)))
              (if (source-loc? f)
                  (loop (cdr fs) (source-loc-line f) (cons f acc))
                  (loop (cdr fs) (+ line 1) (cons (list '%source-loc file line 1 f) acc))))))))

(define (read-all-forms-from-string str)
  (let ((p (open-input-string str)))
    (let loop ((acc '()))
      (let ((expr (read p)))
        (if (eof-object? expr)
            (reverse acc)
            (loop (cons (sanitize-reader-form expr) acc)))))))

;;; -----------------------------------------------------------------------
;;; Lazy Output Redirection Helper (Issue #785)
;;; Delays file creation until frontend & LIR analysis succeed to avoid creating empty/stale output files
;;; -----------------------------------------------------------------------
(define (open-and-redirect-output-file! cli-out-file)
  (if (and cli-out-file (not (string=? cli-out-file "-")) (not (car *cli-active-output-file*)))
      (begin
        (set-car! *cli-active-output-file* cli-out-file)
        (let* ((initial-mode 420) ; Open initially as 0644 non-executable
               (out-fd (sys-open cli-out-file 577 initial-mode)))
          (if (< out-fd 0)
              (begin
                (display-stderr (string-append "ulisp: error: cannot open output file: " cli-out-file "\n"))
                (compiler-abort-and-cleanup! 1))
              (begin
                (sys-dup2 out-fd 1)
                (sys-close out-fd)))))))

;;; -----------------------------------------------------------------------
;;; Standard Library & 1-Step Executable Link Pipeline Helpers (Issue #786)
;;; -----------------------------------------------------------------------
(define (file-readable? path)
  (if (not (string? path))
      #f
      (let ((fd (sys-open path 0 0)))
        (if (>= fd 0)
            (begin
              (sys-close fd)
              #t)
            #f))))

(define (extract-dirname path)
  (if (not (string? path))
      "."
      (let ((len (string-length path)))
        (let loop ((i (- len 1)))
          (cond
            ((< i 0) ".")
            ((char=? (string-ref path i) #\/)
             (if (= i 0) "/" (substring path 0 i)))
            (else (loop (- i 1))))))))

(define (find-ulisp-stdlib-object)
  (let* ((env-path (sys-getenv "ULISP_STDLIB"))
         (bin-path (if (pair? (command-line)) (car (command-line)) #f))
         (bin-dir (if bin-path (extract-dirname bin-path) #f))
         (parent (if bin-dir (extract-dirname bin-dir) #f))
         (c1 (if (and parent (not (string=? parent ".")))
                 (string-append parent "/build/ulisp_stdlib.o")
                 "build/ulisp_stdlib.o"))
         (c2 (if bin-dir (string-append bin-dir "/build/ulisp_stdlib.o") #f)))
    (cond
      ((and (string? env-path) (> (string-length env-path) 0) (file-readable? env-path))
       env-path)
      ((file-readable? "build/ulisp_stdlib.o")
       "build/ulisp_stdlib.o")
      ((file-readable? "ulisp/build/ulisp_stdlib.o")
       "ulisp/build/ulisp_stdlib.o")
      ((and c1 (file-readable? c1)) c1)
      ((and c2 (file-readable? c2)) c2)
      (else #f))))

(define (find-ulisp-stdlib-macros)
  (let* ((env-path (sys-getenv "ULISP_STDLIB_MACROS"))
         (bin-path (if (pair? (command-line)) (car (command-line)) #f))
         (bin-dir (if bin-path (extract-dirname bin-path) #f))
         (parent (if bin-dir (extract-dirname bin-dir) #f))
         (c1 (if (and parent (not (string=? parent ".")))
                 (string-append parent "/lib/stdlib_macros.scm")
                 "lib/stdlib_macros.scm"))
         (c2 (if bin-dir (string-append bin-dir "/lib/stdlib_macros.scm") #f)))
    (cond
      ((and (string? env-path) (> (string-length env-path) 0) (file-readable? env-path))
       env-path)
      ((file-readable? "lib/stdlib_macros.scm")
       "lib/stdlib_macros.scm")
      ((file-readable? "ulisp/lib/stdlib_macros.scm")
       "ulisp/lib/stdlib_macros.scm")
      ((and c1 (file-readable? c1)) c1)
      ((and c2 (file-readable? c2)) c2)
      (else #f))))

(define (forms-include-stdlib-macros? forms)
  (let loop ((fs forms))
    (if (null? fs)
        #f
        (let ((f (car fs)))
          (cond
            ((and (pair? f) (or (eq? (car f) 'include) (eq? (car f) 'include-ci)))
             (let ((paths (cdr f)))
               (let check-p ((ps paths))
                 (cond
                   ((null? ps) (loop (cdr fs)))
                   ((and (string? (car ps))
                         (or (string=? (car ps) "ulisp/lib/stdlib_macros.scm")
                             (string=? (car ps) "lib/stdlib_macros.scm")))
                    #t)
                   (else (check-p (cdr ps)))))))
            (else (loop (cdr fs))))))))

(define (resolve-default-target cli-target cli-out-file directive-target)
  (cond
    (cli-target cli-target)
    ((and cli-out-file (not (string=? cli-out-file "-")))
     (cond
       ((string-ends-with? cli-out-file ".s") 'x86_64)
       ((string-ends-with? cli-out-file ".o") 'obj)
       ((string-ends-with? cli-out-file ".lir") 'lir)
       ((string-ends-with? cli-out-file ".c") 'c)
       (else 'elf)))
    (else directive-target)))

;;; Entry point: CLI parsing and compilation through two-layer pipeline
(let* ((cmd-args (let ((cl (command-line)))
                   (if (pair? cl)
                       (cdr cl)
                       '())))
       (parsed (parse-cli-arguments cmd-args))
       (cli-in-file (car parsed))
       (cli-out-file (cadr parsed))
       (cli-inline-expr (caddr parsed))
       (cli-target (cadddr parsed))
       (cli-opt-level (car (cddddr parsed)))
       (cli-verbose (cadr (cddddr parsed)))
       (cli-quiet (caddr (cddddr parsed)))
       (cli-time-passes (cadddr (cddddr parsed)))
       (cli-dump-ir (car (cddddr (cddddr parsed))))
       (cli-allow-extern (cadr (cddddr (cddddr parsed))))
       (cli-module-name (caddr (cddddr (cddddr parsed))))
       (cli-in-files (car (cdddr (cddddr (cddddr parsed)))))
       (cli-entry-sym (cadr (cdddr (cddddr (cddddr parsed)))))
       (cli-nostdlib (caddr (cdddr (cddddr (cddddr parsed))))))

  ;; 1. Setup CLI flags
  (if cli-opt-level (set-pipeline-opt-level! cli-opt-level))
  (if cli-time-passes (enable-pipeline-time-passes!))
  (if cli-dump-ir (set-pipeline-dump-ir! cli-dump-ir))
  (if cli-allow-extern (set-allow-extern-symbols! #t))
  (if cli-nostdlib (set-stdlib-enabled! #f))
  (if cli-module-name
      (begin
        (set-module-mode! #t)
        (set-allow-extern-symbols! #t)
        (set-current-module-id! cli-module-name)))

  ;; 2. Lazy Output Redirection (called later upon successful LIR compilation)

  ;; 3. Redirect stdin if input file is specified (and not -)
  (if (and cli-in-file (not (string=? cli-in-file "-")) (not (eq? cli-target 'ld-mode)))
      (let ((in-fd (sys-open cli-in-file 0 0)))
        (if (< in-fd 0)
            (begin
              (display-stderr (string-append "ulisp: error: cannot open input file: " cli-in-file "\n"))
              (compiler-abort-and-cleanup! 1))
            (begin
              (sys-dup2 in-fd 0)
              (sys-close in-fd)))))

  ;; 3b. Builtin Assembler Mode (ulisp --as [--64] [input.s] [-o output.o])
  (if (eq? cli-target 'as-mode)
      (begin
        (open-and-redirect-output-file! cli-out-file)
        (assemble-stream-to-elf-obj)
        (set-car! *cli-active-output-file* #f)
        (exit 0)))

  ;; 3c. Builtin Static Linker Mode (ulisp --ld [options] obj1.o [obj2.o ...] [-o output])
  (if (eq? cli-target 'ld-mode)
      (begin
        (open-and-redirect-output-file! cli-out-file)
        (link-elf64-objects-to-file cli-in-files cli-out-file cli-entry-sym)
        (if (and cli-out-file (not (string=? cli-out-file "-")))
            (sys-chmod cli-out-file 493))
        (set-car! *cli-active-output-file* #f)
        (exit 0)))

  ;; 4. Read forms
  (let* ((src-name (if (and cli-in-file (not (string=? cli-in-file "-"))) cli-in-file "stdin.scm"))
         (dbg? (debug-symbols-enabled?))
         (raw (cond
                (cli-inline-expr (read-all-forms-from-string cli-inline-expr))
                (dbg?
                 (let* ((text (read-all-chars-to-string))
                        (starts (scan-toplevel-datum-starts text))
                        (plain (read-all-forms-from-string text)))
                   (wrap-forms-with-locs plain starts src-name)))
                (else (read-all-forms))))
         (directives (extract-directives-and-forms raw))
         (target (resolve-default-target cli-target cli-out-file (car directives)))
         (dummy-target-set (set-current-target-arch! target))
         (gc-mode (cadr directives))
         (prelude-needed? (and (not cli-nostdlib)
                               (or (eq? target 'elf) (eq? target 'obj))))
         (macros-path (if prelude-needed? (find-ulisp-stdlib-macros) #f))
         (actual-raw (if (and prelude-needed? macros-path (not (forms-include-stdlib-macros? raw)))
                         (cons (list 'include macros-path) raw)
                         raw))
         (actual-directives (if (eq? actual-raw raw)
                                directives
                                (extract-directives-and-forms actual-raw)))
         (forms (if (and dbg? (not cli-inline-expr))
                    (begin
                      (set-current-source-file! src-name)
                      (register-source-file! src-name)
                      (rewrap-forms-with-locs (caddr actual-directives)))
                    (caddr actual-directives)))
         (verify-mode (cadddr actual-directives))
         (trace-mode (car (cddddr actual-directives)))
         (debug-mode (if (> (length actual-directives) 5) (car (cdr (cddddr actual-directives))) #f)))
    (if debug-mode
        (enable-call-stack-trace!))
    (if (not (null? forms))
        (cond
          ;; 1. LIR Intermediate Output Mode (--target-lir or (!target lir))
          ((eq? target 'lir)
           (let ((lir (compile-to-lir forms verify-mode trace-mode)))
             (open-and-redirect-output-file! cli-out-file)
             (dump-lir-ast lir)
             (if (pipeline-time-passes?)
                 (print-pass-timing-report))))
          ;; 2. Direct LIR Ingestion Mode (Input is already a Canonical LIR S-expression)
          ((and (pair? forms) (pair? (car forms)) (eq? (caar forms) '%lir-program))
           (let ((lir (car forms)))
             (reset-pass-timings!)
             (if verify-mode
                 (begin
                   (enable-verifier!)
                   (verify-pass-output 'lir lir)))
             (open-and-redirect-output-file! cli-out-file)
             (compile-backend lir target gc-mode)
             (if (pipeline-time-passes?)
                 (print-pass-timing-report))))
          ;; 3. Standard Full Pipeline (Frontend -> LIR -> Backend)
          (else
           (let ((lir (compile-to-lir forms verify-mode trace-mode)))
             (cond
               ((and (eq? target 'elf) (not cli-nostdlib))
                (let ((stdlib-path (find-ulisp-stdlib-object)))
                  (if (not stdlib-path)
                      (begin
                        (display-stderr "ulisp: error: cannot locate standard library object (ulisp_stdlib.o). Run 'make -C ulisp build/ulisp_stdlib.o' or set ULISP_STDLIB\n")
                        (compiler-abort-and-cleanup! 1))
                      (let* ((user-obj-bv (build-x86-64-elf-obj lir gc-mode))
                             (bin-bv (link-elf64-relocatable-objects (list user-obj-bv stdlib-path) cli-entry-sym)))
                        (open-and-redirect-output-file! cli-out-file)
                        (write-elf64-bytevector bin-bv)
                        (if (pipeline-time-passes?)
                            (print-pass-timing-report))))))
               (else
                (open-and-redirect-output-file! cli-out-file)
                (compile-backend lir target gc-mode)
                (if (pipeline-time-passes?)
                    (print-pass-timing-report))))))))
    ;; Flush and finalize output file permissions upon 100% success (Issue #785)
    (if (car *compiler-in-error*)
        (compiler-abort-and-cleanup! 1)
        (begin
          (if (and cli-out-file (not (string=? cli-out-file "-")) (eq? target 'elf))
              (cond
                ((and (procedure? sys-chmod) (not (null? sys-chmod)))
                 (sys-chmod cli-out-file 493)) ; 0755
                (else #f)))
          (set-car! *cli-active-output-file* #f)
          (exit 0)))))

