;;; =======================================================================
;;; ULisp Compiler Pass 2: Static Scope & Free-Variable Analysis Pass
;;; Conforms to DSN-33 Architecture Specification & Nanopass Framework DSL (Phase 3)
;;; Note: Operates strictly on Canonical Core AST produced by Pass 1 (desugar-all)
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: free-vars-acc
;;; Computes free variables using an accumulator thread across L_core AST.
;;; -----------------------------------------------------------------------
(define-pass free-vars-acc : L_core (ir bound acc) -> * (acc)
  (definitions
    (define (free-vars-list es b cur-acc)
      (if (null? es)
          cur-acc
          (free-vars-list (cdr es) b (free-vars-acc (car es) b cur-acc)))))
  (Expr : Expr (ir bound acc) -> * (acc)
    ((quote ,datum)
     acc)
    (,x (guard (symbol? x))
     (if (or (memq x bound) (memq x acc))
         acc
         (cons x acc)))
    (,c (guard (not (pair? c)))
     acc)
    ((if ,test ,then ,else-expr)
     (free-vars-acc else-expr bound (free-vars-acc then bound (free-vars-acc test bound acc))))
    ((if ,test ,then)
     (free-vars-acc then bound (free-vars-acc test bound acc)))
    ((begin ,es ...)
     (free-vars-list es bound acc))
    ((let ((,x* ,e*) ...) ,body)
     (let* ((b-acc (free-vars-list e* bound acc))
            (new-bound (set-union x* bound)))
       (free-vars-acc body new-bound b-acc)))
    ((letrec ((,x* ,e*) ...) ,body)
     (let* ((new-bound (set-union x* bound))
            (b-acc (free-vars-list e* new-bound acc)))
       (free-vars-acc body new-bound b-acc)))
    ((lambda (,params ...) ,body)
     (free-vars-acc body (set-union params bound) acc))
    ((%make-closure ,tag ,es ...)
     (free-vars-list es bound acc))
    ((%make-closure-env ,tag ,es ...)
     (free-vars-list es bound acc))
    ((%cont-fun ,f-name (,params ...) ,f-body ,in-body)
     (let* ((f-bound (set-union params bound))
            (f-acc (free-vars-acc f-body f-bound acc)))
       (free-vars-acc in-body bound f-acc)))
    ((%cont-call ,target ,es ...)
     (free-vars-list es bound acc))
    ((%with-handler ,h ,body)
     (free-vars-acc body bound (free-vars-acc h bound acc)))
    ((%raw-call/cc ,arg)
     (free-vars-acc arg bound acc))
    ((%call-with-values ,prod ,cons-fn)
     (free-vars-acc cons-fn bound (free-vars-acc prod bound acc)))
    ((%program ,defs ,main)
     (let* ((d-acc (let loop ((ds defs) (cur-acc acc))
                     (if (null? ds) cur-acc
                         (let ((d (car ds)))
                           (loop (cdr ds)
                                 (if (and (pair? d) (eq? (car d) 'define))
                                     (free-vars-acc (caddr d) bound cur-acc)
                                     (free-vars-acc d bound cur-acc))))))))
       (free-vars-acc main bound d-acc)))
    ((%values ,es ...)
     (free-vars-list es bound acc))
    ((,op ,args ...)
     (cond
       ((zero-arg-prim? op)
        acc)
       ((or (unary-prim? op) (or (binop-prim? op) (or (triop-prim? op) (septop-prim? op))))
        (free-vars-list args bound acc))
       (else
        (let ((op-acc (free-vars-acc op bound acc)))
          (free-vars-list args bound op-acc)))))))

(define (free-vars expr bound)
  (reverse (free-vars-acc expr bound '())))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: analyze-escapes
;;; Checks whether `var` escapes (appears in non-operator position) within `expr`.
;;; -----------------------------------------------------------------------
(define-pass analyze-escapes : L_core (ir var) -> * (escapes?)
  (Expr : Expr (ir var) -> * (escapes?)
    ((quote ,datum) #f)
    (,x (guard (symbol? x))
     (eq? x var))
    (,c (guard (not (pair? c)))
     #f)
    ((if ,test ,then ,else-expr)
     (or (Expr test var) (or (Expr then var) (Expr else-expr var))))
    ((if ,test ,then)
     (or (Expr test var) (Expr then var)))
    ((begin ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((let ((,x* ,e*) ...) ,body)
     (or (let loop ((rest e*))
           (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest)))))
         (if (memq var x*) #f (Expr body var))))
    ((letrec ((,x* ,e*) ...) ,body)
     (if (memq var x*)
         #f
         (or (let loop ((rest e*))
               (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest)))))
             (Expr body var))))
    ((lambda (,params ...) ,body)
     (if (memq var params)
         #f
         (if (memq var (free-vars body params))
             #t
             (Expr body var))))
    ((%make-closure ,tag ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((%make-closure-env ,tag ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((%with-handler ,h ,body)
     (or (Expr h var) (Expr body var)))
    ((%raw-call/cc ,arg)
     (Expr arg var))
    ((%call-with-values ,prod ,cons-fn)
     (or (Expr prod var) (Expr cons-fn var)))
    ((%values ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((%program ,defs ,main)
     (or (let loop ((ds defs))
           (and (pair? ds)
                (or (let ((d (car ds)))
                      (if (and (pair? d) (eq? (car d) 'define))
                          (Expr (caddr d) var)
                          (Expr d var)))
                    (loop (cdr ds)))))
         (Expr main var)))
    ((,op ,args ...)
     (if (eq? op var)
         (let loop ((as args))
           (and (pair? as) (or (Expr (car as) var) (loop (cdr as)))))
         (or (Expr op var)
             (let loop ((as args))
               (and (pair? as) (or (Expr (car as) var) (loop (cdr as))))))))))

(define (escapes? var expr)
  (analyze-escapes expr var))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: tail-calls-only?
;;; Checks whether all call sites of `var` in `expr` are in tail position.
;;; -----------------------------------------------------------------------
(define-pass tail-calls-only-impl : L_core (ir var tail?) -> * (ok?)
  (definitions
    (define (all-non-tail es v)
      (or (null? es)
          (and (tail-calls-only-impl (car es) v #f)
               (all-non-tail (cdr es) v)))))
  (Expr : Expr (ir var tail?) -> * (ok?)
    ((quote ,datum) #t)
    (,x (guard (symbol? x)) #t)
    (,c (guard (not (pair? c))) #t)
    ((if ,test ,then ,else-expr)
     (and (tail-calls-only-impl test var #f)
          (tail-calls-only-impl then var tail?)
          (tail-calls-only-impl else-expr var tail?)))
    ((if ,test ,then)
     (and (tail-calls-only-impl test var #f)
          (tail-calls-only-impl then var tail?)))
    ((begin ,es ...)
     (let loop ((rest es))
       (cond
         ((null? rest) #t)
         ((null? (cdr rest)) (tail-calls-only-impl (car rest) var tail?))
         (else (and (tail-calls-only-impl (car rest) var #f) (loop (cdr rest)))))))
    ((let ((,x* ,e*) ...) ,body)
     (and (all-non-tail e* var)
          (if (memq var x*) #t (tail-calls-only-impl body var tail?))))
    ((letrec ((,x* ,e*) ...) ,body)
     (if (memq var x*)
         #t
         (and (all-non-tail e* var)
              (tail-calls-only-impl body var tail?))))
    ((lambda (,params ...) ,body)
     (if (memq var params) #t (tail-calls-only-impl body var #t)))
    ((%with-handler ,h ,body)
     (and (tail-calls-only-impl h var #f) (tail-calls-only-impl body var #f)))
    ((%raw-call/cc ,arg)
     (tail-calls-only-impl arg var #f))
    ((%call-with-values ,prod ,cons-fn)
     (and (tail-calls-only-impl prod var #f) (tail-calls-only-impl cons-fn var #f)))
    ((%values ,es ...)
     (all-non-tail es var))
    ((%program ,defs ,main)
     (and (let loop ((ds defs))
            (or (null? ds)
                (let ((d (car ds)))
                  (and (if (and (pair? d) (eq? (car d) 'define))
                           (tail-calls-only-impl (caddr d) var #f)
                           (tail-calls-only-impl d var #f))
                       (loop (cdr ds))))))
          (tail-calls-only-impl main var tail?)))
    ((,op ,args ...)
     (if (eq? op var)
         (and tail? (all-non-tail args var))
         (and (tail-calls-only-impl op var #f) (all-non-tail args var))))))

(define (tail-calls-only? var expr)
  (tail-calls-only-impl expr var #t))

;;; Checks whether a binding `(var val)` in `(letrec ... body)` is contifiable.
(define (contifiable-binding? var val body)
  (and (pair? val)
       (eq? (car val) 'lambda)
       (pair? (cdr val))
       (pair? (cddr val))
       (not (escapes? var body))
       (not (escapes? var (caddr val)))
       (tail-calls-only? var body)
       (tail-calls-only? var (caddr val))))

;;; -----------------------------------------------------------------------
;;; Static Arity Checker (Issue #629)
;;; Validates call sites against builtin primitives and known procedures.
;;; -----------------------------------------------------------------------

(define (ast-contains-num-args? expr)
  (cond
    ((not (pair? expr)) #f)
    ((eq? (car expr) '%num-args) #t)
    (else
     (or (ast-contains-num-args? (car expr))
         (ast-contains-num-args? (cdr expr))))))

(define (formal-params-arity params)
  (cond
    ((symbol? params) (cons 'min 0))
    ((null? params) (cons 'exact 0))
    ((pair? params)
     (let loop ((ps params) (cnt 0))
       (cond
         ((null? ps) (cons 'exact cnt))
         ((symbol? ps) (cons 'min cnt))
         ((pair? ps) (loop (cdr ps) (+ cnt 1)))
         (else (cons 'exact cnt)))))
    (else #f)))

(define (check-arity-expr expr top-env local-env)
  (cond
    ((not (pair? expr)) #t)
    (else
     (let ((op (car expr)))
       (case op
         ((quote) #t)
         ((if)
          (check-arity-expr (cadr expr) top-env local-env)
          (check-arity-expr (caddr expr) top-env local-env)
          (if (pair? (cdddr expr))
              (check-arity-expr (cadddr expr) top-env local-env)
              #t))
         ((begin)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cdr expr)))
         ((let)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (new-local
                  (let loop ((bs bindings) (acc local-env))
                    (if (null? bs) acc
                        (let* ((b (car bs))
                               (var (car b))
                               (val (cadr b)))
                          (check-arity-expr val top-env local-env)
                          (if (and (pair? val)
                                   (eq? (car val) 'lambda)
                                   (pair? (cdr val))
                                   (not (and (pair? (cddr val)) (ast-contains-num-args? (caddr val)))))
                              (let ((ar (formal-params-arity (cadr val))))
                                (if ar (loop (cdr bs) (cons (cons var ar) acc))
                                    (loop (cdr bs) acc)))
                              (loop (cdr bs) acc)))))))
            (check-arity-expr body top-env new-local)))
         ((letrec)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (rec-local
                  (let loop ((bs bindings) (acc local-env))
                    (if (null? bs) acc
                        (let* ((b (car bs))
                               (var (car b))
                               (val (cadr b)))
                          (if (and (pair? val)
                                   (eq? (car val) 'lambda)
                                   (pair? (cdr val))
                                   (not (and (pair? (cddr val)) (ast-contains-num-args? (caddr val)))))
                              (let ((ar (formal-params-arity (cadr val))))
                                (if ar (loop (cdr bs) (cons (cons var ar) acc))
                                    (loop (cdr bs) acc)))
                              (loop (cdr bs) acc)))))))
            (for-each (lambda (b) (check-arity-expr (cadr b) top-env rec-local)) bindings)
            (check-arity-expr body top-env rec-local)))
         ((lambda)
          (let ((body (caddr expr)))
            (check-arity-expr body top-env local-env)))
         ((%make-closure %make-closure-env)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cddr expr)))
         ((%cont-fun)
          (let ((f-body (cadddr expr))
                (in-body (cadr (cdddr expr))))
            (check-arity-expr f-body top-env local-env)
            (check-arity-expr in-body top-env local-env)))
         ((%cont-call)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cddr expr)))
         ((%with-handler)
          (check-arity-expr (cadr expr) top-env local-env)
          (check-arity-expr (caddr expr) top-env local-env))
         ((%raw-call/cc)
          (check-arity-expr (cadr expr) top-env local-env))
         ((%call-with-values)
          (check-arity-expr (cadr expr) top-env local-env)
          (check-arity-expr (caddr expr) top-env local-env))
         ((%values)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cdr expr)))
         ((%program)
          (let* ((defs (cadr expr))
                 (main (caddr expr))
                 (new-top
                  (let loop ((ds defs) (acc top-env))
                    (if (null? ds) acc
                        (let ((d (car ds)))
                          (if (and (pair? d) (eq? (car d) 'define) (pair? (cdr d)) (pair? (cddr d)))
                              (let ((name (cadr d))
                                    (val (caddr d)))
                                (if (and (pair? val)
                                         (eq? (car val) 'lambda)
                                         (pair? (cdr val))
                                         (not (and (pair? (cddr val)) (ast-contains-num-args? (caddr val)))))
                                    (let ((ar (formal-params-arity (cadr val))))
                                      (if ar (loop (cdr ds) (cons (cons name ar) acc))
                                          (loop (cdr ds) acc)))
                                    (loop (cdr ds) acc)))
                              (loop (cdr ds) acc)))))))
            (for-each (lambda (d)
                        (if (and (pair? d) (eq? (car d) 'define))
                            (check-arity-expr (caddr d) new-top local-env)
                            (check-arity-expr d new-top local-env)))
                      defs)
            (check-arity-expr main new-top local-env)))
         (else
          ;; Call site: (op arg1 ... argN)
          (let* ((args (cdr expr))
                 (actual (length args)))
            (if (symbol? op)
                (let ((fixed (builtin-fixed-arity op))
                      (min-a (builtin-min-arity op))
                      (top-fn (assq op top-env))
                      (loc-fn (assq op local-env)))
                  (cond
                    ((eq? op '-)
                     (if (not (or (= actual 1) (= actual 2)))
                         (error (string-append "[ULISP ARITY ERROR] Builtin procedure '-' expects 1 or 2 argument(s), but got "
                                               (number->string actual))
                                expr)))
                    ((number? fixed)
                     (if (not (= actual fixed))
                         (error (string-append "[ULISP ARITY ERROR] Builtin procedure '"
                                               (symbol->string op) "' expects "
                                               (number->string fixed) " argument(s), but got "
                                               (number->string actual))
                                expr)))
                    ((number? min-a)
                     (if (< actual min-a)
                         (error (string-append "[ULISP ARITY ERROR] Builtin procedure '"
                                               (symbol->string op) "' requires at least "
                                               (number->string min-a) " argument(s), but got "
                                               (number->string actual))
                                expr)))
                    (loc-fn
                     (let ((sig (cdr loc-fn)))
                       (if (eq? (car sig) 'exact)
                           (if (not (= actual (cdr sig)))
                               (error (string-append "[ULISP ARITY ERROR] Local procedure '"
                                                     (symbol->string op) "' expects "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr))
                           (if (< actual (cdr sig))
                               (error (string-append "[ULISP ARITY ERROR] Local procedure '"
                                                     (symbol->string op) "' requires at least "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr)))))
                    (top-fn
                     (let ((sig (cdr top-fn)))
                       (if (eq? (car sig) 'exact)
                           (if (not (= actual (cdr sig)))
                               (error (string-append "[ULISP ARITY ERROR] Procedure '"
                                                     (symbol->string op) "' expects "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr))
                           (if (< actual (cdr sig))
                               (error (string-append "[ULISP ARITY ERROR] Procedure '"
                                                     (symbol->string op) "' requires at least "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr))))))))
            (if (pair? op)
                (check-arity-expr op top-env local-env))
            (for-each (lambda (a) (check-arity-expr a top-env local-env)) args))))))))

(define (check-arity-all ast)
  (check-arity-expr ast '() '())
  ast)
