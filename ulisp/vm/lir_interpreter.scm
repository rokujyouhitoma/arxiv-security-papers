;;; =======================================================================
;;; ULisp Canonical LIR Reference Virtual Machine (vm/lir_interpreter.scm)
;;; 100% Pure Scheme Implementation of Low-Level IR Evaluation Engine
;;; Conforms to DSN-33 §2, DSN-33-02 §7.1, DSN-38 §2 K3, and Issue #834
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; §1. Architecture Constants & 64-Bit Integer Arithmetic
;;; -----------------------------------------------------------------------

(define *lir-vm-mask-8*   #xff)
(define *lir-vm-sign-8*   #x80)
(define *lir-vm-mask-16*  #xffff)
(define *lir-vm-sign-16*  #x8000)
(define *lir-vm-mask-32*  #xffffffff)
(define *lir-vm-sign-32*  #x80000000)
(define *lir-vm-mask-64*  #xffffffffffffffff)
(define *lir-vm-sign-64*  #x8000000000000000)
(define *lir-vm-max-s64*  #x7fffffffffffffff)
(define *lir-vm-min-s64*  (- #x8000000000000000))

(define *lir-vm-default-mem-size* 16777216) ; 16MB linear memory
(define *lir-vm-null-page-limit*  4096)     ; 0..4095 protected NULL page
(define *lir-vm-heap-base*        65536)    ; 64KB heap start
(define *lir-vm-heap-limit*       8388608)  ; 8MB heap upper bound
(define *lir-vm-stack-limit*      8388608)  ; 8MB stack lower bound
(define *lir-vm-default-fuel*     10000000) ; 10M instructions limit

(define (lir-vm-u64 n)
  (bitwise-and n *lir-vm-mask-64*))

(define (lir-vm-s64 n)
  (let ((u (bitwise-and n *lir-vm-mask-64*)))
    (if (>= u *lir-vm-sign-64*)
        (- u (+ *lir-vm-mask-64* 1))
        u)))

(define (lir-vm-u32 n)
  (bitwise-and n *lir-vm-mask-32*))

(define (lir-vm-s32 n)
  (let ((u (bitwise-and n *lir-vm-mask-32*)))
    (if (>= u *lir-vm-sign-32*)
        (- u (+ *lir-vm-mask-32* 1))
        u)))

(define (lir-vm-u16 n)
  (bitwise-and n *lir-vm-mask-16*))

(define (lir-vm-s16 n)
  (let ((u (bitwise-and n *lir-vm-mask-16*)))
    (if (>= u *lir-vm-sign-16*)
        (- u (+ *lir-vm-mask-16* 1))
        u)))

(define (lir-vm-u8 n)
  (bitwise-and n *lir-vm-mask-8*))

(define (lir-vm-s8 n)
  (let ((u (bitwise-and n *lir-vm-mask-8*)))
    (if (>= u *lir-vm-sign-8*)
        (- u (+ *lir-vm-mask-8* 1))
        u)))

;;; -----------------------------------------------------------------------
;;; §2. Virtual Machine Data Structures (<lir-vm> & <vm-trap>)
;;; -----------------------------------------------------------------------

(define-record-type <vm-trap>
  (make-vm-trap type message pc details)
  vm-trap?
  (type vm-trap-type)
  (message vm-trap-message)
  (pc vm-trap-pc)
  (details vm-trap-details))

(define-record-type <lir-vm>
  (make-lir-vm-raw registers xmm-registers vregs flags memory heap-ptr
                   strings functions main-func current-fn current-block
                   pc call-stack status fuel step-count tracer last-trap
                   globals foreign-handlers f64-cells)
  lir-vm?
  (registers vm-registers-vector vm-set-registers-vector!)
  (xmm-registers vm-xmm-vector vm-set-xmm-vector!)
  (vregs vm-vregs-table vm-set-vregs-table!)
  (flags vm-flags-record vm-set-flags-record!)
  (memory vm-memory-bytes vm-set-memory-bytes!)
  (heap-ptr vm-heap-ptr vm-set-heap-ptr!)
  (strings vm-strings-table vm-set-strings-table!)
  (functions vm-functions-table vm-set-functions-table!)
  (main-func vm-main-func vm-set-main-func!)
  (current-fn vm-current-fn vm-set-current-fn!)
  (current-block vm-current-block vm-set-current-block!)
  (pc vm-pc vm-set-pc!)
  (call-stack vm-call-stack vm-set-call-stack!)
  (status vm-status vm-set-status!)
  (fuel vm-fuel vm-set-fuel!)
  (step-count vm-step-count vm-set-step-count!)
  (tracer vm-tracer vm-set-tracer!)
  (last-trap vm-last-trap vm-set-last-trap!)
  (globals vm-globals-table vm-set-globals-table!)
  (foreign-handlers vm-foreign-handlers vm-set-foreign-handlers!)
  (f64-cells vm-f64-cells vm-set-f64-cells!))

;;; Constructor
(define (make-lir-vm-with-size mem-size)
  (let* ((actual-size (if (> mem-size 65536) mem-size *lir-vm-default-mem-size*))
         (mem (make-bytevector actual-size 0))
         (regs (make-vector 16 0))
         (xmms (make-vector 16 0.0))
         (flags (vector 0 0 0 0))) ; #(ZF SF OF CF)
    (make-lir-vm-raw regs xmms '() flags mem
                     *lir-vm-heap-base* '() '() #f
                     '%main '%entry 0 '() 'ready
                     *lir-vm-default-fuel* 0 #f #f '() '() '())))

(define (make-lir-vm)
  (make-lir-vm-with-size *lir-vm-default-mem-size*))

;;; Trap Trigger
(define (vm-trigger-trap! vm type msg details)
  (let ((trap (make-vm-trap type msg (cons (vm-current-fn vm) (vm-pc vm)) details)))
    (vm-set-status! vm 'trapped)
    (vm-set-last-trap! vm trap)
    trap))

;;; -----------------------------------------------------------------------
;;; §3. Register Accessors (GPR, XMM, Virtual Registers)
;;; -----------------------------------------------------------------------

(define (gpr-name->index reg)
  (case reg
    ((%rax) 0)
    ((%rcx) 1)
    ((%rdx) 2)
    ((%rbx) 3)
    ((%rsp) 4)
    ((%rbp) 5)
    ((%rsi) 6)
    ((%rdi) 7)
    ((%r8)  8)
    ((%r9)  9)
    ((%r10) 10)
    ((%r11) 11)
    ((%r12) 12)
    ((%r13) 13)
    ((%r14) 14)
    ((%r15) 15)
    (else #f)))

(define (xmm-name->index reg)
  (case reg
    ((%xmm0)  0)
    ((%xmm1)  1)
    ((%xmm2)  2)
    ((%xmm3)  3)
    ((%xmm4)  4)
    ((%xmm5)  5)
    ((%xmm6)  6)
    ((%xmm7)  7)
    ((%xmm8)  8)
    ((%xmm9)  9)
    ((%xmm10) 10)
    ((%xmm11) 11)
    ((%xmm12) 12)
    ((%xmm13) 13)
    ((%xmm14) 14)
    ((%xmm15) 15)
    (else #f)))

(define (vm-get-reg vm reg)
  (let ((idx (gpr-name->index reg)))
    (if idx
        (vector-ref (vm-registers-vector vm) idx)
        (if (eq? reg '%al)
            (bitwise-and (vector-ref (vm-registers-vector vm) 0) #xff)
            (vm-get-vreg vm reg)))))

(define (vm-set-reg! vm reg val)
  (let ((idx (gpr-name->index reg)))
    (if idx
        (vector-set! (vm-registers-vector vm) idx (lir-vm-s64 val))
        (if (eq? reg '%al)
            (let* ((rax (vector-ref (vm-registers-vector vm) 0))
                   (new-rax (bitwise-ior (bitwise-and rax (bitwise-not #xff))
                                         (bitwise-and val #xff))))
              (vector-set! (vm-registers-vector vm) 0 (lir-vm-s64 new-rax)))
            (vm-set-vreg! vm reg val)))))

(define (vm-get-xmm vm reg)
  (let ((idx (xmm-name->index reg)))
    (if idx
        (vector-ref (vm-xmm-vector vm) idx)
        (vm-get-vreg vm reg))))

(define (vm-set-xmm! vm reg val)
  (let ((idx (xmm-name->index reg)))
    (if idx
        (vector-set! (vm-xmm-vector vm) idx (if (number? val) (exact->inexact val) 0.0))
        (vm-set-vreg vm reg val))))

(define (vm-get-vreg vm key)
  (let ((entry (assq key (vm-vregs-table vm))))
    (if entry (cdr entry) 0)))

(define (vm-set-vreg! vm key val)
  (let ((entry (assq key (vm-vregs-table vm))))
    (if entry
        (set-cdr! entry val)
        (vm-set-vregs-table! vm (cons (cons key val) (vm-vregs-table vm))))))

;;; Global variables (%global-ref / %global-set!)
(define (vm-lookup-global vm key)
  (let ((entry (assq key (vm-globals-table vm))))
    (if entry (cdr entry) #f)))

(define (vm-set-global! vm key val)
  (let ((entry (assq key (vm-globals-table vm))))
    (if entry
        (set-cdr! entry val)
        (vm-set-globals-table! vm (cons (cons key val) (vm-globals-table vm))))))

;;; Condition flags accessors
(define (vm-flag-zf vm) (vector-ref (vm-flags-record vm) 0))
(define (vm-flag-sf vm) (vector-ref (vm-flags-record vm) 1))
(define (vm-flag-of vm) (vector-ref (vm-flags-record vm) 2))
(define (vm-flag-cf vm) (vector-ref (vm-flags-record vm) 3))

(define (vm-set-flags! vm zf sf of cf)
  (let ((vec (vm-flags-record vm)))
    (vector-set! vec 0 zf)
    (vector-set! vec 1 sf)
    (vector-set! vec 2 of)
    (vector-set! vec 3 cf)))

;;; -----------------------------------------------------------------------
;;; §4. Memory Accessors & Little-Endian Integer Encoding (THREAT-834-1)
;;; -----------------------------------------------------------------------

(define (vm-mem-read-u8 vm addr)
  (let ((mem (vm-memory-bytes vm)))
    (if (or (< addr *lir-vm-null-page-limit*)
            (>= addr (bytevector-length mem)))
        (begin
          (vm-trigger-trap! vm 'out-of-bounds "Memory read out of bounds" addr)
          0)
        (bytevector-u8-ref mem addr))))

(define (vm-mem-write-u8! vm addr val)
  (let ((mem (vm-memory-bytes vm)))
    (if (or (< addr *lir-vm-null-page-limit*)
            (>= addr (bytevector-length mem)))
        (vm-trigger-trap! vm 'out-of-bounds "Memory write out of bounds" addr)
        (bytevector-u8-set! mem addr (lir-vm-u8 val)))))

(define (vm-mem-read-i8 vm addr)
  (lir-vm-s8 (vm-mem-read-u8 vm addr)))

(define (vm-mem-write-i8! vm addr val)
  (vm-mem-write-u8! vm addr (lir-vm-u8 val)))

(define (vm-mem-read-u16 vm addr)
  (let ((b0 (vm-mem-read-u8 vm addr))
        (b1 (vm-mem-read-u8 vm (+ addr 1))))
    (+ b0 (* b1 256))))

(define (vm-mem-read-i16 vm addr)
  (lir-vm-s16 (vm-mem-read-u16 vm addr)))

(define (vm-mem-write-u16! vm addr val)
  (let ((u (lir-vm-u16 val)))
    (vm-mem-write-u8! vm addr (bitwise-and u #xff))
    (vm-mem-write-u8! vm (+ addr 1) (bitwise-and (quotient u 256) #xff))))

(define (vm-mem-write-i16! vm addr val)
  (vm-mem-write-u16! vm addr (lir-vm-u16 val)))

(define (vm-mem-read-u32 vm addr)
  (let ((b0 (vm-mem-read-u8 vm addr))
        (b1 (vm-mem-read-u8 vm (+ addr 1)))
        (b2 (vm-mem-read-u8 vm (+ addr 2)))
        (b3 (vm-mem-read-u8 vm (+ addr 3))))
    (+ b0 (* b1 256) (* b2 65536) (* b3 16777216))))

(define (vm-mem-read-i32 vm addr)
  (lir-vm-s32 (vm-mem-read-u32 vm addr)))

(define (vm-mem-write-u32! vm addr val)
  (let ((u (lir-vm-u32 val)))
    (vm-mem-write-u8! vm addr (bitwise-and u #xff))
    (vm-mem-write-u8! vm (+ addr 1) (bitwise-and (quotient u 256) #xff))
    (vm-mem-write-u8! vm (+ addr 2) (bitwise-and (quotient u 65536) #xff))
    (vm-mem-write-u8! vm (+ addr 3) (bitwise-and (quotient u 16777216) #xff))))

(define (vm-mem-write-i32! vm addr val)
  (vm-mem-write-u32! vm addr (lir-vm-u32 val)))

(define (vm-mem-read-u64 vm addr)
  (let ((low (vm-mem-read-u32 vm addr))
        (high (vm-mem-read-u32 vm (+ addr 4))))
    (+ low (* high 4294967296))))

(define (vm-mem-read-i64 vm addr)
  (lir-vm-s64 (vm-mem-read-u64 vm addr)))

(define (vm-mem-write-u64! vm addr val)
  (let* ((u (lir-vm-u64 val))
         (low (bitwise-and u *lir-vm-mask-32*))
         (high (bitwise-and (arithmetic-shift u -32) *lir-vm-mask-32*)))
    (vm-mem-write-u32! vm addr low)
    (vm-mem-write-u32! vm (+ addr 4) high)))

(define (vm-mem-write-i64! vm addr val)
  (vm-mem-write-u64! vm addr (lir-vm-u64 val)))

;;; Float Memory Access (F64 Cells)
(define (vm-mem-read-f64 vm addr)
  (let ((entry (assv addr (vm-f64-cells vm))))
    (if entry
        (cdr entry)
        (exact->inexact (vm-mem-read-i64 vm addr)))))

(define (vm-mem-write-f64! vm addr val)
  (let ((flt (if (number? val) (exact->inexact val) 0.0)))
    (let ((entry (assv addr (vm-f64-cells vm))))
      (if entry
          (set-cdr! entry flt)
          (vm-set-f64-cells! vm (cons (cons addr flt) (vm-f64-cells vm)))))
    ;; Also mirror in linear memory integer representation
    (vm-mem-write-i64! vm addr (exact (truncate flt)))))

;;; -----------------------------------------------------------------------
;;; §5. Operand Evaluation & SIB Address Calculation
;;; -----------------------------------------------------------------------

(define (vm-lookup-string vm key)
  (let ((entry (assq key (vm-strings-table vm))))
    (if entry (cdr entry) #f)))

(define (vm-eval-sib vm sib)
  (let* ((idx-reg (cadr sib))
         (scale (caddr sib))
         (disp (cadddr sib))
         (idx-val (vm-eval-operand vm idx-reg)))
    (+ (* idx-val scale) disp)))

(define (vm-eval-offset vm offset)
  (cond
    ((integer? offset) offset)
    ((and (pair? offset) (eq? (car offset) '%sib))
     (vm-eval-sib vm offset))
    (else
     (vm-eval-operand vm offset))))

(define (vm-eval-operand vm opnd)
  (cond
    ((integer? opnd) opnd)
    ((symbol? opnd)
     (let ((g-idx (gpr-name->index opnd)))
       (if g-idx
           (vector-ref (vm-registers-vector vm) g-idx)
           (if (eq? opnd '%al)
               (bitwise-and (vector-ref (vm-registers-vector vm) 0) #xff)
               (let ((x-idx (xmm-name->index opnd)))
                 (if x-idx
                     (vector-ref (vm-xmm-vector vm) x-idx)
                     (let ((str-addr (vm-lookup-string vm opnd)))
                       (if str-addr
                           (+ str-addr 3) ; String tag is 3 in ULisp
                           (let ((glob (vm-lookup-global vm opnd)))
                             (if glob
                                 glob
                                 (vm-get-vreg vm opnd)))))))))))
    ((pair? opnd)
     (let ((tag (car opnd)))
       (case tag
         ((%reg)
          (if (and (pair? (cdr opnd)) (pair? (cddr opnd)))
              (vm-eval-operand vm (caddr opnd))
              (vm-eval-operand vm (cadr opnd))))
         ((%freg)
          (vm-eval-operand vm (cadr opnd)))
         ((%stack)
          (let* ((offset (cadr opnd))
                 (addr (+ (vm-get-reg vm '%rsp) offset)))
            (vm-mem-read-i64 vm addr)))
         ((%mem)
          (let* ((base (cadr opnd))
                 (offset (caddr opnd))
                 (base-val (vm-eval-operand vm base))
                 (off-val (vm-eval-offset vm offset))
                 (addr (+ base-val off-val)))
            (vm-mem-read-i64 vm addr)))
         (else
          (error "Unknown operand in LIR VM:" opnd)))))
    (else
     (error "Invalid operand type in LIR VM:" opnd))))

(define (vm-set-location! vm loc val)
  (cond
    ((symbol? loc)
     (let ((g-idx (gpr-name->index loc)))
       (if g-idx
           (vector-set! (vm-registers-vector vm) g-idx (lir-vm-s64 val))
           (if (eq? loc '%al)
               (let* ((rax (vector-ref (vm-registers-vector vm) 0))
                      (new-rax (bitwise-ior (bitwise-and rax (bitwise-not #xff))
                                            (bitwise-and val #xff))))
                 (vector-set! (vm-registers-vector vm) 0 (lir-vm-s64 new-rax)))
               (let ((x-idx (xmm-name->index loc)))
                 (if x-idx
                     (vector-set! (vm-xmm-vector vm) x-idx
                                  (if (number? val) (exact->inexact val) 0.0))
                     (vm-set-vreg! vm loc val)))))))
    ((pair? loc)
     (let ((tag (car loc)))
       (case tag
         ((%reg)
          (if (and (pair? (cdr loc)) (pair? (cddr loc)))
              (vm-set-location! vm (caddr loc) val)
              (vm-set-location! vm (cadr loc) val)))
         ((%freg)
          (vm-set-location! vm (cadr loc) val))
         ((%stack)
          (let* ((offset (cadr loc))
                 (addr (+ (vm-get-reg vm '%rsp) offset)))
            (vm-mem-write-i64! vm addr val)))
         ((%mem)
          (let* ((base (cadr loc))
                 (offset (caddr loc))
                 (base-val (vm-eval-operand vm base))
                 (off-val (vm-eval-offset vm offset))
                 (addr (+ base-val off-val)))
            (vm-mem-write-i64! vm addr val)))
         (else
          (error "Unknown destination operand in LIR VM:" loc)))))
    (else
     (error "Invalid destination operand in LIR VM:" loc))))

;;; -----------------------------------------------------------------------
;;; §6. Condition Codes Evaluation
;;; -----------------------------------------------------------------------

(define (vm-eval-condition-code vm raw-cc)
  (let ((cc (if (string? raw-cc) (string->symbol raw-cc) raw-cc))
        (zf (= (vm-flag-zf vm) 1))
        (sf (= (vm-flag-sf vm) 1))
        (of (= (vm-flag-of vm) 1))
        (cf (= (vm-flag-cf vm) 1)))
    (case cc
      ((e z eq equal zero je jz sete setz) zf)
      ((ne nz not-equal not-zero jne jnz setne setnz) (not zf))
      ((l less jl setl) (not (eq? sf of)))
      ((le less-equal jle setle) (or zf (not (eq? sf of))))
      ((g greater jg setg) (and (not zf) (eq? sf of)))
      ((ge greater-equal jge setge) (eq? sf of))
      ((b c carry below jb jc setb setc) cf)
      ((be below-equal jbe setbe) (or cf zf))
      ((a above ja seta) (and (not cf) (not zf)))
      ((ae above-equal jae nc setae setnc) (not cf))
      ((o overflow jo seto) of)
      ((no no-overflow jno setno) (not of))
      ((s sign js sets) sf)
      ((ns no-sign jns setns) (not sf))
      (else
       (error "Unknown condition code in LIR VM:" raw-cc)))))

;;; -----------------------------------------------------------------------
;;; §7. Arithmetic Flags Updating Helpers
;;; -----------------------------------------------------------------------

(define (vm-update-cmp-flags! vm val1 val2)
  (let* ((s1 (lir-vm-s64 val1))
         (s2 (lir-vm-s64 val2))
         (diff (- s1 s2))
         (s_diff (lir-vm-s64 diff))
         (u1 (lir-vm-u64 s1))
         (u2 (lir-vm-u64 s2))
         (zf (if (= s1 s2) 1 0))
         (sf (if (< s_diff 0) 1 0))
         (of (if (or (and (not (negative? s1)) (negative? s2) (negative? s_diff))
                     (and (negative? s1) (not (negative? s2)) (not (negative? s_diff))))
                 1 0))
         (cf (if (< u1 u2) 1 0)))
    (vm-set-flags! vm zf sf of cf)))

(define (vm-update-add-flags! vm s1 s2)
  (let* ((sum (+ s1 s2))
         (s_sum (lir-vm-s64 sum))
         (u_sum (+ (lir-vm-u64 s1) (lir-vm-u64 s2)))
         (zf (if (= s_sum 0) 1 0))
         (sf (if (< s_sum 0) 1 0))
         (of (if (or (and (not (negative? s1)) (not (negative? s2)) (negative? s_sum))
                     (and (negative? s1) (negative? s2) (not (negative? s_sum))))
                 1 0))
         (cf (if (> u_sum *lir-vm-mask-64*) 1 0)))
    (vm-set-flags! vm zf sf of cf)))

(define (vm-update-sub-flags! vm s1 s2)
  (let* ((diff (- s1 s2))
         (s_diff (lir-vm-s64 diff))
         (u1 (lir-vm-u64 s1))
         (u2 (lir-vm-u64 s2))
         (zf (if (= s_diff 0) 1 0))
         (sf (if (< s_diff 0) 1 0))
         (of (if (or (and (not (negative? s1)) (negative? s2) (negative? s_diff))
                     (and (negative? s1) (not (negative? s2)) (not (negative? s_diff))))
                 1 0))
         (cf (if (< u1 u2) 1 0)))
    (vm-set-flags! vm zf sf of cf)))

(define (vm-update-logic-flags! vm val)
  (let* ((s (lir-vm-s64 val))
         (zf (if (= s 0) 1 0))
         (sf (if (< s 0) 1 0)))
    (vm-set-flags! vm zf sf 0 0)))

;;; -----------------------------------------------------------------------
;;; §8. Program Loader & Block/Function Table Builder
;;; -----------------------------------------------------------------------

;;; Flatten nested %block forms into a linear instruction sequence
(define (flatten-lir-insts insts)
  (let loop ((is insts) (acc '()))
    (if (null? is)
        (reverse acc)
        (let ((inst (car is)))
          (if (and (pair? inst) (eq? (car inst) '%block) (pair? (cdddr inst)))
              (let* ((lbl (cadr inst))
                     (params (caddr inst))
                     (body (cdddr inst))
                     (header (list '%block lbl params))
                     (flat-body (flatten-lir-insts body)))
                (loop (cdr is) (append (reverse flat-body) (cons header acc))))
              (loop (cdr is) (cons inst acc)))))))

;;; Function Descriptor: (list 'func name params frame-size inst-vec label-map block-params)
(define (make-func-descriptor name params frame-size inst-list)
  (let* ((flat-list (flatten-lir-insts inst-list))
         (inst-vec (list->vector flat-list))
         (len (vector-length inst-vec))
         (label-map '())
         (block-params '()))
    (let loop ((i 0))
      (if (< i len)
          (let ((inst (vector-ref inst-vec i)))
            (if (pair? inst)
                (case (car inst)
                  ((%label)
                   (let ((lbl (cadr inst)))
                     (set! label-map (cons (cons lbl i) label-map))))
                  ((%block)
                   (let ((lbl (cadr inst))
                         (p (caddr inst)))
                     (set! label-map (cons (cons lbl i) label-map))
                     (set! block-params (cons (cons lbl p) block-params))))))
            (loop (+ i 1)))))
    (list 'func name params frame-size inst-vec label-map block-params)))

(define (func-name desc) (cadr desc))
(define (func-params desc) (caddr desc))
(define (func-frame-size desc) (cadddr desc))
(define (func-inst-vec desc) (list-ref desc 4))
(define (func-label-map desc) (list-ref desc 5))
(define (func-block-params desc) (list-ref desc 6))

(define (func-find-label-index desc lbl)
  (let ((entry (assq lbl (func-label-map desc))))
    (if entry (cdr entry) #f)))

(define (func-find-block-params desc lbl)
  (let ((entry (assq lbl (func-block-params desc))))
    (if entry (cdr entry) '())))

;;; Load LIR Program into VM
(define (lir-vm-load! vm prog)
  (if (or (not (pair? prog)) (not (eq? (car prog) '%lir-program)))
      (error "Invalid %lir-program:" prog))
  (let* ((strings-decl (cadr prog))
         (stackmaps-decl (caddr prog))
         (funcs-decl (cadddr prog))
         (main-decl (list-ref prog 4))
         ;; Strings loading
         (str-table '())
         (cur-str-addr *lir-vm-null-page-limit*))
    (if (and (pair? strings-decl) (eq? (car strings-decl) 'strings))
        (for-each
         (lambda (entry)
           (let* ((lbl (car entry))
                  (str (cadr entry))
                  (len (string-length str)))
             ;; Write 8-byte length header followed by string bytes and null terminator
             (vm-mem-write-i64! vm cur-str-addr len)
             (let loop ((i 0))
               (if (< i len)
                   (begin
                     (vm-mem-write-u8! vm (+ cur-str-addr 8 i) (char->integer (string-ref str i)))
                     (loop (+ i 1)))))
             (vm-mem-write-u8! vm (+ cur-str-addr 8 len) 0) ; Null terminator
             (set! str-table (cons (cons lbl (+ cur-str-addr 8)) str-table))
             (set! cur-str-addr (+ cur-str-addr (bitwise-and (+ len 16) -8)))))
         (cadr strings-decl)))
    (vm-set-strings-table! vm str-table)

    ;; Functions loading
    (let ((fn-table '()))
      (if (and (pair? funcs-decl) (eq? (car funcs-decl) '%lir-functions))
          (for-each
           (lambda (fn-form)
             (if (and (pair? fn-form) (eq? (car fn-form) '%lir-function))
                 (let* ((lbl (cadr fn-form))
                        (params-clause (caddr fn-form))
                        (frame-clause (cadddr fn-form))
                        (body-clause (list-ref fn-form 4))
                        (params (if (and (pair? params-clause) (eq? (car params-clause) 'params))
                                    (cadr params-clause)
                                    '()))
                        (frame-sz (if (and (pair? frame-clause) (eq? (car frame-clause) 'frame-size))
                                      (cadr frame-clause)
                                      0))
                        (body-insts (if (and (pair? body-clause) (eq? (car body-clause) 'body))
                                        (cdr body-clause)
                                        '()))
                        (desc (make-func-descriptor lbl params frame-sz body-insts)))
                   (set! fn-table (cons (cons lbl desc) fn-table)))))
           (cdr funcs-decl)))
      (vm-set-functions-table! vm fn-table))

    ;; Main loading
    (if (and (pair? main-decl) (eq? (car main-decl) '%lir-main))
        (let* ((frame-clause (cadr main-decl))
               (body-clause (caddr main-decl))
               (frame-sz (if (and (pair? frame-clause) (eq? (car frame-clause) 'frame-size))
                             (cadr frame-clause)
                             0))
               (body-insts (if (and (pair? body-clause) (eq? (car body-clause) 'body))
                               (cdr body-clause)
                               '()))
               (main-desc (make-func-descriptor '%main '() frame-sz body-insts)))
          (vm-set-main-func! vm main-desc)))

    ;; Initial Register & PC Setup
    (let ((top (- (bytevector-length (vm-memory-bytes vm)) 16)))
      (vm-set-reg! vm '%rsp top)
      (vm-set-reg! vm '%rbp top)
      (vm-set-reg! vm '%r12 *lir-vm-heap-base*) ; Heap pointer
      (vm-set-current-fn! vm '%main)
      (vm-set-current-block! vm '%entry)
      (vm-set-pc! vm 0)
      (vm-set-call-stack! vm '())
      (vm-set-status! vm 'ready)
      (vm-set-step-count! vm 0)
      (vm-set-last-trap! vm #f)
      vm)))

;;; -----------------------------------------------------------------------
;;; §9. Instruction Dispatcher & Execution Engine
;;; -----------------------------------------------------------------------

(define (vm-get-current-desc vm)
  (let ((fn (vm-current-fn vm)))
    (if (eq? fn '%main)
        (vm-main-func vm)
        (let ((entry (assq fn (vm-functions-table vm))))
          (if entry (cdr entry) #f)))))

(define (lir-vm-step! vm)
  (let ((st (vm-status vm)))
    (if (or (eq? st 'halted) (eq? st 'trapped))
        st
        (let ((f (vm-fuel vm)))
          (if (and f (<= f 0))
              (begin
                (vm-trigger-trap! vm 'out-of-fuel "Execution step limit exceeded (Fuel exhausted)" (vm-step-count vm))
                'trapped)
              (begin
                (if f (vm-set-fuel! vm (- f 1)))
                (vm-set-step-count! vm (+ (vm-step-count vm) 1))
                (vm-set-status! vm 'running)
                (let* ((desc (vm-get-current-desc vm)))
                  (if (not desc)
                      (begin
                        (vm-trigger-trap! vm 'undefined-target "Current function not found" (vm-current-fn vm))
                        'trapped)
                      (let* ((inst-vec (func-inst-vec desc))
                             (pc (vm-pc vm))
                             (len (vector-length inst-vec)))
                        (if (>= pc len)
                            ;; End of function instructions -> implicit %return
                            (vm-dispatch-return! vm #f)
                            (let* ((inst (vector-ref inst-vec pc)))
                              ;; Call tracer if registered
                              (if (vm-tracer vm)
                                  ((vm-tracer vm) vm inst))
                              ;; Advance PC past current instruction
                              (vm-set-pc! vm (+ pc 1))
                              ;; Execute instruction
                              (vm-dispatch-inst! vm desc inst)
                              (vm-status vm))))))))))))

(define (vm-dispatch-inst! vm desc inst)
  (if (pair? inst)
      (let ((op (car inst)))
        (case op
          ;; --- Labels & SSA Blocks ---
          ((%label)
           #t) ; No-op during sequential stepping

          ((%block)
           #t) ; Block params assigned on jump

          ;; --- Data Movement & Memory ---
          ((%mov)
           (let ((dst (cadr inst))
                 (src (caddr inst)))
             (let ((val (vm-eval-operand vm src)))
               (vm-set-location! vm dst val))))

          ((%load)
           (let* ((dst (cadr inst))
                  (base (caddr inst))
                  (offset (cadddr inst))
                  (base-val (vm-eval-operand vm base))
                  (off-val (vm-eval-offset vm offset))
                  (addr (+ base-val off-val))
                  (val (vm-mem-read-i64 vm addr)))
             (vm-set-location! vm dst val)))

          ((%store)
           (let* ((base (cadr inst))
                  (offset (caddr inst))
                  (src (cadddr inst))
                  (base-val (vm-eval-operand vm base))
                  (off-val (vm-eval-offset vm offset))
                  (addr (+ base-val off-val))
                  (val (vm-eval-operand vm src)))
             (vm-mem-write-i64! vm addr val)))

          ((%load-byte-zx)
           (let* ((dst (cadr inst))
                  (base (caddr inst))
                  (offset (cadddr inst))
                  (base-val (vm-eval-operand vm base))
                  (off-val (vm-eval-offset vm offset))
                  (addr (+ base-val off-val))
                  (val (vm-mem-read-u8 vm addr)))
             (vm-set-location! vm dst val)))

          ((%store-byte)
           (let* ((base (cadr inst))
                  (offset (caddr inst))
                  (src (cadddr inst))
                  (base-val (vm-eval-operand vm base))
                  (off-val (vm-eval-offset vm offset))
                  (addr (+ base-val off-val))
                  (val (vm-eval-operand vm src)))
             (vm-mem-write-u8! vm addr val)))

          ((%load-typed)
           (let* ((type (cadr inst))
                  (dst (caddr inst))
                  (base (cadddr inst))
                  (offset (list-ref inst 4))
                  (base-val (vm-eval-operand vm base))
                  (off-val (vm-eval-offset vm offset))
                  (addr (+ base-val off-val)))
             (case type
               ((i8)  (vm-set-location! vm dst (vm-mem-read-i8 vm addr)))
               ((u8)  (vm-set-location! vm dst (vm-mem-read-u8 vm addr)))
               ((i16) (vm-set-location! vm dst (vm-mem-read-i16 vm addr)))
               ((u16) (vm-set-location! vm dst (vm-mem-read-u16 vm addr)))
               ((i32) (vm-set-location! vm dst (vm-mem-read-i32 vm addr)))
               ((u32) (vm-set-location! vm dst (vm-mem-read-u32 vm addr)))
               ((i64) (vm-set-location! vm dst (vm-mem-read-i64 vm addr)))
               ((u64) (vm-set-location! vm dst (vm-mem-read-u64 vm addr)))
               ((ptr raw-bits scheme-val) (vm-set-location! vm dst (vm-mem-read-u64 vm addr)))
               ((f64) (vm-set-xmm! vm dst (vm-mem-read-f64 vm addr)))
               (else (error "Unsupported type in %load-typed:" type)))))

          ((%store-typed)
           (let* ((type (cadr inst))
                  (base (caddr inst))
                  (offset (cadddr inst))
                  (src (list-ref inst 4))
                  (base-val (vm-eval-operand vm base))
                  (off-val (vm-eval-offset vm offset))
                  (addr (+ base-val off-val))
                  (val (if (eq? type 'f64)
                           (vm-eval-operand vm src)
                           (vm-eval-operand vm src))))
             (case type
               ((i8)  (vm-mem-write-i8! vm addr val))
               ((u8)  (vm-mem-write-u8! vm addr val))
               ((i16) (vm-mem-write-i16! vm addr val))
               ((u16) (vm-mem-write-u16! vm addr val))
               ((i32) (vm-mem-write-i32! vm addr val))
               ((u32) (vm-mem-write-u32! vm addr val))
               ((i64) (vm-mem-write-i64! vm addr val))
               ((u64) (vm-mem-write-u64! vm addr val))
               ((ptr raw-bits scheme-val) (vm-mem-write-u64! vm addr val))
               ((f64) (vm-mem-write-f64! vm addr val))
               (else (error "Unsupported type in %store-typed:" type)))))

          ((%push)
           (let* ((src (cadr inst))
                  (val (vm-eval-operand vm src))
                  (new-rsp (- (vm-get-reg vm '%rsp) 8)))
             (vm-set-reg! vm '%rsp new-rsp)
             (vm-mem-write-i64! vm new-rsp val)))

          ((%pop)
           (let* ((dst (cadr inst))
                  (rsp (vm-get-reg vm '%rsp))
                  (val (vm-mem-read-i64 vm rsp))
                  (new-rsp (+ rsp 8)))
             (vm-set-location! vm dst val)
             (vm-set-reg! vm '%rsp new-rsp)))

          ((%str-ref)
           (let* ((dst (cadr inst))
                  (lbl (caddr inst))
                  (addr (vm-lookup-string vm lbl)))
             (if addr
                 (vm-set-location! vm dst (+ addr 3)) ; Add String tag 3
                 (vm-trigger-trap! vm 'undefined-target "String label not found" lbl))))

          ((%code-ref)
           (let* ((dst (cadr inst))
                  (lbl (caddr inst)))
             ;; Code address represented as a virtual reference / address
             (vm-set-location! vm dst 4096)))

          ((%global-ref)
           (let* ((dst (cadr inst))
                  (var (caddr inst))
                  (val (vm-lookup-global vm var)))
             (vm-set-location! vm dst (if val val 0))))

          ((%global-set!)
           (let* ((var (cadr inst))
                  (src (caddr inst))
                  (val (vm-eval-operand vm src)))
             (vm-set-global! vm var val)))

          ;; --- Arithmetic & Logic Operations ---
          ((%add %raw-add)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (v-dst (vm-eval-operand vm dst))
                  (v-src (vm-eval-operand vm src))
                  (s-dst (lir-vm-s64 v-dst))
                  (s-src (lir-vm-s64 v-src))
                  (res (+ s-dst s-src)))
             (vm-update-add-flags! vm s-dst s-src)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%sub %raw-sub)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (v-dst (vm-eval-operand vm dst))
                  (v-src (vm-eval-operand vm src))
                  (s-dst (lir-vm-s64 v-dst))
                  (s-src (lir-vm-s64 v-src))
                  (res (- s-dst s-src)))
             (vm-update-sub-flags! vm s-dst s-src)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%imul %raw-mul)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (v-dst (vm-eval-operand vm dst))
                  (v-src (vm-eval-operand vm src))
                  (s-dst (lir-vm-s64 v-dst))
                  (s-src (lir-vm-s64 v-src))
                  (prod (* s-dst s-src))
                  (of (if (or (< prod *lir-vm-min-s64*) (> prod *lir-vm-max-s64*)) 1 0)))
             (vm-set-flags! vm (if (= (lir-vm-s64 prod) 0) 1 0)
                            (if (< (lir-vm-s64 prod) 0) 1 0)
                            of of)
             (vm-set-location! vm dst (lir-vm-s64 prod))))

          ((%neg)
           (let* ((dst (cadr inst))
                  (v (vm-eval-operand vm dst))
                  (s (lir-vm-s64 v))
                  (res (- s)))
             (vm-update-sub-flags! vm 0 s)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%inc)
           (let* ((dst (cadr inst))
                  (v (vm-eval-operand vm dst))
                  (s (lir-vm-s64 v))
                  (res (+ s 1)))
             (vm-update-add-flags! vm s 1)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%cqo)
           (let* ((rax (vm-get-reg vm '%rax))
                  (rdx (if (negative? (lir-vm-s64 rax)) -1 0)))
             (vm-set-reg! vm '%rdx rdx)))

          ((%idiv)
           (let* ((src (cadr inst))
                  (s-src (lir-vm-s64 (vm-eval-operand vm src))))
             (if (= s-src 0)
                 (vm-trigger-trap! vm 'division-by-zero "Integer division by zero" src)
                 (let* ((s-rax (lir-vm-s64 (vm-get-reg vm '%rax)))
                        (q (quotient s-rax s-src))
                        (r (remainder s-rax s-src)))
                   (vm-set-reg! vm '%rax (lir-vm-s64 q))
                   (vm-set-reg! vm '%rdx (lir-vm-s64 r))))))

          ((%udiv)
           (let* ((src (cadr inst))
                  (u-src (lir-vm-u64 (vm-eval-operand vm src))))
             (if (= u-src 0)
                 (vm-trigger-trap! vm 'division-by-zero "Unsigned division by zero" src)
                 (let* ((u-rax (lir-vm-u64 (vm-get-reg vm '%rax)))
                        (q (quotient u-rax u-src))
                        (r (modulo u-rax u-src)))
                   (vm-set-reg! vm '%rax (lir-vm-u64 q))
                   (vm-set-reg! vm '%rdx (lir-vm-u64 r))))))

          ((%urem)
           (let* ((src (cadr inst))
                  (u-src (lir-vm-u64 (vm-eval-operand vm src))))
             (if (= u-src 0)
                 (vm-trigger-trap! vm 'division-by-zero "Unsigned remainder by zero" src)
                 (let* ((u-rax (lir-vm-u64 (vm-get-reg vm '%rax)))
                        (r (modulo u-rax u-src)))
                   (vm-set-reg! vm '%rax (lir-vm-u64 r))))))

          ((%shl)
           (let* ((dst (cadr inst))
                  (cnt-op (caddr inst))
                  (v-dst (vm-eval-operand vm dst))
                  (cnt (bitwise-and (lir-vm-u64 (vm-eval-operand vm cnt-op)) 63))
                  (res (lir-vm-u64 (arithmetic-shift (lir-vm-u64 v-dst) cnt))))
             (vm-update-logic-flags! vm res)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%shr)
           (let* ((dst (cadr inst))
                  (cnt-op (caddr inst))
                  (v-dst (vm-eval-operand vm dst))
                  (cnt (bitwise-and (lir-vm-u64 (vm-eval-operand vm cnt-op)) 63))
                  (res (arithmetic-shift (lir-vm-u64 v-dst) (- cnt))))
             (vm-update-logic-flags! vm res)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%sar)
           (let* ((dst (cadr inst))
                  (cnt-op (caddr inst))
                  (v-dst (vm-eval-operand vm dst))
                  (cnt (bitwise-and (lir-vm-u64 (vm-eval-operand vm cnt-op)) 63))
                  (res (lir-vm-s64 (arithmetic-shift (lir-vm-s64 v-dst) (- cnt)))))
             (vm-update-logic-flags! vm res)
             (vm-set-location! vm dst res)))

          ((%bit-and)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (v1 (vm-eval-operand vm dst))
                  (v2 (vm-eval-operand vm src))
                  (res (bitwise-and (lir-vm-u64 v1) (lir-vm-u64 v2))))
             (vm-update-logic-flags! vm res)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%bit-or)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (v1 (vm-eval-operand vm dst))
                  (v2 (vm-eval-operand vm src))
                  (res (bitwise-ior (lir-vm-u64 v1) (lir-vm-u64 v2))))
             (vm-update-logic-flags! vm res)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%bit-xor)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (v1 (vm-eval-operand vm dst))
                  (v2 (vm-eval-operand vm src))
                  (res (bitwise-xor (lir-vm-u64 v1) (lir-vm-u64 v2))))
             (vm-update-logic-flags! vm res)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%not)
           (let* ((dst (cadr inst))
                  (v (vm-eval-operand vm dst))
                  (res (bitwise-xor (lir-vm-u64 v) *lir-vm-mask-64*)))
             (vm-update-logic-flags! vm res)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ;; --- Issue #828: Overflow-Checked & Unsigned Arithmetic ---
          ((%add-overflow)
           (let* ((four-op? (= (length inst) 5))
                  (dst-val (cadr inst))
                  (dst-flag (if four-op? (caddr inst) #f))
                  (src1 (if four-op? (cadddr inst) (cadr inst)))
                  (src2 (if four-op? (car (cddddr inst)) (caddr inst)))
                  (s1 (lir-vm-s64 (vm-eval-operand vm src1)))
                  (s2 (lir-vm-s64 (vm-eval-operand vm src2)))
                  (sum (+ s1 s2))
                  (s_sum (lir-vm-s64 sum))
                  (of (if (or (< sum *lir-vm-min-s64*) (> sum *lir-vm-max-s64*)) 1 0)))
             (vm-set-flags! vm (if (= s_sum 0) 1 0) (if (< s_sum 0) 1 0) of 0)
             (vm-set-location! vm dst-val s_sum)
             (if dst-flag (vm-set-location! vm dst-flag of))))

          ((%sub-overflow)
           (let* ((four-op? (= (length inst) 5))
                  (dst-val (cadr inst))
                  (dst-flag (if four-op? (caddr inst) #f))
                  (src1 (if four-op? (cadddr inst) (cadr inst)))
                  (src2 (if four-op? (car (cddddr inst)) (caddr inst)))
                  (s1 (lir-vm-s64 (vm-eval-operand vm src1)))
                  (s2 (lir-vm-s64 (vm-eval-operand vm src2)))
                  (diff (- s1 s2))
                  (s_diff (lir-vm-s64 diff))
                  (of (if (or (< diff *lir-vm-min-s64*) (> diff *lir-vm-max-s64*)) 1 0)))
             (vm-set-flags! vm (if (= s_diff 0) 1 0) (if (< s_diff 0) 1 0) of 0)
             (vm-set-location! vm dst-val s_diff)
             (if dst-flag (vm-set-location! vm dst-flag of))))

          ((%mul-overflow)
           (let* ((four-op? (= (length inst) 5))
                  (dst-val (cadr inst))
                  (dst-flag (if four-op? (caddr inst) #f))
                  (src1 (if four-op? (cadddr inst) (cadr inst)))
                  (src2 (if four-op? (car (cddddr inst)) (caddr inst)))
                  (s1 (lir-vm-s64 (vm-eval-operand vm src1)))
                  (s2 (lir-vm-s64 (vm-eval-operand vm src2)))
                  (prod (* s1 s2))
                  (s_prod (lir-vm-s64 prod))
                  (of (if (or (< prod *lir-vm-min-s64*) (> prod *lir-vm-max-s64*)) 1 0)))
             (vm-set-flags! vm (if (= s_prod 0) 1 0) (if (< s_prod 0) 1 0) of of)
             (vm-set-location! vm dst-val s_prod)
             (if dst-flag (vm-set-location! vm dst-flag of))))

          ((%uadd)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (u1 (lir-vm-u64 (vm-eval-operand vm dst)))
                  (u2 (lir-vm-u64 (vm-eval-operand vm src)))
                  (sum (+ u1 u2))
                  (cf (if (> sum *lir-vm-mask-64*) 1 0))
                  (res (lir-vm-u64 sum)))
             (vm-set-flags! vm (if (= res 0) 1 0) 0 0 cf)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%usub)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (u1 (lir-vm-u64 (vm-eval-operand vm dst)))
                  (u2 (lir-vm-u64 (vm-eval-operand vm src)))
                  (cf (if (< u1 u2) 1 0))
                  (res (lir-vm-u64 (- u1 u2))))
             (vm-set-flags! vm (if (= res 0) 1 0) 0 0 cf)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ((%umul)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (u1 (lir-vm-u64 (vm-eval-operand vm dst)))
                  (u2 (lir-vm-u64 (vm-eval-operand vm src)))
                  (prod (* u1 u2))
                  (cf (if (> prod *lir-vm-mask-64*) 1 0))
                  (res (lir-vm-u64 prod)))
             (vm-set-flags! vm (if (= res 0) 1 0) 0 0 cf)
             (vm-set-location! vm dst (lir-vm-s64 res))))

          ;; --- Type Conversions & Fixnum Boxing ---
          ((%trunc)
           (let* ((type (cadr inst))
                  (dst (caddr inst))
                  (src (cadddr inst))
                  (val (vm-eval-operand vm src)))
             (case type
               ((i8 u8)   (vm-set-location! vm dst (bitwise-and val #xff)))
               ((i16 u16) (vm-set-location! vm dst (bitwise-and val #xffff)))
               ((i32 u32) (vm-set-location! vm dst (bitwise-and val #xffffffff)))
               (else (vm-set-location! vm dst val)))))

          ((%zext)
           (let* ((type (cadr inst))
                  (dst (caddr inst))
                  (src (cadddr inst))
                  (val (vm-eval-operand vm src)))
             (case type
               ((i8 u8)   (vm-set-location! vm dst (bitwise-and val #xff)))
               ((i16 u16) (vm-set-location! vm dst (bitwise-and val #xffff)))
               ((i32 u32) (vm-set-location! vm dst (bitwise-and val #xffffffff)))
               (else (vm-set-location! vm dst (lir-vm-u64 val))))))

          ((%sext)
           (let* ((type (cadr inst))
                  (dst (caddr inst))
                  (src (cadddr inst))
                  (val (vm-eval-operand vm src)))
             (case type
               ((i8)  (vm-set-location! vm dst (lir-vm-s8 (bitwise-and val #xff))))
               ((i16) (vm-set-location! vm dst (lir-vm-s16 (bitwise-and val #xffff))))
               ((i32) (vm-set-location! vm dst (lir-vm-s32 (bitwise-and val #xffffffff))))
               (else (vm-set-location! vm dst (lir-vm-s64 val))))))

          ((%box-fixnum)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (val (vm-eval-operand vm src))
                  (boxed (lir-vm-s64 (* (lir-vm-s64 val) 4)))) ; Shift left 2, tag 0
             (vm-set-location! vm dst boxed)))

          ((%unbox-fixnum)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (val (vm-eval-operand vm src))
                  (unboxed (lir-vm-s64 (quotient (lir-vm-s64 val) 4)))) ; Shift right 2
             (vm-set-location! vm dst unboxed)))

          ;; --- Comparisons & Condition Booleans ---
          ((%cmp %raw-cmp)
           (let* ((s1 (cadr inst))
                  (s2 (caddr inst))
                  (v1 (vm-eval-operand vm s1))
                  (v2 (vm-eval-operand vm s2)))
             (vm-update-cmp-flags! vm v1 v2)))

          ((%set-boolean)
           (let* ((dst (cadr inst))
                  (cc (caddr inst))
                  (res (if (vm-eval-condition-code vm cc) 111 47))) ; 0x6F: #t, 0x2F: #f
             (vm-set-location! vm dst res)))

          ;; --- Floating Point Operations (XMM) ---
          ((%sitofp)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (val (vm-eval-operand vm src)))
             (vm-set-xmm! vm dst (exact->inexact (lir-vm-s64 val)))))

          ((%fptosi)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (flt (vm-get-xmm vm src)))
             (vm-set-location! vm dst (exact (truncate flt)))))

          ((%fadd)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (f1 (vm-get-xmm vm dst))
                  (f2 (vm-get-xmm vm src)))
             (vm-set-xmm! vm dst (+ f1 f2))))

          ((%fsub)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (f1 (vm-get-xmm vm dst))
                  (f2 (vm-get-xmm vm src)))
             (vm-set-xmm! vm dst (- f1 f2))))

          ((%fmul)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (f1 (vm-get-xmm vm dst))
                  (f2 (vm-get-xmm vm src)))
             (vm-set-xmm! vm dst (* f1 f2))))

          ((%fdiv)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (f1 (vm-get-xmm vm dst))
                  (f2 (vm-get-xmm vm src)))
             (vm-set-xmm! vm dst (/ f1 f2))))

          ((%fcmp)
           (let* ((s1 (cadr inst))
                  (s2 (caddr inst))
                  (f1 (vm-get-xmm vm s1))
                  (f2 (vm-get-xmm vm s2))
                  (zf (if (= f1 f2) 1 0))
                  (cf (if (< f1 f2) 1 0)))
             (vm-set-flags! vm zf 0 0 cf)))

          ;; --- Control Flow & SSA Branches ---
          ((%jump)
           (let* ((target-lbl (cadr inst))
                  (args (if (pair? (cddr inst)) (caddr inst) '())))
             (vm-dispatch-jump! vm desc target-lbl args)))

          ((%jump-if)
           (let* ((reg (cadr inst))
                  (t-lbl (caddr inst))
                  (t-args (cadddr inst))
                  (e-lbl (list-ref inst 4))
                  (e-args (list-ref inst 5))
                  (val (vm-eval-operand vm reg)))
             (if (not (= val 47)) ; Not #f (0x2F)
                 (vm-dispatch-jump! vm desc t-lbl t-args)
                 (vm-dispatch-jump! vm desc e-lbl e-args))))

          ((%jump-if-false)
           (let* ((reg (cadr inst))
                  (lbl (caddr inst))
                  (args (if (pair? (cdddr inst)) (cadddr inst) '()))
                  (val (vm-eval-operand vm reg)))
             (if (= val 47) ; Is #f (0x2F)
                 (vm-dispatch-jump! vm desc lbl args))))

          ((%jump-cond)
           (let* ((cc (cadr inst))
                  (lbl (caddr inst)))
             (if (vm-eval-condition-code vm cc)
                 (vm-dispatch-jump! vm desc lbl '()))))

          ((%jump-if-zero)
           (let ((lbl (cadr inst)))
             (if (= (vm-flag-zf vm) 1)
                 (vm-dispatch-jump! vm desc lbl '()))))

          ((%direct-jump)
           (let ((lbl (cadr inst)))
             (let ((idx (func-find-label-index desc lbl)))
               (if idx
                   (vm-set-pc! vm idx)
                   (let ((fn-entry (assq lbl (vm-functions-table vm))))
                     (if fn-entry
                         (begin
                           (vm-set-current-fn! vm lbl)
                           (vm-set-pc! vm 0))
                         (vm-trigger-trap! vm 'undefined-target "Jump target not found" lbl)))))))

          ((%return)
           (let ((val (if (pair? (cdr inst)) (cadr inst) #f)))
             (vm-dispatch-return! vm val)))

          ;; --- Procedure Calls & ABI ---
          ((%direct-call)
           (let* ((func-lbl (cadr inst))
                  (shift (caddr inst))
                  (fn-entry (assq func-lbl (vm-functions-table vm))))
             (if (not fn-entry)
                 (vm-trigger-trap! vm 'undefined-target "Called function not found" func-lbl)
                 (let ((cur-rsp (vm-get-reg vm '%rsp)))
                   ;; Push frame to call stack
                   (vm-set-call-stack! vm (cons (list (vm-current-fn vm) (vm-pc vm) cur-rsp)
                                                (vm-call-stack vm)))
                   ;; Adjust %rsp
                   (vm-set-reg! vm '%rsp (- cur-rsp (+ shift 8)))
                   ;; Set PC to target function
                   (vm-set-current-fn! vm func-lbl)
                   (vm-set-pc! vm 0)))))

          ((%c-call %call-foreign)
           (let* ((fn (cadr inst))
                  (shift (caddr inst)))
             (vm-dispatch-c-call! vm fn shift)))

          ((%alloc)
           (let* ((dst (cadr inst))
                  (bytes (caddr inst))
                  (tag (cadddr inst))
                  (aligned (bitwise-and (+ bytes 7) -8))
                  (raw-ptr (vm-heap-ptr vm))
                  (new-ptr (+ raw-ptr aligned)))
             (if (> new-ptr *lir-vm-heap-limit*)
                 (vm-trigger-trap! vm 'out-of-bounds "Heap memory limit exceeded" new-ptr)
                 (begin
                   (vm-set-heap-ptr! vm new-ptr)
                   (vm-set-location! vm dst (+ raw-ptr tag))))))

          ((%inline-asm)
           (lir-vm-exec-inline-asm! vm inst))

          (else
           (error "Unsupported LIR instruction in Reference VM:" inst))))
      (error "Invalid instruction form:" inst)))

;;; -----------------------------------------------------------------------
;;; §7b. Inline Assembly (%inline-asm) Reference VM Interpreter
;;; -----------------------------------------------------------------------
(define *lir-vm-inline-asm-tsc* (cons 1000000 '()))

(define (register-inline-asm-handler! vm template-str proc)
  (let* ((key (string->symbol (string-append "__inline_asm__:" template-str)))
         (entry (assq key (vm-foreign-handlers vm))))
    (if entry
        (set-cdr! entry proc)
        (vm-set-foreign-handlers! vm (cons (cons key proc) (vm-foreign-handlers vm))))))

(define (lir-vm-ia-downcase str)
  (let* ((len (string-length str))
         (out (make-string len #\space)))
    (let loop ((i 0))
      (if (>= i len)
          out
          (let* ((ch (string-ref str i))
                 (code (char->integer ch)))
            (string-set! out i (if (and (>= code 65) (<= code 90))
                                   (integer->char (+ code 32))
                                   ch))
            (loop (+ i 1)))))))

(define (lir-vm-ia-trim s)
  (let ((len (string-length s)))
    (let left ((i 0))
      (if (and (< i len) (memv (string-ref s i) '(#\space #\tab #\return #\newline)))
          (left (+ i 1))
          (let right ((j len))
            (if (and (> j i) (memv (string-ref s (- j 1)) '(#\space #\tab #\return #\newline)))
                (right (- j 1))
                (substring s i j)))))))

(define (lir-vm-ia-parse-int str)
  (let* ((s (lir-vm-ia-trim str))
         (len (string-length s)))
    (if (= len 0)
        #f
        (let* ((neg? (char=? (string-ref s 0) #\-))
               (pos? (char=? (string-ref s 0) #\+))
               (start (if (or neg? pos?) 1 0))
               (rem (substring s start len))
               (rlen (string-length rem)))
          (if (= rlen 0)
              #f
              (let* ((low (lir-vm-ia-downcase rem))
                     (hex? (and (>= rlen 3) (char=? (string-ref low 0) #\0) (char=? (string-ref low 1) #\x)))
                     (digits (if hex? (substring low 2 rlen) low))
                     (dlen (string-length digits)))
                (if (= dlen 0)
                    #f
                    (let loop ((i 0) (acc 0))
                      (if (>= i dlen)
                          (if neg? (- 0 acc) acc)
                          (let ((c (string-ref digits i)))
                            (cond
                              ((and (char>=? c #\0) (char<=? c #\9))
                               (loop (+ i 1) (+ (* acc (if hex? 16 10)) (- (char->integer c) 48))))
                              ((and hex? (char>=? c #\a) (char<=? c #\f))
                               (loop (+ i 1) (+ (* acc 16) (+ 10 (- (char->integer c) 97)))))
                              (else #f))))))))))))

(define (lir-vm-ia-parse-reg-spec tok)
  (let ((s (lir-vm-ia-downcase
            (let ((t (lir-vm-ia-trim tok)))
              (if (and (> (string-length t) 0) (char=? (string-ref t 0) #\%))
                  (substring t 1 (string-length t))
                  t)))))
    (cond
      ((string=? s "rax") '(%rax 8 full)) ((string=? s "eax") '(%rax 4 full)) ((string=? s "ax") '(%rax 2 full)) ((string=? s "al") '(%rax 1 full)) ((string=? s "ah") '(%rax 1 high))
      ((string=? s "rbx") '(%rbx 8 full)) ((string=? s "ebx") '(%rbx 4 full)) ((string=? s "bx") '(%rbx 2 full)) ((string=? s "bl") '(%rbx 1 full)) ((string=? s "bh") '(%rbx 1 high))
      ((string=? s "rcx") '(%rcx 8 full)) ((string=? s "ecx") '(%rcx 4 full)) ((string=? s "cx") '(%rcx 2 full)) ((string=? s "cl") '(%rcx 1 full)) ((string=? s "ch") '(%rcx 1 high))
      ((string=? s "rdx") '(%rdx 8 full)) ((string=? s "edx") '(%rdx 4 full)) ((string=? s "dx") '(%rdx 2 full)) ((string=? s "dl") '(%rdx 1 full)) ((string=? s "dh") '(%rdx 1 high))
      ((string=? s "rsi") '(%rsi 8 full)) ((string=? s "esi") '(%rsi 4 full)) ((string=? s "si") '(%rsi 2 full)) ((string=? s "sil") '(%rsi 1 full))
      ((string=? s "rdi") '(%rdi 8 full)) ((string=? s "edi") '(%rdi 4 full)) ((string=? s "di") '(%rdi 2 full)) ((string=? s "dil") '(%rdi 1 full))
      ((string=? s "rbp") '(%rbp 8 full)) ((string=? s "ebp") '(%rbp 4 full)) ((string=? s "bp") '(%rbp 2 full)) ((string=? s "bpl") '(%rbp 1 full))
      ((string=? s "rsp") '(%rsp 8 full)) ((string=? s "esp") '(%rsp 4 full)) ((string=? s "sp") '(%rsp 2 full)) ((string=? s "spl") '(%rsp 1 full))
      ((string=? s "r8")  '(%r8  8 full)) ((string=? s "r8d") '(%r8  4 full)) ((string=? s "r8w") '(%r8  2 full)) ((string=? s "r8b") '(%r8  1 full))
      ((string=? s "r9")  '(%r9  8 full)) ((string=? s "r9d") '(%r9  4 full)) ((string=? s "r9w") '(%r9  2 full)) ((string=? s "r9b") '(%r9  1 full))
      ((string=? s "r10") '(%r10 8 full)) ((string=? s "r10d") '(%r10 4 full)) ((string=? s "r10w") '(%r10 2 full)) ((string=? s "r10b") '(%r10 1 full))
      ((string=? s "r11") '(%r11 8 full)) ((string=? s "r11d") '(%r11 4 full)) ((string=? s "r11w") '(%r11 2 full)) ((string=? s "r11b") '(%r11 1 full))
      ((string=? s "r12") '(%r12 8 full)) ((string=? s "r12d") '(%r12 4 full)) ((string=? s "r12w") '(%r12 2 full)) ((string=? s "r12b") '(%r12 1 full))
      ((string=? s "r13") '(%r13 8 full)) ((string=? s "r13d") '(%r13 4 full)) ((string=? s "r13w") '(%r13 2 full)) ((string=? s "r13b") '(%r13 1 full))
      ((string=? s "r14") '(%r14 8 full)) ((string=? s "r14d") '(%r14 4 full)) ((string=? s "r14w") '(%r14 2 full)) ((string=? s "r14b") '(%r14 1 full))
      ((string=? s "r15") '(%r15 8 full)) ((string=? s "r15d") '(%r15 4 full)) ((string=? s "r15w") '(%r15 2 full)) ((string=? s "r15b") '(%r15 1 full))
      (else #f))))

(define (lir-vm-ia-norm-reg-sym sym)
  (let ((spec (and (or (symbol? sym) (string? sym))
                   (lir-vm-ia-parse-reg-spec (if (symbol? sym) (symbol->string sym) sym)))))
    (if spec (car spec) #f)))

(define (lir-vm-ia-canonical-gpr opnd)
  (let ((d (lir-vm-ia-norm-reg-sym opnd)))
    (if d d
        (if (and (pair? opnd) (eq? (car opnd) '%reg) (pair? (cdr opnd)))
            (lir-vm-ia-norm-reg-sym (cadr opnd))
            #f))))

(define (lir-vm-ia-reg-str gpr mod-ch)
  (let ((nr (lir-vm-ia-norm-reg-sym gpr)))
    (cond
      ((or (not mod-ch) (char=? mod-ch #\q) (char=? mod-ch #\c) (char=? mod-ch #\n))
       (case nr
         ((%rax) "rax") ((%rbx) "rbx") ((%rcx) "rcx") ((%rdx) "rdx")
         ((%rsi) "rsi") ((%rdi) "rdi") ((%rbp) "rbp") ((%rsp) "rsp")
         ((%r8) "r8") ((%r9) "r9") ((%r10) "r10") ((%r11) "r11")
         ((%r12) "r12") ((%r13) "r13") ((%r14) "r14") ((%r15) "r15") (else "rax")))
      ((char=? mod-ch #\k)
       (case nr
         ((%rax) "eax") ((%rbx) "ebx") ((%rcx) "ecx") ((%rdx) "edx")
         ((%rsi) "esi") ((%rdi) "edi") ((%rbp) "ebp") ((%rsp) "esp")
         ((%r8) "r8d") ((%r9) "r9d") ((%r10) "r10d") ((%r11) "r11d")
         ((%r12) "r12d") ((%r13) "r13d") ((%r14) "r14d") ((%r15) "r15d") (else "eax")))
      ((char=? mod-ch #\w)
       (case nr
         ((%rax) "ax") ((%rbx) "bx") ((%rcx) "cx") ((%rdx) "dx")
         ((%rsi) "si") ((%rdi) "di") ((%rbp) "bp") ((%rsp) "sp")
         ((%r8) "r8w") ((%r9) "r9w") ((%r10) "r10w") ((%r11) "r11w")
         ((%r12) "r12w") ((%r13) "r13w") ((%r14) "r14w") ((%r15) "r15w") (else "ax")))
      ((or (char=? mod-ch #\b) (char=? mod-ch #\l))
       (case nr
         ((%rax) "al") ((%rbx) "bl") ((%rcx) "cl") ((%rdx) "dl")
         ((%rsi) "sil") ((%rdi) "dil") ((%rbp) "bpl") ((%rsp) "spl")
         ((%r8) "r8b") ((%r9) "r9b") ((%r10) "r10b") ((%r11) "r11b")
         ((%r12) "r12b") ((%r13) "r13b") ((%r14) "r14b") ((%r15) "r15b") (else "al")))
      ((char=? mod-ch #\h)
       (case nr ((%rax) "ah") ((%rbx) "bh") ((%rcx) "ch") ((%rdx) "dh") (else "al")))
      (else (lir-vm-ia-reg-str gpr #f)))))

(define (lir-vm-ia-parse-braced-reg s)
  (let ((len (string-length s)))
    (if (and (>= len 3) (char=? (string-ref s 0) #\{) (char=? (string-ref s (- len 1)) #\}))
        (lir-vm-ia-norm-reg-sym (substring s 1 (- len 1)))
        #f)))

(define (lir-vm-ia-parse-short-reg s)
  (cond
    ((string=? s "a") '%rax) ((string=? s "b") '%rbx) ((string=? s "c") '%rcx)
    ((string=? s "d") '%rdx) ((string=? s "S") '%rsi) ((string=? s "D") '%rdi)
    (else #f)))

(define (lir-vm-ia-extract-clauses inst)
  (let ((template (cadr inst))
        (clauses (cddr inst)))
    (let loop ((cs clauses) (outputs '()) (inputs '()) (clobbers '()) (volatile? #t))
      (if (null? cs)
          (list template outputs inputs clobbers volatile?)
          (let ((c (car cs)))
            (case (car c)
              ((:outputs) (loop (cdr cs) (cadr c) inputs clobbers volatile?))
              ((:inputs) (loop (cdr cs) outputs (cadr c) clobbers volatile?))
              ((:clobbers) (loop (cdr cs) outputs inputs (cadr c) volatile?))
              ((:volatile?) (loop (cdr cs) outputs inputs clobbers (cadr c)))
              (else (loop (cdr cs) outputs inputs clobbers volatile?))))))))

(define (lir-vm-ia-norm-entry entry)
  (if (and (pair? (cdr entry)) (null? (cddr entry)))
      (list #f (car entry) (cadr entry))
      (list (car entry) (caddr entry) (cadr entry))))

(define (lir-vm-ia-parse-out-cstr cstr)
  (let* ((rw? (char=? (string-ref cstr 0) #\+))
         (raw-body (substring cstr 1 (string-length cstr)))
         (body (if (and (> (string-length raw-body) 0) (char=? (string-ref raw-body 0) #\&))
                   (substring raw-body 1 (string-length raw-body))
                   raw-body))
         (sr (lir-vm-ia-parse-short-reg body))
         (br (lir-vm-ia-parse-braced-reg body)))
    (cond
      ((or (string=? body "r") (string=? body "q")) (list '=any-reg rw?))
      ((string=? body "m") (list '=mem rw?))
      (sr (list '=reg sr rw?))
      (br (list '=reg br rw?))
      (else (list '=any-reg rw?)))))

(define (lir-vm-ia-parse-in-cstr cstr)
  (let ((sr (lir-vm-ia-parse-short-reg cstr))
        (br (lir-vm-ia-parse-braced-reg cstr))
        (uint (lir-vm-ia-parse-int cstr)))
    (cond
      ((or (string=? cstr "r") (string=? cstr "q") (string=? cstr "ri") (string=? cstr "ir") (string=? cstr "r,i")) '(any-reg))
      ((string=? cstr "m") '(mem))
      ((or (string=? cstr "i") (string=? cstr "n") (string=? cstr "I") (string=? cstr "J") (string=? cstr "K")) '(imm))
      (sr (list 'reg sr))
      (br (list 'reg br))
      ((and uint (>= uint 0)) (list 'tied uint))
      (else '(any-reg)))))

(define (lir-vm-ia-first-free-gpr used)
  (let loop ((pool '(%r10 %r11 %rax %rcx %rdx %rsi %rdi %r8 %r9 %rbx %r13 %r14 %rbp %r15 %r12)))
    (cond ((null? pool) #f)
          ((memq (car pool) used) (loop (cdr pool)))
          (else (car pool)))))

(define (lir-vm-ia-build-plan inst)
  (let* ((cls (lir-vm-ia-extract-clauses inst))
         (template (car cls))
         (outs (cadr cls))
         (ins (caddr cls))
         (raw-clobs (cadddr cls))
         (num-outs (length outs))
         (clob-regs
          (let loop ((cs raw-clobs) (acc '()))
            (if (null? cs)
                acc
                (let ((r (lir-vm-ia-norm-reg-sym (if (symbol? (car cs)) (symbol->string (car cs)) (car cs)))))
                  (if (and r (not (memq r acc))) (loop (cdr cs) (cons r acc)) (loop (cdr cs) acc))))))
         (init-res
          (let loop-o ((os outs) (acc clob-regs))
            (if (null? os)
                (let loop-i ((is ins) (acc acc))
                  (if (null? is) acc
                      (let* ((ni (lir-vm-ia-norm-entry (car is)))
                             (src (cadr ni))
                             (ic (lir-vm-ia-parse-in-cstr (caddr ni)))
                             (a1 (if (and (pair? src) (eq? (car src) '%mem))
                                     (let ((br (lir-vm-ia-canonical-gpr (cadr src))))
                                       (if (and br (not (eq? br '%rsp)) (not (memq br acc))) (cons br acc) acc))
                                     acc)))
                        (if (and (eq? (car ic) 'reg) (not (memq (cadr ic) a1)))
                            (loop-i (cdr is) (cons (cadr ic) a1))
                            (loop-i (cdr is) a1)))))
                (let* ((no (lir-vm-ia-norm-entry (car os)))
                       (dst (cadr no))
                       (oc (lir-vm-ia-parse-out-cstr (caddr no)))
                       (a1 (if (and (pair? dst) (eq? (car dst) '%mem))
                               (let ((br (lir-vm-ia-canonical-gpr (cadr dst))))
                                 (if (and br (not (eq? br '%rsp)) (not (memq br acc))) (cons br acc) acc))
                               acc)))
                  (if (and (eq? (car oc) '=reg) (not (memq (cadr oc) a1)))
                      (loop-o (cdr os) (cons (cadr oc) a1))
                      (loop-o (cdr os) a1))))))
         (out-res
          (let oloop ((os outs) (idx 0) (used init-res) (acc '()))
            (if (null? os)
                (cons (reverse acc) used)
                (let* ((no (lir-vm-ia-norm-entry (car os)))
                       (nm (car no))
                       (dst (cadr no))
                       (oc (lir-vm-ia-parse-out-cstr (caddr no))))
                  (cond
                    ((eq? (car oc) '=reg)
                     (let ((r (cadr oc)))
                       (oloop (cdr os) (+ idx 1) (if (memq r used) used (cons r used))
                              (cons (list idx nm dst (caddr oc) 'reg r) acc))))
                    ((eq? (car oc) '=mem)
                     (oloop (cdr os) (+ idx 1) used
                            (cons (list idx nm dst (cadr oc) 'mem dst) acc)))
                    (else
                     (let ((r (or (lir-vm-ia-first-free-gpr used) '%r10)))
                       (oloop (cdr os) (+ idx 1) (cons r used)
                              (cons (list idx nm dst (cadr oc) 'reg r) acc)))))))))
         (out-plans (car out-res))
         (used2 (cdr out-res))
         (in-plans
          (let iloop ((is ins) (idx num-outs) (used used2) (acc '()))
            (if (null? is)
                (reverse acc)
                (let* ((ni (lir-vm-ia-norm-entry (car is)))
                       (nm (car ni))
                       (src (cadr ni))
                       (ic (lir-vm-ia-parse-in-cstr (caddr ni))))
                  (case (car ic)
                    ((reg)
                     (let ((r (cadr ic)))
                       (iloop (cdr is) (+ idx 1) (if (memq r used) used (cons r used))
                              (cons (list idx nm src 'reg r #f) acc))))
                    ((mem)
                     (iloop (cdr is) (+ idx 1) used (cons (list idx nm src 'mem src #f) acc)))
                    ((imm)
                     (iloop (cdr is) (+ idx 1) used (cons (list idx nm src 'imm src #f) acc)))
                    ((tied)
                     (let* ((t-idx (cadr ic))
                            (to (list-ref out-plans t-idx))
                            (tk (list-ref to 4))
                            (tc (list-ref to 5)))
                       (iloop (cdr is) (+ idx 1) used
                              (cons (list idx nm src 'tied (if (eq? tk 'reg) tc (list-ref to 2)) t-idx) acc))))
                    (else
                     (let ((r (or (lir-vm-ia-first-free-gpr used) '%r11)))
                       (iloop (cdr is) (+ idx 1) (cons r used)
                              (cons (list idx nm src 'reg r #f) acc))))))))))
    (list template out-plans in-plans)))

(define (lir-vm-ia-eval-addr vm mem-opnd)
  (cond
    ((and (pair? mem-opnd) (eq? (car mem-opnd) '%stack))
     (+ (vm-get-reg vm '%rsp) (cadr mem-opnd)))
    ((and (pair? mem-opnd) (eq? (car mem-opnd) '%mem))
     (+ (vm-eval-operand vm (cadr mem-opnd)) (vm-eval-offset vm (caddr mem-opnd))))
    (else 0)))

(define (lir-vm-ia-format-mem vm opnd mod-ch)
  (let* ((addr (lir-vm-ia-eval-addr vm opnd))
         (sz (cond ((or (eqv? mod-ch #\b) (eqv? mod-ch #\l)) "byte ptr ")
                   ((eqv? mod-ch #\w) "word ptr ")
                   ((eqv? mod-ch #\k) "dword ptr ")
                   ((eqv? mod-ch #\q) "qword ptr ")
                   (else ""))))
    (string-append sz "[" (number->string addr) "]")))

(define (lir-vm-ia-format-opnd-idx vm idx mod-ch out-plans in-plans)
  (let ((no (length out-plans)))
    (if (< idx no)
        (let ((op (list-ref out-plans idx)))
          (if (eq? (list-ref op 4) 'reg)
              (lir-vm-ia-reg-str (list-ref op 5) mod-ch)
              (lir-vm-ia-format-mem vm (list-ref op 2) mod-ch)))
        (let* ((ip (list-ref in-plans (- idx no)))
               (kind (list-ref ip 3))
               (carrier (list-ref ip 4)))
          (case kind
            ((reg) (lir-vm-ia-reg-str carrier mod-ch))
            ((imm) (number->string (vm-eval-operand vm carrier)))
            ((mem) (lir-vm-ia-format-mem vm (list-ref ip 2) mod-ch))
            ((tied) (lir-vm-ia-format-opnd-idx vm (list-ref ip 5) mod-ch out-plans in-plans))
            (else "0"))))))

(define (lir-vm-ia-find-name nm out-plans in-plans)
  (let oloop ((ops out-plans))
    (if (not (null? ops))
        (if (eq? (list-ref (car ops) 1) nm)
            (list-ref (car ops) 0)
            (oloop (cdr ops)))
        (let iloop ((ips in-plans))
          (if (null? ips) #f
              (if (eq? (list-ref (car ips) 1) nm)
                  (list-ref (car ips) 0)
                  (iloop (cdr ips))))))))

(define (lir-vm-ia-expand-template vm template out-plans in-plans)
  (let ((len (string-length template)))
    (let loop ((i 0) (acc ""))
      (if (>= i len)
          acc
          (let ((ch (string-ref template i)))
            (if (not (char=? ch #\%))
                (let scan ((j (+ i 1)))
                  (if (and (< j len) (not (char=? (string-ref template j) #\%)))
                      (scan (+ j 1))
                      (loop j (string-append acc (substring template i j)))))
                (let ((c1 (if (< (+ i 1) len) (string-ref template (+ i 1)) #\space)))
                  (cond
                    ((char=? c1 #\%)
                     (let scan-r ((j (+ i 2)))
                       (if (and (< j len)
                                (let ((c (string-ref template j)))
                                  (or (and (char>=? c #\0) (char<=? c #\9))
                                      (and (char>=? c #\a) (char<=? c #\z))
                                      (and (char>=? c #\A) (char<=? c #\Z)))))
                           (scan-r (+ j 1))
                           (let ((tok (if (> j (+ i 2)) (substring template (+ i 2) j) "")))
                             (if (and (> (string-length tok) 0) (lir-vm-ia-parse-reg-spec tok))
                                 (loop j (string-append acc (lir-vm-ia-downcase tok)))
                                 (loop (+ i 2) (string-append acc "%")))))))
                    ((char=? c1 #\[)
                     (let find-c ((j (+ i 2)))
                       (if (or (>= j len) (char=? (string-ref template j) #\]))
                           (let* ((nm (string->symbol (if (< (+ i 2) j) (substring template (+ i 2) j) "")))
                                  (idx (lir-vm-ia-find-name nm out-plans in-plans)))
                             (loop (if (< j len) (+ j 1) j)
                                   (string-append acc (if idx (lir-vm-ia-format-opnd-idx vm idx #f out-plans in-plans) "0"))))
                           (find-c (+ j 1)))))
                    ((and (char>=? c1 #\0) (char<=? c1 #\9))
                     (let scan-n ((j (+ i 1)) (idx 0))
                       (if (and (< j len) (char>=? (string-ref template j) #\0) (char<=? (string-ref template j) #\9))
                           (scan-n (+ j 1) (+ (* idx 10) (- (char->integer (string-ref template j)) 48)))
                           (loop j (string-append acc (lir-vm-ia-format-opnd-idx vm idx #f out-plans in-plans))))))
                    ((and (< (+ i 2) len)
                          (memv c1 '(#\b #\w #\k #\q #\h #\l #\c #\n))
                          (or (and (char>=? (string-ref template (+ i 2)) #\0) (char<=? (string-ref template (+ i 2)) #\9))
                              (char=? (string-ref template (+ i 2)) #\[)))
                     (if (char=? (string-ref template (+ i 2)) #\[)
                         (let find-c2 ((j (+ i 3)))
                           (if (or (>= j len) (char=? (string-ref template j) #\]))
                               (let* ((nm (string->symbol (if (< (+ i 3) j) (substring template (+ i 3) j) "")))
                                      (idx (lir-vm-ia-find-name nm out-plans in-plans)))
                                 (loop (if (< j len) (+ j 1) j)
                                       (string-append acc (if idx (lir-vm-ia-format-opnd-idx vm idx c1 out-plans in-plans) "0"))))
                               (find-c2 (+ j 1))))
                         (let scan-n2 ((j (+ i 2)) (idx 0))
                           (if (and (< j len) (char>=? (string-ref template j) #\0) (char<=? (string-ref template j) #\9))
                               (scan-n2 (+ j 1) (+ (* idx 10) (- (char->integer (string-ref template j)) 48)))
                               (loop j (string-append acc (lir-vm-ia-format-opnd-idx vm idx c1 out-plans in-plans)))))))
                    (else
                     (loop (+ i 1) (string-append acc "%")))))))))))

(define (lir-vm-ia-split-lines str)
  (let ((len (string-length str)))
    (let loop ((i 0) (start 0) (acc '()))
      (if (>= i len)
          (let ((tail (lir-vm-ia-trim (substring str start len))))
            (reverse (if (or (string=? tail "") (char=? (string-ref tail 0) #\#)) acc (cons tail acc))))
          (let ((ch (string-ref str i)))
            (if (or (char=? ch #\newline) (char=? ch #\return) (char=? ch #\;))
                (let ((chunk (lir-vm-ia-trim (substring str start i))))
                  (loop (+ i 1) (+ i 1)
                        (if (or (string=? chunk "") (char=? (string-ref chunk 0) #\#)) acc (cons chunk acc))))
                (loop (+ i 1) start acc)))))))

(define (lir-vm-ia-split-opnd-strs rest)
  (let ((len (string-length rest)))
    (let loop ((i 0) (start 0) (bracket-depth 0) (acc '()))
      (if (>= i len)
          (let ((tail (lir-vm-ia-trim (substring rest start len))))
            (reverse (if (string=? tail "") acc (cons tail acc))))
          (let ((ch (string-ref rest i)))
            (cond
              ((char=? ch #\[) (loop (+ i 1) start (+ bracket-depth 1) acc))
              ((char=? ch #\]) (loop (+ i 1) start (if (> bracket-depth 0) (- bracket-depth 1) 0) acc))
              ((and (char=? ch #\,) (= bracket-depth 0))
               (loop (+ i 1) (+ i 1) 0 (cons (lir-vm-ia-trim (substring rest start i)) acc)))
              (else (loop (+ i 1) start bracket-depth acc))))))))

(define (lir-vm-ia-parse-mem-expr vm inner sz)
  (let ((len (string-length inner)))
    (let loop ((i 0) (sign 1) (sum 0) (start 0))
      (let ((at-end? (>= i len))
            (ch (if (< i len) (string-ref inner i) #\+)))
        (if (or at-end? (and (> i start) (or (char=? ch #\+) (char=? ch #\-))))
            (let* ((tok (lir-vm-ia-trim (substring inner start i)))
                   (val (if (string=? tok "")
                            0
                            (let ((n (lir-vm-ia-parse-int tok)))
                              (if n n
                                  (let ((rs (lir-vm-ia-parse-reg-spec tok)))
                                    (if rs (vm-get-reg vm (car rs)) 0))))))
                   (next-sum (+ sum (* sign val))))
              (if at-end?
                  (list 'mem next-sum sz)
                  (loop (+ i 1) (if (char=? ch #\-) -1 1) next-sum (+ i 1))))
            (if (and (= i start) (char=? ch #\-))
                (loop (+ i 1) (- 0 sign) sum (+ i 1))
                (if (and (= i start) (char=? ch #\+))
                    (loop (+ i 1) sign sum (+ i 1))
                    (loop (+ i 1) sign sum start))))))))

(define (lir-vm-ia-parse-asm-opnd vm raw-str)
  (let* ((s0 (lir-vm-ia-trim raw-str))
         (low (lir-vm-ia-downcase s0)))
    (let* ((sz-and-rem
            (cond
              ((and (>= (string-length low) 9) (string=? (substring low 0 9) "qword ptr")) (cons 8 (lir-vm-ia-trim (substring s0 9 (string-length s0)))))
              ((and (>= (string-length low) 9) (string=? (substring low 0 9) "dword ptr")) (cons 4 (lir-vm-ia-trim (substring s0 9 (string-length s0)))))
              ((and (>= (string-length low) 8) (string=? (substring low 0 8) "word ptr"))  (cons 2 (lir-vm-ia-trim (substring s0 8 (string-length s0)))))
              ((and (>= (string-length low) 8) (string=? (substring low 0 8) "byte ptr"))  (cons 1 (lir-vm-ia-trim (substring s0 8 (string-length s0)))))
              (else (cons 8 s0))))
           (sz (car sz-and-rem))
           (s (cdr sz-and-rem))
           (slen (string-length s)))
      (cond
        ((and (>= slen 2) (char=? (string-ref s 0) #\[) (char=? (string-ref s (- slen 1)) #\]))
         (lir-vm-ia-parse-mem-expr vm (substring s 1 (- slen 1)) sz))
        ((lir-vm-ia-parse-reg-spec s)
         (let ((rs (lir-vm-ia-parse-reg-spec s)))
           (list 'reg (car rs) (cadr rs) (caddr rs))))
        ((lir-vm-ia-parse-int s)
         (list 'imm (lir-vm-ia-parse-int s) 8))
        (else (list 'imm 0 8))))))

(define (lir-vm-ia-read-opnd vm op)
  (case (car op)
    ((imm) (cadr op))
    ((reg)
     (let* ((gpr (cadr op))
            (sz (caddr op))
            (half (cadddr op))
            (raw (vm-get-reg vm gpr)))
       (cond
         ((= sz 8) raw)
         ((= sz 4) (lir-vm-u32 raw))
         ((= sz 2) (bitwise-and raw #xffff))
         ((eq? half 'high) (bitwise-and (quotient (lir-vm-u64 raw) 256) #xff))
         (else (bitwise-and raw #xff)))))
    ((mem)
     (let ((addr (cadr op))
           (sz (caddr op)))
       (case sz
         ((1) (vm-mem-read-u8 vm addr))
         ((2) (vm-mem-read-u16 vm addr))
         ((4) (vm-mem-read-u32 vm addr))
         (else (vm-mem-read-i64 vm addr)))))
    (else 0)))

(define (lir-vm-ia-write-opnd! vm op val)
  (case (car op)
    ((reg)
     (let* ((gpr (cadr op))
            (sz (caddr op))
            (half (cadddr op))
            (cur (lir-vm-u64 (vm-get-reg vm gpr))))
       (cond
         ((= sz 8) (vm-set-reg! vm gpr val))
         ((= sz 4) (vm-set-reg! vm gpr (lir-vm-u32 val)))
         ((= sz 2)
          (let ((newv (bitwise-ior (bitwise-and cur (bitwise-not #xffff)) (bitwise-and val #xffff))))
            (vm-set-reg! vm gpr newv)))
         ((eq? half 'high)
          (let ((newv (bitwise-ior (bitwise-and cur (bitwise-not #xff00)) (* (bitwise-and val #xff) 256))))
            (vm-set-reg! vm gpr newv)))
         (else
          (let ((newv (bitwise-ior (bitwise-and cur (bitwise-not #xff)) (bitwise-and val #xff))))
            (vm-set-reg! vm gpr newv))))))
    ((mem)
     (let ((addr (cadr op))
           (sz (caddr op)))
       (case sz
         ((1) (vm-mem-write-u8! vm addr (bitwise-and val #xff)))
         ((2) (vm-mem-write-u16! vm addr (bitwise-and val #xffff)))
         ((4) (vm-mem-write-u32! vm addr (lir-vm-u32 val)))
         (else (vm-mem-write-u64! vm addr (lir-vm-u64 val))))))))

(define (lir-vm-ia-bswap-val val sz)
  (let ((n (if (= sz 4) 4 8))
        (u (if (= sz 4) (lir-vm-u32 val) (lir-vm-u64 val))))
    (let loop ((i 0) (v u) (acc 0))
      (if (>= i n)
          (if (= sz 4) acc (lir-vm-s64 acc))
          (loop (+ i 1) (quotient v 256) (+ (* acc 256) (bitwise-and v #xff)))))))

(define (lir-vm-ia-exec-line! vm line)
  (let* ((len (string-length line))
         (sp (let find-sp ((i 0))
               (if (or (>= i len) (memv (string-ref line i) '(#\space #\tab))) i (find-sp (+ i 1)))))
         (raw-first (lir-vm-ia-downcase (substring line 0 sp)))
         (rest0 (if (< sp len) (lir-vm-ia-trim (substring line sp len)) ""))
         (split2 (if (string=? raw-first "lock")
                     (let* ((rlen (string-length rest0))
                            (sp2 (let f2 ((i 0))
                                   (if (or (>= i rlen) (memv (string-ref rest0 i) '(#\space #\tab))) i (f2 (+ i 1))))))
                       (cons (lir-vm-ia-downcase (substring rest0 0 sp2))
                             (if (< sp2 rlen) (lir-vm-ia-trim (substring rest0 sp2 rlen)) "")))
                     (cons raw-first rest0)))
         (mnem (car split2))
         (op-strs (if (string=? (cdr split2) "") '() (lir-vm-ia-split-opnd-strs (cdr split2))))
         (opnds (map (lambda (s) (lir-vm-ia-parse-asm-opnd vm s)) op-strs)))
    (cond
      ((or (string=? mnem "nop") (string=? mnem "pause")
           (string=? mnem "mfence") (string=? mnem "lfence") (string=? mnem "sfence"))
       #t)
      ((or (string=? mnem "mov") (string=? mnem "movq"))
       (lir-vm-ia-write-opnd! vm (car opnds) (lir-vm-ia-read-opnd vm (cadr opnds))))
      ((or (string=? mnem "movzx") (string=? mnem "movzbq") (string=? mnem "movzwq"))
       (let* ((src (cadr opnds))
              (v (lir-vm-ia-read-opnd vm src))
              (mask (case (caddr src) ((1) #xff) ((2) #xffff) ((4) #xffffffff) (else *lir-vm-mask-64*))))
         (lir-vm-ia-write-opnd! vm (car opnds) (bitwise-and v mask))))
      ((string=? mnem "lea")
       (let ((src (cadr opnds)))
         (lir-vm-ia-write-opnd! vm (car opnds) (if (eq? (car src) 'mem) (cadr src) (lir-vm-ia-read-opnd vm src)))))
      ((string=? mnem "add")
       (let* ((dst (car opnds))
              (v1 (lir-vm-ia-read-opnd vm dst))
              (v2 (lir-vm-ia-read-opnd vm (cadr opnds))))
         (vm-update-add-flags! vm v1 v2)
         (lir-vm-ia-write-opnd! vm dst (+ v1 v2))))
      ((string=? mnem "sub")
       (let* ((dst (car opnds))
              (v1 (lir-vm-ia-read-opnd vm dst))
              (v2 (lir-vm-ia-read-opnd vm (cadr opnds))))
         (vm-update-sub-flags! vm v1 v2)
         (lir-vm-ia-write-opnd! vm dst (- v1 v2))))
      ((string=? mnem "imul")
       (if (= (length opnds) 3)
           (let ((v2 (lir-vm-ia-read-opnd vm (cadr opnds)))
                 (v3 (lir-vm-ia-read-opnd vm (caddr opnds))))
             (lir-vm-ia-write-opnd! vm (car opnds) (* v2 v3)))
           (let* ((dst (car opnds))
                  (v1 (lir-vm-ia-read-opnd vm dst))
                  (v2 (lir-vm-ia-read-opnd vm (cadr opnds))))
             (lir-vm-ia-write-opnd! vm dst (* v1 v2)))))
      ((string=? mnem "and")
       (let* ((dst (car opnds))
              (res (bitwise-and (lir-vm-ia-read-opnd vm dst) (lir-vm-ia-read-opnd vm (cadr opnds)))))
         (vm-update-logic-flags! vm res)
         (lir-vm-ia-write-opnd! vm dst res)))
      ((string=? mnem "or")
       (let* ((dst (car opnds))
              (res (bitwise-ior (lir-vm-ia-read-opnd vm dst) (lir-vm-ia-read-opnd vm (cadr opnds)))))
         (vm-update-logic-flags! vm res)
         (lir-vm-ia-write-opnd! vm dst res)))
      ((string=? mnem "xor")
       (let* ((dst (car opnds))
              (res (bitwise-xor (lir-vm-ia-read-opnd vm dst) (lir-vm-ia-read-opnd vm (cadr opnds)))))
         (vm-update-logic-flags! vm res)
         (lir-vm-ia-write-opnd! vm dst res)))
      ((string=? mnem "shl")
       (let* ((dst (car opnds))
              (cnt (bitwise-and (lir-vm-ia-read-opnd vm (cadr opnds)) 63))
              (res (arithmetic-shift (lir-vm-ia-read-opnd vm dst) cnt)))
         (lir-vm-ia-write-opnd! vm dst res)))
      ((or (string=? mnem "shr") (string=? mnem "sar"))
       (let* ((dst (car opnds))
              (cnt (bitwise-and (lir-vm-ia-read-opnd vm (cadr opnds)) 63))
              (raw (lir-vm-ia-read-opnd vm dst))
              (base (if (string=? mnem "shr") (lir-vm-u64 raw) (lir-vm-s64 raw))))
         (lir-vm-ia-write-opnd! vm dst (arithmetic-shift base (- 0 cnt)))))
      ((string=? mnem "inc")
       (let* ((dst (car opnds)) (v (lir-vm-ia-read-opnd vm dst)))
         (vm-update-add-flags! vm v 1)
         (lir-vm-ia-write-opnd! vm dst (+ v 1))))
      ((string=? mnem "dec")
       (let* ((dst (car opnds)) (v (lir-vm-ia-read-opnd vm dst)))
         (vm-update-sub-flags! vm v 1)
         (lir-vm-ia-write-opnd! vm dst (- v 1))))
      ((string=? mnem "neg")
       (let* ((dst (car opnds)) (v (lir-vm-ia-read-opnd vm dst)))
         (vm-update-sub-flags! vm 0 v)
         (lir-vm-ia-write-opnd! vm dst (- 0 v))))
      ((string=? mnem "not")
       (let* ((dst (car opnds)) (v (lir-vm-ia-read-opnd vm dst)))
         (lir-vm-ia-write-opnd! vm dst (bitwise-not v))))
      ((string=? mnem "cmp")
       (vm-update-cmp-flags! vm (lir-vm-ia-read-opnd vm (car opnds)) (lir-vm-ia-read-opnd vm (cadr opnds))))
      ((string=? mnem "test")
       (vm-update-logic-flags! vm (bitwise-and (lir-vm-ia-read-opnd vm (car opnds)) (lir-vm-ia-read-opnd vm (cadr opnds)))))
      ((or (string=? mnem "sete") (string=? mnem "setz"))
       (lir-vm-ia-write-opnd! vm (car opnds) (vm-flag-zf vm)))
      ((or (string=? mnem "setne") (string=? mnem "setnz"))
       (lir-vm-ia-write-opnd! vm (car opnds) (if (= (vm-flag-zf vm) 0) 1 0)))
      ((string=? mnem "setl")
       (lir-vm-ia-write-opnd! vm (car opnds) (if (not (= (vm-flag-sf vm) (vm-flag-of vm))) 1 0)))
      ((string=? mnem "setge")
       (lir-vm-ia-write-opnd! vm (car opnds) (if (= (vm-flag-sf vm) (vm-flag-of vm)) 1 0)))
      ((string=? mnem "setle")
       (lir-vm-ia-write-opnd! vm (car opnds) (if (or (= (vm-flag-zf vm) 1) (not (= (vm-flag-sf vm) (vm-flag-of vm)))) 1 0)))
      ((string=? mnem "setg")
       (lir-vm-ia-write-opnd! vm (car opnds) (if (and (= (vm-flag-zf vm) 0) (= (vm-flag-sf vm) (vm-flag-of vm))) 1 0)))
      ((or (string=? mnem "setb") (string=? mnem "setc"))
       (lir-vm-ia-write-opnd! vm (car opnds) (vm-flag-cf vm)))
      ((or (string=? mnem "setae") (string=? mnem "setnc"))
       (lir-vm-ia-write-opnd! vm (car opnds) (if (= (vm-flag-cf vm) 0) 1 0)))
      ((string=? mnem "xchg")
       (let ((o1 (car opnds))
             (o2 (cadr opnds)))
         (let ((v1 (lir-vm-ia-read-opnd vm o1))
               (v2 (lir-vm-ia-read-opnd vm o2)))
           (lir-vm-ia-write-opnd! vm o1 v2)
           (lir-vm-ia-write-opnd! vm o2 v1))))
      ((string=? mnem "xadd")
       (let ((dst (car opnds))
             (src (cadr opnds)))
         (let ((vd (lir-vm-ia-read-opnd vm dst))
               (vs (lir-vm-ia-read-opnd vm src)))
           (vm-update-add-flags! vm vd vs)
           (lir-vm-ia-write-opnd! vm src vd)
           (lir-vm-ia-write-opnd! vm dst (+ vd vs)))))
      ((or (string=? mnem "cmpxchg") (string=? mnem "cmpxchgq"))
       (let* ((dst (car opnds))
              (src (cadr opnds))
              (acc (vm-get-reg vm '%rax))
              (vd (lir-vm-ia-read-opnd vm dst)))
         (vm-update-cmp-flags! vm acc vd)
         (if (= (lir-vm-s64 acc) (lir-vm-s64 vd))
             (lir-vm-ia-write-opnd! vm dst (lir-vm-ia-read-opnd vm src))
             (vm-set-reg! vm '%rax vd))))
      ((string=? mnem "bswap")
       (let* ((dst (car opnds))
              (sz (caddr dst)))
         (lir-vm-ia-write-opnd! vm dst (lir-vm-ia-bswap-val (lir-vm-ia-read-opnd vm dst) sz))))
      ((or (string=? mnem "rdtsc") (string=? mnem "rdtscp"))
       (let ((t (+ (car *lir-vm-inline-asm-tsc*) 37)))
         (set-car! *lir-vm-inline-asm-tsc* t)
         (vm-set-reg! vm '%rax (bitwise-and t *lir-vm-mask-32*))
         (vm-set-reg! vm '%rdx (arithmetic-shift t -32))
         (if (string=? mnem "rdtscp")
             (vm-set-reg! vm '%rcx 0))))
      ((string=? mnem "cpuid")
       (let ((leaf (lir-vm-u32 (vm-get-reg vm '%rax))))
         (if (= leaf 0)
             (begin
               (vm-set-reg! vm '%rax 1)
               (vm-set-reg! vm '%rbx #x756e6547)
               (vm-set-reg! vm '%rdx #x49656e69)
               (vm-set-reg! vm '%rcx #x6c65746e))
             (begin
               (vm-set-reg! vm '%rax #x000306c3)
               (vm-set-reg! vm '%rbx 0)
               (vm-set-reg! vm '%rcx #x7ffafbbf)
               (vm-set-reg! vm '%rdx #xbfebfbff)))))
      ((string=? mnem "syscall")
       (let ((num (vm-get-reg vm '%rax)))
         (cond
           ((= num 60)
            (vm-set-reg! vm '%rax (vm-get-reg vm '%rdi))
            (vm-set-status! vm 'halted))
           ((= num 39)
            (vm-set-reg! vm '%rax 1000))
           ((= num 1)
            (vm-set-reg! vm '%rax (vm-get-reg vm '%rdx)))
           (else
            (vm-set-reg! vm '%rax 0)))))
      (else
       (error "Unsupported instruction in %inline-asm Reference VM:" line)))))

(define (lir-vm-exec-inline-asm! vm inst)
  (let* ((plan (lir-vm-ia-build-plan inst))
         (template (car plan))
         (out-plans (cadr plan))
         (in-plans (caddr plan))
         (regs-vec (vm-registers-vector vm))
         (saved-regs (make-vector 16 0)))
    ;; 1. Snapshot all 16 GPRs before modifying anything
    (let copy-in ((i 0))
      (if (< i 16)
          (begin
            (vector-set! saved-regs i (vector-ref regs-vec i))
            (copy-in (+ i 1)))))
    ;; 2. Evaluate all staged initial values in parallel BEFORE writing carriers (THREAT-838-2)
    (let* ((staged-rw
            (let loop ((ops out-plans) (acc '()))
              (if (null? ops)
                  (reverse acc)
                  (let ((op (car ops)))
                    (if (and (list-ref op 3) (eq? (list-ref op 4) 'reg))
                        (loop (cdr ops) (cons (cons (list-ref op 5) (vm-eval-operand vm (list-ref op 2))) acc))
                        (loop (cdr ops) acc))))))
           (staged-in
            (let loop ((ips in-plans) (acc '()))
              (if (null? ips)
                  (reverse acc)
                  (let ((ip (car ips)))
                    (if (or (eq? (list-ref ip 3) 'reg)
                            (and (eq? (list-ref ip 3) 'tied) (lir-vm-ia-norm-reg-sym (list-ref ip 4))))
                        (loop (cdr ips) (cons (cons (list-ref ip 4) (vm-eval-operand vm (list-ref ip 2))) acc))
                        (loop (cdr ips) acc))))))
           (final-dst-regs
            (let loop ((ops out-plans) (acc '()))
              (if (null? ops)
                  acc
                  (let ((dg (lir-vm-ia-canonical-gpr (list-ref (car ops) 2))))
                    (if (and dg (not (memq dg acc)))
                        (loop (cdr ops) (cons dg acc))
                        (loop (cdr ops) acc))))))
           (final-dst-indices
            (map gpr-name->index final-dst-regs)))
      ;; Expand template BEFORE overwriting carrier regs if any mem base aliases carrier
      (let* ((handler-key (string->symbol (string-append "__inline_asm__:" template)))
             (custom-entry (assq handler-key (vm-foreign-handlers vm)))
             (expanded-lines (if custom-entry
                                 '()
                                 (lir-vm-ia-split-lines (lir-vm-ia-expand-template vm template out-plans in-plans)))))
        ;; 3. Write parallel staged inputs into carrier GPRs
        (for-each (lambda (p) (vm-set-reg! vm (car p) (cdr p))) staged-rw)
        (for-each (lambda (p) (vm-set-reg! vm (car p) (cdr p))) staged-in)
        ;; 4. Execute custom handler or interpreted instruction lines
        (if custom-entry
            ((cdr custom-entry) vm)
            (for-each (lambda (ln) (lir-vm-ia-exec-line! vm ln)) expanded-lines))
        ;; 5. Read register outputs before restoring non-output registers
        (let ((out-vals
               (map (lambda (op)
                      (if (eq? (list-ref op 4) 'reg)
                          (cons (list-ref op 2) (vm-get-reg vm (list-ref op 5)))
                          #f))
                    out-plans)))
          ;; 6. Restore all non-output GPRs (including clobbers & scratch carriers, THREAT-838-1)
          (let copy-out ((i 0))
            (if (< i 16)
                (begin
                  (if (and (not (= i 4)) (not (memv i final-dst-indices)))
                      (vector-set! regs-vec i (vector-ref saved-regs i)))
                  (copy-out (+ i 1)))))
          ;; 7. Write outputs to LIR destinations (Skip %rsp updates)
          (for-each
           (lambda (ov)
             (if ov
                 (vm-set-location! vm (car ov) (cdr ov))))
           out-vals))))))

;;; Branch & SSA Parallel Assignment Helper
(define (vm-dispatch-jump! vm desc target-lbl args)
  (let ((idx (func-find-label-index desc target-lbl)))
    (if (not idx)
        (vm-trigger-trap! vm 'undefined-target "Jump label not found in function" target-lbl)
        (let ((params (func-find-block-params desc target-lbl)))
          ;; Parallel assignment: evaluate all args before setting any param
          (if (pair? args)
              (let ((vals (map (lambda (a) (vm-eval-operand vm a)) args)))
                (let assign-loop ((ps params) (vs vals))
                  (if (and (pair? ps) (pair? vs))
                      (begin
                        (vm-set-location! vm (car ps) (car vs))
                        (assign-loop (cdr ps) (cdr vs)))))))
          (vm-set-current-block! vm target-lbl)
          (vm-set-pc! vm idx)))))

;;; Return Helper
(define (vm-dispatch-return! vm val-opnd)
  (if val-opnd
      (let ((ret-val (vm-eval-operand vm val-opnd)))
        (vm-set-reg! vm '%rax ret-val)))
  (let ((stack (vm-call-stack vm)))
    (if (null? stack)
        ;; Finished %main -> Halt VM
        (vm-set-status! vm 'halted)
        ;; Pop caller frame
        (let* ((frame (car stack))
               (saved-fn (car frame))
               (saved-pc (cadr frame))
               (saved-rsp (caddr frame)))
          (vm-set-call-stack! vm (cdr stack))
          (vm-set-reg! vm '%rsp saved-rsp)
          (vm-set-current-fn! vm saved-fn)
          (vm-set-pc! vm saved-pc)))))

;;; C Foreign Call Dispatcher
(define (vm-dispatch-c-call! vm fn-name shift)
  ;; Check registered custom handlers first (supports both string and symbol names)
  (let* ((fn-sym (if (string? fn-name) (string->symbol fn-name) fn-name))
         (fn-str (if (symbol? fn-name) (symbol->string fn-name) fn-name))
         (custom (or (assq fn-sym (vm-foreign-handlers vm))
                     (assoc fn-str (vm-foreign-handlers vm)))))
    (if custom
        ((cdr custom) vm)
        (case fn-sym
          ((ulisp_alloc malloc)
           (let* ((bytes (vm-get-reg vm '%rdi))
                  (tag (if (eq? fn-sym 'ulisp_alloc) (vm-get-reg vm '%rsi) 0))
                  (aligned (bitwise-and (+ bytes 7) -8))
                  (raw-ptr (vm-heap-ptr vm))
                  (new-ptr (+ raw-ptr aligned)))
             (if (> new-ptr *lir-vm-heap-limit*)
                 (vm-trigger-trap! vm 'out-of-bounds "Heap out of memory" new-ptr)
                 (begin
                   (vm-set-heap-ptr! vm new-ptr)
                   (vm-set-reg! vm '%rax (+ raw-ptr tag))))))

          ((putchar)
           (let ((c (bitwise-and (vm-get-reg vm '%rdi) #xff)))
             (vm-set-reg! vm '%rax c)))

          ((puts printf)
           (vm-set-reg! vm '%rax 0))

          ((exit)
           (vm-set-status! vm 'halted))

          (else
           ;; Default stub: succeed with rax = 0
           (vm-set-reg! vm '%rax 0))))))

(define (register-c-foreign-handler! vm name proc)
  (let* ((key (if (string? name) (string->symbol name) name))
         (entry (assq key (vm-foreign-handlers vm))))
    (if entry
        (set-cdr! entry proc)
        (vm-set-foreign-handlers! vm (cons (cons key proc) (vm-foreign-handlers vm))))))

;;; -----------------------------------------------------------------------
;;; §10. Public Execution & Convenience APIs
;;; -----------------------------------------------------------------------

(define (lir-vm-run! vm)
  (let loop ()
    (let ((st (lir-vm-step! vm)))
      (if (or (eq? st 'halted) (eq? st 'trapped))
          st
          (loop)))))

(define (set-lir-vm-tracer! vm proc)
  (vm-set-tracer! vm proc))

(define (eval-lir-program prog)
  (let ((vm (make-lir-vm)))
    (lir-vm-load! vm prog)
    (let ((res (lir-vm-run! vm)))
      (if (eq? res 'trapped)
          (error "LIR VM Trapped during evaluation:" (vm-last-trap vm))
          (vm-get-reg vm '%rax)))))

(define (eval-lir-program-with-fuel prog fuel)
  (let ((vm (make-lir-vm)))
    (vm-set-fuel! vm fuel)
    (lir-vm-load! vm prog)
    (let ((res (lir-vm-run! vm)))
      (if (eq? res 'trapped)
          (vm-last-trap vm)
          (vm-get-reg vm '%rax)))))

(define (eval-lir-program-unboxed prog)
  (let ((val (eval-lir-program prog)))
    (quotient val 4)))
