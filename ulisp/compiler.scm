              (call-part (list (list '%raw-asm (string-append "    call " reg-str)))))
         (append sub-part (append al-part (append call-part add-part)))))

      ((%call-closure)
       (let ((frame-shift (cadr inst))
             (safepoint (if (pair? (cddr inst)) (caddr inst) #f)))
         (let ((sp-str (if (symbol? safepoint) (symbol->raw-name safepoint) safepoint))
               (shift-str (small-int->string frame-shift)))
           (if (> frame-shift 0)
               (if safepoint
                   (list (list '%raw-asm (string-append "    sub rsp, " shift-str))
                         (list '%raw-asm "    mov r11, [r10 - 1]")
                         (list '%raw-asm "    call r11")
                         (list '%raw-asm (string-append sp-str ":"))
                         (list '%raw-asm (string-append "    add rsp, " shift-str)))
                   (list (list '%raw-asm (string-append "    sub rsp, " shift-str))
                         (list '%raw-asm "    mov r11, [r10 - 1]")
                         (list '%raw-asm "    call r11")
                         (list '%raw-asm (string-append "    add rsp, " shift-str))))
               (if safepoint
                   (list (list '%raw-asm "    mov r11, [r10 - 1]")
                         (list '%raw-asm "    call r11")
                         (list '%raw-asm (string-append sp-str ":")))
                   (list (list '%raw-asm "    mov r11, [r10 - 1]")
                         (list '%raw-asm "    call r11")))))))

      ((%direct-call)
       (let* ((label (cadr inst))
              (frame-shift (caddr inst))
              (safepoint (if (pair? (cdddr inst)) (cadddr inst) #f))
              (lbl-str (if (symbol? label) (symbol->raw-name label) label))
              (sp-str (if (symbol? safepoint) (symbol->raw-name safepoint) safepoint))
              (c-tu? (eq? (car *backend-gc-mode*) 'c-tu))
              (adj (x86-call-frame-adjustments frame-shift))
              (sub-part (car adj))
              (add-part (cdr adj))
              (r10-part (if c-tu? '() (list (list '%raw-asm "    xor r10, r10"))))
              (call-part (list (list '%raw-asm (string-append "    call " lbl-str))))
              (sp-part (if safepoint (list (list '%raw-asm (string-append sp-str ":"))) '())))
         (backend-concat (list sub-part r10-part call-part sp-part add-part))))

      ((%global-ref)
       (let ((reg (cadr inst))
             (var (caddr inst)))
         (let ((g-lbl (mangle-gvar-label var)))
           (list (list '%raw-asm (string-append "    lea r11, [rip + " g-lbl "]"))
                 (list '%raw-asm (string-append "    mov " (reg->str reg) ", [r11]"))))))

      ((%global-addr)
       (let ((reg (cadr inst))
             (var (caddr inst)))
         (let ((g-lbl (if (eq? (car *backend-gc-mode*) 'c-tu)
                          (asm-label->str var)
                          (mangle-gvar-label var))))
