;; -----------------------------------------------------------------------
(define (asm-copy-op-bytes! bv base-off bytes)
  (let loop ((bs bytes) (i 0))
    (if (pair? bs)
        (begin
          (bytevector-u8-set! bv (+ base-off i) (car bs))
          (loop (cdr bs) (+ i 1)))
        i)))

(define (asm-resolve-aliases! aliases sym-map sym-table-add!)
  (let loop-pass ((depth 0))
    (if (< depth 8)
        (let step ((as aliases) (changed? #f))
          (if (null? as)
              (if changed? (loop-pass (+ depth 1)))
              (let* ((alias (caar as))
                     (tgt (cdar as)))
                (if (not (symbol-map-contains? sym-map alias))
                    (let ((hit (symbol-map-get sym-map tgt)))
                      (if hit
                          (let ((val (cdr hit)))
                            (symbol-map-set! sym-map alias val)
                            (sym-table-add! alias val)
                            (step (cdr as) #t))
                          (step (cdr as) changed?)))
                    (step (cdr as) changed?))))))))

;; Main interface:
;; (assemble-x86-lines lines)
;; Returns: (list text-bv rodata-bv data-bv bss-size entry-offset [file-table line-table sym-table])
(define (assemble-x86-lines lines)
  (let ((file-table-box (cons '() '()))
        (line-table-box (cons '() '()))
        (globl-box (cons '() '()))
        (weak-box (cons '() '()))
        (types-box (cons '() '()))
        (aliases-box (cons '() '()))
        (sym-map (make-symbol-map 8192)))
    (let pass1-loop ((lines-rest lines)
                   (sym-table '())
                   (relocs '())
                   (text-ops '())
                   (rodata-ops '())
                   (data-ops '())
                   (cur-sec 'text)
                   (text-len 0)
                   (rodata-len 0)
                   (data-len 0)
                   (bss-len 0)
                   (entry-off -1))
    (if (pair? lines-rest)
        (let* ((line (car lines-rest))
               (clean (asm-trim-string (asm-strip-comment line))))
          (if (= (string-length clean) 0)
              (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                          cur-sec text-len rodata-len data-len bss-len entry-off)
              (let ((tokens (asm-tokenize-line clean)))
                (if (null? tokens)
                    (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                cur-sec text-len rodata-len data-len bss-len entry-off)
                    (let ((first (car tokens)))
                      (cond
                        ;; Label definition: "NAME:"
                        ((or (and (pair? (cdr tokens)) (string=? (cadr tokens) ":"))
                             (char=? (string-ref first (- (string-length first) 1)) #\:))
                         (let* ((lbl-name (if (char=? (string-ref first (- (string-length first) 1)) #\:)
                                              (substring first 0 (- (string-length first) 1))
                                              first))
                                (off (case cur-sec
                                       ((text) text-len)
                                       ((rodata) rodata-len)
                                       ((data) data-len)
                                       ((bss) bss-len)
                                       (else text-len)))
                                (new-entry-off (cond
                                                 ((string=? lbl-name "_start") off)
                                                 ((and (= entry-off -1) (string=? lbl-name "scheme_entry")) off)
                                                 (else entry-off)))
                                (colon-pos (let cloop ((i 0))
                                             (if (or (>= i (string-length clean)) (char=? (string-ref clean i) #\:))
                                                 i
                                                 (cloop (+ i 1)))))
                                (rem-line (if (< (+ colon-pos 1) (string-length clean))
                                              (asm-trim-string (substring clean (+ colon-pos 1) (string-length clean)))
                                              ""))
                                (next-lines (if (> (string-length rem-line) 0)
                                                (cons rem-line (cdr lines-rest))
                                                (cdr lines-rest))))
                           (symbol-map-set! sym-map lbl-name (list cur-sec off))
                           (pass1-loop next-lines
                                       (cons (cons lbl-name (list cur-sec off)) sym-table)
                                       relocs text-ops rodata-ops data-ops
                                       cur-sec text-len rodata-len data-len bss-len new-entry-off)))

                        ;; Section switching directives
                        ((or (string=? first ".text") (string-starts-with? clean ".section .text"))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     'text text-len rodata-len data-len bss-len entry-off))
                        ((or (string=? first ".data") (string-starts-with? clean ".section .data"))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     'data text-len rodata-len data-len bss-len entry-off))
                        ((or (string=? first ".rodata") (string-starts-with? clean ".section .rodata"))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     'rodata text-len rodata-len data-len bss-len entry-off))
                        ((or (string=? first ".bss") (string-starts-with? clean ".section .bss"))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     'bss text-len rodata-len data-len bss-len entry-off))
                        ((string-starts-with? clean ".section ulisp_globals_sec")
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     'rodata text-len rodata-len data-len bss-len entry-off))
                        ((string-starts-with? clean ".section .init_array")
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     'data text-len rodata-len data-len bss-len entry-off))
                        ((or (string=? first ".section") (string=? first ".pushsection"))
                         (let ((target (if (pair? (cdr tokens)) (asm-canonical-section (cadr tokens)) 'text)))
                           (case target
                             ((text) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops 'text text-len rodata-len data-len bss-len entry-off))
                             ((data) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops 'data text-len rodata-len data-len bss-len entry-off))
                             ((rodata) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops 'rodata text-len rodata-len data-len bss-len entry-off))
                             ((bss) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops 'bss text-len rodata-len data-len bss-len entry-off))
                             ((init_array) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops 'data text-len rodata-len data-len bss-len entry-off))
                             ((ulisp_globals_sec) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops 'rodata text-len rodata-len data-len bss-len entry-off))
                             (else (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops cur-sec text-len rodata-len data-len bss-len entry-off)))))

                        ;; Symbol binding and type directives (Issue #830 / #928)
                        ((or (string=? first ".globl") (string=? first ".global"))
                         (let ((groups (asm-split-by-comma (cdr tokens))))
                           (let gloop ((gs groups))
                             (if (pair? gs)
                                 (let ((sym (asm-tokens->string (car gs))))
                                   (if (> (string-length sym) 0)
                                       (set-car! globl-box (cons sym (car globl-box))))
                                   (gloop (cdr gs)))))
                           (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                       cur-sec text-len rodata-len data-len bss-len entry-off)))
                        ((string=? first ".weak")
                         (let ((groups (asm-split-by-comma (cdr tokens))))
                           (let wloop ((gs groups))
                             (if (pair? gs)
                                 (let ((sym (asm-tokens->string (car gs))))
                                   (if (> (string-length sym) 0)
                                       (set-car! weak-box (cons sym (car weak-box))))
                                   (wloop (cdr gs)))))
                           (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                       cur-sec text-len rodata-len data-len bss-len entry-off)))
                        ((or (string=? first ".set") (string=? first ".equiv"))
                         (let ((groups (asm-split-by-comma (cdr tokens))))
                           (if (and (pair? groups) (pair? (cdr groups)))
                               (let ((alias (asm-tokens->string (car groups)))
                                     (tgt (asm-tokens->string (cadr groups))))
                                 (if (and (> (string-length alias) 0) (> (string-length tgt) 0))
                                     (set-car! aliases-box (cons (cons alias tgt) (car aliases-box)))))))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     cur-sec text-len rodata-len data-len bss-len entry-off))
                        ((or (string=? first ".hidden")
                             (string=? first ".protected")
                             (string=? first ".internal")
                             (string=? first ".size"))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     cur-sec text-len rodata-len data-len bss-len entry-off))
                        ((string=? first ".type")
                         (if (and (pair? (cdr tokens)) (pair? (cddr tokens)))
                             (let* ((sym (cadr tokens))
                                    (rest-toks (cddr tokens))
                                    (type-tok (if (and (string=? (car rest-toks) ",") (pair? (cdr rest-toks)))
                                                  (cadr rest-toks)
                                                  (car rest-toks)))
                                    (stt (cond
                                           ((or (string=? type-tok "@function") (string=? type-tok "%function")) 2)
                                           ((or (string=? type-tok "@object") (string=? type-tok "%object")) 1)
                                           (else 0))))
                               (set-car! types-box (cons (cons sym stt) (car types-box)))))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     cur-sec text-len rodata-len data-len bss-len entry-off))

                        ((or (string-starts-with? clean ".section .note")
                             (string=? first ".intel_syntax"))
                         (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                     cur-sec text-len rodata-len data-len bss-len entry-off))

                        ;; DWARF directives (Issue #619)
                        ((string=? first ".file")
                         (let* ((fid (if (pair? (cdr tokens)) (safe-string->number (cadr tokens)) 1))
                                (fpath (if (and (pair? (cdr tokens)) (pair? (cddr tokens))) (caddr tokens) "source.scm")))
                           (set-car! file-table-box (cons (cons (if fid fid 1) fpath) (car file-table-box)))
                           (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                       cur-sec text-len rodata-len data-len bss-len entry-off)))
                        ((string=? first ".loc")
                         (let* ((fid (if (pair? (cdr tokens)) (safe-string->number (cadr tokens)) 1))
                                (line (if (and (pair? (cdr tokens)) (pair? (cddr tokens))) (safe-string->number (caddr tokens)) 1))
                                (col (if (and (pair? (cdr tokens)) (pair? (cddr tokens)) (pair? (cdddr tokens)))
                                         (safe-string->number (cadddr tokens)) 0)))
                           (set-car! line-table-box (cons (list (if fid fid 1) (if line line 1) (if col col 0) text-len) (car line-table-box)))
                           (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                       cur-sec text-len rodata-len data-len bss-len entry-off)))

                        ;; Alignment
                        ((or (string=? first ".align") (string=? first ".p2align"))
                         (let* ((val (if (pair? (cdr tokens)) (safe-string->number (cadr tokens)) 8))
                                (align (if (string=? first ".p2align") (expt 2 val) val)))
                           (case cur-sec
                             ((text)
                              (let* ((rem (modulo text-len align))
                                     (pad (if (= rem 0) 0 (- align rem))))
                                (pass1-loop (cdr lines-rest) sym-table relocs
                                            (cons (cons 'pad-nop pad) text-ops)
                                            rodata-ops data-ops cur-sec
                                            (+ text-len pad) rodata-len data-len bss-len entry-off)))
                             ((rodata)
                              (let* ((rem (modulo rodata-len align))
                                     (pad (if (= rem 0) 0 (- align rem))))
                                (pass1-loop (cdr lines-rest) sym-table relocs text-ops
                                            (cons (cons 'pad-zero pad) rodata-ops)
                                            data-ops cur-sec text-len
                                            (+ rodata-len pad) data-len bss-len entry-off)))
                             ((data)
                              (let* ((rem (modulo data-len align))
                                     (pad (if (= rem 0) 0 (- align rem))))
                                (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops
                                            (cons (cons 'pad-zero pad) data-ops)
                                            cur-sec text-len rodata-len
                                            (+ data-len pad) bss-len entry-off)))
                             ((bss)
                              (let* ((rem (modulo bss-len align))
                                     (pad (if (= rem 0) 0 (- align rem))))
                                (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                            cur-sec text-len rodata-len data-len
                                            (+ bss-len pad) entry-off)))
                             (else
                              (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                          cur-sec text-len rodata-len data-len bss-len entry-off)))))

                        ;; Data directives: .byte
                        ((string=? first ".byte")
                         (let* ((groups (asm-split-by-comma (cdr tokens))))
                           (let byte-loop ((gs groups)
                                           (cur-ops (case cur-sec ((text) text-ops) ((data) data-ops) (else rodata-ops)))
                                           (cur-len (case cur-sec ((text) text-len) ((data) data-len) (else rodata-len))))
                             (if (null? gs)
                                 (case cur-sec
                                   ((text) (pass1-loop (cdr lines-rest) sym-table relocs cur-ops rodata-ops data-ops cur-sec cur-len rodata-len data-len bss-len entry-off))
                                   ((data) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops cur-ops cur-sec text-len rodata-len cur-len bss-len entry-off))
                                   (else   (pass1-loop (cdr lines-rest) sym-table relocs text-ops cur-ops data-ops cur-sec text-len cur-len data-len bss-len entry-off)))
                                 (let* ((g (car gs))
                                        (expr (asm-parse-data-expr (asm-tokens->string g)))
                                        (val (if (eq? (car expr) 'num) (cdr expr) 0))
                                        (b (modulo (if (< val 0) (+ val 256) val) 256)))
                                   (byte-loop (cdr gs) (cons (list b) cur-ops) (+ cur-len 1)))))))

                        ;; Data directives: .short / .2byte
                        ((or (string=? first ".short") (string=? first ".2byte"))
                         (let* ((groups (asm-split-by-comma (cdr tokens))))
                           (let short-loop ((gs groups)
                                            (cur-ops (case cur-sec ((text) text-ops) ((data) data-ops) (else rodata-ops)))
                                            (cur-len (case cur-sec ((text) text-len) ((data) data-len) (else rodata-len))))
                             (if (null? gs)
                                 (case cur-sec
                                   ((text) (pass1-loop (cdr lines-rest) sym-table relocs cur-ops rodata-ops data-ops cur-sec cur-len rodata-len data-len bss-len entry-off))
                                   ((data) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops cur-ops cur-sec text-len rodata-len cur-len bss-len entry-off))
                                   (else   (pass1-loop (cdr lines-rest) sym-table relocs text-ops cur-ops data-ops cur-sec text-len cur-len data-len bss-len entry-off)))
                                 (let* ((g (car gs))
                                        (expr (asm-parse-data-expr (asm-tokens->string g)))
                                        (val (if (eq? (car expr) 'num) (cdr expr) 0))
                                        (bs (split-u16-le val)))
                                   (short-loop (cdr gs) (cons bs cur-ops) (+ cur-len 2)))))))

                        ;; Data directives: .long / .4byte
                        ((or (string=? first ".long") (string=? first ".4byte"))
                         (let* ((groups (asm-split-by-comma (cdr tokens))))
                           (let long-loop ((gs groups)
                                           (cur-ops (case cur-sec ((text) text-ops) ((data) data-ops) (else rodata-ops)))
                                           (cur-len (case cur-sec ((text) text-len) ((data) data-len) (else rodata-len)))
                                           (cur-rels relocs))
                             (if (null? gs)
                                 (case cur-sec
                                   ((text) (pass1-loop (cdr lines-rest) sym-table cur-rels cur-ops rodata-ops data-ops cur-sec cur-len rodata-len data-len bss-len entry-off))
                                   ((data) (pass1-loop (cdr lines-rest) sym-table cur-rels text-ops rodata-ops cur-ops cur-sec text-len rodata-len cur-len bss-len entry-off))
                                   (else   (pass1-loop (cdr lines-rest) sym-table cur-rels text-ops cur-ops data-ops cur-sec text-len cur-len data-len bss-len entry-off)))
                                 (let* ((g (car gs))
                                        (expr (asm-parse-data-expr (asm-tokens->string g))))
                                   (cond
                                     ((eq? (car expr) 'num)
                                      (let ((bs (split-u32-le (cdr expr))))
                                        (long-loop (cdr gs) (cons bs cur-ops) (+ cur-len 4) cur-rels)))
                                     ((eq? (car expr) 'sym-diff)
                                      (let* ((pair (cdr expr))
                                             (new-rel (list 'sym_diff32 cur-sec cur-len (car pair) (cdr pair))))
                                        (long-loop (cdr gs) (cons '(0 0 0 0) cur-ops) (+ cur-len 4) (cons new-rel cur-rels))))
                                     (else
                                      (let* ((sym-info (cdr expr))
                                             (sym-name (car sym-info))
                                             (addend (cdr sym-info))
                                             (new-rel (list 'abs32 cur-sec cur-len sym-name addend)))
                                        (long-loop (cdr gs) (cons '(0 0 0 0) cur-ops) (+ cur-len 4) (cons new-rel cur-rels))))))))))

                        ;; Data directives: .quad / .8byte
                        ((or (string=? first ".quad") (string=? first ".8byte"))
                         (let* ((groups (asm-split-by-comma (cdr tokens))))
                           (let quad-loop ((gs groups)
                                           (cur-ops (case cur-sec ((text) text-ops) ((data) data-ops) (else rodata-ops)))
                                           (cur-len (case cur-sec ((text) text-len) ((data) data-len) (else rodata-len)))
                                           (cur-rels relocs))
                             (if (null? gs)
                                 (case cur-sec
                                   ((text) (pass1-loop (cdr lines-rest) sym-table cur-rels cur-ops rodata-ops data-ops cur-sec cur-len rodata-len data-len bss-len entry-off))
                                   ((data) (pass1-loop (cdr lines-rest) sym-table cur-rels text-ops rodata-ops cur-ops cur-sec text-len rodata-len cur-len bss-len entry-off))
                                   (else   (pass1-loop (cdr lines-rest) sym-table cur-rels text-ops cur-ops data-ops cur-sec text-len cur-len data-len bss-len entry-off)))
                                 (let* ((g (car gs))
                                        (expr (asm-parse-data-expr (asm-tokens->string g))))
                                   (if (eq? (car expr) 'num)
                                       (let ((bs (split-u64-le (cdr expr))))
                                         (quad-loop (cdr gs) (cons bs cur-ops) (+ cur-len 8) cur-rels))
                                       (let* ((sym-info (cdr expr))
                                              (sym-name (car sym-info))
                                              (addend (cdr sym-info))
                                              (new-rel (list 'abs64 cur-sec cur-len sym-name addend)))
                                         (quad-loop (cdr gs) (cons '(0 0 0 0 0 0 0 0) cur-ops) (+ cur-len 8) (cons new-rel cur-rels)))))))))

                        ;; Data directives: .string / .asciz / .ascii
                        ((or (string=? first ".string") (string=? first ".asciz") (string=? first ".ascii"))
                         (let* ((null-term? (not (string=? first ".ascii")))
                                (groups (asm-split-by-comma (cdr tokens))))
                           (let str-loop ((gs groups)
                                          (cur-ops (case cur-sec ((text) text-ops) ((data) data-ops) (else rodata-ops)))
                                          (cur-len (case cur-sec ((text) text-len) ((data) data-len) (else rodata-len))))
                             (if (null? gs)
                                 (case cur-sec
                                   ((text) (pass1-loop (cdr lines-rest) sym-table relocs cur-ops rodata-ops data-ops cur-sec cur-len rodata-len data-len bss-len entry-off))
                                   ((data) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops cur-ops cur-sec text-len rodata-len cur-len bss-len entry-off))
                                   (else   (pass1-loop (cdr lines-rest) sym-table relocs text-ops cur-ops data-ops cur-sec text-len cur-len data-len bss-len entry-off)))
                                 (let* ((g (car gs))
                                        (expr (asm-parse-data-expr (asm-tokens->string g)))
                                        (raw-str (cond
                                                   ((eq? (car expr) 'str) (cdr expr))
                                                   ((pair? g) (car g))
                                                   (else "")))
                                        (bs (asm-string->bytes raw-str null-term?))
                                        (blen (length bs)))
                                   (str-loop (cdr gs) (cons bs cur-ops) (+ cur-len blen)))))))

                        ;; Data directives: .space / .zero
                        ((or (string=? first ".space") (string=? first ".zero"))
                         (let* ((groups (asm-split-by-comma (cdr tokens)))
                                (cnt-expr (if (pair? groups) (asm-parse-data-expr (asm-tokens->string (car groups))) '(num . 0)))
                                (cnt (if (eq? (car cnt-expr) 'num) (cdr cnt-expr) 0))
                                (val-expr (if (and (pair? groups) (pair? (cdr groups))) (asm-parse-data-expr (asm-tokens->string (cadr groups))) '(num . 0)))
                                (val (if (eq? (car val-expr) 'num) (cdr val-expr) 0)))
                           (if (<= cnt 0)
                               (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops cur-sec text-len rodata-len data-len bss-len entry-off)
                               (if (eq? cur-sec 'bss)
                                   (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops cur-sec text-len rodata-len data-len (+ bss-len cnt) entry-off)
                                   (let ((op (if (= val 0) (cons 'pad-zero cnt) (asm-make-byte-list cnt val))))
                                     (case cur-sec
                                       ((text) (pass1-loop (cdr lines-rest) sym-table relocs (cons op text-ops) rodata-ops data-ops cur-sec (+ text-len cnt) rodata-len data-len bss-len entry-off))
                                       ((data) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops (cons op data-ops) cur-sec text-len rodata-len (+ data-len cnt) bss-len entry-off))
                                       (else   (pass1-loop (cdr lines-rest) sym-table relocs text-ops (cons op rodata-ops) data-ops cur-sec text-len (+ rodata-len cnt) data-len bss-len entry-off))))))))

                        ;; Data directives: .fill
                        ((string=? first ".fill")
                         (let* ((groups (asm-split-by-comma (cdr tokens)))
                                (fill-params (asm-parse-fill-args groups))
                                (repeat (car fill-params))
                                (size (cadr fill-params))
                                (val (caddr fill-params))
                                (total-bytes (* repeat size)))
                           (if (<= total-bytes 0)
                               (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops cur-sec text-len rodata-len data-len bss-len entry-off)
                               (if (eq? cur-sec 'bss)
                                   (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops cur-sec text-len rodata-len data-len (+ bss-len total-bytes) entry-off)
                                   (let ((op (if (= val 0)
                                                 (cons 'pad-zero total-bytes)
                                                 (asm-generate-fill-bytes repeat size val))))
                                     (case cur-sec
                                       ((text) (pass1-loop (cdr lines-rest) sym-table relocs (cons op text-ops) rodata-ops data-ops cur-sec (+ text-len total-bytes) rodata-len data-len bss-len entry-off))
                                       ((data) (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops (cons op data-ops) cur-sec text-len rodata-len (+ data-len total-bytes) bss-len entry-off))
                                       (else   (pass1-loop (cdr lines-rest) sym-table relocs text-ops (cons op rodata-ops) data-ops cur-sec text-len (+ rodata-len total-bytes) data-len bss-len entry-off))))))))

                        ;; Instruction
                        (else
                         (let* ((has-lock? (and (string=? (safe-string-downcase first) "lock") (pair? (cdr tokens))))
                                (mnem (if has-lock? (cadr tokens) first))
                                (raw-opnd-tokens (if has-lock? (cddr tokens) (cdr tokens)))
                                (opnd-strs (let loop ((ts raw-opnd-tokens) (cur '()) (acc '()))
                                             (cond
                                               ((null? ts)
                                                (if (null? cur) (reverse acc)
                                                    (reverse (cons (let l ((cs (reverse cur)) (s ""))
                                                                     (if (null? cs) s (l (cdr cs) (string-append s (car cs) " ")))) acc))))
                                               ((string=? (car ts) ",")
                                                (loop (cdr ts) '()
                                                      (cons (let l ((cs (reverse cur)) (s ""))
                                                              (if (null? cs) s (l (cdr cs) (string-append s (car cs) " ")))) acc)))
                                               (else
                                                (loop (cdr ts) (cons (car ts) cur) acc)))))
                                (opnds (map parse-operand-str opnd-strs))
                                (res (assemble-inst-with-syms mnem opnds (if has-lock? (+ text-len 1) text-len) sym-map)))
                           (if (pair? res)
                               (let* ((bytes (if has-lock? (cons 240 (car res)) (car res)))
                                      (reloc (cadr res))
                                      (new-relocs (if reloc
                                                      (cons (cons (car reloc) (cons 'text (cdr reloc))) relocs)
                                                      relocs))
                                      (blen (length bytes)))
                                 (pass1-loop (cdr lines-rest) sym-table new-relocs (cons bytes text-ops) rodata-ops data-ops
                                             cur-sec (+ text-len blen) rodata-len data-len bss-len entry-off))
                               (pass1-loop (cdr lines-rest) sym-table relocs text-ops rodata-ops data-ops
                                           cur-sec text-len rodata-len data-len bss-len entry-off))))))))))
        ;; ---------------------------------------------------------------
        ;; Pass 2: Allocate bytevectors, copy bytes, patch relocations
        ;; ---------------------------------------------------------------
        ;; Resolve .set/.equiv aliases before Pass 2 relocations
        (let* ((sym-table-box (cons sym-table '()))
               (_res (asm-resolve-aliases! (reverse (car aliases-box)) sym-map
                                           (lambda (a v) (set-car! sym-table-box (cons (cons a v) (car sym-table-box))))))
               (sym-table (car sym-table-box))
               (text-bv (make-bytevector text-len 0))
               (rodata-bv (make-bytevector rodata-len 0))
               (data-bv (make-bytevector data-len 0))

               ;; Virtual Addresses
               (vaddr-text-base (+ 4194304 176))
               (vaddr-rodata-base (+ vaddr-text-base text-len))
               (vaddr-data-base 6291456)
               (vaddr-bss-base (+ vaddr-data-base data-len)))

          ;; Copy text bytes
          (let loop ((ops (reverse text-ops)) (off 0))
            (if (pair? ops)
                (let ((op (car ops)))
                  (cond
                    ((and (pair? op) (eq? (car op) 'pad-nop))
                     (let ((pad (cdr op)))
                       (let fill ((k 0))
                         (if (< k pad)
                             (begin
                               (bytevector-u8-set! text-bv (+ off k) 144)
                               (fill (+ k 1)))
                             (loop (cdr ops) (+ off pad))))))
                    (else
                     (let ((n (asm-copy-op-bytes! text-bv off op)))
                       (loop (cdr ops) (+ off n))))))
                #t))

          ;; Copy rodata bytes
          (let loop ((ops (reverse rodata-ops)) (off 0))
            (if (pair? ops)
                (let ((op (car ops)))
                  (cond
                    ((and (pair? op) (eq? (car op) 'pad-zero))
                     (loop (cdr ops) (+ off (cdr op))))
                    (else
                     (let ((n (asm-copy-op-bytes! rodata-bv off op)))
                       (loop (cdr ops) (+ off n))))))
                #t))

          ;; Copy data bytes
          (let loop ((ops (reverse data-ops)) (off 0))
            (if (pair? ops)
                (let ((op (car ops)))
                  (cond
                    ((and (pair? op) (eq? (car op) 'pad-zero))
                     (loop (cdr ops) (+ off (cdr op))))
                    (else
                     (let ((n (asm-copy-op-bytes! data-bv off op)))
                       (loop (cdr ops) (+ off n))))))
                #t))

          ;; Apply Relocations
          (let reloc-loop ((rels relocs))
            (if (pair? rels)
                (let* ((rel (car rels))
                       (type (car rel))
                       (sec (cadr rel))
                       (patch-off (caddr rel)))
                  (if (eq? type 'sym_diff32)
                      (let* ((sym1 (cadddr rel))
                             (sym2 (car (cddddr rel)))
                             (resolve-vaddr (lambda (s)
                                              (let ((entry (symbol-map-get sym-map s)))
                                                (if entry
                                                    (let* ((val (cdr entry))
                                                           (sec2 (car val))
                                                           (o (cadr val)))
                                                      (case sec2
                                                        ((text) (+ vaddr-text-base o))
                                                        ((rodata) (+ vaddr-rodata-base o))
                                                        ((data) (+ vaddr-data-base o))
                                                        ((bss) (+ vaddr-bss-base o))
                                                        (else (+ vaddr-text-base o))))
                                                    0))))
                             (diff (- (resolve-vaddr sym1) (resolve-vaddr sym2)))
                             (target-bv (case sec
                                          ((text) text-bv)
                                          ((data) data-bv)
                                          (else rodata-bv))))
                        (elf64-set-u32-le! target-bv patch-off diff)
                        (reloc-loop (cdr rels)))
                      (let* ((sym (cadddr rel))
                             (addend (car (cddddr rel)))
                             (adj (if (pair? (cdr (cddddr rel))) (cadr (cddddr rel)) 0))
                             (sym-vaddr (let ((entry (symbol-map-get sym-map sym)))
                                          (if entry
                                              (let ((val (cdr entry)))
                                                (let ((s (car val))
                                                      (o (cadr val)))
                                                  (case s
                                                    ((text) (+ vaddr-text-base o))
                                                    ((rodata) (+ vaddr-rodata-base o))
                                                    ((data) (+ vaddr-data-base o))
                                                    ((bss) (+ vaddr-bss-base o))
                                                    (else (+ vaddr-text-base o)))))
                                              0)))
                             (target-vaddr (+ sym-vaddr addend)))
                        (case type
                          ((rel32)
                           (let* ((patch-vaddr (+ vaddr-text-base patch-off))
                                  (next-ip (+ patch-vaddr 4))
                                  (diff (- target-vaddr next-ip)))
                             (elf64-set-u32-le! text-bv patch-off diff)))

                          ((rip_disp32)
                           (let* ((patch-vaddr (+ vaddr-text-base patch-off))
                                  (next-ip (+ (+ patch-vaddr 4) adj))
                                  (diff (if (= sym-vaddr 0)
                                            (- 0 next-ip)
                                            (- target-vaddr next-ip))))
                             (elf64-set-u32-le! text-bv patch-off diff)))

                          ((abs64)
                           (let ((target-bv (case sec
                                              ((text) text-bv)
                                              ((data) data-bv)
                                              (else rodata-bv))))
                             (elf64-set-u64-le! target-bv patch-off target-vaddr)))

                          ((abs32 abs32s)
                           (let ((target-bv (case sec
                                              ((text) text-bv)
                                              ((data) data-bv)
                                              (else rodata-bv))))
                             (elf64-set-u32-le! target-bv patch-off target-vaddr))))
                        (reloc-loop (cdr rels)))))
                #t))

          ;; Return tuple: (text-bv rodata-bv data-bv bss-size entry-offset file-table line-table sym-table globl-syms weak-syms sym-types)
          (list text-bv rodata-bv data-bv bss-len (if (= entry-off -1) 0 entry-off)
                (reverse (car file-table-box))
                (reverse (car line-table-box))
                sym-table
                (reverse (car globl-box))
                (reverse (car weak-box))
                (reverse (car types-box))))))))

;; -----------------------------------------------------------------------
;; 6. Relocatable ELF64 Object (ET_REL) 2-Pass Assembler (Issue #783)
;; -----------------------------------------------------------------------
;; (assemble-x86-relocatable lines)
;; Returns:
;;   (list text-bv rodata-bv data-bv bss-len init-array-bv globals-bv
;;         sym-table globl-syms weak-syms sym-types reloc-records)
;; where each reloc-record in reloc-records is:
;;   (list sec patch-off target r-type r-addend)
;;   - sec: 'text | 'rodata | 'data | 'init_array | 'ulisp_globals_sec
;;   - patch-off: integer byte offset within sec
;;   - target: integer 1..6 (section symbol index) OR string (global/weak/undef symbol name)
;;   - r-type: 1 (R_X86_64_64), 2 (R_X86_64_PC32), or 4 (R_X86_64_PLT32)
;;   - r-addend: signed 64-bit integer addend

(define (asm-sec->shndx sec)
  (case sec
    ((text) 1)
    ((rodata) 2)
    ((data) 3)
    ((bss) 4)
    ((init_array) 5)
    ((ulisp_globals_sec) 6)
    (else 1)))

(define (asm-str-list-member? s lst)
  (let loop ((rest lst))
    (if (null? rest)
        #f
        (if (string=? s (car rest))
            #t
            (loop (cdr rest))))))

(define (asm-copy-section-ops! bv ops)
  (let loop ((rest (reverse ops)) (off 0))
    (if (pair? rest)
        (let ((op (car rest)))
          (cond
            ((and (pair? op) (eq? (car op) 'pad-nop))
             (let ((pad (cdr op)))
               (let fill ((k 0))
                 (if (< k pad)
                     (begin
                       (bytevector-u8-set! bv (+ off k) 144)
                       (fill (+ k 1)))
                     (loop (cdr rest) (+ off pad))))))
            ((and (pair? op) (eq? (car op) 'pad-zero))
             (loop (cdr rest) (+ off (cdr op))))
            (else
             (let ((n (asm-copy-op-bytes! bv off op)))
               (loop (cdr rest) (+ off n))))))
        #t)))

(define (assemble-x86-relocatable lines)
  (let ((sym-table-box (vector '()))
        (sym-map (make-symbol-map 8192))
        (globl-map (make-symbol-map 2048))
        (weak-map (make-symbol-map 512))
        (globl-box (vector '()))
        (weak-box (vector '()))
        (types-box (vector '()))
        (aliases-box (vector '()))
        (relocs-box (vector '()))
        (text-ops-box (vector '()))
        (rodata-ops-box (vector '()))
        (data-ops-box (vector '()))
        (init-ops-box (vector '()))
        (globals-ops-box (vector '()))
        (lens-vec (vector 0 0 0 0 0 0))) ;; 0:text, 1:rodata, 2:data, 3:bss, 4:init_array, 5:ulisp_globals_sec
    (let ((get-sec-len (lambda (sec)
                         (case sec
                           ((text) (vector-ref lens-vec 0))
                           ((rodata) (vector-ref lens-vec 1))
                           ((data) (vector-ref lens-vec 2))
                           ((bss) (vector-ref lens-vec 3))
                           ((init_array) (vector-ref lens-vec 4))
                           ((ulisp_globals_sec) (vector-ref lens-vec 5))
                           (else (vector-ref lens-vec 0)))))
          (add-sec-op! (lambda (sec op blen)
                         (case sec
                           ((text)
                            (vector-set! text-ops-box 0 (cons op (vector-ref text-ops-box 0)))
                            (vector-set! lens-vec 0 (+ (vector-ref lens-vec 0) blen)))
                           ((rodata)
                            (vector-set! rodata-ops-box 0 (cons op (vector-ref rodata-ops-box 0)))
                            (vector-set! lens-vec 1 (+ (vector-ref lens-vec 1) blen)))
                           ((data)
                            (vector-set! data-ops-box 0 (cons op (vector-ref data-ops-box 0)))
                            (vector-set! lens-vec 2 (+ (vector-ref lens-vec 2) blen)))
                           ((bss)
                            (vector-set! lens-vec 3 (+ (vector-ref lens-vec 3) blen)))
                           ((init_array)
                            (vector-set! init-ops-box 0 (cons op (vector-ref init-ops-box 0)))
                            (vector-set! lens-vec 4 (+ (vector-ref lens-vec 4) blen)))
                           ((ulisp_globals_sec)
                            (vector-set! globals-ops-box 0 (cons op (vector-ref globals-ops-box 0)))
                            (vector-set! lens-vec 5 (+ (vector-ref lens-vec 5) blen)))
                           (else #f)))))
      (let pass1-loop ((lines-rest lines) (cur-sec 'text))
        (if (pair? lines-rest)
            (let* ((line (car lines-rest))
                   (clean (asm-trim-string (asm-strip-comment line))))
              (if (= (string-length clean) 0)
                  (pass1-loop (cdr lines-rest) cur-sec)
                  (let ((tokens (asm-tokenize-line clean)))
                    (if (null? tokens)
                        (pass1-loop (cdr lines-rest) cur-sec)
                        (let ((first (car tokens)))
                          (cond
                            ;; Label definition: "NAME:" (possibly followed by inline directive/instruction)
                            ((or (and (pair? (cdr tokens)) (string=? (cadr tokens) ":"))
                                 (char=? (string-ref first (- (string-length first) 1)) #\:))
                             (let* ((colon-in-first? (char=? (string-ref first (- (string-length first) 1)) #\:))
                                    (lbl-name (if colon-in-first?
                                                  (substring first 0 (- (string-length first) 1))
                                                  first))
                                    (off (get-sec-len cur-sec))
                                    (colon-pos (let cloop ((i 0))
                                                 (if (or (>= i (string-length clean)) (char=? (string-ref clean i) #\:))
                                                     i
                                                     (cloop (+ i 1)))))
                                    (rem-line (if (< (+ colon-pos 1) (string-length clean))
                                                  (asm-trim-string (substring clean (+ colon-pos 1) (string-length clean)))
                                                  "")))
                               (symbol-map-set! sym-map lbl-name (list cur-sec off))
                               (vector-set! sym-table-box 0 (cons (cons lbl-name (list cur-sec off)) (vector-ref sym-table-box 0)))
                               (if (> (string-length rem-line) 0)
                                   (pass1-loop (cons rem-line (cdr lines-rest)) cur-sec)
                                   (pass1-loop (cdr lines-rest) cur-sec))))

                            ;; Section switching directives
                            ((or (string=? first ".text") (string-starts-with? clean ".section .text"))
                             (pass1-loop (cdr lines-rest) 'text))
                            ((or (string=? first ".data") (string-starts-with? clean ".section .data"))
                             (pass1-loop (cdr lines-rest) 'data))
                            ((or (string=? first ".rodata") (string-starts-with? clean ".section .rodata"))
                             (pass1-loop (cdr lines-rest) 'rodata))
                            ((or (string=? first ".bss") (string-starts-with? clean ".section .bss"))
                             (pass1-loop (cdr lines-rest) 'bss))
                            ((string-starts-with? clean ".section ulisp_globals_sec")
                             (pass1-loop (cdr lines-rest) 'ulisp_globals_sec))
                            ((string-starts-with? clean ".section .init_array")
                             (pass1-loop (cdr lines-rest) 'init_array))
                            ((or (string=? first ".section") (string=? first ".pushsection"))
                             (let ((target (if (pair? (cdr tokens)) (asm-canonical-section (cadr tokens)) 'text)))
                               (if (eq? target 'note)
                                   (pass1-loop (cdr lines-rest) cur-sec)
                                   (pass1-loop (cdr lines-rest) target))))

                            ;; Symbol binding & type directives
                            ((or (string=? first ".globl") (string=? first ".global"))
                             (let ((groups (asm-split-by-comma (cdr tokens))))
                               (let gloop ((gs groups))
                                 (if (pair? gs)
                                     (let ((sym (asm-tokens->string (car gs))))
                                       (if (and (> (string-length sym) 0)
                                                (not (symbol-map-contains? globl-map sym)))
                                           (begin
                                             (symbol-map-set! globl-map sym #t)
                                             (vector-set! globl-box 0 (cons sym (vector-ref globl-box 0)))))
                                       (gloop (cdr gs))))))
                             (pass1-loop (cdr lines-rest) cur-sec))
                            ((string=? first ".weak")
                             (let ((groups (asm-split-by-comma (cdr tokens))))
                               (let wloop ((gs groups))
                                 (if (pair? gs)
                                     (let ((sym (asm-tokens->string (car gs))))
                                       (if (and (> (string-length sym) 0)
                                                (not (symbol-map-contains? weak-map sym)))
                                           (begin
                                             (symbol-map-set! weak-map sym #t)
                                             (vector-set! weak-box 0 (cons sym (vector-ref weak-box 0)))))
                                       (wloop (cdr gs))))))
                             (pass1-loop (cdr lines-rest) cur-sec))
                            ((or (string=? first ".set") (string=? first ".equiv"))
                             (let ((groups (asm-split-by-comma (cdr tokens))))
                               (if (and (pair? groups) (pair? (cdr groups)))
                                   (let ((alias (asm-tokens->string (car groups)))
                                         (tgt (asm-tokens->string (cadr groups))))
                                     (if (and (> (string-length alias) 0) (> (string-length tgt) 0))
                                         (vector-set! aliases-box 0 (cons (cons alias tgt) (vector-ref aliases-box 0)))))))
                             (pass1-loop (cdr lines-rest) cur-sec))
                            ((or (string=? first ".hidden")
                                 (string=? first ".protected")
                                 (string=? first ".internal")
                                 (string=? first ".size"))
                             (pass1-loop (cdr lines-rest) cur-sec))
                            ((string=? first ".type")
                             (if (and (pair? (cdr tokens)) (pair? (cddr tokens)))
                                 (let* ((sym (cadr tokens))
                                        (rest-toks (cddr tokens))
                                        (type-tok (if (and (string=? (car rest-toks) ",") (pair? (cdr rest-toks)))
                                                      (cadr rest-toks)
                                                      (car rest-toks)))
                                        (stt (cond
                                               ((or (string=? type-tok "@function") (string=? type-tok "%function")) 2)
                                               ((or (string=? type-tok "@object") (string=? type-tok "%object")) 1)
                                               (else 0))))
                                   (vector-set! types-box 0 (cons (cons sym stt) (vector-ref types-box 0)))))
                             (pass1-loop (cdr lines-rest) cur-sec))

                            ((or (string-starts-with? clean ".section .note")
                                 (string=? first ".intel_syntax")
                                 (string=? first ".file")
                                 (string=? first ".loc"))
                             (pass1-loop (cdr lines-rest) cur-sec))

                            ;; Alignment
                            ((or (string=? first ".align") (string=? first ".p2align"))
                             (let* ((val (if (pair? (cdr tokens)) (safe-string->number (cadr tokens)) 8))
                                    (align (if (string=? first ".p2align") (expt 2 val) val))
                                    (cur-len (get-sec-len cur-sec))
                                    (rem (modulo cur-len align))
                                    (pad (if (= rem 0) 0 (- align rem))))
                               (if (> pad 0)
                                   (if (eq? cur-sec 'text)
                                       (add-sec-op! 'text (cons 'pad-nop pad) pad)
                                       (add-sec-op! cur-sec (cons 'pad-zero pad) pad)))
                               (pass1-loop (cdr lines-rest) cur-sec)))

                            ;; Data directives: .byte
                            ((string=? first ".byte")
                             (let ((groups (asm-split-by-comma (cdr tokens))))
                               (for-each (lambda (g)
                                           (let* ((expr (asm-parse-data-expr (asm-tokens->string g)))
                                                  (val (if (eq? (car expr) 'num) (cdr expr) 0))
                                                  (b (modulo (if (< val 0) (+ val 256) val) 256)))
                                             (add-sec-op! cur-sec (list b) 1)))
                                         groups))
                             (pass1-loop (cdr lines-rest) cur-sec))

                            ;; Data directives: .short / .2byte
                            ((or (string=? first ".short") (string=? first ".2byte"))
                             (let ((groups (asm-split-by-comma (cdr tokens))))
                               (for-each (lambda (g)
                                           (let* ((expr (asm-parse-data-expr (asm-tokens->string g)))
                                                  (val (if (eq? (car expr) 'num) (cdr expr) 0)))
                                             (add-sec-op! cur-sec (split-u16-le val) 2)))
                                         groups))
                             (pass1-loop (cdr lines-rest) cur-sec))

                            ;; Data directives: .long / .4byte
                            ((or (string=? first ".long") (string=? first ".4byte"))
                             (let ((groups (asm-split-by-comma (cdr tokens))))
                               (for-each (lambda (g)
                                           (let* ((expr (asm-parse-data-expr (asm-tokens->string g))))
                                             (cond
                                               ((eq? (car expr) 'num)
                                                (add-sec-op! cur-sec (split-u32-le (cdr expr)) 4))
                                               ((eq? (car expr) 'sym-diff)
                                                (let* ((pair (cdr expr))
                                                       (cur-len (get-sec-len cur-sec)))
                                                  (vector-set! relocs-box 0 (cons (list 'sym_diff32 cur-sec cur-len (car pair) (cdr pair)) (vector-ref relocs-box 0)))
                                                  (add-sec-op! cur-sec '(0 0 0 0) 4)))
                                               (else
                                                (let* ((sym-info (cdr expr))
                                                       (sym-name (car sym-info))
                                                       (addend (cdr sym-info))
                                                       (cur-len (get-sec-len cur-sec)))
                                                  (vector-set! relocs-box 0 (cons (list 'abs32 cur-sec cur-len sym-name addend) (vector-ref relocs-box 0)))
                                                  (add-sec-op! cur-sec '(0 0 0 0) 4))))))
                                         groups))
                             (pass1-loop (cdr lines-rest) cur-sec))

                            ;; Data directives: .quad / .8byte
                            ((or (string=? first ".quad") (string=? first ".8byte"))
                             (let ((groups (asm-split-by-comma (cdr tokens))))
                               (for-each (lambda (g)
                                           (let* ((expr (asm-parse-data-expr (asm-tokens->string g))))
                                             (if (eq? (car expr) 'num)
                                                 (add-sec-op! cur-sec (split-u64-le (cdr expr)) 8)
                                                 (let* ((sym-info (cdr expr))
                                                        (sym-name (car sym-info))
                                                        (addend (cdr sym-info))
                                                        (cur-len (get-sec-len cur-sec)))
                                                   (vector-set! relocs-box 0 (cons (list 'abs64 cur-sec cur-len sym-name addend) (vector-ref relocs-box 0)))
                                                   (add-sec-op! cur-sec '(0 0 0 0 0 0 0 0) 8)))))
                                         groups))
                             (pass1-loop (cdr lines-rest) cur-sec))

                            ;; Data directives: .string / .asciz / .ascii
                            ((or (string=? first ".string") (string=? first ".asciz") (string=? first ".ascii"))
                             (let* ((null-term? (not (string=? first ".ascii")))
                                    (groups (asm-split-by-comma (cdr tokens))))
                               (for-each (lambda (g)
                                           (let* ((expr (asm-parse-data-expr (asm-tokens->string g)))
                                                  (raw-str (cond
                                                             ((eq? (car expr) 'str) (cdr expr))
                                                             ((pair? g) (car g))
                                                             (else "")))
                                                  (bs (asm-string->bytes raw-str null-term?)))
                                             (add-sec-op! cur-sec bs (length bs))))
                                         groups))
                             (pass1-loop (cdr lines-rest) cur-sec))

                            ;; Data directives: .space / .zero
                            ((or (string=? first ".space") (string=? first ".zero"))
                             (let* ((groups (asm-split-by-comma (cdr tokens)))
                                    (cnt-expr (if (pair? groups) (asm-parse-data-expr (asm-tokens->string (car groups))) '(num . 0)))
                                    (cnt (if (eq? (car cnt-expr) 'num) (cdr cnt-expr) 0))
                                    (val-expr (if (and (pair? groups) (pair? (cdr groups))) (asm-parse-data-expr (asm-tokens->string (cadr groups))) '(num . 0)))
                                    (val (if (eq? (car val-expr) 'num) (cdr val-expr) 0)))
                               (if (> cnt 0)
                                   (if (= val 0)
                                       (add-sec-op! cur-sec (cons 'pad-zero cnt) cnt)
                                       (add-sec-op! cur-sec (asm-make-byte-list cnt val) cnt)))
                               (pass1-loop (cdr lines-rest) cur-sec)))

                            ;; Data directives: .fill
                            ((string=? first ".fill")
                             (let* ((groups (asm-split-by-comma (cdr tokens)))
                                    (fill-params (asm-parse-fill-args groups))
                                    (repeat (car fill-params))
                                    (size (cadr fill-params))
                                    (val (caddr fill-params))
                                    (total-bytes (* repeat size)))
                               (if (> total-bytes 0)
                                   (if (= val 0)
                                       (add-sec-op! cur-sec (cons 'pad-zero total-bytes) total-bytes)
                                       (add-sec-op! cur-sec (asm-generate-fill-bytes repeat size val) total-bytes)))
                               (pass1-loop (cdr lines-rest) cur-sec)))

                            ;; Instruction
                            (else
                             (let* ((has-lock? (and (or (string=? first "lock")
                                                        (string=? (safe-string-downcase first) "lock"))
                                                    (pair? (cdr tokens))))
                                    (mnem (if has-lock? (cadr tokens) first))
                                    (raw-opnd-tokens (if has-lock? (cddr tokens) (cdr tokens)))
                                    (opnd-strs (let loop ((ts raw-opnd-tokens) (cur '()) (acc '()))
                                                 (cond
                                                   ((null? ts)
                                                    (if (null? cur)
                                                        (reverse acc)
                                                        (reverse (cons (if (null? (cdr cur))
                                                                           (car cur)
                                                                           (let l ((cs (reverse cur)) (s ""))
                                                                             (if (null? cs) s (l (cdr cs) (string-append s (car cs) " ")))))
                                                                       acc))))
                                                   ((string=? (car ts) ",")
                                                    (loop (cdr ts) '()
                                                          (cons (if (null? cur)
                                                                    ""
                                                                    (if (null? (cdr cur))
                                                                        (car cur)
                                                                        (let l ((cs (reverse cur)) (s ""))
                                                                          (if (null? cs) s (l (cdr cs) (string-append s (car cs) " "))))))
                                                                acc)))
                                                   (else
                                                    (loop (cdr ts) (cons (car ts) cur) acc)))))
                                    (opnds (map parse-operand-str opnd-strs))
                                    (text-len (vector-ref lens-vec 0))
                                    (res (assemble-inst-with-syms mnem opnds (if has-lock? (+ text-len 1) text-len) sym-map)))
                               (if (pair? res)
                                   (let* ((bytes (if has-lock? (cons 240 (car res)) (car res)))
                                          (reloc (cadr res))
                                          (blen (length bytes)))
                                     (if reloc
                                         (vector-set! relocs-box 0 (cons (cons (car reloc) (cons 'text (cdr reloc))) (vector-ref relocs-box 0))))
                                     (add-sec-op! 'text bytes blen)))
                               (pass1-loop (cdr lines-rest) cur-sec)))))))))
            (begin
              ;; Resolve .set/.equiv aliases before Pass 2 materialization
              (asm-resolve-aliases! (reverse (vector-ref aliases-box 0))
                                    sym-map
                                    (lambda (a v)
                                      (vector-set! sym-table-box 0 (cons (cons a v) (vector-ref sym-table-box 0)))))
              ;; Pass 2: Materialize section bytevectors and compute ELF64 RELA records
              (let* ((text-len (vector-ref lens-vec 0))
                   (rodata-len (vector-ref lens-vec 1))
                   (data-len (vector-ref lens-vec 2))
                   (bss-len (vector-ref lens-vec 3))
                   (init-len (vector-ref lens-vec 4))
                   (globals-len (vector-ref lens-vec 5))
                   (text-bv (make-bytevector text-len 0))
                   (rodata-bv (make-bytevector rodata-len 0))
                   (data-bv (make-bytevector data-len 0))
                   (init-bv (make-bytevector init-len 0))
                   (globals-bv (make-bytevector globals-len 0))
                   (sym-table (vector-ref sym-table-box 0))
                   (globl-syms (reverse (vector-ref globl-box 0)))
                   (weak-syms (reverse (vector-ref weak-box 0)))
                   (sym-types (vector-ref types-box 0)))
              (asm-copy-section-ops! text-bv (vector-ref text-ops-box 0))
              (asm-copy-section-ops! rodata-bv (vector-ref rodata-ops-box 0))
              (asm-copy-section-ops! data-bv (vector-ref data-ops-box 0))
              (asm-copy-section-ops! init-bv (vector-ref init-ops-box 0))
              (asm-copy-section-ops! globals-bv (vector-ref globals-ops-box 0))
              (let reloc-loop ((rels (reverse (vector-ref relocs-box 0))) (rela-acc '()))
                (if (pair? rels)
                    (let* ((rel (car rels))
                           (type (car rel))
                           (sec (cadr rel))
                           (patch-off (caddr rel)))
                      (if (eq? type 'sym_diff32)
                          (let* ((sym1 (cadddr rel))
                                 (sym2 (car (cddddr rel)))
                                 (p1 (symbol-map-get sym-map sym1))
                                 (p2 (symbol-map-get sym-map sym2)))
                            (if (and p1 p2 (eq? (cadr p1) (cadr p2)))
                                (let* ((diff (- (caddr p1) (caddr p2)))
                                       (target-bv (case sec
                                                    ((text) text-bv)
                                                    ((rodata) rodata-bv)
                                                    ((data) data-bv)
                                                    ((init_array) init-bv)
                                                    (else globals-bv))))
                                  (elf64-set-u32-le! target-bv patch-off diff)
                                  (reloc-loop (cdr rels) rela-acc))
                                (error "Invalid cross-section or undefined symbol difference in ET_REL:" sym1 sym2)))
                          (let* ((sym (cadddr rel))
                                 (addend (car (cddddr rel)))
                                 (adj (if (pair? (cdr (cddddr rel))) (cadr (cddddr rel)) 0))
                                 (sym-pair (symbol-map-get sym-map sym))
                                 (sym-entry (if sym-pair (cons sym (cdr sym-pair)) #f))
                                 (is-exported? (or (symbol-map-contains? globl-map sym)
                                                   (symbol-map-contains? weak-map sym))))
                            (cond
                              ;; Intra-.text rel32 branch/call to a non-exported local label: resolve directly in text-bv!
                              ((and (eq? type 'rel32)
                                    (eq? sec 'text)
                                    sym-entry
                                    (eq? (cadr sym-entry) 'text)
                                    (not is-exported?))
                               (let* ((sym-off (caddr sym-entry))
                                      (diff (- (+ sym-off addend) (+ patch-off 4))))
                                 (elf64-set-u32-le! text-bv patch-off diff)
                                 (reloc-loop (cdr rels) rela-acc)))

                              ;; Otherwise emit an SHT_RELA relocation entry
                              (else
                               (let* ((r-type (case type
                                                ((rel32) 4)       ;; R_X86_64_PLT32 (4)
                                                ((rip_disp32) 2)  ;; R_X86_64_PC32 (2)
                                                ((abs64) 1)       ;; R_X86_64_64 (1)
                                                ((abs32) 10)      ;; R_X86_64_32 (10)
                                                ((abs32s) 11)     ;; R_X86_64_32S (11)
                                                (else 2)))
                                      (base-addend (case type
                                                     ((rel32) (- addend 4))
                                                     ((rip_disp32) (- (- addend 4) adj))
                                                     ((abs64 abs32 abs32s) addend)
                                                     (else addend))))
                                 (if (and sym-entry (not is-exported?))
                                     ;; Local symbol defined in target-sec: relocate against section symbol (1..6)
                                     (let* ((target-sec (cadr sym-entry))
                                            (sym-off (caddr sym-entry))
                                            (sec-shndx (asm-sec->shndx target-sec))
                                            (final-addend (+ sym-off base-addend)))
                                       (reloc-loop (cdr rels)
                                                   (cons (list sec patch-off sec-shndx r-type final-addend) rela-acc)))
                                     ;; Exported or undefined symbol: relocate against named symbol
                                     (reloc-loop (cdr rels)
                                                 (cons (list sec patch-off sym r-type base-addend) rela-acc)))))))))
                    (list text-bv rodata-bv data-bv bss-len init-bv globals-bv
                          sym-table globl-syms weak-syms sym-types (reverse rela-acc)))))))))))

;;; =======================================================================
;;; ULisp Compiler Pass 144: Direct ELF64 Static Executable Generator
;;; Conforms to DSN-33 Architecture Specification & Issue #616
;;;
;;; Combines Pass 140 (x86-64 instruction selection & emission),
;;; Pass 144a (native 2-pass x86-64 machine code assembler),
;;; and Layer 2 (ELF64 static binary builder) to emit standalone ET_EXEC
;;; binaries directly from memory, eliminating GNU binutils (as, ld).
;;; =======================================================================

(define (with-emit-line-sink sink thunk)
  (let ((prev (get-emit-line-sink)))
    (set-emit-line-sink! sink)
    (let ((res (thunk)))
      (set-emit-line-sink! prev)
      res)))

(define (write-elf64-bytevector bv)
  (cond-expand
    (ulisp
     (write-bytevector bv)
     (flush-output-port))
    (else
     (let ((p (current-output-port)))
       (if (binary-port? p)
           (begin
             (write-bytevector bv p)
             (flush-output-port p))
           (let loop ((i 0) (len (bytevector-length bv)))
             (if (< i len)
                 (begin
                   (write-char (integer->char (bytevector-u8-ref bv i)))
                   (loop (+ i 1) len))
                 (flush-output-port))))))))

;;; -----------------------------------------------------------------------
;;; Public Utility: Assemble assembly lines directly into ELF bytevector
;;; -----------------------------------------------------------------------
(define (assemble-and-build-elf lines)
  (let* ((assembled (assemble-x86-lines lines))
         (text-bv (car assembled))
         (rodata-bv (cadr assembled))
         (data-bv (caddr assembled))
         (bss-size (cadddr assembled))
         (entry-off (car (cddddr assembled)))
         (file-table (if (> (length assembled) 5) (list-ref assembled 5) '()))
         (line-table (if (> (length assembled) 6) (list-ref assembled 6) '()))
         (sym-table (if (> (length assembled) 7) (list-ref assembled 7) '()))
         (debug-payload (if (or (pair? file-table) (pair? line-table) (pair? sym-table))
                            (list file-table line-table sym-table)
                            #f)))
    (build-elf64-executable-ex text-bv rodata-bv data-bv bss-size entry-off debug-payload)))

(define (assemble-and-build-elf-with-rodata lines frozen-payload)
  (let* ((assembled (assemble-x86-lines lines))
         (text-bv (car assembled))
         (orig-rodata-bv (cadr assembled))
         (data-bv (caddr assembled))
         (bss-size (cadddr assembled))
         (entry-off (car (cddddr assembled)))
         (file-table (if (> (length assembled) 5) (list-ref assembled 5) '()))
         (line-table (if (> (length assembled) 6) (list-ref assembled 6) '()))
         (sym-table (if (> (length assembled) 7) (list-ref assembled 7) '()))
         (frozen-bv (if (bytevector? frozen-payload)
                        frozen-payload
                        (freeze-serialized->bytevector frozen-payload)))
         (append-res (elf64-append-rodata-payload-with-offset orig-rodata-bv frozen-bv))
         (rodata-bv (car append-res))
         (frozen-off (cdr append-res))
         (frozen-sym (list "__ulisp_frozen_graph_root" 'rodata frozen-off (bytevector-length frozen-bv)))
         (updated-sym-table (cons frozen-sym (if (list? sym-table) sym-table '())))
         (debug-payload (list file-table line-table updated-sym-table)))
    (build-elf64-executable-ex text-bv rodata-bv data-bv bss-size entry-off debug-payload)))

;;; -----------------------------------------------------------------------
;;; Pass 144 Entrypoint: Direct-to-ELF Native Code Generator
;;; -----------------------------------------------------------------------
(define (emit-x86-64-elf prog gc-mode)
  (let ((lines-box (vector '())))
    (with-emit-line-sink
      (lambda (line)
        (vector-set! lines-box 0 (cons line (vector-ref lines-box 0))))
      (lambda ()
        (emit-x86-64 prog gc-mode)))
    (let* ((asm-lines (reverse (vector-ref lines-box 0)))
           (elf-bv (assemble-and-build-elf asm-lines)))
      (write-elf64-bytevector elf-bv)
      elf-bv)))

;;; -----------------------------------------------------------------------
;;; Issue #783: Builtin Assembler & ELF64 Relocatable Object (.o, ET_REL)
;;; -----------------------------------------------------------------------
(define (assemble-and-build-elf-obj lines)
  (let ((assembled (assemble-x86-relocatable lines)))
    (build-elf64-relocatable assembled)))

(define (emit-x86-64-elf-obj prog gc-mode)
  (let ((lines-box (vector '())))
    (with-emit-line-sink
      (lambda (line)
        (vector-set! lines-box 0 (cons line (vector-ref lines-box 0))))
      (lambda ()
        (emit-x86-64 prog gc-mode)))
    (let* ((asm-lines (reverse (vector-ref lines-box 0)))
           (elf-bv (assemble-and-build-elf-obj asm-lines)))
      (write-elf64-bytevector elf-bv)
      elf-bv)))

(define (build-x86-64-elf-obj prog gc-mode)
  (let ((lines-box (vector '())))
    (with-emit-line-sink
      (lambda (line)
        (vector-set! lines-box 0 (cons line (vector-ref lines-box 0))))
      (lambda ()
        (emit-x86-64 prog gc-mode)))
    (let* ((asm-lines (reverse (vector-ref lines-box 0))))
      (assemble-and-build-elf-obj asm-lines))))

(define (read-asm-lines-from-stdin)
  (cond-expand
    (ulisp
     (let ((p (list '%file-input-port
                    0
                    (cons (make-string 4096) '())
                    (cons 0 '())
                    (cons 0 '())
                    (cons 1 '())
                    (cons 1 '())
                    "stdin"
                    #f)))
       (let loop ((cur '()) (lines '()))
         (let ((c (port-read-char p)))
           (cond
             ((eof-object? c)
              (if (null? cur)
                  (reverse lines)
                  (reverse (cons (list->string (reverse cur)) lines))))
             ((char=? c #\newline)
              (loop '() (cons (list->string (reverse cur)) lines)))
             ((char=? c (integer->char 13))
              (loop cur lines))
             (else
              (loop (cons c cur) lines)))))))
    (else
     (let loop ((cur '()) (lines '()))
       (let ((c (read-char)))
         (cond
           ((eof-object? c)
            (if (null? cur)
                (reverse lines)
                (reverse (cons (list->string (reverse cur)) lines))))
           ((char=? c #\newline)
            (loop '() (cons (list->string (reverse cur)) lines)))
           ((char=? c (integer->char 13))
            (loop cur lines))
           (else
            (loop (cons c cur) lines))))))))

(define (assemble-stream-to-elf-obj)
  (let* ((lines (read-asm-lines-from-stdin))
         (elf-bv (assemble-and-build-elf-obj lines)))
    (write-elf64-bytevector elf-bv)
    elf-bv))

;;; -----------------------------------------------------------------------
;;; Public Utility: Link multiple ELF64 ET_REL objects into static executable (Issue #784)
;;; -----------------------------------------------------------------------
(define (link-elf64-objects-to-file obj-paths out-path entry-sym)
  (let ((bin-bv (link-elf64-relocatable-objects obj-paths entry-sym)))
    (if (and (string? out-path) (> (string-length out-path) 0) (not (string=? out-path "-")))
        (begin
          (elf64-write-binary-file! out-path bin-bv)
          (if (procedure? sys-chmod)
              (sys-chmod out-path 493)))
        (write-elf64-bytevector bin-bv))
    bin-bv))


;;; =======================================================================
;;; ULisp Compiler Pass 7: Native AArch64 (ARM64) Backend Code Generator
;;; Conforms to DSN-33 Architecture Specification & Issue #503
;;; Consumes Pass 6 %lir-program and emits pure GNU AArch64 assembly.
;;; =======================================================================

(define (arm-reg->str reg)
  (case reg
    ((%rax) "x0")
    ((%rdi) "x0")
    ((%rsi) "x1")
    ((%rdx) "x2")
    ((%rcx) "x3")
    ((%r8)  "x4")
    ((%r9)  "x5")
    ((%rbx) "x19")
    ((%r10) "x10")
    ((%r11) "x11")
    ((%r12) "x19")
    ((%r13) "x20")
    ((%r14) "x21")
    ((%r15) "x22")
    ((%rbp) "x29")
    ((%rsp) "sp")
    ((%al)  "w0")
    ((%xmm0) "d0")
    ((%xmm1) "d1")
    ((%xmm2) "d2")
    ((%xmm3) "d3")
    ((%xmm4) "d4")
    ((%xmm5) "d5")
    ((%xmm6) "d6")
    ((%xmm7) "d7")
    ((%xmm8) "d8")
    ((%xmm9) "d9")
    ((%xmm10) "d10")
    ((%xmm11) "d11")
    ((%xmm12) "d12")
    ((%xmm13) "d13")
    ((%xmm14) "d14")
    ((%xmm15) "d15")
    (else
     (cond
       ((and (pair? reg) (eq? (car reg) '%reg))
        (if (and (pair? (cdr reg)) (pair? (cddr reg)))
            (arm-reg->str (caddr reg))
            (arm-reg->str (cadr reg))))
       ((and (pair? reg) (eq? (car reg) '%freg))
        (arm-reg->str (cadr reg)))
       ((symbol? reg) (symbol->string reg))
       (else reg)))))

(define (arm-w-reg->str reg)
  (case reg
    ((%rax %rdi x0) "w0")
    ((%rsi x1) "w1")
    ((%rdx x2) "w2")
    ((%rcx x3) "w3")
    ((%r8 x4) "w4")
    ((%r9 x5) "w5")
    ((%r10 x10) "w10")
    ((%rbx %r12 x19) "w19")
    ((%r13 x20) "w20")
    ((%r14 x21) "w21")
    ((%r15 x22) "w22")
    ((%rbp x29) "w29")
    ((%al)  "w0")
    (else
     (let ((s (if (symbol? reg) (symbol->string reg) reg)))
       (if (and (> (string-length s) 1) (char=? (string-ref s 0) #\x))
           (string-append "w" (substring s 1 (string-length s)))
           s)))))

(define (arm-emit-sib-address base offset)
  (let* ((idx (arm-reg->str (cadr offset)))
         (scale (caddr offset))
         (shift (case scale ((1) 0) ((2) 1) ((4) 2) ((8) 3) (else 0)))
         (disp (cadddr offset))
         (b-str (arm-reg->str base)))
    (if (= shift 0)
        (emit (string-append "    add x9, " b-str ", " idx))
        (emit (string-append "    add x9, " b-str ", " idx ", lsl #" (number->string shift))))
    (cond
      ((> disp 0)
       (emit (string-append "    add x9, x9, #" (number->string disp))))
      ((< disp 0)
       (emit (string-append "    sub x9, x9, #" (number->string (- 0 disp))))))))

(define (arm-mem-op->str base offset)
  (let ((base-str (arm-reg->str base)))
    (cond
      ((and (pair? offset) (eq? (car offset) '%sib))
       (let* ((idx (arm-reg->str (cadr offset)))
              (scale (caddr offset))
              (shift (case scale ((1) 0) ((2) 1) ((4) 2) ((8) 3) (else 0)))
              (disp (cadddr offset)))
         (if (= shift 0)
             (string-append "[" base-str ", " idx "]")
             (string-append "[" base-str ", " idx ", lsl #" (number->string shift) "]"))))
      ((symbol? offset)
       (string-append "[" base-str ", " (arm-reg->str offset) "]"))
      (else
       (string-append "[" base-str ", #" (number->string offset) "]")))))

(define (arm-valid-imm-offset? offset)
  (and (integer? offset)
       (or (and (>= offset -256) (<= offset 255))
           (and (>= offset 0) (<= offset 32760) (= (modulo offset 8) 0)))))

(define (arm-valid-byte-imm-offset? offset)
  (and (integer? offset)
       (or (and (>= offset -256) (<= offset 255))
           (and (>= offset 0) (<= offset 4095)))))

(define (arm-emit-store src base offset)
  (let ((src-str (arm-reg->str src))
        (base-str (arm-reg->str base)))
    (cond
      ((and (pair? offset) (eq? (car offset) '%sib))
       (arm-emit-sib-address base offset)
       (emit (string-append "    str " src-str ", [x9]")))
      ((symbol? offset)
       (emit (string-append "    str " src-str ", [" base-str ", " (arm-reg->str offset) "]")))
      ((arm-valid-imm-offset? offset)
       (emit (string-append "    str " src-str ", [" base-str ", #" (number->string offset) "]")))
      (else
       (cond
         ((and (< offset 0) (>= offset -4095))
          (emit (string-append "    sub x16, " base-str ", #" (number->string (- 0 offset)))))
         ((and (> offset 0) (<= offset 4095))
          (emit (string-append "    add x16, " base-str ", #" (number->string offset))))
         (else
          (emit (string-append "    ldr x16, =" (number->string offset)))
          (emit (string-append "    add x16, " base-str ", x16"))))
       (emit (string-append "    str " src-str ", [x16]"))))))

(define (arm-emit-load dst base offset)
  (let ((dst-str (arm-reg->str dst))
        (base-str (arm-reg->str base)))
    (cond
      ((and (pair? offset) (eq? (car offset) '%sib))
       (arm-emit-sib-address base offset)
       (emit (string-append "    ldr " dst-str ", [x9]")))
      ((symbol? offset)
       (emit (string-append "    ldr " dst-str ", [" base-str ", " (arm-reg->str offset) "]")))
      ((arm-valid-imm-offset? offset)
       (emit (string-append "    ldr " dst-str ", [" base-str ", #" (number->string offset) "]")))
      (else
       (cond
         ((and (< offset 0) (>= offset -4095))
          (emit (string-append "    sub x16, " base-str ", #" (number->string (- 0 offset)))))
         ((and (> offset 0) (<= offset 4095))
          (emit (string-append "    add x16, " base-str ", #" (number->string offset))))
         (else
          (emit (string-append "    ldr x16, =" (number->string offset)))
          (emit (string-append "    add x16, " base-str ", x16"))))
       (emit (string-append "    ldr " dst-str ", [x16]"))))))

(define (arm-emit-store-byte src base offset)
  (let ((base-str (arm-reg->str base)))
    (cond
      ((and (pair? offset) (eq? (car offset) '%sib))
       (arm-emit-sib-address base offset)
       (cond
         ((and (number? src) (= src 0))
          (emit "    strb wzr, [x9]"))
         ((number? src)
          (emit (string-append "    mov w10, #" (number->string src)))
          (emit "    strb w10, [x9]"))
         (else
          (emit (string-append "    strb " (arm-w-reg->str src) ", [x9]")))))
      ((symbol? offset)
       (cond
         ((and (number? src) (= src 0))
          (emit (string-append "    strb wzr, [" base-str ", " (arm-reg->str offset) "]")))
         ((number? src)
          (emit (string-append "    mov w10, #" (number->string src)))
          (emit (string-append "    strb w10, [" base-str ", " (arm-reg->str offset) "]")))
         (else
          (emit (string-append "    strb " (arm-w-reg->str src) ", [" base-str ", " (arm-reg->str offset) "]")))))
      ((arm-valid-byte-imm-offset? offset)
       (cond
         ((and (number? src) (= src 0))
          (emit (string-append "    strb wzr, [" base-str ", #" (number->string offset) "]")))
         ((number? src)
          (emit (string-append "    mov w9, #" (number->string src)))
          (emit (string-append "    strb w9, [" base-str ", #" (number->string offset) "]")))
         (else
          (emit (string-append "    strb " (arm-w-reg->str src) ", [" base-str ", #" (number->string offset) "]")))))
      (else
       (cond
         ((and (< offset 0) (>= offset -4095))
          (emit (string-append "    sub x16, " base-str ", #" (number->string (- 0 offset)))))
         ((and (> offset 0) (<= offset 4095))
          (emit (string-append "    add x16, " base-str ", #" (number->string offset))))
         (else
          (emit (string-append "    ldr x16, =" (number->string offset)))
          (emit (string-append "    add x16, " base-str ", x16"))))
       (cond
         ((and (number? src) (= src 0))
          (emit "    strb wzr, [x16]"))
         ((number? src)
          (emit (string-append "    mov w9, #" (number->string src)))
          (emit "    strb w9, [x16]"))
         (else
          (emit (string-append "    strb " (arm-w-reg->str src) ", [x16]"))))))))

(define (arm-emit-load-byte-zx dst base offset)
  (let ((dst-str (arm-w-reg->str dst))
        (base-str (arm-reg->str base)))
    (cond
      ((and (pair? offset) (eq? (car offset) '%sib))
       (arm-emit-sib-address base offset)
       (emit (string-append "    ldrb " dst-str ", [x9]")))
      ((symbol? offset)
       (emit (string-append "    ldrb " dst-str ", [" base-str ", " (arm-reg->str offset) "]")))
      ((arm-valid-byte-imm-offset? offset)
       (emit (string-append "    ldrb " dst-str ", [" base-str ", #" (number->string offset) "]")))
      (else
       (cond
         ((and (< offset 0) (>= offset -4095))
          (emit (string-append "    sub x16, " base-str ", #" (number->string (- 0 offset)))))
         ((and (> offset 0) (<= offset 4095))
          (emit (string-append "    add x16, " base-str ", #" (number->string offset))))
         (else
          (emit (string-append "    ldr x16, =" (number->string offset)))
          (emit (string-append "    add x16, " base-str ", x16"))))
       (emit (string-append "    ldrb " dst-str ", [x16]"))))))

(define (arm-emit-load-operand dst opnd)
  (cond
    ((symbol? opnd)
     (emit (string-append "    mov " (arm-reg->str dst) ", " (arm-reg->str opnd))))
    ((integer? opnd)
     (if (and (>= opnd -65535) (<= opnd 65535))
         (emit (string-append "    mov " (arm-reg->str dst) ", #" (number->string opnd)))
         (emit (string-append "    ldr " (arm-reg->str dst) ", =" (number->string opnd)))))
    ((pair? opnd)
     (case (car opnd)
       ((%stack)
        (arm-emit-load dst 'sp (cadr opnd)))
       ((%mem)
        (arm-emit-load dst (cadr opnd) (caddr opnd)))
       (else
        (error "Unknown operand in AArch64 load-operand:" opnd))))
    (else
     (error "Invalid operand in AArch64 load-operand:" opnd))))

(define (arm-emit-sub-sp shift)
  (if (and (>= shift 0) (<= shift 4095))
      (emit (string-append "    sub sp, sp, #" (number->string shift)))
      (begin
        (emit (string-append "    ldr x16, =" (number->string shift)))
        (emit "    sub sp, sp, x16"))))

(define (arm-emit-add-sp shift)
  (if (and (>= shift 0) (<= shift 4095))
      (emit (string-append "    add sp, sp, #" (number->string shift)))
      (begin
        (emit (string-append "    ldr x16, =" (number->string shift)))
        (emit "    add sp, sp, x16"))))

(define (arm-operand->str opnd)
  (cond
    ((symbol? opnd)
     (arm-reg->str opnd))
    ((integer? opnd)
     (string-append "#" (number->string opnd)))
    ((pair? opnd)
     (let ((tag (car opnd)))
       (case tag
         ((%stack)
          (string-append "[sp, #" (number->string (cadr opnd)) "]"))
         ((%mem)
          (arm-mem-op->str (cadr opnd) (caddr opnd)))
         (else
          (error "Unknown operand in AArch64 backend:" opnd)))))
    (else
     (error "Invalid operand type in AArch64 backend:" opnd))))

(define (arm-condition-code set-inst)
  (cond
    ((string=? set-inst "sete")  "eq")
    ((string=? set-inst "setl")  "lt")
    ((string=? set-inst "setle") "le")
    ((string=? set-inst "setg")  "gt")
    ((string=? set-inst "setge") "ge")
    ((string=? set-inst "setne") "ne")
    (else (error "Unknown set-cc in AArch64 backend:" set-inst))))

(define (emit-arm-boolean-from-set set-inst)
  (let ((cond (arm-condition-code set-inst)))
    (emit (string-append "    cset x0, " cond))
    (emit "    lsl x0, x0, 6")
    (emit "    add x0, x0, 0x2F")))

;; AAPCS64 16-byte stack frame alignment helper
(define (arm-align-frame-shift shift)
  (let* ((raw (+ shift 16))
         (rem (modulo raw 16)))
    (if (= rem 0) raw (+ raw (- 16 rem)))))

;;; Block Arguments tracking and parallel copy for SSA LIR (AArch64)
(define *arm-block-params* (cons '() '()))

(define (reset-arm-block-params!)
  (set-car! *arm-block-params* '()))

(define (record-arm-block-params! lbl params)
  (let ((entry (assq lbl (car *arm-block-params*))))
    (if entry
        (set-cdr! entry params)
        (set-car! *arm-block-params* (cons (cons lbl params) (car *arm-block-params*))))))

(define (get-arm-block-params lbl)
  (let ((entry (assq lbl (car *arm-block-params*))))
    (if entry (cdr entry) '())))

(define (scan-arm-blocks! insts)
  (reset-arm-block-params!)
  (for-each
   (lambda (inst)
     (if (and (pair? inst) (eq? (car inst) '%block))
         (record-arm-block-params! (cadr inst) (caddr inst))))
   insts))

(define (arm-param-location idx param)
  (cond
    ((or (eq? param '%rax) (eq? param 'x0)) 'x0)
    ((and (pair? param) (eq? (car param) '%stack)) param)
    (else
     (list '%stack (* -8 (+ idx 2))))))

(define (emit-arm-parallel-copy target-lbl args)
  (let ((params (get-arm-block-params target-lbl)))
    (let loop ((ps params) (as args) (i 0))
      (if (and (pair? ps) (pair? as))
          (let* ((param (car ps))
                 (arg (car as))
                 (loc (arm-param-location i param)))
            (cond
              ((equal? loc arg) #f)
              ((or (eq? loc 'x0) (eq? loc '%rax))
               (if (integer? arg)
                   (emit (string-append "    mov x0, #" (number->string arg)))
                   (arm-emit-load-operand 'x0 arg)))
              ((and (pair? loc) (eq? (car loc) '%stack))
               (let ((offset (cadr loc)))
                 (cond
                   ((integer? arg)
                    (emit (string-append "    mov x1, #" (number->string arg)))
                    (arm-emit-store 'x1 'sp offset))
                   ((pair? arg)
                    (arm-emit-load-operand 'x1 arg)
                    (arm-emit-store 'x1 'sp offset))
                   (else
                    (arm-emit-store arg 'sp offset)))))
              (else
               (if (integer? arg)
                   (emit (string-append "    mov " (arm-reg->str loc) ", #" (number->string arg)))
                   (arm-emit-load-operand loc arg))))
            (loop (cdr ps) (cdr as) (+ i 1)))))))

;;; Emits a single LIR instruction to AArch64 assembly
(define (emit-arm-lir-instruction inst)
  (let ((op (car inst)))
    (case op
      ((%label)
       (let ((lbl (cadr inst)))
         (emit "    .p2align 4")
         (emit (string-append (if (symbol? lbl) (symbol->string lbl) lbl) ":"))))

      ((%block)
       (let ((lbl (cadr inst))
             (params (caddr inst))
             (body (cdddr inst)))
         (record-arm-block-params! lbl params)
         (emit "    .p2align 4")
         (emit (string-append (if (symbol? lbl) (symbol->string lbl) lbl) ":"))
         (for-each emit-arm-lir-instruction body)))

      ((%jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (if (pair? args)
             (emit-arm-parallel-copy lbl args))
         (if (and (symbol? lbl)
                  (memq lbl '(%rax %rdx %rcx %rbx %r10 %r11 %r12 %rdi %rsi %r8 %r9 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x16 x17 x19 x30 lr)))
             (emit (string-append "    br " (arm-reg->str lbl)))
             (emit (string-append "    b " (if (symbol? lbl) (symbol->string lbl) lbl))))))

      ((%jump-if-false)
       (let* ((reg (cadr inst))
              (lbl (caddr inst))
              (args (if (pair? (cdddr inst)) (cadddr inst) '()))
              (reg-str (if (pair? reg)
                           (begin
                             (arm-emit-load-operand 'x10 reg)
                             "x10")
                           (arm-reg->str reg))))
         (if (null? args)
             (begin
               (emit (string-append "    cmp " reg-str ", #0x2F"))
               (emit (string-append "    b.eq " (if (symbol? lbl) (symbol->string lbl) lbl))))
             (let ((cont-lbl (unique-label-sym "L_cont_")))
               (emit (string-append "    cmp " reg-str ", #0x2F"))
               (emit (string-append "    b.ne " (symbol->string cont-lbl)))
               (emit-arm-parallel-copy lbl args)
               (emit (string-append "    b " (if (symbol? lbl) (symbol->string lbl) lbl)))
               (emit (string-append (symbol->string cont-lbl) ":"))))))

      ((%jump-if)
       (let* ((reg (cadr inst))
              (then-lbl (caddr inst))
              (then-args (cadddr inst))
              (rest-else (cdr (cdddr inst)))
              (else-lbl (car rest-else))
              (else-args (cadr rest-else))
              (else-tramline (unique-label-sym "L_else_tramline_"))
              (reg-str (if (pair? reg)
                           (begin
                             (arm-emit-load-operand 'x10 reg)
                             "x10")
                           (arm-reg->str reg))))
         (emit (string-append "    cmp " reg-str ", #0x2F"))
         (emit (string-append "    b.eq " (symbol->string else-tramline)))
         (if (pair? then-args)
             (emit-arm-parallel-copy then-lbl then-args))
         (emit (string-append "    b " (if (symbol? then-lbl) (symbol->string then-lbl) then-lbl)))
         (emit (string-append (symbol->string else-tramline) ":"))
         (if (pair? else-args)
             (emit-arm-parallel-copy else-lbl else-args))
         (emit (string-append "    b " (if (symbol? else-lbl) (symbol->string else-lbl) else-lbl)))))

      ((%jump-if-zero)
       (let ((lbl (cadr inst)))
         (emit (string-append "    b.eq " (if (symbol? lbl) (symbol->string lbl) lbl)))))

      ((%direct-jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (if (pair? args)
             (emit-arm-parallel-copy lbl args))
         (emit (string-append "    b " (if (symbol? lbl) (symbol->string lbl) lbl)))))

      ((%switch)
       ;; (%switch val def-lbl [def-args] cases)
       (let* ((val (cadr inst))
              (def-lbl (caddr inst))
              (has-def-args? (= (length inst) 5))
              (def-args (if has-def-args? (cadddr inst) '()))
              (cases (cond (has-def-args? (car (cddddr inst)))
                           ((pair? (cdddr inst)) (cadddr inst))
                           (else '())))
              (val-str (arm-operand->str val)))
         (for-each
          (lambda (c)
            (let* ((c-val (car c))
                   (c-lbl (cadr c))
                   (c-args (if (pair? (cddr c)) (caddr c) '()))
                   (next-c (unique-label-sym "L_arm_case_next_")))
              (emit (string-append "    cmp " val-str ", " (arm-operand->str c-val)))
              (emit (string-append "    b.ne " (symbol->string next-c)))
              (if (pair? c-args) (emit-arm-parallel-copy c-lbl c-args))
              (emit (string-append "    b " (if (symbol? c-lbl) (symbol->string c-lbl) c-lbl)))
              (emit (string-append (symbol->string next-c) ":"))))
          cases)
         ;; Default
         (if (pair? def-args) (emit-arm-parallel-copy def-lbl def-args))
         (emit (string-append "    b " (if (symbol? def-lbl) (symbol->string def-lbl) def-lbl)))))

      ((%jump-cond)
       (let* ((cond-op (cadr inst))
              (lbl (caddr inst))
              (lbl-str (if (symbol? lbl) (symbol->string lbl) lbl))
              (cc (cond ((or (string=? cond-op "je") (string=? cond-op "jz")) "eq")
                        ((or (string=? cond-op "jne") (string=? cond-op "jnz")) "ne")
                        ((string=? cond-op "jl") "lt")
                        ((string=? cond-op "jle") "le")
                        ((string=? cond-op "jg") "gt")
                        ((string=? cond-op "jge") "ge")
                        (else (error "Unknown jump-cond in AArch64:" cond-op)))))
         (emit (string-append "    b." cc " " lbl-str))))

      ((%return)
       (emit "    ret"))

      ((%mov)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((integer? src)
            (if (and (>= src -65535) (<= src 65535))
                (emit (string-append "    mov " (arm-reg->str dst) ", #" (number->string src)))
                (emit (string-append "    ldr " (arm-reg->str dst) ", =" (number->string src)))))
           ((pair? src)
            (arm-emit-load-operand dst src))
           (else
            (emit (string-append "    mov " (arm-reg->str dst) ", " (arm-reg->str src)))))))

      ((%load)
       (let ((dst (cadr inst))
             (base (caddr inst))
             (offset (cadddr inst)))
         (arm-emit-load dst base offset)))

      ((%store)
       (let ((base (cadr inst))
             (offset (caddr inst))
             (src (cadddr inst)))
         (arm-emit-store src base offset)))

      ((%memory-fence)
       (emit "    dmb ish"))

      ((%syscall)
       (if (pair? (cdr inst))
           (let ((si (cadr inst)))
             (arm-emit-load 'x8 'sp si)
             (arm-emit-load 'x0 'sp (- si 8))
             (arm-emit-load 'x1 'sp (- si 16))
             (arm-emit-load 'x2 'sp (- si 24))
             (arm-emit-load 'x3 'sp (- si 32))
             (arm-emit-load 'x4 'sp (- si 40))
             (arm-emit-load 'x5 'sp (- si 48))
             (emit "    svc #0"))
           (emit "    svc #0")))

      ((%atomic-cas!)
       (let ((dst (cadr inst))
             (box (caddr inst))
             (new (cadddr inst)))
         (emit (string-append "    mov x10, " (arm-reg->str dst)))
         (emit (string-append "    add x9, " (arm-reg->str box) ", #11"))
         (emit (string-append "    casal " (arm-reg->str dst) ", " (arm-reg->str new) ", [x9]"))
         (emit (string-append "    cmp " (arm-reg->str dst) ", x10"))
         (emit "    cset x0, eq")
         (emit "    lsl x0, x0, #6")
         (emit "    add x0, x0, #47")))

      ((%store-byte)
       (let ((base (cadr inst))
             (offset (caddr inst))
             (src (cadddr inst)))
         (arm-emit-store-byte src base offset)))

      ((%load-byte-zx)
       (let ((dst (cadr inst))
             (base (caddr inst))
             (offset (cadddr inst)))
         (arm-emit-load-byte-zx dst base offset)))

      ((%add %raw-add)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((pair? src)
            (arm-emit-load-operand 'x9 src)
            (emit (string-append "    add " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           ((number? src)
            (if (and (>= src 0) (<= src 4095))
                (emit (string-append "    add " (arm-reg->str dst) ", " (arm-reg->str dst) ", #" (number->string src)))
                (begin
                  (emit (string-append "    ldr x9, =" (number->string src)))
                  (emit (string-append "    add " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))))
           (else
            (emit (string-append "    add " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-reg->str src)))))))

      ((%sub %raw-sub)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((pair? src)
            (arm-emit-load-operand 'x9 src)
            (emit (string-append "    sub " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           ((number? src)
            (if (and (>= src 0) (<= src 4095))
                (emit (string-append "    sub " (arm-reg->str dst) ", " (arm-reg->str dst) ", #" (number->string src)))
                (begin
                  (emit (string-append "    ldr x9, =" (number->string src)))
                  (emit (string-append "    sub " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))))
           (else
            (emit (string-append "    sub " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-reg->str src)))))))

      ((%neg)
       (let ((dst (cadr inst)))
         (emit (string-append "    neg " (arm-reg->str dst) ", " (arm-reg->str dst)))))

      ((%imul %raw-mul)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((pair? src)
            (arm-emit-load-operand 'x9 src)
            (emit (string-append "    mul " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           ((number? src)
            (emit (string-append "    ldr x9, =" (number->string src)))
            (emit (string-append "    mul " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           (else
            (emit (string-append "    mul " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-reg->str src)))))))

      ((%box-fixnum)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    lsl " (arm-reg->str dst) ", " (arm-reg->str src) ", #2"))))

      ((%unbox-fixnum)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    asr " (arm-reg->str dst) ", " (arm-reg->str src) ", #2"))))

      ;; Typed Machine LIR: Memory Access, FP & Conversions (Issue #826)
      ((%load-typed)
       (let ((mty (cadr inst))
             (dst (caddr inst))
             (base (cadddr inst))
             (offset (car (cddddr inst))))
         (let ((dst-str (arm-reg->str dst))
               (mem-str (arm-mem-op->str base offset)))
           (case mty
             ((i8)  (emit (string-append "    ldrsb " dst-str ", " mem-str)))
             ((u8)  (emit (string-append "    ldrb " (arm-w-reg->str dst) ", " mem-str)))
             ((i16) (emit (string-append "    ldrsh " dst-str ", " mem-str)))
             ((u16) (emit (string-append "    ldrh " (arm-w-reg->str dst) ", " mem-str)))
             ((i32) (emit (string-append "    ldrsw " dst-str ", " mem-str)))
             ((u32) (emit (string-append "    ldr " (arm-w-reg->str dst) ", " mem-str)))
             ((f32) (emit (string-append "    ldr s" (substring dst-str 1 (string-length dst-str)) ", " mem-str)))
             ((f64) (emit (string-append "    ldr " dst-str ", " mem-str)))
             (else  (emit (string-append "    ldr " dst-str ", " mem-str)))))))

      ((%store-typed)
       (let ((mty (cadr inst))
             (base (caddr inst))
             (offset (cadddr inst))
             (src (car (cddddr inst))))
         (let ((src-str (arm-operand->str src))
               (mem-str (arm-mem-op->str base offset)))
           (case mty
             ((i8 u8)   (emit (string-append "    strb " (arm-w-reg->str src) ", " mem-str)))
             ((i16 u16) (emit (string-append "    strh " (arm-w-reg->str src) ", " mem-str)))
             ((i32 u32) (emit (string-append "    str " (arm-w-reg->str src) ", " mem-str)))
             ((f32)     (emit (string-append "    str s" (substring src-str 1 (string-length src-str)) ", " mem-str)))
             ((f64)     (emit (string-append "    str " src-str ", " mem-str)))
             (else      (emit (string-append "    str " src-str ", " mem-str)))))))

      ((%fmov)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fmov " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fadd)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fadd " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fsub)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fsub " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fmul)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fmul " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fdiv)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fdiv " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fcmp)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fcmp " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fneg)
       (let ((mty (cadr inst)) (dst (caddr inst)) (src (cadddr inst)))
         (let ((d-str (arm-reg->str dst))
               (s-str (arm-operand->str src)))
           (if (eq? mty 'f32)
               (let ((ds (string-append "s" (substring d-str 1 (string-length d-str))))
                     (ss (string-append "s" (substring s-str 1 (string-length s-str)))))
                 (emit (string-append "    fneg " ds ", " ss)))
               (emit (string-append "    fneg " d-str ", " s-str))))))

      ((%fpext)
       (let ((dst (caddr inst)) (src (cadddr inst)))
         (let ((s-str (arm-operand->str src)))
           (emit (string-append "    fcvt " (arm-reg->str dst) ", s" (substring s-str 1 (string-length s-str)))))))

      ((%fptrunc)
       (let ((dst (caddr inst)) (src (cadddr inst)))
         (let ((d-str (arm-reg->str dst)))
           (emit (string-append "    fcvt s" (substring d-str 1 (string-length d-str)) ", " (arm-operand->str src))))))

      ((%sitofp)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    scvtf " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%uitofp)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    ucvtf " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fptosi)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fcvtzs " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fptoui)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    fcvtzu " (arm-reg->str dst) ", " (arm-operand->str src)))))

      ((%fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge)
       (let* ((dst (cadr inst))
              (lhs (caddr inst))
              (rhs (cadddr inst))
              (cc (case op
                    ((%fcmp-oeq) "eq")
                    ((%fcmp-une) "ne")
                    ((%fcmp-olt) "mi")
                    ((%fcmp-ole) "ls")
                    ((%fcmp-ogt) "gt")
                    ((%fcmp-oge) "ge"))))
         (emit (string-append "    fcmp " (arm-reg->str lhs) ", " (arm-operand->str rhs)))
         (emit (string-append "    cset " (arm-reg->str dst) ", " cc))))

      ((%box-flonum)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    str " (arm-reg->str src) ", [" (arm-reg->str dst) ", #8]"))))

      ((%unbox-flonum)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (emit (string-append "    ldr " (arm-reg->str dst) ", [" (arm-reg->str src) ", #8]"))))

      ((%trunc %zext %sext)
       (let ((mty (cadr inst)) (dst (caddr inst)) (src (cadddr inst)))
         (case mty
           ((i8)  (emit (string-append "    sxtb " (arm-reg->str dst) ", " (arm-w-reg->str src))))
           ((u8)  (emit (string-append "    uxtb " (arm-w-reg->str dst) ", " (arm-w-reg->str src))))
           ((i16) (emit (string-append "    sxth " (arm-reg->str dst) ", " (arm-w-reg->str src))))
           ((u16) (emit (string-append "    uxth " (arm-w-reg->str dst) ", " (arm-w-reg->str src))))
           ((i32) (emit (string-append "    sxtw " (arm-reg->str dst) ", " (arm-w-reg->str src))))
           ((u32) (emit (string-append "    mov " (arm-w-reg->str dst) ", " (arm-w-reg->str src))))
           (else  (emit (string-append "    mov " (arm-reg->str dst) ", " (arm-operand->str src)))))))

      ((%cqo)
       ;; In AArch64, 64-bit sdiv does not require cqo sign extension; no-op.
       #f)

      ((%idiv)
       (let ((src (cadr inst)))
         (let ((src-str (if (pair? src)
                            (begin
                              (arm-emit-load-operand 'x10 src)
                              "x10")
                            (arm-operand->str src))))
           (emit (string-append "    sdiv x9, x0, " src-str))
           (emit (string-append "    msub x2, x9, " src-str ", x0"))
           (emit "    mov x0, x9"))))

      ((%udiv)
       (if (= (length inst) 2)
           (let ((src (cadr inst)))
             (let ((src-str (if (pair? src)
                                (begin
                                  (arm-emit-load-operand 'x10 src)
                                  "x10")
                                (if (number? src)
                                    (begin
                                      (emit (string-append "    ldr x10, =" (number->string src)))
                                      "x10")
                                    (arm-operand->str src)))))
               (emit (string-append "    udiv x9, x0, " src-str))
               (emit (string-append "    msub x2, x9, " src-str ", x0"))
               (emit "    mov x0, x9")))
           (let ((dst (cadr inst))
                 (src1 (caddr inst))
                 (src2 (cadddr inst)))
             (let ((s1-str (if (pair? src1)
                               (begin (arm-emit-load-operand 'x9 src1) "x9")
                               (if (number? src1)
                                   (begin (emit (string-append "    ldr x9, =" (number->string src1))) "x9")
                                   (arm-operand->str src1))))
                   (s2-str (if (pair? src2)
                               (begin (arm-emit-load-operand 'x10 src2) "x10")
                               (if (number? src2)
                                   (begin (emit (string-append "    ldr x10, =" (number->string src2))) "x10")
                                   (arm-operand->str src2)))))
               (emit (string-append "    udiv " (arm-reg->str dst) ", " s1-str ", " s2-str))))))

      ((%urem)
       (if (= (length inst) 2)
           (let ((src (cadr inst)))
             (let ((src-str (if (pair? src)
                                (begin
                                  (arm-emit-load-operand 'x10 src)
                                  "x10")
                                (if (number? src)
                                    (begin
                                      (emit (string-append "    ldr x10, =" (number->string src)))
                                      "x10")
                                    (arm-operand->str src)))))
               (emit (string-append "    udiv x9, x0, " src-str))
               (emit (string-append "    msub x2, x9, " src-str ", x0"))
               (emit "    mov x0, x2")))
           (let ((dst (cadr inst))
                 (src1 (caddr inst))
                 (src2 (cadddr inst)))
             (let ((s1-str (if (pair? src1)
                               (begin (arm-emit-load-operand 'x9 src1) "x9")
                               (if (number? src1)
                                   (begin (emit (string-append "    ldr x9, =" (number->string src1))) "x9")
                                   (arm-operand->str src1))))
                   (s2-str (if (pair? src2)
                               (begin (arm-emit-load-operand 'x10 src2) "x10")
                               (if (number? src2)
                                   (begin (emit (string-append "    ldr x10, =" (number->string src2))) "x10")
                                   (arm-operand->str src2)))))
               (emit (string-append "    udiv x11, " s1-str ", " s2-str))
               (emit (string-append "    msub " (arm-reg->str dst) ", x11, " s2-str ", " s1-str))))))

      ((%add-overflow)
       (let ((dst-val (cadr inst))
             (dst-flag (caddr inst))
             (src1 (cadddr inst))
             (src2 (car (cddddr inst))))
         (let ((s1-str (if (pair? src1)
                           (begin (arm-emit-load-operand 'x9 src1) "x9")
                           (if (number? src1)
                               (begin (emit (string-append "    ldr x9, =" (number->string src1))) "x9")
                               (arm-operand->str src1))))
               (s2-str (if (pair? src2)
                           (begin (arm-emit-load-operand 'x10 src2) "x10")
                           (if (number? src2)
                               (begin (emit (string-append "    ldr x10, =" (number->string src2))) "x10")
                               (arm-operand->str src2)))))
           (emit (string-append "    adds " (arm-reg->str dst-val) ", " s1-str ", " s2-str))
           (emit (string-append "    cset " (arm-reg->str dst-flag) ", vs")))))

      ((%sub-overflow)
       (let ((dst-val (cadr inst))
             (dst-flag (caddr inst))
             (src1 (cadddr inst))
             (src2 (car (cddddr inst))))
         (let ((s1-str (if (pair? src1)
                           (begin (arm-emit-load-operand 'x9 src1) "x9")
                           (if (number? src1)
                               (begin (emit (string-append "    ldr x9, =" (number->string src1))) "x9")
                               (arm-operand->str src1))))
               (s2-str (if (pair? src2)
                           (begin (arm-emit-load-operand 'x10 src2) "x10")
                           (if (number? src2)
                               (begin (emit (string-append "    ldr x10, =" (number->string src2))) "x10")
                               (arm-operand->str src2)))))
           (emit (string-append "    subs " (arm-reg->str dst-val) ", " s1-str ", " s2-str))
           (emit (string-append "    cset " (arm-reg->str dst-flag) ", vs")))))

      ((%mul-overflow)
       (let ((dst-val (cadr inst))
             (dst-flag (caddr inst))
             (src1 (cadddr inst))
             (src2 (car (cddddr inst))))
         (let ((s1-str (if (pair? src1)
                           (begin (arm-emit-load-operand 'x9 src1) "x9")
                           (if (number? src1)
                               (begin (emit (string-append "    ldr x9, =" (number->string src1))) "x9")
                               (arm-operand->str src1))))
               (s2-str (if (pair? src2)
                           (begin (arm-emit-load-operand 'x10 src2) "x10")
                           (if (number? src2)
                               (begin (emit (string-append "    ldr x10, =" (number->string src2))) "x10")
                               (arm-operand->str src2)))))
           (emit (string-append "    smulh x11, " s1-str ", " s2-str))
           (emit (string-append "    mul " (arm-reg->str dst-val) ", " s1-str ", " s2-str))
           (emit (string-append "    asr x12, " (arm-reg->str dst-val) ", #63"))
           (emit "    cmp x11, x12")
           (emit (string-append "    cset " (arm-reg->str dst-flag) ", ne")))))

      ((%inc)
       (let ((dst (cadr inst)))
         (emit (string-append "    add " (arm-reg->str dst) ", " (arm-reg->str dst) ", #1"))))

      ((%shl)
       (let* ((dst (cadr inst))
              (count (caddr inst))
              (cnt-str (if (number? count)
                           (string-append "#" (number->string count))
                           (arm-reg->str count))))
         (emit (string-append "    lsl " (arm-reg->str dst) ", " (arm-reg->str dst) ", " cnt-str))))

      ((%shr)
       (if (= (length inst) 3)
           (let* ((dst (cadr inst))
                  (count (caddr inst))
                  (cnt-str (if (number? count)
                               (string-append "#" (number->string count))
                               (arm-reg->str count))))
             (emit (string-append "    lsr " (arm-reg->str dst) ", " (arm-reg->str dst) ", " cnt-str)))
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (count (cadddr inst))
                  (cnt-str (if (number? count)
                               (string-append "#" (number->string count))
                               (arm-reg->str count))))
             (let ((src-str (if (pair? src)
                                (begin (arm-emit-load-operand 'x9 src) "x9")
                                (arm-operand->str src))))
               (emit (string-append "    lsr " (arm-reg->str dst) ", " src-str ", " cnt-str))))))

      ((%sar)
       (let* ((dst (cadr inst))
              (count (caddr inst))
              (cnt-str (if (number? count)
                           (string-append "#" (number->string count))
                           (arm-reg->str count))))
         (emit (string-append "    asr " (arm-reg->str dst) ", " (arm-reg->str dst) ", " cnt-str))))

      ((%bit-and)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((pair? src)
            (arm-emit-load-operand 'x9 src)
            (emit (string-append "    and " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           ((number? src)
            (emit (string-append "    ldr x9, =" (number->string src)))
            (emit (string-append "    and " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           (else
            (emit (string-append "    and " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-reg->str src)))))))

      ((%bit-or)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((pair? src)
            (arm-emit-load-operand 'x9 src)
            (emit (string-append "    orr " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           ((number? src)
            (emit (string-append "    ldr x9, =" (number->string src)))
            (emit (string-append "    orr " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           (else
            (emit (string-append "    orr " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-reg->str src)))))))

      ((%bit-xor)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((pair? src)
            (arm-emit-load-operand 'x9 src)
            (emit (string-append "    eor " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           ((number? src)
            (emit (string-append "    ldr x9, =" (number->string src)))
            (emit (string-append "    eor " (arm-reg->str dst) ", " (arm-reg->str dst) ", x9")))
           (else
            (emit (string-append "    eor " (arm-reg->str dst) ", " (arm-reg->str dst) ", " (arm-reg->str src)))))))

      ((%cmp %raw-cmp)
       (let ((s1 (cadr inst))
             (s2 (caddr inst)))
         (if (pair? s1)
             (begin
               (arm-emit-load-operand 'x10 s1)
               (cond
                 ((pair? s2)
                  (arm-emit-load-operand 'x9 s2)
                  (emit "    cmp x10, x9"))
                 ((number? s2)
                  (if (and (>= s2 0) (<= s2 4095))
                      (emit (string-append "    cmp x10, #" (number->string s2)))
                      (begin
                        (emit (string-append "    ldr x9, =" (number->string s2)))
                        (emit "    cmp x10, x9"))))
                 (else
                  (emit (string-append "    cmp x10, " (arm-reg->str s2))))))
             (cond
               ((pair? s2)
                (arm-emit-load-operand 'x9 s2)
                (emit (string-append "    cmp " (arm-reg->str s1) ", x9")))
               ((number? s2)
                (if (and (>= s2 0) (<= s2 4095))
                    (emit (string-append "    cmp " (arm-reg->str s1) ", #" (number->string s2)))
                    (begin
                      (emit (string-append "    ldr x9, =" (number->string s2)))
                      (emit (string-append "    cmp " (arm-reg->str s1) ", x9")))))
               (else
                (emit (string-append "    cmp " (arm-reg->str s1) ", " (arm-operand->str s2))))))))

      ((%setb %setbe %seta %setae)
       (let ((cc-cond (case (car inst)
                        ((%setb) "cc")
                        ((%setbe) "ls")
                        ((%seta) "hi")
                        ((%setae) "cs"))))
         (if (= (length inst) 2)
             (let ((dst (cadr inst)))
               (emit (string-append "    cset " (arm-reg->str dst) ", " cc-cond)))
             (let ((dst (cadr inst))
                   (s1 (caddr inst))
                   (s2 (cadddr inst)))
               (let ((s1-str (if (pair? s1)
                                 (begin (arm-emit-load-operand 'x9 s1) "x9")
                                 (if (number? s1)
                                     (begin (emit (string-append "    ldr x9, =" (number->string s1))) "x9")
                                     (arm-operand->str s1))))
                     (s2-str (if (pair? s2)
                                 (begin (arm-emit-load-operand 'x10 s2) "x10")
                                 (if (number? s2)
                                     (begin (emit (string-append "    ldr x10, =" (number->string s2))) "x10")
                                     (arm-operand->str s2)))))
                 (emit (string-append "    cmp " s1-str ", " s2-str))
                 (emit (string-append "    cset " (arm-reg->str dst) ", " cc-cond)))))))

      ((%set-boolean)
       (let ((cc (caddr inst)))
         (emit-arm-boolean-from-set cc)))

      ((%alloc)
       (let ((dst (cadr inst))
             (bytes (caddr inst))
             (tag (cadddr inst)))
         (if (= tag 0)
             (emit (string-append "    mov " (arm-reg->str dst) ", x19"))
             (emit (string-append "    add " (arm-reg->str dst) ", x19, #" (number->string tag))))
         (emit (string-append "    add x19, x19, #" (number->string bytes)))))

      ((%alloc-stack)
       (let ((dst (cadr inst))
             (offset (caddr inst))
             (tag (cadddr inst)))
         (let ((disp (+ offset tag)))
           (cond
             ((and (>= disp 0) (<= disp 4095))
              (emit (string-append "    add " (arm-reg->str dst) ", sp, #" (number->string disp))))
             ((and (< disp 0) (>= disp -4095))
              (emit (string-append "    sub " (arm-reg->str dst) ", sp, #" (number->string (- 0 disp)))))
             (else
              (emit (string-append "    ldr x16, =" (number->string disp)))
              (emit (string-append "    add " (arm-reg->str dst) ", sp, x16")))))))

      ((%code-ref)
       (let ((dst (cadr inst))
             (lbl (caddr inst)))
         (let ((lbl-str (if (symbol? lbl) (symbol->string lbl) lbl))
               (dst-str (arm-reg->str dst)))
           (emit (string-append "    adrp " dst-str ", " lbl-str))
           (emit (string-append "    add " dst-str ", " dst-str ", :lo12:" lbl-str)))))

      ((%str-ref)
       (let ((dst (cadr inst))
             (lbl (caddr inst)))
         (let ((lbl-str (if (symbol? lbl) (symbol->string lbl) lbl))
               (dst-str (arm-reg->str dst)))
           (emit (string-append "    adrp " dst-str ", " lbl-str))
           (emit (string-append "    add " dst-str ", " dst-str ", :lo12:" lbl-str))
           (emit (string-append "    add " dst-str ", " dst-str ", #3")))))

      ((%c-call %call-foreign)
       (let* ((func (cadr inst))
              (frame-shift (caddr inst))
              (total-shift (arm-align-frame-shift frame-shift)))
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit (string-append "    bl " (if (symbol? func) (symbol->raw-name func) func)))
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)))

      ((%call-indirect)
       (let* ((target-reg (cadr inst))
              (frame-shift (caddr inst))
              (total-shift (arm-align-frame-shift frame-shift)))
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit (string-append "    blr " (arm-reg->str target-reg)))
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)))

      ((%call-closure)
       (let* ((frame-shift (cadr inst))
              (safepoint (if (pair? (cddr inst)) (caddr inst) #f))
              (total-shift (arm-align-frame-shift frame-shift)))
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit "    ldr x16, [x10, #-1]")
         (emit "    blr x16")
         (if safepoint
             (emit (string-append (if (symbol? safepoint) (symbol->string safepoint) safepoint) ":")))
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)))

      ((%direct-call)
       (let* ((label (cadr inst))
              (lbl-str (if (symbol? label) (symbol->string label) label))
              (frame-shift (caddr inst))
              (safepoint (if (pair? (cdddr inst)) (cadddr inst) #f))
              (total-shift (arm-align-frame-shift frame-shift)))
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit "    mov x10, #0")
         (emit (string-append "    bl " lbl-str))
         (if safepoint
             (emit (string-append (if (symbol? safepoint) (symbol->string safepoint) safepoint) ":")))
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)))

      ((%direct-jump)
       (let* ((label (cadr inst))
              (lbl-str (if (symbol? label) (symbol->string label) label)))
         (emit "    mov x10, #0")
         (emit (string-append "    b " lbl-str))))

      ((%global-ref)
       (let ((reg (cadr inst))
             (var (caddr inst)))
         (let ((g-lbl (string-append "ulisp_gvar_" (sanitize-label-str (symbol->string var)))))
           (emit (string-append "    adrp x9, " g-lbl))
           (emit (string-append "    add x9, x9, :lo12:" g-lbl))
           (emit (string-append "    ldr " (arm-reg->str reg) ", [x9]")))))

      ((%global-set!)
       (let ((var (cadr inst))
             (reg (caddr inst)))
         (let ((g-lbl (string-append "ulisp_gvar_" (sanitize-label-str (symbol->string var)))))
           (emit (string-append "    adrp x9, " g-lbl))
           (emit (string-append "    add x9, x9, :lo12:" g-lbl))
           (emit (string-append "    str " (arm-reg->str reg) ", [x9]")))))

      ((%push-handler)
       (let ((catch-lbl (cadr inst))
             (frame-si (caddr inst))
             (handler-si (cadddr inst)))
         (let ((lbl-str (if (symbol? catch-lbl) (symbol->string catch-lbl) catch-lbl)))
           (emit (string-append "    adrp x9, " lbl-str))
           (emit (string-append "    add x9, x9, :lo12:" lbl-str))
           (arm-emit-store 'x9 '%rsp (+ frame-si 24))
           (emit "    mrs x1, tpidr_el0")
           (emit "    cbz x1, 1f")
           (emit "    ldr x1, [x1]")
           (emit "    and x1, x1, #63")
           (emit "1:")
           (emit "    adrp x2, ulisp_handler_chain")
           (emit "    add x2, x2, :lo12:ulisp_handler_chain")
           (emit "    add x1, x2, x1, lsl #3")
           (emit "    ldr x2, [x1]")
           (arm-emit-store 'x2 '%rsp frame-si)
           (emit "    mov x9, sp")
           (arm-emit-store 'x9 '%rsp (+ frame-si 8))
           (arm-emit-store 'x29 '%rsp (+ frame-si 16))
           (arm-emit-store 'x30 '%rsp (+ frame-si 40))
           (arm-emit-load 'x9 '%rsp handler-si)
           (arm-emit-store 'x9 '%rsp (+ frame-si 32))
           (if (and (>= (- 0 frame-si) 0) (<= (- 0 frame-si) 4095))
               (emit (string-append "    sub x9, sp, #" (number->string (- 0 frame-si))))
               (begin
                 (emit (string-append "    ldr x16, =" (number->string frame-si)))
                 (emit "    add x9, sp, x16")))
           (emit "    str x9, [x1]"))))

      ((%pop-handler)
       (let ((frame-si (cadr inst)))
         (emit "    mrs x1, tpidr_el0")
         (emit "    cbz x1, 1f")
         (emit "    ldr x1, [x1]")
         (emit "    and x1, x1, #63")
         (emit "1:")
         (emit "    adrp x2, ulisp_handler_chain")
         (emit "    add x2, x2, :lo12:ulisp_handler_chain")
         (emit "    add x1, x2, x1, lsl #3")
         (arm-emit-load 'x2 '%rsp frame-si)
         (emit "    str x2, [x1]")))

      ((%raise)
       (emit "    mrs x1, tpidr_el0")
       (emit "    cbz x1, 1f")
       (emit "    ldr x1, [x1]")
       (emit "    and x1, x1, #63")
       (emit "1:")
       (emit "    adrp x2, ulisp_handler_chain")
       (emit "    add x2, x2, :lo12:ulisp_handler_chain")
       (emit "    add x1, x2, x1, lsl #3")
       (emit "    ldr x3, [x1]")
       (emit "    cbz x3, .L_arm_unhandled_exn")
       (emit "    ldr x2, [x3]")
       (emit "    str x2, [x1]")
       (emit "    ldr x9, [x3, #8]")
       (emit "    mov sp, x9")
       (emit "    ldr x29, [x3, #16]")
       (emit "    ldr x30, [x3, #40]")
       (emit "    ldr x9, [x3, #24]")
       (emit "    ldr x10, [x3, #32]")
       (emit "    br x9"))

      ((%set-values-count)
       (let ((cnt (cadr inst)))
         (emit "    adrp x1, ulisp_values_count")
         (emit "    add x1, x1, :lo12:ulisp_values_count")
         (emit (string-append "    mov x2, #" (number->string cnt)))
         (emit "    str x2, [x1]")))

      ((%store-values-buf)
       (let ((base-si (cadr inst))
             (count (caddr inst)))
         (emit "    adrp x1, ulisp_values_buf")
         (emit "    add x1, x1, :lo12:ulisp_values_buf")
         (let loop ((i 0))
           (if (< i count)
               (let ((offset (+ base-si (* -8 i)))
                     (buf-disp (* 8 i)))
                 (arm-emit-load 'x0 '%rsp offset)
                 (emit (string-append "    str x0, [x1, #" (number->string buf-disp) "]"))
                 (loop (+ i 1)))))))

      ((%dispatch-consumer)
       (let* ((consumer-si (cadr inst))
              (aligned-si (caddr inst))
              (frame-shift (cadddr inst))
              (total-shift (+ frame-shift 8))
              (exit-lbl (unique-label-sym "L_arm_cwv_exit_"))
              (call-0-lbl (unique-label-sym "L_arm_cwv_call_0_"))
              (call-1-lbl (unique-label-sym "L_arm_cwv_call_1_"))
              (call-2-lbl (unique-label-sym "L_arm_cwv_call_2_"))
              (call-3-lbl (unique-label-sym "L_arm_cwv_call_3_"))
              (call-4-lbl (unique-label-sym "L_arm_cwv_call_4_"))
              (exit-str (symbol->string exit-lbl)))
         (emit "    adrp x1, ulisp_values_count")
         (emit "    add x1, x1, :lo12:ulisp_values_count")
         (emit "    ldr x2, [x1]")
         (emit "    mov x3, #1")
         (emit "    str x3, [x1]")
         (arm-emit-load 'x10 '%rsp consumer-si)
         (emit "    adrp x3, ulisp_values_buf")
         (emit "    add x3, x3, :lo12:ulisp_values_buf")
         (emit "    cmp x2, #1")
         (emit (string-append "    b.eq " (symbol->string call-1-lbl)))
         (emit "    cmp x2, #2")
         (emit (string-append "    b.eq " (symbol->string call-2-lbl)))
         (emit (string-append "    cbz x2, " (symbol->string call-0-lbl)))
         (emit "    cmp x2, #3")
         (emit (string-append "    b.eq " (symbol->string call-3-lbl)))
         (emit "    cmp x2, #4")
         (emit (string-append "    b.eq " (symbol->string call-4-lbl)))
         ;; 0 args
         (emit (string-append (symbol->string call-0-lbl) ":"))
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit "    mov x7, #0")
         (emit "    ldr x16, [x10, #-1]")
         (emit "    blr x16")
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)
         (emit (string-append "    b " exit-str))
         ;; 1 arg (x0 has the value)
         (emit (string-append (symbol->string call-1-lbl) ":"))
         (arm-emit-store 'x0 '%rsp aligned-si)
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit "    mov x7, #4")
         (emit "    ldr x16, [x10, #-1]")
         (emit "    blr x16")
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)
         (emit (string-append "    b " exit-str))
         ;; 2 args
         (emit (string-append (symbol->string call-2-lbl) ":"))
         (emit "    ldr x0, [x3]")
         (arm-emit-store 'x0 '%rsp (+ aligned-si 8))
         (emit "    ldr x1, [x3, #8]")
         (arm-emit-store 'x1 '%rsp aligned-si)
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit "    mov x7, #8")
         (emit "    ldr x16, [x10, #-1]")
         (emit "    blr x16")
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)
         (emit (string-append "    b " exit-str))
         ;; 3 args
         (emit (string-append (symbol->string call-3-lbl) ":"))
         (emit "    ldr x0, [x3]")
         (arm-emit-store 'x0 '%rsp (+ aligned-si 16))
         (emit "    ldr x1, [x3, #8]")
         (arm-emit-store 'x1 '%rsp (+ aligned-si 8))
         (emit "    ldr x2, [x3, #16]")
         (arm-emit-store 'x2 '%rsp aligned-si)
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit "    mov x7, #12")
         (emit "    ldr x16, [x10, #-1]")
         (emit "    blr x16")
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)
         (emit (string-append "    b " exit-str))
         ;; 4 args
         (emit (string-append (symbol->string call-4-lbl) ":"))
         (emit "    ldr x0, [x3]")
         (arm-emit-store 'x0 '%rsp (+ aligned-si 24))
         (emit "    ldr x1, [x3, #8]")
         (arm-emit-store 'x1 '%rsp (+ aligned-si 16))
         (emit "    ldr x2, [x3, #16]")
         (arm-emit-store 'x2 '%rsp (+ aligned-si 8))
         (emit "    ldr x3, [x3, #24]")
         (arm-emit-store 'x3 '%rsp aligned-si)
         (arm-emit-sub-sp total-shift)
         (emit "    str x30, [sp]")
         (emit "    mov x7, #16")
         (emit "    ldr x16, [x10, #-1]")
         (emit "    blr x16")
         (emit "    ldr x30, [sp]")
         (arm-emit-add-sp total-shift)
         (emit (string-append "    b " exit-str))
         (emit (string-append exit-str ":"))))

      ((%capture-cc)
       (let* ((ret-lbl (cadr inst))
              (k-si (caddr inst))
              (lbl-str (if (symbol? ret-lbl) (symbol->string ret-lbl) ret-lbl))
              (loop-lbl (unique-label-sym "L_arm_copy_")))
         (emit "    adrp x2, ulisp_stack_base")
         (emit "    ldr x2, [x2, :lo12:ulisp_stack_base]")
         (emit "    mov x3, sp")
         (emit "    sub x2, x2, x3")
         (emit "    add x4, x2, #111")
         (emit "    and x4, x4, #~15")
         (emit "    mov x0, x19")
         (emit "    add x19, x19, x4")
         (emit "    adrp x5, ulisp_continuation_invoke")
         (emit "    add x5, x5, :lo12:ulisp_continuation_invoke")
         (emit "    str x5, [x0]")
         (emit "    str x2, [x0, #8]")
         (emit "    str x3, [x0, #16]")
         (emit "    str x29, [x0, #24]")
         (emit (string-append "    adrp x5, " lbl-str))
         (emit (string-append "    add x5, x5, :lo12:" lbl-str))
         (emit "    str x5, [x0, #72]")
         (emit "    mrs x5, tpidr_el0")
         (emit "    cbz x5, 1f")
         (emit "    ldr x5, [x5]")
         (emit "    and x5, x5, #63")
         (emit "1:")
         (emit "    adrp x6, ulisp_handler_chain")
         (emit "    add x6, x6, :lo12:ulisp_handler_chain")
         (emit "    add x5, x6, x5, lsl #3")
         (emit "    ldr x6, [x5]")
         (emit "    str x6, [x0, #80]")
         (emit "    add x1, x0, #96")
         (emit "    mov x7, x3")
         (emit "    mov x8, x2")
         (emit (string-append (symbol->string loop-lbl) ":"))
         (emit "    cbz x8, 1f")
         (emit "    ldrb w9, [x7], #1")
         (emit "    strb w9, [x1], #1")
         (emit "    sub x8, x8, #1")
         (emit (string-append "    b " (symbol->string loop-lbl)))
         (emit "1:")
         (emit "    orr x0, x0, #1")
         (arm-emit-store 'x0 '%rsp k-si)))

      ((%align %p2align)
       (let ((align (cadr inst)))
         (emit (string-append "    .p2align " (number->string align)))))

      ((%raw-asm)
       (emit (cadr inst)))

      (else
       (error "Unknown LIR opcode in AArch64 backend:" inst)))))

(define (arm-call-or-jump-inst? inst)
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (case op
          ((%direct-call %call-closure %direct-jump %c-call %call-indirect) #t)
          ((%jump)
           ;; Only indirect jumps to registers (%jump %r11) are tail calls expecting argc in x7.
           ;; Jumps to code labels (%jump <lbl>) are local control-flow transfers (e.g. if-merge)
           ;; where (%mov %rax ...) is setting the actual return/expression value into x0.
           (and (pair? (cdr inst))
                (memq (cadr inst) '(%rax %r10 %r11 %r12 %rdi %rsi %rdx %rcx %r8 %r9 %rbx %rbp %rsp x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x16 x17 x19 x30 lr))))
          (else #f)))))

(define (emit-arm-body insts skip-return?)
  (let loop ((rest insts))
    (if (pair? rest)
        (let* ((inst (car rest))
               (next (if (pair? (cdr rest)) (cadr rest) #f)))
          (cond
            ;; 1. If skip-return? is true and this is %return, do nothing
            ((and skip-return? (pair? inst) (eq? (car inst) '%return))
             #f)

            ;; 2. If (%mov %rax N) immediately followed by a call/jump, set x7 (argc)
            ((and (pair? inst)
                  (eq? (car inst) '%mov)
                  (eq? (cadr inst) '%rax)
                  next
                  (pair? next)
                  (arm-call-or-jump-inst? next))
             (let ((src (caddr inst)))
               (if (number? src)
                   (emit (string-append "    mov x7, #" (number->string src)))
                   (emit (string-append "    mov x7, " (arm-reg->str src))))))

            ;; 2b. Guard catch entry: (%mov %r10 %rax) when next is (%mov %rax 4)
            ;; In AArch64, %raise has already loaded the handler closure into x10 and exception value into x0.
            ;; Overwriting x10 with x0 would clobber the handler closure with the exception value.
            ((and (pair? inst)
                  (eq? (car inst) '%mov)
                  (eq? (cadr inst) '%r10)
                  (eq? (caddr inst) '%rax)
                  next
                  (pair? next)
                  (eq? (car next) '%mov)
                  (eq? (cadr next) '%rax)
                  (pair? (cddr next))
                  (equal? (caddr next) 4))
             #f)

            ;; 3. Normal instruction
            (else
             (emit-arm-lir-instruction inst)))
          (loop (cdr rest))))))

;;; Emits assembly for a single %lir-function
(define (emit-arm-function fn)
  (let* ((label (cadr fn))
         (label-str (if (symbol? label) (symbol->string label) label))
         (body (cdr (assq 'body (cddr fn)))))
    (scan-arm-blocks! body)
    (emit "    .p2align 4")
    (emit (string-append "    .globl " label-str))
    (emit (string-append "    .weak " label-str))
    (emit (string-append "    .type " label-str ", %function"))
    (emit (string-append label-str ":"))
    ;; Callee prologue: self closure pointer was in x10
    ;; Store self closure pointer at [sp, #-8]
    (emit "    str x10, [sp, #-8]")
    ;; Callee prologue: if first instruction is (%store %rsp -16 %rax), store argc (x7)
    (if (and (pair? body)
             (pair? (car body))
             (eq? (caar body) '%store)
             (eq? (cadar body) '%rsp)
             (= (caddar body) -16)
             (eq? (car (cdddar body)) '%rax))
        (begin
          (emit "    str x7, [sp, #-16]")
          (emit-arm-body (cdr body) #f))
        (emit-arm-body body #f))))

;;; Pass 7 Entrypoint: Takes %lir-program and emits complete GNU AArch64 assembly
(define (emit-aarch64 prog gc-mode)
  (let* ((funcs-clause (assq '%lir-functions (cdr prog)))
         (funcs (if funcs-clause (cdr funcs-clause) '()))
         (main-clause (assq '%lir-main (cdr prog)))
         (main-body (cdr (assq 'body (cdr main-clause)))))
    (emit "    .text")
    (if (not (module-mode?))
        (begin
          (emit "    .globl _start")
          (emit "    .weak _start")
          (emit "    .type _start, @function")
          (emit "    .p2align 4")
          (emit "_start:")
          ;; Initialize TLS for Main Thread (Worker 0)
          (emit "    adrp x0, ulisp_worker_tls_table")
          (emit "    add x0, x0, :lo12:ulisp_worker_tls_table")
          (emit "    msr tpidr_el0, x0")
          (emit "    adrp x2, ulisp_stack_base")
          (emit "    mov x3, sp")
          (emit "    str x3, [x2, :lo12:ulisp_stack_base]")
          (emit "    adrp x2, ulisp_heap_limit")
          (emit "    adrp x0, ulisp_initial_heap")
          (emit "    add x0, x0, :lo12:ulisp_initial_heap")
          (emit "    mov x1, #1")
          (emit "    lsl x1, x1, #24")
          (emit "    add x1, x0, x1")
          (emit "    str x1, [x2, :lo12:ulisp_heap_limit]")
          (emit "    bl scheme_entry")
          (emit "    and x1, x0, #3")
          (emit "    cbnz x1, 1f")
          (emit "    asr x0, x0, #2")
          (emit "    b 2f")
          (emit "1:")
          (emit "    mov x0, #0")
          (emit "2:")
          (emit "    mov x8, #93")
          (emit "    svc #0")))
    (if (module-mode?)
        (let ((init-lbl (if (current-module-id)
                            (mangle-mod-init-label (current-module-id))
                            "ulisp_stdlib_init")))
          (emit (string-append "    .globl " init-lbl))
          (emit (string-append "    .type " init-lbl ", @function"))
          (emit "    .p2align 4")
          (emit (string-append init-lbl ":"))
          (if (current-module-id)
              (begin
                (emit "    .section .init_array, \"aw\"")
                (emit "    .p2align 3")
                (emit (string-append "    .xword " init-lbl))
                (emit "    .text"))))
        (begin
          (emit "    .globl scheme_entry")
          (emit "    .type scheme_entry, @function")
          (emit "    .p2align 4")
          (emit "scheme_entry:")))
    (if (module-mode?)
        (begin
          (emit "    stp x29, x30, [sp, #-48]!")
          (emit "    mov x29, sp")
          (emit "    stp x20, x21, [sp, #16]")
          (emit "    stp x22, x23, [sp, #32]")
          (emit "    adrp x2, ulisp_stack_base")
          (emit "    ldr x3, [x2, :lo12:ulisp_stack_base]")
          (emit "    cbnz x3, 1f")
          (emit "    mov x3, sp")
          (emit "    str x3, [x2, :lo12:ulisp_stack_base]")
          (emit "1:"))
        (begin
          (emit "    stp x29, x30, [sp, #-64]!")
          (emit "    mov x29, sp")
          (emit "    stp x19, x20, [sp, #16]")
          (emit "    stp x21, x22, [sp, #32]")
