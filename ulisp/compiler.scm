  (AsmClause (asm_clause)
    (:outputs (asm_out ...))
    (:inputs (asm_in ...))
    (:clobbers (asm_clob ...))
    (:volatile? bool_val))
  (Inst (inst)
    ;; Pseudo / Raw-Only Instructions
    (%nop)

    ;; Debug & Source Location
