  (emit "    mov rax, r10")
  (emit "    and rax, 7")
  (emit "    test rax, rax")
  (emit "    jz .L_gc_do_copy_dual")
  (emit "    mov rax, r10")
  (emit "    and rax, -8")
  (emit "    mov r9, [r11 + 8]")
  (emit "    cmp rax, r9")
  (emit "    jb .L_gc_do_copy_dual")
  (emit "    cmp rax, [r11 + 40]")
  (emit "    jae .L_gc_do_copy_dual")
  (emit "    mov rax, r10")
  (emit "    ret")
  (emit ".L_gc_do_copy_dual:")
  (emit "    mov r9, [r11 + 40]")
  (emit "    mov rax, r10")
  (emit "    shr rax, 2")
  (emit "    shr rax, 16")
  (emit "    add rax, 8")
  (emit "    xor rcx, rcx")
  (emit ".L_gc_dual_copy_loop:")
  (emit "    cmp rcx, rax")
  (emit "    jae .L_gc_dual_copy_done")
  (emit "    mov r10, [r8 - 8 + rcx]")
  (emit "    mov [r9 + rcx], r10")
  (emit "    add rcx, 8")
  (emit "    jmp .L_gc_dual_copy_loop")
  (emit ".L_gc_dual_copy_done:")
  (emit "    lea r10, [r9 + 8]")
  (emit "    mov rcx, rdi")
  (emit "    and rcx, 7")
  (emit "    or r10, rcx")
  (emit "    mov [r8 - 8], r10")
  (emit "    add r9, rax")
  (emit "    mov [r11 + 40], r9")
  (emit "    mov rax, r10")
  (emit "    ret")
  (emit ".L_gc_ret_dual_orig:")
