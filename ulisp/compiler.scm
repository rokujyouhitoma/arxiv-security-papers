;;; -----------------------------------------------------------------------
;;; 4. L_lir_canonical: Canonical LIR (Post-Branch Fusion & Peephole)
;;; -----------------------------------------------------------------------
(define-language L_lir_canonical
  (extends L_lir_raw)
  (entry Program)
  (Inst (inst)
    (- (%nop))))
;;; =======================================================================
;;; ULisp Compiler: Canonical LIR Specification Verifier & Boundary Validator
;;; Conforms to DSN-33 Architecture Specification & Issue #589
;;; =======================================================================

(define *canonical-lir-registers*
  '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp
    %r8  %r9  %r10 %r11 %r12 %r13 %r14 %r15 %al))

(define *canonical-lir-float-registers*
  '(%xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
    %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15))

(define *canonical-lir-machine-types*
  '(i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 ptr raw-bits scheme-val))

(define *managed-dialect-opcodes*
  '(%alloc
    %alloc-stack
    %managed-alloc
    %managed-alloc-stack
    %managed-safepoint-poll
    %safepoint-poll
    %managed-write-barrier
    %managed-box
    %managed-unbox
    %box-fixnum
    %unbox-fixnum
    %box-flonum
    %unbox-flonum
    %capture-cc
    %push-handler
    %pop-handler
    %raise
    %set-values-count
    %store-values-buf))

(define (managed-dialect-opcode? op)
  (if (memq op *managed-dialect-opcodes*) #t #f))

(define (lir-machine-type? ty)
  (if (memq ty *canonical-lir-machine-types*) #t #f))

(define (lir-symbol-starts-with-percent? sym)
  (and (symbol? sym)
       (let ((str (symbol->string sym)))
         (and (> (string-length str) 1)
              (char=? (string-ref str 0) #\%)))))

(define (lir-float-register? reg)
  (cond
    ((memq reg *canonical-lir-float-registers*) #t)
    ((and (pair? reg) (eq? (car reg) '%reg) (pair? (cdr reg))
          (memq (cadr reg) *canonical-lir-float-registers*)) #t)
    ((and (pair? reg) (eq? (car reg) '%reg) (pair? (cdr reg)) (pair? (cddr reg))
          (memq (cadr reg) '(f32 f64))) #t)
    ((and (pair? reg) (eq? (car reg) '%freg) (pair? (cdr reg))) #t)
    (else #f)))

(define (lir-float-operand? opnd)
  (or (lir-float-register? opnd)
      (and (pair? opnd) (eq? (car opnd) '%mem))
      (and (pair? opnd) (eq? (car opnd) '%stack))
      (number? opnd)))

(define (lir-valid-register? reg)
  (cond
    ((memq reg *canonical-lir-registers*) #t)
    ((memq reg *canonical-lir-float-registers*) #t)
    ((and (pair? reg) (eq? (car reg) '%reg) (pair? (cdr reg)))
     (cond
       ((and (pair? (cddr reg)) (lir-machine-type? (cadr reg))) #t)
       ((memq (cadr reg) *canonical-lir-registers*) #t)
       ((memq (cadr reg) *canonical-lir-float-registers*) #t)
       (else (symbol? (cadr reg)))))
    ((and (pair? reg) (eq? (car reg) '%freg) (pair? (cdr reg)) (symbol? (cadr reg))) #t)
    (else #f)))

(define (lir-valid-sib? sib)
  (and (pair? sib)
       (eq? (car sib) '%sib)
       (= (length sib) 4)
       (lir-valid-register? (cadr sib))
       (integer? (caddr sib))
       (integer? (cadddr sib))))

(define (lir-valid-offset? off)
  (or (integer? off)
      (lir-valid-register? off)
      (lir-valid-sib? off)))

(define (lir-valid-lvalue? opnd)
  (cond
    ((lir-valid-register? opnd) #t)
    ((and (pair? opnd) (eq? (car opnd) '%stack) (pair? (cdr opnd))
          (integer? (cadr opnd))) #t)
    ((and (pair? opnd) (eq? (car opnd) '%mem) (pair? (cdr opnd)) (pair? (cddr opnd)))
     (and (lir-valid-register? (cadr opnd))
          (lir-valid-offset? (caddr opnd))))
    ((and (symbol? opnd) (not (lir-symbol-starts-with-percent? opnd))) #t)
    (else #f)))

(define (lir-valid-operand? opnd)
  (cond
    ((lir-valid-register? opnd) #t)
    ((integer? opnd) #t)
    ((and (symbol? opnd) (not (lir-symbol-starts-with-percent? opnd))) #t)
    ((and (pair? opnd) (eq? (car opnd) '%stack) (pair? (cdr opnd))
          (integer? (cadr opnd))) #t)
    ((and (pair? opnd) (eq? (car opnd) '%mem) (pair? (cdr opnd)) (pair? (cddr opnd)))
     (and (lir-valid-register? (cadr opnd))
          (lir-valid-offset? (caddr opnd))))
    (else #f)))

(define (lir-atomic-operand? opnd)
  (or (integer? opnd)
      (and (symbol? opnd) (not (lir-symbol-starts-with-percent? opnd)))
      (lir-valid-register? opnd)
      (and (pair? opnd) (eq? (car opnd) '%stack) (pair? (cdr opnd)) (integer? (cadr opnd)))))

(define (lir-report-error msg expr)
  (verifier-error 'canonical-lir msg expr))

;;; -----------------------------------------------------------------------
;;; %inline-asm Verification Helpers (Issue #838, THREAT-838-1..3)
;;; -----------------------------------------------------------------------
(define (lir-inline-asm-digit? ch)
  (let ((c (char->integer ch)))
    (and (>= c 48) (<= c 57))))

(define (lir-verify-inline-asm-template template total-opnds declared-names inst)
  (let ((len (string-length template)))
    (let loop ((i 0))
      (if (>= i len)
          #t
          (let ((ch (string-ref template i)))
            (if (not (char=? ch #\%))
                (loop (+ i 1))
                (if (>= (+ i 1) len)
                    (lir-report-error "Trailing '%' in %inline-asm template" inst)
                    (let ((c1 (string-ref template (+ i 1))))
                      (cond
                        ((char=? c1 #\%)
                         (loop (+ i 2)))
                        ((char=? c1 #\[)
                         (let find-close ((j (+ i 2)))
                           (cond
                             ((>= j len)
                              (lir-report-error "Unclosed '%[' named operand in %inline-asm template" inst))
                             ((char=? (string-ref template j) #\])
                              (if (= j (+ i 2))
                                  (lir-report-error "Empty '%[]' named operand in %inline-asm template" inst)
                                  (let ((nm (string->symbol (substring template (+ i 2) j))))
                                    (if (memq nm declared-names)
                                        (loop (+ j 1))
                                        (lir-report-error "Undefined named operand %[...] in %inline-asm template (THREAT-838-3)" inst)))))
                             (else (find-close (+ j 1))))))
                        ((lir-inline-asm-digit? c1)
                         (let scan-num ((j (+ i 1)) (idx 0))
                           (if (and (< j len) (lir-inline-asm-digit? (string-ref template j)))
                               (scan-num (+ j 1) (+ (* idx 10) (- (char->integer (string-ref template j)) 48)))
                               (if (< idx total-opnds)
                                   (loop j)
                                   (lir-report-error "Out-of-bounds %N operand reference in %inline-asm template (THREAT-838-3)" inst)))))
                        ((and (< (+ i 2) len)
                              (memv c1 '(#\b #\w #\k #\q #\h #\l #\c #\n))
                              (lir-inline-asm-digit? (string-ref template (+ i 2))))
                         (let scan-mod ((j (+ i 2)) (idx 0))
                           (if (and (< j len) (lir-inline-asm-digit? (string-ref template j)))
                               (scan-mod (+ j 1) (+ (* idx 10) (- (char->integer (string-ref template j)) 48)))
                               (if (< idx total-opnds)
                                   (loop j)
                                   (lir-report-error "Out-of-bounds modified %N operand reference in %inline-asm template (THREAT-838-3)" inst)))))
                        (else
                         (loop (+ i 2))))))))))))

(define (lir-verify-inline-asm-clauses-syntax clauses inst)
  (let loop ((cs clauses) (seen-keys '()))
    (if (null? cs)
        #t
        (let ((c (car cs)))
          (cond
            ((not (pair? c))
             (lir-report-error "%inline-asm clause must be a pair" inst))
            ((not (memq (car c) '(:outputs :inputs :clobbers :volatile?)))
             (lir-report-error "Unknown %inline-asm clause keyword" c))
            ((memq (car c) seen-keys)
             (lir-report-error "Duplicate %inline-asm clause keyword" c))
            ((eq? (car c) ':volatile?)
             (if (and (= (length c) 2) (boolean? (cadr c)))
                 (loop (cdr cs) (cons (car c) seen-keys))
                 (lir-report-error "%inline-asm :volatile? clause must be (:volatile? <bool>)" c)))
            (else
             (if (and (= (length c) 2) (list? (cadr c)))
                 (loop (cdr cs) (cons (car c) seen-keys))
                 (lir-report-error "%inline-asm list clause must be (:key (<entry> ...))" c))))))))

(define (lir-verify-inline-asm-outputs outs inst)
  (let loop ((os outs) (seen-regs '()) (names '()))
    (if (null? os)
        (cons seen-regs names)
        (let ((no (inline-asm-normalize-out-entry (car os))))
          (if (not no)
              (lir-report-error "%inline-asm output spec must be (<dst> <constraint>) or (<name> <constraint> <dst>)" (car os))
              (let ((name (car no))
                    (dst (cadr no))
                    (cstr (caddr no)))
                (cond
                  ((not (or (lir-valid-register? dst)
                            (and (symbol? dst) (not (lir-symbol-starts-with-percent? dst)))
                            (and (pair? dst) (eq? (car dst) '%stack)
                                 (pair? (cdr dst)) (integer? (cadr dst)))
                            (and (pair? dst) (eq? (car dst) '%mem) (lir-valid-operand? dst))))
                   (lir-report-error "%inline-asm output destination must be writable location or virtual register" (car os)))
                  ((eq? (inline-asm-normalize-reg-sym dst) '%rsp)
                   (lir-report-error "%inline-asm cannot write directly to stack pointer %rsp (THREAT-838-1)" (car os)))
                  (else
                   (let ((oc (inline-asm-parse-output-constraint cstr)))
                     (cond
                       ((not oc)
                        (lir-report-error "Invalid %inline-asm output constraint (THREAT-838-3)" (car os)))
                       ((and (eq? (car oc) '=reg) (eq? (cadr oc) '%rsp))
                        (lir-report-error "%inline-asm cannot constrain output to reserved %rsp (THREAT-838-1)" (car os)))
                       ((and (eq? (car oc) '=reg) (memq (cadr oc) seen-regs))
                        (lir-report-error "Duplicate fixed physical register in %inline-asm :outputs (THREAT-838-3)" (car os)))
                       (else
                        (let ((new-regs (if (eq? (car oc) '=reg) (cons (cadr oc) seen-regs) seen-regs))
                              (new-names (if (symbol? name) (cons name names) names)))
                          (loop (cdr os) new-regs new-names)))))))))))))

(define (lir-verify-inline-asm-inputs ins num-outs init-names inst)
  (let loop ((is ins) (seen-regs '()) (names init-names))
    (if (null? is)
        names
        (let ((ni (inline-asm-normalize-in-entry (car is))))
          (if (not ni)
              (lir-report-error "%inline-asm input spec must be (<src> <constraint>) or (<name> <constraint> <src>)" (car is))
              (let ((name (car ni))
                    (src (cadr ni))
                    (cstr (caddr ni)))
                (if (not (lir-valid-operand? src))
                    (lir-report-error "Invalid %inline-asm input operand" (car is))
                    (let ((ic (inline-asm-parse-input-constraint cstr num-outs)))
                      (cond
                        ((not ic)
                         (lir-report-error "Invalid or out-of-range %inline-asm input constraint (THREAT-838-3)" (car is)))
                        ((and (eq? (car ic) 'imm) (not (integer? src)))
                         (lir-report-error "%inline-asm immediate constraint ('i'/'n') requires integer operand" (car is)))
                        ((and (eq? (car ic) 'reg) (eq? (cadr ic) '%rsp) (not (eq? src '%rsp)))
                         (lir-report-error "%inline-asm cannot bind non-%rsp value to %rsp (THREAT-838-1)" (car is)))
                        ((and (eq? (car ic) 'reg) (memq (cadr ic) seen-regs))
                         (lir-report-error "Duplicate fixed physical register in %inline-asm :inputs (THREAT-838-3)" (car is)))
                        (else
                         (let ((new-regs (if (eq? (car ic) 'reg) (cons (cadr ic) seen-regs) seen-regs))
                               (new-names (if (symbol? name) (cons name names) names)))
                           (loop (cdr is) new-regs new-names))))))))))))

(define (lir-verify-inline-asm-clobbers clobs inst)
  (let loop ((cs clobs))
    (if (null? cs)
        #t
        (let ((cp (inline-asm-parse-clobber (car cs))))
          (cond
            ((not cp)
             (lir-report-error "Invalid %inline-asm :clobbers entry (THREAT-838-3)" (car cs)))
            ((eq? cp '%rsp)
             (lir-report-error "%inline-asm cannot clobber stack pointer %rsp (THREAT-838-1)" (car cs)))
            (else
             (loop (cdr cs))))))))

(define (lir-verify-inline-asm inst)
  (cond
    ((not (and (pair? (cdr inst)) (string? (cadr inst))))
     (lir-report-error "%inline-asm requires a template string as first operand" inst))
    ((not (lir-verify-inline-asm-clauses-syntax (cddr inst) inst))
     #f)
    (else
     (let* ((parsed (inline-asm-extract-clauses inst))
            (template (car parsed))
            (outs (cadr parsed))
            (ins (caddr parsed))
            (clobs (cadddr parsed))
            (out-res (lir-verify-inline-asm-outputs outs inst)))
       (if (not out-res)
           #f
           (let ((all-names (lir-verify-inline-asm-inputs ins (length outs) (cdr out-res) inst)))
             (if (not all-names)
                 #f
                 (and (lir-verify-inline-asm-clobbers clobs inst)
                      (lir-verify-inline-asm-template
                       template (+ (length outs) (length ins)) all-names inst)))))))))

;;; -----------------------------------------------------------------------
;;; Instruction-Level Validation
;;; -----------------------------------------------------------------------
(define (lir-valid-inst? inst)
  (if (not (pair? inst))
      (lir-report-error "Instruction must be a non-empty pair" inst)
      (let ((op (car inst)))
        (case op
          ;; Control Flow
          ((%label)
           (if (and (= (length inst) 2) (symbol? (cadr inst)))
               #t
               (lir-report-error "%label must have exactly 1 symbol operand" inst)))

          ((%block)
           (if (and (>= (length inst) 3)
                    (symbol? (cadr inst))
                    (list? (caddr inst)))
               (let p-loop ((ps (caddr inst)))
                 (if (null? ps)
                     (let b-loop ((body (cdddr inst)))
                       (if (null? body)
                           #t
                           (and (lir-valid-inst? (car body))
                                (b-loop (cdr body)))))
                     (if (symbol? (car ps))
                         (p-loop (cdr ps))
                         (lir-report-error "%block parameter must be a symbol" (car ps)))))
               (lir-report-error "%block must be (%block <label-sym> (<param-syms>...) <insts>...)" inst)))

          ((%jump)
           (cond
             ((= (length inst) 2)
              (if (symbol? (cadr inst)) #t
                  (lir-report-error "%jump target must be a label symbol" inst)))
             ((= (length inst) 3)
              (if (and (symbol? (cadr inst)) (list? (caddr inst)))
                  (let a-loop ((as (caddr inst)))
                    (if (null? as) #t
                        (if (lir-atomic-operand? (car as))
                            (a-loop (cdr as))
                            (lir-report-error "%jump argument must be an atomic operand" (car as)))))
                  (lir-report-error "%jump format must be (%jump <lbl> (<args>...))" inst)))
             (else
              (lir-report-error "Invalid %jump arity" inst))))

          ((%jump-if-false)
           (cond
             ((= (length inst) 3)
              (if (and (lir-valid-register? (cadr inst)) (symbol? (caddr inst))) #t
                  (lir-report-error "%jump-if-false must have register and label symbol" inst)))
             ((= (length inst) 4)
              (if (and (lir-valid-register? (cadr inst))
                       (symbol? (caddr inst))
                       (list? (cadddr inst)))
                  (let a-loop ((as (cadddr inst)))
                    (if (null? as) #t
                        (if (lir-atomic-operand? (car as))
                            (a-loop (cdr as))
                            (lir-report-error "%jump-if-false argument must be atomic" (car as)))))
                  (lir-report-error "%jump-if-false format must be (%jump-if-false <reg> <lbl> (<args>...))" inst)))
             (else
              (lir-report-error "Invalid %jump-if-false arity" inst))))

          ((%jump-if)
           ;; Format: (%jump-if <reg> <then-lbl> (<then-args>...) <else-lbl> (<else-args>...))
           (if (and (= (length inst) 6)
                    (lir-valid-register? (cadr inst))
                    (symbol? (caddr inst))
                    (list? (cadddr inst))
                    (symbol? (car (cddddr inst)))
                    (list? (cadr (cddddr inst))))
               (and (let a-loop ((as (cadddr inst)))
                      (if (null? as) #t
                          (if (lir-atomic-operand? (car as))
                              (a-loop (cdr as))
                              (lir-report-error "%jump-if then-argument must be atomic" (car as)))))
                    (let b-loop ((as (cadr (cddddr inst))))
                      (if (null? as) #t
                          (if (lir-atomic-operand? (car as))
                              (b-loop (cdr as))
                              (lir-report-error "%jump-if else-argument must be atomic" (car as))))))
               (lir-report-error "%jump-if format must be (%jump-if <reg> <t_lbl> (<ta>...) <e_lbl> (<ea>...))" inst)))

          ((%jump-cond)
           (if (and (= (length inst) 3)
                    (or (symbol? (cadr inst)) (string? (cadr inst)))
                    (symbol? (caddr inst)))
               #t
               (lir-report-error "%jump-cond format must be (%jump-cond <cond-op> <lbl>)" inst)))

          ((%jump-if-zero)
           (if (and (= (length inst) 2) (symbol? (cadr inst)))
               #t
               (lir-report-error "%jump-if-zero format must be (%jump-if-zero <lbl>)" inst)))

          ((%direct-jump)
           (if (and (= (length inst) 2) (symbol? (cadr inst)))
               #t
               (lir-report-error "%direct-jump format must be (%direct-jump <lbl>)" inst)))

          ((%switch)
           ;; Format: (%switch <val> <def-lbl> (<def-args>...) ((<case-val> <case-lbl> (<case-args>...))...))
           ;; or:     (%switch <val> <def-lbl> ((<case-val> <case-lbl>)...))
           (cond
             ((= (length inst) 4)
              (if (and (lir-valid-operand? (cadr inst))
                       (symbol? (caddr inst))
                       (list? (cadddr inst)))
                  (let c-loop ((cs (cadddr inst)))
                    (if (null? cs) #t
                        (let ((c (car cs)))
                          (if (and (list? c) (= (length c) 2)
                                   (lir-valid-operand? (car c))
                                   (symbol? (cadr c)))
                              (c-loop (cdr cs))
                              (lir-report-error "Invalid switch case format in %switch" c)))))
                  (lir-report-error "Invalid 4-argument %switch format" inst)))
             ((= (length inst) 5)
              (if (and (lir-valid-operand? (cadr inst))
                       (symbol? (caddr inst))
                       (list? (cadddr inst))
                       (list? (car (cddddr inst))))
                  (and (let a-loop ((as (cadddr inst)))
                         (if (null? as) #t
                             (if (lir-atomic-operand? (car as))
                                 (a-loop (cdr as))
                                 (lir-report-error "%switch default argument must be atomic" (car as)))))
                       (let c-loop ((cs (car (cddddr inst))))
                         (if (null? cs) #t
                             (let ((c (car cs)))
                               (if (and (list? c) (= (length c) 3)
                                        (lir-valid-operand? (car c))
                                        (symbol? (cadr c))
                                        (list? (caddr c)))
                                   (let ca-loop ((cas (caddr c)))
                                     (if (null? cas)
                                         (c-loop (cdr cs))
                                         (if (lir-atomic-operand? (car cas))
                                             (ca-loop (cdr cas))
                                             (lir-report-error "%switch case argument must be atomic" (car cas)))))
                                   (lir-report-error "Invalid switch case with arguments format in %switch" c))))))
                  (lir-report-error "Invalid 5-argument %switch format" inst)))
             (else
              (lir-report-error "Invalid %switch arity" inst))))

          ((%return)
           (if (or (= (length inst) 1)
                   (and (= (length inst) 2) (lir-valid-operand? (cadr inst))))
               #t
               (lir-report-error "Invalid %return instruction format" inst)))

          ;; Calls & ABI
          ((%c-call %call-foreign)
           (if (or (and (= (length inst) 3)
                        (or (symbol? (cadr inst)) (string? (cadr inst)))
                        (integer? (caddr inst)))
                   (and (= (length inst) 4)
                        (or (symbol? (cadr inst)) (string? (cadr inst)))
                        (integer? (caddr inst))
                        (or (integer? (cadddr inst)) (not (cadddr inst)))))
               #t
               (lir-report-error "%c-call / %call-foreign format must be (%c-call <fn-name> <shift> [<al-val>])" inst)))

          ((%call-indirect)
           (if (or (and (= (length inst) 3)
                        (lir-valid-register? (cadr inst))
                        (integer? (caddr inst)))
                   (and (= (length inst) 4)
                        (lir-valid-register? (cadr inst))
                        (integer? (caddr inst))
                        (or (integer? (cadddr inst)) (not (cadddr inst)))))
               #t
               (lir-report-error "%call-indirect format must be (%call-indirect <reg> <shift> [<al-val>])" inst)))

          ((%call-closure)
           (if (or (and (= (length inst) 2) (integer? (cadr inst)))
                   (and (= (length inst) 3) (integer? (cadr inst))
                        (or (symbol? (caddr inst)) (string? (caddr inst)) (not (caddr inst)))))
               #t
               (lir-report-error "%call-closure format must be (%call-closure <shift> [<safepoint>])" inst)))

          ((%direct-call)
           (if (or (and (= (length inst) 3) (or (symbol? (cadr inst)) (string? (cadr inst))) (integer? (caddr inst)))
                   (and (= (length inst) 4) (or (symbol? (cadr inst)) (string? (cadr inst))) (integer? (caddr inst))
                        (or (symbol? (cadddr inst)) (string? (cadddr inst)) (not (cadddr inst)))))
               #t
               (lir-report-error "%direct-call format must be (%direct-call <lbl> <shift> [<safepoint>])" inst)))

          ((%dispatch-consumer)
           (if (and (= (length inst) 4)
                    (integer? (cadr inst))
                    (integer? (caddr inst))
                    (integer? (cadddr inst)))
               #t
               (lir-report-error "%dispatch-consumer format must be (%dispatch-consumer <c-si> <a-si> <shift>)" inst)))

          ;; Memory & Data Transfer
          ((%mov)
           (if (and (= (length inst) 3)
                    (lir-valid-lvalue? (cadr inst))
                    (lir-valid-operand? (caddr inst)))
               #t
               (lir-report-error "%mov format must be (%mov <dst> <src>)" inst)))

          ((%load)
           (if (and (= (length inst) 4)
                    (lir-valid-register? (cadr inst))
                    (lir-valid-register? (caddr inst))
                    (lir-valid-offset? (cadddr inst)))
               #t
               (lir-report-error "%load format must be (%load <dst-reg> <base-reg> <offset>)" inst)))

          ((%store)
           (if (and (= (length inst) 4)
                    (lir-valid-register? (cadr inst))
                    (lir-valid-offset? (caddr inst))
                    (lir-valid-operand? (cadddr inst)))
               #t
               (lir-report-error "%store format must be (%store <base-reg> <offset> <src>)" inst)))

          ((%load-byte-zx)
           (if (and (= (length inst) 4)
                    (lir-valid-register? (cadr inst))
                    (lir-valid-register? (caddr inst))
                    (lir-valid-offset? (cadddr inst)))
               #t
               (lir-report-error "%load-byte-zx format must be (%load-byte-zx <dst> <base> <offset>)" inst)))

          ((%store-byte)
           (if (and (= (length inst) 4)
                    (lir-valid-register? (cadr inst))
                    (lir-valid-offset? (caddr inst))
                    (or (lir-valid-register? (cadddr inst)) (integer? (cadddr inst))))
               #t
               (lir-report-error "%store-byte format must be (%store-byte <base> <offset> <src>)" inst)))

          ((%push)
           (if (and (= (length inst) 2) (lir-valid-register? (cadr inst)))
               #t
               (lir-report-error "%push format must be (%push <reg>)" inst)))

          ((%pop)
           (if (and (= (length inst) 2) (lir-valid-register? (cadr inst)))
               #t
               (lir-report-error "%pop format must be (%pop <reg>)" inst)))

          ((%code-ref)
           (if (and (= (length inst) 3)
                    (lir-valid-register? (cadr inst))
                    (symbol? (caddr inst)))
               #t
               (lir-report-error "%code-ref format must be (%code-ref <dst> <lbl>)" inst)))

          ((%str-ref)
           (if (and (= (length inst) 3)
                    (lir-valid-register? (cadr inst))
                    (symbol? (caddr inst)))
               #t
               (lir-report-error "%str-ref format must be (%str-ref <dst> <lbl>)" inst)))

          ((%global-ref)
           (if (and (= (length inst) 3)
                    (lir-valid-register? (cadr inst))
                    (symbol? (caddr inst)))
               #t
               (lir-report-error "%global-ref format must be (%global-ref <reg> <var-sym>)" inst)))

          ((%global-addr)
           (if (and (= (length inst) 3)
                    (lir-valid-register? (cadr inst))
                    (symbol? (caddr inst)))
               #t
               (lir-report-error "%global-addr format must be (%global-addr <reg> <var-sym>)" inst)))

          ((%global-set!)
           (if (and (= (length inst) 3)
                    (symbol? (cadr inst))
                    (lir-valid-register? (caddr inst)))
               #t
               (lir-report-error "%global-set! format must be (%global-set! <var-sym> <reg>)" inst)))

          ;; Arithmetic / Logic / Primitives
          ((%add %raw-add %sub %raw-sub %imul %raw-mul %bit-and %bit-or %bit-xor %cmp %raw-cmp)
           (if (and (= (length inst) 3)
                    (lir-valid-operand? (cadr inst))
                    (lir-valid-operand? (caddr inst)))
               #t
               (lir-report-error (string-append (symbol->string op) " must have exactly 2 valid operands") inst)))

          ((%neg %inc)
           (if (and (= (length inst) 2) (lir-valid-operand? (cadr inst)))
               #t
               (lir-report-error (string-append (symbol->string op) " must have 1 operand") inst)))

          ((%shl %sar)
           (if (and (= (length inst) 3)
                    (lir-valid-operand? (cadr inst))
                    (not (lir-float-register? (cadr inst)))
                    (or (integer? (caddr inst)) (eq? (caddr inst) '%rcx)))
               #t
               (lir-report-error (string-append (symbol->string op) " shift count must be an integer or %rcx") inst)))

          ((%shr)
           (cond
             ((and (= (length inst) 3)
                   (lir-valid-operand? (cadr inst))
                   (not (lir-float-register? (cadr inst)))
                   (or (integer? (caddr inst)) (eq? (caddr inst) '%rcx)))
              #t)
             ((and (= (length inst) 4)
                   (lir-valid-register? (cadr inst))
                   (not (lir-float-register? (cadr inst)))
                   (lir-valid-operand? (caddr inst))
                   (not (lir-float-register? (caddr inst)))
                   (or (integer? (cadddr inst)) (eq? (cadddr inst) '%rcx)))
              #t)
             ((or (lir-float-register? (cadr inst))
                  (and (= (length inst) 4) (lir-float-register? (caddr inst))))
              (lir-report-error "%shr operands cannot be float registers (CWE-843 defense)" inst))
             (else
              (lir-report-error "%shr format must be (%shr <opnd> <count>) or (%shr <dst-reg> <src-opnd> <count>)" inst))))

          ((%cqo %raise %memory-fence)
           (if (= (length inst) 1)
               #t
               (lir-report-error (string-append (symbol->string op) " takes zero operands") inst)))

          ((%syscall)
           (if (or (= (length inst) 1)
                   (and (= (length inst) 2) (integer? (cadr inst))))
               #t
               (lir-report-error "%syscall format must be (%syscall) or (%syscall <si>)" inst)))

          ((%atomic-cas!)
           (if (and (= (length inst) 4)
                    (lir-valid-register? (cadr inst))
                    (lir-valid-register? (caddr inst))
                    (lir-valid-register? (cadddr inst)))
               #t
               (lir-report-error "%atomic-cas! format must be (%atomic-cas! <dst-reg> <box-reg> <new-reg>)" inst)))

          ((%inline-asm)
           (lir-verify-inline-asm inst))

          ((%idiv)
           (if (and (= (length inst) 2) (lir-valid-operand? (cadr inst)))
               #t
               (lir-report-error "%idiv takes 1 operand" inst)))

          ((%udiv %urem)
           (cond
             ((and (= (length inst) 2)
                   (lir-valid-operand? (cadr inst))
                   (not (lir-float-register? (cadr inst))))
              #t)
             ((and (= (length inst) 4)
                   (lir-valid-register? (cadr inst))
                   (not (lir-float-register? (cadr inst)))
                   (lir-valid-operand? (caddr inst))
                   (not (lir-float-register? (caddr inst)))
                   (lir-valid-operand? (cadddr inst))
                   (not (lir-float-register? (cadddr inst))))
              #t)
             ((or (and (>= (length inst) 2) (lir-float-register? (cadr inst)))
                  (and (>= (length inst) 3) (lir-float-register? (caddr inst)))
                  (and (>= (length inst) 4) (lir-float-register? (cadddr inst))))
              (lir-report-error (string-append (symbol->string op) " operands must be integer operands (CWE-843 defense)") inst))
             (else
              (lir-report-error (string-append (symbol->string op) " format must be (op <src>) or (op <dst> <src1> <src2>)") inst))))

          ((%add-overflow %sub-overflow %mul-overflow)
           (if (not (= (length inst) 5))
               (lir-report-error (string-append (symbol->string op) " format must be (op <dst-val> <dst-flag> <src1> <src2>)") inst)
               (let ((dst-val (cadr inst))
                     (dst-flag (caddr inst))
                     (src1 (cadddr inst))
                     (src2 (car (cddddr inst))))
                 (cond
                   ((or (lir-float-register? dst-val) (lir-float-register? dst-flag)
                        (lir-float-register? src1) (lir-float-register? src2))
                    (lir-report-error (string-append (symbol->string op) " operands must be general-purpose integer registers/operands (CWE-843 defense)") inst))
                   ((not (lir-valid-register? dst-val))
                    (lir-report-error (string-append (symbol->string op) " dst-val must be a valid general-purpose register") inst))
                   ((not (lir-valid-register? dst-flag))
                    (lir-report-error (string-append (symbol->string op) " dst-flag must be a valid general-purpose register") inst))
                   ((equal? dst-val dst-flag)
                    (lir-report-error (string-append (symbol->string op) " dst-val and dst-flag registers must be distinct (non-destructive flag output)") inst))
                   ((not (lir-valid-operand? src1))
                    (lir-report-error (string-append (symbol->string op) " src1 must be a valid operand") inst))
                   ((not (lir-valid-operand? src2))
                    (lir-report-error (string-append (symbol->string op) " src2 must be a valid operand") inst))
                   (else #t)))))

          ((%setb %setbe %seta %setae)
           (cond
             ((and (= (length inst) 2)
                   (lir-valid-register? (cadr inst))
                   (not (lir-float-register? (cadr inst))))
              #t)
             ((and (= (length inst) 4)
                   (lir-valid-register? (cadr inst))
                   (not (lir-float-register? (cadr inst)))
                   (lir-valid-operand? (caddr inst))
                   (not (lir-float-register? (caddr inst)))
                   (lir-valid-operand? (cadddr inst))
                   (not (lir-float-register? (cadddr inst))))
              #t)
             ((or (and (>= (length inst) 2) (lir-float-register? (cadr inst)))
                  (and (>= (length inst) 3) (lir-float-register? (caddr inst)))
                  (and (>= (length inst) 4) (lir-float-register? (cadddr inst))))
              (lir-report-error (string-append (symbol->string op) " operands must be general-purpose registers/operands (CWE-843 defense)") inst))
             (else
              (lir-report-error (string-append (symbol->string op) " format must be (op <dst-reg>) or (op <dst-reg> <src1> <src2>)") inst))))

          ((%set-boolean)
           (if (and (= (length inst) 3)
                    (lir-valid-operand? (cadr inst))
                    (or (symbol? (caddr inst)) (string? (caddr inst))))
               #t
               (lir-report-error "%set-boolean format must be (%set-boolean <dst> <cc>)" inst)))

          ((%box-fixnum %unbox-fixnum)
           (if (and (= (length inst) 3)
                    (lir-valid-operand? (cadr inst))
                    (lir-valid-operand? (caddr inst)))
               #t
               (lir-report-error (string-append (symbol->string op) " format must be (op <dst> <src>)") inst)))

          ;; Typed Machine LIR: Memory & Conversions (Issue #826)
          ((%load-typed)
           (if (and (= (length inst) 5)
                    (lir-machine-type? (cadr inst))
                    (lir-valid-register? (caddr inst))
                    (lir-valid-register? (cadddr inst))
                    (lir-valid-offset? (car (cddddr inst))))
               (if (and (memq (cadr inst) '(f32 f64))
                        (not (lir-float-register? (caddr inst))))
                   (lir-report-error "%load-typed float type requires float destination register" inst)
                   #t)
               (lir-report-error "%load-typed format must be (%load-typed <mty> <dst-reg> <base-reg> <offset>)" inst)))

          ((%store-typed)
           (if (and (= (length inst) 5)
                    (lir-machine-type? (cadr inst))
                    (lir-valid-register? (caddr inst))
                    (lir-valid-offset? (cadddr inst))
                    (lir-valid-operand? (car (cddddr inst))))
               (if (and (memq (cadr inst) '(f32 f64))
                        (not (lir-float-operand? (car (cddddr inst)))))
                   (lir-report-error "%store-typed float type requires float source operand" inst)
                   #t)
               (lir-report-error "%store-typed format must be (%store-typed <mty> <base-reg> <offset> <src-opnd>)" inst)))

          ((%fmov)
           (if (and (= (length inst) 3)
                    (lir-float-register? (cadr inst))
                    (lir-float-operand? (caddr inst)))
               #t
               (lir-report-error "%fmov format must be (%fmov <dst-freg> <src-fopnd>)" inst)))

          ((%fadd %fsub %fmul %fdiv %fcmp)
           (if (and (= (length inst) 3)
                    (lir-float-register? (cadr inst))
                    (lir-float-operand? (caddr inst)))
               #t
               (lir-report-error (string-append (symbol->string op) " operands must be floating-point registers/operands (CWE-843 defense)") inst)))

          ((%box-flonum %unbox-flonum)
           (if (and (= (length inst) 3)
                    (lir-valid-operand? (cadr inst))
                    (lir-valid-operand? (caddr inst)))
               #t
               (lir-report-error (string-append (symbol->string op) " format must be (op <dst> <src>)") inst)))

          ((%fneg)
           (if (and (= (length inst) 4)
                    (memq (cadr inst) '(f32 f64))
                    (lir-float-register? (caddr inst))
                    (lir-float-operand? (cadddr inst)))
               #t
               (lir-report-error "%fneg format must be (%fneg <f32|f64> <dst-freg> <src-fopnd>)" inst)))

          ((%fpext)
           (if (and (= (length inst) 4)
                    (eq? (cadr inst) 'f64)
                    (lir-float-register? (caddr inst))
                    (lir-float-operand? (cadddr inst)))
               #t
               (lir-report-error "%fpext format must be (%fpext f64 <dst-freg> <src-fopnd>)" inst)))

          ((%fptrunc)
           (if (and (= (length inst) 4)
                    (eq? (cadr inst) 'f32)
                    (lir-float-register? (caddr inst))
                    (lir-float-operand? (cadddr inst)))
               #t
               (lir-report-error "%fptrunc format must be (%fptrunc f32 <dst-freg> <src-fopnd>)" inst)))

          ((%sitofp)
           (if (and (= (length inst) 3)
                    (lir-float-register? (cadr inst))
                    (lir-valid-operand? (caddr inst)))
               #t
               (lir-report-error "%sitofp format must be (%sitofp <dst-freg> <src-gpr>)" inst)))

          ((%uitofp)
           (if (and (= (length inst) 3)
                    (lir-float-register? (cadr inst))
                    (lir-valid-operand? (caddr inst))
                    (not (lir-float-register? (caddr inst))))
               #t
               (lir-report-error "%uitofp format must be (%uitofp <dst-freg> <src-gpr>)" inst)))

          ((%fptosi)
           (if (and (= (length inst) 3)
                    (lir-valid-register? (cadr inst))
                    (not (lir-float-register? (cadr inst)))
                    (lir-float-operand? (caddr inst)))
               #t
               (lir-report-error "%fptosi format must be (%fptosi <dst-gpr> <src-freg>)" inst)))

          ((%fptoui)
           (if (and (= (length inst) 3)
                    (lir-valid-register? (cadr inst))
                    (not (lir-float-register? (cadr inst)))
                    (lir-float-operand? (caddr inst)))
               #t
               (lir-report-error "%fptoui format must be (%fptoui <dst-gpr> <src-freg>)" inst)))

          ((%fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge)
           (if (and (= (length inst) 4)
                    (lir-valid-register? (cadr inst))
                    (not (lir-float-register? (cadr inst)))
                    (lir-float-register? (caddr inst))
                    (lir-float-operand? (cadddr inst)))
               #t
               (lir-report-error (string-append (symbol->string op) " format must be (op <dst-gpr> <lhs-freg> <rhs-fopnd>)") inst)))

          ((%trunc %zext %sext)
           (if (and (= (length inst) 4)
                    (lir-machine-type? (cadr inst))
                    (lir-valid-register? (caddr inst))
                    (lir-valid-operand? (cadddr inst)))
               #t
               (lir-report-error (string-append (symbol->string op) " format must be (op <mty> <dst> <src>)") inst)))

          ;; Runtime / GC / CC / Values
          ((%alloc)
           (if (and (or (= (length inst) 4) (= (length inst) 5))
                    (lir-valid-operand? (cadr inst))
                    (integer? (caddr inst))
                    (integer? (cadddr inst)))
               #t
               (lir-report-error "%alloc format must be (%alloc <dst> <bytes> <tag> [<si>])" inst)))

          ((%alloc-stack)
           (if (and (= (length inst) 4)
                    (lir-valid-operand? (cadr inst))
                    (integer? (caddr inst))
                    (integer? (cadddr inst)))
               #t
               (lir-report-error "%alloc-stack format must be (%alloc-stack <dst> <offset> <tag>)" inst)))

          ((%capture-cc)
           (if (and (= (length inst) 3)
                    (symbol? (cadr inst))
                    (integer? (caddr inst)))
               #t
               (lir-report-error "%capture-cc format must be (%capture-cc <ret-lbl> <k-si>)" inst)))

          ((%push-handler)
           (if (and (= (length inst) 4)
                    (symbol? (cadr inst))
                    (integer? (caddr inst))
                    (integer? (cadddr inst)))
               #t
               (lir-report-error "%push-handler format must be (%push-handler <catch-lbl> <f-si> <h-si>)" inst)))

          ((%pop-handler)
           (if (and (= (length inst) 2) (integer? (cadr inst)))
               #t
               (lir-report-error "%pop-handler format must be (%pop-handler <f-si>)" inst)))

          ((%set-values-count)
           (if (and (= (length inst) 2) (integer? (cadr inst)))
               #t
               (lir-report-error "%set-values-count takes 1 integer operand" inst)))

          ((%store-values-buf)
           (if (and (= (length inst) 3) (integer? (cadr inst)) (integer? (caddr inst)))
               #t
               (lir-report-error "%store-values-buf takes base-si and count integers" inst)))

          (else
           (lir-report-error (string-append "Unknown Canonical LIR opcode: "
                                            (if (symbol? op) (symbol->string op) "?"))
                             inst))))))

;;; -----------------------------------------------------------------------
;;; Lightweight Symbol Hash Set & Hash Table for O(1) Fast CFG Verification
;;; -----------------------------------------------------------------------
;;; NOTE (self-hosting constraints): this file is compiled by the ulisp
;;; compiler itself during bootstrap, so it must avoid variadic parameter
;;; lists, internal defines, `max`, and the 2-argument form of `make-vector`.
(define (lir-max2 a b) (if (> a b) a b))

(define (lir-symbol-hash-str str)
  (let ((len (string-length str)))
    (let loop ((i 0) (h 5381))
      (if (= i len)
          (modulo h 16777213)
          (let ((c (char->integer (string-ref str i))))
            (loop (+ i 1)
                  (modulo (+ (* h 33) c) 16777213)))))))

(define (lir-make-bucket-vector size)
  (let* ((n (lir-max2 16 size))
         (v (make-vector n)))
    (let loop ((i 0))
      (if (= i n)
          v
          (begin
            (vector-set! v i '())
            (loop (+ i 1)))))))

(define (make-symbol-hash-set size)
  (lir-make-bucket-vector size))

(define (symbol-hash-bucket-index sym size)
  (let ((str (if (symbol? sym) (symbol->string sym) "")))
    (modulo (lir-symbol-hash-str str) size)))

(define (symbol-hash-set-add! set sym)
  (let* ((idx (symbol-hash-bucket-index sym (vector-length set)))
         (bucket (vector-ref set idx)))
    (if (memq sym bucket)
        #f
        (begin
          (vector-set! set idx (cons sym bucket))
          #t))))

(define (symbol-hash-set-contains? set sym)
  (let* ((idx (symbol-hash-bucket-index sym (vector-length set)))
         (bucket (vector-ref set idx)))
    (if (memq sym bucket) #t #f)))

(define (make-symbol-hash-table size)
  (lir-make-bucket-vector size))

(define (symbol-hash-table-put! tbl sym val)
  (let* ((idx (symbol-hash-bucket-index sym (vector-length tbl)))
         (bucket (vector-ref tbl idx))
         (entry (assq sym bucket)))
    (if entry
        (set-cdr! entry val)
        (vector-set! tbl idx (cons (cons sym val) bucket)))))

(define (symbol-hash-table-ref tbl sym default)
  (let* ((idx (symbol-hash-bucket-index sym (vector-length tbl)))
         (bucket (vector-ref tbl idx))
         (entry (assq sym bucket)))
    (if entry (cdr entry) default)))

;;; -----------------------------------------------------------------------
;;; Single-Pass Instruction Verification and CFG Target Resolution (O(N))
;;; -----------------------------------------------------------------------
;;; state = (label-set block-arity-tbl pending-jumps-cell fn-name)

(define (lir-sp-push-jump! pending entry)
  (set-car! pending (cons entry (car pending))))

(define (lir-sp-queue-jump! inst pending)
  (case (car inst)
    ((%jump)
     (let ((args (if (pair? (cddr inst)) (caddr inst) '())))
       (lir-sp-push-jump! pending (list '%jump (cadr inst) (length args) inst))))
    ((%jump-if-false)
     (let ((args (if (pair? (cdddr inst)) (cadddr inst) '())))
       (lir-sp-push-jump! pending (list '%jump-if-false (caddr inst)
                                        (if (pair? args) (length args) #f) inst))))
    ((%jump-if)
     (let ((then-args (cadddr inst))
           (else-args (cadr (cddddr inst))))
       (lir-sp-push-jump! pending (list '%jump-if (caddr inst)
                                        (if (pair? then-args) (length then-args) #f)
                                        inst
                                        (car (cddddr inst))
                                        (if (pair? else-args) (length else-args) #f)))))
    ((%jump-cond)
     (lir-sp-push-jump! pending (list '%jump-cond (caddr inst) #f inst)))
    ((%jump-if-zero)
     (lir-sp-push-jump! pending (list '%jump-if-zero (cadr inst) #f inst)))
    ((%direct-jump)
     (lir-sp-push-jump! pending (list '%direct-jump (cadr inst) #f inst)))
    ((%switch)
     (let* ((def-lbl (caddr inst))
            (def-args (if (and (= (length inst) 5) (list? (cadddr inst))) (cadddr inst) '()))
            (cases (if (= (length inst) 5) (car (cddddr inst)) (cadddr inst))))
       (lir-sp-push-jump! pending (list '%jump def-lbl (if (list? def-args) (length def-args) #f) inst))
       (for-each
        (lambda (c)
          (let ((c-lbl (cadr c))
                (c-args (if (and (= (length c) 3) (list? (caddr c))) (caddr c) '())))
            (lir-sp-push-jump! pending (list '%jump c-lbl (if (list? c-args) (length c-args) #f) inst))))
        cases)))
    (else #t)))

(define (lir-sp-check-block-params params)
  (if (null? params)
      #t
      (if (symbol? (car params))
          (lir-sp-check-block-params (cdr params))
          (lir-report-error "%block parameter must be a symbol" (car params)))))

;; Step 1: single traversal validating syntax, collecting labels & arities,
;; and queuing jump targets for post-pass resolution.
(define (lir-sp-scan insts label-set arity-tbl pending fn-name)
  (if (null? insts)
      #t
      (let ((inst (car insts)))
        (cond
          ((not (pair? inst))
           (lir-report-error "Instruction must be a non-empty pair" inst))
          ((eq? (car inst) '%label)
           (cond
             ((not (and (= (length inst) 2) (symbol? (cadr inst))))
              (lir-report-error "%label must have exactly 1 symbol operand" inst))
             ((not (symbol-hash-set-add! label-set (cadr inst)))
              (lir-report-error "Duplicate label definition within function" (cadr inst)))
             (else
              (lir-sp-scan (cdr insts) label-set arity-tbl pending fn-name))))
          ((eq? (car inst) '%block)
           (cond
             ((not (and (>= (length inst) 3) (symbol? (cadr inst)) (list? (caddr inst))))
              (lir-report-error "%block must be (%block <label-sym> (<param-syms>...) <insts>...)" inst))
             ((not (symbol-hash-set-add! label-set (cadr inst)))
              (lir-report-error "Duplicate block label definition within function" (cadr inst)))
             ((not (lir-sp-check-block-params (caddr inst))) #f)
             (else
              (let ((lbl (cadr inst)))
                (symbol-hash-table-put! arity-tbl lbl (length (caddr inst)))
                (and (with-verifier-context
                      (list (cons 'phase 'canonical-lir) (cons 'function fn-name) (cons 'block lbl))
                      (lambda () (lir-sp-scan (cdddr inst) label-set arity-tbl pending fn-name)))
                     (lir-sp-scan (cdr insts) label-set arity-tbl pending fn-name))))))
          ((not (lir-valid-inst? inst)) #f)
          (else
           (lir-sp-queue-jump! inst pending)
           (lir-sp-scan (cdr insts) label-set arity-tbl pending fn-name))))))

(define (lir-sp-target-known? target label-set known-fn-set)
  (or (symbol-hash-set-contains? label-set target)
      (symbol-hash-set-contains? known-fn-set target)))

(define (lir-sp-arity-mismatch? target argc arity-tbl)
  (and argc
       (let ((expected (symbol-hash-table-ref arity-tbl target #f)))
         (and expected (not (= argc expected))))))

;; Step 2: post-pass target resolution in O(1) per jump.
(define (lir-sp-resolve jumps label-set known-fn-set arity-tbl)
  (if (null? jumps)
      #t
      (let* ((j (car jumps))
             (kind (car j))
             (target (cadr j))
             (argc (caddr j))
             (inst (cadddr j)))
        (cond
          ((not (lir-sp-target-known? target label-set known-fn-set))
           (cond
             ((eq? kind '%jump)
              (lir-report-error "Undefined jump target label" target))
             ((eq? kind '%jump-if-false)
              (lir-report-error "Undefined jump target in %jump-if-false" target))
             ((eq? kind '%jump-if)
              (lir-report-error "Undefined then-target in %jump-if" target))
             (else
              (lir-report-error "Undefined jump condition target" target))))
          ((lir-sp-arity-mismatch? target argc arity-tbl)
           (cond
             ((eq? kind '%jump-if-false)
              (lir-report-error "%jump-if-false argument count mismatch with %block" inst))
             ((eq? kind '%jump-if)
              (lir-report-error "%jump-if then-argument count mismatch with %block" inst))
             (else
              (lir-report-error "Jump argument count does not match %block parameter count" inst))))
          ((eq? kind '%jump-if)
           (let ((else-target (car (cddddr j)))
                 (else-argc (cadr (cddddr j))))
             (cond
               ((not (lir-sp-target-known? else-target label-set known-fn-set))
                (lir-report-error "Undefined else-target in %jump-if" else-target))
               ((lir-sp-arity-mismatch? else-target else-argc arity-tbl)
                (lir-report-error "%jump-if else-argument count mismatch with %block" inst))
               (else
                (lir-sp-resolve (cdr jumps) label-set known-fn-set arity-tbl)))))
          (else
           (lir-sp-resolve (cdr jumps) label-set known-fn-set arity-tbl))))))

(define (lir-verify-insts-single-pass insts known-fn-set fn-name)
  (let ((label-set (make-symbol-hash-set 128))
        (arity-tbl (make-symbol-hash-table 128))
        (pending (cons '() '())))
    (and (lir-sp-scan insts label-set arity-tbl pending fn-name)
         (lir-sp-resolve (reverse (car pending)) label-set known-fn-set arity-tbl))))

;;; Backward-compatibility wrappers for tests and legacy callers
(define (lir-collect-labels-and-params insts)
  (let loop ((is insts) (labels '()) (block-params '()))
    (if (null? is)
        (cons labels block-params)
        (let ((inst (car is)))
          (cond
            ((and (pair? inst) (eq? (car inst) '%label))
             (let ((lbl (cadr inst)))
               (if (memq lbl labels)
                   (begin
                     (lir-report-error "Duplicate label definition within function" lbl)
                     #f)
                   (loop (cdr is) (cons lbl labels) block-params))))
            ((and (pair? inst) (eq? (car inst) '%block))
             (let ((lbl (cadr inst))
                   (params (caddr inst))
                   (sub-insts (cdddr inst)))
               (if (memq lbl labels)
                   (begin
                     (lir-report-error "Duplicate block label definition within function" lbl)
                     #f)
                   (let ((sub-res (lir-collect-labels-and-params sub-insts)))
                     (if (not sub-res)
                         #f
                         (loop (cdr is)
                               (cons lbl (append (car sub-res) labels))
                               (cons (cons lbl (length params))
                                     (append (cdr sub-res) block-params))))))))
            (else
             (loop (cdr is) labels block-params)))))))

(define (lir-verify-cfg-targets insts defined-labels block-params known-fn-labels)
  (let ((label-set (make-symbol-hash-set (lir-max2 16 (* 2 (length defined-labels)))))
        (known-set (make-symbol-hash-set (lir-max2 16 (* 2 (length known-fn-labels)))))
        (arity-tbl (make-symbol-hash-table (lir-max2 16 (* 2 (length block-params))))))
    (for-each (lambda (l) (symbol-hash-set-add! label-set l)) defined-labels)
    (for-each (lambda (k) (symbol-hash-set-add! known-set k)) known-fn-labels)
    (for-each (lambda (bp) (symbol-hash-table-put! arity-tbl (car bp) (cdr bp))) block-params)
    (let loop ((is insts))
      (if (null? is) #t
          (let ((inst (car is)))
            (cond
              ((not (pair? inst)) (loop (cdr is)))
              ((eq? (car inst) '%block)
               (and (loop (cdddr inst))
                    (loop (cdr is))))
              ((eq? (car inst) '%jump)
               (let* ((target (cadr inst))
                      (args (if (pair? (cddr inst)) (caddr inst) '()))
                      (expected-arity (symbol-hash-table-ref arity-tbl target #f)))
                 (cond
                   ((and (not (symbol-hash-set-contains? label-set target))
                         (not (symbol-hash-set-contains? known-set target)))
                    (lir-report-error "Undefined jump target label" target))
                   ((and expected-arity (not (= (length args) expected-arity)))
                    (lir-report-error "Jump argument count does not match %block parameter count" inst))
                   (else
                    (loop (cdr is))))))
              ((eq? (car inst) '%jump-if-false)
               (let* ((target (caddr inst))
                      (args (if (pair? (cdddr inst)) (cadddr inst) '()))
                      (expected-arity (symbol-hash-table-ref arity-tbl target #f)))
                 (cond
                   ((and (not (symbol-hash-set-contains? label-set target))
                         (not (symbol-hash-set-contains? known-set target)))
                    (lir-report-error "Undefined jump target in %jump-if-false" target))
                   ((and expected-arity (pair? args) (not (= (length args) expected-arity)))
                    (lir-report-error "%jump-if-false argument count mismatch with %block" inst))
                   (else
                    (loop (cdr is))))))
              ((eq? (car inst) '%jump-if)
               (let* ((then-target (caddr inst))
                      (then-args (cadddr inst))
                      (else-target (car (cddddr inst)))
                      (else-args (cadr (cddddr inst)))
                      (then-expected (symbol-hash-table-ref arity-tbl then-target #f))
                      (else-expected (symbol-hash-table-ref arity-tbl else-target #f)))
                 (cond
                   ((and (not (symbol-hash-set-contains? label-set then-target))
                         (not (symbol-hash-set-contains? known-set then-target)))
                    (lir-report-error "Undefined then-target in %jump-if" then-target))
                   ((and (not (symbol-hash-set-contains? label-set else-target))
                         (not (symbol-hash-set-contains? known-set else-target)))
                    (lir-report-error "Undefined else-target in %jump-if" else-target))
                   ((and then-expected (pair? then-args) (not (= (length then-args) then-expected)))
                    (lir-report-error "%jump-if then-argument count mismatch with %block" inst))
                   ((and else-expected (pair? else-args) (not (= (length else-args) else-expected)))
                    (lir-report-error "%jump-if else-argument count mismatch with %block" inst))
                   (else
                    (loop (cdr is))))))
              ((or (eq? (car inst) '%jump-cond)
                   (eq? (car inst) '%jump-if-zero)
                   (eq? (car inst) '%direct-jump))
               (let ((target (if (eq? (car inst) '%jump-cond) (caddr inst) (cadr inst))))
                 (if (and (not (symbol-hash-set-contains? label-set target))
                          (not (symbol-hash-set-contains? known-set target)))
                     (lir-report-error "Undefined jump condition target" target)
                     (loop (cdr is)))))
              ((eq? (car inst) '%switch)
               (let* ((def-lbl (caddr inst))
                      (def-args (if (and (= (length inst) 5) (list? (cadddr inst))) (cadddr inst) '()))
                      (cases (if (= (length inst) 5) (car (cddddr inst)) (cadddr inst)))
                      (def-expected (symbol-hash-table-ref arity-tbl def-lbl #f)))
                 (cond
                   ((and (not (symbol-hash-set-contains? label-set def-lbl))
                         (not (symbol-hash-set-contains? known-set def-lbl)))
                    (lir-report-error "Undefined switch default target" def-lbl))
                   ((and def-expected (pair? def-args) (not (= (length def-args) def-expected)))
                    (lir-report-error "%switch default argument count mismatch with %block" inst))
                   (else
                    (for-each
                     (lambda (c)
                       (let* ((c-lbl (cadr c))
                              (c-args (if (and (= (length c) 3) (list? (caddr c))) (caddr c) '()))
                              (c-expected (symbol-hash-table-ref arity-tbl c-lbl #f)))
                         (cond
                           ((and (not (symbol-hash-set-contains? label-set c-lbl))
                                 (not (symbol-hash-set-contains? known-set c-lbl)))
                            (lir-report-error "Undefined switch case target" c-lbl))
                           ((and c-expected (pair? c-args) (not (= (length c-args) c-expected)))
                            (lir-report-error "%switch case argument count mismatch with %block" inst)))))
                     cases)
                    (loop (cdr is))))))
              (else
               (loop (cdr is)))))))))

(define (lir-verify-insts-and-cfg insts known-fn-labels)
  (let ((known-set (make-symbol-hash-set (lir-max2 16 (* 2 (length known-fn-labels))))))
    (for-each (lambda (k) (symbol-hash-set-add! known-set k)) known-fn-labels)
    (lir-verify-insts-single-pass insts known-set '%unnamed-fn)))

;;; -----------------------------------------------------------------------
;;; Function-Level and Program-Level Validation
;;; -----------------------------------------------------------------------
(define (lir-valid-function? fn known-fn-set)
  (cond
    ((not (and (pair? fn) (eq? (car fn) '%lir-function)))
     (lir-report-error "Function node must start with %lir-function" fn))
    ((not (symbol? (cadr fn)))
     (lir-report-error "%lir-function name must be a symbol" fn))
    (else
     (let ((fn-name (cadr fn))
           (params-clause (assq 'params (cddr fn)))
           (frame-clause (assq 'frame-size (cddr fn)))
           (body-clause (assq 'body (cddr fn))))
       (with-verifier-context (list (cons 'phase 'canonical-lir) (cons 'function fn-name))
         (lambda ()
           (cond
             ((not (and params-clause (list? (cadr params-clause))))
              (lir-report-error "%lir-function must have valid (params (...)) clause" fn))
             ((not (and frame-clause (integer? (cadr frame-clause))
                        (>= (cadr frame-clause) 0)
                        (= (modulo (cadr frame-clause) 8) 0)))
              (lir-report-error "%lir-function frame-size must be a non-negative multiple of 8" fn))
             ((not (and body-clause (list? (cdr body-clause))))
              (lir-report-error "%lir-function must have valid (body <insts>...) clause" fn))
             (else
              (lir-verify-insts-single-pass (cdr body-clause) known-fn-set fn-name)))))))))

(define (lir-valid-main? main-clause known-fn-set)
  (cond
    ((not (and (pair? main-clause) (eq? (car main-clause) '%lir-main)))
     (lir-report-error "%lir-main node must start with %lir-main" main-clause))
    (else
     (let ((frame-clause (assq 'frame-size (cdr main-clause)))
           (body-clause (assq 'body (cdr main-clause))))
       (with-verifier-context (list (cons 'phase 'canonical-lir) (cons 'function '%lir-main))
         (lambda ()
           (cond
             ((not (and frame-clause (integer? (cadr frame-clause))
                        (>= (cadr frame-clause) 0)
                        (= (modulo (cadr frame-clause) 8) 0)))
              (lir-report-error "%lir-main frame-size must be a non-negative multiple of 8" main-clause))
             ((not (and body-clause (list? (cdr body-clause))))
              (lir-report-error "%lir-main must have valid (body <insts>...) clause" main-clause))
             (else
              (lir-verify-insts-single-pass (cdr body-clause) known-fn-set '%lir-main)))))))))

;;; -----------------------------------------------------------------------
;;; Public API: validate-lir / verify-lir / validate-core-lir / verify-core-lir
;;; Conforms to DSN-33, DSN-38 & Issue #835 (Core Machine LIR vs Managed Dialect)
;;; -----------------------------------------------------------------------

(define (lir-check-no-managed-insts insts fn-name)
  (let loop ((is insts))
    (if (null? is)
        #t
        (let ((inst (car is)))
          (cond
            ((not (pair? inst))
             (loop (cdr is)))
            ((eq? (car inst) '%block)
             (and (lir-check-no-managed-insts (cdddr inst) fn-name)
                  (loop (cdr is))))
            ((managed-dialect-opcode? (car inst))
             (lir-report-error
              (string-append "Managed runtime dialect opcode forbidden in Core Machine LIR: "
                             (symbol->string (car inst)))
              inst)
             #f)
            (else
             (loop (cdr is))))))))

(define (lir-verify-core-purity prog)
  (let* ((funcs-clause (assq '%lir-functions (cdr prog)))
         (main-clause (assq '%lir-main (cdr prog)))
         (funcs (if funcs-clause (cdr funcs-clause) '())))
    (and
     (let f-loop ((fs funcs))
       (if (null? fs)
           #t
           (let* ((fn (car fs))
                  (lbl (if (pair? (cdr fn)) (cadr fn) '%unknown-fn))
                  (body-clause (assq 'body (cdr fn)))
                  (body-insts (if body-clause (cdr body-clause) '())))
             (and (with-verifier-context (list (cons 'phase 'core-lir) (cons 'function lbl))
                    (lambda () (lir-check-no-managed-insts body-insts lbl)))
                  (f-loop (cdr fs))))))
     (if main-clause
         (let* ((body-clause (assq 'body (cdr main-clause)))
                (body-insts (if body-clause (cdr body-clause) '())))
           (with-verifier-context (list (cons 'phase 'core-lir) (cons 'function '%lir-main))
             (lambda () (lir-check-no-managed-insts body-insts '%lir-main))))
         #t))))

(define (validate-core-lir prog)
  (and (validate-lir prog)
       (lir-verify-core-purity prog)
       (if (and (>= (verifier-level) 3)
                (assq 'L_lir_core (nanopass-get-languages)))
           (if (not (nanopass-ast-valid? 'L_lir_core prog))
               (begin
                 (lir-report-error "Program violates L_lir_core schema invariants" prog)
                 #f)
               #t)
           #t)))

(define (verify-core-lir prog)
  (if (not (verifier-enabled?))
      #t
      (validate-core-lir prog)))

(define validate-lir
  (case-lambda
    ((prog) (validate-lir-general prog))
    ((prog dialect)
     (if (eq? dialect 'core)
         (validate-core-lir prog)
         (validate-lir-general prog)))))

(define (lir-valid-data-chunk? dc)
  (cond
    ((integer? dc)
     (and (>= dc 0) (<= dc 255)))
    ((and (pair? dc) (eq? (car dc) 'zero))
     (and (= (length dc) 2)
          (integer? (cadr dc))
          (>= (cadr dc) 0)))
    ((and (pair? dc) (eq? (car dc) 'reloc))
     (and (= (length dc) 3)
          (symbol? (cadr dc))
          (integer? (caddr dc))))
    (else #f)))

(define (lir-valid-data-entry? de)
  (and (pair? de)
       (case (car de)
         ((bss)
          (and (= (length de) 4)
               (symbol? (cadr de))
               (integer? (caddr de))
               (>= (caddr de) 1)
               (integer? (cadddr de))
               (>= (cadddr de) 0)))
         ((bytes)
          (and (>= (length de) 3)
               (symbol? (cadr de))
               (integer? (caddr de))
               (>= (caddr de) 1)
               (let loop ((cs (cdddr de)))
                 (if (null? cs)
                     #t
                     (and (lir-valid-data-chunk? (car cs))
                          (loop (cdr cs)))))))
         (else #f))))

(define (lir-valid-data-clause? data-clause)
  (and (pair? data-clause)
       (eq? (car data-clause) 'data)
       (pair? (cdr data-clause))
       (null? (cddr data-clause))
       (list? (cadr data-clause))
       (let loop ((des (cadr data-clause)))
         (if (null? des)
             #t
             (and (lir-valid-data-entry? (car des))
                  (loop (cdr des)))))))

(define (validate-lir-general prog)
  (cond
    ((not (and (pair? prog) (eq? (car prog) '%lir-program)))
     (lir-report-error "Root of LIR AST must be %lir-program" prog))
    (else
     (let* ((strings-clause (assq 'strings (cdr prog)))
            (data-clause (assq 'data (cdr prog)))
            (stackmaps-clause (assq 'stackmaps (cdr prog)))
            (funcs-clause (assq '%lir-functions (cdr prog)))
            (main-clause (assq '%lir-main (cdr prog))))
       (cond
         ((not strings-clause)
          (lir-report-error "%lir-program missing (strings ...) clause" prog))
         ((and data-clause (not (lir-valid-data-clause? data-clause)))
          (lir-report-error "Invalid (data ...) clause in %lir-program" data-clause))
         ((not stackmaps-clause)
          (lir-report-error "%lir-program missing (stackmaps ...) clause" prog))
         ((not funcs-clause)
          (lir-report-error "%lir-program missing (%lir-functions ...) clause" prog))
         ((not main-clause)
          (lir-report-error "%lir-program missing (%lir-main ...) clause" prog))
         (else
          (let* ((funcs (cdr funcs-clause))
                 (known-fn-set (make-symbol-hash-set (lir-max2 32 (* 2 (length funcs))))))
            ;; Populate known function labels in O(1)
            (let extract ((fs funcs))
              (if (null? fs)
                  #t
                  (begin
                    (if (and (pair? (car fs)) (pair? (cdar fs)) (symbol? (cadar fs)))
                        (symbol-hash-set-add! known-fn-set (cadar fs)))
                    (extract (cdr fs)))))
            (and (verify-lir-safepoint prog)
                 (let f-loop ((fs funcs))
                   (if (null? fs) #t
                       (and (lir-valid-function? (car fs) known-fn-set)
                            (f-loop (cdr fs)))))
                 (lir-valid-main? main-clause known-fn-set)
                 (if (and (>= (verifier-level) 3)
                          (assq 'L_lir_canonical (nanopass-get-languages)))
                     (if (not (nanopass-ast-valid? 'L_lir_canonical prog))
                         (lir-report-error "Program violates L_lir_canonical schema invariants" prog)
                         #t)
                     #t)))))))))

(define (verify-lir prog)
  (if (not (verifier-enabled?))
      #t
      (validate-lir prog)))
;;; =======================================================================
;;; ULisp Compiler Pass 123: LIR Closures & Stack Allocation Pass
;;; Conforms to DSN-33 Architecture Specification & Issue #583
;;; =======================================================================
;;; Lowers closure allocation (heap and stack) and stack pairs into LIR instructions.
;;; =======================================================================

(define (lir-compile-make-closure expr si env)
  (let* ((label-arg (cadr expr))
         (label-sym (if (and (pair? label-arg) (eq? (car label-arg) 'quote))
                        (cadr label-arg)
                        label-arg))
         (args (cddr expr))
         (num-args (length args))
         (closure-size (* (+ num-args 1) 8))
         (aligned-size (if (= (modulo closure-size 16) 0) closure-size (+ closure-size 8))))
    ;; 1. Evaluate arguments sequentially and place into temporary stack slots
    (let loop ((as args) (curr-si si))
      (if (not (null? as))
          (begin
            (track-lir-si! curr-si)
            (lir-compile-expr (car as) curr-si env #f)
            (emit-lir! (list '%store '%rsp curr-si '%rax))
            (loop (cdr as) (- curr-si 8)))))
    ;; 2. Allocate closure on heap (%alloc puts tagged pointer into %r10)
    (let ((lowest-si (- si (* num-args 8))))
      (emit-lir! (list '%alloc '%r10 (+ aligned-size 8) 9 lowest-si)))
    ;; 3. Write 8-byte prefix header to [%r10 - 9]
    (let* ((hdr-val (+ (+ (* aligned-size 65536) (* (+ num-args 1) 256)) 2))
           (hdr-fixnum (* hdr-val 4)))
      (emit-lir! (list '%mov '%rdx hdr-fixnum))
      (emit-lir! '(%store %r10 -9 %rdx)))
    ;; 4. Write code pointer to [%r10 - 1]
    (emit-lir! (list '%code-ref '%rax label-sym))
    (emit-lir! '(%store %r10 -1 %rax))
    ;; 5. Copy captured arguments from stack to heap [%r10 - 1 + 8 * i]
    (let loop ((i 1) (curr-si si))
      (if (<= i num-args)
          (begin
            (emit-lir! (list '%load '%rax '%rsp curr-si))
            (emit-lir! (list '%store '%r10 (+ -1 (* i 8)) '%rax))
            (loop (+ i 1) (- curr-si 8)))))
    (emit-lir! '(%mov %rax %r10))))

(define (stack-alloc-attr? attr)
  (or (eq? attr '#:stack-alloc)
      (eq? attr 'stack-alloc)
      (and (symbol? attr)
           (let ((s (symbol->string attr)))
             (or (string=? s ":stack-alloc")
                 (string=? s "#:stack-alloc")
                 (string=? s "stack-alloc"))))))

(define (stack-alloc-bytes val)
  (cond
    ((not (pair? val)) 0)
    ((eq? (car val) '%stack-cons) 24)
    ((and (eq? (car val) 'annotate)
          (pair? (cdr val))
          (stack-alloc-attr? (cadr val))
          (pair? (cddr val))
          (pair? (caddr val)))
     (let ((inner (caddr val)))
       (cond
         ((memq (car inner) '(%make-closure-env %make-closure))
          (let* ((num-args (length (cddr inner)))
                 (closure-size (* (+ num-args 1) 8))
                 (aligned-size (if (= (modulo closure-size 16) 0) closure-size (+ closure-size 8))))
            (+ aligned-size 8)))
         ((eq? (car inner) 'cons) 24)
         (else 0))))
    ((eq? (car val) '%make-stack-closure)
     (let* ((num-args (length (cddr val)))
            (closure-size (* (+ num-args 1) 8))
            (aligned-size (if (= (modulo closure-size 16) 0) closure-size (+ closure-size 8))))
       (+ aligned-size 8)))
    (else 0)))

(define (get-stack-vars env)
  (let ((entry (assq '%stack-vars env)))
    (if entry (cdr entry) '())))

(define (set-stack-vars svars env)
  (cons (cons '%stack-vars svars) env))

(define (lir-compile-stack-cons expr si env)
  (let* ((e1 (cadr expr))
         (e2 (caddr expr))
         (base-si (- si 24))
         (tmp1 (- base-si 8))
         (tmp2 (- base-si 16)))
    ;; 1. Evaluate arguments onto temporary stack slots below base-si
    (track-lir-si! tmp1)
    (lir-compile-expr e1 tmp1 env #f)
    (emit-lir! (list '%store '%rsp tmp1 '%rax))
    (track-lir-si! tmp2)
    (lir-compile-expr e2 tmp2 env #f)
    ;; 2. Allocate 24 bytes (header + car + cdr) directly on current stack frame
    (track-lir-si! base-si)
    (emit-lir! '(%mov %rdx 4196356))
    (emit-lir! (list '%store '%rsp base-si '%rdx))
    (emit-lir! (list '%load '%rdx '%rsp tmp1))
    (emit-lir! (list '%store '%rsp (+ base-si 8) '%rdx))
    (emit-lir! (list '%store '%rsp (+ base-si 16) '%rax))
    ;; 3. Return stack-allocated tagged pair pointer (offset +8 from base-si, tag 1)
    (emit-lir! (list '%alloc-stack '%rax (+ base-si 8) 1))))

(define (lir-compile-make-stack-closure expr si env)
  (let* ((label-arg (cadr expr))
         (label-sym (if (and (pair? label-arg) (eq? (car label-arg) 'quote))
                        (cadr label-arg)
                        label-arg))
         (args (cddr expr))
         (num-args (length args))
         (closure-size (* (+ num-args 1) 8))
         (aligned-size (if (= (modulo closure-size 16) 0) closure-size (+ closure-size 8)))
         (total-bytes (+ aligned-size 8))
         (base-si (- si total-bytes))
         (temp-base (- base-si 8)))
    ;; 1. Evaluate arguments sequentially and place into temporary stack slots below temp-base
    (let loop ((as args) (curr-si temp-base))
      (if (not (null? as))
          (begin
            (track-lir-si! curr-si)
            (lir-compile-expr (car as) curr-si env #f)
            (emit-lir! (list '%store '%rsp curr-si '%rax))
            (loop (cdr as) (- curr-si 8)))))
    ;; 2. Format header and store onto stack frame
    (track-lir-si! base-si)
    (let* ((hdr-val (+ (+ (* aligned-size 65536) (* (+ num-args 1) 256)) 2))
           (hdr-fixnum (* hdr-val 4)))
      (emit-lir! (list '%mov '%rdx hdr-fixnum))
      (emit-lir! (list '%store '%rsp base-si '%rdx)))
    (emit-lir! (list '%code-ref '%rax label-sym))
    (emit-lir! (list '%store '%rsp (+ base-si 8) '%rax))
    ;; 3. Copy captured arguments from temporary slots to stack closure slots
    (let loop ((i 1) (curr-si temp-base))
      (if (<= i num-args)
          (begin
            (emit-lir! (list '%load '%rax '%rsp curr-si))
            (emit-lir! (list '%store '%rsp (+ (+ base-si 8) (* i 8)) '%rax))
            (loop (+ i 1) (- curr-si 8)))))
    ;; 4. Tag closure pointer with 0x01 (offset +8 from header)
    (emit-lir! (list '%alloc-stack '%rax (+ base-si 8) 1))))
;;; =======================================================================
;;; ULisp Compiler Pass 124: LIR Procedure Invocations & Call ABI Pass
;;; Conforms to DSN-33 Architecture Specification & Issue #583, #625
;;; =======================================================================
;;; Lowers general closure calls and direct static-label calls into LIR instructions,
;;; handling System V AMD64 register argument passing (rdi, rsi, rdx, rcx, r8, r9),
;;; stack spill argument evaluation, frame shift alignment, Tail Call Optimization (TCO),
;;; and exact GC safepoint registration.
;;; =======================================================================

(define *arg-registers* '(%rdi %rsi %rdx %rcx %r8 %r9))

(define (lir-compile-call proc args si env tail?)
  (let* ((num-args (length args))
         (cur-params-entry (assq '%num-params env))
         (cur-num-params (if cur-params-entry (cdr cur-params-entry) #f))
         (stack-vars (get-stack-vars env))
         (is-stack-closure? (and (symbol? proc) (memq proc stack-vars)))
         (can-tco? (and tail?
                        (not is-stack-closure?)
                        (if cur-num-params (= cur-num-params num-args) #f)))
         (frame-shift (align-frame-shift (if (= num-args 0)
                                             (- 0 si)
                                             (- (* 8 (- num-args 1)) si))))
         (aligned-si (if (= num-args 0)
                         (- 0 frame-shift)
                         (- (* 8 (- num-args 1)) frame-shift))))
    ;; 1. Evaluate arguments sequentially and place into temporary stack slots
    (let loop ((as args) (curr-si aligned-si))
      (if (not (null? as))
          (begin
            (track-lir-si! curr-si)
            (lir-compile-expr (car as) curr-si env #f)
            (emit-lir! (list '%store '%rsp curr-si '%rax))
            (loop (cdr as) (- curr-si 8)))))

    (let ((end-args-si (- aligned-si (* num-args 8))))
      (track-lir-si! end-args-si)
      ;; 2. Evaluate procedure expression -> RAX
      (lir-compile-expr proc end-args-si env #f)
      (emit-lir! '(%mov %r10 %rax))

      (if can-tco?
          ;; --- TAIL CALL OPTIMIZATION (TCO) ---
          (begin
            (let loop ((i 0))
              (if (< i num-args)
                  (if (< i 6)
                      (let ((temp-offset (- aligned-si (* i 8)))
                            (reg (list-ref *arg-registers* i)))
                        (emit-lir! (list '%load reg '%rsp temp-offset))
                        (loop (+ i 1)))
                      (let ((temp-offset (- aligned-si (* i 8)))
                            (param-offset (* 8 (- num-args i))))
                        (emit-lir! (list '%load '%r11 '%rsp temp-offset))
                        (emit-lir! (list '%store '%rsp param-offset '%r11))
                        (loop (+ i 1))))))
            (emit-lir! '(%load %r11 %r10 -1))
            (emit-lir! (list '%mov '%rax (* num-args 4)))
            (emit-lir! '(%jump %r11)))

          ;; --- NON-TAIL CALL ---
          (let* ((bitmap (compute-stackmap-bitmap frame-shift aligned-si args env))
                 (safepoint-lbl (new-safepoint-label!)))
            (record-safepoint! safepoint-lbl frame-shift bitmap)
            ;; Load register arguments (0..min(num-args, 6)-1)
            (let loop ((i 0))
              (if (and (< i num-args) (< i 6))
                  (let ((temp-offset (- aligned-si (* i 8)))
                        (reg (list-ref *arg-registers* i)))
                    (emit-lir! (list '%load reg '%rsp temp-offset))
                    (loop (+ i 1)))))
            (emit-lir! (list '%mov '%rax (* num-args 4)))
            (emit-lir! (list '%call-closure frame-shift safepoint-lbl)))))))

(define (direct-call-simple-arg? arg env)
  (cond
    ((integer? arg)
     (let ((q (quotient arg 1073741824)))
       (and (< q 536870912) (> q -536870912))))
    ((and (symbol? arg) (number? (env-stack-slot? arg env))) #t)
    ((and (pair? arg) (eq? (car arg) '%unbox-fixnum))
     (let ((inner (cadr arg)))
       (or (integer? inner)
           (and (symbol? inner)
                (number? (env-stack-slot? inner env))
                (memq inner (get-raw-vars env))))))
    (else #f)))

(define (every-direct-simple-arg? args env)
  (let loop ((as args))
    (if (null? as)
        #t
        (and (direct-call-simple-arg? (car as) env)
             (loop (cdr as))))))

(define (emit-direct-simple-arg! arg reg env)
  (cond
    ((integer? arg)
     (emit-lir! (list '%mov reg (* arg 4))))
    ((symbol? arg)
     (let ((slot (env-stack-slot? arg env)))
       (emit-lir! (list '%load reg '%rsp slot))))
    ((and (pair? arg) (eq? (car arg) '%unbox-fixnum))
     (let ((inner (cadr arg)))
       (if (integer? inner)
           (emit-lir! (list '%mov reg inner))
           (let ((slot (env-stack-slot? inner env)))
             (emit-lir! (list '%load reg '%rsp slot))))))))

(define (lir-compile-direct-call label args si env tail?)
  (let* ((num-args (length args))
         (cur-params-entry (assq '%num-params env))
         (cur-num-params (if cur-params-entry (cdr cur-params-entry) #f))
         (can-tco? (and tail? (if cur-num-params (= cur-num-params num-args) #f)))
         (cur-fn-entry (assq '%current-func env))
         (is-self-call (and cur-fn-entry (eq? (cdr cur-fn-entry) label)))
         (loop-head-entry (and is-self-call (assq '%self-loop-head env)))
         (self-loop-head (if loop-head-entry (cdr loop-head-entry) #f))
         (direct-simple? (and (<= num-args 6) (every-direct-simple-arg? args env))))
    (if direct-simple?
        ;; Fast path: All arguments are immediate constants or stack variables (no temp stack spill needed)
        (let ((frame-shift (align-frame-shift (- 0 si))))
          (let loop ((as args) (i 0))
            (if (not (null? as))
                (begin
                  (emit-direct-simple-arg! (car as) (list-ref *arg-registers* i) env)
                  (loop (cdr as) (+ i 1)))))
          (if can-tco?
              (if self-loop-head
                  (emit-lir! (list '%jump self-loop-head))
                  (begin
                    (emit-lir! (list '%mov '%rax (* num-args 4)))
                    (emit-lir! (list '%direct-jump label))))
              (let* ((bitmap (compute-stackmap-bitmap frame-shift (- 0 frame-shift) '() env))
                     (safepoint-lbl (new-safepoint-label!)))
                (record-safepoint! safepoint-lbl frame-shift bitmap)
                (emit-lir! (list '%mov '%rax (* num-args 4)))
                (emit-lir! (list '%direct-call label frame-shift safepoint-lbl)))))
        ;; Standard path: Evaluate arguments sequentially into temporary stack slots
        (let* ((frame-shift (align-frame-shift (if (= num-args 0)
                                                   (- 0 si)
                                                   (- (* 8 (- num-args 1)) si))))
               (aligned-si (if (= num-args 0)
                               (- 0 frame-shift)
                               (- (* 8 (- num-args 1)) frame-shift))))
          ;; 1. Evaluate arguments sequentially and place into temporary stack slots
          (let loop ((as args) (curr-si aligned-si))
            (if (not (null? as))
                (begin
                  (track-lir-si! curr-si)
                  (lir-compile-expr (car as) curr-si env #f)
                  (emit-lir! (list '%store '%rsp curr-si '%rax))
                  (loop (cdr as) (- curr-si 8)))))

          (if can-tco?
              ;; --- TAIL CALL OPTIMIZATION (TCO) via Direct Jump ---
              (begin
                (let loop ((i 0))
                  (if (< i num-args)
                      (if (< i 6)
                          (let ((temp-offset (- aligned-si (* i 8)))
                                (reg (list-ref *arg-registers* i)))
                            (emit-lir! (list '%load reg '%rsp temp-offset))
                            (loop (+ i 1)))
                          (let ((temp-offset (- aligned-si (* i 8)))
                                (param-offset (* 8 (- num-args i))))
                            (emit-lir! (list '%load '%r11 '%rsp temp-offset))
                            (emit-lir! (list '%store '%rsp param-offset '%r11))
                            (loop (+ i 1))))))
                (if self-loop-head
                    (emit-lir! (list '%jump self-loop-head))
                    (begin
                      (emit-lir! (list '%mov '%rax (* num-args 4)))
                      (emit-lir! (list '%direct-jump label)))))

              ;; --- NON-TAIL DIRECT CALL ---
              (let* ((bitmap (compute-stackmap-bitmap frame-shift aligned-si args env))
                     (safepoint-lbl (new-safepoint-label!)))
                (record-safepoint! safepoint-lbl frame-shift bitmap)
                ;; Load register arguments (0..min(num-args, 6)-1)
                (let loop ((i 0))
                  (if (and (< i num-args) (< i 6))
                      (let ((temp-offset (- aligned-si (* i 8)))
                            (reg (list-ref *arg-registers* i)))
                        (emit-lir! (list '%load reg '%rsp temp-offset))
                        (loop (+ i 1)))))
                (emit-lir! (list '%mov '%rax (* num-args 4)))
                (emit-lir! (list '%direct-call label frame-shift safepoint-lbl))))))))

;;; -----------------------------------------------------------------------
;;; Foreign Function Interface (C-FFI) / System V AMD64 ABI Calls
;;; -----------------------------------------------------------------------

(define (parse-foreign-args args)
  (let loop ((as args) (rev-types '()) (rev-exprs '()))
    (if (null? as)
        (cons (reverse rev-types) (reverse rev-exprs))
        (let ((item (car as)))
          (cond
            ((and (pair? item)
                  (symbol? (car item))
                  (memq (car item) '(string cstr f32 f64 float double i8 u8 i16 u16 i32 u32 i64 u64 int ptr fixnum))
                  (pair? (cdr item))
                  (null? (cddr item)))
             (loop (cdr as)
                   (cons (car item) rev-types)
                   (cons (cadr item) rev-exprs)))
            ((string? item)
             (loop (cdr as)
                   (cons 'string rev-types)
                   (cons item rev-exprs)))
            (else
             (loop (cdr as)
                   (cons 'ptr rev-types)
                   (cons item rev-exprs))))))))

(define (lir-compile-foreign-call func raw-args si env convention return-type varargs?)
  (let* ((parsed (parse-foreign-args raw-args))
         (arg-types (car parsed))
         (arg-exprs (cdr parsed))
         (num-args (length arg-exprs))
         (layout (compute-call-abi-layout convention arg-types varargs?))
         (locations (abi-layout-locations layout))
         (stack-bytes (abi-layout-stack-bytes layout))
         (al-val (abi-layout-al-val layout))
         (eval-frame-shift (align-frame-shift (if (= num-args 0)
                                                  (- 0 si)
                                                  (- (* 8 (- num-args 1)) si))))
         (aligned-si (if (= num-args 0)
                         (- 0 eval-frame-shift)
                         (- (* 8 (- num-args 1)) eval-frame-shift))))
    ;; 1. Evaluate arguments sequentially and place into temporary stack slots
    (let loop ((as arg-exprs) (types arg-types) (curr-si aligned-si) (i 0))
      (if (not (null? as))
          (let ((expr (car as))
                (ty (car types)))
            (track-lir-si! curr-si)
            (if (and (arg-type-float? ty) (number? expr))
                (begin
                  (if (integer? expr)
                      (begin
                        (emit-lir! (list '%mov '%rax expr))
                        (emit-lir! '(%sitofp %xmm0 %rax)))
                      (begin
                        (emit-lir! (list '%mov '%rax (inexact->exact (round (* expr 1000000)))))
                        (emit-lir! '(%sitofp %xmm0 %rax))))
                  (emit-lir! (list '%store-typed 'f64 '%rsp curr-si '%xmm0)))
                (begin
                  (lir-compile-expr expr curr-si env #f)
                  (cond
                    ((memq ty '(string cstr))
                     (emit-lir! '(%sub %rax 3))
                     (emit-lir! (list '%store '%rsp curr-si '%rax)))
                    ((eq? ty 'fixnum)
                     (emit-lir! '(%sar %rax 2))
                     (emit-lir! (list '%store '%rsp curr-si '%rax)))
                    ((arg-type-float? ty)
                     (emit-lir! '(%unbox-flonum %xmm0 %rax))
                     (emit-lir! (list '%store-typed 'f64 '%rsp curr-si '%xmm0)))
                    (else
                     (emit-lir! (list '%store '%rsp curr-si '%rax))))))
            (loop (cdr as) (cdr types) (- curr-si 8) (+ i 1)))))

    (let* ((end-si (- aligned-si (* num-args 8)))
           (final-frame-shift (align-frame-shift (+ (- 0 end-si) stack-bytes))))
      (track-lir-si! (- 0 final-frame-shift))

      ;; 2. For stack spill arguments, write to outgoing stack slots
      (let loop ((locs locations))
        (if (not (null? locs))
            (let ((loc (car locs)))
              (if (eq? (abi-arg-loc-kind loc) 'stack)
                  (let* ((idx (abi-arg-loc-index loc))
                         (temp-slot (- aligned-si (* idx 8)))
                         (stk-offset (abi-arg-loc-offset loc))
                         (target-slot (- stk-offset final-frame-shift))
                         (ty (abi-arg-loc-type loc)))
                    (track-lir-si! target-slot)
                    (if (arg-type-float? ty)
                        (begin
                          (emit-lir! (list '%load-typed 'f64 '%xmm0 '%rsp temp-slot))
                          (emit-lir! (list '%store-typed 'f64 '%rsp target-slot '%xmm0)))
                        (begin
                          (emit-lir! (list '%load '%r11 '%rsp temp-slot))
                          (emit-lir! (list '%store '%rsp target-slot '%r11))))))
              (loop (cdr locs)))))

      ;; 3. Load register arguments (GPR and XMM)
      (let loop ((locs locations))
        (if (not (null? locs))
            (let ((loc (car locs)))
              (cond
                ((eq? (abi-arg-loc-kind loc) 'gpr)
                 (let* ((idx (abi-arg-loc-index loc))
                        (temp-slot (- aligned-si (* idx 8)))
                        (reg (abi-arg-loc-target loc)))
                   (emit-lir! (list '%load reg '%rsp temp-slot))))
                ((eq? (abi-arg-loc-kind loc) 'xmm)
                 (let* ((idx (abi-arg-loc-index loc))
                        (temp-slot (- aligned-si (* idx 8)))
                        (reg (abi-arg-loc-target loc))
                        (ty (abi-arg-loc-type loc)))
                   (if (eq? ty 'f32)
                       (emit-lir! (list '%load-typed 'f32 reg '%rsp temp-slot))
                       (emit-lir! (list '%load-typed 'f64 reg '%rsp temp-slot))))))
              (loop (cdr locs)))))

      ;; 4. Emit foreign call instruction
      (let ((fn-name (cond
                       ((string? func) func)
                       ((symbol? func) (symbol->string func))
                       (else func))))
        (emit-lir! (list '%c-call fn-name final-frame-shift al-val)))

      ;; 5. Handle return value
      (cond
        ((eq? return-type 'void)
         (emit-lir! '(%mov %rax 63)))
        ((arg-type-float? return-type)
         (emit-lir! '(%alloc %rax 16 3))
         (emit-lir! '(%store-typed f64 %rax 8 %xmm0)))
        ((memq return-type '(fixnum int))
         (emit-lir! '(%shl %rax 2)))
        (else #t)))))

(define (lir-compile-c-call expr si env tail?)
  (let ((func (cadr expr))
        (rest (cddr expr)))
    (cond
      ((and (pair? rest) (list? (car rest)))
       (let* ((args (car rest))
              (ret-type (if (pair? (cdr rest)) (cadr rest) 'any))
              (varargs? (if (and (pair? (cdr rest)) (pair? (cddr rest))) (caddr rest) #f)))
         (lir-compile-foreign-call func args si env 'sysv-abi ret-type varargs?)))
      (else
       (lir-compile-foreign-call func rest si env 'sysv-abi 'any #f)))))

(define (lir-compile-foreign-call-expr expr si env tail?)
  (let* ((conv (cadr expr))
         (ret-type (caddr expr))
         (func (cadddr expr))
         (args (car (cddddr expr)))
         (varargs? (if (pair? (cdr (cddddr expr))) (cadr (cddddr expr)) #f)))
    (lir-compile-foreign-call func args si env conv ret-type varargs?)))
;;; =======================================================================
;;; ULisp Compiler Pass 125: LIR Continuation Transfer & Loop In-Place Shuffle Pass
;;; Conforms to DSN-33 Architecture Specification & Issue #583
;;; =======================================================================
;;; Lowers continuation functions (%cont-fun) and continuation calls (%cont-call)
;;; into Block Arguments SSA jumps (%jump, %block), in-place register shuffle loops,
;;; and rotated do-while loops with condition flag fusion.
;;; =======================================================================

(define (expr-references-var? expr var)
  (cond
    ((eq? expr var) #t)
    ((pair? expr)
     (or (expr-references-var? (car expr) var)
         (expr-references-var? (cdr expr) var)))
    (else #f)))

(define (expr-free-references-var? expr var)
  (cond
    ((eq? expr var) #t)
    ((not (pair? expr)) #f)
    (else
     (let ((op (car expr)))
       (case op
         ((quote) #f)
         ((let letrec)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (shadowed? (assq var bindings)))
            (or (let loop ((bs bindings))
                  (and (pair? bs)
                       (or (expr-free-references-var? (cadar bs) var)
                           (loop (cdr bs)))))
                (if shadowed?
                    #f
                    (expr-free-references-var? body var)))))
         ((lambda)
          (let ((params (cadr expr))
                (body (caddr expr)))
            (if (memq var params)
                #f
                (expr-free-references-var? body var))))
         ((%cont-fun)
          (let ((f-name (cadr expr))
                (params (caddr expr))
                (f-body (cadddr expr))
                (in-body (cadr (cdddr expr))))
            (or (if (memq var params) #f (expr-free-references-var? f-body var))
                (expr-free-references-var? in-body var))))
         (else
          (or (expr-free-references-var? (car expr) var)
              (expr-free-references-var? (cdr expr) var))))))))

(define (in-place-const-int? x)
  (and (integer? x) (>= x -268435456) (<= x 268435455)))

(define (extract-in-place-const op e)
  (let* ((raw-c (if (integer? (cadr e)) (cadr e) (caddr e)))
         (is-raw? (memq op '(%raw-add %raw-sub))))
    (if is-raw? raw-c (* raw-c 4))))

(define (cont-target-all-regs? target-info)
  (let* ((p-bindings (caddr target-info))
         (num-args (length p-bindings)))
    (and (> num-args 0)
         (let check-regs ((pbs p-bindings))
           (if (null? pbs) #t
               (let ((info (cdar pbs)))
                 (and (or (and (pair? info) (eq? (car info) 'reg))
                          (memq info '(%rbx %r13 %r14 %r15)))
                      (check-regs (cdr pbs)))))))))

(define (emit-in-place-jump! entry-lbl regs)
  (if entry-lbl
      (emit-lir! (list '%jump entry-lbl regs))))

(define (lir-compile-in-place-cont-call f-name exprs target-info si env)
  (let* ((entry-lbl (cadr target-info))
         (p-bindings (caddr target-info))
         (num-args (length exprs))
         (p-names (map car* p-bindings))
         (p-regs (map (lambda (pb)
                        (let ((info (cdr pb)))
                          (if (pair? info) (cdr info) info)))
                      p-bindings)))
    (cond
      ;; === 2-Argument Hot Loop In-Place Shuffle ===
      ((= num-args 2)
       (let* ((p0 (car p-names))
              (p1 (cadr p-names))
              (r0 (car p-regs))
              (r1 (cadr p-regs))
              (e0 (car exprs))
              (e1 (cadr exprs))
              ;; Check if e0 references p1
              (e0-refs-p1? (expr-references-var? e0 p1))
              ;; Check if e1 references p0
              (e1-refs-p0? (expr-references-var? e1 p0)))
         (cond
           ;; Case 1: Swap (loop p1 p0)
           ((and (eq? e0 p1) (eq? e1 p0))
            (emit-lir! (list '%mov '%r10 r0))
            (emit-lir! (list '%mov r0 r1))
            (emit-lir! (list '%mov r1 '%r10))
            (emit-in-place-jump! entry-lbl (list r0 r1)))

           ;; Case 1b: Identity on one variable
           ((and (eq? e1 p1) (not e0-refs-p1?))
            (cond
              ((and (pair? e0)
                    (memq (car e0) '(+ %raw-add))
                    (or (and (eq? (cadr e0) p0) (in-place-const-int? (caddr e0)))
                        (and (in-place-const-int? (cadr e0)) (eq? (caddr e0) p0))))
               (let ((c (extract-in-place-const (car e0) e0)))
                 (emit-lir! (list '%add r0 c))))
              ((and (pair? e0)
                    (memq (car e0) '(- %raw-sub))
                    (eq? (cadr e0) p0)
                    (in-place-const-int? (caddr e0)))
               (let ((c (extract-in-place-const (car e0) e0)))
                 (emit-lir! (list '%sub r0 c))))
              (else
               (lir-compile-expr e0 si env #f)
               (if (not (eq? r0 '%rax))
                   (emit-lir! (list '%mov r0 '%rax)))))
            (emit-in-place-jump! entry-lbl (list r0 r1)))

           ((and (eq? e0 p0) (not e1-refs-p0?))
            (cond
              ((and (pair? e1)
                    (memq (car e1) '(+ %raw-add))
                    (or (and (eq? (cadr e1) p1) (in-place-const-int? (caddr e1)))
                        (and (in-place-const-int? (cadr e1)) (eq? (caddr e1) p1))))
               (let ((c (extract-in-place-const (car e1) e1)))
                 (emit-lir! (list '%add r1 c))))
              ((and (pair? e1)
                    (memq (car e1) '(- %raw-sub))
                    (eq? (cadr e1) p1)
                    (in-place-const-int? (caddr e1)))
               (let ((c (extract-in-place-const (car e1) e1)))
                 (emit-lir! (list '%sub r1 c))))
              (else
               (lir-compile-expr e1 si env #f)
               (if (not (eq? r1 '%rax))
                   (emit-lir! (list '%mov r1 '%rax)))))
            (emit-in-place-jump! entry-lbl (list r0 r1)))

           ;; Case 2: DAG dependency (e1 depends on p0, e0 does NOT depend on p1)
           ;; e.g. e0 = (+ i 1), e1 = (+ acc i). Evaluate e1 into r1 first, then e0 into r0!
           ((and e1-refs-p0? (not e0-refs-p1?))
            ;; Fast path: e1 is (%raw-add i acc) or (+ acc i) -> direct in-place add!
            (cond
              ((and (pair? e1)
                    (memq (car e1) '(+ %raw-add))
                    (or (and (eq? (cadr e1) p0) (eq? (caddr e1) p1))
                        (and (eq? (cadr e1) p1) (eq? (caddr e1) p0))))
               (emit-lir! (list '%add r1 r0)))
              ((and (pair? e1)
                    (memq (car e1) '(- %raw-sub))
                    (eq? (cadr e1) p1)
                    (eq? (caddr e1) p0))
               (emit-lir! (list '%sub r1 r0)))
              (else
               (lir-compile-expr e1 si env #f)
               (if (not (eq? r1 '%rax))
                   (emit-lir! (list '%mov r1 '%rax)))))
            ;; Now evaluate e0 into r0 in-place!
            (cond
              ((and (pair? e0)
                    (memq (car e0) '(+ %raw-add))
                    (or (and (eq? (cadr e0) p0) (in-place-const-int? (caddr e0)))
                        (and (in-place-const-int? (cadr e0)) (eq? (caddr e0) p0))))
               (let ((c (extract-in-place-const (car e0) e0)))
                 (emit-lir! (list '%add r0 c))))
              ((and (pair? e0)
                    (memq (car e0) '(- %raw-sub))
                    (eq? (cadr e0) p0)
                    (in-place-const-int? (caddr e0)))
               (let ((c (extract-in-place-const (car e0) e0)))
                 (emit-lir! (list '%sub r0 c))))
              (else
               (lir-compile-expr e0 si env #f)
               (if (not (eq? r0 '%rax))
                   (emit-lir! (list '%mov r0 '%rax)))))
            (emit-in-place-jump! entry-lbl (list r0 r1)))

           ;; Case 3: DAG dependency (e0 depends on p1, e1 does NOT depend on p0)
           ;; Evaluate e0 into r0 first, then e1 into r1!
           ((and e0-refs-p1? (not e1-refs-p0?))
            (cond
              ((and (pair? e0)
                    (memq (car e0) '(+ %raw-add))
                    (or (and (eq? (cadr e0) p0) (eq? (caddr e0) p1))
                        (and (eq? (cadr e0) p1) (eq? (caddr e0) p0))))
               (emit-lir! (list '%add r0 r1)))
              (else
               (lir-compile-expr e0 si env #f)
               (if (not (eq? r0 '%rax))
                   (emit-lir! (list '%mov r0 '%rax)))))
            ;; Now evaluate e1 into r1 in-place!
            (cond
              ((and (pair? e1)
                    (memq (car e1) '(+ %raw-add))
                    (or (and (eq? (cadr e1) p1) (in-place-const-int? (caddr e1)))
                        (and (in-place-const-int? (cadr e1)) (eq? (caddr e1) p1))))
               (let ((c (extract-in-place-const (car e1) e1)))
                 (emit-lir! (list '%add r1 c))))
              ((and (pair? e1)
                    (memq (car e1) '(- %raw-sub))
                    (eq? (cadr e1) p1)
                    (in-place-const-int? (caddr e1)))
               (let ((c (extract-in-place-const (car e1) e1)))
                 (emit-lir! (list '%sub r1 c))))
              (else
               (lir-compile-expr e1 si env #f)
               (if (not (eq? r1 '%rax))
                   (emit-lir! (list '%mov r1 '%rax)))))
            (emit-in-place-jump! entry-lbl (list r0 r1)))

           ;; Case 4: General 2-argument parallel update: preserve e0 on stack slot si across e1 evaluation
           (else
            (track-lir-si! si)
            (lir-compile-expr e0 si env #f)
            (emit-lir! (list '%store '%rsp si '%rax))
            (lir-compile-expr e1 (- si 8) env #f)
            (if (not (eq? r1 '%rax))
                (emit-lir! (list '%mov r1 '%rax)))
            (emit-lir! (list '%load r0 '%rsp si))
            (emit-in-place-jump! entry-lbl (list r0 r1))))))

      ;; === 1-Argument In-Place Update ===
      ((= num-args 1)
       (let ((r0 (car p-regs))
             (p0 (car p-names))
             (e0 (car exprs)))
         (cond
           ((and (pair? e0)
                 (memq (car e0) '(+ %raw-add))
                 (or (and (eq? (cadr e0) p0) (in-place-const-int? (caddr e0)))
                     (and (in-place-const-int? (cadr e0)) (eq? (caddr e0) p0))))
            (let ((c (extract-in-place-const (car e0) e0)))
              (emit-lir! (list '%add r0 c))))
           ((and (pair? e0)
                 (memq (car e0) '(- %raw-sub))
                 (eq? (cadr e0) p0)
                 (in-place-const-int? (caddr e0)))
            (let ((c (extract-in-place-const (car e0) e0)))
              (emit-lir! (list '%sub r0 c))))
           (else
            (lir-compile-expr e0 si env #f)
            (if (not (eq? r0 '%rax))
                (emit-lir! (list '%mov r0 '%rax)))))
         (emit-in-place-jump! entry-lbl (list r0))))

      ;; === Fallback for >= 3 arguments using stack-free %cont-call ===
      (else
       (let loop ((es exprs) (curr-si si) (temp-sis '()))
         (if (pair? es)
             (begin
               (track-lir-si! curr-si)
               (lir-compile-expr (car es) curr-si env #f)
               (emit-lir! (list '%store '%rsp curr-si '%rax))
               (loop (cdr es) (- curr-si 8) (cons curr-si temp-sis)))
             (begin
               (let xfer ((ts (reverse temp-sis)) (pbs p-bindings))
                 (if (and (pair? ts) (pair? pbs))
                     (let ((t-si (car ts))
                           (p-info (cdar pbs)))
                       (cond
                         ((and (pair? p-info) (eq? (car p-info) 'reg))
                          (emit-lir! (list '%load (cdr p-info) '%rsp t-si)))
                         ((memq p-info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15))
                          (emit-lir! (list '%load p-info '%rsp t-si)))
                         (else
                          (emit-lir! (list '%load '%rdx '%rsp t-si))
                          (emit-lir! (list '%store '%rsp p-info '%rdx))))
                       (xfer (cdr ts) (cdr pbs)))))
               (emit-in-place-jump! entry-lbl
                                (map (lambda (pb)
                                       (let ((p-info (cdr pb)))
                                         (cond
                                           ((and (pair? p-info) (eq? (car p-info) 'reg))
                                            (cdr p-info))
                                           ((memq p-info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15))
                                            p-info)
                                           (else
                                            (list '%stack p-info)))))
                                     p-bindings)))))))))

(define (cont-recurse-tail? f-name expr)
  (cond
    ((not (pair? expr)) #f)
    ((eq? (car expr) '%cont-call)
     (eq? (cadr expr) f-name))
    ((eq? (car expr) 'let)
     (cont-recurse-tail? f-name (caddr expr)))
    ((eq? (car expr) 'begin)
     (let loop ((rest (cdr expr)))
       (cond
         ((null? rest) #f)
         ((null? (cdr rest)) (cont-recurse-tail? f-name (car rest)))
         (else (loop (cdr rest))))))
    (else #f)))

(define (cont-loop-rotation-candidate? f-name f-body)
  (let ((actual-body
         (if (and (pair? f-body)
                  (eq? (car f-body) 'begin)
                  (pair? (cdr f-body)))
             (let loop ((es (cdr f-body)))
               (cond
                 ((null? es) f-body)
                 ((null? (cdr es)) (car es))
                 ((and (pair? (car es))
                       (memq (caar es) '(%synapse-safepoint-poll! %safepoint-poll! synapse-safepoint-poll!)))
                  (loop (cdr es)))
                 (else (car (reverse es)))))
             f-body)))
    (cond
       ;; Pattern A: (let ((var (cmp-op lhs rhs))) (if var then-exit else-recurse))
      ((and (pair? actual-body)
            (eq? (car actual-body) 'let)
            (= (length (cadr actual-body)) 1))
       (let* ((b (car (cadr actual-body)))
              (var (car b))
              (val (cadr b))
              (inner (caddr actual-body)))
         (if (and (pair? val)
                  (memq (car val) '(= < <= > >= eq?))
                  (= (length val) 3)
                  (pair? inner)
                  (eq? (car inner) 'if)
                  (eq? (cadr inner) var)
                  (not (expr-free-references-var? (caddr inner) var))
                  (not (expr-free-references-var? (cdddr inner) var))
                  (not (occurs-in? '%cont-call (caddr inner)))
                  (pair? (cdddr inner))
                  (cont-recurse-tail? f-name (car (cdddr inner))))
             (list val (caddr inner) (car (cdddr inner)))
             #f)))
      ;; Pattern B: (if (cmp-op lhs rhs) then-exit else-recurse)
      ((and (pair? actual-body)
            (eq? (car actual-body) 'if)
            (pair? (cadr actual-body))
            (memq (car (cadr actual-body)) '(= < <= > >= eq?))
            (= (length (cadr actual-body)) 3))
       (let ((val (cadr actual-body))
             (then-exit (caddr actual-body))
             (else-recurse (if (pair? (cdddr actual-body)) (car (cdddr actual-body)) #f)))
         (if (and else-recurse
                  (not (occurs-in? '%cont-call then-exit))
                  (cont-recurse-tail? f-name else-recurse))
             (list val then-exit else-recurse)
             #f)))
      (else #f))))

(define (cont-extract-int val)
  (cond
    ((integer? val) val)
    ((and (pair? val) (eq? (car val) '%unbox-fixnum) (integer? (cadr val)))
     (cadr val))
    (else #f)))

(define (cont-can-unroll-counting-loop? params cmp-expr else-recurse f-name)
  (and (= (length params) 2)
       (pair? cmp-expr)
       (memq (car cmp-expr) '(= >= <= < > eq?))
       (let* ((p0 (car params))
              (p1 (cadr params))
              (lhs (cadr cmp-expr))
              (rhs (caddr cmp-expr))
              (limit (cond
                       ((eq? lhs p0) (cont-extract-int rhs))
                       ((eq? rhs p0) (cont-extract-int lhs))
                       (else #f))))
         (and limit
              (>= limit 16)
              (<= limit 1000000000)
              (zero? (modulo limit 8))
              (let* ((call-form
                      (cond
                        ((and (pair? else-recurse) (eq? (car else-recurse) '%cont-call))
                         else-recurse)
                        ((and (pair? else-recurse)
                              (eq? (car else-recurse) 'let)
                              (pair? (cddr else-recurse))
                              (pair? (caddr else-recurse))
                              (eq? (car (caddr else-recurse)) '%cont-call))
                         (caddr else-recurse))
                        ((and (pair? else-recurse)
                              (eq? (car else-recurse) 'begin))
                         (let loop-b ((es (cdr else-recurse)))
                           (cond
                             ((null? es) #f)
                             ((null? (cdr es))
                              (cond
                                ((and (pair? (car es)) (eq? (caar es) '%cont-call))
                                 (car es))
                                ((and (pair? (car es))
                                      (eq? (caar es) 'let)
                                      (pair? (cddr (car es)))
                                      (pair? (caddr (car es)))
                                      (eq? (car (caddr (car es))) '%cont-call))
                                 (caddr (car es)))
                                (else #f)))
                             (else (loop-b (cdr es))))))
                        (else #f)))
                     (bindings
                      (if (and (pair? else-recurse) (eq? (car else-recurse) 'let))
                          (cadr else-recurse)
                          '())))
                (and call-form
                     (eq? (cadr call-form) f-name)
                     (let* ((raw-a0 (caddr call-form))
                            (raw-a1 (cadddr call-form))
                            (resolve-arg
                             (lambda (a)
                               (let ((b (assq a bindings)))
                                 (if b (cadr b) a))))
                            (e0 (resolve-arg raw-a0))
                            (e1 (resolve-arg raw-a1)))
                       (and (pair? e0)
                            (memq (car e0) '(+ %raw-add))
                            (or (and (eq? (cadr e0) p0) (eqv? (caddr e0) 1))
                                (and (eqv? (cadr e0) 1) (eq? (caddr e0) p0)))
                            (pair? e1)
                            (memq (car e1) '(+ %raw-add))
                            (or (and (eq? (cadr e1) p0) (eq? (caddr e1) p1))
                                (and (eq? (cadr e1) p1) (eq? (caddr e1) p0)))))))))))

(define (cont-body-has-external-call? expr f-name)
  (cond
    ((null? expr) #f)
    ((not (pair? expr)) #f)
    (else
     (let ((op (car expr)))
       (case op
         ((quote) #f)
         ((%cont-call)
          (if (eq? (cadr expr) f-name)
              (let loop ((args (cddr expr)))
                (and (pair? args)
                     (or (cont-body-has-external-call? (car args) f-name)
                         (loop (cdr args)))))
              #t))
         ((%direct-call %call %closure-call %c-call %syscall %raw-call/cc %make-closure %make-closure-env)
          #t)
         ((if)
          (or (cont-body-has-external-call? (cadr expr) f-name)
              (cont-body-has-external-call? (caddr expr) f-name)
              (if (null? (cdddr expr)) #f (cont-body-has-external-call? (cadddr expr) f-name))))
         ((begin)
          (let loop ((es (cdr expr)))
            (and (pair? es)
                 (or (cont-body-has-external-call? (car es) f-name)
                     (loop (cdr es))))))
         ((let letrec)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (b-calls (let loop ((bs bindings))
                            (and (pair? bs)
                                 (or (cont-body-has-external-call? (cadar bs) f-name)
                                     (loop (cdr bs)))))))
            (or b-calls (cont-body-has-external-call? body f-name))))
         ((%cont-fun)
          (or (cont-body-has-external-call? (cadddr expr) f-name)
              (cont-body-has-external-call? (cadr (cdddr expr)) f-name)))
         ((%box-fixnum %unbox-fixnum %raw-add %raw-sub %raw-mul %raw-div %raw-cmp
           %bitwise-and %bitwise-ior %shift-left %shift-right %store %load
           + - * / = < <= > >= eq? null? zero? pair? not)
          (let loop ((args (cdr expr)))
            (and (pair? args)
                 (or (cont-body-has-external-call? (car args) f-name)
                     (loop (cdr args))))))
         (else
          (if (symbol? op)
              #t
              (or (cont-body-has-external-call? (car expr) f-name)
                  (cont-body-has-external-call? (cdr expr) f-name)))))))))

(define (lir-compile-cont-fun f-name params f-body in-body si env tail?)
  (let* ((entry-lbl (unique-label-sym "L_cont_entry_"))
         (exit-lbl  (unique-label-sym "L_cont_exit_"))
         (num-params (length params))
         ;; Allocate callee-saved registers (%rbx, %r13, %r14) for leaf loops with <= 3 parameters
         (use-reg-alloc? (and (<= num-params 3)
                              (not (cont-body-has-external-call? f-body f-name))
                              (or (unboxed-fn? f-name)
                                  (not (occurs-in? '* f-body)))))
         (rot-cand (and use-reg-alloc? (cont-loop-rotation-candidate? f-name f-body)))
         (callee-saved-regs '(%rbx %r13 %r14)))
    (cond
      ;; === Path 1: Rotated Do-While Loop (Loop Rotation / Inversion) ===
      (rot-cand
       (let* ((assigned-regs
               (let loop ((i 0) (acc '()))
                 (if (< i num-params)
                     (loop (+ i 1) (cons (list-ref callee-saved-regs i) acc))
                     (reverse acc))))
              (saved-slots
               (let loop ((rs assigned-regs) (curr-si si) (acc '()))
                 (if (null? rs)
                     acc
                     (begin
                       (track-lir-si! curr-si)
                       (emit-lir! (list '%store '%rsp curr-si (car rs)))
                       (loop (cdr rs) (- curr-si 8) (cons (cons (car rs) curr-si) acc))))))
              (p-bindings
               (let loop ((ps params) (rs assigned-regs) (acc '()))
                 (if (null? ps)
                     (reverse acc)
                     (loop (cdr ps) (cdr rs)
                           (cons (cons (car ps) (cons 'reg (car rs))) acc)))))
              (raw-vars (if (unboxed-fn? f-name)
                            (append params (get-raw-vars env))
                            (get-raw-vars env)))
              (body-env (set-raw-vars raw-vars (append p-bindings env)))
              (next-si (- si (* num-params 8)))
              (cmp-expr (car rot-cand))
              (then-exit (cadr rot-cand))
              (else-recurse (caddr rot-cand))
              (body-lbl (unique-label-sym "L_loop_body_"))
              (done-lbl (unique-label-sym "L_loop_done_"))
              ;; Note: in rot-env, target entry-lbl is #f so in-place update omits terminal %jump!
              (rot-cont-info (list '%cont-target #f p-bindings))
              (rot-env (cons (cons f-name rot-cont-info) body-env))
              ;; In init-env, initial call jumps to entry-lbl
              (init-cont-info (list '%cont-target entry-lbl p-bindings))
              (init-env (cons (cons f-name init-cont-info) body-env)))
         ;; 1. Compile in-body first: evaluates initial args into registers and jumps to entry-lbl
         (lir-compile-expr in-body next-si init-env tail?)
         (emit-lir! (list '%jump exit-lbl))

         ;; 2. Loop entry with guard check: if condition true, jump to done-lbl!
         (emit-lir! (list '%block entry-lbl assigned-regs))
         (lir-compile-fused-cmp-cond (car cmp-expr) (cadr cmp-expr) (caddr cmp-expr)
                                     done-lbl lir-cmp-true-cc next-si rot-env)

         ;; 3. Loop body: in-place update args, then backward conditional branch!
         (if (cont-can-unroll-counting-loop? params cmp-expr else-recurse f-name)
             (let ((limit (or (cont-extract-int (cadr cmp-expr)) (cont-extract-int (caddr cmp-expr))))
                   (r0 (car assigned-regs))
                   (r1 (cadr assigned-regs)))
               (emit-lir! (list '%mov '%r10 0))
               (emit-lir! (list '%block body-lbl '()))
               (let unroll ((step 0))
                 (if (< step 8)
                     (let ((acc-reg (if (zero? (modulo step 2)) r1 '%r10)))
                       (if (= step 0)
                           (emit-lir! (list '%add acc-reg r0))
                           (begin
                             (emit-lir! (list '%mov '%rax r0))
                             (emit-lir! (list '%add '%rax step))
                             (emit-lir! (list '%add acc-reg '%rax))))
                       (unroll (+ step 1)))))
               (emit-lir! (list '%add r0 8))
               (emit-lir! (list '%cmp r0 limit))
               (emit-lir! (list '%jump-cond "jne" body-lbl))
               (emit-lir! (list '%add r1 '%r10)))
             (begin
               (emit-lir! (list '%block body-lbl '()))
               (lir-compile-expr else-recurse next-si rot-env #f)
               (lir-compile-fused-cmp-cond (car cmp-expr) (cadr cmp-expr) (caddr cmp-expr)
                                           body-lbl lir-cmp-false-cc next-si rot-env)))

         ;; 4. Loop exit / termination
         (emit-lir! (list '%block done-lbl '()))
         (lir-compile-expr then-exit next-si rot-env tail?)
         (emit-lir! (list '%label exit-lbl))
         ;; 5. Restore saved callee-saved registers upon exiting the loop
         (for-each
          (lambda (entry)
            (let ((reg (car entry))
                  (slot (cdr entry)))
              (emit-lir! (list '%load reg '%rsp slot))))
          (reverse saved-slots))))

      ;; === Path 2: Standard Leaf Loop Register Allocation ===
      (use-reg-alloc?
       (let* ((assigned-regs
               (let loop ((i 0) (acc '()))
                 (if (< i num-params)
                     (loop (+ i 1) (cons (list-ref callee-saved-regs i) acc))
                     (reverse acc))))
              ;; 1. Save original callee-saved registers to frame stack slots
              (saved-slots
               (let loop ((rs assigned-regs) (curr-si si) (acc '()))
                 (if (null? rs)
                     acc
                     (begin
                       (track-lir-si! curr-si)
                       (emit-lir! (list '%store '%rsp curr-si (car rs)))
                       (loop (cdr rs) (- curr-si 8) (cons (cons (car rs) curr-si) acc))))))
              (p-bindings
               (let loop ((ps params) (rs assigned-regs) (acc '()))
                 (if (null? ps)
                     (reverse acc)
                     (loop (cdr ps) (cdr rs)
                           (cons (cons (car ps) (cons 'reg (car rs))) acc)))))
              (raw-vars (if (unboxed-fn? f-name)
                            (append params (get-raw-vars env))
                            (get-raw-vars env)))
              (body-env (set-raw-vars raw-vars (append p-bindings env)))
              (next-si (- si (* num-params 8)))
              ;; Record contification target info in env
              (cont-info (list '%cont-target entry-lbl p-bindings))
              (full-env (cons (cons f-name cont-info) body-env)))
         ;; Compile in-body first (evaluates initial call into registers and jumps to entry-lbl)
         (lir-compile-expr in-body next-si full-env tail?)
         (emit-lir! (list '%jump exit-lbl))
         ;; Continuation function body entry: emitted as %block with register block arguments!
         (emit-lir! (list '%block entry-lbl assigned-regs))
         (lir-compile-expr f-body next-si full-env tail?)
         (emit-lir! (list '%label exit-lbl))
         ;; Restore saved callee-saved registers upon exiting the loop
         (for-each
          (lambda (entry)
            (let ((reg (car entry))
                  (slot (cdr entry)))
              (emit-lir! (list '%load reg '%rsp slot))))
          (reverse saved-slots))))

      ;; === Path 3: Stack-based Fallback Path (> 3 params or non-leaf) ===
      (else
        (let* ((param-slots
                (let loop ((ps params) (curr-si si) (acc-slots '()) (acc-env env))
                  (if (null? ps)
                      (cons (reverse acc-slots) acc-env)
                      (begin
                        (track-lir-si! curr-si)
                        (loop (cdr ps)
                              (- curr-si 8)
                              (cons (cons (car ps) curr-si) acc-slots)
                              (cons (cons (car ps) curr-si) acc-env))))))
               (p-offsets (car param-slots))
               (raw-vars (if (unboxed-fn? f-name)
                             (append params (get-raw-vars env))
                             (get-raw-vars env)))
               (body-env (set-raw-vars raw-vars (cdr param-slots)))
               (next-si (- si (* (length params) 8)))
               ;; Record contification target info in env
               (cont-info (list '%cont-target entry-lbl p-offsets))
               (full-env (cons (cons f-name cont-info) body-env)))
          ;; Compile in-body first
          (lir-compile-expr in-body next-si full-env tail?)
          (emit-lir! (list '%jump exit-lbl))
          ;; Continuation function body entry: emitted as %block with block arguments!
          (emit-lir! (list '%block entry-lbl (map (lambda (po) (list '%stack (cdr po))) p-offsets)))
          (lir-compile-expr f-body next-si full-env tail?)
          (emit-lir! (list '%label exit-lbl)))))))

(define (lir-compile-cont-call f-name args si env)
  (let ((binding (assq f-name env)))
    (if (not (and binding (pair? (cdr binding)) (eq? (cadr binding) '%cont-target)))
        (error "Unresolved %cont-call target:" f-name)
        (let* ((target-info (cdr binding))
               (entry-lbl (cadr target-info))
               (p-bindings (caddr target-info))
               (num-args (length args))
               (all-reg-targets? (cont-target-all-regs? target-info)))
          (if (not (= num-args (length p-bindings)))
              (error "Arity mismatch in %cont-call:" f-name)
              (cond
                ;; === In-Place / Register-Only Transfer Path ===
                (all-reg-targets?
                 (lir-compile-in-place-cont-call f-name args target-info si env))

                (else
                 ;; === General Transfer Path (sequential stack evaluation) ===
                 (let eval-loop ((as args) (curr-si si) (temp-sis '()))
                   (if (pair? as)
                       (begin
                         (track-lir-si! curr-si)
                         (lir-compile-expr (car as) curr-si env #f)
                         (emit-lir! (list '%store '%rsp curr-si '%rax))
                         (eval-loop (cdr as) (- curr-si 8) (cons curr-si temp-sis)))
                       (begin
                         ;; Transfer temporary values to parameter slots or registers
                         (let xfer-loop ((ts (reverse temp-sis)) (pbs p-bindings))
                           (if (and (pair? ts) (pair? pbs))
                               (let ((t-si (car ts))
                                     (p-info (cdar pbs)))
                                 (cond
                                   ((and (pair? p-info) (eq? (car p-info) 'reg))
                                    (emit-lir! (list '%load (cdr p-info) '%rsp t-si)))
                                   ((memq p-info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15))
                                    (emit-lir! (list '%load p-info '%rsp t-si)))
                                   (else
                                    (emit-lir! (list '%load '%rdx '%rsp t-si))
                                    (emit-lir! (list '%store '%rsp p-info '%rdx))))
                                 (xfer-loop (cdr ts) (cdr pbs)))))
                         ;; Directly jump to continuation target with block arguments!
                         (emit-lir! (list '%jump entry-lbl
                                          (map (lambda (pb)
                                                 (let ((p-info (cdr pb)))
                                                   (cond
                                                     ((and (pair? p-info) (eq? (car p-info) 'reg))
                                                      (cdr p-info))
                                                     ((memq p-info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15))
                                                      p-info)
                                                     (else
                                                      (list '%stack p-info)))))
                                               p-bindings)))))))))))))
;;; =======================================================================
;;; ULisp Compiler Pass 126: LIR Control Flow & Join Path Splitting Pass
;;; Conforms to DSN-33 Architecture Specification & Issue #583
;;; =======================================================================
;;; Lowers high-level control structures (let, if, begin) into LIR blocks,
;;; performing Join Node Path Splitting and ANF Condition/Branch Flag Fusion.
;;; =======================================================================

(define (terminal-cont-call-info body bindings env)
  (cond
    ((and (pair? body) (eq? (car body) '%cont-call))
     (let* ((f-name (cadr body))
            (call-args (cddr body))
            (binding-vars (map car* bindings))
            (b-entry (assq f-name env)))
       (if (and (equal? call-args binding-vars)
                b-entry
                (pair? (cdr b-entry))
                (eq? (cadr b-entry) '%cont-target)
                (cont-target-all-regs? (cdr b-entry)))
           (list '() f-name (cdr b-entry))
           #f)))
    ((and (pair? body) (eq? (car body) 'begin) (pair? (cdr body)))
     (let loop ((es (cdr body)) (prologue '()))
       (cond
         ((null? (cdr es))
          (let ((term (car es)))
            (if (and (pair? term) (eq? (car term) '%cont-call))
                (let* ((f-name (cadr term))
                       (call-args (cddr term))
                       (binding-vars (map car* bindings))
                       (b-entry (assq f-name env)))
                  (if (and (equal? call-args binding-vars)
                           b-entry
                           (pair? (cdr b-entry))
                           (eq? (cadr b-entry) '%cont-target)
                           (cont-target-all-regs? (cdr b-entry)))
                      (list (reverse prologue) f-name (cdr b-entry))
                      #f))
                #f)))
         (else
          (loop (cdr es) (cons (car es) prologue))))))
    (else #f)))

(define (lir-compile-let bindings body si env tail?)
  (let ((term-info (terminal-cont-call-info body bindings env)))
    (cond
      ;; In-place Tail Loop Argument Shuffle: (let ((t0 e0) (t1 e1) ...) (%cont-call loop t0 t1 ...))
      ;; or (let ((t0 e0) (t1 e1) ...) (begin ... (%cont-call loop t0 t1 ...)))
      (term-info
       (let* ((prologue (car term-info))
              (f-name (cadr term-info))
              (target-info (caddr term-info))
              (exprs (map cadr bindings)))
         (for-each (lambda (p) (lir-compile-expr p si env #f)) prologue)
         (lir-compile-in-place-cont-call f-name exprs target-info si env)))

    ;; Flag / Branch Fusion on ANF: (let ((var (cmp-or-pred-expr ...))) (if var then-e else-e))
    ((and (= (length bindings) 1)
          (let* ((b (car bindings))
                 (var (car b))
                 (val (cadr b)))
            (and (pair? val)
                 (memq (car val) '(= < <= > >= eq? null? zero? pair? not))
                 (pair? body)
                 (eq? (car body) 'if)
                 (eq? (cadr body) var)
                 (not (expr-free-references-var? (caddr body) var))
                 (not (expr-free-references-var? (cdddr body) var)))))
     (let* ((b (car bindings))
            (val (cadr b))
            (then-e (caddr body))
            (else-opt (cdddr body)))
       (lir-compile-if val then-e else-opt si env tail?)))

    ;; Path Splitting on join nodes: (let ((var (if cond then-e else-e))) body)
    ((and (= (length bindings) 1)
          (let* ((b (car bindings))
                 (val (cadr b)))
            (and (pair? val)
                 (eq? (car val) 'if)
                 (<= (expr-size body) 40)
                 (let ((var (car b)))
                   (expr-has-conditional-or-pred-on-var? body var)))))
     (let* ((b (car bindings))
            (var (car b))
            (if-expr (cadr b))
            (cond-part (cadr if-expr))
            (then-e (caddr if-expr))
            (else-e (if (null? (cdddr if-expr)) #f (cadddr if-expr))))
       (lir-compile-if cond-part
                       (list 'let (list (list var then-e)) body)
                       (list (list 'let (list (list var else-e)) body))
                       si env tail?)))

    ;; Single-use argument forwarding into 1-arg %direct-call: (let ((var val)) (%direct-call label var))
    ((and (= (length bindings) 1)
          (pair? body)
          (eq? (car body) '%direct-call)
          (= (length body) 3)
          (eq? (caddr body) (caar bindings)))
     (let* ((b (car bindings))
            (val (cadr b))
            (label (cadr body))
            (cur-params-entry (assq '%num-params env))
            (cur-num-params (if cur-params-entry (cdr cur-params-entry) #f))
            (can-tco? (and tail? (if cur-num-params (= cur-num-params 1) #f)))
            (frame-shift (align-frame-shift (- 0 si))))
       (lir-compile-expr val si env #f)
       (emit-lir! '(%mov %rdi %rax))
       (if can-tco?
           (begin
             (emit-lir! '(%mov %rax 4))
             (emit-lir! (list '%direct-jump label)))
           (let* ((bitmap (compute-stackmap-bitmap frame-shift (- 0 frame-shift) '() env))
                  (safepoint-lbl (new-safepoint-label!)))
             (record-safepoint! safepoint-lbl frame-shift bitmap)
             (emit-lir! '(%mov %rax 4))
             (emit-lir! (list '%direct-call label frame-shift safepoint-lbl))))))

    (else
     (let loop ((bs bindings)
                (curr-si si)
                (new-env env))
       (if (null? bs)
           (lir-compile-expr body curr-si new-env tail?)
           (let* ((b (car bs))
                  (var (car b))
                  (val (cadr b))
                  (rvars (get-raw-vars new-env))
                  (is-raw (raw-expr? val rvars))
                  (next-rvars (if is-raw (cons var rvars) rvars))
                  (extra-bytes (stack-alloc-bytes val))
                  (svars (get-stack-vars new-env))
                  (next-svars (if (> extra-bytes 0) (cons var svars) svars))
                  (next-si (if (> extra-bytes 0)
                               (- curr-si (+ 8 extra-bytes))
                               (- curr-si 8))))
             ;; Fast path: Last binding in let where body is commutative (%raw-add prev-var var)
             (if (and (null? (cdr bs))
                      (= extra-bytes 0)
                      (pair? body)
                      (eq? (car body) '%raw-add)
                      (= (length body) 3)
                      (eq? (caddr body) var)
                      (symbol? (cadr body))
                      (not (eq? (cadr body) var))
                      (number? (env-stack-slot? (cadr body) new-env)))
                 (let ((s1 (env-stack-slot? (cadr body) new-env)))
                   (lir-compile-expr val curr-si new-env #f)
                   (emit-lir! (list '%raw-add '%rax (list '%stack s1))))
                 (begin
                   (track-lir-si! curr-si)
                   (if (> extra-bytes 0)
                       (track-lir-si! next-si))
                   (lir-compile-expr val curr-si new-env #f)
                   (emit-lir! (list '%store '%rsp curr-si '%rax))
                   (loop (cdr bs)
                         next-si
                         (cons (cons var curr-si)
                               (set-stack-vars next-svars (set-raw-vars next-rvars new-env)))))))))))))

(define (lir-compile-if test then else-opt si env tail?)
  (let ((else-label (unique-label-sym "L_else"))
        (end-label (unique-label-sym "L_end")))
    (cond
      ;; 1. Branch Fusion: binary comparisons (=, <, <=, >, >=, eq?)
      ((and (pair? test) (memq (car test) '(= < <= > >= eq?)) (= (length test) 3))
       (lir-compile-fused-cmp (car test) (cadr test) (caddr test) else-label si env))

      ;; 2. Branch Fusion: null?
      ((and (pair? test) (eq? (car test) 'null?) (= (length test) 2))
       (lir-compile-expr (cadr test) si env #f)
       (emit-lir! (list '%cmp '%rax 63))
       (emit-lir! (list '%jump-cond "jne" else-label)))

      ;; 3. Branch Fusion: zero?
      ((and (pair? test) (eq? (car test) 'zero?) (= (length test) 2))
       (let ((r (env-reg-var? (cadr test) env)))
         (if r
             (emit-lir! (list '%cmp r 0))
             (begin
               (lir-compile-expr (cadr test) si env #f)
               (emit-lir! (list '%cmp '%rax 0))))
         (emit-lir! (list '%jump-cond "jne" else-label))))

      ;; 4. Branch Fusion: pair?
      ((and (pair? test) (eq? (car test) 'pair?) (= (length test) 2))
       (lir-compile-expr (cadr test) si env #f)
       (emit-lir! '(%bit-and %rax 7))
       (emit-lir! (list '%cmp '%rax 1))
       (emit-lir! (list '%jump-cond "jne" else-label)))

      ;; 5. Branch Fusion: not
      ((and (pair? test) (eq? (car test) 'not) (= (length test) 2))
       (lir-compile-expr (cadr test) si env #f)
       (emit-lir! (list '%cmp '%rax 47))
       (emit-lir! (list '%jump-cond "jne" else-label)))

      ;; 6. Standard boolean expression fallback
      (else
       (lir-compile-expr test si env #f)
       (emit-lir! (list '%jump-if-false '%rax else-label))))

    (lir-compile-expr then si env tail?)
    (emit-lir! (list '%jump end-label (list '%rax)))
    (emit-lir! (list '%block else-label '()))
    (if (null? else-opt)
        (emit-lir! '(%mov %rax 47))
        (lir-compile-expr (car else-opt) si env tail?))
    (emit-lir! (list '%block end-label (list '%rax)))))

(define (lir-compile-begin exprs si env tail?)
  (if (null? exprs)
      (emit-lir! '(%mov %rax 63))
      (let loop ((es exprs))
        (if (null? (cdr es))
            (lir-compile-expr (car es) si env tail?)
            (begin
              (lir-compile-expr (car es) si env #f)
              (loop (cdr es)))))))
;;; =======================================================================
;;; ULisp Compiler Pass 127: LIR Runtime & Advanced Features Pass
;;; Conforms to DSN-33 Architecture Specification & Issue #583
;;; =======================================================================
;;; Lowers runtime advanced operations into LIR instructions:
;;; - Structured exception handling (%with-handler, %push-handler, %pop-handler)
;;; - Multiple values production (%values, %set-values-count, %store-values-buf)
;;; - Multiple values consumption (%call-with-values, %dispatch-consumer)
;;; - First-class continuations (%raw-call/cc, %capture-cc)
;;; =======================================================================

(define (lir-compile-with-handler handler-expr thunk-expr si env tail?)
  (let* ((exit-lbl (unique-label-sym "L_handler_exit_"))
         (catch-lbl (unique-label-sym "L_handler_catch_"))
         (handler-si si)
         (thunk-si (- si 8))
         (frame-si (- si 56))
         (call-si (- frame-si 8)))
    (track-lir-si! handler-si)
    (track-lir-si! thunk-si)
    (track-lir-si! frame-si)
    (track-lir-si! call-si)
    ;; 1. Evaluate handler closure and store at handler-si
    (lir-compile-expr handler-expr handler-si env #f)
    (emit-lir! (list '%store '%rsp handler-si '%rax))
    ;; 2. Evaluate thunk closure and store at thunk-si
    (lir-compile-expr thunk-expr thunk-si env #f)
    (emit-lir! (list '%store '%rsp thunk-si '%rax))
    ;; 3. Push handler frame: %push-handler catch-lbl frame-si handler-si
    (emit-lir! (list '%push-handler catch-lbl frame-si handler-si))
    ;; 4. Call thunk closure with 0 arguments
    (emit-lir! (list '%load '%rax '%rsp thunk-si))
    (emit-lir! '(%mov %r10 %rax))
    (let* ((frame-shift (align-frame-shift (- 0 call-si)))
           (safepoint-lbl (new-safepoint-label!))
           (bitmap (compute-stackmap-bitmap frame-shift call-si '() env)))
      (record-safepoint! safepoint-lbl frame-shift bitmap)
      (emit-lir! (list '%mov '%rax 0))
      (emit-lir! (list '%call-closure frame-shift safepoint-lbl)))
    ;; 5. Normal return from thunk: Pop handler frame and jump to exit
    (emit-lir! (list '%pop-handler frame-si))
    (emit-lir! (list '%jump exit-lbl))
    ;; 6. Exception catch entry: control arrives here on %raise
    (emit-lir! (list '%label catch-lbl))
    (let* ((frame-shift (align-frame-shift (- 0 call-si)))
           (aligned-si (- 0 frame-shift)))
      (track-lir-si! aligned-si)
      (emit-lir! (list '%store '%rsp aligned-si '%rdi))
      (emit-lir! '(%mov %r10 %rax))
      (let* ((safepoint-lbl (new-safepoint-label!))
             (bitmap (compute-stackmap-bitmap frame-shift aligned-si (list '%rdi) env)))
        (record-safepoint! safepoint-lbl frame-shift bitmap)
        (emit-lir! (list '%mov '%rax 4))
        (emit-lir! (list '%call-closure frame-shift safepoint-lbl))))
    ;; 7. Exit label
    (emit-lir! (list '%label exit-lbl))))

(define (lir-compile-values args si env)
  (let ((count (length args)))
    (cond
      ((= count 0)
       (emit-lir! (list '%set-values-count 0))
       (emit-lir! '(%mov %rax 63)))
      ((= count 1)
       (lir-compile-expr (car args) si env #f)
       (emit-lir! (list '%set-values-count 1)))
      (else
       ;; Evaluate each argument and save on stack
       (let loop ((as args) (curr-si si))
         (if (not (null? as))
             (begin
               (track-lir-si! curr-si)
               (lir-compile-expr (car as) curr-si env #f)
               (emit-lir! (list '%store '%rsp curr-si '%rax))
               (loop (cdr as) (- curr-si 8)))))
       (emit-lir! (list '%store-values-buf si count))
       (emit-lir! (list '%set-values-count count))
       ;; Load first argument to RAX
       (emit-lir! (list '%load '%rax '%rsp si))
       ;; Load second argument to RDX
       (emit-lir! (list '%load '%rdx '%rsp (- si 8)))))))

(define (lir-compile-call-with-values producer-expr consumer-expr si env tail?)
  (let* ((consumer-si si)
         (producer-si (- si 8))
         (call-si (- producer-si 8)))
    (track-lir-si! consumer-si)
    (track-lir-si! producer-si)
    (track-lir-si! call-si)
    ;; 1. Evaluate consumer closure and store at consumer-si
    (lir-compile-expr consumer-expr consumer-si env #f)
    (emit-lir! (list '%store '%rsp consumer-si '%rax))
    ;; 2. Evaluate producer closure and store at producer-si
    (lir-compile-expr producer-expr producer-si env #f)
    (emit-lir! (list '%store '%rsp producer-si '%rax))
    ;; 3. Call producer with 0 arguments (initialize default count to 1)
    (emit-lir! (list '%set-values-count 1))
    (emit-lir! (list '%load '%rax '%rsp producer-si))
    (emit-lir! '(%mov %r10 %rax))
    (let* ((frame-shift (align-frame-shift (- 0 call-si)))
           (safepoint-lbl (new-safepoint-label!))
           (bitmap (compute-stackmap-bitmap frame-shift call-si '() env)))
      (record-safepoint! safepoint-lbl frame-shift bitmap)
      (emit-lir! (list '%mov '%rax 0))
      (emit-lir! (list '%call-closure frame-shift safepoint-lbl)))
    ;; 4. Dispatch to consumer based on ulisp_values_count
    (let* ((frame-shift (align-frame-shift (- 0 call-si)))
           (aligned-si (- 0 frame-shift)))
      (track-lir-si! aligned-si)
      (track-lir-si! (- aligned-si 32))
      (emit-lir! (list '%dispatch-consumer consumer-si aligned-si frame-shift)))))

(define (lir-compile-raw-call-cc proc-expr si env tail?)
  (let* ((proc-si si)
         (k-si (- si 8))
         (call-si (- k-si 8))
         (ret-lbl (unique-label-sym "L_callcc_ret_")))
    (track-lir-si! proc-si)
    (track-lir-si! k-si)
    (track-lir-si! call-si)
    ;; 1. Evaluate proc-expr and store at proc-si
    (lir-compile-expr proc-expr proc-si env #f)
    (emit-lir! (list '%store '%rsp proc-si '%rax))
    ;; 2. Capture continuation: creates continuation object in %rax and stores to k-si
    (emit-lir! (list '%capture-cc ret-lbl k-si))
    ;; 3. Call proc with 1 argument (k)
    (emit-lir! (list '%load '%rax '%rsp k-si))
    (emit-lir! (list '%load '%r10 '%rsp proc-si))
    (let* ((frame-shift (align-frame-shift (- 0 call-si)))
           (aligned-si (- 0 frame-shift)))
      (track-lir-si! aligned-si)
      (emit-lir! (list '%store '%rsp aligned-si '%rax))
      (emit-lir! '(%mov %rdi %rax))
      (let* ((safepoint-lbl (new-safepoint-label!))
             (bitmap (compute-stackmap-bitmap frame-shift call-si (list '%rdi) env)))
        (record-safepoint! safepoint-lbl frame-shift bitmap)
        (emit-lir! (list '%mov '%rax 4))
        (emit-lir! (list '%call-closure frame-shift safepoint-lbl))))
    ;; 4. Return label: both normal return and (k val) jump here!
    (emit-lir! (list '%block ret-lbl '()))))
;;; =======================================================================
;;; ULisp Compiler Pass 128: LIR Branch & Comparison Flag Fusion
;;; Conforms to DSN-33 Architecture Specification & Issues #571, #595
;;; Fuses relational comparisons directly into conditional jumps (%jump-cond)
;;; eliminating intermediate boolean instantiation.
;;; =======================================================================

(define (lir-cmp-false-cc op)
  (case op
    ((= eq?) "jne")
    ((<)     "jge")
    ((<=)    "jg")
    ((>)     "jle")
    ((>=)    "jl")
    (else    "jne")))

(define (lir-cmp-true-cc op)
  (case op
    ((= eq?) "je")
    ((<)     "jl")
    ((<=)    "jle")
    ((>)     "jg")
    ((>=)    "jge")
    (else    "je")))

(define (lir-invert-cond-op op)
  (cond
    ((or (equal? op "je") (eq? op 'je) (eq? op 'equal) (eq? op 'zero)) "jne")
    ((or (equal? op "jne") (eq? op 'jne) (eq? op 'not-equal) (eq? op 'not-zero)) "je")
    ((or (equal? op "jl") (eq? op 'jl) (eq? op 'less)) "jge")
    ((or (equal? op "jle") (eq? op 'jle) (eq? op 'less-equal)) "jg")
    ((or (equal? op "jg") (eq? op 'jg) (eq? op 'greater)) "jle")
    ((or (equal? op "jge") (eq? op 'jge) (eq? op 'greater-equal)) "jl")
    (else "jne")))

(define (extract-fused-cmp-int e)
  (cond
    ((integer? e)
     (let ((q (quotient e 1073741824)))
       (if (or (>= q 536870912) (<= q -536870912))
           #f
           (* e 4))))
    ((and (pair? e) (eq? (car e) '%unbox-fixnum) (integer? (cadr e))) (cadr e))
    (else #f)))

(define (lir-num-cmp-slow-fn op)
  (case op
    ((=)  'ulisp_fn_num_eq)
    ((<)  'ulisp_fn_num_lt)
    ((<=) 'ulisp_fn_num_lt_eq)
    ((>)  'ulisp_fn_num_gt)
    ((>=) 'ulisp_fn_num_gt_eq)
    (else #f)))

(define (lir-compile-fused-cmp-cond op e1 e2 target-label jmp-cc-fn si env)
  (let* ((jmp-op (jmp-cc-fn op))
         (r1 (env-reg-var? e1 env))
         (r2 (env-reg-var? e2 env))
         (c1 (extract-fused-cmp-int e1))
         (c2 (extract-fused-cmp-int e2))
         (raw-vars (get-raw-vars env))
         (is-raw? (or (raw-expr? e1 raw-vars) (raw-expr? e2 raw-vars)))
         (allow-imm? (or (eq? op 'eq?) is-raw?
                         (and (integer? e1) (integer? e2))
                         (and (pair? e2) (eq? (car e2) '%unbox-fixnum))
                         (and (pair? e1) (eq? (car e1) '%unbox-fixnum)))))
    (cond
      ;; 1. e1 is reg, e2 is integer constant -> direct cmp reg, c2
      ((and r1 c2)
       (emit-lir! (list '%cmp r1 c2))
       (emit-lir! (list '%jump-cond jmp-op target-label)))

      ;; 2. e2 is reg, e1 is integer constant -> reverse comparison
      ((and r2 c1)
       (let ((rev-op (case op
                       ((= eq?) '=)
                       ((<)     '>)
                       ((<=)    '>=)
                       ((>)     '<)
                       ((>=)    '<=)
                       (else    op))))
         (emit-lir! (list '%cmp r2 c1))
         (emit-lir! (list '%jump-cond (jmp-cc-fn rev-op) target-label))))

      ;; 3. Both are register variables -> cmp r1, r2
      ((and r1 r2)
       (emit-lir! (list '%cmp r1 r2))
       (emit-lir! (list '%jump-cond jmp-op target-label)))

      ;; 4. e1 is reg, e2 is expr -> evaluate e2 to rax, then cmp r1, rax
      (r1
       (lir-compile-expr e2 si env #f)
       (emit-lir! (list '%cmp r1 '%rax))
       (emit-lir! (list '%jump-cond jmp-op target-label)))

      ;; 5. e2 is reg, e1 is expr -> evaluate e1 to rax, then cmp rax, r2
      (r2
       (lir-compile-expr e1 si env #f)
       (emit-lir! (list '%cmp '%rax r2))
       (emit-lir! (list '%jump-cond jmp-op target-label)))

      ;; 6. e2 is integer constant (raw or eq?) -> evaluate e1 to rax, then cmp rax, c2
      ((and c2 allow-imm?)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%cmp '%rax c2))
       (emit-lir! (list '%jump-cond jmp-op target-label)))

      ;; 7. e1 is integer constant (raw or eq?) -> evaluate e2 to rax, then reverse cmp rax, c1
      ((and c1 allow-imm?)
       (let ((rev-op (case op
                       ((= eq?) '=)
                       ((<)     '>)
                       ((<=)    '>=)
                       ((>)     '<)
                       ((>=)    '<=)
                       (else    op))))
         (lir-compile-operand-for-op op e2 si env)
         (emit-lir! (list '%cmp '%rax c1))
         (emit-lir! (list '%jump-cond (jmp-cc-fn rev-op) target-label))))

      ;; 8. General fallback: evaluate e1 to stack, evaluate e2 to rax
      (else
       (track-lir-si! si)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%store '%rsp si '%rax))
       (track-lir-si! (- si 8))
       (lir-compile-operand-for-op op e2 (- si 8) env)
       (let ((slow-fn (if (not is-raw?) (lir-num-cmp-slow-fn op) #f)))
         (if slow-fn
             (let ((lbl-slow (unique-label-sym "cmp_br_slow"))
                   (lbl-cont (unique-label-sym "cmp_br_cont"))
                   (jump-if-true? (string=? (jmp-cc-fn '=) "je")))
               (emit-lir! '(%mov %rdx %rax))
               (emit-lir! (list '%bit-or '%rdx (list '%stack si)))
               (emit-lir! (list '%bit-and '%rdx 3))
               (emit-lir! (list '%cmp '%rdx 0))
               (emit-lir! (list '%jump-cond "jne" lbl-slow))
               (emit-lir! (list '%cmp (list '%stack si) '%rax))
               (emit-lir! (list '%jump-cond jmp-op target-label))
               (emit-lir! (list '%jump lbl-cont))
               (emit-lir! (list '%label lbl-slow))
               (emit-lir! (list '%load '%rdi '%rsp si))
               (emit-lir! '(%mov %rsi %rax))
               (let* ((frame-shift (align-frame-shift (- 0 si)))
                      (bitmap (compute-stackmap-bitmap frame-shift (- 0 frame-shift) '() env))
                      (safepoint-lbl (new-safepoint-label!)))
                 (record-safepoint! safepoint-lbl frame-shift bitmap)
                 (emit-lir! (list '%mov '%rax 8))
                 (emit-lir! (list '%direct-call slow-fn frame-shift safepoint-lbl)))
               (emit-lir! (list '%cmp '%rax 47))
               (emit-lir! (list '%jump-cond (if jump-if-true? "jne" "je") target-label))
               (emit-lir! (list '%label lbl-cont)))
             (begin
               (emit-lir! (list '%cmp (list '%stack si) '%rax))
               (emit-lir! (list '%jump-cond jmp-op target-label)))))))))

(define (lir-compile-fused-cmp op e1 e2 else-label si env)
  (lir-compile-fused-cmp-cond op e1 e2 else-label lir-cmp-false-cc si env))

;;; -----------------------------------------------------------------------
;;; First-Class Branch Fusion Picopass Rules (DSN-33-01 T5.3)
;;; -----------------------------------------------------------------------

;; Pattern 1: (%cmp opnd1 opnd2) followed by (%set-boolean reg cond) and (%jump-if-false reg lbl)
;; -> (%cmp opnd1 opnd2) followed by (%jump-cond (invert-cc cond) lbl)
(define-picopass rule-lir-fuse-cmp-branch-invert
  (InstWindow
    (((%cmp ,opnd1 ,opnd2) (%set-boolean ,reg1 ,cond) (%jump-if-false ,reg2 ,lbl) . ,rest)
     (guard (equal? reg1 reg2))
     (cons (list '%cmp opnd1 opnd2)
           (cons (list '%jump-cond (lir-invert-cond-op cond) lbl)
                 rest)))
    (((%raw-cmp ,opnd1 ,opnd2) (%set-boolean ,reg1 ,cond) (%jump-if-false ,reg2 ,lbl) . ,rest)
     (guard (equal? reg1 reg2))
     (cons (list '%raw-cmp opnd1 opnd2)
           (cons (list '%jump-cond (lir-invert-cond-op cond) lbl)
                 rest)))))

;; Pattern 2: (%set-boolean reg cond) followed by (%jump-if-false reg lbl)
;; -> (%jump-cond (invert-cc cond) lbl)
(define-picopass rule-lir-fuse-set-boolean-branch
  (InstWindow
    (((%set-boolean ,reg1 ,cond) (%jump-if-false ,reg2 ,lbl) . ,rest)
     (guard (equal? reg1 reg2))
     (cons (list '%jump-cond (lir-invert-cond-op cond) lbl)
           rest))))

;; Pattern 3: (%cmp reg const) followed by (%jump-if-false reg2 lbl)
;; -> (%cmp reg const) followed by (%jump-cond "jne" lbl)
(define-picopass rule-lir-fuse-cmp-jne-branch
  (InstWindow
    (((%cmp ,opnd1 ,opnd2) (%jump-if-false ,reg ,lbl) . ,rest)
     (cons (list '%cmp opnd1 opnd2)
           (cons (list '%jump-cond "jne" lbl)
                 rest)))
    (((%raw-cmp ,opnd1 ,opnd2) (%jump-if-false ,reg ,lbl) . ,rest)
     (cons (list '%raw-cmp opnd1 opnd2)
           (cons (list '%jump-cond "jne" lbl)
                 rest)))))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: lir-fuse-branches (fuse-window-rules)
;;; -----------------------------------------------------------------------

(define-pass %lir-fuse-branches-window : L_lir_canonical (ir) -> L_lir_canonical ()
  (fuse-window-rules
    rule-lir-fuse-cmp-branch-invert
    rule-lir-fuse-set-boolean-branch
    rule-lir-fuse-cmp-jne-branch))

;;; -----------------------------------------------------------------------
;;; C99 Comparison Diamond, Short-Circuit & Jump Fusion (Issue #927)
;;; -----------------------------------------------------------------------

(define (%bf-c99-invert-cc cc)
  (case cc
    ((je)  'jne)
    ((jne) 'je)
    ((jl)  'jge)
    ((jge) 'jl)
    ((jle) 'jg)
    ((jg)  'jle)
    ((jb)  'jae)
    ((jae) 'jb)
    ((jbe) 'ja)
    ((ja)  'jbe)
    (else
     (cond
       ((equal? cc "je")  "jne")
       ((equal? cc "jne") "je")
       ((equal? cc "jl")  "jge")
       ((equal? cc "jge") "jl")
       ((equal? cc "jle") "jg")
       ((equal? cc "jg")  "jle")
       (else #f)))))

(define (%bf-ht-make)
  (make-vector 1024 '()))

(define (%bf-ht-ref ht sym default)
  (let* ((idx (symbol->hash-idx sym))
         (entry (assq sym (vector-ref ht idx))))
    (if entry (cdr entry) default)))

(define (%bf-ht-set! ht sym val)
  (let* ((idx (symbol->hash-idx sym))
         (bucket (vector-ref ht idx))
         (entry (assq sym bucket)))
    (if entry
        (set-cdr! entry val)
        (vector-set! ht idx (cons (cons sym val) bucket)))))

(define (%bf-ht-inc! ht sym)
  (let* ((idx (symbol->hash-idx sym))
         (bucket (vector-ref ht idx))
         (entry (assq sym bucket)))
    (if entry
        (set-cdr! entry (+ (cdr entry) 1))
        (vector-set! ht idx (cons (cons sym 1) bucket)))))

(define (%bf-c99-has-cmp-rax-zero? insts)
  (let loop ((xs insts))
    (if (null? xs)
        #f
        (let ((inst (car xs)))
          (if (and (pair? inst)
                   (eq? (car inst) '%cmp)
                   (pair? (cdr inst))
                   (eq? (cadr inst) '%rax)
                   (pair? (cddr inst))
                   (eqv? (caddr inst) 0)
                   (null? (cdddr inst)))
              #t
              (loop (cdr xs)))))))

(define (%bf-c99-drop-adjacent-jumps insts)
  ;; O(N) fast pass for Scheme & simple functions: handles Patterns B3/B4
  ;; without allocating hash tables or scanning lists twice; returns original
  ;; `insts` by eq? when unchanged.
  (let loop ((xs insts) (rev-prefix '()) (changed? #f))
    (if (null? xs)
        (if changed? (reverse rev-prefix) insts)
        (let ((i0 (car xs))
              (t1 (cdr xs)))
          (if (and (pair? t1)
                   (pair? i0)
                   (pair? (car t1))
                   (eq? (caar t1) '%label)
                   (pair? (cdar t1))
                   (let ((next-lbl (cadar t1))
                         (op (car i0)))
                     (or (and (eq? op '%jump-cond)
                              (pair? (cdr i0))
                              (pair? (cddr i0))
                              (null? (cdddr i0))
                              (eq? (caddr i0) next-lbl))
                         (and (eq? op '%direct-jump)
                              (pair? (cdr i0))
                              (eq? (cadr i0) next-lbl)))))
              (loop t1
                    (if changed?
                        rev-prefix
                        (let copy ((p insts) (acc '()))
                          (if (eq? p xs)
                              acc
                              (copy (cdr p) (cons (car p) acc)))))
                    #t)
              (loop t1
                    (if changed? (cons i0 rev-prefix) rev-prefix)
                    changed?))))))

(define (%bf-c99-count-label-refs insts)
  (let ((def-ht (%bf-ht-make))
        (refs-ht (%bf-ht-make)))
    (for-each
     (lambda (inst)
       (if (and (pair? inst) (eq? (car inst) '%label) (pair? (cdr inst)) (symbol? (cadr inst)))
           (%bf-ht-set! def-ht (cadr inst) #t)))
     insts)
    (letrec ((scan-refs
              (lambda (x)
                (cond
                  ((symbol? x)
                   (if (%bf-ht-ref def-ht x #f)
                       (%bf-ht-inc! refs-ht x)))
                  ((pair? x)
                   (scan-refs (car x))
                   (scan-refs (cdr x)))))))
      (for-each
       (lambda (inst)
         (if (not (and (pair? inst) (eq? (car inst) '%label)))
             (scan-refs inst)))
       insts))
    refs-ht))

(define (%bf-c99-build-label-map insts)
  (let ((lbl-ht (%bf-ht-make)))
    (let loop ((xs insts))
      (if (null? xs)
          lbl-ht
          (let ((inst (car xs)))
            (if (and (pair? inst) (eq? (car inst) '%label) (pair? (cdr inst)) (symbol? (cadr inst)))
                (%bf-ht-set! lbl-ht (cadr inst) (cdr xs)))
            (loop (cdr xs)))))))

(define (%bf-c99-tree-has? tree sym)
  (cond
    ((eq? tree sym) #t)
    ((pair? tree)
     (or (%bf-c99-tree-has? (car tree) sym)
         (%bf-c99-tree-has? (cdr tree) sym)))
    (else #f)))

(define (%bf-c99-rax-overwritten-before-read? insts lbl-ht depth)
  (if (> depth 8)
      #f
      (let loop ((xs insts) (steps 0))
        (cond
          ((or (null? xs) (> steps 10)) #f)
          ((not (pair? (car xs))) #f)
          (else
           (let* ((inst (car xs))
                  (op (car inst)))
             (cond
               ((eq? op '%label)
                (loop (cdr xs) steps))
               ((or (eq? op '%direct-jump) (eq? op '%jump))
                (let ((tail (and (symbol? (cadr inst)) (%bf-ht-ref lbl-ht (cadr inst) #f))))
                  (if tail
                      (%bf-c99-rax-overwritten-before-read? tail lbl-ht (+ depth 1))
                      #f)))
               ((and (eq? op '%mov) (pair? (cdr inst)) (pair? (cddr inst)) (null? (cdddr inst))
                     (eq? (cadr inst) '%rax))
                (not (%bf-c99-tree-has? (caddr inst) '%rax)))
               ((and (eq? op '%load) (pair? (cdr inst)) (pair? (cddr inst)) (pair? (cdddr inst))
                     (eq? (cadr inst) '%rax))
                (and (not (eq? (caddr inst) '%rax))
                     (not (%bf-c99-tree-has? (cadddr inst) '%rax))))
               ((and (eq? op '%load-typed) (>= (length inst) 5) (eq? (caddr inst) '%rax))
                (and (not (eq? (cadddr inst) '%rax))
                     (not (%bf-c99-tree-has? (car (cddddr inst)) '%rax))))
               ((and (case op ((%global-addr %global-ref %str-ref %code-ref %pop %load-byte-zx) #t) (else #f))
                     (pair? (cdr inst))
                     (eq? (cadr inst) '%rax))
                (if (pair? (cddr inst))
                    (not (%bf-c99-tree-has? (cddr inst) '%rax))
                    #t))
               ;; Calls read %rax only for varargs (%al) if not cleared, conservatively check %rax mention
               ((%bf-c99-tree-has? inst '%rax)
                #f)
               ((eq? op '%return)
                #f)
               ((lir-inst-terminates-block? inst)
                #f)
               (else
                (loop (cdr xs) (+ steps 1))))))))))

(define (%bf-c99-resolve-redirect redirects lbl)
  (let loop ((cur lbl) (seen '()))
    (if (memq cur seen)
        cur
        (let ((slot (assq cur redirects)))
          (if slot
              (loop (cdr slot) (cons cur seen))
              cur)))))

(define (%bf-c99-apply-redirects insts redirects)
  (if (null? redirects)
      insts
      (let ((redir-ht (%bf-ht-make)))
        (for-each (lambda (p)
                    (%bf-ht-set! redir-ht (car p) (%bf-c99-resolve-redirect redirects (car p))))
                  redirects)
        (letrec ((rw
                  (lambda (x)
                    (cond
                      ((symbol? x)
                       (or (%bf-ht-ref redir-ht x #f) x))
                      ((pair? x)
                       (cons (rw (car x)) (rw (cdr x))))
                      (else x)))))
          (map (lambda (inst)
                 (if (and (pair? inst) (eq? (car inst) '%label))
                     inst
                     (rw inst)))
               insts)))))

(define (%bf-c99-match-mov-rax-k? inst)
  (and (pair? inst)
       (eq? (car inst) '%mov)
       (pair? (cdr inst))
       (eq? (cadr inst) '%rax)
       (pair? (cddr inst))
       (null? (cdddr inst))
       (let ((k (caddr inst)))
         (or (eqv? k 0) (eqv? k 1)))))

(define (%bf-c99-cmp-rax-0? inst)
  (and (pair? inst)
       (eq? (car inst) '%cmp)
       (pair? (cdr inst))
       (eq? (cadr inst) '%rax)
       (pair? (cddr inst))
       (eqv? (caddr inst) 0)
       (null? (cdddr inst))))

(define (%bf-c99-fuse-once insts)
  (if (or (null? insts) (null? (cdr insts)))
      insts
      (let* ((refs-ht (%bf-c99-count-label-refs insts))
             (lbl-ht (%bf-c99-build-label-map insts))
             (redirect-box (cons '() '()))
             (dead-rax?
              (lambda (fallthrough target-lbl)
                (and (%bf-c99-rax-overwritten-before-read? fallthrough lbl-ht 0)
                     (let ((t-tail (and (symbol? target-lbl) (%bf-ht-ref lbl-ht target-lbl #f))))
                       (and t-tail
                            (%bf-c99-rax-overwritten-before-read? t-tail lbl-ht 0))))))
             (copy-prefix
              (lambda (stop-cell)
                (let loop ((p insts) (acc '()))
                  (if (eq? p stop-cell)
                      acc
                      (loop (cdr p) (cons (car p) acc)))))))
        (let loop ((xs insts) (acc '()) (changed? #f))
          (if (null? xs)
              (if changed?
                  (%bf-c99-apply-redirects (reverse acc) (car redirect-box))
                  insts)
              (let ((i0 (car xs))
                    (t1 (cdr xs)))
                (cond
                  ;; Pattern B1: 9-instruction C99 comparison materialization + compare-zero + branch
                  ((and (pair? i0)
                        (eq? (car i0) '%cmp)
                        (pair? t1) (pair? (cdr t1)) (pair? (cddr t1)) (pair? (cdddr t1))
                        (let ((t5 (cddddr t1)))
                          (and (pair? t5) (pair? (cdr t5)) (pair? (cddr t5)) (pair? (cdddr t5))
                               (let ((x1 (car t1))
                                     (x2 (cadr t1))
                                     (x3 (caddr t1))
                                     (x4 (cadddr t1))
                                     (x5 (car t5))
                                     (x6 (cadr t5))
                                     (x7 (caddr t5))
                                     (x8 (cadddr t5)))
                                 (and (pair? x1) (eq? (car x1) '%jump-cond)
                                      (pair? x2) (eq? (car x2) '%mov) (pair? (cdr x2)) (eq? (cadr x2) '%rax)
                                      (pair? (cddr x2)) (eqv? (caddr x2) 0) (null? (cdddr x2))
                                      (pair? x3) (eq? (car x3) '%direct-jump)
                                      (pair? x4) (eq? (car x4) '%label)
                                      (pair? x5) (eq? (car x5) '%mov) (pair? (cdr x5)) (eq? (cadr x5) '%rax)
                                      (pair? (cddr x5)) (eqv? (caddr x5) 1) (null? (cdddr x5))
                                      (pair? x6) (eq? (car x6) '%label)
                                      (%bf-c99-cmp-rax-0? x7)
                                      (pair? x8) (eq? (car x8) '%jump-cond)
                                      (eq? (caddr x1) (cadr x4))
                                      (eq? (cadr x3) (cadr x6))
                                      (symbol? (cadr x4)) (= (%bf-ht-ref refs-ht (cadr x4) 0) 1)
                                      (symbol? (cadr x6)) (= (%bf-ht-ref refs-ht (cadr x6) 0) 1)
                                      (or (eq? (cadr x8) 'je) (eq? (cadr x8) 'jne))
                                      (%bf-c99-invert-cc (cadr x1))
                                      (dead-rax? (cddddr t5) (caddr x8)))))))
                   (let* ((t5 (cddddr t1))
                          (x1 (car t1))
                          (x8 (cadddr t5))
                          (cc (cadr x1))
                          (jcc (cadr x8))
                          (target (caddr x8))
                          (fused-cc (if (eq? jcc 'je) (%bf-c99-invert-cc cc) cc))
                          (cur-acc (if changed? acc (copy-prefix xs))))
                     (loop (cddddr t5)
                           (cons (list '%jump-cond fused-cc target)
                                 (cons i0 cur-acc))
                           #t)))

                  ;; Pattern B2: Short-circuit && / || diamond tail feeding (%cmp %rax 0) (%jump-cond je/jne target)
                  ((and (%bf-c99-match-mov-rax-k? i0)
                        (pair? t1) (pair? (cdr t1)) (pair? (cddr t1)) (pair? (cdddr t1))
                        (let ((t5 (cddddr t1)))
                          (and (pair? t5) (pair? (cdr t5))
                               (let ((x1 (car t1))
                                     (x2 (cadr t1))
                                     (x3 (caddr t1))
                                     (x4 (cadddr t1))
                                     (x5 (car t5))
                                     (x6 (cadr t5)))
                                 (and (pair? x1) (eq? (car x1) '%direct-jump)
                                      (pair? x2) (eq? (car x2) '%label)
                                      (%bf-c99-match-mov-rax-k? x3)
                                      (not (= (caddr i0) (caddr x3)))
                                      (pair? x4) (eq? (car x4) '%label)
                                      (%bf-c99-cmp-rax-0? x5)
                                      (pair? x6) (eq? (car x6) '%jump-cond)
                                      (eq? (cadr x1) (cadr x4))
                                      (symbol? (cadr x4)) (= (%bf-ht-ref refs-ht (cadr x4) 0) 1)
                                      (or (eq? (cadr x6) 'je) (eq? (cadr x6) 'jne))
                                      (not (eq? (caddr x6) (cadr x2)))
                                      (not (eq? (caddr x6) (cadr x4)))
                                      (dead-rax? (cddr t5) (caddr x6)))))))
                   (let* ((t5 (cddddr t1))
                          (x2 (cadr t1))
                          (x6 (cadr t5))
                          (k1 (caddr i0))
                          (mid-lbl (cadr x2))
                          (jcc (cadr x6))
                          (target (caddr x6))
                          (k1-taken? (if (eq? jcc 'je) (= k1 0) (not (= k1 0))))
                          (cur-acc (if changed? acc (copy-prefix xs))))
                     (if k1-taken?
                         (loop (cddr t5)
                               (cons (list '%label mid-lbl)
                                     (cons (list '%direct-jump target) cur-acc))
                               #t)
                         (begin
                           (set-car! redirect-box (cons (cons mid-lbl target) (car redirect-box)))
                           (loop (cddr t5) cur-acc #t)))))

                  ;; Pattern B3: Conditional jump to immediately following label -> drop jump
                  ((and (pair? t1)
                        (pair? i0)
                        (eq? (car i0) '%jump-cond)
                        (pair? (cdr i0)) (pair? (cddr i0)) (null? (cdddr i0))
                        (pair? (car t1))
                        (eq? (caar t1) '%label)
                        (eq? (caddr i0) (cadar t1)))
                   (loop t1 (if changed? acc (copy-prefix xs)) #t))

                  ;; Pattern B4: Direct jump to immediately following label -> drop jump
                  ((and (pair? t1)
                        (pair? i0)
                        (eq? (car i0) '%direct-jump)
                        (pair? (cdr i0))
                        (pair? (car t1))
                        (eq? (caar t1) '%label)
                        (eq? (cadr i0) (cadar t1)))
                   (loop t1 (if changed? acc (copy-prefix xs)) #t))

                  (else
                   (loop t1 (if changed? (cons i0 acc) acc) changed?)))))))))

(define (lir-fuse-c99-branches-in-body insts)
  (if (or (null? insts) (null? (cdr insts)))
      insts
      (if (%bf-c99-has-cmp-rax-zero? insts)
          (let ((r1 (%bf-c99-fuse-once insts)))
            (if (eq? r1 insts)
                insts
                (let ((r2 (%bf-c99-fuse-once r1)))
                  (if (eq? r2 r1) r1 r2))))
          (%bf-c99-drop-adjacent-jumps insts))))

(define (%bf-c99-transform-clause form)
  (if (not (pair? form))
      form
      (case (car form)
        ((%lir-function)
         (let ((new-c (map (lambda (sub)
                             (if (and (pair? sub) (eq? (car sub) 'body))
                                 (let* ((ob (cdr sub))
                                        (nb (lir-fuse-c99-branches-in-body ob)))
                                   (if (eq? nb ob) sub (cons 'body nb)))
                                 sub))
                           (cdr form))))
           (cons '%lir-function new-c)))
        ((%lir-main)
         (let ((new-c (map (lambda (sub)
                             (if (and (pair? sub) (eq? (car sub) 'body))
                                 (let* ((ob (cdr sub))
                                        (nb (lir-fuse-c99-branches-in-body ob)))
                                   (if (eq? nb ob) sub (cons 'body nb)))
                                 sub))
                           (cdr form))))
           (cons '%lir-main new-c)))
        ((%lir-functions)
         (let ((nf (map %bf-c99-transform-clause (cdr form))))
           (cons '%lir-functions nf)))
        (else form))))

(define (lir-fuse-c99-branches-in-ir ir)
  (cond
    ((null? ir) '())
    ((and (pair? ir) (eq? (car ir) '%lir-program))
     (cons '%lir-program (map %bf-c99-transform-clause (cdr ir))))
    ((pair? ir)
     (if (or (eq? (car ir) '%lir-function) (eq? (car ir) '%lir-main))
         (%bf-c99-transform-clause ir)
         (lir-fuse-c99-branches-in-body ir)))
    (else ir)))

(define (lir-fuse-branches ir)
  (let* ((w (%lir-fuse-branches-window ir))
         (c (lir-fuse-c99-branches-in-ir w)))
    (if (eq? c ir) ir c)))

(define (optimize-branch-fusion insts)
  (lir-fuse-branches insts))
;;; =======================================================================
;;; ULisp Compiler Pass 129: LIR Primitive Instruction Selection
;;; =======================================================================
;;; Extracts primitive operator compilation (zero-arg, unary, binary,
;;; ternary, and raw syscall) out of the monolithic 130_lir.scm pass.
;;; =======================================================================

(define (lir-compile-zero-arg op si env)
  (let ((frame-shift (align-frame-shift (- si))))
    (case op
      ((%get-rsp)
       (emit-lir! '(%mov %rax %rsp)))
      ((%get-heap-ptr)
       (emit-lir! '(%mov %rax %r12)))
      ((%get-gc-state-ptr)
       (emit-lir! (list '%code-ref '%rax "ulisp_gc_state")))
      ((%get-environ-ptr)
       (emit-lir! (list '%code-ref '%rax "ulisp_environ")))
      ((%get-heap-limit-ptr)
       (emit-lir! (list '%code-ref '%rax "ulisp_heap_limit")))
      ((%get-stackmap-table)
       (emit-lir! (list '%code-ref '%rax "__ulisp_stackmap_table")))
      ((%get-initial-heap-ptr %get-initial-heap sys-initial-heap)
       (emit-lir! (list '%code-ref '%rax "ulisp_initial_heap")))
      ((eof-object)
       (emit-lir! (list '%mov '%rax (repr-encode-eof))))
      ((%num-args)
       (emit-lir! '(%load %rax %rsp -16)))
      ((read-char %read-char)
       (emit-lir! (list '%c-call "ulisp_read_char" frame-shift)))
      ((peek-char %peek-char)
       (emit-lir! (list '%c-call "ulisp_peek_char" frame-shift)))
      ((flush-output-port ulisp-flush)
       (emit-lir! (list '%c-call "ulisp_flush" frame-shift)))
      ((%synapse-safepoint-poll! %safepoint-poll! synapse-safepoint-poll!)
       (emit-lir! '(%memory-fence))
       (emit-lir! (list '%mov '%rax (repr-encode-void))))
      ((%memory-fence)
       (emit-lir! '(%memory-fence))
       (emit-lir! (list '%mov '%rax (repr-encode-void)))))))

(define (lir-compile-unary op arg si env)
  (if (and (eq? op '%unbox-fixnum) (integer? arg))
      (emit-lir! (list '%mov '%rax arg))
      (if (and (eq? op '%unbox-fixnum) (symbol? arg) (memq arg (get-raw-vars env)))
          (lir-compile-expr arg si env #f)
          (begin
            (lir-compile-expr arg si env #f)
            (case op
    ((-)
     (let ((lbl-slow (unique-label-sym "neg_slow"))
           (lbl-done (unique-label-sym "neg_done")))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%bit-and '%rdx (repr-fixnum-mask)))
       (emit-lir! (list '%cmp '%rdx (repr-fixnum-tag)))
       (emit-lir! (list '%jump-cond "jne" lbl-slow))
       (emit-lir! '(%mov %rcx 0))
       (emit-lir! '(%sub-overflow %rcx %rdx %rcx %rax))
       (emit-lir! '(%cmp %rdx 0))
       (emit-lir! (list '%jump-cond "jne" lbl-slow))
       (emit-lir! '(%mov %rax %rcx))
       (emit-lir! (list '%jump lbl-done))
       (emit-lir! (list '%label lbl-slow))
       (emit-lir! '(%mov %rdi %rax))
       (let* ((frame-shift (align-frame-shift (- 0 si)))
              (bitmap (compute-stackmap-bitmap frame-shift (- 0 frame-shift) '() env))
              (safepoint-lbl (new-safepoint-label!)))
         (record-safepoint! safepoint-lbl frame-shift bitmap)
         (emit-lir! '(%mov %rax 4))
         (emit-lir! (list '%direct-call 'ulisp_fn_num_ frame-shift safepoint-lbl)))
       (emit-lir! (list '%label lbl-done))))
    ((fxadd1)
     (emit-lir! (list '%add '%rax (repr-fixnum-step))))
    ((fxsub1)
     (emit-lir! (list '%sub '%rax (repr-fixnum-step))))
    ((fixnum->char integer->char)
     (emit-lir! (list '%shl '%rax (repr-char-op-shift)))
     (emit-lir! (list '%bit-or '%rax (repr-char-tag))))
    ((char->fixnum char->integer)
     (emit-lir! (list '%sar '%rax (repr-char-op-shift))))
    ((integer->symbol)
     (emit-lir! (list '%shl '%rax (repr-symbol-shift)))
     (emit-lir! (list '%bit-or '%rax (repr-symbol-tag))))
    ((symbol->integer)
     (emit-lir! (list '%sar '%rax (repr-symbol-shift))))
    ((zero?)
     (emit-lir! '(%cmp %rax 0))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((fixnum? integer? number? exact? exact-integer? real? rational? complex?)
     (emit-lir! (list '%bit-and '%rax (repr-fixnum-mask)))
     (emit-lir! (list '%cmp '%rax (repr-fixnum-tag)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((inexact?)
     (let ((lbl-true (unique-label-sym "inexact_true"))
           (lbl-false (unique-label-sym "inexact_false"))
           (lbl-done (unique-label-sym "inexact_done"))
           (flonum-sym-id (intern-symbol 'ulisp-flonum-tag)))
       ;; 1. If fixnum (rax & 3 == 0), jump to false
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%bit-and '%rdx (repr-fixnum-mask)))
       (emit-lir! (list '%cmp '%rdx (repr-fixnum-tag)))
       (emit-lir! (list '%jump-if-zero lbl-false))
       ;; 2. If %rax has flonum tag (heap tag 'flonum = 11)
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%bit-and '%rdx 15))
       (emit-lir! (list '%cmp '%rdx (repr-heap-tag 'flonum)))
       (emit-lir! (list '%jump-if-zero lbl-true))
       ;; 3. Check if %rax is a vector
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%bit-and '%rdx (repr-pointer-mask)))
       (emit-lir! (list '%cmp '%rdx (repr-heap-tag 'vector)))
       (emit-lir! (list '%jump-cond "jne" lbl-false))
       ;; 4. Load vector[0] and check if eq to 'ulisp-flonum-tag
       (emit-lir! (list '%load '%rdx '%rax 3))
       (emit-lir! (list '%mov '%rcx flonum-sym-id))
       (emit-lir! '(%cmp %rdx %rcx))
       (emit-lir! (list '%jump-if-zero lbl-true))
       ;; False branch
       (emit-lir! (list '%label lbl-false))
       (emit-lir! (list '%mov '%rax (repr-encode-boolean #f)))
       (emit-lir! (list '%jump lbl-done))
       ;; True branch
       (emit-lir! (list '%label lbl-true))
       (emit-lir! (list '%mov '%rax (repr-encode-boolean #t)))
       (emit-lir! (list '%label lbl-done))))
    ((boolean?)
     (emit-lir! '(%mov %rdx %rax))
     (emit-lir! (list '%bit-xor '%rdx (repr-encode-boolean #f)))
     (emit-lir! (list '%bit-and '%rdx (repr-boolean-mask)))
     (emit-lir! '(%cmp %rdx 0))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((char?)
     (emit-lir! (list '%bit-and '%rax (repr-char-mask)))
     (emit-lir! (list '%cmp '%rax (repr-char-tag)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((null?)
     (emit-lir! (list '%cmp '%rax (repr-encode-null)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((not)
     (emit-lir! (list '%cmp '%rax (repr-encode-boolean #f)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((symbol?)
     (emit-lir! (list '%bit-and '%rax (repr-symbol-mask)))
     (emit-lir! (list '%cmp '%rax (repr-symbol-tag)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((car)
     (emit-lir! (list '%load '%rax '%rax (repr-field-offset 'pair 0))))
    ((cdr)
     (emit-lir! (list '%load '%rax '%rax (repr-field-offset 'pair 8))))
    ((pair? procedure?)
     (emit-lir! (list '%bit-and '%rax (repr-pointer-mask)))
     (emit-lir! (list '%cmp '%rax (repr-heap-tag 'pair)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((string?)
     (emit-lir! (list '%bit-and '%rax (repr-pointer-mask)))
     (emit-lir! (list '%cmp '%rax (repr-heap-tag 'string)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((bytevector?)
     (emit-lir! (list '%bit-and '%rax (repr-pointer-mask)))
     (emit-lir! (list '%cmp '%rax (repr-heap-tag 'bytevector)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((vector?)
     (emit-lir! (list '%bit-and '%rax (repr-pointer-mask)))
     (emit-lir! (list '%cmp '%rax (repr-heap-tag 'vector)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((write-char %write-char write-byte write-u8)
     (let ((frame-shift (align-frame-shift (- si))))
       (emit-lir! '(%mov %rdi %rax))
       (emit-lir! (list '%c-call "ulisp_write_char" frame-shift))))
    ((write-string %write-string)
     (let ((frame-shift (align-frame-shift (- si))))
       (emit-lir! '(%mov %rdi %rax))
       (emit-lir! (list '%c-call "ulisp_write_string" frame-shift))))
    ((flush-output-port ulisp-flush)
     (let ((frame-shift (align-frame-shift (- si))))
       (emit-lir! (list '%c-call "ulisp_flush" frame-shift))))
    ((raise %raise)
     (emit-lir! '(%raise)))
    ((eof-object?)
     (emit-lir! (list '%cmp '%rax (repr-encode-eof)))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((%set-heap-ptr!)
     (emit-lir! '(%mov %r12 %rax)))
    ((%ptr-tag)
     (emit-lir! (list '%bit-and '%rax (repr-pointer-mask)))
     (if (> (repr-fixnum-shift) 0)
         (emit-lir! (list '%shl '%rax (repr-fixnum-shift)))))
    ((%ptr-untag)
     (emit-lir! (list '%bit-and '%rax (repr-pointer-untag-mask))))
    ((%to-raw)
     (if (> (repr-fixnum-shift) 0)
         (emit-lir! (list '%sar '%rax (repr-fixnum-shift)))))
    ((%to-fixnum)
     (if (> (repr-fixnum-shift) 0)
         (emit-lir! (list '%shl '%rax (repr-fixnum-shift)))))
    ((%box-fixnum)
     (emit-lir! '(%box-fixnum %rax %rax)))
    ((%unbox-fixnum)
     (emit-lir! '(%unbox-fixnum %rax %rax)))
    ((%box-flonum)
     (emit-lir! '(%box-flonum %rax %xmm0)))
    ((%unbox-flonum)
     (emit-lir! '(%unbox-flonum %xmm0 %rax)))
    ((%sitofp)
     (emit-lir! '(%sitofp %xmm0 %rax)))
    ((%fptosi)
     (emit-lir! '(%fptosi %rax %xmm0)))
    ((make-string)
     (emit-lir! '(%sar %rax 2))
     (emit-lir! '(%mov %rcx %rax))
     (emit-lir! '(%add %rax 8))
     (emit-lir! '(%bit-and %rax -8))
     (emit-lir! '(%mov %rdx %rax))
     (emit-lir! '(%shl %rdx 16))
     (emit-lir! '(%bit-or %rdx 3))
     (emit-lir! '(%shl %rdx 2))
     (emit-lir! '(%store %r12 0 %rdx))
     (emit-lir! '(%mov %rdx %r12))
     (emit-lir! '(%add %rdx 8))
     (emit-lir! '(%add %rax 8))
     (emit-lir! '(%add %r12 %rax))
     (emit-lir! '(%store-byte %rdx %rcx 0))
     (emit-lir! '(%add %rdx 3))
     (emit-lir! '(%mov %rax %rdx)))
    ((string-length)
     (let ((l-loop (unique-label-sym "strlen_loop"))
           (l-done (unique-label-sym "strlen_done")))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! '(%sub %rdx 3))
       (emit-lir! '(%mov %rax 0))
       (emit-lir! (list '%label l-loop))
       (emit-lir! '(%load-byte-zx %rcx %rdx %rax))
       (emit-lir! '(%cmp %rcx 0))
       (emit-lir! (list '%jump-if-zero l-done))
       (emit-lir! '(%inc %rax))
       (emit-lir! (list '%jump l-loop))
       (emit-lir! (list '%label l-done))
       (emit-lir! '(%shl %rax 2))))
    ((bytevector-length)
     (emit-lir! '(%sub %rax 7))
     (emit-lir! '(%load %rax %rax 0)))
    ((make-bytevector %make-bytevector)
     (let ((l-loop (unique-label-sym "bv_zero_loop"))
           (l-done (unique-label-sym "bv_zero_done")))
       (emit-lir! '(%sar %rax 2))
       (emit-lir! '(%mov %rcx %rax))
       (emit-lir! '(%add %rax 15))
       (emit-lir! '(%bit-and %rax -8))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! '(%shl %rdx 16))
       (emit-lir! '(%bit-or %rdx 4))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 0 %rdx))
       (emit-lir! '(%mov %rdx %rcx))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 8 %rdx))
       (emit-lir! '(%mov %r10 0))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%label l-loop))
       (emit-lir! (list '%cmp '%rdx 8))
       (emit-lir! (list '%jump-if-zero l-done))
       (emit-lir! '(%store %r12 %rdx %r10))
       (emit-lir! '(%sub %rdx 8))
       (emit-lir! (list '%jump l-loop))
       (emit-lir! (list '%label l-done))
       (emit-lir! '(%mov %rcx %r12))
       (emit-lir! '(%add %rcx 15))
       (emit-lir! '(%add %rax 8))
       (emit-lir! '(%add %r12 %rax))
       (emit-lir! '(%mov %rax %rcx))))
    ((vector-length)
     (emit-lir! '(%sub %rax 5))
     (emit-lir! '(%load %rax %rax 0)))
    ((make-vector %make-vector)
     (let ((l-loop (unique-label-sym "vec_init_loop"))
           (l-done (unique-label-sym "vec_init_done")))
       (emit-lir! '(%sar %rax 2))
       (emit-lir! '(%mov %rcx %rax))
       (emit-lir! '(%shl %rax 3))
       (emit-lir! '(%add %rax 8))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! '(%shl %rdx 16))
       (emit-lir! '(%bit-or %rdx 5))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 0 %rdx))
       (emit-lir! '(%mov %rdx %rcx))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 8 %rdx))
       (emit-lir! '(%mov %r10 47))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%label l-loop))
       (emit-lir! (list '%cmp '%rdx 8))
       (emit-lir! (list '%jump-if-zero l-done))
       (emit-lir! '(%store %r12 %rdx %r10))
       (emit-lir! '(%sub %rdx 8))
       (emit-lir! (list '%jump l-loop))
       (emit-lir! (list '%label l-done))
       (emit-lir! '(%mov %rcx %r12))
       (emit-lir! '(%add %rcx 13))
       (emit-lir! '(%add %rax 8))
       (emit-lir! '(%add %r12 %rax))
       (emit-lir! '(%mov %rax %rcx)))))))))

(define (lir-compile-operand-for-op op e si env)
  (if (and (integer? e) (memq op '(%raw-add %raw-sub %raw-mul %raw-cmp)))
      (emit-lir! (list '%mov '%rax e))
      (lir-compile-expr e si env #f)))

(define (env-reg-var? e env)
  (and (symbol? e)
       (let ((b (assq e env)))
         (and b
              (let ((info (cdr b)))
                (cond
                  ((and (pair? info) (eq? (car info) 'reg)) (cdr info))
                  ((memq info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15)) info)
                  (else #f)))))))

(define (env-stack-slot? e env)
  (and (symbol? e)
       (let ((b (assq e env)))
         (and b
              (let ((info (cdr b)))
                (cond
                  ((number? info) info)
                  ((and (pair? info) (eq? (car info) 'param)) (cdr info))
                  (else #f)))))))

(define (lir-emit-bin-slow-call! slow-fn si env)
  (emit-lir! (list '%load '%rdi '%rsp si))
  (emit-lir! '(%mov %rsi %rax))
  (let* ((frame-shift (align-frame-shift (- 0 si)))
         (bitmap (compute-stackmap-bitmap frame-shift (- 0 frame-shift) '() env))
         (safepoint-lbl (new-safepoint-label!)))
    (record-safepoint! safepoint-lbl frame-shift bitmap)
    (emit-lir! (list '%mov '%rax 8))
    (emit-lir! (list '%direct-call slow-fn frame-shift safepoint-lbl))))

(define (lir-compile-relop cc slow-fn si env)
  (if (not slow-fn)
      (begin
        (emit-lir! (list '%cmp (list '%stack si) '%rax))
        (emit-lir! (list '%set-boolean '%rax cc)))
      (let ((lbl-slow (unique-label-sym "cmp_slow"))
            (lbl-done (unique-label-sym "cmp_done")))
        (emit-lir! '(%mov %rdx %rax))
        (emit-lir! (list '%bit-or '%rdx (list '%stack si)))
        (emit-lir! (list '%bit-and '%rdx 3))
        (emit-lir! (list '%cmp '%rdx 0))
        (emit-lir! (list '%jump-cond "jne" lbl-slow))
        (emit-lir! (list '%cmp (list '%stack si) '%rax))
        (emit-lir! (list '%set-boolean '%rax cc))
        (emit-lir! (list '%jump lbl-done))
        (emit-lir! (list '%label lbl-slow))
        (lir-emit-bin-slow-call! slow-fn si env)
        (emit-lir! (list '%label lbl-done)))))

(define (lir-compile-binop op e1 e2 si env)
  (let ((r1 (env-reg-var? e1 env))
        (r2 (env-reg-var? e2 env))
        (s2 (env-stack-slot? e2 env))
        (raw-vars (get-raw-vars env))
        (lir-op (case op
                  ((+) '%add)
                  ((-) '%sub)
                  (else op))))
    (cond
      ;; Fast path: op is + or %raw-add and e2 is a register variable
      ((and (memq op '(+ %raw-add)) r2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list lir-op '%rax r2)))
      ;; Fast path: op is + or %raw-add and e1 is a register variable
      ((and (memq op '(+ %raw-add)) r1)
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list lir-op '%rax r1)))
      ;; Fast path: op is - or %raw-sub and e2 is a register variable
      ((and (memq op '(- %raw-sub)) r2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list lir-op '%rax r2)))
      ;; Fast path: op is %raw-add and e2 is an integer constant
      ((and (eq? op '%raw-add) (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%raw-add '%rax e2)))
      ;; Fast path: op is %raw-add and e1 is an integer constant
      ((and (eq? op '%raw-add) (integer? e1) (>= e1 -268435456) (<= e1 268435455))
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list '%raw-add '%rax e1)))
      ;; Fast path: op is %raw-sub and e2 is an integer constant
      ((and (eq? op '%raw-sub) (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%raw-sub '%rax e2)))
      ;; Fast path: op is + and e1 is a register variable and e2 is an integer constant
      ((and (eq? op '+) r1 (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%add '%rax (* e2 4))))
      ;; Fast path: op is + and e2 is a register variable and e1 is an integer constant
      ((and (eq? op '+) r2 (integer? e1) (>= e1 -268435456) (<= e1 268435455))
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list '%add '%rax (* e1 4))))
      ;; Fast path: op is - and e1 is a register variable and e2 is an integer constant
      ((and (eq? op '-) r1 (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%sub '%rax (* e2 4))))
      ;; Fast path: op is %raw-add / %raw-sub and e2 is a stack variable
      ((and (memq op '(%raw-add %raw-sub)) s2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list lir-op '%rax (list '%stack s2))))
      ;; Fast path: op is = and e1 is a register variable with compatible e2
      ((and (eq? op '=) r1 (or (integer? e2) r2 (raw-expr? e2 raw-vars)))
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list '%cmp r1 '%rax))
       (emit-lir! '(%set-boolean %rax "sete")))
      ;; Fast path: op is = and e2 is a register variable with compatible e1
      ((and (eq? op '=) r2 (or (integer? e1) r1 (raw-expr? e1 raw-vars)))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%cmp '%rax r2))
       (emit-lir! '(%set-boolean %rax "sete")))
      (else
       ;; Standard stack-based path
       (track-lir-si! si)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%store '%rsp si '%rax))
       (track-lir-si! (- si 8))
       (lir-compile-operand-for-op op e2 (- si 8) env)
       (case op
         ((+)
          (let ((lbl-slow (unique-label-sym "add_slow"))
                (lbl-done (unique-label-sym "add_done")))
            (emit-lir! '(%mov %rdx %rax))
            (emit-lir! (list '%bit-or '%rdx (list '%stack si)))
            (emit-lir! (list '%bit-and '%rdx 3))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! '(%mov %rcx %rax))
            (emit-lir! (list '%add-overflow '%rcx '%rdx '%rcx (list '%stack si)))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! '(%mov %rax %rcx))
            (emit-lir! (list '%jump lbl-done))
            (emit-lir! (list '%label lbl-slow))
            (lir-emit-bin-slow-call! 'ulisp_fn_num_plus si env)
            (emit-lir! (list '%label lbl-done))))
         ((-)
          (let ((lbl-slow (unique-label-sym "sub_slow"))
                (lbl-done (unique-label-sym "sub_done")))
            (emit-lir! '(%mov %rdx %rax))
            (emit-lir! (list '%bit-or '%rdx (list '%stack si)))
            (emit-lir! (list '%bit-and '%rdx 3))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! (list '%mov '%rcx (list '%stack si)))
            (emit-lir! '(%sub-overflow %rcx %rdx %rcx %rax))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! '(%mov %rax %rcx))
            (emit-lir! (list '%jump lbl-done))
            (emit-lir! (list '%label lbl-slow))
            (lir-emit-bin-slow-call! 'ulisp_fn_num_ si env)
            (emit-lir! (list '%label lbl-done))))
         ((*)
          (let ((lbl-slow (unique-label-sym "mul_slow"))
                (lbl-done (unique-label-sym "mul_done")))
            (emit-lir! '(%mov %rdx %rax))
            (emit-lir! (list '%bit-or '%rdx (list '%stack si)))
            (emit-lir! (list '%bit-and '%rdx 3))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! '(%mov %rcx %rax))
            (emit-lir! '(%sar %rcx 2))
            (emit-lir! (list '%mul-overflow '%rcx '%rdx '%rcx (list '%stack si)))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! '(%mov %rax %rcx))
            (emit-lir! (list '%jump lbl-done))
            (emit-lir! (list '%label lbl-slow))
            (lir-emit-bin-slow-call! 'ulisp_fn_num_star si env)
            (emit-lir! (list '%label lbl-done))))
         ((%raw-add)
          (emit-lir! (list '%raw-add '%rax (list '%stack si))))
         ((%raw-sub)
          (emit-lir! (list '%mov '%rdx (list '%stack si)))
          (emit-lir! '(%raw-sub %rdx %rax))
          (emit-lir! '(%mov %rax %rdx)))
         ((%raw-mul)
          (emit-lir! (list '%raw-mul '%rax (list '%stack si))))
         ((%raw-cmp)
          (emit-lir! (list '%raw-cmp (list '%stack si) '%rax)))
         ((modulo)
          (let ((lbl-slow (unique-label-sym "mod_slow"))
                (lbl-done (unique-label-sym "mod_done")))
            (emit-lir! '(%mov %rdx %rax))
            (emit-lir! (list '%bit-or '%rdx (list '%stack si)))
            (emit-lir! (list '%bit-and '%rdx 3))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! '(%cmp %rax 0))
            (emit-lir! (list '%jump-if-zero lbl-slow))
            (emit-lir! '(%cmp %rax -4))
            (emit-lir! (list '%jump-if-zero lbl-slow))
            (emit-lir! '(%mov %rcx %rax))
            (emit-lir! (list '%load '%rax '%rsp si))
            (emit-lir! '(%sar %rax 2))
            (emit-lir! '(%sar %rcx 2))
            (emit-lir! '(%cqo))
            (emit-lir! '(%idiv %rcx))
            (let ((l-pos (unique-label-sym "mod_pos")))
              (emit-lir! (list '%cmp '%rdx 0))
              (emit-lir! (list '%jump-if-zero l-pos))
              (emit-lir! '(%mov %r10 %rdx))
              (emit-lir! '(%bit-xor %r10 %rcx))
              (emit-lir! (list '%cmp '%r10 0))
              (emit-lir! (list '%jump-cond "jge" l-pos))
              (emit-lir! '(%add %rdx %rcx))
              (emit-lir! (list '%label l-pos)))
            (emit-lir! '(%mov %rax %rdx))
            (emit-lir! '(%shl %rax 2))
            (emit-lir! (list '%jump lbl-done))
            (emit-lir! (list '%label lbl-slow))
            (lir-emit-bin-slow-call! 'ulisp_fn_num_modulo si env)
            (emit-lir! (list '%label lbl-done))))
         ((/)
          (lir-emit-bin-slow-call! 'ulisp_fn_num_slash si env))
         ((quotient)
          (let ((lbl-slow (unique-label-sym "quot_slow"))
                (lbl-done (unique-label-sym "quot_done")))
            (emit-lir! '(%mov %rdx %rax))
            (emit-lir! (list '%bit-or '%rdx (list '%stack si)))
            (emit-lir! (list '%bit-and '%rdx 3))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-cond "jne" lbl-slow))
            (emit-lir! '(%cmp %rax 0))
            (emit-lir! (list '%jump-if-zero lbl-slow))
            (emit-lir! '(%cmp %rax -4))
            (emit-lir! (list '%jump-if-zero lbl-slow))
            (emit-lir! '(%mov %rcx %rax))
            (emit-lir! (list '%load '%rax '%rsp si))
            (emit-lir! '(%sar %rax 2))
            (emit-lir! '(%sar %rcx 2))
            (emit-lir! '(%cqo))
            (emit-lir! '(%idiv %rcx))
            (emit-lir! '(%shl %rax 2))
            (emit-lir! (list '%jump lbl-done))
            (emit-lir! (list '%label lbl-slow))
            (lir-emit-bin-slow-call! 'ulisp_fn_num_quotient si env)
            (emit-lir! (list '%label lbl-done))))
         ((%udiv)
          (emit-lir! '(%mov %rcx %rax))
          (emit-lir! (list '%load '%rax '%rsp si))
          (emit-lir! '(%udiv %rax %rax %rcx)))
         ((%urem)
          (emit-lir! '(%mov %rcx %rax))
          (emit-lir! (list '%load '%rax '%rsp si))
          (emit-lir! '(%urem %rax %rax %rcx)))
         ((string-ref)
          (let ((raw-idx? (raw-expr? e2 (get-raw-vars env))))
            (if raw-idx?
                (begin
                  (emit-lir! (list '%load '%rdx '%rsp si))
                  (emit-lir! (list '%load-byte-zx '%rax '%rdx '(%sib %rax 1 -3)))
                  (emit-lir! '(%shl %rax 8))
                  (emit-lir! '(%bit-or %rax 14)))
                (begin
                  (emit-lir! '(%sar %rax 2))
                  (emit-lir! (list '%load '%rdx '%rsp si))
                  (emit-lir! (list '%load-byte-zx '%rax '%rdx '(%sib %rax 1 -3)))
                  (emit-lir! '(%shl %rax 8))
                  (emit-lir! '(%bit-or %rax 14))))))
         ((bytevector-u8-ref)
          (let ((raw-idx? (raw-expr? e2 (get-raw-vars env))))
            (if raw-idx?
                (begin
                  (emit-lir! (list '%load '%rdx '%rsp si))
                  (emit-lir! (list '%load-byte-zx '%rax '%rdx '(%sib %rax 1 1)))
                  (emit-lir! '(%shl %rax 2)))
                (begin
                  (emit-lir! '(%sar %rax 2))
                  (emit-lir! (list '%load '%rdx '%rsp si))
                  (emit-lir! (list '%load-byte-zx '%rax '%rdx '(%sib %rax 1 1)))
                  (emit-lir! '(%shl %rax 2))))))
         ((vector-ref)
          (let ((raw-idx? (raw-expr? e2 (get-raw-vars env))))
            (emit-lir! (list '%load '%rdx '%rsp si))
            (if raw-idx?
                (emit-lir! (list '%load '%rax '%rdx '(%sib %rax 8 3)))
                (emit-lir! (list '%load '%rax '%rdx '(%sib %rax 2 3))))))
         ((= < <= > >=)
          (let ((cc (case op
                      ((=) "sete") ((<) "setl") ((<=) "setle") ((>) "setg") (else "setge")))
                (slow (and (not (or (raw-expr? e1 raw-vars) (raw-expr? e2 raw-vars)))
                           (case op
                             ((=) 'ulisp_fn_num_eq)
                             ((<) 'ulisp_fn_num_lt)
                             ((<=) 'ulisp_fn_num_lt_eq)
                             ((>) 'ulisp_fn_num_gt)
                             (else 'ulisp_fn_num_gt_eq)))))
            (lir-compile-relop cc slow si env)))
         ((bitwise-and)
          (emit-lir! (list '%bit-and '%rax (list '%stack si))))
         ((bitwise-ior)
          (emit-lir! (list '%bit-or '%rax (list '%stack si))))
         ((%raw-load)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%add %rdx %rax))
          (emit-lir! '(%load %rax %rdx 0)))
         ((%raw-load-u8)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! (list '%load-byte-zx '%rax '%rdx '%rax))
          (emit-lir! '(%shl %rax 2)))
         ((%ptr-add %ptr-tag-add)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%add '%rax (list '%stack si))))
         ((cons)
          (emit-lir! (list '%store '%rsp (- si 8) '%rax))
          (emit-lir! (list '%alloc '%rax 24 9 (- si 8)))
          (emit-lir! '(%mov %rdx 4196356))
          (emit-lir! '(%store %rax -9 %rdx))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%store %rax -1 %rdx))
          (emit-lir! (list '%load '%rdx '%rsp (- si 8)))
          (emit-lir! '(%store %rax 7 %rdx)))
         ((set-car!)
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%store %rdx -1 %rax))
          (emit-lir! '(%mov %rax 63)))
         ((set-cdr!)
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%store %rdx 7 %rax))
          (emit-lir! '(%mov %rax 63)))
         ((eq? eqv? char=?)
          (emit-lir! (list '%cmp (list '%stack si) '%rax))
          (emit-lir! '(%set-boolean %rax "sete")))
         ((boolean=?)
          (emit-lir! (list '%mov '%rdx (list '%stack si)))
          (emit-lir! '(%bit-xor %rdx %rax))
          (emit-lir! '(%bit-xor %rax 47))
          (emit-lir! '(%bit-and %rax -65))
          (emit-lir! '(%bit-or %rax %rdx))
          (emit-lir! '(%cmp %rax 0))
          (emit-lir! '(%set-boolean %rax "sete")))
         ((symbol=?)
          (emit-lir! (list '%mov '%rdx (list '%stack si)))
          (emit-lir! '(%bit-xor %rdx %rax))
          (emit-lir! '(%bit-xor %rax 2))
          (emit-lir! '(%bit-and %rax 255))
          (emit-lir! '(%bit-or %rax %rdx))
          (emit-lir! '(%cmp %rax 0))
          (emit-lir! '(%set-boolean %rax "sete"))))))))

(define (lir-compile-triop op e1 e2 e3 si env)
  (track-lir-si! si)
  (lir-compile-expr e1 si env #f)
  (emit-lir! (list '%store '%rsp si '%rax))
  (track-lir-si! (- si 8))
  (lir-compile-expr e2 (- si 8) env #f)
  (emit-lir! (list '%store '%rsp (- si 8) '%rax))
  (track-lir-si! (- si 16))
  (lir-compile-expr e3 (- si 16) env #f)
  (case op
    ((string-set!)
     (emit-lir! '(%shr %rax 8))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%sub %rdx 3))
     (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
     (emit-lir! '(%sar %rcx 2))
     (emit-lir! '(%store-byte %rdx %rcx %al))
     (emit-lir! '(%mov %rax 63)))
    ((bytevector-u8-set!)
     (emit-lir! '(%sar %rax 2))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%sub %rdx 7))
     (emit-lir! '(%add %rdx 8))
     (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
     (emit-lir! '(%sar %rcx 2))
     (emit-lir! '(%store-byte %rdx %rcx %al))
     (emit-lir! '(%mov %rax 63)))
    ((vector-set!)
     (let ((raw-idx? (raw-expr? e2 (get-raw-vars env))))
       (emit-lir! '(%mov %r10 %rax))
       (emit-lir! (list '%load '%rdx '%rsp si))
       (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
       (if raw-idx?
           (emit-lir! (list '%store '%rdx '(%sib %rcx 8 3) '%r10))
           (emit-lir! (list '%store '%rdx '(%sib %rcx 2 3) '%r10)))
       (emit-lir! '(%mov %rax 63))))
    ((%raw-store!)
     (emit-lir! '(%mov %r10 %rax))
     (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
     (emit-lir! '(%sar %rcx 2))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%add %rdx %rcx))
     (emit-lir! '(%store %rdx 0 %r10))
     (emit-lir! '(%mov %rax 63)))
    ((%atomic-cas!)
     (emit-lir! '(%mov %rcx %rax))
     (emit-lir! (list '%load '%rax '%rsp (- si 8)))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%atomic-cas! %rax %rdx %rcx)))))

(define (lir-compile-raw-syscall args si env)
  (let ((num (car args))
        (a1 (car (cdr args)))
        (a2 (car (cdr (cdr args))))
        (a3 (car (cdr (cdr (cdr args)))))
        (a4 (car (cdr (cdr (cdr (cdr args))))))
        (a5 (car (cdr (cdr (cdr (cdr (cdr args)))))))
        (a6 (car (cdr (cdr (cdr (cdr (cdr (cdr args)))))))))
    (track-lir-si! si)
    (lir-compile-expr num si env #f)
    (emit-lir! (list '%store '%rsp si '%rax))
    (track-lir-si! (- si 8))
    (lir-compile-expr a1 (- si 8) env #f)
    (emit-lir! (list '%store '%rsp (- si 8) '%rax))
    (track-lir-si! (- si 16))
    (lir-compile-expr a2 (- si 16) env #f)
    (emit-lir! (list '%store '%rsp (- si 16) '%rax))
    (track-lir-si! (- si 24))
    (lir-compile-expr a3 (- si 24) env #f)
    (emit-lir! (list '%store '%rsp (- si 24) '%rax))
    (track-lir-si! (- si 32))
    (lir-compile-expr a4 (- si 32) env #f)
    (emit-lir! (list '%store '%rsp (- si 32) '%rax))
    (track-lir-si! (- si 40))
    (lir-compile-expr a5 (- si 40) env #f)
    (emit-lir! (list '%store '%rsp (- si 40) '%rax))
    (track-lir-si! (- si 48))
    (lir-compile-expr a6 (- si 48) env #f)
    (emit-lir! (list '%store '%rsp (- si 48) '%rax))
    (emit-lir! (list '%syscall si))))
;;; =======================================================================
;;; ULisp Compiler Pass 130: Low-Level Intermediate Representation (LIR)
;;; Conforms to DSN-33 Architecture Specification & Issue #583
;;; =======================================================================
;;; Core LIR Orchestrator:
;;; - Accumulator and stack tracking state (*lir-instructions*, *lir-min-si*)
;;; - Environment and raw-variable tracking (get-raw-vars, set-raw-vars, raw-expr?)
;;; - Immediate and variable resolution (immediate?, lir-immediate, lir-compile-variable)
;;; - Expression compiler dispatcher (lir-compile-expr) orchestrating modular sub-passes:
;;;     * Pass 123: LIR Closures & Stack Allocation (passes/123_lir_closures.scm)
;;;     * Pass 124: LIR Procedure Invocations & Call ABI (passes/124_lir_call_abi.scm)
;;;     * Pass 125: LIR Continuation Transfer & Loop In-Place Shuffle (passes/125_lir_continuation.scm)
;;;     * Pass 126: LIR Control Flow & Join Path Splitting (passes/126_lir_control.scm)
;;;     * Pass 127: LIR Runtime & Advanced Features (passes/127_lir_runtime.scm)
;;;     * Pass 128: LIR Branch & Comparison Flag Fusion (passes/128_lir_branch_fusion.scm)
;;;     * Pass 129: LIR Primitive Instruction Selection (passes/129_lir_primitives.scm)
;;; - Function and Program level compilation entrypoints (lir-compile-function, generate-lir)
;;; =======================================================================

;;; Boxed accumulators for LIR instructions and stack tracking
(define *lir-instructions* (cons '() '()))
(define *lir-min-si* (cons 0 '()))
(define *stack-alloc-attr* (string->symbol ":stack-alloc"))
(define (stack-alloc-attr? attr)
  (or (eq? attr *stack-alloc-attr*)
      (eq? attr 'stack-alloc)
      (and (symbol? attr)
           (let ((s (symbol->string attr)))
             (or (string=? s ":stack-alloc")
                 (string=? s "#:stack-alloc")
                 (string=? s "stack-alloc"))))))
(define (get-raw-vars env)
  (let ((entry (assq '%raw-vars env)))
    (if entry (cdr entry) '())))

(define (set-raw-vars rvars env)
  (cons (cons '%raw-vars rvars) env))

(define (raw-expr? expr raw-env)
  (cond
    ((not (pair? expr))
     (and (symbol? expr) (memq expr raw-env)))
    ((memq (car expr) '(%raw-add %raw-sub %raw-mul %raw-cmp %raw-load %raw-syscall %to-raw %unbox-fixnum
                        %load-typed %fadd %fsub %fmul %fdiv %fcmp %unbox-flonum %sitofp %fptosi
                        %udiv %urem %shr %setb %setbe %seta %setae
                        %add-overflow %sub-overflow %mul-overflow %inline-asm))
     #t)
    ((and (eq? (car expr) '%direct-call)
          (pair? (cdr expr))
          (unboxed-ret-fn? (cadr expr)))
     #t)
    ((and (symbol? (car expr))
          (unboxed-ret-fn? (car expr)))
     #t)
    ((eq? (car expr) 'let)
     (raw-expr? (caddr expr) raw-env))
    ((eq? (car expr) 'if)
     (and (raw-expr? (caddr expr) raw-env)
          (pair? (cdddr expr))
          (raw-expr? (cadddr expr) raw-env)))
    (else #f)))

(define (reset-lir!)
  (set-car! *lir-instructions* '())
  (set-car! *lir-min-si* 0))

(define (emit-lir! inst)
  (set-car! *lir-instructions* (cons inst (car *lir-instructions*))))

(define (track-lir-si! si)
  (if (< si (car *lir-min-si*))
      (set-car! *lir-min-si* si)))

(define (immediate? expr)
  (or (integer? expr)
      (boolean? expr)
      (char? expr)
      (null? expr)
      (string? expr)))

(define (lir-immediate expr)
  (cond
    ((or (integer? expr) (boolean? expr) (char? expr) (null? expr))
     (repr-encode-immediate expr))
    ((string? expr)
     (let ((label (intern-string expr)))
       (list '%string-ref label)))))

(define (lir-compile-immediate expr)
  (if (and (integer? expr)
           (not (repr-nan-boxed-with? (current-value-repr)))
           (= (repr-fixnum-tag) 0)
           (> (repr-fixnum-shift) 0)
           (let ((q (quotient expr 1073741824)))
             (or (>= q 536870912) (<= q -536870912))))
      (begin
        (emit-lir! (list '%mov '%rax expr))
        (emit-lir! (list '%shl '%rax (repr-fixnum-shift))))
      (let ((val (lir-immediate expr)))
        (if (and (pair? val) (eq? (car val) '%string-ref))
            (emit-lir! (list '%str-ref '%rax (cadr val)))
            (emit-lir! (list '%mov '%rax val))))))

(define (lir-compile-variable var env)
  (let ((binding (assq var env)))
    (if (not binding)
        (if (or (allow-extern-symbols?) (stdlib-symbol? var))
            (emit-lir! (list '%global-ref '%rax var))
            (begin
              (dump-lir-unbound-variable-diagnostic var env)
              (error (string-append "Unbound variable in LIR: " (symbol->string var)) var)))
        (let ((info (cdr binding)))
          (cond
            ((number? info)
             (emit-lir! (list '%load '%rax '%rsp info)))
            ((and (pair? info) (eq? (car info) 'reg))
             (let ((reg (cdr info)))
               (if (not (eq? reg '%rax))
                   (emit-lir! (list '%mov '%rax reg)))))
            ((and (symbol? info) (memq info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15)))
             (if (not (eq? info '%rax))
                 (emit-lir! (list '%mov '%rax info))))
            ((and (pair? info) (eq? (car info) 'param))
             (emit-lir! (list '%load '%rax '%rsp (cdr info))))
            ((and (pair? info) (eq? (car info) 'self))
             (emit-lir! (list '%load '%rax '%rsp (cdr info))))
            (else
             (error "Invalid binding format in LIR:" binding)))))))

(define (lir-compile-expr expr si env tail?)
  (cond
    ((ast-has-span? expr)
     (let ((span (ast-source-span expr))
           (inner (ast-strip-span expr)))
       (if (and (debug-symbols-enabled?) span)
           (let* ((file (span-effective-file span))
                  (line (span-effective-line span))
                  (col (span-effective-col span)))
             (if (and (string? file) (integer? line) (> line 0))
                 (let ((fid (register-source-file! file)))
                   (emit-lir! (list '%loc fid line col))))))
       (lir-compile-expr inner si env tail?)))
    (else
     (if (pair? expr)
         (set-current-form! expr))
     (cond
       ((immediate? expr)
        (lir-compile-immediate expr))
       ((symbol? expr)
        (lir-compile-variable expr env))
       ((pair? expr)
        (let ((op (car expr)))
          (cond
            ((zero-arg-prim? op)
             (lir-compile-zero-arg op si env))
         ((eq? op '-)
          (if (null? (cddr expr))
              (lir-compile-unary '- (cadr expr) si env)
              (lir-compile-binop '- (cadr expr) (caddr expr) si env)))
         ((unary-prim? op)
          (lir-compile-unary op (cadr expr) si env))
         ((memq op '(%make-closure %make-closure-env))
          (lir-compile-make-closure expr si env))
         ((eq? op '%make-stack-closure)
          (lir-compile-make-stack-closure expr si env))
         ((eq? op '%stack-cons)
          (lir-compile-stack-cons expr si env))
         ((eq? op 'annotate)
          (let ((attr (cadr expr))
                (inner (caddr expr)))
            (cond
              ((stack-alloc-attr? attr)
               (cond
                 ((and (pair? inner) (memq (car inner) '(%make-closure %make-closure-env)))
                  (lir-compile-make-stack-closure inner si env))
                 ((and (pair? inner) (eq? (car inner) 'cons))
                  (lir-compile-stack-cons inner si env))
                 (else
                  (lir-compile-expr inner si env tail?))))
              (else
               (lir-compile-expr inner si env tail?)))))
         ((eq? op '%closure-ref)
          (let* ((idx (caddr expr))
                 (offset (- (* idx 8) 1)))
            (lir-compile-expr (cadr expr) si env #f)
            (emit-lir! (list '%load '%rax '%rax offset))))
         ((eq? op '%closure-set!)
          (let* ((c-expr (cadr expr))
                 (idx (caddr expr))
                 (val-expr (cadddr expr))
                 (offset (- (* idx 8) 1)))
            (track-lir-si! si)
            (lir-compile-expr c-expr si env #f)
            (emit-lir! (list '%store '%rsp si '%rax))
            (track-lir-si! (- si 8))
            (lir-compile-expr val-expr (- si 8) env #f)
            (emit-lir! (list '%load '%rdx '%rsp si))
            (emit-lir! (list '%store '%rdx offset '%rax))
            (emit-lir! '(%mov %rax 63))))
         ;; Typed Machine LIR: Memory Access, FP & Conversions (Issue #826)
         ((eq? op '%load-typed)
          (let ((mty (cadr expr))
                (base-expr (caddr expr))
                (off-expr (cadddr expr)))
            (lir-compile-expr base-expr si env #f)
            (let ((dst-reg (if (memq mty '(f32 f64)) '%xmm0 '%rax)))
              (emit-lir! (list '%load-typed mty dst-reg '%rax off-expr)))))
         ((eq? op '%store-typed)
          (let ((mty (cadr expr))
                (base-expr (caddr expr))
                (off-expr (cadddr expr))
                (val-expr (car (cddddr expr))))
            (track-lir-si! si)
            (lir-compile-expr base-expr si env #f)
            (emit-lir! (list '%store '%rsp si '%rax))
            (track-lir-si! (- si 8))
            (lir-compile-expr val-expr (- si 8) env #f)
            (emit-lir! (list '%load '%rdx '%rsp si))
            (let ((src-opnd (if (memq mty '(f32 f64)) '%xmm0 '%rax)))
              (emit-lir! (list '%store-typed mty '%rdx off-expr src-opnd))
              (emit-lir! '(%mov %rax 63)))))
         ((memq op '(%fadd %fsub %fmul %fdiv %fcmp))
          (let ((e1 (cadr expr))
                (e2 (caddr expr)))
            (track-lir-si! si)
            (lir-compile-expr e1 si env #f)
            (emit-lir! (list '%store '%rsp si '%rax))
            (track-lir-si! (- si 8))
            (lir-compile-expr e2 (- si 8) env #f)
            (emit-lir! '(%fmov %xmm1 %xmm0))
            (emit-lir! (list '%load '%rax '%rsp si))
            (emit-lir! (list op '%xmm0 '%xmm1))))
         ((eq? op '%fmov)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%fmov %xmm0 %xmm1)))
         ((eq? op '%sitofp)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%sitofp %xmm0 %rax)))
         ((eq? op '%fptosi)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%fptosi %rax %xmm0)))
         ((eq? op '%box-flonum)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%alloc %rax 16 3))
          (emit-lir! '(%store-typed f64 %rax 8 %xmm0)))
         ((eq? op '%unbox-flonum)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%load-typed f64 %xmm0 %rax 8)))
         ((memq op '(%trunc %zext %sext))
          (let ((mty (cadr expr))
                (val-expr (caddr expr)))
            (lir-compile-expr val-expr si env #f)
            (emit-lir! (list op mty '%rax '%rax))))
         ((binop-prim? op)
          (lir-compile-binop op (cadr expr) (caddr expr) si env))
         ((triop-prim? op)
          (lir-compile-triop op (cadr expr) (caddr expr) (cadddr expr) si env))
         ((septop-prim? op)
          (lir-compile-raw-syscall (cdr expr) si env))
         ((eq? op '%cont-fun)
          (lir-compile-cont-fun (cadr expr) (caddr expr) (cadddr expr) (cadr (cdddr expr)) si env tail?))
         ((eq? op '%cont-call)
          (lir-compile-cont-call (cadr expr) (cddr expr) si env))
         ((eq? op '%with-handler)
          (lir-compile-with-handler (cadr expr) (caddr expr) si env tail?))
         ((eq? op '%raw-call/cc)
          (lir-compile-raw-call-cc (cadr expr) si env tail?))
         ((eq? op '%values)
          (lir-compile-values (cdr expr) si env))
         ((eq? op '%call-with-values)
          (lir-compile-call-with-values (cadr expr) (caddr expr) si env tail?))
         ((eq? op 'let)
          (lir-compile-let (cadr expr) (caddr expr) si env tail?))
         ;; Stage-Polymorphic Residual ANF Lowering (Issue #889 / DSN-33-03 §6.2)
         ((eq? op 'atom-value)
          (let ((v (cadr expr)))
            (cond
              ((immediate? v) (lir-compile-immediate v))
              ((symbol? v) (lir-compile-variable v env))
              ((pair? v) (lir-compile-expr v si env tail?))
              (else (error "Invalid atom-value in LIR:" v)))))
         ((eq? op 'let-anf)
          (lir-compile-let (cadr expr) (caddr expr) si env tail?))
         ((eq? op 'let-call)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (b (car bindings))
                 (var (car b))
                 (call-expr (cadr b)))
            (if (and (pair? call-expr) (symbol? (car call-expr)))
                (let* ((callee (car call-expr))
                       (cargs (cdr call-expr)))
                  (if (assq callee env)
                      (lir-compile-let bindings body si env tail?)
                      (let ((direct-binding (list var (cons '%direct-call (cons callee cargs)))))
                        (lir-compile-let (list direct-binding) body si env tail?))))
                (lir-compile-let bindings body si env tail?))))
         ((eq? op 'if-anf)
          (lir-compile-if (cadr expr) (caddr expr) (cdddr expr) si env tail?))
         ((eq? op 'if)
          (lir-compile-if (cadr expr) (caddr expr) (cdddr expr) si env tail?))
         ((eq? op 'begin)
          (lir-compile-begin (cdr expr) si env tail?))
         ((eq? op 'quote)
          (let ((datum (cadr expr)))
            (cond
              ((symbol? datum)
               (let ((id (intern-symbol datum)))
                 (emit-lir! (list '%mov '%rax id))))
              ((immediate? datum)
               (lir-compile-immediate datum))
              ((pair? datum)
               (lir-compile-expr (list 'cons
                                       (list 'quote (car datum))
                                       (list 'quote (cdr datum)))
                                 si env #f))
              ((vector? datum)
               (lir-compile-expr (desugar-vector
                                  (map (lambda (x) (list 'quote x))
                                       (vector->list datum)))
                                 si env #f))
              (else
               (error "Invalid quoted datum in LIR:" datum)))))
         ((eq? op '%direct-call)
          (lir-compile-direct-call (cadr expr) (cddr expr) si env tail?))
         ((eq? op '%c-call)
          (lir-compile-c-call expr si env tail?))
         ((eq? op '%call-foreign)
          (lir-compile-foreign-call-expr expr si env tail?))
         ((eq? op '%global-ref)
          (emit-lir! (list '%global-ref '%rax (cadr expr))))
         ((eq? op '%global-set!)
          (track-lir-si! si)
          (lir-compile-expr (caddr expr) si env #f)
          (emit-lir! (list '%global-set! (cadr expr) '%rax)))
         ((eq? op '%inline-asm)
          (lir-compile-inline-asm expr si env))
         (else
          ;; General procedure call
          (lir-compile-call op (cdr expr) si env tail?)))))
    (else
     (error "Invalid syntax in LIR compiler:" expr))))))

(define (lir-inline-asm-resolve-var var env)
  (let ((binding (assq var env)))
    (if (not binding)
        var
        (let ((info (cdr binding)))
          (cond
            ((number? info) (list '%stack info))
            ((and (pair? info) (memq (car info) '(param self))) (list '%stack (cdr info)))
            ((and (pair? info) (eq? (car info) 'reg)) (cdr info))
            ((symbol? info) info)
            (else var))))))

(define (lir-inline-asm-lir-operand? x)
  (or (integer? x)
      (symbol? x)
      (and (pair? x) (memq (car x) '(%stack %mem %reg)))))

(define (lir-compile-inline-asm expr si env)
  (let* ((parsed (inline-asm-extract-clauses expr))
         (template (car parsed))
         (raw-outs (cadr parsed))
         (raw-ins (caddr parsed))
         (clobs (cadddr parsed))
         (volatile? (car (cddddr parsed)))
         (cur-si-box (cons si '()))
         (resolved-ins
          (map
           (lambda (in-entry)
             (let ((ni (inline-asm-normalize-in-entry in-entry)))
               (if (not ni)
                   in-entry
                   (let* ((nm (car ni))
                          (src (cadr ni))
                          (cstr (caddr ni))
                          (final-src
                           (cond
                             ((symbol? src)
                              (lir-inline-asm-resolve-var src env))
                             ((lir-inline-asm-lir-operand? src)
                              src)
                             (else
                              (let ((slot (car cur-si-box)))
                                (set-car! cur-si-box (- slot 8))
                                (track-lir-si! slot)
                                (lir-compile-expr src slot env #f)
                                (emit-lir! (list '%mov (list '%stack slot) '%rax))
                                (list '%stack slot))))))
                     (if nm
                         (list nm cstr final-src)
                         (list final-src cstr))))))
           raw-ins))
         (resolved-outs
          (map
           (lambda (out-entry)
             (let ((no (inline-asm-normalize-out-entry out-entry)))
               (if (not no)
                   out-entry
                   (let* ((nm (car no))
                          (dst (cadr no))
                          (cstr (caddr no))
                          (final-dst
                           (if (symbol? dst)
                               (lir-inline-asm-resolve-var dst env)
                               dst)))
                     (if nm
                         (list nm cstr final-dst)
                         (list final-dst cstr))))))
           raw-outs))
         (lir-inst
          (list '%inline-asm template
                (list ':outputs resolved-outs)
                (list ':inputs resolved-ins)
                (list ':clobbers clobs)
                (list ':volatile? volatile?))))
    (emit-lir! lir-inst)
    (if (pair? resolved-outs)
        (let* ((no0 (inline-asm-normalize-out-entry (car resolved-outs)))
               (dst0 (and no0 (cadr no0))))
          (cond
            ((or (and (pair? dst0) (eq? (car dst0) '%stack))
                 (and (pair? dst0) (eq? (car dst0) '%mem)))
             (emit-lir! (list '%mov '%rax dst0)))
            ((and (pair? dst0) (eq? (car dst0) '%reg))
             (if (not (eq? (inline-asm-normalize-reg-sym (cadr dst0)) '%rax))
                 (emit-lir! (list '%mov '%rax (cadr dst0)))))
            ((and (symbol? dst0)
                  (let ((nr (inline-asm-normalize-reg-sym dst0)))
                    (and nr (not (eq? nr '%rax)))))
             (emit-lir! (list '%mov '%rax dst0))))))))

;;; Compile a single lifted %function to LIR representation
(define (lir-compile-function fn-raw)
  (let* ((fn (if (ast-has-span? fn-raw) (ast-strip-span fn-raw) fn-raw))
         (label (cadr fn))
         (params (caddr fn))
         (body (cadddr fn))
         (num-params (length params))
         (num-reg-params (if (< num-params 6) num-params 6))
         (initial-raw-vars (if (unboxed-fn? label) params '())))
    (set-current-toplevel-name! label)
    (with-call-frame label fn
      (lambda ()
        (reset-lir!)
        (let ((loc-info (lookup-function-source-loc label)))
          (if (and (debug-symbols-enabled?) loc-info)
              (let* ((file (car loc-info))
                     (line (cadr loc-info))
                     (col (caddr loc-info))
                     (fid (register-source-file! file)))
                (emit-lir! (list '%loc fid line col)))))
        ;; Build callee env:
        ;; %self at [rsp - 8]
        ;; params 0..5 in registers spilled to [rsp - 24 - 8*i]
        ;; params 6+ at [rsp + 8 * (num-params - i)]
        (let* ((self-env (list (cons '%self (cons 'self -8))))
               (param-env
                (let loop ((ps params) (i 0) (acc '()))
                  (if (null? ps) acc
                      (if (< i 6)
                          (let ((slot (- -24 (* 8 i))))
                            (loop (cdr ps) (+ i 1)
                                  (cons (cons (car ps) slot) acc)))
                          (let ((offset (* 8 (- num-params i))))
                            (loop (cdr ps) (+ i 1)
                                  (cons (cons (car ps) (cons 'param offset)) acc)))))))
               (callee-env (cons (cons '%num-params num-params)
                                 (cons (cons '%raw-vars initial-raw-vars)
                                       (cons (cons '%stack-vars '())
                                             (append self-env param-env)))))
               (callee-si (- -24 (* 8 num-reg-params))))
          (track-lir-si! -8)
          (track-lir-si! -16)
          ;; Track spilled parameter slots
          (let loop ((i 0))
            (if (< i num-reg-params)
                (begin
                  (track-lir-si! (- -24 (* 8 i)))
                  (loop (+ i 1)))))
          (track-lir-si! callee-si)
          (emit-lir! '(%store %rsp -16 %rax))
          (let ((loop-head-lbl (unique-label-sym (string-append "L_loop_head_" (if (symbol? label) (symbol->string label) "fn") "_"))))
            (emit-lir! (list '%label loop-head-lbl))
            ;; Store incoming argument registers into their callee stack slots
            (let loop ((i 0))
              (if (< i num-reg-params)
                  (begin
                    (emit-lir! (list '%store '%rsp (- -24 (* 8 i)) (list-ref *arg-registers* i)))
                    (loop (+ i 1)))))
            (let ((callee-env-with-self (cons (cons '%current-func label)
                                              (cons (cons '%self-loop-head loop-head-lbl)
                                                    callee-env))))
              (lir-compile-expr body callee-si callee-env-with-self #t)))
          (emit-lir! '(%return))
          (let* ((needed-frame (- 0 (car *lir-min-si*)))
                 (frame-size (align-frame-shift needed-frame))
                 (insts (reverse (car *lir-instructions*))))
            (list '%lir-function
                  label
                  (list 'params params)
                  (list 'frame-size frame-size)
                  (cons 'body insts))))))))

;;; Pass 6 Entrypoint: Transforms Pass 5 %program AST into %lir-program
(define (generate-lir prog-raw)
  (let* ((prog (if (ast-has-span? prog-raw) (ast-strip-span prog-raw) prog-raw)))
    (reset-safepoints!)
    (reset-symbol-table!)
    (let ((funcs (cadr prog))
          (main-expr (caddr prog)))
      (set-current-toplevel-name! '%main)
      (reset-lir!)
      (let ((main-loc (lookup-function-source-loc '%main)))
        (if (and (debug-symbols-enabled?) main-loc)
            (let* ((file (car main-loc))
                   (line (cadr main-loc))
                   (col (caddr main-loc))
                   (fid (register-source-file! file)))
              (emit-lir! (list '%loc fid line col)))))
      (track-lir-si! -8)
      (lir-compile-expr main-expr -8 (list (cons '%raw-vars '()) (cons '%stack-vars '())) #f)
      (emit-lir! '(%return))
      (let* ((main-insts (reverse (car *lir-instructions*)))
             (main-frame (align-frame-shift (- 0 (car *lir-min-si*))))
             (lir-main (list '%lir-main
                             (list 'frame-size main-frame)
                             (cons 'body main-insts)))
             (lir-funcs (map lir-compile-function funcs))
             (safepoints (reverse (car *lir-safepoints*))))
        (list '%lir-program
              (list 'strings (car *strings*))
              (list 'stackmaps safepoints)
              (cons '%lir-functions lir-funcs)
              lir-main)))))

;;; -----------------------------------------------------------------------
;;; Pass 130 Bridge: Lowering L-Residual-ANF to LIR (DSN-33-03 §6.2 & Issue #889)
;;; -----------------------------------------------------------------------

(define (residual-normalize-func def)
  (cond
    ((not (pair? def)) def)
    ((eq? (car def) '%function) def)
    ;; (define (name p ...) body ...)
    ((and (eq? (car def) 'define) (pair? (cdr def)) (pair? (cadr def)))
     (let* ((sig (cadr def))
            (name (car sig))
            (params (cdr sig))
            (body-forms (cddr def))
            (body (if (= (length body-forms) 1) (car body-forms) (cons 'begin body-forms))))
       (list '%function name params body)))
    ;; (define name (lambda (p ...) body ...))
    ((and (eq? (car def) 'define) (pair? (cdr def)) (symbol? (cadr def))
          (pair? (cddr def)) (pair? (caddr def)) (eq? (caaddr def) 'lambda))
     (let* ((name (cadr def))
            (lam (caddr def))
            (params (cadr lam))
            (lbody-forms (cddr lam))
            (lbody (if (= (length lbody-forms) 1) (car lbody-forms) (cons 'begin lbody-forms))))
       (list '%function name params lbody)))
    (else def)))

(define (lower-residual-anf-to-lir residual-ast)
  (cond
    ((null? residual-ast) '())
    ((and (pair? residual-ast) (eq? (car residual-ast) '%program))
     (let ((funcs (map residual-normalize-func (cadr residual-ast)))
           (main (caddr residual-ast)))
       (generate-lir (list '%program funcs main))))
    (else
     (generate-lir (list '%program '() residual-ast)))))

(define (lower-residual-anf-to-lir-insts expr)
  (reset-lir!)
  (track-lir-si! -8)
  (lir-compile-expr expr -8 (list (cons '%raw-vars '()) (cons '%stack-vars '())) #f)
  (reverse (car *lir-instructions*)))
;;; =======================================================================
;;; ULisp Compiler Pass 131: Lower Managed Runtime Dialect to Core Machine LIR
;;; Conforms to DSN-33, DSN-38 Architecture Specifications & Issue #835
;;; =======================================================================
;;; Formally lowers high-level Managed Runtime Dialect instructions
;;; (%alloc, %alloc-stack, %box-*, %unbox-*, %managed-*, %capture-cc, etc.)
;;; into pure, unmanaged Core Machine LIR instruction sequences.
;;;
;;; Guarantees:
;;; 1. The output contains ZERO managed dialect opcodes.
;;; 2. All heap/stack pointer operations conform to machine alignment rules.
;;; 3. Unmanaged/C-language frontends bypass this pass and target Core LIR directly.
;;; =======================================================================

(define *managed-dialect-opcodes*
  '(%alloc
    %alloc-stack
    %managed-alloc
    %managed-alloc-stack
    %managed-safepoint-poll
    %safepoint-poll
    %managed-write-barrier
    %managed-box
    %managed-unbox
    %box-fixnum
    %unbox-fixnum
    %box-flonum
    %unbox-flonum
    %capture-cc
    %push-handler
    %pop-handler
    %raise
    %set-values-count
    %store-values-buf))

(define (managed-dialect-opcode? op)
  (if (memq op *managed-dialect-opcodes*) #t #f))

;;; -----------------------------------------------------------------------
;;; Instruction-Level Lowering Transformer
;;; -----------------------------------------------------------------------

(define (lower-managed-inst inst)
  (if (not (pair? inst))
      (list inst)
      (let ((op (car inst)))
        (case op
          ;; 1. Heap Allocation: (%alloc dst bytes tag [si]) / (%managed-alloc dst bytes tag [si])
          ((%alloc %managed-alloc)
           (let* ((dst (cadr inst))
                  (bytes (caddr inst))
                  (tag (cadddr inst))
                  (aligned (ctfe-bitwise-and (+ bytes 7) -8)))
             (if (equal? dst '%r12)
                 (list (list '%add '%r12 aligned))
                 (list (list '%mov dst '%r12)
                       (list '%add dst tag)
                       (list '%add '%r12 aligned)))))

          ;; 2. Stack Allocation: (%alloc-stack dst offset tag) / (%managed-alloc-stack dst offset tag)
          ((%alloc-stack %managed-alloc-stack)
           (let* ((dst (cadr inst))
                  (offset (caddr inst))
                  (tag (cadddr inst))
                  (disp (+ offset tag)))
             (if (= disp 0)
                 (list (list '%mov dst '%rsp))
                 (list (list '%mov dst '%rsp)
                       (list '%add dst disp)))))

          ;; 3. Safepoint Polling: (%managed-safepoint-poll) / (%safepoint-poll)
          ((%managed-safepoint-poll %safepoint-poll)
           (list '(%memory-fence)))

          ;; 4. Write Barrier: (%managed-write-barrier obj offset val)
          ((%managed-write-barrier)
           (let ((obj (cadr inst))
                 (offset (caddr inst))
                 (val (cadddr inst)))
             (list (list '%mov '%r11 obj)
                   (list '%add '%r11 offset)
                   (list '%shr '%r11 9)
                   (list '%global-ref '%r10 'ulisp_card_table_base)
                   (list '%store-byte '%r10 '%r11 1))))

          ;; 5. Fixnum Boxing & Unboxing: (%box-fixnum dst src), (%unbox-fixnum dst src)
          ((%box-fixnum)
           (let ((dst (cadr inst))
                 (src (caddr inst)))
             (repr-emit-box-fixnum dst src)))

          ((%unbox-fixnum)
           (let ((dst (cadr inst))
                 (src (caddr inst)))
             (repr-emit-unbox-fixnum dst src)))

          ;; 6. Generic Managed Box / Unbox: (%managed-box mty dst src), (%managed-unbox mty dst src)
          ((%managed-box)
           (let ((mty (cadr inst))
                 (dst (caddr inst))
                 (src (cadddr inst)))
             (cond
               ((or (eq? mty 'fixnum) (eq? mty 'i64))
                (repr-emit-box-fixnum dst src))
               ((or (eq? mty 'flonum) (eq? mty 'f64))
                (repr-emit-box-flonum dst src))
               (else
                (if (equal? dst src)
                    '()
                    (list (list '%mov dst src)))))))

          ((%managed-unbox)
           (let ((mty (cadr inst))
                 (dst (caddr inst))
                 (src (cadddr inst)))
             (cond
               ((or (eq? mty 'fixnum) (eq? mty 'i64))
                (repr-emit-unbox-fixnum dst src))
               ((or (eq? mty 'flonum) (eq? mty 'f64))
                (repr-emit-unbox-flonum dst src))
               (else
                (if (equal? dst src)
                    '()
                    (list (list '%mov dst src)))))))

          ;; 7. Flonum Boxing & Unboxing: (%box-flonum dst src), (%unbox-flonum dst src)
          ((%box-flonum)
           (let ((dst (cadr inst))
                 (src (caddr inst)))
             (repr-emit-box-flonum dst src)))

          ((%unbox-flonum)
           (let ((dst (cadr inst))
                 (src (caddr inst)))
             (repr-emit-unbox-flonum dst src)))

          ;; 8. Runtime Continuations, Exceptions and Multiple Values
          ;; Handled directly by native backend code generators (e.g. 140_backend_x86_64.scm)
          ((%capture-cc %push-handler %pop-handler %raise %set-values-count %store-values-buf)
           (list inst))

          ;; 9. Nested SSA Blocks: (%block lbl params . body)
          ((%block)
           (let ((lbl (cadr inst))
                 (params (caddr inst))
                 (sub-insts (cdddr inst)))
             (list (cons '%block
                         (cons lbl
                               (cons params
                                     (lower-managed-inst-list sub-insts)))))))

          ;; Default: Core Machine LIR instructions are preserved as-is
          (else
           (list inst))))))

(define (lower-managed-inst-list insts)
  (let loop ((is insts) (acc '()))
    (if (null? is)
        (reverse acc)
        (let ((lowered (lower-managed-inst (car is))))
          (loop (cdr is) (append (reverse lowered) acc))))))

;;; -----------------------------------------------------------------------
;;; Function, Main and Program Level Lowering
;;; -----------------------------------------------------------------------

(define (lower-managed-function fn-decl)
  (if (and (pair? fn-decl) (eq? (car fn-decl) '%lir-function))
      (let* ((lbl (cadr fn-decl))
             (params-clause (caddr fn-decl))
             (frame-clause (cadddr fn-decl))
             (body-clause (car (cddddr fn-decl)))
             (body-insts (cdr body-clause)))
        (list '%lir-function
              lbl
              params-clause
              frame-clause
              (cons 'body (lower-managed-inst-list body-insts))))
      fn-decl))

(define (lower-managed-main main-decl)
  (if (and (pair? main-decl) (eq? (car main-decl) '%lir-main))
      (let* ((frame-clause (cadr main-decl))
             (body-clause (caddr main-decl))
             (body-insts (cdr body-clause)))
        (list '%lir-main
              frame-clause
              (cons 'body (lower-managed-inst-list body-insts))))
      main-decl))

(define (lower-managed-dialect prog)
  (cond
    ((not (pair? prog)) prog)
    ((eq? (car prog) '%lir-program)
     (let* ((strings-clause (assq 'strings (cdr prog)))
            (data-clause (assq 'data (cdr prog)))
            (stackmaps-clause (assq 'stackmaps (cdr prog)))
            (funcs-clause (assq '%lir-functions (cdr prog)))
            (main-clause (assq '%lir-main (cdr prog)))
            (new-funcs (if funcs-clause
                           (cons '%lir-functions (map lower-managed-function (cdr funcs-clause)))
                           '(%lir-functions)))
            (new-main (if main-clause (lower-managed-main main-clause) '(%lir-main (frame-size 0) (body)))))
       (if data-clause
           (list '%lir-program
                 (if strings-clause strings-clause '(strings ()))
                 data-clause
                 (if stackmaps-clause stackmaps-clause '(stackmaps ()))
                 new-funcs
                 new-main)
           (list '%lir-program
                 (if strings-clause strings-clause '(strings ()))
                 (if stackmaps-clause stackmaps-clause '(stackmaps ()))
                 new-funcs
                 new-main))))
    ((eq? (car prog) '%lir-function)
     (lower-managed-function prog))
    ((eq? (car prog) '%lir-main)
     (lower-managed-main prog))
    ((list? prog)
     (lower-managed-inst-list prog))
    (else prog)))
;;; =======================================================================
;;; ULisp Compiler Pass 131: GC Safepoint & Stackmap Bitmaps
;;; =======================================================================

(define *lir-safepoints* (cons '() '()))
(define *safepoint-counter* (cons 0 '()))

(define (reset-safepoints!)
  (set-car! *lir-safepoints* '())
  (set-car! *safepoint-counter* 0))

(define (new-safepoint-label!)
  (let* ((cnt (+ (car *safepoint-counter*) 1))
         (lbl-str (string-append "__safepoint_" (number->string cnt))))
    (set-car! *safepoint-counter* cnt)
    lbl-str))

(define (record-safepoint! lbl frame-size bitmap)
  (set-car! *lir-safepoints*
            (cons (list lbl frame-size bitmap) (car *lir-safepoints*))))

(define (power-of-2 k)
  (let loop ((i 0) (acc 1))
    (if (< i k)
        (loop (+ i 1) (* acc 2))
        acc)))


(define (compute-stackmap-bitmap frame-shift aligned-si args env)
  (let* ((slot-count (quotient frame-shift 8))
         (rvars (get-raw-vars env)))
    (let loop ((k 0) (bitmap 0))
      (if (or (>= k slot-count) (>= k 60))
          bitmap
          (let* ((slot-offset (- (* k 8) frame-shift))
                 (is-ptr
                  (if (= slot-offset -8)
                      #t
                      (let ((arg-res
                             (let check-arg ((cur-args args) (i 0))
                               (if (null? cur-args)
                                   #f
                                   (let ((arg-si (- aligned-si (* i 8))))
                                     (if (= slot-offset arg-si)
                                         (cons #t (not (raw-expr? (car cur-args) rvars)))
                                         (check-arg (cdr cur-args) (+ i 1))))))))
                        (if arg-res
                            (cdr arg-res)
                            (let ((var-res
                                   (let check-var ((e env))
                                     (if (null? e)
                                         #f
                                         (let ((entry (car e)))
                                           (if (and (pair? entry)
                                                    (not (eq? (car entry) '%num-params))
                                                    (not (eq? (car entry) '%raw-vars)))
                                               (let ((v (car entry))
                                                     (info (cdr entry)))
                                                 (if (and (number? info) (= info slot-offset))
                                                     (cons #t (not (memq v rvars)))
                                                     (if (and (pair? info) (eq? (car info) 'param) (= (cdr info) slot-offset))
                                                         (cons #t (not (memq v rvars)))
                                                         (check-var (cdr e)))))
                                               (check-var (cdr e))))))))
                              (if var-res
                                  (cdr var-res)
                                  #f)))))))
            (loop (+ k 1)
                  (if is-ptr (+ bitmap (power-of-2 k)) bitmap)))))))

;;; =======================================================================
;;; ULisp Compiler Pass 132: Braun et al. (2013) SSA & Block Arguments Engine
;;; =======================================================================

;;; Conforms to DSN-33 Section 8.1, DSN-33-02 Section 6.1 & Issue #827
;;; =======================================================================

(define (make-braun-cfg)
  (list (cons 'blocks '())            ; (label . (insts ...))
        (cons 'order '())             ; (lbl1 lbl2 ...)
        (cons 'preds '())             ; (label . (pred1 pred2 ...))
        (cons 'succs '())             ; (label . (succ1 succ2 ...))
        (cons 'sealed '())            ; (lbl1 lbl2 ...)
        (cons 'params '())            ; (label . (p1 p2 ...))
        (cons 'defs '())              ; ((var . lbl) . val)
        (cons 'incomplete '())        ; (label . ((param . var) ...))
        (cons 'incoming '())          ; ((param . pred) . val)
        (cons 'replacements '())      ; (param . canonical-val)
        (cons 'terminators '())       ; (label . terminator-inst)
        (cons 'rep-types '())         ; (val/param . rep-type)
        (cons 'phi-users '())         ; (val . ((user-param . user-block-lbl) ...))
        (cons 'param-vars '())        ; (param . var)
        (cons 'current-block #f)))

;;; -----------------------------------------------------------------------
;;; Representation Type Lattice (Issue #618: bot <= raw-i64 <= top)
;;; -----------------------------------------------------------------------
(define (braun-rep-bot) 'bot)
(define (braun-rep-raw-i64) 'raw-i64)
(define (braun-rep-tagged-fixnum) 'tagged-fixnum)
(define (braun-rep-top) 'top)

(define (braun-rep-lub r1 r2)
  (cond
    ((eq? r1 'bot) r2)
    ((eq? r2 'bot) r1)
    ((eq? r1 r2) r1)
    (else 'top)))

(define (braun-set-rep-type! cfg val rep)
  (let* ((reps (braun-cfg-ref cfg 'rep-types))
         (entry (assoc val reps)))
    (if entry
        (set-cdr! entry rep)
        (braun-cfg-set! cfg 'rep-types (cons (cons val rep) reps)))))

(define (braun-get-rep-type cfg val)
  (let* ((reps (braun-cfg-ref cfg 'rep-types))
         (entry (assoc val reps)))
    (if entry (cdr entry) 'bot)))

(define (braun-infer-block-params-rep! cfg)
  (let ((order (braun-cfg-ref cfg 'order)))
    (for-each
     (lambda (block-lbl)
       (let ((params (braun-get-params cfg block-lbl))
             (preds (braun-get-preds cfg block-lbl)))
         (for-each
          (lambda (param)
            (let ((inferred-rep
                   (let loop ((ps preds) (acc 'bot))
                     (if (null? ps) acc
                         (let* ((pred (car ps))
                                (inc (braun-resolve-val cfg (braun-get-incoming cfg param pred)))
                                (inc-rep (braun-get-rep-type cfg inc)))
                           (loop (cdr ps) (braun-rep-lub acc inc-rep)))))))
              (if (not (eq? inferred-rep 'bot))
                  (braun-set-rep-type! cfg param inferred-rep))))
          params)))
     order)
    cfg))

(define (braun-get-raw-params cfg)
  (let* ((reps (braun-cfg-ref cfg 'rep-types)))
    (let loop ((rs reps) (acc '()))
      (if (null? rs) (reverse acc)
          (if (eq? (cdar rs) 'raw-i64)
              (loop (cdr rs) (cons (caar rs) acc))
              (loop (cdr rs) acc))))))

(define (braun-cfg-ref cfg key)
  (let ((entry (assq key cfg)))
    (if entry (cdr entry) '())))

(define (braun-cfg-set! cfg key val)
  (let ((entry (assq key cfg)))
    (if entry
        (set-cdr! entry val)
        (error "Unknown Braun CFG key:" key))))

(define (braun-new-block! cfg label)
  (let ((order (braun-cfg-ref cfg 'order))
        (blocks (braun-cfg-ref cfg 'blocks))
        (preds (braun-cfg-ref cfg 'preds))
        (succs (braun-cfg-ref cfg 'succs))
        (params (braun-cfg-ref cfg 'params))
        (incomplete (braun-cfg-ref cfg 'incomplete))
        (terms (braun-cfg-ref cfg 'terminators)))
    (braun-cfg-set! cfg 'order (append order (list label)))
    (braun-cfg-set! cfg 'blocks (cons (cons label '()) blocks))
    (braun-cfg-set! cfg 'preds (cons (cons label '()) preds))
    (braun-cfg-set! cfg 'succs (cons (cons label '()) succs))
    (braun-cfg-set! cfg 'params (cons (cons label '()) params))
    (braun-cfg-set! cfg 'incomplete (cons (cons label '()) incomplete))
    (braun-cfg-set! cfg 'terminators (cons (cons label #f) terms))
    (braun-cfg-set! cfg 'current-block label)
    label))

(define (braun-update-sealed-block-edge! cfg from-lbl to-lbl)
  (let ((params (braun-get-params cfg to-lbl)))
    (for-each
     (lambda (param)
       (let ((var (braun-get-param-var cfg param)))
         (if var
             (let ((val (braun-read-variable cfg var from-lbl)))
               (braun-set-incoming! cfg param from-lbl val)
               (braun-try-remove-trivial! cfg to-lbl param '())))))
     params)))

(define (braun-add-edge! cfg from-lbl to-lbl)
  (let* ((preds (braun-cfg-ref cfg 'preds))
         (p-entry (assq to-lbl preds))
         (succs (braun-cfg-ref cfg 'succs))
         (s-entry (assq from-lbl succs)))
    ;; Update preds
    (if p-entry
        (if (not (memq from-lbl (cdr p-entry)))
            (set-cdr! p-entry (append (cdr p-entry) (list from-lbl))))
        (braun-cfg-set! cfg 'preds (cons (list to-lbl from-lbl) preds)))
    ;; Update succs
    (if s-entry
        (if (not (memq to-lbl (cdr s-entry)))
            (set-cdr! s-entry (append (cdr s-entry) (list to-lbl))))
        (braun-cfg-set! cfg 'succs (cons (list from-lbl to-lbl) succs)))
    ;; If to-lbl is already sealed, dynamically update its block arguments
    (if (memq to-lbl (braun-cfg-ref cfg 'sealed))
        (braun-update-sealed-block-edge! cfg from-lbl to-lbl))))

(define (braun-get-preds cfg block-lbl)
  (let ((entry (assq block-lbl (braun-cfg-ref cfg 'preds))))
    (if entry (cdr entry) '())))

(define (braun-get-succs cfg block-lbl)
  (let ((entry (assq block-lbl (braun-cfg-ref cfg 'succs))))
    (if entry (cdr entry) '())))

(define (braun-get-params cfg block-lbl)
  (let ((entry (assq block-lbl (braun-cfg-ref cfg 'params))))
    (if entry (cdr entry) '())))

(define (braun-add-param! cfg block-lbl param)
  (let* ((params (braun-cfg-ref cfg 'params))
         (entry (assq block-lbl params)))
    (if entry
        (if (not (memq param (cdr entry)))
            (set-cdr! entry (append (cdr entry) (list param))))
        (braun-cfg-set! cfg 'params (cons (list block-lbl param) params)))))

(define (braun-set-param-var! cfg param var)
  (let* ((pvars (braun-cfg-ref cfg 'param-vars))
         (entry (assq param pvars)))
    (if entry
        (set-cdr! entry var)
        (braun-cfg-set! cfg 'param-vars (cons (cons param var) pvars)))))

(define (braun-get-param-var cfg param)
  (let ((entry (assq param (braun-cfg-ref cfg 'param-vars))))
    (if entry (cdr entry) #f)))

(define (braun-write-variable! cfg var block-lbl val)
  (let* ((defs (braun-cfg-ref cfg 'defs))
         (key (cons var block-lbl))
         (entry (assoc key defs)))
    (if entry
        (set-cdr! entry val)
        (braun-cfg-set! cfg 'defs (cons (cons key val) defs)))))

(define (braun-resolve-val cfg val)
  (let loop ((v val) (visited '()))
    (if (or (not (symbol? v)) (memq v visited))
        v
        (let* ((reps (braun-cfg-ref cfg 'replacements))
               (entry (assq v reps)))
          (if entry
              (loop (cdr entry) (cons v visited))
              v)))))

(define (braun-member? x lst)
  (let loop ((xs lst))
    (cond
      ((null? xs) #f)
      ((equal? (car xs) x) #t)
      (else (loop (cdr xs))))))

(define (braun-add-phi-user! cfg val param block-lbl)
  (if (symbol? val)
      (let* ((users-map (braun-cfg-ref cfg 'phi-users))
             (entry (assq val users-map))
             (item (cons param block-lbl)))
        (if entry
            (if (not (braun-member? item (cdr entry)))
                (set-cdr! entry (cons item (cdr entry))))
            (braun-cfg-set! cfg 'phi-users (cons (list val item) users-map))))))

(define (braun-get-phi-users cfg val)
  (let ((entry (assq val (braun-cfg-ref cfg 'phi-users))))
    (if entry (cdr entry) '())))

(define (braun-find-block-of-param cfg param)
  (let loop ((blocks (braun-cfg-ref cfg 'params)))
    (if (null? blocks) #f
        (if (memq param (cdar blocks))
            (caar blocks)
            (loop (cdr blocks))))))

(define (braun-set-incoming! cfg param pred val)
  (let* ((inc (braun-cfg-ref cfg 'incoming))
         (key (cons param pred))
         (entry (assoc key inc)))
    (if entry
        (set-cdr! entry val)
        (braun-cfg-set! cfg 'incoming (cons (cons key val) inc))))
  (let ((b-lbl (braun-find-block-of-param cfg param)))
    (if b-lbl (braun-add-phi-user! cfg val param b-lbl))))

(define (braun-get-incoming cfg param pred)
  (let* ((inc (braun-cfg-ref cfg 'incoming))
         (key (cons param pred))
         (entry (assoc key inc)))
    (if entry (cdr entry) #f)))

;;; Braun et al. (2013) Section 3.2: Recursive Trivial Phi Elimination
(define (braun-try-remove-trivial! cfg block-lbl param visited)
  (if (memq param visited)
        param ;; Cycle detected: break recursion safely (CWE-400 defense)
        (let* ((preds (braun-get-preds cfg block-lbl)))
          (let loop ((ps preds) (same #f) (trivial? #t))
            (if (null? ps)
                (if trivial?
                    (let ((replacement (if same same param)))
                      (if (not (equal? replacement param))
                          (begin
                            ;; 1. Register canonical replacement
                            (let ((reps (braun-cfg-ref cfg 'replacements)))
                              (braun-cfg-set! cfg 'replacements (cons (cons param replacement) reps)))
                            ;; 2. Remove param from block's parameter list
                            (let* ((params (braun-cfg-ref cfg 'params))
                                   (p-entry (assq block-lbl params)))
                              (if p-entry
                                  (set-cdr! p-entry (filter (lambda (p) (not (eq? p param))) (cdr p-entry)))))
                            ;; 3. Braun 2013: Recursively check all users of this phi
                            (let ((users (braun-get-phi-users cfg param))
                                  (new-visited (cons param visited)))
                              (for-each
                               (lambda (u-pair)
                                 (let ((user-param (car u-pair))
                                       (user-block (cdr u-pair)))
                                   (if (and user-block (memq user-param (braun-get-params cfg user-block)))
                                       (braun-try-remove-trivial! cfg user-block user-param new-visited))))
                               users))
                            replacement)
                          param))
                    param)
                (let* ((pred (car ps))
                       (raw-op (braun-get-incoming cfg param pred))
                       (op (if raw-op (braun-resolve-val cfg raw-op) param)))
                  (cond
                    ((or (equal? op param) (equal? op same))
                     ;; Unique value so far or self-reference: ignore
                     (loop (cdr ps) same trivial?))
                    ((eq? same #f)
                     ;; First non-self operand encountered
                     (loop (cdr ps) op trivial?))
                    (else
                     ;; Multiple distinct operands: non-trivial phi!
                     (loop '() same #f))))))))) 

(define (braun-add-arguments! cfg block-lbl param var)
  (let ((preds (braun-get-preds cfg block-lbl)))
    (for-each
     (lambda (pred)
       (let ((val (braun-read-variable cfg var pred)))
         (braun-set-incoming! cfg param pred val)))
     preds)
    (braun-try-remove-trivial! cfg block-lbl param '())))

(define (braun-read-variable-recursive cfg var block-lbl)
  (let* ((sealed (braun-cfg-ref cfg 'sealed))
         (is-sealed? (memq block-lbl sealed)))
    (if (not is-sealed?)
        ;; Incomplete CFG: block not sealed yet
        (let ((param (unique-label-sym (string-append "ba_" (symbol->string var) "_"))))
          (braun-add-param! cfg block-lbl param)
          (braun-set-param-var! cfg param var)
          (let* ((incomp (braun-cfg-ref cfg 'incomplete))
                 (entry (assq block-lbl incomp)))
            (if entry
                (set-cdr! entry (cons (cons param var) (cdr entry)))
                (braun-cfg-set! cfg 'incomplete (cons (list block-lbl (cons param var)) incomp))))
          (braun-write-variable! cfg var block-lbl param)
          param)
        ;; Sealed block
        (let ((preds (braun-get-preds cfg block-lbl)))
          (cond
            ((null? preds)
             var)
            ((and (null? (cdr preds)) (not (eq? (car preds) block-lbl)))
             ;; Single predecessor optimization: no block argument needed!
             (let ((val (braun-read-variable cfg var (car preds))))
               (braun-write-variable! cfg var block-lbl val)
               val))
            (else
             ;; Multiple predecessors: create block argument
             (let ((param (unique-label-sym (string-append "ba_" (symbol->string var) "_"))))
               (braun-add-param! cfg block-lbl param)
               (braun-set-param-var! cfg param var)
               (braun-write-variable! cfg var block-lbl param)
               (let ((resolved (braun-add-arguments! cfg block-lbl param var)))
                 (braun-write-variable! cfg var block-lbl resolved)
                 resolved))))))))

(define (braun-read-variable cfg var block-lbl)
  (let* ((defs (braun-cfg-ref cfg 'defs))
         (key (cons var block-lbl))
         (entry (assoc key defs)))
    (if entry
        (braun-resolve-val cfg (cdr entry))
        (braun-read-variable-recursive cfg var block-lbl))))

(define (braun-seal-block! cfg block-lbl)
  (let ((sealed (braun-cfg-ref cfg 'sealed)))
    (if (not (memq block-lbl sealed))
        (begin
          (braun-cfg-set! cfg 'sealed (cons block-lbl sealed))
          (let* ((incomp-entry (assq block-lbl (braun-cfg-ref cfg 'incomplete)))
                 (incomps (if incomp-entry (cdr incomp-entry) '())))
            (if incomp-entry (set-cdr! incomp-entry '()))
            (for-each
             (lambda (pair)
               (let ((param (car pair))
                     (var (cdr pair)))
                 (braun-add-arguments! cfg block-lbl param var)))
             (reverse incomps)))))))

(define (braun-seal-all-blocks! cfg)
  (let ((order (braun-cfg-ref cfg 'order)))
    (for-each (lambda (b) (braun-seal-block! cfg b)) order)
    cfg))

(define (braun-emit-inst! cfg block-lbl inst)
  (let* ((blocks (braun-cfg-ref cfg 'blocks))
         (entry (assq block-lbl blocks)))
    (if entry
        (set-cdr! entry (append (cdr entry) (list inst)))
        (braun-cfg-set! cfg 'blocks (cons (list block-lbl inst) blocks)))))

(define (braun-get-insts cfg block-lbl)
  (let ((entry (assq block-lbl (braun-cfg-ref cfg 'blocks))))
    (if entry (cdr entry) '())))

(define (braun-set-terminator! cfg block-lbl term)
  (let* ((terms (braun-cfg-ref cfg 'terminators))
         (entry (assq block-lbl terms)))
    (if entry
        (set-cdr! entry term)
        (braun-cfg-set! cfg 'terminators (cons (cons block-lbl term) terms)))))

(define (braun-get-terminator cfg block-lbl)
  (let ((entry (assq block-lbl (braun-cfg-ref cfg 'terminators))))
    (if entry (cdr entry) #f)))

(define (braun-auto-add-terminator-edges! cfg block-lbl term)
  (if (pair? term)
      (case (car term)
        ((%jump %direct-jump)
         (braun-add-edge! cfg block-lbl (cadr term)))
        ((%jump-if)
         (braun-add-edge! cfg block-lbl (caddr term))
         (let ((else-lbl (if (= (length term) 4) (cadddr term) (car (cddddr term)))))
           (braun-add-edge! cfg block-lbl else-lbl)))
        ((%jump-if-false %jump-cond)
         (braun-add-edge! cfg block-lbl (caddr term)))
        ((%jump-if-zero)
         (braun-add-edge! cfg block-lbl (cadr term)))
        ((%switch)
         (let* ((def-lbl (caddr term))
                (cases (cond ((= (length term) 5) (car (cddddr term)))
                             ((pair? (cdddr term)) (cadddr term))
                             (else '()))))
           (braun-add-edge! cfg block-lbl def-lbl)
           (for-each
            (lambda (c)
              (let ((c-lbl (if (pair? (cdr c)) (cadr c) (cdr c))))
                (braun-add-edge! cfg block-lbl c-lbl)))
            cases)))
        (else #f))))

;;; Path Splitting & Join Block Bypass for Braun SSA CFG (Chambers & Ungar 1989)
(define (braun-cfg-path-split! cfg)
  (let ((order (braun-cfg-ref cfg 'order)))
    (for-each
     (lambda (join-lbl)
       (let ((term (braun-get-terminator cfg join-lbl)))
         (if (and term (or (eq? (car term) '%jump-if) (eq? (car term) '%jump-if-false)))
             (let* ((cond-var (cadr term))
                    (then-target (if (eq? (car term) '%jump-if) (caddr term) #f))
                    (else-target (if (eq? (car term) '%jump-if) (cadddr term) (caddr term)))
                    (preds (braun-get-preds cfg join-lbl)))
               (for-each
                (lambda (pred-lbl)
                  (let* ((inc-val (braun-resolve-val cfg (braun-get-incoming cfg cond-var pred-lbl)))
                         (pred-term (braun-get-terminator cfg pred-lbl)))
                    (if (and inc-val pred-term (eq? (car pred-term) '%jump) (eq? (cadr pred-term) join-lbl))
                        ;; Check if incoming condition value is statically truthy or falsy
                        (let ((is-false? (or (eq? inc-val #f) (equal? inc-val 47))))
                          (cond
                            ((and is-false? else-target)
                             ;; Bypass join-lbl directly to else-target from pred-lbl
                             (let ((join-insts (braun-get-insts cfg join-lbl)))
                               (for-each (lambda (inst) (braun-emit-inst! cfg pred-lbl inst)) join-insts)
                               (braun-set-terminator! cfg pred-lbl (list '%jump else-target))
                               (braun-add-edge! cfg pred-lbl else-target)))
                            ((and (not is-false?) then-target)
                             ;; Bypass join-lbl directly to then-target from pred-lbl
                             (let ((join-insts (braun-get-insts cfg join-lbl)))
                               (for-each (lambda (inst) (braun-emit-inst! cfg pred-lbl inst)) join-insts)
                               (braun-set-terminator! cfg pred-lbl (list '%jump then-target))
                               (braun-add-edge! cfg pred-lbl then-target))))))))
                preds)))))
     order)
    cfg))

;;; Converts a Braun CFG into structured Block Arguments LIR
(define (braun-cfg->lir cfg)
  (let ((order (braun-cfg-ref cfg 'order)))
    (map
     (lambda (lbl)
       (let* ((params (braun-get-params cfg lbl))
              (raw-insts (braun-get-insts cfg lbl))
              ;; Resolve any variables in instructions
              (insts
               (map (lambda (inst)
                      (if (and (pair? inst) (eq? (car inst) '%inline-asm))
                          (let resolve-clause ((cs (cdr inst)))
                            (if (null? cs)
                                '()
                                (cons
                                 (let ((el (car cs)))
                                   (cond
                                     ((and (pair? el) (memq (car el) '(:inputs :outputs)))
                                      (list (car el)
                                            (map (lambda (entry)
                                                   (map (lambda (sub) (braun-resolve-val cfg sub)) entry))
                                                 (cadr el))))
                                     (else (braun-resolve-val cfg el))))
                                 (resolve-clause (cdr cs)))))
                          (map (lambda (elem) (braun-resolve-val cfg elem)) inst)))
                    raw-insts))
              (term (braun-get-terminator cfg lbl))
              (term-inst
               (cond
                 ((not term) '())
                 ((eq? (car term) '%jump)
                  (let* ((target (cadr term))
                         (target-params (braun-get-params cfg target))
                         (args (map (lambda (p)
                                      (braun-resolve-val cfg (braun-get-incoming cfg p lbl)))
                                    target-params)))
                    (list (list '%jump target args))))
                 ((eq? (car term) '%direct-jump)
                  (let* ((target (cadr term))
                         (target-params (braun-get-params cfg target))
                         (args (map (lambda (p)
                                      (braun-resolve-val cfg (braun-get-incoming cfg p lbl)))
                                    target-params)))
                    (if (null? args)
                        (list (list '%direct-jump target))
                        (list (list '%jump target args)))))
                 ((eq? (car term) '%jump-if-false)
                  (let* ((cond-var (braun-resolve-val cfg (cadr term)))
                         (else-lbl (caddr term))
                         (else-params (braun-get-params cfg else-lbl))
                         (else-args (map (lambda (p)
                                           (braun-resolve-val cfg (braun-get-incoming cfg p lbl)))
                                         else-params)))
                    (list (list '%jump-if-false cond-var else-lbl else-args))))
                 ((eq? (car term) '%jump-if)
                  (let* ((cond-var (braun-resolve-val cfg (cadr term)))
                         (then-lbl (caddr term))
                         (else-lbl (if (= (length term) 4) (cadddr term) (car (cddddr term))))
                         (then-params (braun-get-params cfg then-lbl))
                         (then-args (map (lambda (p)
                                           (braun-resolve-val cfg (braun-get-incoming cfg p lbl)))
                                         then-params))
                         (else-params (braun-get-params cfg else-lbl))
                         (else-args (map (lambda (p)
                                           (braun-resolve-val cfg (braun-get-incoming cfg p lbl)))
                                         else-params)))
                    (list (list '%jump-if cond-var then-lbl then-args else-lbl else-args))))
                 ((eq? (car term) '%switch)
                  (let* ((cond-var (braun-resolve-val cfg (cadr term)))
                         (def-lbl (caddr term))
                         (cases (cond ((= (length term) 5) (car (cddddr term)))
                                      ((pair? (cdddr term)) (cadddr term))
                                      (else '())))
                         (def-params (braun-get-params cfg def-lbl))
                         (def-args (map (lambda (p)
                                          (braun-resolve-val cfg (braun-get-incoming cfg p lbl)))
                                        def-params))
                         (lowered-cases
                          (map (lambda (c)
                                 (let* ((c-val (car c))
                                        (c-lbl (if (pair? (cdr c)) (cadr c) (cdr c)))
                                        (c-params (braun-get-params cfg c-lbl))
                                        (c-args (map (lambda (p)
                                                       (braun-resolve-val cfg (braun-get-incoming cfg p lbl)))
                                                     c-params)))
                                   (list c-val c-lbl c-args)))
                               cases)))
                    (list (list '%switch cond-var def-lbl def-args lowered-cases))))
                 ((eq? (car term) '%return)
                  (let ((val (if (pair? (cdr term))
                                 (braun-resolve-val cfg (cadr term))
                                 '%rax)))
                    (list (list '%return val))))
                 (else
                  (list (map (lambda (elem) (braun-resolve-val cfg elem)) term)))))
              (block-body (append insts term-inst)))
         (cons '%block (cons lbl (cons params block-body)))))
     order)))

;;; -----------------------------------------------------------------------
;;; Dominator Tree & Dominance Frontiers (Cooper et al. 2001)
;;; -----------------------------------------------------------------------
(define (braun-block-rpo-index order b)
  (let loop ((os order) (idx 0))
    (cond
      ((null? os) 999999)
      ((eq? (car os) b) idx)
      (else (loop (cdr os) (+ idx 1))))))

(define (braun-intersect-doms order idom b1 b2)
  (let loop ((finger1 b1) (finger2 b2))
    (cond
      ((eq? finger1 finger2) finger1)
      ((> (braun-block-rpo-index order finger1) (braun-block-rpo-index order finger2))
       (let ((p1 (assq finger1 idom)))
         (if (and p1 (not (eq? (cdr p1) finger1)))
             (loop (cdr p1) finger2)
             finger2)))
      (else
       (let ((p2 (assq finger2 idom)))
         (if (and p2 (not (eq? (cdr p2) finger2)))
             (loop finger1 (cdr p2))
             finger1))))))

(define (braun-compute-dominators cfg)
  (let* ((order (braun-cfg-ref cfg 'order)))
    (if (null? order) '()
        (let* ((entry (car order))
               (idom (map (lambda (b) (cons b (if (eq? b entry) entry #f))) order)))
          (let outer-loop ((changed? #t))
            (if (not changed?)
                (filter (lambda (entry) (cdr entry)) idom)
                (let inner-loop ((bs (cdr order)) (any-change? #f))
                  (if (null? bs)
                      (outer-loop any-change?)
                      (let* ((b (car bs))
                             (preds (braun-get-preds cfg b))
                             (processed-preds (filter (lambda (p)
                                                        (let ((cell (assq p idom)))
                                                          (and cell (cdr cell))))
                                                      preds)))
                        (if (null? processed-preds)
                            (inner-loop (cdr bs) any-change?)
                            (let* ((new-idom
                                    (let fold-p ((ps (cdr processed-preds))
                                                 (acc (car processed-preds)))
                                      (if (null? ps) acc
                                          (fold-p (cdr ps)
                                                  (braun-intersect-doms order idom (car ps) acc)))))
                                   (cur (assq b idom)))
                              (if (not (eq? (cdr cur) new-idom))
                                  (begin
                                    (set-cdr! cur new-idom)
                                    (inner-loop (cdr bs) #t))
                                  (inner-loop (cdr bs) any-change?)))))))))))))

(define (braun-compute-dominance-frontiers cfg idom-map)
  (let* ((order (braun-cfg-ref cfg 'order))
         (df-map (map (lambda (b) (cons b '())) order)))
    (for-each
     (lambda (b)
       (let ((preds (braun-get-preds cfg b)))
         (if (and (pair? preds) (pair? (cdr preds)))
             (let ((b-idom-entry (assq b idom-map)))
               (if b-idom-entry
                   (let ((b-idom (cdr b-idom-entry)))
                     (for-each
                      (lambda (p)
                        (let runner-loop ((runner p))
                          (if (and (not (eq? runner b-idom))
                                   (assq runner idom-map))
                              (begin
                                (let ((df-entry (assq runner df-map)))
                                  (if (and df-entry (not (memq b (cdr df-entry))))
                                      (set-cdr! df-entry (cons b (cdr df-entry)))))
                                (let ((r-idom-entry (assq runner idom-map)))
                                  (if (and r-idom-entry (not (eq? (cdr r-idom-entry) runner)))
                                      (runner-loop (cdr r-idom-entry))))))))
                      preds)))))))
     order)
    df-map))

;;; -----------------------------------------------------------------------
;;; CFG Verification (Integrity & Invariant Check)
;;; -----------------------------------------------------------------------
(define (braun-verify-cfg cfg)
  (let ((order (braun-cfg-ref cfg 'order))
        (sealed (braun-cfg-ref cfg 'sealed))
        (incomplete (braun-cfg-ref cfg 'incomplete)))
    ;; 1. All blocks must be sealed
    (for-each
     (lambda (b)
       (if (not (memq b sealed))
           (error "Braun CFG verification failure: block not sealed:" b)))
     order)
    ;; 2. Incomplete entries must be empty
    (for-each
     (lambda (inc-pair)
       (if (and (pair? (cdr inc-pair)) (not (null? (cdr inc-pair))))
           (error "Braun CFG verification failure: unresolved incomplete variables in block:" (car inc-pair))))
     incomplete)
    ;; 3. Check every block parameter has incoming values from all predecessors
    (for-each
     (lambda (b)
       (let ((params (braun-get-params cfg b))
             (preds (braun-get-preds cfg b)))
         (for-each
          (lambda (param)
            (for-each
             (lambda (pred)
               (let ((inc (braun-get-incoming cfg param pred)))
                 (if (not inc)
                     (error "Braun CFG verification failure: missing incoming value for param:" param "from pred:" pred "in block:" b))))
             preds))
          params)))
     order)
    ;; 4. Check terminator targets exist in CFG
    (for-each
     (lambda (b)
       (let ((term (braun-get-terminator cfg b)))
         (if term
             (case (car term)
               ((%jump %direct-jump)
                (if (not (memq (cadr term) order))
                    (error "Braun CFG verification failure: unknown jump target in block:" b (cadr term))))
               ((%jump-if)
                (if (not (memq (caddr term) order))
                    (error "Braun CFG verification failure: unknown then-target in block:" b (caddr term)))
                (let ((else-lbl (if (= (length term) 4) (cadddr term) (car (cddddr term)))))
                  (if (not (memq else-lbl order))
                      (error "Braun CFG verification failure: unknown else-target in block:" b else-lbl))))
               ((%jump-if-false %jump-cond)
                (if (not (memq (caddr term) order))
                    (error "Braun CFG verification failure: unknown else-target in block:" b (caddr term))))
               ((%jump-if-zero)
                (if (not (memq (cadr term) order))
                    (error "Braun CFG verification failure: unknown zero-target in block:" b (cadr term))))
               ((%switch)
                (let ((def-lbl (caddr term))
                      (cases (cond ((= (length term) 5) (car (cddddr term)))
                                   ((pair? (cdddr term)) (cadddr term))
                                   (else '()))))
                  (if (not (memq def-lbl order))
                      (error "Braun CFG verification failure: unknown switch default target:" def-lbl))
                  (for-each
                   (lambda (c)
                     (let ((c-lbl (if (pair? (cdr c)) (cadr c) (cdr c))))
                       (if (not (memq c-lbl order))
                           (error "Braun CFG verification failure: unknown switch case target:" c-lbl))))
                   cases)))
               (else #t)))))
     order)
    #t))

;;; -----------------------------------------------------------------------
;;; mem2reg Stack Variable Promotion (DSN-38 Section 2 D1, Issue #922)
;;; -----------------------------------------------------------------------
(define (braun-inst-returns-twice? inst)
  (and (pair? inst)
       (pair? (cdr inst))
       (case (car inst)
         ((%direct-call)
          (if (memq (cadr inst) '(__ulisp_setjmp setjmp _setjmp sigsetjmp)) #t #f))
         ((%c-call %call-foreign)
          (let ((fn (cadr inst)))
            (cond
              ((symbol? fn)
               (if (memq fn '(__ulisp_setjmp setjmp _setjmp sigsetjmp)) #t #f))
              ((string? fn)
               (if (or (string=? fn "__ulisp_setjmp")
                       (string=? fn "setjmp")
                       (string=? fn "_setjmp")
                       (string=? fn "sigsetjmp"))
                   #t
                   #f))
              (else #f))))
         (else #f))))

(define (braun-cfg-has-returns-twice? cfg)
  (let loop-blocks ((bs (braun-cfg-ref cfg 'blocks)))
    (if (null? bs)
        #f
        (let loop-insts ((is (cdar bs)))
          (cond
            ((null? is) (loop-blocks (cdr bs)))
            ((braun-inst-returns-twice? (car is)) #t)
            (else (loop-insts (cdr is))))))))

(define (braun-promote-alloca-to-ssa cfg candidate-offsets)
  (if (braun-cfg-has-returns-twice? cfg)
      #f
      (let ((order (braun-cfg-ref cfg 'order)))
        (for-each
         (lambda (b)
           (let* ((insts (braun-get-insts cfg b))
                  (new-insts
                   (let loop ((is insts) (acc '()))
                     (if (null? is) (reverse acc)
                         (let ((inst (car is)))
                           (cond
                             ;; (%store %rsp offset val)
                             ((and (pair? inst) (eq? (car inst) '%store)
                                   (eq? (cadr inst) '%rsp)
                                   (braun-member? (caddr inst) candidate-offsets))
                              (let* ((offset (caddr inst))
                                     (val (cadddr inst))
                                     (var (string->symbol (string-append "stk_" (number->string offset)))))
                                (braun-write-variable! cfg var b (braun-resolve-val cfg val))
                                (loop (cdr is) acc)))
                             ;; (%load dst %rsp offset)
                             ((and (pair? inst) (eq? (car inst) '%load)
                                   (eq? (caddr inst) '%rsp)
                                   (braun-member? (cadddr inst) candidate-offsets))
                              (let* ((dst (cadr inst))
                                     (offset (cadddr inst))
                                     (var (string->symbol (string-append "stk_" (number->string offset))))
                                     (val (braun-read-variable cfg var b)))
                                (loop (cdr is) (cons (list '%mov dst (braun-resolve-val cfg val)) acc))))
                             (else
                              (loop (cdr is) (cons inst acc)))))))))
             ;; Update block instructions
             (let ((blocks (braun-cfg-ref cfg 'blocks)))
               (let ((entry (assq b blocks)))
                 (if entry (set-cdr! entry new-insts))))))
         order)
        #t)))

;;; -----------------------------------------------------------------------
;;; Register-Safe & ABI-Safe C99 LIR mem2reg & Intra-Block Promotion (Issue #927)
;;; -----------------------------------------------------------------------

(define (%c99-m2r-reg? x)
  (case x
    ((%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp
      %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15 %al %cl)
     #t)
    (else #f)))

(define (%c99-m2r-caller-saved? x)
  (case x
    ((%rax %rcx %rdx %rsi %rdi %r8 %r9 %r10 %r11 %al %cl
      %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
      %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15)
     #t)
    (else #f)))

(define (%c99-m2r-tree-has? tree sym)
  (cond
    ((eq? tree sym) #t)
    ((pair? tree)
     (or (%c99-m2r-tree-has? (car tree) sym)
         (%c99-m2r-tree-has? (cdr tree) sym)))
    (else #f)))

(define (%c99-m2r-type-width ty)
  (case ty
    ((bool i8 u8) 1)
    ((i16 u16) 2)
    ((i32 u32 f32) 4)
    ((i64 u64 f64 ptr raw-bits) 8)
    (else #f)))

(define (%c99-m2r-canon-int-kind ty)
  (case ty
    ((bool u8) 'u8)
    ((i8)      'i8)
    ((u16)     'u16)
    ((i16)     'i16)
    ((u32)     'u32)
    ((i32)     'i32)
    ((i64 u64 ptr raw-bits) 'i64)
    (else #f)))

(define (%c99-m2r-norm-int kind v)
  (case kind
    ((u8)  (modulo v 256))
    ((u16) (modulo v 65536))
    ((u32) (modulo v 4294967296))
    ((i8)  (let ((m (modulo v 256))) (if (>= m 128) (- m 256) m)))
    ((i16) (let ((m (modulo v 65536))) (if (>= m 32768) (- m 65536) m)))
    ((i32) (let ((m (modulo v 4294967296))) (if (>= m 2147483648) (- m 4294967296) m)))
    (else v)))

(define (%c99-m2r-managed-or-unsafe-body? insts)
  (let loop ((xs insts))
    (if (null? xs)
        #f
        (let ((inst (car xs)))
          (if (or (not (pair? inst))
                  (memq (car inst)
                        '(%block %alloc %alloc-stack %managed-alloc %managed-alloc-stack
                          %managed-safepoint-poll %safepoint-poll %managed-write-barrier
                          %managed-box %managed-unbox %capture-cc %push-handler %pop-handler
                          %raise %set-values-count %store-values-buf %call-closure
                          %dispatch-consumer %inline-asm %atomic-cas! %push %pop))
                  (%c99-m2r-tree-has? inst '%stack)
                  (%c99-m2r-tree-has? inst '%disp)
                  (%c99-m2r-tree-has? inst '%mem))
              #t
              (loop (cdr xs)))))))

(define (%c99-m2r-call-inst? inst)
  (and (pair? inst)
       (memq (car inst) '(%c-call %direct-call %call-indirect %call-foreign %syscall))))

(define (%c99-m2r-rsp-escape-inst? inst)
  (if (not (pair? inst))
      #t
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%mov) (>= (length inst) 3))
           (or (eq? (cadr inst) '%rsp) (eq? (caddr inst) '%rsp)))
          ((and (memq op '(%store %store-byte)) (>= (length inst) 4))
           (or (not (eq? (cadr inst) '%rsp))
               (not (integer? (caddr inst)))
               (eq? (cadddr inst) '%rsp)))
          ((and (eq? op '%store-typed) (>= (length inst) 5))
           (or (not (eq? (caddr inst) '%rsp))
               (not (integer? (cadddr inst)))
               (eq? (car (cddddr inst)) '%rsp)))
          ((and (memq op '(%load %load-byte-zx)) (>= (length inst) 4))
           (or (eq? (cadr inst) '%rsp)
               (and (eq? (caddr inst) '%rsp) (not (integer? (cadddr inst))))))
          ((and (eq? op '%load-typed) (>= (length inst) 5))
           (or (eq? (caddr inst) '%rsp)
               (and (eq? (cadddr inst) '%rsp) (not (integer? (car (cddddr inst)))))))
          (else
           (%c99-m2r-tree-has? inst '%rsp))))))

(define (%c99-m2r-match-rsp-load inst)
  ;; Returns (dst off width kind) or #f
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%load) (= (length inst) 4)
                (eq? (caddr inst) '%rsp) (integer? (cadddr inst)))
           (list (cadr inst) (cadddr inst) 8 'i64))
          ((and (eq? op '%load-byte-zx) (= (length inst) 4)
                (eq? (caddr inst) '%rsp) (integer? (cadddr inst)))
           (list (cadr inst) (cadddr inst) 1 'u8))
          ((and (eq? op '%load-typed) (= (length inst) 5)
                (eq? (cadddr inst) '%rsp) (integer? (car (cddddr inst))))
           (let* ((mty (cadr inst))
                  (w (%c99-m2r-type-width mty)))
             (if w
                 (list (caddr inst) (car (cddddr inst)) w mty)
                 #f)))
          (else #f)))))

(define (%c99-m2r-match-rsp-store inst)
  ;; Returns (off width kind src) or #f
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%store) (= (length inst) 4)
                (eq? (cadr inst) '%rsp) (integer? (caddr inst)))
           (list (caddr inst) 8 'i64 (cadddr inst)))
          ((and (eq? op '%store-byte) (= (length inst) 4)
                (eq? (cadr inst) '%rsp) (integer? (caddr inst)))
           (list (caddr inst) 1 'u8 (cadddr inst)))
          ((and (eq? op '%store-typed) (= (length inst) 5)
                (eq? (caddr inst) '%rsp) (integer? (cadddr inst)))
           (let* ((mty (cadr inst))
                  (w (%c99-m2r-type-width mty)))
             (if w
                 (list (cadddr inst) w mty (car (cddddr inst)))
                 #f)))
          (else #f)))))

(define (%c99-m2r-all-gprs)
  '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp
    %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15 %al %cl))

(define (%c99-m2r-all-kill-regs)
  '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp
    %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15 %al %cl
    %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
    %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15))

(define (%c99-m2r-collect-used-gprs insts)
  (let ((regs-box (cons '() '())))
    (for-each
     (lambda (inst)
       (for-each
        (lambda (r)
          (if (and (not (memq r (car regs-box)))
                   (or (%c99-m2r-tree-has? inst r)
                       (lir-inst-defines-reg? inst r)))
              (set-car! regs-box (cons r (car regs-box)))))
        (%c99-m2r-all-gprs)))
     insts)
    (car regs-box)))

(define (%c99-m2r-free-scratch-pool insts)
  (let* ((used (%c99-m2r-collect-used-gprs insts))
         (has-switch?
          (let loop ((xs insts))
            (and (pair? xs)
                 (or (and (pair? (car xs)) (eq? (caar xs) '%switch))
                     (loop (cdr xs))))))
         (p0 '())
         (p1 (if (memq '%r8 used) p0 (cons '%r8 p0)))
         (p2 (if (memq '%r9 used) p1 (cons '%r9 p1)))
         (p3 (if (or has-switch? (memq '%r10 used)) p2 (cons '%r10 p2)))
         (p4 (if (or has-switch? (memq '%r11 used)) p3 (cons '%r11 p3))))
    (reverse p4)))

(define (%c99-m2r-intervals-overlap? lo1 hi1 lo2 hi2)
  (and (< lo1 hi2) (< lo2 hi1)))

(define (%c99-m2r-insert-sort-candidates xs)
  (let loop ((rem xs) (sorted '()))
    (if (null? rem)
        sorted
        (let ((cur (car rem)))
          (let ins ((ss sorted) (acc '()))
            (if (null? ss)
                (loop (cdr rem) (reverse (cons cur acc)))
                (if (>= (cdr cur) (cdr (car ss)))
                    (loop (cdr rem) (append (reverse acc) (cons cur ss)))
                    (ins (cdr ss) (cons (car ss) acc)))))))))

(define (%c99-m2r-find-leaf-slot-map insts pool)
  ;; Scans all negative %rsp accesses; returns alist of (off . (preg . canon-kind))
  (let ((stats-box (cons '() '()))
        (bad-box (cons #f '())))
    (define (record-acc! off width kind is-load?)
      (let ((cur (assv off (car stats-box))))
        (if cur
            (let ((rec (cdr cur)))
              ;; rec = (width loads stores kinds-list has-float?)
              (if (or (not (= (list-ref rec 0) width))
                      (memq kind '(f32 f64)))
                  (set-car! rec -1))
              (if is-load?
                  (let ((ld-box (list-ref rec 1)))
                    (set-car! ld-box (+ (car ld-box) 1))
                    (let ((ks (list-ref rec 3)))
                      (if (not (memq kind (car ks)))
                          (set-car! ks (cons kind (car ks))))))
                  (let ((st-box (list-ref rec 2)))
                    (set-car! st-box (+ (car st-box) 1))
                    (let ((ks (list-ref rec 4)))
                      (if (not (memq kind (car ks)))
                          (set-car! ks (cons kind (car ks))))))))
            (let ((init-w (if (memq kind '(f32 f64)) -1 width)))
              (set-car! stats-box
                        (cons (cons off
                                    (list init-w
                                          (cons (if is-load? 1 0) '())
                                          (cons (if is-load? 0 1) '())
                                          (cons (if is-load? (list kind) '()) '())
                                          (cons (if is-load? '() (list kind)) '())))
                              (car stats-box)))))))
    (for-each
     (lambda (inst)
       (if (%c99-m2r-tree-has? inst '%stack)
           (set-car! bad-box #t))
       (let ((ld (%c99-m2r-match-rsp-load inst))
             (st (%c99-m2r-match-rsp-store inst)))
         (cond
           (ld
            (if (< (cadr ld) 0)
                (record-acc! (cadr ld) (caddr ld) (cadddr ld) #t)
                (set-car! bad-box #t)))
           (st
            (if (< (car st) 0)
                (record-acc! (car st) (cadr st) (caddr st) #f)
                (set-car! bad-box #t)))
           ((%c99-m2r-tree-has? inst '%rsp)
            (set-car! bad-box #t)))))
     insts)
    (if (car bad-box)
        '()
        (let* ((stats (car stats-box))
               (eligible
                (let loop ((xs stats) (acc '()))
                  (if (null? xs)
                      acc
                      (let* ((off (caar xs))
                             (rec (cdar xs))
                             (w (list-ref rec 0))
                             (lds (car (list-ref rec 1)))
                             (sts (car (list-ref rec 2)))
                             (l-kinds (car (list-ref rec 3)))
                             (s-kinds (car (list-ref rec 4)))
                             (hi (+ off w))
                             (overlaps?
                              (let chk ((ys stats))
                                (if (null? ys)
                                    #f
                                    (let* ((o2 (caar ys))
                                           (r2 (cdar ys))
                                           (w2 (let ((raw-w (list-ref r2 0)))
                                                 (if (> raw-w 0) raw-w 8))))
                                      (if (and (not (= o2 off))
                                               (%c99-m2r-intervals-overlap? off hi o2 (+ o2 w2)))
                                          #t
                                          (chk (cdr ys))))))))
                        (if (and (> w 0)
                                 (not overlaps?)
                                 (> lds 0)
                                 (> sts 0)
                                 (= (length l-kinds) 1)
                                 (>= w 1))
                            (let ((lk (%c99-m2r-canon-int-kind (car l-kinds)))
                                  (all-compat-stores?
                                   (let cl ((sks s-kinds))
                                     (or (null? sks)
                                         (and (%c99-m2r-canon-int-kind (car sks))
                                              (= (%c99-m2r-type-width (car sks)) w)
                                              (cl (cdr sks)))))))
                              (if (and lk all-compat-stores?)
                                  (loop (cdr xs) (cons (cons (list off lk) (+ lds sts)) acc))
                                  (loop (cdr xs) acc)))
                            (loop (cdr xs) acc))))))
               (ranked (%c99-m2r-insert-sort-candidates eligible)))
          (let assign ((cs ranked) (ps pool) (res '()))
            (if (or (null? cs) (null? ps))
                (reverse res)
                (let ((off (caaar cs))
                      (kind (cadar (car cs)))
                      (preg (car ps)))
                  (assign (cdr cs) (cdr ps)
                          (cons (list off preg kind) res)))))))))

(define (%c99-m2r-promote-leaf-slots insts)
  (let* ((has-call?
          (let loop ((xs insts))
            (and (pair? xs) (or (%c99-m2r-call-inst? (car xs)) (loop (cdr xs))))))
         (has-escape?
          (let loop ((xs insts))
            (and (pair? xs) (or (%c99-m2r-rsp-escape-inst? (car xs)) (loop (cdr xs)))))))
    (if (or has-call? has-escape?)
        insts
        (let ((pool (%c99-m2r-free-scratch-pool insts)))
          (if (null? pool)
              insts
              (let ((slot-map (%c99-m2r-find-leaf-slot-map insts pool)))
                (if (null? slot-map)
                    insts
                    (let loop ((xs insts) (acc '()))
                      (if (null? xs)
                          (reverse acc)
                          (let* ((inst (car xs))
                                 (ld (%c99-m2r-match-rsp-load inst))
                                 (st (%c99-m2r-match-rsp-store inst)))
                            (cond
                              ((and ld (assv (cadr ld) slot-map))
                               => (lambda (slot)
                                    (let ((dst (car ld))
                                          (preg (cadr slot)))
                                      (loop (cdr xs)
                                            (if (eq? dst preg)
                                                acc
                                                (cons (list '%mov dst preg) acc))))))
                              ((and st (assv (car st) slot-map))
                               => (lambda (slot)
                                    (let* ((preg (cadr slot))
                                           (kind (caddr slot))
                                           (src (cadddr st))
                                           (new-inst
                                            (cond
                                              ((integer? src)
                                               (list '%mov preg (%c99-m2r-norm-int kind src)))
                                              ((eq? kind 'i64)
                                               (if (eq? preg src) #f (list '%mov preg src)))
                                              ((memq kind '(i8 i16 i32))
                                               (list '%sext kind preg src))
                                              (else
                                               (list '%zext kind preg src)))))
                                      (loop (cdr xs)
                                            (if new-inst (cons new-inst acc) acc)))))
                              (else
                               (loop (cdr xs) (cons inst acc))))))))))))))

(define (%c99-m2r-inst-reads-any-reg? inst regs)
  ;; Over-approximation: check if any symbol in regs appears in rhs operands or implicit uses
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (or (and (memq op '(%cqo %idiv %udiv %urem))
                 (or (memq '%rax regs) (memq '%rdx regs)))
            (and (memq op '(%shl %shr %sar))
                 (= (length inst) 3)
                 (not (integer? (caddr inst)))
                 (memq '%rcx regs))
            (and (memq op '(%return))
                 (memq '%rax regs))
            (let loop ((rs regs))
              (if (null? rs)
                  #f
                  (if (%c99-m2r-tree-has? inst (car rs))
                      #t
                      (loop (cdr rs)))))))))

(define (%c99-m2r-slot-env-kill-overlap env off w)
  (let ((hi (+ off w)))
    (let loop ((xs env) (acc '()))
      (if (null? xs)
          (reverse acc)
          (let* ((e (car xs))
                 (eo (list-ref e 0))
                 (ew (list-ref e 1)))
            (if (%c99-m2r-intervals-overlap? off hi eo (+ eo ew))
                (loop (cdr xs) acc)
                (loop (cdr xs) (cons e acc))))))))

(define (%c99-m2r-slot-env-kill-reg env reg)
  (let loop ((xs env) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let* ((e (car xs))
               (val (list-ref e 3)))
          (if (and (memq (car val) '(reg loaded-reg freg))
                   (lir-reg-aliases? (cdr val) reg))
              (loop (cdr xs) acc)
              (loop (cdr xs) (cons e acc)))))))

(define (%c99-m2r-slot-env-kill-caller-regs env keep-consts?)
  (let loop ((xs env) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let* ((e (car xs))
               (val (list-ref e 3)))
          (cond
            ((eq? (car val) 'const)
             (if keep-consts?
                 (loop (cdr xs) (cons e acc))
                 (loop (cdr xs) acc)))
            ((and (memq (car val) '(reg loaded-reg)) (not (%c99-m2r-caller-saved? (cdr val))))
             (loop (cdr xs) (cons e acc)))
            (else
             (loop (cdr xs) acc)))))))

(define (%c99-m2r-reg-env-kill env inst)
  (let loop ((xs env) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let* ((r (caar xs))
               (val (cdar xs)))
          (if (or (lir-inst-defines-reg? inst r)
                  (and (eq? (car val) 'reg) (lir-inst-defines-reg? inst (cdr val))))
              (loop (cdr xs) acc)
              (loop (cdr xs) (cons (car xs) acc)))))))

(define (%c99-m2r-forward-blocks insts)
  (let* ((has-escape?
          (let loop ((xs insts))
            (and (pair? xs) (or (%c99-m2r-rsp-escape-inst? (car xs)) (loop (cdr xs))))))
         (has-rt? (braun-cfg-has-returns-twice? (list (cons 'blocks (list (cons 'entry insts))))))
         (safe-across-calls? (and (not has-escape?) (not has-rt?))))
    (let loop ((xs insts) (slot-env '()) (reg-env '()) (acc '()))
      (if (null? xs)
          (reverse acc)
          (let ((inst (car xs)))
            (if (not (pair? inst))
                (loop (cdr xs) '() '() (cons inst acc))
                (let ((op (car inst))
                      (ld (%c99-m2r-match-rsp-load inst))
                      (st (%c99-m2r-match-rsp-store inst)))
                  (cond
                    ;; 1. Block terminators / labels reset intrablock state
                    ((or (lir-label-inst? inst)
                         (lir-inst-terminates-block? inst))
                     (loop (cdr xs) '() '() (cons inst acc)))

                    ;; 2. Calls preserve non-escaped constant stack slots if no setjmp/rsp-escape
                    ((%c99-m2r-call-inst? inst)
                     (loop (cdr xs)
                           (if safe-across-calls?
                               (%c99-m2r-slot-env-kill-caller-regs slot-env #t)
                               '())
                           '()
                           (cons inst acc)))

                    ;; 3. Other memory barriers reset everything
                    ((lir-inst-memory-barrier? inst)
                     (loop (cdr xs) '() '() (cons inst acc)))

                    ;; 4. Store to negative %rsp slot
                    ((and st (< (car st) 0))
                     (let* ((off (car st))
                            (w (cadr st))
                            (skind (caddr st))
                            (src (cadddr st))
                            (s-env0 (%c99-m2r-slot-env-kill-overlap slot-env off w))
                            (s-val (cond
                                     ((integer? src)
                                      (if (memq skind '(f32 f64))
                                          #f
                                          (let ((c-k (%c99-m2r-canon-int-kind skind)))
                                            (cons 'const (if c-k (%c99-m2r-norm-int c-k src) src)))))
                                     ((%c99-m2r-reg? src)
                                      (let ((r-hit (assq src reg-env)))
                                        (if (and r-hit (eq? (car (cdr r-hit)) 'const))
                                            (let ((c-k (%c99-m2r-canon-int-kind skind)))
                                              (cons 'const (if c-k
                                                               (%c99-m2r-norm-int c-k (cdr (cdr r-hit)))
                                                               (cdr (cdr r-hit)))))
                                            (if r-hit (cdr r-hit) (cons 'reg src)))))
                                     ((and (memq skind '(f64)) (lir-float-register? src))
                                      (cons 'freg src))
                                     (else #f)))
                            (s-env1 (if s-val
                                        (cons (list off w skind s-val) s-env0)
                                        s-env0)))
                       (loop (cdr xs) s-env1 reg-env (cons inst acc))))

                    ;; 5. Store to non-%rsp memory may alias if %rsp escaped
                    ((memq op '(%store %store-byte %store-typed))
                     (loop (cdr xs)
                           (if safe-across-calls? slot-env '())
                           reg-env
                           (cons inst acc)))

                    ;; 6. Load from negative %rsp slot
                    ((and ld (< (cadr ld) 0))
                     (let* ((dst (car ld))
                            (off (cadr ld))
                            (w (caddr ld))
                            (lkind (cadddr ld))
                            (l-c-kind (%c99-m2r-canon-int-kind lkind))
                            (hit (assv off slot-env))
                            (forwarded-inst
                             (if (and hit (= (list-ref hit 1) w))
                                 (let ((skind (list-ref hit 2))
                                       (vdesc (list-ref hit 3)))
                                   (cond
                                     ((and l-c-kind (not (memq skind '(f32 f64))) (eq? (car vdesc) 'const))
                                      (list '%mov dst (%c99-m2r-norm-int l-c-kind (cdr vdesc))))
                                     ((and l-c-kind (not (memq skind '(f32 f64))) (memq (car vdesc) '(reg loaded-reg)))
                                      (let ((sreg (cdr vdesc))
                                            (s-c-kind (%c99-m2r-canon-int-kind skind))
                                            (already-ext? (eq? (car vdesc) 'loaded-reg)))
                                        (cond
                                          ((or (= w 8)
                                               (and already-ext? (eq? s-c-kind l-c-kind)))
                                           (list '%mov dst sreg))
                                          ((memq l-c-kind '(i8 i16 i32))
                                           (list '%sext l-c-kind dst sreg))
                                          ((memq l-c-kind '(u8 u16 u32))
                                           (list '%zext l-c-kind dst sreg))
                                          (else #f))))
                                     ((and (eq? lkind 'f64) (eq? skind 'f64) (eq? (car vdesc) 'freg))
                                      (list '%fmov dst (cdr vdesc)))
                                     (else #f)))
                                 #f))
                            (emit-i (or forwarded-inst inst))
                            (r-env1 (%c99-m2r-reg-env-kill reg-env emit-i))
                            (s-env1
                             (let loop-kill ((rs (%c99-m2r-all-kill-regs)) (se slot-env))
                               (if (null? rs)
                                   se
                                   (loop-kill (cdr rs)
                                              (if (lir-inst-defines-reg? emit-i (car rs))
                                                  (%c99-m2r-slot-env-kill-reg se (car rs))
                                                  se)))))
                            (r-env2 (cond
                                      ((and (pair? emit-i) (eq? (car emit-i) '%mov) (= (length emit-i) 3)
                                            (%c99-m2r-reg? (cadr emit-i)) (integer? (caddr emit-i)))
                                       (cons (cons (cadr emit-i) (cons 'const (caddr emit-i))) r-env1))
                                      ((and (pair? emit-i) (eq? (car emit-i) '%mov) (= (length emit-i) 3)
                                            (%c99-m2r-reg? (cadr emit-i)) (%c99-m2r-reg? (caddr emit-i)))
                                       (let ((rh (assq (caddr emit-i) r-env1)))
                                         (if (and rh (eq? (car (cdr rh)) 'const))
                                             (cons (cons (cadr emit-i) (cdr rh)) r-env1)
                                             r-env1)))
                                      (else r-env1)))
                            (s-env2 (if (and (not forwarded-inst) l-c-kind (%c99-m2r-reg? dst))
                                        (cons (list off w lkind (cons 'loaded-reg dst))
                                              (%c99-m2r-slot-env-kill-overlap s-env1 off w))
                                        s-env1)))
                       (loop (cdr xs)
                             s-env2
                             r-env2
                             (if (and (memq (car emit-i) '(%mov %fmov)) (eq? (cadr emit-i) (caddr emit-i)))
                                 acc
                                 (cons emit-i acc)))))

                    ;; 7. Any other instruction: propagate reg-env & kill overwritten regs
                    (else
                     (let* ((r-env1 (%c99-m2r-reg-env-kill reg-env inst))
                            (s-env1
                             (let loop-kill ((rs (%c99-m2r-all-kill-regs)) (se slot-env))
                               (if (null? rs)
                                   se
                                   (loop-kill (cdr rs)
                                              (if (lir-inst-defines-reg? inst (car rs))
                                                  (%c99-m2r-slot-env-kill-reg se (car rs))
                                                  se)))))
                            (r-env2
                             (cond
                               ((and (eq? op '%mov) (= (length inst) 3)
                                     (%c99-m2r-reg? (cadr inst)) (integer? (caddr inst)))
                                (cons (cons (cadr inst) (cons 'const (caddr inst))) r-env1))
                               ((and (eq? op '%mov) (= (length inst) 3)
                                     (%c99-m2r-reg? (cadr inst)) (%c99-m2r-reg? (caddr inst)))
                                (let ((rh (assq (caddr inst) reg-env)))
                                  (if (and rh (not (eq? (cadr inst) (caddr inst))))
                                      (if (eq? (car (cdr rh)) 'const)
                                          (cons (cons (cadr inst) (cdr rh)) r-env1)
                                          r-env1)
                                      r-env1)))
                               (else r-env1)))
                            ;; If %mov reg1 reg2 where reg2 holds a constant in reg-env, replace with (%mov reg1 imm)!
                            (final-inst
                             (if (and (eq? op '%mov) (= (length inst) 3)
                                      (%c99-m2r-reg? (cadr inst)) (%c99-m2r-reg? (caddr inst)))
                                 (let ((rh (assq (caddr inst) reg-env)))
                                   (if (and rh (eq? (car (cdr rh)) 'const))
                                       (list '%mov (cadr inst) (cdr (cdr rh)))
                                       inst))
                                 inst)))
                       (loop (cdr xs) s-env1 r-env2 (cons final-inst acc))))))))))
    ))

(define (%c99-m2r-elim-dead-stores-intra-block insts)
  (let* ((has-escape?
          (let loop ((xs insts))
            (and (pair? xs) (or (%c99-m2r-rsp-escape-inst? (car xs)) (loop (cdr xs))))))
         (has-rt? (braun-cfg-has-returns-twice? (list (cons 'blocks (list (cons 'entry insts))))))
         (safe-across-calls? (and (not has-escape?) (not has-rt?))))
    (let loop ((xs (reverse insts)) (dead-ivs '()) (acc '()))
      (if (null? xs)
          acc
          (let* ((inst (car xs))
                 (ld (%c99-m2r-match-rsp-load inst))
                 (st (%c99-m2r-match-rsp-store inst)))
            (cond
              ((or (not (pair? inst))
                   (lir-label-inst? inst)
                   (lir-inst-terminates-block? inst))
               (loop (cdr xs) '() (cons inst acc)))
              ((%c99-m2r-call-inst? inst)
               ;; Outside the outgoing call frame, stores strictly overwritten LATER in subsequent blocks aren't tracked here;
               ;; reset dead-ivs at calls conservatively.
               (loop (cdr xs) (if safe-across-calls? '() '()) (cons inst acc)))
              ((lir-inst-memory-barrier? inst)
               (loop (cdr xs) '() (cons inst acc)))
              ((and st (< (car st) 0) (<= (+ (car st) (cadr st)) 0))
               (let* ((off (car st))
                      (w (cadr st))
                      (hi (+ off w))
                      (subsumed? (lir-iv-subsumed? dead-ivs off hi)))
                 (if subsumed?
                     (loop (cdr xs) dead-ivs acc)
                     (loop (cdr xs) (lir-iv-insert dead-ivs off hi) (cons inst acc)))))
              ((and ld (< (cadr ld) 0))
               (let ((off (cadr ld))
                     (w (caddr ld)))
                 (loop (cdr xs) (lir-iv-remove dead-ivs off (+ off w)) (cons inst acc))))
              ((and has-escape? (%c99-m2r-tree-has? inst '%load))
               (loop (cdr xs) '() (cons inst acc)))
              (else
               (loop (cdr xs) dead-ivs (cons inst acc)))))))))

(define (c99-lir-mem2reg-function-body body)
  (if (or (null? body) (%c99-m2r-managed-or-unsafe-body? body))
      body
      (let* ((b1 (%c99-m2r-promote-leaf-slots body))
             (b2 (%c99-m2r-forward-blocks b1))
             (b3 (%c99-m2r-elim-dead-stores-intra-block b2)))
        (if (equal? b3 body) body b3))))

(define (%c99-m2r-transform-clause form)
  (if (not (pair? form))
      form
      (case (car form)
        ((%lir-function)
         (let ((new-clauses
                (map (lambda (sub)
                       (if (and (pair? sub) (eq? (car sub) 'body))
                           (let* ((old-b (cdr sub))
                                  (new-b (c99-lir-mem2reg-function-body old-b)))
                             (if (eq? new-b old-b) sub (cons 'body new-b)))
                           sub))
                     (cdr form))))
           (if (equal? new-clauses (cdr form))
               form
               (cons '%lir-function new-clauses))))
        ((%lir-main)
         (let ((new-clauses
                (map (lambda (sub)
                       (if (and (pair? sub) (eq? (car sub) 'body))
                           (let* ((old-b (cdr sub))
                                  (new-b (c99-lir-mem2reg-function-body old-b)))
                             (if (eq? new-b old-b) sub (cons 'body new-b)))
                           sub))
                     (cdr form))))
           (if (equal? new-clauses (cdr form))
               form
               (cons '%lir-main new-clauses))))
        ((%lir-functions)
         (let ((new-fns (map %c99-m2r-transform-clause (cdr form))))
           (if (equal? new-fns (cdr form))
               form
               (cons '%lir-functions new-fns))))
        (else form))))

(define (c99-lir-mem2reg-optimize ir)
  (cond
    ((null? ir) '())
    ((and (pair? ir) (eq? (car ir) '%lir-program))
     (let ((new-body (map %c99-m2r-transform-clause (cdr ir))))
       (if (equal? new-body (cdr ir))
           ir
           (cons '%lir-program new-body))))
    ((pair? ir)
     (if (memq (car ir) '(%lir-function %lir-main))
         (%c99-m2r-transform-clause ir)
         (c99-lir-mem2reg-function-body ir)))
    (else ir)))
;;; =======================================================================
;;; ULisp Compiler Pass 133: LIR Peephole Optimization & Dead Code Elimination
;;; Conforms to DSN-33 Architecture Specification & Issues #595, #767
;;; Implements sliding-window local simplifications, unreachable code pruning,
;;; and distance-independent DAG Store-Reload forwarding.
;;; =======================================================================

(define (lir-peephole-reg? opnd)
  (and (symbol? opnd)
       (case opnd
         ((%rax %rcx %rdx %rbx %rsp %rbp %rsi %rdi
           %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15)
          #t)
         (else
          (let ((s (symbol->string opnd)))
            (and (> (string-length s) 1)
                 (char=? (string-ref s 0) #\%)))))))

(define (lir-unconditional-terminator? inst)
  (and (pair? inst)
       (case (car inst)
         ((%jump %direct-jump %switch %return) #t)
         (else #f))))

(define (lir-label-inst? inst)
  (and (pair? inst)
       (let ((op (car inst)))
         (or (eq? op '%label) (eq? op '%block)))))

;;; -----------------------------------------------------------------------
;;; First-Class LIR Peephole Picopass Rules (DSN-33-01 T5.3)
;;; -----------------------------------------------------------------------

;; Rule 1: Redundant Self-Move Elimination
;; (%mov reg reg) -> ()
(define-picopass rule-lir-self-mov-elim
  (InstWindow
    (((%mov ,r1 ,r2) . ,rest)
     (guard (equal? r1 r2))
     rest)))

;; Rule 2: Round-Trip Register Move Elimination
;; (%mov r1 r2) (%mov r2 r1) -> (%mov r1 r2)
(define-picopass rule-lir-roundtrip-mov-elim
  (InstWindow
    (((%mov ,r1 ,r2) (%mov ,r3 ,r4) . ,rest)
     (guard (and (equal? r1 r4)
                 (equal? r2 r3)
                 (lir-peephole-reg? r1)
                 (lir-peephole-reg? r2)))
     (cons (list '%mov r1 r2) rest))))

;; Rule 2b: Dead Register Overwrite Elimination (Issue #927)
;; (%mov r1 _any) (%mov r1 src) -> (%mov r1 src) when src does not reference r1
;; (%load r1 %rsp off) (%mov r1 src) -> (%mov r1 src) when src does not reference r1
(define-picopass rule-lir-dead-reg-overwrite-elim
  (InstWindow
    (((%mov ,r1 ,_src0) (%mov ,r2 ,src1) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? src1 r1))))
     (cons (list '%mov r2 src1) rest))
    (((%load ,r1 %rsp ,_off) (%mov ,r2 ,src1) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? src1 r1))))
     (cons (list '%mov r2 src1) rest))
    (((%load-typed ,_ty ,r1 %rsp ,_off) (%mov ,r2 ,src1) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? src1 r1))))
     (cons (list '%mov r2 src1) rest))
    (((%mov ,r1 ,_src0) (%load ,r2 ,base ,off) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? base r1))
                 (not (lir-dse-tree-contains-sym? off r1))))
     (cons (list '%load r2 base off) rest))
    (((%mov ,r1 ,_src0) (%load-typed ,mty ,r2 ,base ,off) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? base r1))
                 (not (lir-dse-tree-contains-sym? off r1))))
     (cons (list '%load-typed mty r2 base off) rest))))

;; Rule 3: Redundant Jump to Next Immediate Label
;; (%jump L1) (%label L1) -> (%label L1)
(define-picopass rule-lir-jump-next-label-elim
  (InstWindow
    (((%jump ,l1) (%label ,l2) . ,rest)
     (guard (equal? l1 l2))
     (cons (list '%label l2) rest))
    (((%direct-jump ,l1) (%label ,l2) . ,rest)
     (guard (equal? l1 l2))
     (cons (list '%label l2) rest))))

;; Rule 4: Identity Arithmetic Simplification
;; (%add reg 0) / (%raw-add reg 0) / (%sub reg 0) / (%raw-sub reg 0) -> ()
(define-picopass rule-lir-identity-arith-elim
  (InstWindow
    (((%add ,r 0) . ,rest) rest)
    (((%raw-add ,r 0) . ,rest) rest)
    (((%sub ,r 0) . ,rest) rest)
    (((%raw-sub ,r 0) . ,rest) rest)))

;; Rule 5: Identity Multiplication Simplification
;; (%imul reg 1) / (%raw-mul reg 1) -> ()
(define-picopass rule-lir-identity-mul-elim
  (InstWindow
    (((%imul ,r 1) . ,rest) rest)
    (((%raw-mul ,r 1) . ,rest) rest)))

;; Rule 6: Unreachable Code Elimination (DCE)
;; (%jump L) / (%return) followed by non-label instructions up to next label
(define-picopass rule-lir-unreachable-dce
  (InstWindow
    (((%jump ,lbl) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons (list '%jump lbl) (lir-skip-to-next-label rest)))
    (((%direct-jump ,lbl) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons (list '%direct-jump lbl) (lir-skip-to-next-label rest)))
    (((%return) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons '(%return) (lir-skip-to-next-label rest)))
    (((%return ,opnd) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons (list '%return opnd) (lir-skip-to-next-label rest)))))

;; Rule 7: Distance-Independent DAG Store-Reload Forwarding (DSN-33-01 T5.3)
;; Unifies Rule 2b (adjacent store-reload), Rule 2b-2/2b-3 (1-store gap),
;; and multi-instruction gaps across intervening straight-line instructions.
(define-picopass rule-lir-store-load-forward
  (InstWindow
    ;; Distance 0: Adjacent Store-Reload (Rule 2b)
    (((%store %rsp ,off ,src) (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) rest)
         (cons (list '%store '%rsp off src)
               (cons (list '%mov dst src) rest))))

    ;; Distance 1: 1 Intervening Instruction (Rule 2b-2, Rule 2b-3, or safe intervening inst)
    (((%store %rsp ,off ,src) ,i1 (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) (cons i1 rest))
         (cons (list '%store '%rsp off src) (cons i1 (cons (list '%mov dst src) rest)))))

    ;; Distance 2: 2 Intervening Instructions (test 11, test 15)
    (((%store %rsp ,off ,src) ,i1 ,i2 (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 rest)))
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 (cons (list '%mov dst src) rest))))))

    ;; Distance 3: 3 Intervening Instructions (test 12)
    (((%store %rsp ,off ,src) ,i1 ,i2 ,i3 (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-terminates-block? i3))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-memory-barrier? i3))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-defines-reg? i3 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))
                 (not (lir-inst-may-alias-stack-slot? i3 off))))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 (cons i3 rest))))
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 (cons i3 (cons (list '%mov dst src) rest)))))))))

;; Rule 8: Redundant Box-Unbox Pair Elimination (Issue #826)
;; (%box-fixnum r1 r2) (%unbox-fixnum r3 r1) -> (%mov r3 r2)
;; (%unbox-fixnum r1 r2) (%box-fixnum r3 r1) -> (%mov r3 r2)
;; (%box-flonum r1 r2) (%unbox-flonum r3 r1) -> (%fmov r3 r2)
;; (%unbox-flonum r1 r2) (%box-flonum r3 r1) -> (%fmov r3 r2)
(define-picopass rule-lir-box-unbox-elim
  (InstWindow
    (((%box-fixnum ,d1 ,s1) (%unbox-fixnum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%mov d2 s1) rest)))
    (((%unbox-fixnum ,d1 ,s1) (%box-fixnum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%mov d2 s1) rest)))
    (((%box-flonum ,d1 ,s1) (%unbox-flonum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%fmov d2 s1) rest)))
    (((%unbox-flonum ,d1 ,s1) (%box-flonum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%fmov d2 s1) rest)))))

;; Rule 9: Redundant Source Location Elimination
;; (%loc fid line col1) (%loc fid line col2) -> (%loc fid line col2)
(define-picopass rule-lir-redundant-loc-elim
  (InstWindow
    (((%loc ,f1 ,l1 ,c1) (%loc ,f2 ,l2 ,c2) . ,rest)
     (guard (and (equal? f1 f2) (equal? l1 l2)))
     (cons (list '%loc f2 l2 c2) rest))))

;; Rule 10: Redundant Self Floating-Point Move Elimination (Issue #934)
;; (%fmov reg reg) -> ()
(define-picopass rule-lir-self-fmov-elim
  (InstWindow
    (((%fmov ,r1 ,r2) . ,rest)
     (guard (equal? r1 r2))
     rest)))

;; Rule 11: Distance-Independent f64 Store-Reload Forwarding (Issue #934)
;; Strictly restricted to f64 because 160_backend_c rounds f32 on %store-typed/%load-typed
;; whereas %fmov performs raw 64-bit IEEE-754 register transfer.
(define-picopass rule-lir-f64-store-load-forward
  (InstWindow
    ;; Distance 0: Adjacent f64 Store-Reload
    (((%store-typed f64 %rsp ,off ,src) (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) rest)
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons (list '%fmov dst src) rest))))

    ;; Distance 1
    (((%store-typed f64 %rsp ,off ,src) ,i1 (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) (cons i1 rest))
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons i1 (cons (list '%fmov dst src) rest)))))

    ;; Distance 2
    (((%store-typed f64 %rsp ,off ,src) ,i1 ,i2 (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) (cons i1 (cons i2 rest)))
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons i1 (cons i2 (cons (list '%fmov dst src) rest))))))

    ;; Distance 3
    (((%store-typed f64 %rsp ,off ,src) ,i1 ,i2 ,i3 (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-terminates-block? i3))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-memory-barrier? i3))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-defines-reg? i3 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))
                 (not (lir-inst-may-alias-stack-slot? i3 off))))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) (cons i1 (cons i2 (cons i3 rest))))
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons i1 (cons i2 (cons i3 (cons (list '%fmov dst src) rest)))))))))

;;; -----------------------------------------------------------------------
;;; Linear O(N) Backward-Liveness Stack Dead-Store Elimination (Issue #934)
;;; -----------------------------------------------------------------------

(define (lir-iv-insert ivs lo hi)
  (if (>= lo hi)
      ivs
      (let loop ((xs ivs) (cur-lo lo) (cur-hi hi) (acc '()))
        (cond
          ((null? xs)
           (reverse (cons (cons cur-lo cur-hi) acc)))
          ((< (cdar xs) cur-lo)
           (loop (cdr xs) cur-lo cur-hi (cons (car xs) acc)))
          ((> (caar xs) cur-hi)
           (let append-rest ((ys xs) (out (cons (cons cur-lo cur-hi) acc)))
             (if (null? ys)
                 (reverse out)
                 (append-rest (cdr ys) (cons (car ys) out)))))
          (else
           (loop (cdr xs)
                 (min cur-lo (caar xs))
                 (max cur-hi (cdar xs))
                 acc))))))

(define (lir-iv-remove ivs lo hi)
  (if (>= lo hi)
      ivs
      (let loop ((xs ivs) (acc '()))
        (if (null? xs)
            (reverse acc)
            (let ((xlo (caar xs))
                  (xhi (cdar xs)))
              (cond
                ((or (<= xhi lo) (>= xlo hi))
                 (loop (cdr xs) (cons (car xs) acc)))
                (else
                 (let* ((acc1 (if (< xlo lo) (cons (cons xlo lo) acc) acc))
                        (acc2 (if (< hi xhi) (cons (cons hi xhi) acc1) acc1)))
                   (loop (cdr xs) acc2)))))))))

(define (lir-iv-subsumed? ivs lo hi)
  (let loop ((xs ivs))
    (cond
      ((null? xs) #f)
      ((> (caar xs) lo) #f)
      ((<= (caar xs) lo)
       (if (>= (cdar xs) hi)
           #t
           (loop (cdr xs))))
      (else (loop (cdr xs))))))

(define (lir-iv-overlaps? ivs lo hi)
  (let loop ((xs ivs))
    (cond
      ((null? xs) #f)
      ((>= (caar xs) hi) #f)
      ((> (cdar xs) lo) #t)
      (else (loop (cdr xs))))))

(define (lir-dse-type-width ty)
  (case ty
    ((i8 u8 bool) 1)
    ((i16 u16) 2)
    ((i32 u32 f32) 4)
    (else 8)))

(define (lir-dse-tree-contains-sym? x sym)
  (cond
    ((eq? x sym) #t)
    ((pair? x) (or (lir-dse-tree-contains-sym? (car x) sym)
                   (lir-dse-tree-contains-sym? (cdr x) sym)))
    (else #f)))

(define (lir-dse-inst-escapes-rsp? inst)
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((case op
             ((%inline-asm %alloc-stack %managed-alloc-stack %capture-cc) #t)
             (else #f))
           #t)
          ((or (eq? op '%store) (eq? op '%store-byte))
           (and (>= (length inst) 4) (eq? (list-ref inst 3) '%rsp)))
          ((eq? op '%store-typed)
           (and (>= (length inst) 5) (eq? (list-ref inst 4) '%rsp)))
          ((or (eq? op '%load) (eq? op '%load-byte-zx))
           (and (>= (length inst) 4) (eq? (list-ref inst 3) '%rsp)))
          ((eq? op '%load-typed)
           (and (>= (length inst) 5) (eq? (list-ref inst 4) '%rsp)))
          ((case op
             ((%add %sub %raw-add %raw-sub) #t)
             (else #f))
           (and (>= (length inst) 3)
                (or (eq? (caddr inst) '%rsp)
                    (and (not (eq? (cadr inst) '%rsp))
                         (lir-dse-tree-contains-sym? (cdr inst) '%rsp)))))
          (else
           (lir-dse-tree-contains-sym? (cdr inst) '%rsp))))))

(define (lir-dse-inst-modifies-rsp? inst)
  (and (pair? inst) (lir-inst-defines-reg? inst '%rsp)))

(define (lir-dse-inst-indirect-read? inst)
  (and (pair? inst)
       (let ((op (car inst)))
         (or (and (or (eq? op '%load) (eq? op '%load-byte-zx))
                  (>= (length inst) 4)
                  (not (eq? (caddr inst) '%rsp)))
             (and (eq? op '%load-typed)
                  (>= (length inst) 5)
                  (not (eq? (cadddr inst) '%rsp)))
             (case op
               ((%unbox-flonum %unbox-fixnum %atomic-cas!
                 %managed-unbox %managed-write-barrier
                 %box-flonum %managed-box)
                #t)
               (else #f))))))

(define (lir-dse-neg-store-range inst)
  ;; Returns (lo . hi) if inst stores strictly into negative %rsp offset (< 0) with known integer width, else #f
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%store)
                (>= (length inst) 4)
                (eq? (cadr inst) '%rsp)
                (integer? (caddr inst)))
           (let ((off (caddr inst)))
             (if (and (< off 0) (<= (+ off 8) 0) (not (eq? (cadddr inst) '%rsp)))
                 (cons off (+ off 8))
                 #f)))
          ((and (eq? op '%store-byte)
                (>= (length inst) 4)
                (eq? (cadr inst) '%rsp)
                (integer? (caddr inst)))
           (let ((off (caddr inst)))
             (if (and (< off 0) (<= (+ off 1) 0) (not (eq? (cadddr inst) '%rsp)))
                 (cons off (+ off 1))
                 #f)))
          ((and (eq? op '%store-typed)
                (>= (length inst) 5)
                (eq? (caddr inst) '%rsp)
                (integer? (cadddr inst)))
           (let* ((off (cadddr inst))
                  (w (lir-dse-type-width (cadr inst))))
             (if (and (< off 0) (<= (+ off w) 0) (not (eq? (list-ref inst 4) '%rsp)))
                 (cons off (+ off w))
                 #f)))
          (else #f)))))

(define (lir-dse-rsp-load-range inst)
  ;; Returns (lo . hi) for direct %rsp load, 'unknown if non-const %rsp load, or #f if not a %rsp load
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%load) (>= (length inst) 4) (eq? (caddr inst) '%rsp))
           (let ((off (cadddr inst)))
             (if (integer? off) (cons off (+ off 8)) 'unknown)))
          ((and (eq? op '%load-byte-zx) (>= (length inst) 4) (eq? (caddr inst) '%rsp))
           (let ((off (cadddr inst)))
             (if (integer? off) (cons off (+ off 1)) 'unknown)))
          ((and (eq? op '%load-typed) (>= (length inst) 5) (eq? (cadddr inst) '%rsp))
           (let ((off (list-ref inst 4))
                 (w (lir-dse-type-width (cadr inst))))
             (if (integer? off) (cons off (+ off w)) 'unknown)))
          (else #f)))))

(define (lir-dse-live-dead? live lo hi)
  (if (eq? (car live) 'exact)
      (not (lir-iv-overlaps? (cdr live) lo hi))
      (lir-iv-subsumed? (cdr live) lo hi)))

(define (lir-dse-live-mark-read live lo hi)
  (if (eq? (car live) 'exact)
      (cons 'exact (lir-iv-insert (cdr live) lo hi))
      (cons 'all-except (lir-iv-remove (cdr live) lo hi))))

(define (lir-dse-live-mark-written live lo hi)
  (if (eq? (car live) 'exact)
      (cons 'exact (lir-iv-remove (cdr live) lo hi))
      (cons 'all-except (lir-iv-insert (cdr live) lo hi))))

(define (lir-dse-fold-stack-opnds tree live)
  ;; Records any (%stack off) operands anywhere in tree into liveness state.
  (cond
    ((not (pair? tree)) live)
    ((eq? (car tree) '%stack)
     (let ((off (and (pair? (cdr tree)) (cadr tree))))
       (if (integer? off)
           (lir-dse-live-mark-read live off (+ off 8))
           '(all-except))))
    (else
     (lir-dse-fold-stack-opnds (cdr tree)
                               (lir-dse-fold-stack-opnds (car tree) live)))))

(define (lir-dse-collect-leaf-reads insts)
  ;; Scans all direct %rsp reads & (%stack off) reads in a function -> (unknown? . ivs)
  (let loop ((xs insts) (unk #f) (ivs '()))
    (if (or unk (null? xs))
        (cons unk ivs)
        (let* ((inst (car xs))
               (ld (lir-dse-rsp-load-range inst))
               (live0 (cons 'exact ivs))
               (live1 (lir-dse-fold-stack-opnds inst live0)))
          (cond
            ((eq? ld 'unknown)
             (loop (cdr xs) #t '()))
            ((eq? (car live1) 'all-except)
             (loop (cdr xs) #t '()))
            (ld
             (loop (cdr xs) #f (lir-iv-insert (cdr live1) (car ld) (cdr ld))))
            (else
             (loop (cdr xs) #f (cdr live1))))))))

(define (lir-eliminate-dead-stack-stores insts)
  (if (or (null? insts)
          (not (let has-neg? ((xs insts))
                 (and (pair? xs)
                      (or (and (not (lir-dse-tree-contains-sym? (car xs) '%stack))
                               (lir-dse-neg-store-range (car xs)))
                          (has-neg? (cdr xs)))))))
      insts
      (let* ((has-escape?
              (let loop ((xs insts))
                (and (pair? xs)
                     (or (lir-dse-inst-escapes-rsp? (car xs))
                         (loop (cdr xs))))))
             (has-barrier?
              (let loop ((xs insts))
                (and (pair? xs)
                     (or (lir-inst-memory-barrier? (car xs))
                         (lir-dse-inst-modifies-rsp? (car xs))
                         (loop (cdr xs))))))
             (leaf-info (if (and (not has-escape?) (not has-barrier?))
                            (lir-dse-collect-leaf-reads insts)
                            (cons #t '())))
             (leaf-exact-reads? (not (car leaf-info)))
             (leaf-read-ivs (cdr leaf-info)))
        (let loop ((xs (reverse insts))
                   (live '(all-except))
                   (acc '())
                   (changed? #f))
          (if (null? xs)
              (if changed? acc insts)
              (let* ((inst (car xs))
                     (st (and (not (lir-dse-tree-contains-sym? inst '%stack))
                              (lir-dse-neg-store-range inst))))
                (if st
                    (let* ((lo (car st))
                           (hi (cdr st))
                           (dead? (or (and leaf-exact-reads?
                                           (not (lir-iv-overlaps? leaf-read-ivs lo hi)))
                                      (lir-dse-live-dead? live lo hi))))
                      (if dead?
                          (loop (cdr xs) live acc #t)
                          (loop (cdr xs) (lir-dse-live-mark-written live lo hi) (cons inst acc) changed?)))
                    (let ((next-live
                           (cond
                             ((and (pair? inst) (eq? (car inst) '%return))
                              (lir-dse-fold-stack-opnds (cdr inst) '(exact)))
                             ((or (not (pair? inst))
                                  (lir-inst-memory-barrier? inst)
                                  (and (lir-inst-terminates-block? inst)
                                       (not (lir-label-inst? inst)))
                                  (lir-dse-inst-modifies-rsp? inst))
                              '(all-except))
                             ((lir-dse-rsp-load-range inst)
                              => (lambda (ld)
                                   (if (eq? ld 'unknown)
                                       '(all-except)
                                       (lir-dse-fold-stack-opnds
                                        inst
                                        (lir-dse-live-mark-read live (car ld) (cdr ld))))))
                             ((and has-escape? (lir-dse-inst-indirect-read? inst))
                              '(all-except))
                             (else
                              (lir-dse-fold-stack-opnds inst live)))))
                      (loop (cdr xs) next-live (cons inst acc) changed?)))))))))

(define (%lir-map-keep-eq proc xs)
  (let loop ((rem xs) (acc '()) (changed? #f))
    (if (null? rem)
        (if changed? (reverse acc) xs)
        (let* ((orig (car rem))
               (mapped (proc orig)))
          (if (eq? mapped orig)
              (loop (cdr rem) (cons orig acc) changed?)
              (loop (cdr rem) (cons mapped acc) #t))))))

(define (%lir-transform-fn-body form body-fn)
  (if (not (pair? form))
      form
      (case (car form)
        ((%lir-function %lir-main)
         (let ((new-rest
                (%lir-map-keep-eq
                 (lambda (sub)
                   (if (and (pair? sub) (eq? (car sub) 'body))
                       (let* ((ob (cdr sub))
                              (nb (body-fn ob)))
                         (if (eq? nb ob) sub (cons 'body nb)))
                       sub))
                 (cdr form))))
           (if (eq? new-rest (cdr form))
               form
               (cons (car form) new-rest))))
        ((%lir-functions)
         (let ((new-fns (%lir-map-keep-eq (lambda (f) (%lir-transform-fn-body f body-fn)) (cdr form))))
           (if (eq? new-fns (cdr form))
               form
               (cons '%lir-functions new-fns))))
        (else form))))

(define (%lir-transform-ir-bodies ir body-fn transform-raw-list?)
  (cond
    ((null? ir) '())
    ((and (pair? ir) (eq? (car ir) '%lir-program))
     (let ((new-clauses (%lir-map-keep-eq (lambda (c) (%lir-transform-fn-body c body-fn)) (cdr ir))))
       (if (eq? new-clauses (cdr ir))
           ir
           (cons '%lir-program new-clauses))))
    ((pair? ir)
     (if (or (eq? (car ir) '%lir-function) (eq? (car ir) '%lir-main))
         (%lir-transform-fn-body ir body-fn)
         (if transform-raw-list? (body-fn ir) ir)))
    (else ir)))

(define (lir-dse-transform-clause form)
  (%lir-transform-fn-body form lir-eliminate-dead-stack-stores))

(define (lir-eliminate-dead-stack-stores-in-ir ir)
  (%lir-transform-ir-bodies ir lir-eliminate-dead-stack-stores #t))

;;; -----------------------------------------------------------------------
;;; Linear O(N) Algebraic Zero/Sign-Extension Folding (Issue #935)
;;; -----------------------------------------------------------------------

(define (lir-ext-inst->kind inst)
  (and (pair? inst)
       (= (length inst) 4)
       (lir-peephole-reg? (caddr inst))
       (lir-peephole-reg? (cadddr inst))
       (let ((op (car inst))
             (mty (cadr inst)))
         (case op
           ((%trunc %zext)
            (case mty
              ((i8 u8) 'u8)
              ((i16 u16) 'u16)
              ((i32 u32) 'u32)
              (else #f)))
           ((%sext)
            (case mty
              ((i8) 'i8)
              ((i16) 'i16)
              ((i32) 'i32)
              (else #f)))
           (else #f)))))

(define (lir-ext-kind-width kind)
  (case kind
    ((u8 i8) 8)
    ((u16 i16) 16)
    ((u32 i32 u31) 32)
    (else #f)))

(define (lir-ext-normalize-const kind v)
  (case kind
    ((u8)  (modulo v 256))
    ((u16) (modulo v 65536))
    ((u32) (modulo v 4294967296))
    ((i8)  (let ((m (modulo v 256))) (if (>= m 128) (- m 256) m)))
    ((i16) (let ((m (modulo v 65536))) (if (>= m 32768) (- m 65536) m)))
    ((i32) (let ((m (modulo v 4294967296))) (if (>= m 2147483648) (- m 4294967296) m)))
    (else v)))

(define (lir-ext-fact-subsumes? fact target-kind)
  (cond
    ((not fact) #f)
    ((and (pair? fact) (eq? (car fact) 'const))
     (= (cdr fact) (lir-ext-normalize-const target-kind (cdr fact))))
    (else
     (case fact
       ((u8)  (case target-kind ((u8 u16 i16 u32 i32) #t) (else #f)))
       ((i8)  (case target-kind ((i8 i16 i32) #t) (else #f)))
       ((u16) (case target-kind ((u16 u32 i32) #t) (else #f)))
       ((i16) (or (eq? target-kind 'i16) (eq? target-kind 'i32)))
       ((u31) (or (eq? target-kind 'u32) (eq? target-kind 'i32)))
       ((u32) (eq? target-kind 'u32))
       ((i32) (eq? target-kind 'i32))
       (else #f)))))

(define (lir-ext-reg-overlaps? r1 r2)
  (or (equal? r1 r2)
      (lir-reg-aliases? r1 r2)
      (and (or (eq? r1 '%rax) (eq? r1 '%al)) (or (eq? r2 '%rax) (eq? r2 '%al)))
      (and (or (eq? r1 '%rcx) (eq? r1 '%cl)) (or (eq? r2 '%rcx) (eq? r2 '%cl)))))

(define (lir-ext-env-lookup env reg)
  (let ((hit (assoc reg env)))
    (and hit (cdr hit))))

(define (lir-ext-env-kill env reg)
  (let loop ((xs env) (acc '()))
    (if (null? xs)
        (reverse acc)
        (loop (cdr xs)
              (if (lir-ext-reg-overlaps? (caar xs) reg)
                  acc
                  (cons (car xs) acc))))))

(define (lir-ext-env-set env reg fact)
  (let ((cleaned (lir-ext-env-kill env reg)))
    (if fact
        (cons (cons reg fact) cleaned)
        cleaned)))

(define (lir-ext-env-kill-by-inst env inst)
  (let loop ((xs env) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let* ((r (caar xs))
               (killed?
                (or (lir-inst-defines-reg? inst r)
                    (and (eq? r '%rax) (lir-inst-defines-reg? inst '%al))
                    (and (eq? r '%al) (lir-inst-defines-reg? inst '%rax))
                    (and (eq? r '%rcx) (lir-inst-defines-reg? inst '%cl))
                    (and (eq? r '%cl) (lir-inst-defines-reg? inst '%rcx))
                    (and (pair? inst)
                         (or (eq? (car inst) '%push) (eq? (car inst) '%pop))
                         (eq? r '%rsp)))))
          (loop (cdr xs) (if killed? acc (cons (car xs) acc)))))))

(define (lir-ext-safe-intra-block-op? op)
  (case op
    ((%loc %mov %load %load-byte-zx %load-typed %store %store-byte %store-typed
      %add %raw-add %sub %raw-sub %imul %raw-mul %neg %inc
      %bit-and %bit-or %bit-xor %shl %shr %sar
      %cmp %raw-cmp %setb %setbe %seta %setae %set-boolean
      %cqo %idiv %udiv %urem %trunc %zext %sext
      %fmov %fadd %fsub %fmul %fdiv %fneg %fpext %fptrunc
      %fcmp %fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge
      %sitofp %uitofp %fptosi %fptoui %bitcast-f64-to-i64 %bitcast-i64-to-f64
      %global-addr %global-ref %global-set! %code-ref %str-ref %not %push %pop
      %add-overflow %sub-overflow %mul-overflow
      %box-fixnum %unbox-fixnum %box-flonum %unbox-flonum)
     #t)
    (else #f)))

(define (lir-ext-try-fold-imm-prev acc reg target-kind)
  (let loop ((xs acc) (locs '()))
    (cond
      ((null? xs) #f)
      ((and (pair? (car xs)) (eq? (caar xs) '%loc))
       (loop (cdr xs) (cons (car xs) locs)))
      ((and (pair? (car xs))
            (eq? (caar xs) '%mov)
            (= (length (car xs)) 3)
            (equal? (cadar xs) reg)
            (integer? (caddr (car xs))))
       (let ((nv (lir-ext-normalize-const target-kind (caddr (car xs)))))
         (if (and (not (= nv 0)) (>= nv -2147483648) (<= nv 2147483647))
             (cons nv (append (reverse locs) (cons (list '%mov reg nv) (cdr xs))))
             #f)))
      (else #f))))

(define (lir-ext-try-overwrite-prev acc reg target-w)
  (let loop ((xs acc) (locs '()))
    (cond
      ((null? xs) #f)
      ((and (pair? (car xs)) (eq? (caar xs) '%loc))
       (loop (cdr xs) (cons (car xs) locs)))
      (else
       (let ((pk (lir-ext-inst->kind (car xs))))
         (if (and pk
                  (equal? (caddr (car xs)) reg)
                  (equal? (cadddr (car xs)) reg)
                  (>= (lir-ext-kind-width pk) target-w))
             (append (reverse locs) (cdr xs))
             #f))))))

(define (lir-ext-shr-nonneg v cnt)
  (let loop ((x v) (k (modulo cnt 64)))
    (if (or (<= k 0) (= x 0))
        x
        (loop (quotient x 2) (- k 1)))))

(define (lir-ext-uint-range-fact n)
  (cond
    ((< n 0) #f)
    ((<= n 255) 'u8)
    ((<= n 65535) 'u16)
    ((<= n 2147483647) 'u31)
    ((<= n 4294967295) 'u32)
    (else #f)))

(define (lir-ext-post-inst-env env inst)
  (let ((op (car inst))
        (env1 (lir-ext-env-kill-by-inst env inst)))
    (case op
      ((%mov)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (cond
           ((and (lir-peephole-reg? dst) (integer? src))
            (lir-ext-env-set env1 dst (cons 'const src)))
           ((and (lir-peephole-reg? dst) (lir-peephole-reg? src))
            (lir-ext-env-set env1 dst (lir-ext-env-lookup env src)))
           (else env1))))
      ((%load-typed)
       (let ((mty (cadr inst)) (dst (caddr inst)))
         (if (and (lir-peephole-reg? dst)
                  (case mty ((i8 u8 i16 u16 i32 u32) #t) (else #f)))
             (lir-ext-env-set env1 dst mty)
             env1)))
      ((%load-byte-zx %setb %setbe %seta %setae %fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge)
       (let ((dst (cadr inst)))
         (if (lir-peephole-reg? dst)
             (lir-ext-env-set env1 dst 'u8)
             env1)))
      ((%bit-and)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (if (and (lir-peephole-reg? dst) (integer? src) (>= src 0) (<= src 2147483647))
             (lir-ext-env-set env1 dst (lir-ext-uint-range-fact src))
             env1)))
      ((%shr)
       (if (= (length inst) 4)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (cnt (cadddr inst))
                  (sf (and (lir-peephole-reg? src) (lir-ext-env-lookup env src))))
             (if (lir-peephole-reg? dst)
                 (cond
                   ((case sf ((u8 u16 u31 u32) #t) (else #f))
                    (lir-ext-env-set env1 dst sf))
                   ((and (pair? sf) (eq? (car sf) 'const) (>= (cdr sf) 0))
                    (if (integer? cnt)
                        (lir-ext-env-set env1 dst (cons 'const (lir-ext-shr-nonneg (cdr sf) cnt)))
                        (lir-ext-env-set env1 dst (lir-ext-uint-range-fact (cdr sf)))))
                   (else env1))
                 env1))
           (let* ((dst (cadr inst))
                  (cnt (caddr inst))
                  (df (and (lir-peephole-reg? dst) (lir-ext-env-lookup env dst))))
             (if (lir-peephole-reg? dst)
                 (cond
                   ((case df ((u8 u16 u31 u32) #t) (else #f))
                    (lir-ext-env-set env1 dst df))
                   ((and (pair? df) (eq? (car df) 'const) (>= (cdr df) 0))
                    (if (integer? cnt)
                        (lir-ext-env-set env1 dst (cons 'const (lir-ext-shr-nonneg (cdr df) cnt)))
                        (lir-ext-env-set env1 dst (lir-ext-uint-range-fact (cdr df)))))
                   (else env1))
                 env1))))
      ((%sar)
       (let* ((dst (cadr inst))
              (df (and (lir-peephole-reg? dst) (lir-ext-env-lookup env dst))))
         (if (and (lir-peephole-reg? dst)
                  (case df ((i8 i16 i32 u8 u16 u31 u32) #t) (else #f)))
             (lir-ext-env-set env1 dst df)
             env1)))
      (else env1))))

(define (%lir-copy-prefix insts stop-cell)
  (let loop ((p insts) (acc '()))
    (if (eq? p stop-cell)
        acc
        (loop (cdr p) (cons (car p) acc)))))

(define (lir-fold-redundant-extensions insts)
  (if (or (null? insts)
          (not (let has-ext? ((xs insts))
                 (and (pair? xs)
                      (or (lir-ext-inst->kind (car xs))
                          (has-ext? (cdr xs)))))))
      insts
      (let loop ((xs insts) (env '()) (acc '()) (changed? #f))
        (if (null? xs)
            (if changed? (reverse acc) insts)
            (let* ((inst (car xs))
                   (rest (cdr xs))
                   (tk (lir-ext-inst->kind inst)))
              (cond
                (tk
                 (let* ((dst (caddr inst))
                        (src (cadddr inst))
                        (sf (lir-ext-env-lookup env src)))
                   (cond
                     ((and sf (lir-ext-fact-subsumes? sf tk))
                      (let ((cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                        (if (equal? dst src)
                            (loop rest env cur-acc #t)
                            (loop rest
                                  (lir-ext-env-set env dst sf)
                                  (cons (list '%mov dst src) cur-acc)
                                  #t))))
                     ((equal? dst src)
                      (let* ((cur-acc (if changed? acc (%lir-copy-prefix insts xs)))
                             (imm-fold (lir-ext-try-fold-imm-prev cur-acc dst tk)))
                        (if imm-fold
                            (loop rest
                                  (lir-ext-env-set env dst (cons 'const (car imm-fold)))
                                  (cdr imm-fold)
                                  #t)
                            (let ((trimmed (lir-ext-try-overwrite-prev cur-acc dst (lir-ext-kind-width tk))))
                              (if trimmed
                                  (loop rest
                                        (lir-ext-env-set env dst tk)
                                        (cons inst trimmed)
                                        #t)
                                  (loop rest
                                        (lir-ext-env-set env dst tk)
                                        (if changed? (cons inst acc) acc)
                                        changed?))))))
                     (else
                      (loop rest
                            (lir-ext-env-set env dst tk)
                            (if changed? (cons inst acc) acc)
                            changed?)))))
                ((and (pair? inst) (lir-ext-safe-intra-block-op? (car inst)))
                 (loop rest
                       (lir-ext-post-inst-env env inst)
                       (if changed? (cons inst acc) acc)
                       changed?))
                (else
                 (loop rest '() (if changed? (cons inst acc) acc) changed?))))))))

(define (lir-ext-transform-clause form)
  (%lir-transform-fn-body form lir-fold-redundant-extensions))

(define (lir-fold-redundant-extensions-in-ir ir)
  (%lir-transform-ir-bodies ir lir-fold-redundant-extensions #t))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: lir-peephole-window-pass (fuse-window-rules) + DSE
;;; -----------------------------------------------------------------------

;; Constants & Arithmetic Intra-Block Folding (Issue #927)
;; Strictly restricted to pure-fixnum imm32 range [-2147483648, 2147483647]
;; so self-hosted 62-bit ULisp bootstrap never allocates or emits bignums.
(define (lir-peephole-imm32? n)
  (and (integer? n) (>= n -2147483648) (<= n 2147483647)))

(define (lir-peephole-eval-unary-const op v)
  (if (not (lir-peephole-imm32? v))
      #f
      (let ((res (cond
                   ((eq? op '%neg) (- 0 v))
                   ((eq? op '%inc) (+ v 1))
                   (else #f))))
        (if (and res (lir-peephole-imm32? res)) res #f))))

(define (lir-peephole-eval-bin-const op v1 v2)
  (cond
    ((or (eq? op '%add) (eq? op '%raw-add))
     (if (and (lir-peephole-imm32? v1) (lir-peephole-imm32? v2))
         (let ((res (+ v1 v2)))
           (if (lir-peephole-imm32? res) res #f))
         #f))
    ((or (eq? op '%sub) (eq? op '%raw-sub))
     (if (and (lir-peephole-imm32? v1) (lir-peephole-imm32? v2))
         (let ((res (- v1 v2)))
           (if (lir-peephole-imm32? res) res #f))
         #f))
    ((or (eq? op '%imul) (eq? op '%raw-mul))
     (if (and (integer? v1) (integer? v2)
              (>= v1 -1000000) (<= v1 1000000)
              (>= v2 -1000000) (<= v2 1000000))
         (let ((res (* v1 v2)))
           (if (lir-peephole-imm32? res) res #f))
         #f))
    ((eq? op '%bit-and)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (<= v2 2147483647))
         (bitwise-and v1 v2)
         #f))
    ((eq? op '%bit-or)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (<= v2 2147483647))
         (bitwise-ior v1 v2)
         #f))
    ((eq? op '%bit-xor)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (<= v2 2147483647))
         (- (bitwise-ior v1 v2) (bitwise-and v1 v2))
         #f))
    ((eq? op '%shl)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (< v2 31))
         (let loop ((x v1) (i 0))
           (cond
             ((>= i v2) x)
             ((> x 1073741823) #f)
             (else (loop (* x 2) (+ i 1)))))
         #f))
    ((eq? op '%shr)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (< v2 32))
         (let loop ((x v1) (i 0))
           (if (>= i v2) x (loop (quotient x 2) (+ i 1))))
         #f))
    ((eq? op '%sar)
     (if (and (lir-peephole-imm32? v1)
              (integer? v2) (>= v2 0) (< v2 32))
         (let loop ((x v1) (i 0))
           (if (>= i v2)
               x
               (loop (if (< x 0)
                         (quotient (- x 1) 2)
                         (quotient x 2))
                     (+ i 1))))
         #f))
    (else #f)))

(define (lir-peephole-fold-int-const-ops insts)
  (if (null? insts)
      insts
      (let loop ((xs insts) (cenv '()) (acc '()) (changed? #f))
        (if (null? xs)
            (if changed? (reverse acc) insts)
            (let ((inst (car xs))
                  (rest (cdr xs)))
              (if (not (pair? inst))
                  (loop rest '() (if changed? (cons inst acc) acc) changed?)
                  (let ((op (car inst)))
                    (cond
                      ((and (eq? op '%mov)
                            (pair? (cdr inst)) (pair? (cddr inst)) (null? (cdddr inst))
                            (lir-peephole-reg? (cadr inst)))
                       (let* ((dst (cadr inst))
                              (src (caddr inst))
                              (c1 (if (null? cenv) '() (lir-ext-env-kill cenv dst))))
                         (cond
                           ((lir-peephole-imm32? src)
                            (loop rest (cons (cons dst src) c1)
                                  (if changed? (cons inst acc) acc) changed?))
                           ((and (pair? c1) (lir-peephole-reg? src) (assq src cenv))
                            => (lambda (h)
                                 (let ((kv (cdr h))
                                       (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                   (loop rest (cons (cons dst kv) c1)
                                         (cons (list '%mov dst kv) cur-acc) #t))))
                           ((and (null? c1) (lir-peephole-reg? src) (assq src cenv))
                            => (lambda (h)
                                 (let ((kv (cdr h))
                                       (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                   (loop rest (cons (cons dst kv) c1)
                                         (cons (list '%mov dst kv) cur-acc) #t))))
                           (else
                            (loop rest c1 (if changed? (cons inst acc) acc) changed?)))))
                      ((and (or (eq? op '%neg) (eq? op '%inc))
                            (pair? (cdr inst)) (null? (cddr inst))
                            (lir-peephole-reg? (cadr inst))
                            (pair? cenv)
                            (assq (cadr inst) cenv))
                       => (lambda (h)
                            (let ((nv (lir-peephole-eval-unary-const op (cdr h))))
                              (if nv
                                  (let ((c1 (cons (cons (cadr inst) nv) (lir-ext-env-kill cenv (cadr inst))))
                                        (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                    (loop rest c1 (cons (list '%mov (cadr inst) nv) cur-acc) #t))
                                  (loop rest (lir-ext-env-kill cenv (cadr inst))
                                        (if changed? (cons inst acc) acc) changed?)))))
                      ((and (case op
                              ((%add %raw-add %sub %raw-sub %imul %raw-mul
                                %bit-and %bit-or %bit-xor %shl %shr %sar)
                               #t)
                              (else #f))
                            (pair? (cdr inst)) (pair? (cddr inst)) (null? (cdddr inst))
                            (lir-peephole-reg? (cadr inst))
                            (pair? cenv)
                            (assq (cadr inst) cenv))
                       => (lambda (h)
                            (let* ((r (cadr inst))
                                   (rhs (caddr inst))
                                   (kv (cond ((integer? rhs) rhs)
                                             ((and (lir-peephole-reg? rhs) (assq rhs cenv))
                                              (cdr (assq rhs cenv)))
                                             (else #f)))
                                   (nv (if kv (lir-peephole-eval-bin-const op (cdr h) kv) #f)))
                              (if nv
                                  (let ((c1 (cons (cons r nv) (lir-ext-env-kill cenv r)))
                                        (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                    (loop rest c1 (cons (list '%mov r nv) cur-acc) #t))
                                  (loop rest (lir-ext-env-kill cenv r)
                                        (if changed? (cons inst acc) acc) changed?)))))
                      ((and (lir-ext-safe-intra-block-op? op)
                            (not (lir-label-inst? inst))
                            (not (lir-inst-terminates-block? inst)))
                       (loop rest
                             (if (null? cenv)
                                 '()
                                 (let kill ((es cenv) (ka '()))
                                   (if (null? es)
                                       (reverse ka)
                                       (kill (cdr es)
                                             (if (lir-inst-defines-reg? inst (caar es))
                                                 ka
                                                 (cons (car es) ka))))))
                             (if changed? (cons inst acc) acc)
                             changed?))
                      (else
                       (loop rest '() (if changed? (cons inst acc) acc) changed?))))))))))

(define (lir-peephole-fold-consts-in-ir ir)
  (%lir-transform-ir-bodies ir lir-peephole-fold-int-const-ops #f))

(define-pass lir-peephole-window-pass : L_lir_canonical (ir) -> L_lir_canonical ()
  (fuse-window-rules
    rule-lir-self-mov-elim
    rule-lir-self-fmov-elim
    rule-lir-roundtrip-mov-elim
    rule-lir-dead-reg-overwrite-elim
    rule-lir-store-load-forward
    rule-lir-f64-store-load-forward
    rule-lir-jump-next-label-elim
    rule-lir-identity-arith-elim
    rule-lir-identity-mul-elim
    rule-lir-box-unbox-elim
    rule-lir-redundant-loc-elim
    rule-lir-unreachable-dce))

(define (%lir-all-eq? xs ys)
  (cond
    ((eq? xs ys) #t)
    ((and (pair? xs) (pair? ys))
     (and (eq? (car xs) (car ys))
          (%lir-all-eq? (cdr xs) (cdr ys))))
    (else (and (null? xs) (null? ys)))))

(define (%lir-program-bodies-unchanged? a b)
  (cond
    ((eq? a b) #t)
    ((and (pair? a) (pair? b) (eq? (car a) '%lir-program) (eq? (car b) '%lir-program))
     (let ((fa (assq '%lir-functions (cdr a)))
           (fb (assq '%lir-functions (cdr b)))
           (ma (assq '%lir-main (cdr a)))
           (mb (assq '%lir-main (cdr b))))
       (and (or (eq? ma mb) (equal? ma mb))
            (cond
              ((eq? fa fb) #t)
              ((and (pair? fa) (pair? fb))
               (%lir-all-eq? (cdr fa) (cdr fb)))
              (else #f)))))
    (else #f)))

(define (lir-peephole-optimize ir)
  (let* ((c1 (lir-peephole-fold-consts-in-ir ir))
         (w1 (lir-peephole-window-pass c1))
         (e1 (lir-fold-redundant-extensions-in-ir w1))
         (d1 (lir-eliminate-dead-stack-stores-in-ir e1)))
    (if (or (eq? d1 ir) (%lir-program-bodies-unchanged? ir d1))
        ir
        (let* ((c2 (lir-peephole-fold-consts-in-ir d1))
               (w2 (lir-peephole-window-pass c2))
               (e2 (lir-fold-redundant-extensions-in-ir w2)))
          (if (or (eq? e2 w2) (%lir-program-bodies-unchanged? w2 e2))
              (if (%lir-program-bodies-unchanged? d1 e2) d1 e2)
              (lir-eliminate-dead-stack-stores-in-ir e2))))))

(define (optimize-peephole-fixpoint insts)
  (lir-peephole-optimize insts))
;;; =======================================================================
;;; ULisp Compiler: Backend Architecture Intermediate Languages
;;; Conforms to DSN-33 Architecture Specification & Issue #596
;;; =======================================================================
;;; Formal intermediate language definition for Target Machine Assembly (L_asm_x86)
;;; using Nanopass DSL (define-language). Serves as the declarative contract
;;; between instruction selection (LIR -> L_asm) and code emission (L_asm -> text).
;;; =======================================================================

(define-language L_asm_x86
  (entry Program)
  (terminals
    (symbol (lbl var op cc))
    (integer (n disp imm scale bitmap frame_size offset al_val align))
    (string (str))
    (boolean (bool_val)))
  (Register (reg)
    rax rbx rcx rdx rsi rdi rbp rsp
    r8  r9  r10 r11 r12 r13 r14 r15 al cl
    (%reg var))
  (Memory (mem)
    (%disp disp reg)
    (%index reg reg scale disp)
    (%mem reg disp))
  (Operand (opnd)
    reg
    mem
    (%imm imm)
    imm
    lbl)
  (Inst (inst)
    (%label lbl)
    (%p2align align)
    (%align align)
    (%raw-asm str)
    (mov opnd1 opnd2)
    (movzx opnd1 opnd2)
    (lea opnd1 opnd2)
    (add opnd1 opnd2)
    (sub opnd1 opnd2)
    (imul opnd1 opnd2)
    (and opnd1 opnd2)
    (or opnd1 opnd2)
    (xor opnd1 opnd2)
    (shl opnd1 opnd2)
    (shr opnd1 opnd2)
    (sar opnd1 opnd2)
    (neg opnd)
    (not opnd)
    (cmp opnd1 opnd2)
    (test opnd1 opnd2)
    (set cc opnd)
    (jmp lbl)
    (jcc cc lbl)
    (call opnd)
    (ret)
    (push opnd)
    (pop opnd)
    (cqo)
    (idiv opnd)
    (div opnd)
    (inc opnd)
    (syscall)
    (cld)
    (rep-movsb))
  (StringEntry (se)
    (lbl str))
  (DataChunk (dc)
    n
    (zero n)
    (reloc lbl offset))
  (DataEntry (de)
    (bss lbl al_val n)
    (bytes lbl al_val dc ...))
  (SafepointEntry (sm)
    (lbl frame_size bitmap))
  (AliasEntry (ae)
    (lbl1 lbl2 bool_val))
  (MetaClause (mc)
    (weak-fns (lbl ...))
    (weak-data (lbl ...))
    (aliases (ae ...))
    (top-asm (str ...)))
  (FunctionDecl (f)
    (%asm-function lbl (frame-size n) (body inst ...)))
  (MainDecl (m)
    (%asm-main (frame-size n) (body inst ...)))
  (Program (p)
    (%asm-program (strings (se ...)) (stackmaps (sm ...)) (%asm-functions f ...) m mc ...)
    (%asm-program (strings (se ...)) (data (de ...)) (stackmaps (sm ...)) (%asm-functions f ...) m mc ...)))

