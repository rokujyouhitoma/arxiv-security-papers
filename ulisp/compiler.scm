  (emit "    lea r10, [r9 + 8]")
  (emit "    mov rcx, rdi")
  (emit "    and rcx, 7")
  (emit "    or r10, rcx")
  (emit "    mov [r8 - 8], r10")
  (emit "    add r9, rax")
  (emit "    mov [r11 + 40], r9")
