              (list '%raw-asm "    and rcx, 63")
              (list '%raw-asm "    shl rcx, 3")
              (list '%raw-asm "    lea rdx, [rip + ulisp_handler_chain]")
              (list '%raw-asm "    add rdx, rcx")
              (list '%raw-asm "    mov rbx, [rdx]")
              (list '%raw-asm "    test rbx, rbx")
