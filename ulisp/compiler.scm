(define *x86-reg-str-map*
  (let ((m (make-symbol-map 256)))
    (for-each
     (lambda (e)
       (let ((k (car e)))
         (if (and (string? k) (not (symbol-map-contains? m k)))
             (symbol-map-set! m k (cdr e)))))
     *x86-reg-table*)
    m))

(define (lookup-x86-reg reg)
  (let ((hit (symbol-map-get *x86-reg-str-map* (reg->string reg))))
    (if hit (cdr hit) #f)))

(define (x86-reg? reg)
  (pair? (lookup-x86-reg reg)))

