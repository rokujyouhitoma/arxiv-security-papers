(cond-expand
  (ulisp
   (define (string=? s1 s2)
     (and (string? s1) (string? s2)
          (= (string-length s1) (string-length s2))
          (let loop ((i 0) (len (string-length s1)))
            (if (= i len)
                #t
                (if (char=? (string-ref s1 i) (string-ref s2 i))
                    (loop (+ i 1) len)
                    #f))))))
  (else))

