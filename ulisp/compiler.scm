       ("cvtsi2sd" . cvtsi2sd) ("cvttsd2si" . cvttsd2si)
       ("cvtsi2ss" . cvtsi2ss) ("cvttss2si" . cvttss2si)
       ("cvtss2sd" . cvtss2sd) ("cvtsd2ss" . cvtsd2ss)
       ("addsd" . addsd) ("addss" . addss) ("subsd" . subsd) ("subss" . subss)
       ("mulsd" . mulsd) ("mulss" . mulss) ("divsd" . divsd) ("divss" . divss)
       ("sqrtsd" . sqrtsd) ("sqrtss" . sqrtss)
       ("ucomisd" . ucomisd) ("ucomiss" . ucomiss)
       ("pxor" . pxor) ("xorpd" . xorpd) ("xorps" . xorps)
       ("andpd" . andpd) ("andps" . andps) ("orpd" . orpd) ("orps" . orps)
       ("add" . add) ("sub" . sub) ("and" . and) ("or" . or) ("xor" . xor) ("cmp" . cmp)
       ("bt" . bt) ("bsf" . bsf) ("bsr" . bsr) ("test" . test) ("imul" . imul) ("idiv" . idiv) ("div" . div)
       ("pcmpeqd" . pcmpeqd) ("psrlq" . psrlq) ("psllq" . psllq)
       ("shl" . shl) ("shr" . shr) ("sar" . sar) ("neg" . neg) ("not" . not)
       ("inc" . inc) ("dec" . dec) ("mfence" . mfence) ("lfence" . lfence) ("sfence" . sfence)
       ("pause" . pause) ("cpuid" . cpuid) ("rdtsc" . rdtsc) ("rdtscp" . rdtscp)
       ("bswap" . bswap) ("xchg" . xchg) ("xadd" . xadd)
       ("cmpxchg" . cmpxchg) ("cmpxchgq" . cmpxchg)))
    m))

(define (canonical-mnem sym-or-str)
  (if (symbol? sym-or-str)
      (case sym-or-str
        ((nop) 'nop) ((ret) 'ret) ((syscall) 'syscall) ((cld) 'cld) ((cqo) 'cqo) ((hlt) 'hlt)
        ((rep-movsb) 'rep-movsb) ((rep) 'rep) ((movsb) 'movsb) ((movsq) 'movsq) ((stosb) 'stosb) ((stosq) 'stosq)
        ((push) 'push) ((pop) 'pop) ((call) 'call) ((jmp) 'jmp)
        ((je jz) 'je) ((jne jnz) 'jne) ((jb) 'jb) ((jae jnc) 'jae) ((jbe) 'jbe) ((ja) 'ja)
        ((js) 'js) ((jns) 'jns) ((jl) 'jl) ((jge) 'jge) ((jle) 'jle) ((jg) 'jg)
        ((jp jpe) 'jp) ((jnp jpo) 'jnp)
        ((seto) 'seto)
        ((sete setz) 'sete) ((setne setnz) 'setne) ((setb) 'setb) ((setae) 'setae)
        ((setbe) 'setbe) ((seta) 'seta) ((setl) 'setl) ((setge) 'setge) ((setle) 'setle) ((setg) 'setg)
        ((setp setpe) 'setp) ((setnp setpo) 'setnp)
        ((cmove cmovz) 'cmove) ((cmovne cmovnz) 'cmovne) ((cmovl) 'cmovl) ((cmovge) 'cmovge)
        ((cmovle) 'cmovle) ((cmovg) 'cmovg) ((movzx) 'movzx) ((movsx) 'movsx) ((movsxd) 'movsxd) ((lea) 'lea) ((mov) 'mov)
        ((movsd) 'movsd) ((movss) 'movss) ((movq) 'movq) ((movd) 'movd)
        ((movapd) 'movapd) ((movaps) 'movaps) ((movupd) 'movupd) ((movups) 'movups)
        ((cvtsi2sd) 'cvtsi2sd) ((cvttsd2si) 'cvttsd2si)
        ((cvtsi2ss) 'cvtsi2ss) ((cvttss2si) 'cvttss2si)
        ((cvtss2sd) 'cvtss2sd) ((cvtsd2ss) 'cvtsd2ss)
        ((addsd) 'addsd) ((addss) 'addss) ((subsd) 'subsd) ((subss) 'subss)
        ((mulsd) 'mulsd) ((mulss) 'mulss) ((divsd) 'divsd) ((divss) 'divss)
        ((sqrtsd) 'sqrtsd) ((sqrtss) 'sqrtss)
        ((ucomisd) 'ucomisd) ((ucomiss) 'ucomiss)
        ((pxor) 'pxor) ((xorpd) 'xorpd) ((xorps) 'xorps)
        ((andpd) 'andpd) ((andps) 'andps) ((orpd) 'orpd) ((orps) 'orps)
        ((add) 'add) ((sub) 'sub) ((and) 'and) ((or) 'or) ((xor) 'xor) ((cmp) 'cmp)
        ((bt) 'bt) ((bsf) 'bsf) ((bsr) 'bsr) ((test) 'test) ((imul) 'imul) ((idiv) 'idiv) ((div) 'div)
        ((pcmpeqd) 'pcmpeqd) ((psrlq) 'psrlq) ((psllq) 'psllq)
        ((shl) 'shl) ((shr) 'shr) ((sar) 'sar) ((neg) 'neg) ((not) 'not)
        ((inc) 'inc) ((dec) 'dec) ((mfence) 'mfence) ((cmpxchg) 'cmpxchg)
        ((lfence) 'lfence) ((sfence) 'sfence) ((pause) 'pause)
        ((cpuid) 'cpuid) ((rdtsc) 'rdtsc) ((rdtscp) 'rdtscp)
        ((bswap) 'bswap) ((xchg) 'xchg) ((xadd) 'xadd)
        (else 'unknown))
      (if (string? sym-or-str)
          (let ((hit (symbol-map-get *x86-mnem-str-map* (safe-string-downcase sym-or-str))))
            (if hit (cdr hit) 'unknown))
          'unknown)))

(define (reg-id info) (if (pair? info) (car info) 0))
(define (reg-size info) (if (and (pair? info) (pair? (cdr info))) (cadr info) 8))
(define (reg-ext? info) (if (and (pair? info) (pair? (cdr info)) (pair? (cddr info))) (caddr info) #f))
(define (reg-rex? info) (if (and (pair? info) (pair? (cdr info)) (pair? (cddr info)) (pair? (cdddr info))) (cadddr info) #f))

;; Accessors for parsed operands
(define (op-is-reg? op) (and (pair? op) (eq? (car op) 'reg)))
(define (op-is-mem? op) (and (pair? op) (eq? (car op) 'mem)))
(define (op-is-imm? op) (and (pair? op) (eq? (car op) 'imm)))

(define (reg-op-sym op) (if (and (pair? op) (pair? (cdr op))) (cadr op) #f))
(define (reg-op-id op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op))) (caddr op) 0))
(define (reg-op-size op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op)) (pair? (cdddr op))) (cadddr op) 8))
(define (reg-op-ext? op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op)) (pair? (cdddr op)) (pair? (cddddr op))) (car (cddddr op)) #f))

(define (reloc-sym op) (if (and (pair? op) (pair? (cdr op))) (cadr op) ""))
(define (reloc-addend op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op))) (caddr op) 0))

(define (mem-base op) (if (and (pair? op) (pair? (cdr op))) (cadr op) #f))
(define (mem-index op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op))) (caddr op) #f))
(define (mem-scale op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op)) (pair? (cdddr op))) (cadddr op) 1))
(define (mem-disp op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op)) (pair? (cdddr op)) (pair? (cddddr op))) (car (cddddr op)) 0))
(define (mem-size op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op)) (pair? (cdddr op)) (pair? (cddddr op)) (pair? (cdr (cddddr op)))) (cadr (cddddr op)) 8))
(define (mem-rip-sym op) (if (and (pair? op) (pair? (cdr op)) (pair? (cddr op)) (pair? (cdddr op)) (pair? (cddddr op)) (pair? (cdr (cddddr op))) (pair? (cddr (cddddr op)))) (caddr (cddddr op)) #f))
(define (mem-seg-fs? op) (and (pair? op) (pair? (cdr op)) (pair? (cddr op)) (pair? (cdddr op)) (pair? (cddddr op)) (pair? (cdr (cddddr op))) (pair? (cddr (cddddr op))) (pair? (cdddr (cddddr op))) (cadddr (cddddr op))))
(define (op-has-fs? op) (and (op-is-mem? op) (mem-seg-fs? op)))

;; -----------------------------------------------------------------------
;; 2. Instruction Encoding Helpers (REX, ModR/M, SIB)
;; -----------------------------------------------------------------------
;; REX: 0x40 | (W << 3) | (R << 2) | (X << 1) | B
(define (make-rex w r x b)
  (+ (+ (+ (+ 64 (if w 8 0))
           (if r 4 0))
        (if x 2 0))
     (if b 1 0)))

;; ModR/M: (mod << 6) | (reg << 3) | rm
(define (make-modrm mod reg rm)
  (+ (+ (* (modulo mod 4) 64)
        (* (modulo reg 8) 8))
     (modulo rm 8)))

;; SIB: (scale << 6) | (index << 3) | base
(define (make-sib scale index base)
  (+ (+ (* (modulo scale 4) 64)
        (* (modulo index 8) 8))
     (modulo base 8)))

(define (asm-concat-2 l1 l2)
  (if (null? l1)
      l2
      (cons (car l1) (asm-concat-2 (cdr l1) l2))))

(define (asm-flatten lists)
  (let loop ((rest lists))
    (cond
      ((null? rest) '())
      ((null? (cdr rest)) (car rest))
      (else (asm-concat-2 (car rest) (loop (cdr rest)))))))

(define (enc-rex enc) (car enc))
(define (enc-modrm enc) (cadr enc))
(define (enc-sib enc) (caddr enc))
(define (enc-disp enc) (cadddr enc))

;; Little-Endian list of bytes for 16, 32, 64-bit integers
(define (split-u16-le val)
  (let ((u (if (< val 0) (+ val 65536) val)))
    (list (modulo u 256)
          (modulo (quotient u 256) 256))))

(define (split-u32-le val)
  (let ((u (if (< val 0) (+ val 4294967296) val)))
    (list (modulo u 256)
          (modulo (quotient u 256) 256)
          (modulo (quotient u 65536) 256)
          (modulo (quotient u 16777216) 256))))

(define (split-u64-le val)
  (let* ((lo (modulo val 4294967296))
         (hi (quotient (- val lo) 4294967296)))
    (append (split-u32-le lo)
            (split-u32-le hi))))

;; -----------------------------------------------------------------------
;; 3. String & Token Utilities for Assembly Line Parsing
;; -----------------------------------------------------------------------
(define (string-starts-with? s prefix)
  (let ((slen (string-length s))
        (plen (string-length prefix)))
    (if (< slen plen)
        #f
        (let loop ((i 0))
          (if (= i plen)
              #t
              (if (char=? (string-ref s i) (string-ref prefix i))
                  (loop (+ i 1))
                  #f))))))

(define (safe-string-downcase str)
  (let ((len (string-length str)))
    (let check ((i 0))
      (if (>= i len)
          str
          (let ((code (char->integer (string-ref str i))))
            (if (and (>= code 65) (<= code 90))
                (let ((res (make-string len)))
                  (let copy ((j 0))
                    (if (< j len)
                        (let* ((c (string-ref str j))
                               (jc (char->integer c))
                               (new-c (if (and (>= jc 65) (<= jc 90))
                                          (integer->char (+ jc 32))
                                          c)))
                          (string-set! res j new-c)
                          (copy (+ j 1)))
                        res)))
                (check (+ i 1))))))))

(define (safe-string->number val)
  (cond
    ((number? val) val)
    ((symbol? val) (safe-string->number (symbol->string val)))
    ((string? val)
     (let ((len (string-length val)))
       (if (= len 0)
           #f
           (let* ((c0 (string-ref val 0))
                  (neg? (char=? c0 #\-))
                  (pos? (char=? c0 #\+))
                  (start (if (or neg? pos?) 1 0)))
             (if (and (< (+ start 2) len)
                      (char=? (string-ref val start) #\0)
                      (let ((c1 (string-ref val (+ start 1))))
                        (or (char=? c1 #\x) (char=? c1 #\X))))
                 ;; Hexadecimal: 0x...
                 (let loop ((i (+ start 2)) (acc 0))
                   (if (>= i len)
                       (if neg? (- 0 acc) acc)
                       (let* ((c (string-ref val i))
                              (code (char->integer c))
                              (digit (cond
                                       ((and (>= code 48) (<= code 57)) (- code 48))
                                       ((and (>= code 97) (<= code 102)) (+ 10 (- code 97)))
                                       ((and (>= code 65) (<= code 70)) (+ 10 (- code 65)))
                                       (else #f))))
                         (if digit
                             (loop (+ i 1) (+ (* acc 16) digit))
                             #f))))
                 ;; Decimal
                 (if (and (= start 1) (= len 1))
                     #f
                     (let loop ((i start) (acc 0))
                       (if (>= i len)
                           (if neg? (- 0 acc) acc)
                           (let ((c (string-ref val i)))
                             (if (and (char>=? c #\0) (char<=? c #\9))
                                 (loop (+ i 1) (+ (* acc 10) (- (char->integer c) 48)))
                                 #f))))))))))
    (else #f)))

(define (asm-char-whitespace? c)
  (let ((code (char->integer c)))
    (or (= code 32) (= code 9) (= code 10) (= code 13))))

(define (asm-trim-string str)
  (let* ((len (string-length str))
         (start (let loop ((i 0))
                  (if (and (< i len) (asm-char-whitespace? (string-ref str i)))
                      (loop (+ i 1))
                      i)))
         (end (let loop ((j len))
                (if (and (> j start) (asm-char-whitespace? (string-ref str (- j 1))))
                    (loop (- j 1))
                    j))))
    (if (and (= start 0) (= end len))
        str
        (substring str start end))))

(define (asm-strip-comment line)
  (let ((len (string-length line)))
    (let loop ((i 0) (in-quote #f))
      (if (>= i len)
          line
          (let ((c (string-ref line i)))
            (cond
              ((char=? c #\") (loop (+ i 1) (not in-quote)))
              ((and (not in-quote) (or (char=? c #\#) (char=? c #\;)))
               (substring line 0 i))
              (else (loop (+ i 1) in-quote))))))))

(define (asm-tokenize-line line)
  (let* ((clean (asm-trim-string (asm-strip-comment line)))
         (len (string-length clean)))
    (if (= len 0)
        '()
        (let loop ((i 0) (tokens '()))
          (if (>= i len)
              (reverse tokens)
              (let ((c (string-ref clean i)))
                (cond
                  ((asm-char-whitespace? c)
                   (loop (+ i 1) tokens))
                  ((char=? c #\,)
                   (loop (+ i 1) (cons "," tokens)))
                  ((char=? c #\:)
                   (loop (+ i 1) (cons ":" tokens)))
                  ((char=? c #\")
                   (let str-loop ((j (+ i 1)) (escaped #f) (chars '()))
                     (if (>= j len)
                         (reverse (cons (list->string (reverse chars)) tokens))
                         (let ((sc (string-ref clean j)))
                           (cond
                             (escaped
                              (str-loop (+ j 1) #f (cons (case sc ((#\n) #\newline) ((#\t) #\tab) ((#\r) (integer->char 13)) ((#\\) #\\) ((#\") #\") (else sc)) chars)))
                             ((char=? sc #\\)
                              (str-loop (+ j 1) #t chars))
                             ((char=? sc #\")
                              (loop (+ j 1) (cons (list->string (reverse chars)) tokens)))
                             (else
                              (str-loop (+ j 1) #f (cons sc chars))))))))
                  (else
                   (let tok-loop ((j i))
                     (if (or (>= j len)
                             (asm-char-whitespace? (string-ref clean j))
                             (char=? (string-ref clean j) #\,)
                             (char=? (string-ref clean j) #\:))
                         (loop j (cons (substring clean i j) tokens))
                         (tok-loop (+ j 1))))))))))))

;; -----------------------------------------------------------------------
;; 3.1 Data Directives & Section Helpers (Issue #830)
;; -----------------------------------------------------------------------
(define (asm-split-by-comma tokens)
  (let loop ((rest tokens) (cur '()) (acc '()))
    (cond
      ((null? rest)
       (if (null? cur)
           (reverse acc)
           (reverse (cons (reverse cur) acc))))
      ((string=? (car rest) ",")
       (if (null? cur)
           (loop (cdr rest) '() acc)
           (loop (cdr rest) '() (cons (reverse cur) acc))))
      (else
       (loop (cdr rest) (cons (car rest) cur) acc)))))

(define (asm-tokens->string toks)
  (let loop ((ts toks) (acc ""))
    (if (null? ts)
        (asm-trim-string acc)
        (loop (cdr ts) (if (= (string-length acc) 0) (car ts) (string-append acc " " (car ts)))))))

(define (asm-parse-data-expr str)
  (let ((str (asm-trim-string str)))
    (cond
      ((= (string-length str) 0)
       (cons 'num 0))
      ((and (>= (string-length str) 2)
            (char=? (string-ref str 0) #\")
            (char=? (string-ref str (- (string-length str) 1)) #\"))
       (cons 'str (substring str 1 (- (string-length str) 1))))
      (else
       (let ((num (safe-string->number str)))
         (if num
             (cons 'num num)
             (let* ((len (string-length str))
                    (op-pos (let loop ((i 1))
                              (if (>= i len)
                                  #f
                                  (let ((c (string-ref str i)))
                                    (if (or (char=? c #\+) (char=? c #\-))
                                        i
                                        (loop (+ i 1))))))))
               (if op-pos
                   (let* ((sym (asm-trim-string (substring str 0 op-pos)))
                          (sign (if (char=? (string-ref str op-pos) #\-) -1 1))
                          (rest-str (asm-trim-string (substring str (+ op-pos 1) len)))
                          (addend-num (safe-string->number rest-str)))
                     (cond
                       (addend-num
                        (cons 'sym (cons sym (* sign addend-num))))
                       ((and (= sign -1) (> (string-length rest-str) 0))
                        (cons 'sym-diff (cons sym rest-str)))
                       (else
                        (cons 'sym (cons sym 0)))))
                   (cons 'sym (cons str 0))))))))))

(define (asm-string->bytes str null-term?)
  (let loop ((i 0) (acc '()))
    (if (>= i (string-length str))
        (reverse (if null-term? (cons 0 acc) acc))
        (loop (+ i 1) (cons (char->integer (string-ref str i)) acc)))))

(define (asm-make-byte-list count val)
  (let ((b (modulo (if (< val 0) (+ val 256) val) 256)))
    (let loop ((i 0) (acc '()))
      (if (< i count)
          (loop (+ i 1) (cons b acc))
          acc))))

(define (asm-parse-fill-args groups)
  (let* ((repeat-group (if (pair? groups) (car groups) '("0")))
         (repeat-expr (asm-parse-data-expr (asm-tokens->string repeat-group)))
         (repeat (if (eq? (car repeat-expr) 'num) (cdr repeat-expr) 0))
         (size-group (if (and (pair? groups) (pair? (cdr groups))) (cadr groups) '("1")))
         (size-expr (asm-parse-data-expr (asm-tokens->string size-group)))
         (size (if (eq? (car size-expr) 'num) (cdr size-expr) 1))
         (val-group (if (and (pair? groups) (pair? (cdr groups)) (pair? (cddr groups))) (caddr groups) '("0")))
         (val-expr (asm-parse-data-expr (asm-tokens->string val-group)))
         (val (if (eq? (car val-expr) 'num) (cdr val-expr) 0)))
    (list (if (> repeat 0) repeat 0)
          (if (> size 0) size 1)
          val)))

(define (asm-generate-fill-bytes repeat size val)
  (let* ((chunk (cond
                  ((= size 1) (list (modulo (if (< val 0) (+ val 256) val) 256)))
                  ((= size 2) (split-u16-le val))
                  ((= size 4) (split-u32-le val))
                  ((= size 8) (split-u64-le val))
                  (else
                   (let loop ((i 0) (acc '()))
                     (if (< i size)
                         (loop (+ i 1) (cons (modulo val 256) acc))
                         acc))))))
    (let rep-loop ((r repeat) (acc '()))
      (if (<= r 0)
          acc
          (rep-loop (- r 1) (append chunk acc))))))

(define (asm-canonical-section tok)
  (let* ((s (if (string? tok) tok (symbol->string tok)))
         (len (string-length s))
         (clean-s (if (and (>= len 2) (char=? (string-ref s 0) #\") (char=? (string-ref s (- len 1)) #\"))
                      (substring s 1 (- len 1))
                      s)))
    (cond
      ((or (string=? clean-s ".text") (string-starts-with? clean-s ".text")) 'text)
      ((or (string=? clean-s ".rodata") (string-starts-with? clean-s ".rodata")) 'rodata)
      ((or (string=? clean-s ".data") (string-starts-with? clean-s ".data")) 'data)
      ((or (string=? clean-s ".bss") (string-starts-with? clean-s ".bss")) 'bss)
      ((or (string=? clean-s ".init_array") (string-starts-with? clean-s ".init_array")) 'init_array)
      ((or (string=? clean-s "ulisp_globals_sec") (string-starts-with? clean-s "ulisp_globals_sec")) 'ulisp_globals_sec)
      ((string-starts-with? clean-s ".note") 'note)
      (else 'text))))

;; -----------------------------------------------------------------------
;; 4. Direct x86-64 Instruction Encoding Engine
;; -----------------------------------------------------------------------
;; Operand AST definitions:
;; - (list 'reg name id size ext?)
;; - (list 'mem base-id index-id scale disp size rip-sym?)
;; - (list 'imm val)
;; - (list 'rel-sym sym addend)

(define (encode-modrm-sib-disp w r-info mem-op)
  ;; mem-op: (list 'mem base-info index-info scale disp size rip-sym)
  (let* ((mem-op (if (and (pair? mem-op) (eq? (car mem-op) 'rel-sym))
                     (list 'mem #f #f 1 0 8 (cadr mem-op))
                     mem-op))
         (r-id (if (pair? r-info) (reg-id r-info) 0))
         (r-ext? (if (pair? r-info) (reg-ext? r-info) #f))
         (r-rex? (if (pair? r-info) (reg-rex? r-info) #f))
         (base-info (mem-base mem-op))
         (index-info (mem-index mem-op))
         (scale (mem-scale mem-op))
         (disp (mem-disp mem-op))
         (rip-sym (mem-rip-sym mem-op)))
    (cond
      ;; RIP-relative: [rip + sym/disp] -> mod=00, rm=5 (disp32)
      (rip-sym
       (let* ((rex (make-rex w r-ext? #f #f))
              (modrm (make-modrm 0 r-id 5))
              (disp-bytes (split-u32-le disp)))
         (list (if (or w r-ext? r-rex?) (list rex) '())
               (list modrm)
               '()
               disp-bytes)))

      ;; Memory with Index register (SIB): [base + index*scale + disp]
      (index-info
       (let* ((b-id (if base-info (reg-id base-info) 0))
              (b-ext? (if base-info (reg-ext? base-info) #f))
              (b-rex? (if base-info (reg-rex? base-info) #f))
              (i-id (if index-info (reg-id index-info) 0))
              (i-ext? (if index-info (reg-ext? index-info) #f))
              (i-rex? (if index-info (reg-rex? index-info) #f))
              (mod (cond ((= disp 0) (if (or (= b-id 5) (= b-id 13)) 1 0))
                         ((and (>= disp -128) (<= disp 127)) 1)
                         (else 2)))
              (rex (make-rex w r-ext? i-ext? b-ext?))
              (modrm (make-modrm mod r-id 4))
              (sib (make-sib (case scale ((1) 0) ((2) 1) ((4) 2) ((8) 3) (else 0))
                             (modulo i-id 8)
                             (modulo b-id 8)))
              (disp-bytes (cond ((= mod 0) '())
                                ((= mod 1) (list (modulo (if (< disp 0) (+ disp 256) disp) 256)))
                                (else (split-u32-le disp)))))
         (list (if (or w r-ext? i-ext? b-ext? r-rex? b-rex? i-rex?) (list rex) '())
               (list modrm)
               (list sib)
               disp-bytes)))

      ;; Base-only, absolute disp32, or RSP/R12
      ((and (not base-info) (not index-info))
       ;; Absolute disp32 (e.g. fs:[0]): ModRM(mod=0, r-id, rm=4) + SIB(0,4,5=0x25) + disp32
       (let* ((rex (make-rex w r-ext? #f #f))
              (modrm (make-modrm 0 r-id 4))
              (sib (make-sib 0 4 5))
              (disp-bytes (split-u32-le disp)))
         (list (if (or w r-ext? r-rex?) (list rex) '())
               (list modrm)
               (list sib)
               disp-bytes)))

      (else
       (let* ((b-id (if base-info (reg-id base-info) 0))
              (b-ext? (if base-info (reg-ext? base-info) #f))
              (b-rex? (if base-info (reg-rex? base-info) #f))
              (force-sib? (or (= b-id 4) (= b-id 12))) ;; rsp, r12 require SIB
              (mod (cond ((and (= disp 0) (not (or (= b-id 5) (= b-id 13)))) 0)
                         ((and (>= disp -128) (<= disp 127)) 1)
                         (else 2)))
              (rex (make-rex w r-ext? #f b-ext?))
              (modrm (make-modrm mod r-id (if force-sib? 4 (modulo b-id 8))))
              (sib-bytes (if force-sib? (list (make-sib 0 4 (modulo b-id 8))) '()))
              (disp-bytes (cond ((= mod 0) '())
                                ((= mod 1) (list (modulo (if (< disp 0) (+ disp 256) disp) 256)))
                                (else (split-u32-le disp)))))
         (list (if (or w r-ext? b-ext? r-rex? b-rex?) (list rex) '())
               (list modrm)
               sib-bytes
               disp-bytes))))))

;; Helper to parse memory string: e.g. "[rsp - 8]", "[rip + .L_1]", "byte ptr [rax]", "qword ptr fs:[0]"
(define (parse-mem-operand-str str)
  (let* ((clean (asm-trim-string str))
         (low (safe-string-downcase clean))
         ;; detect width prefix
         (is-byte? (string-starts-with? low "byte ptr"))
         (is-word? (string-starts-with? low "word ptr"))
         (is-dword? (string-starts-with? low "dword ptr"))
         (is-qword? (string-starts-with? low "qword ptr"))
         (is-oword? (or (string-starts-with? low "xmmword ptr")
                        (string-starts-with? low "oword ptr")))
         (size (cond (is-byte? 1) (is-word? 2) (is-dword? 4) (is-oword? 16) (else 8)))
         ;; extract bracket contents
         (lb (let loop ((i 0)) (if (or (>= i (string-length clean)) (char=? (string-ref clean i) #\[)) i (loop (+ i 1)))))
         (rb (let loop ((i (- (string-length clean) 1))) (if (or (< i 0) (char=? (string-ref clean i) #\])) i (loop (- i 1)))))
         (pre-br (if (< lb (string-length clean))
                     (safe-string-downcase (asm-trim-string (substring clean 0 lb)))
                     ""))
         (raw-inner (if (and (< lb rb) (< lb (string-length clean)))
                        (asm-trim-string (substring clean (+ lb 1) rb))
                        "rsp"))
         (raw-in-low (safe-string-downcase raw-inner))
         (seg-fs? (or (let ((pn (string-length pre-br)))
                        (or (and (>= pn 3) (string=? (substring pre-br (- pn 3) pn) "fs:"))
                            (and (>= pn 4) (string=? (substring pre-br (- pn 4) pn) "fs :"))
                            (string-starts-with? pre-br "fs:")
                            (string-starts-with? pre-br "fs :")))
                      (string-starts-with? raw-in-low "fs:")))
         (inner (if (string-starts-with? raw-in-low "fs:")
                    (asm-trim-string (substring raw-inner 3 (string-length raw-inner)))
                    raw-inner)))
    ;; Parse inner components: e.g. "rsp - 8", "rax + 96", "rip + ulisp_state", "rdx + rcx*8", "0"
    (let ((tokens (let loop ((i 0) (cur '()) (acc '()))
                    (if (>= i (string-length inner))
                        (if (null? cur) (reverse acc) (reverse (cons (list->string (reverse cur)) acc)))
                        (let ((c (string-ref inner i)))
                          (cond
                            ((or (char=? c #\+) (char=? c #\-))
                             (let ((a (if (null? cur) acc (cons (list->string (reverse cur)) acc))))
                               (loop (+ i 1) '() (cons (string c) a))))
                            ((asm-char-whitespace? c)
                             (if (null? cur)
                                 (loop (+ i 1) '() acc)
                                 (loop (+ i 1) '() (cons (list->string (reverse cur)) acc))))
                            (else
                             (loop (+ i 1) (cons c cur) acc))))))))
      (let* ((first-tok (if (pair? tokens) (car tokens) "rsp"))
             (is-rip? (string=? (safe-string-downcase first-tok) "rip")))
        (if is-rip?
            ;; RIP-relative: (list 'mem #f #f 0 disp size rip-sym seg-fs?)
            (let* ((sign (if (and (pair? (cdr tokens)) (string=? (cadr tokens) "-")) -1 1))
                   (sym-or-disp (if (pair? (cddr tokens)) (caddr tokens) "0"))
                   (num (safe-string->number sym-or-disp)))
              (if num
                  (list 'mem #f #f 0 (* num sign) size "rip_disp" seg-fs?)
                  (let loop ((rem (cdddr tokens)) (disp 0))
                    (cond
                      ((null? rem)
                       (list 'mem #f #f 0 disp size sym-or-disp seg-fs?))
                      ((or (string=? (car rem) "+") (string=? (car rem) "-"))
                       (let* ((s (if (string=? (car rem) "-") -1 1))
                              (n (if (pair? (cdr rem)) (safe-string->number (cadr rem)) 0)))
                         (loop (cddr rem) (+ disp (* (if n n 0) s)))))
                      (else
                       (loop (cdr rem) disp))))))
            ;; Absolute disp32 [0] / [disp] OR Register base + disp or index
            (let* ((b-info (lookup-x86-reg first-tok))
                   (abs-first (if (not b-info) (safe-string->number first-tok) #f))
                   (b-reg (cond (b-info b-info) (abs-first #f) (else (lookup-x86-reg "rsp"))))
                   (init-disp (if abs-first abs-first 0))
                   (rest (cdr tokens)))
              (let parse-rest ((ts rest) (idx-info #f) (scale 1) (disp init-disp))
                (cond
                  ((null? ts)
                   (list 'mem b-reg idx-info scale disp size #f seg-fs?))
                  ((or (string=? (car ts) "+") (string=? (car ts) "-"))
                   (let* ((sign (if (string=? (car ts) "-") -1 1))
                          (next-tok (if (pair? (cdr ts)) (cadr ts) "0"))
                          (num (safe-string->number next-tok)))
                     (if num
                         (parse-rest (cddr ts) idx-info scale (+ disp (* num sign)))
                         ;; check if next-tok is reg or reg*scale
                         (let* ((star-pos (let loop ((k 0)) (if (or (>= k (string-length next-tok)) (char=? (string-ref next-tok k) #\*)) k (loop (+ k 1)))))
                                (r-name (if (< star-pos (string-length next-tok))
                                            (substring next-tok 0 star-pos)
                                            next-tok))
                                (sc (if (< star-pos (string-length next-tok))
                                        (safe-string->number (substring next-tok (+ star-pos 1) (string-length next-tok)))
                                        1))
                                (r-info (lookup-x86-reg r-name)))
                           (if r-info
                               (parse-rest (cddr ts) r-info (if sc sc 1) disp)
                               (parse-rest (cddr ts) idx-info scale disp))))))
                  (else
                   (parse-rest (cdr ts) idx-info scale disp))))))))))

;; Helper to parse register or immediate or memory from token
(define (parse-operand-str tok)
  (let* ((str (cond ((string? tok) tok)
                    ((symbol? tok) (symbol->string tok))
                    ((number? tok) (number->string tok))
                    (else (error "Invalid operand token" tok))))
         (clean (asm-trim-string str))
         (low (safe-string-downcase clean)))
    (cond
      ((or (string-starts-with? low "[")
           (string-starts-with? low "fs:")
           (string-starts-with? low "fs :")
           (string-starts-with? low "byte ptr")
           (string-starts-with? low "word ptr")
           (string-starts-with? low "dword ptr")
           (string-starts-with? low "qword ptr")
           (string-starts-with? low "xmmword ptr")
           (string-starts-with? low "oword ptr"))
       (parse-mem-operand-str clean))
      ((x86-reg? clean)
       (let ((info (lookup-x86-reg clean)))
         (list 'reg (safe-string-downcase clean) (reg-id info) (reg-size info) (reg-ext? info))))
      ((safe-string->number clean)
       (list 'imm (safe-string->number clean)))
      ((and (>= (string-length clean) 3)
            (char=? (string-ref clean 0) #\')
            (char=? (string-ref clean (- (string-length clean) 1)) #\'))
       (let ((c (string-ref clean 1)))
         (list 'imm (if (and (= (string-length clean) 4) (char=? c #\\))
                        (case (string-ref clean 2)
                          ((#\n) 10)
                          ((#\t) 9)
                          ((#\0) 0)
                          ((#\r) 13)
                          (else (char->integer (string-ref clean 2))))
                        (char->integer c)))))
      (else
       ;; Label or symbol reference
       (list 'rel-sym clean 0)))))

;; Shared SSE2 memory operand encoder with RIP-relative relocation emission
(define (asm-emit-sse2-modrm-mem pfx-bytes w opc-list r-info mem-op curr-off)
  (let* ((enc (encode-modrm-sib-disp w r-info mem-op))
         (rip-sym (if (eq? (car mem-op) 'mem) (mem-rip-sym mem-op) (reloc-sym mem-op)))
         (addend (if (eq? (car mem-op) 'mem) (mem-disp mem-op) (reloc-addend mem-op)))
         (head (asm-flatten (list pfx-bytes (enc-rex enc) opc-list (enc-modrm enc) (enc-sib enc)))))
    (if (and rip-sym (not (string=? rip-sym "rip_disp")))
        (list (append head '(0 0 0 0))
              (list 'rip_disp32 (+ curr-off (length head)) rip-sym addend 0))
        (list (asm-flatten (list head (enc-disp enc))) #f))))

;; -----------------------------------------------------------------------
;; 5. Single Instruction Assembler Function
;; -----------------------------------------------------------------------
;; Returns: (list (bytes ...) reloc-or-#f)
;; reloc format: (list type sym addend patch-offset)
;; type: 'rel32, 'rip_disp32, 'abs64
(define (assemble-inst raw-mnem opnds curr-off)
  (assemble-inst-with-syms raw-mnem opnds curr-off #f))

(define (assemble-inst-with-syms raw-mnem opnds curr-off sym-map)
  (let* ((has-fs? (or (and (pair? opnds) (op-has-fs? (car opnds)))
                      (and (pair? opnds) (pair? (cdr opnds)) (op-has-fs? (cadr opnds)))))
         (adj-off (if has-fs? (+ curr-off 1) curr-off))
         (core (assemble-inst-with-syms-core raw-mnem opnds adj-off sym-map)))
    (if (and has-fs? (pair? core))
        (list (cons 100 (car core)) (cadr core))
        core)))

(define (assemble-inst-with-syms-core raw-mnem opnds curr-off sym-map)
  (let ((mnem (canonical-mnem raw-mnem)))
    (case mnem
    ((nop)
     (list '(144) #f)) ;; 0x90

    ((ret)
     (list '(195) #f)) ;; 0xC3

    ((syscall)
     (list '(15 5) #f)) ;; 0x0F 0x05

    ((cld)
     (list '(252) #f)) ;; 0xFC

    ((cqo)
     (list '(72 153) #f))

    ((hlt)
     (list '(244) #f)) ;; 0xF4

    ((movsb)
     (list '(164) #f))

    ((movsq)
     (list '(72 165) #f))

    ((stosb)
     (list '(170) #f))

    ((stosq)
     (list '(72 171) #f))

    ((rep-movsb)
     (list '(243 164) #f))

    ((rep)
     (if (null? opnds)
         (list '(243) #f)
         (let ((sub (canonical-mnem (if (pair? (car opnds)) (reloc-sym (car opnds)) (car opnds)))))
           (case sub
             ((movsq) (list '(243 72 165) #f))
             ((stosb) (list '(243 170) #f))
             ((stosq) (list '(243 72 171) #f))
             (else (list '(243 164) #f))))))

    ((push)
     (let ((op (car opnds)))
       (case (car op)
         ((reg)
          (let ((id (reg-op-id op)) (ext? (reg-op-ext? op)))
            (list (append (if ext? '(65) '()) (list (+ 80 (modulo id 8)))) #f)))
         ((imm)
          (let ((val (cadr op)))
            (if (and (>= val -128) (<= val 127))
                (list (list 106 (modulo (if (< val 0) (+ val 256) val) 256)) #f)
                (list (cons 104 (split-u32-le val)) #f))))
         ((mem rel-sym)
          ;; push mem: FF /6
          (let ((enc (encode-modrm-sib-disp #f (list 0 8 #f) op)))
            (let* ((modrm (car (enc-modrm enc)))
                   (modrm-ext (+ (+ (modulo modrm 8) 48) (modulo (quotient modrm 64) 4)))) ;; /6 = opcode ext 6 (6<<3 = 48)
              (list (asm-flatten (list (enc-rex enc) (list 255 modrm-ext) (enc-sib enc) (enc-disp enc))) #f))))
         (else
          (list '(144) #f)))))

    ((pop)
     (let ((op (car opnds)))
       (case (car op)
         ((reg)
          (let ((id (reg-op-id op)) (ext? (reg-op-ext? op)))
            (list (append (if ext? '(65) '()) (list (+ 88 (modulo id 8)))) #f)))
         ((mem rel-sym)
          ;; pop mem: 8F /0
          (let ((enc (encode-modrm-sib-disp #f (list 0 8 #f) op)))
            (list (asm-flatten (list (enc-rex enc) (list 143) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
         (else
          (list '(144) #f)))))

    ((call)
     (let ((op (car opnds)))
       (case (car op)
         ((reg)
          ;; call reg: FF /2
          (let ((id (reg-op-id op)) (ext? (reg-op-ext? op)))
            (list (append (if ext? '(65) '()) (list 255 (make-modrm 3 2 id))) #f)))
         (else
          ;; call rel32: E8 cd
          (let ((sym (reloc-sym op)) (addend (reloc-addend op)))
            (list '(232 0 0 0 0)
                  (list 'rel32 (+ curr-off 1) sym addend)))))))

    ((jmp)
     (let ((op (car opnds)))
       (case (car op)
         ((reg)
          ;; jmp reg: FF /4
          (let ((id (reg-op-id op)) (ext? (reg-op-ext? op)))
            (list (append (if ext? '(65) '()) (list 255 (make-modrm 3 4 id))) #f)))
         (else
          ;; Check if backward local label in .text is within rel8 [-128, +127]: jmp rel8 = EB cb
          (let* ((sym (reloc-sym op))
                 (addend (reloc-addend op))
                 (sym-pair (if (and sym-map (= addend 0)) (symbol-map-get sym-map sym) #f))
                 (sym-val (if sym-pair (cdr sym-pair) #f))
                 (disp8 (if (and sym-val (eq? (car sym-val) 'text))
                            (- (cadr sym-val) (+ curr-off 2))
                            #f)))
            (if (and disp8 (>= disp8 -128) (<= disp8 127))
                (list (list 235 (modulo (if (< disp8 0) (+ disp8 256) disp8) 256)) #f)
                ;; jmp rel32: E9 cd
                (list '(233 0 0 0 0)
                      (list 'rel32 (+ curr-off 1) sym addend))))))))

    ;; Conditional Jumps: jcc label -> 70+cc rel8 (backward short) or 0F 80+cc rel32 (near)
    ((je jz jne jnz jl jle jg jge jb jbe ja jae jnc js jns jp jpe jnp jpo)
     (let* ((cc-code (case mnem
                       ((je jz) 132)
                       ((jne jnz) 133)
                       ((jb) 130)
                       ((jae jnc) 131)
                       ((jbe) 134)
                       ((ja) 135)
                       ((js) 136)
                       ((jns) 137)
                       ((jp jpe) 138)
                       ((jnp jpo) 139)
                       ((jl) 140)
                       ((jge) 141)
                       ((jle) 142)
                       ((jg) 143)
                       (else 132)))
            (op (car opnds))
            (sym (reloc-sym op))
            (addend (reloc-addend op))
            (sym-pair (if (and sym-map (= addend 0)) (symbol-map-get sym-map sym) #f))
            (sym-val (if sym-pair (cdr sym-pair) #f))
            (disp8 (if (and sym-val (eq? (car sym-val) 'text))
                       (- (cadr sym-val) (+ curr-off 2))
                       #f)))
       (if (and disp8 (>= disp8 -128) (<= disp8 127))
           (list (list (- cc-code 16) (modulo (if (< disp8 0) (+ disp8 256) disp8) 256)) #f)
           (list (list 15 cc-code 0 0 0 0)
                 (list 'rel32 (+ curr-off 2) sym addend)))))

    ;; Condition Set: setcc r8 -> 0F 90+cc ModR/M
    ((seto sete setz setne setnz setl setge setle setg setb setbe seta setae setp setpe setnp setpo)
     (let* ((cc-code (case mnem
                       ((seto) 144)
                       ((sete setz) 148)
                       ((setne setnz) 149)
                       ((setb) 146)
                       ((setae) 147)
                       ((setbe) 150)
                       ((seta) 151)
                       ((setp setpe) 154)
                       ((setnp setpo) 155)
                       ((setl) 156)
                       ((setge) 157)
                       ((setle) 158)
                       ((setg) 159)
                       (else 148)))
            (dst (car opnds))
            (d-info (lookup-x86-reg (cadr dst)))
            (d-id (caddr dst))
            (d-ext? (reg-ext? d-info))
            (d-rex? (reg-rex? d-info)))
       (list (append (if (or d-ext? d-rex?)
                         (list (make-rex #f #f #f d-ext?))
                         '())
                     (list 15 cc-code (make-modrm 3 0 d-id)))
             #f)))

    ;; Conditional Move: cmovcc r64, r64/mem -> REX.W 0F 40+cc ModR/M
    ((cmove cmovz cmovne cmovnz cmovl cmovle cmovg cmovge)
     (let* ((cc-code (case mnem
                       ((cmove cmovz) 68)
                       ((cmovne cmovnz) 69)
                       ((cmovl) 76)
                       ((cmovge) 77)
                       ((cmovle) 78)
                       ((cmovg) 79)
                       (else 68)))
            (dst (car opnds))
            (src (cadr opnds)))
       (case (car src)
         ((reg)
          (let* ((rex (make-rex #t (reg-ext? (lookup-x86-reg (cadr dst))) #f (reg-ext? (lookup-x86-reg (cadr src)))))
                 (modrm (make-modrm 3 (caddr dst) (caddr src))))
            (list (list rex 15 cc-code modrm) #f)))
         ((mem)
          (let ((enc (encode-modrm-sib-disp #t (lookup-x86-reg (cadr dst)) src)))
            (list (asm-flatten (list (enc-rex enc) (list 15 cc-code) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))))

    ;; MOVZX: movzx r32/r64, byte/word ptr [mem] / reg8 / reg16
    ((movzx)
     (let* ((dst (car opnds))
            (src (cadr opnds))
            (d-info (lookup-x86-reg (cadr dst))))
       (case (car src)
         ((mem)
          (let* ((opc2 (if (= (mem-size src) 2) 183 182))
                 (enc (encode-modrm-sib-disp #f d-info src))
                 (rip-sym (mem-rip-sym src)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (list (asm-flatten (list (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                      (list 'rip_disp32 (+ curr-off (length (asm-flatten (list (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc))))) rip-sym (mem-disp src) 0))
                (list (asm-flatten (list (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))
         (else
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (opc2 (if (= (reg-size s-info) 2) 183 182))
                 (rex (make-rex #f (reg-ext? d-info) #f (reg-ext? s-info))))
            (list (append (if (or (reg-ext? d-info) (reg-ext? s-info) (reg-rex? s-info)) (list rex) '())
                          (list 15 opc2 (make-modrm 3 (reg-id d-info) (reg-id s-info)))) #f))))))

    ;; MOVSX: movsx r64, byte/word ptr [mem] / reg8 / reg16
    ((movsx)
     (let* ((dst (car opnds))
            (src (cadr opnds))
            (d-info (lookup-x86-reg (cadr dst)))
            (w (= (reg-size d-info) 8)))
       (case (car src)
         ((mem)
          (let* ((opc2 (if (= (mem-size src) 2) 191 190))
                 (enc (encode-modrm-sib-disp w d-info src))
                 (rip-sym (mem-rip-sym src)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (list (asm-flatten (list (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                      (list 'rip_disp32 (+ curr-off (length (asm-flatten (list (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc))))) rip-sym (mem-disp src) 0))
                (list (asm-flatten (list (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))
         (else
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (opc2 (if (= (reg-size s-info) 2) 191 190))
                 (rex (make-rex w (reg-ext? d-info) #f (reg-ext? s-info))))
            (list (append (if (or w (reg-ext? d-info) (reg-ext? s-info) (reg-rex? s-info)) (list rex) '())
                          (list 15 opc2 (make-modrm 3 (reg-id d-info) (reg-id s-info)))) #f))))))

    ;; MOVSXD: movsxd r64, dword ptr [mem] / reg32
    ((movsxd)
     (let* ((dst (car opnds))
            (src (cadr opnds))
            (d-info (lookup-x86-reg (cadr dst))))
       (case (car src)
         ((mem)
          (let* ((enc (encode-modrm-sib-disp #t d-info src))
                 (rip-sym (mem-rip-sym src)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (list (asm-flatten (list (enc-rex enc) (list 99) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                      (list 'rip_disp32 (+ curr-off (length (asm-flatten (list (enc-rex enc) (list 99) (enc-modrm enc) (enc-sib enc))))) rip-sym (mem-disp src) 0))
                (list (asm-flatten (list (enc-rex enc) (list 99) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))
         (else
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (rex (make-rex #t (reg-ext? d-info) #f (reg-ext? s-info))))
            (list (list rex 99 (make-modrm 3 (reg-id d-info) (reg-id s-info))) #f))))))

    ;; LEA: lea r64, [mem]
    ((lea)
     (let* ((dst (car opnds))
            (raw-src (cadr opnds))
            (src (if (and (pair? raw-src) (eq? (car raw-src) 'rel-sym))
                     (list 'mem #f #f 1 0 8 (cadr raw-src))
                     raw-src))
            (d-info (lookup-x86-reg (cadr dst)))
            (enc (encode-modrm-sib-disp #t d-info src))
            (rip-sym (mem-rip-sym src)))
       (if (and rip-sym (not (string=? rip-sym "rip_disp")))
           (list (asm-flatten (list (enc-rex enc) (list 141) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                 (list 'rip_disp32 (+ curr-off (length (asm-flatten (list (enc-rex enc) (list 141) (enc-modrm enc) (enc-sib enc))))) rip-sym (mem-disp src) 0))
           (list (asm-flatten (list (enc-rex enc) (list 141) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))

    ;; Unified SSE2 Scalar/Packed FP & Bitwise Ops (movsd..orps)
    ((movsd movss movapd movaps movupd movups
      addsd addss subsd subss mulsd mulss divsd divss
      sqrtsd sqrtss ucomisd ucomiss cvtss2sd cvtsd2ss
      pxor xorpd xorps andpd andps orpd orps)
     (let* ((pfx (cond
                   ((memq mnem '(movsd addsd subsd mulsd divsd sqrtsd cvtsd2ss)) 242)
                   ((memq mnem '(movss addss subss mulss divss sqrtss cvtss2sd)) 243)
                   ((memq mnem '(ucomisd movapd movupd pxor xorpd andpd orpd)) 102)
                   (else #f)))
            (pfx-bytes (if pfx (list pfx) '()))
            (reg-opc (case mnem
                       ((movsd movss movupd movups) 16)
                       ((movapd movaps) 40)
                       ((ucomisd ucomiss) 46)
                       ((sqrtsd sqrtss) 81)
                       ((andpd andps) 84)
                       ((orpd orps) 86)
                       ((xorpd xorps) 87)
                       ((addsd addss) 88)
                       ((mulsd mulss) 89)
                       ((cvtss2sd cvtsd2ss) 90)
                       ((subsd subss) 92)
                       ((divsd divss) 94)
                       ((pxor) 239)))
            (store-opc (cond
                         ((memq mnem '(movsd movss movupd movups)) 17)
                         ((memq mnem '(movapd movaps)) 41)
                         (else #f)))
            (dst (car opnds))
            (src (cadr opnds)))
       (cond
         ;; op xmm, xmm -> [pfx] [REX] 0F opc /r
         ((and (eq? (car dst) 'reg) (eq? (car src) 'reg))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (s-info (lookup-x86-reg (cadr src)))
                 (need-rex? (or (reg-ext? d-info) (reg-ext? s-info)))
                 (rex (make-rex #f (reg-ext? d-info) #f (reg-ext? s-info)))
                 (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
            (list (asm-flatten (list pfx-bytes (if need-rex? (list rex) '()) (list 15 reg-opc modrm))) #f)))
         ;; op xmm, [mem] -> [pfx] [REX] 0F opc /r
         ((and (eq? (car dst) 'reg) (memq (car src) '(mem rel-sym)))
          (let ((d-info (lookup-x86-reg (cadr dst))))
            (asm-emit-sse2-modrm-mem pfx-bytes #f (list 15 reg-opc) d-info src curr-off)))
         ;; store [mem], xmm -> [pfx] [REX] 0F store-opc /r
         ((and store-opc (memq (car dst) '(mem rel-sym)) (eq? (car src) 'reg))
          (let ((s-info (lookup-x86-reg (cadr src))))
            (asm-emit-sse2-modrm-mem pfx-bytes #f (list 15 store-opc) s-info dst curr-off)))
         (else
          (list '(144) #f)))))

    ;; MOVQ / MOVD (32/64-bit transfer between GPR/mem/XMM)
    ((movq)
     (let ((dst (car opnds))
           (src (cadr opnds)))
       (cond
         ((and (eq? (car dst) 'reg) (eq? (car src) 'reg))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (s-info (lookup-x86-reg (cadr src)))
                 (d-xmm? (= (reg-size d-info) 16))
                 (s-xmm? (= (reg-size s-info) 16)))
            (cond
              ((and d-xmm? s-xmm?)
               ;; F3 [REX] 0F 7E /r (reg=dst, rm=src)
               (let ((need-rex? (or (reg-ext? d-info) (reg-ext? s-info)))
                     (rex (make-rex #f (reg-ext? d-info) #f (reg-ext? s-info)))
                     (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
                 (list (append (list 243) (append (if need-rex? (list rex) '()) (list 15 126 modrm))) #f)))
              (d-xmm?
               ;; 66 REX.W 0F 6E /r (reg=xmm, rm=r64)
               (let ((rex (make-rex #t (reg-ext? d-info) #f (reg-ext? s-info)))
                     (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
                 (list (list 102 rex 15 110 modrm) #f)))
              (else
               ;; 66 REX.W 0F 7E /r (reg=xmm(src), rm=r64(dst))
               (let ((rex (make-rex #t (reg-ext? s-info) #f (reg-ext? d-info)))
                     (modrm (make-modrm 3 (reg-id s-info) (reg-id d-info))))
                 (list (list 102 rex 15 126 modrm) #f))))))
         ((and (eq? (car dst) 'reg) (memq (car src) '(mem rel-sym)) (= (reg-op-size dst) 16))
          (asm-emit-sse2-modrm-mem '(243) #f '(15 126) (lookup-x86-reg (cadr dst)) src curr-off))
         ((and (memq (car dst) '(mem rel-sym)) (eq? (car src) 'reg) (= (reg-op-size src) 16))
          (asm-emit-sse2-modrm-mem '(102) #f '(15 214) (lookup-x86-reg (cadr src)) dst curr-off))
         (else
          (list '(144) #f)))))

    ((movd)
     (let ((dst (car opnds))
           (src (cadr opnds)))
       (cond
         ((and (eq? (car dst) 'reg) (eq? (car src) 'reg))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (s-info (lookup-x86-reg (cadr src)))
                 (d-xmm? (= (reg-size d-info) 16))
                 (r-info (if d-xmm? d-info s-info))
                 (m-info (if d-xmm? s-info d-info))
                 (opc (if d-xmm? 110 126))
                 (need-rex? (or (reg-ext? r-info) (reg-ext? m-info)))
                 (rex (make-rex #f (reg-ext? r-info) #f (reg-ext? m-info)))
                 (modrm (make-modrm 3 (reg-id r-info) (reg-id m-info))))
            (list (append (list 102) (append (if need-rex? (list rex) '()) (list 15 opc modrm))) #f)))
         ((and (eq? (car dst) 'reg) (memq (car src) '(mem rel-sym)) (= (reg-op-size dst) 16))
          (asm-emit-sse2-modrm-mem '(102) #f '(15 110) (lookup-x86-reg (cadr dst)) src curr-off))
         ((and (memq (car dst) '(mem rel-sym)) (eq? (car src) 'reg) (= (reg-op-size src) 16))
          (asm-emit-sse2-modrm-mem '(102) #f '(15 126) (lookup-x86-reg (cadr src)) dst curr-off))
         (else
          (list '(144) #f)))))

    ;; CVTSI2SD / CVTTSD2SI / CVTSI2SS / CVTTSS2SI (F2/F3 [REX.W] 0F 2A/2C /r)
    ((cvtsi2sd cvttsd2si cvtsi2ss cvttss2si)
     (let* ((pfx (if (memq mnem '(cvtsi2ss cvttss2si)) 243 242))
            (to-int? (memq mnem '(cvttsd2si cvttss2si)))
            (opc (if to-int? 44 42))
            (dst (car opnds))
            (src (cadr opnds)))
       (cond
         ((and (eq? (car dst) 'reg) (eq? (car src) 'reg))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (s-info (lookup-x86-reg (cadr src)))
                 (w? (if to-int? (= (reg-size d-info) 8) (= (reg-size s-info) 8)))
                 (need-rex? (or w? (reg-ext? d-info) (reg-ext? s-info)))
                 (rex (make-rex w? (reg-ext? d-info) #f (reg-ext? s-info)))
                 (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
            (list (append (list pfx) (append (if need-rex? (list rex) '()) (list 15 opc modrm))) #f)))
         ((and (eq? (car dst) 'reg) (memq (car src) '(mem rel-sym)))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (w? (if to-int?
                         (= (reg-size d-info) 8)
                         (if (eq? (car src) 'mem) (not (= (mem-size src) 4)) #t))))
            (asm-emit-sse2-modrm-mem (list pfx) w? (list 15 opc) d-info src curr-off)))
         (else
          (list '(144) #f)))))

    ;; MOV
    ((mov)
     (let ((dst (car opnds))
           (src (cadr opnds)))
       (cond
         ;; mov reg, reg
         ((and (eq? (car dst) 'reg) (eq? (car src) 'reg))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (s-info (lookup-x86-reg (cadr src)))
                 (sz (reg-size d-info))
                 (w (= sz 8))
                 (pfx16 (if (= sz 2) '(102) '()))
                 (rex (make-rex w (reg-ext? s-info) #f (reg-ext? d-info)))
                 (modrm (make-modrm 3 (reg-id s-info) (reg-id d-info)))
                 (opc (if (= sz 1) 136 137)))
            (list (append pfx16
                          (append (if (or w (reg-ext? s-info) (reg-ext? d-info) (reg-rex? s-info) (reg-rex? d-info)) (list rex) '())
                                  (list opc modrm)))
                  #f)))

         ;; mov reg, imm
         ((and (eq? (car dst) 'reg) (eq? (car src) 'imm))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (val (cadr src))
                 (sz (reg-size d-info)))
            (cond
              ;; 8-bit reg: B0+rb imm8
              ((= sz 1)
               (let* ((rex (make-rex #f #f #f (reg-ext? d-info)))
                      (opc (+ 176 (modulo (reg-id d-info) 8))))
                 (list (append (if (or (reg-ext? d-info) (reg-rex? d-info)) (list rex) '())
                               (list opc (modulo (if (< val 0) (+ val 256) val) 256))) #f)))

              ;; 16-bit reg: 66 B8+rw imm16
              ((= sz 2)
               (let* ((rex (make-rex #f #f #f (reg-ext? d-info)))
                      (opc (+ 184 (modulo (reg-id d-info) 8))))
                 (list (cons 102
                             (append (if (reg-ext? d-info) (list rex) '())
                                     (cons opc (split-u16-le val))))
                       #f)))

              ;; 32-bit reg: B8+rd imm32
              ((= sz 4)
               (let* ((rex (make-rex #f #f #f (reg-ext? d-info)))
                      (opc (+ 184 (modulo (reg-id d-info) 8))))
                 (list (append (if (reg-ext? d-info) (list rex) '())
                               (cons opc (split-u32-le val))) #f)))

              ;; 64-bit reg:
              ((let ((q (quotient val 4)))
                 (and (>= q -536870912) (<= q 536870911)))
               ;; 32-bit sign-extended: REX.W C7 /0 imm32
               (let* ((rex (make-rex #t #f #f (reg-ext? d-info)))
                      (modrm (make-modrm 3 0 (reg-id d-info))))
                 (list (cons rex (cons 199 (cons modrm (split-u32-le val)))) #f)))

              (else
               ;; 64-bit full imm: REX.W B8+rd imm64
               (let ((rex (make-rex #t #f #f (reg-ext? d-info))))
                 (list (cons rex (cons (+ 184 (modulo (reg-id d-info) 8)) (split-u64-le val))) #f))))))

         ;; mov reg, [mem]
         ((and (eq? (car dst) 'reg) (eq? (car src) 'mem))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (dsz (reg-size d-info))
                 (sz (mem-size src))
                 (pfx16 (if (or (= dsz 2) (= sz 2)) '(102) '()))
                 (w (= dsz 8))
                 (enc (encode-modrm-sib-disp w d-info src))
                 (opc (if (= dsz 1) 138 139))
                 (rip-sym (mem-rip-sym src)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (let ((head-len (+ (length pfx16) (length (asm-flatten (list (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc)))))))
                  (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                        (list 'rip_disp32 (+ curr-off head-len) rip-sym (mem-disp src) 0)))
                (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))

         ;; mov [mem], reg
         ((and (eq? (car dst) 'mem) (eq? (car src) 'reg))
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (ssz (reg-size s-info))
                 (sz (mem-size dst))
                 (pfx16 (if (or (= ssz 2) (= sz 2)) '(102) '()))
                 (w (= ssz 8))
                 (enc (encode-modrm-sib-disp w s-info dst))
                 (opc (if (= ssz 1) 136 137))
                 (rip-sym (mem-rip-sym dst)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (let ((head-len (+ (length pfx16) (length (asm-flatten (list (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc)))))))
                  (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                        (list 'rip_disp32 (+ curr-off head-len) rip-sym (mem-disp dst) 0)))
                (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))

         ;; mov [mem], imm
         ((and (eq? (car dst) 'mem) (eq? (car src) 'imm))
          (let* ((val (cadr src))
                 (sz (mem-size dst))
                 (w (= sz 8)))
            (cond
              ((= sz 1)
               ;; byte ptr: C6 /0 imm8
               (let ((enc (encode-modrm-sib-disp #f (list 0 1 #f) dst)))
                 (list (asm-flatten (list (enc-rex enc) (list 198) (enc-modrm enc) (enc-sib enc) (enc-disp enc) (list (modulo (if (< val 0) (+ val 256) val) 256)))) #f)))
              ((= sz 2)
               ;; word ptr: 66 C7 /0 imm16
               (let ((enc (encode-modrm-sib-disp #f (list 0 2 #f) dst)))
                 (list (asm-flatten (list (list 102) (enc-rex enc) (list 199) (enc-modrm enc) (enc-sib enc) (enc-disp enc) (split-u16-le val))) #f)))
              (else
               ;; qword/dword ptr: [REX.W] C7 /0 imm32
               (let ((enc (encode-modrm-sib-disp w (list 0 8 #f) dst)))
                 (list (asm-flatten (list (enc-rex enc) (list 199) (enc-modrm enc) (enc-sib enc) (enc-disp enc) (split-u32-le val))) #f))))))
         (else
          (list '(144) #f)))))

    ;; ADD, SUB, AND, OR, XOR, CMP
    ((add sub and or xor cmp)
     (let* ((dst (car opnds))
            (src (cadr opnds))
            (ext-op (case mnem ((add) 0) ((or) 1) ((and) 4) ((sub) 5) ((xor) 6) ((cmp) 7)))
            (base-op (case mnem ((add) 1) ((or) 9) ((and) 33) ((sub) 41) ((xor) 49) ((cmp) 57))))
       (cond
         ;; op r64/r32, r64/r32
         ((and (eq? (car dst) 'reg) (eq? (car src) 'reg))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (s-info (lookup-x86-reg (cadr src)))
                 (w (= (reg-size d-info) 8))
                 (rex (make-rex w (reg-ext? s-info) #f (reg-ext? d-info)))
                 (modrm (make-modrm 3 (reg-id s-info) (reg-id d-info))))
            (list (append (if (or w (reg-ext? s-info) (reg-ext? d-info)) (list rex) '())
                          (list base-op modrm))
                  #f)))

         ;; op r64, imm
         ((and (eq? (car dst) 'reg) (eq? (car src) 'imm))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (val (cadr src))
                 (rex (make-rex #t #f #f (reg-ext? d-info))))
            (if (and (>= val -128) (<= val 127))
                ;; 83 /ext imm8
                (list (list rex 131 (make-modrm 3 ext-op (reg-id d-info))
                            (modulo (if (< val 0) (+ val 256) val) 256)) #f)
                ;; 81 /ext imm32
                (list (append (list rex 129 (make-modrm 3 ext-op (reg-id d-info)))
                              (split-u32-le val)) #f))))

         ;; op r64, [mem]
         ((and (eq? (car dst) 'reg) (eq? (car src) 'mem))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (sz (mem-size src))
                 (w (= (reg-size d-info) 8))
                 (enc (encode-modrm-sib-disp w d-info src))
                 (opc (+ base-op 2))
                 (rip-sym (mem-rip-sym src)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (list (asm-flatten (list (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                      (list 'rip_disp32 (+ curr-off (length (asm-flatten (list (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc))))) rip-sym (mem-disp src) 0))
                (list (asm-flatten (list (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))

         ;; op [mem], reg
         ((and (eq? (car dst) 'mem) (eq? (car src) 'reg))
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (ssz (reg-size s-info))
                 (sz (mem-size dst))
                 (pfx16 (if (or (= ssz 2) (= sz 2)) '(102) '()))
                 (w (= ssz 8))
                 (enc (encode-modrm-sib-disp w s-info dst))
                 (opc (if (= ssz 1) (- base-op 1) base-op))
                 (rip-sym (mem-rip-sym dst)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (let ((head-len (+ (length pfx16) (length (asm-flatten (list (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc)))))))
                  (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) '(0 0 0 0)))
                        (list 'rip_disp32 (+ curr-off head-len) rip-sym (mem-disp dst) 0)))
                (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f))))

         ;; op [mem], imm (add, sub, and, or, xor, cmp)
         ((and (memq mnem '(add sub and or xor cmp)) (eq? (car dst) 'mem) (eq? (car src) 'imm))
          (let* ((val (cadr src))
                 (sz (mem-size dst))
                 (w (= sz 8))
                 (enc (encode-modrm-sib-disp w (list ext-op 8 #f) dst))
                 (fits8? (and (>= val -128) (<= val 127)))
                 (opc (cond ((= sz 1) 128) (fits8? 131) (else 129)))
                 (pfx16 (if (= sz 2) '(102) '()))
                 (imm-bytes (cond ((= sz 1) (list (modulo (if (< val 0) (+ val 256) val) 256)))
                                  (fits8? (list (modulo (if (< val 0) (+ val 256) val) 256)))
                                  (else (split-u32-le val))))
                 (rip-sym (mem-rip-sym dst)))
            (if (and rip-sym (not (string=? rip-sym "rip_disp")))
                (let ((head-len (+ (length pfx16) (length (asm-flatten (list (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc)))))))
                  (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) '(0 0 0 0) imm-bytes))
                        (list 'rip_disp32 (+ curr-off head-len) rip-sym (mem-disp dst) (length imm-bytes))))
                (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc) imm-bytes)) #f))))

         (else
          (list '(144) #f)))))

    ;; BT: bt r64, r64 -> REX.W 0F A3 /r
    ((bt)
     (let* ((dst (car opnds))
            (src (cadr opnds))
            (d-info (lookup-x86-reg (cadr dst)))
            (s-info (lookup-x86-reg (cadr src)))
            (rex (make-rex #t (reg-ext? s-info) #f (reg-ext? d-info)))
            (modrm (make-modrm 3 (modulo (reg-id s-info) 8) (modulo (reg-id d-info) 8))))
       (list (list rex 15 163 modrm) #f)))

    ;; TEST: test r64, r64 -> REX.W 85 /r, test r64, imm -> REX.W F7 /0 imm32
    ((test)
     (let* ((dst (car opnds))
            (src (cadr opnds))
            (d-info (lookup-x86-reg (cadr dst))))
       (case (car src)
         ((reg)
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (sz (reg-size d-info))
                 (w (= sz 8))
                 (rex (make-rex w (reg-ext? s-info) #f (reg-ext? d-info)))
                 (opc (if (= sz 1) 132 133))
                 (modrm (make-modrm 3 (reg-id s-info) (reg-id d-info))))
            (list (append (if (or w (reg-ext? s-info) (reg-ext? d-info) (= sz 1)) (list rex) '())
                          (list opc modrm)) #f)))
         ((imm)
          (let* ((val (cadr src))
                 (sz (reg-size d-info))
                 (w (= sz 8))
                 (rex (make-rex w #f #f (reg-ext? d-info))))
            (if (= sz 1)
                (list (append (if (reg-ext? d-info) (list rex) '())
                              (list 246 (make-modrm 3 0 (reg-id d-info))
                                    (modulo (if (< val 0) (+ val 256) val) 256))) #f)
                (list (append (list rex 247 (make-modrm 3 0 (reg-id d-info)))
                              (split-u32-le val)) #f))))
         (else
          (list '(144) #f)))))

    ;; IMUL: imul r64, r64/mem -> REX.W 0F AF /r, imul r64, imm -> REX.W 6B/69, imul r64, r64, imm -> REX.W 6B/69
    ((imul)
     (cond
       ;; 3-operand: imul dst, src, imm
       ((pair? (cddr opnds))
        (let* ((dst (car opnds))
               (src (cadr opnds))
               (imm-op (caddr opnds))
               (d-info (lookup-x86-reg (cadr dst)))
               (s-info (lookup-x86-reg (cadr src)))
               (val (cadr imm-op))
               (rex (make-rex #t (reg-ext? d-info) #f (reg-ext? s-info)))
               (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
          (if (and (>= val -128) (<= val 127))
              (list (list rex 107 modrm (modulo (if (< val 0) (+ val 256) val) 256)) #f)
              (list (append (list rex 105 modrm) (split-u32-le val)) #f))))

       ;; 2-operand
       (else
        (let* ((dst (car opnds))
               (src (cadr opnds))
               (d-info (lookup-x86-reg (cadr dst))))
          (case (car src)
            ((reg)
             (let* ((s-info (lookup-x86-reg (cadr src)))
                    (rex (make-rex #t (reg-ext? d-info) #f (reg-ext? s-info)))
                    (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
               (list (list rex 15 175 modrm) #f)))
            ((mem)
             (let ((enc (encode-modrm-sib-disp #t d-info src)))
               (list (asm-flatten (list (enc-rex enc) (list 15 175) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
            ((imm)
             (let* ((val (cadr src))
                    (rex (make-rex #t (reg-ext? d-info) #f (reg-ext? d-info)))
                    (modrm (make-modrm 3 (reg-id d-info) (reg-id d-info))))
               (if (and (>= val -128) (<= val 127))
                   (list (list rex 107 modrm (modulo (if (< val 0) (+ val 256) val) 256)) #f)
                   (list (append (list rex 105 modrm) (split-u32-le val)) #f))))
            (else
             (list '(144) #f)))))))

    ;; IDIV, DIV: REX.W F7 /7 (idiv), F7 /6 (div)
    ((idiv div)
     (let* ((ext (if (eq? mnem 'idiv) 7 6))
            (op (car opnds))
            (r-info (lookup-x86-reg (cadr op)))
            (rex (make-rex #t #f #f (reg-ext? r-info)))
            (modrm (make-modrm 3 ext (reg-id r-info))))
       (list (list rex 247 modrm) #f)))

    ;; SHL, SHR, SAR: REX.W C1 /ext imm8, D1 /ext (by 1), D3 /ext (by cl)
    ((shl shr sar)
     (let* ((ext (case mnem ((shl) 4) ((shr) 5) ((sar) 7)))
            (dst (car opnds))
            (d-info (lookup-x86-reg (if (pair? dst) (cadr dst) dst)))
            (rex (make-rex #t #f #f (reg-ext? d-info)))
            (src (if (pair? (cdr opnds)) (cadr opnds) '(imm 1))))
       (cond
         ((and (pair? src) (eq? (car src) 'reg) (let ((rn (cadr src))) (or (equal? rn 'cl) (equal? rn "cl") (equal? rn '%cl) (equal? rn "%cl"))))
          ;; by CL: REX.W D3 /ext
          (list (list rex 211 (make-modrm 3 ext (reg-id d-info))) #f))
         ((and (pair? src) (eq? (car src) 'imm))
          (let ((imm (cadr src)))
            (if (= imm 1)
                (list (list rex 209 (make-modrm 3 ext (reg-id d-info))) #f)
                (list (list rex 193 (make-modrm 3 ext (reg-id d-info)) (modulo (if (< imm 0) (+ imm 256) imm) 256)) #f))))
         (else
          (list (list rex 209 (make-modrm 3 ext (reg-id d-info))) #f)))))

    ;; NEG, NOT: REX.W F7 /3 (neg), F7 /2 (not)
    ((neg not)
     (let* ((ext (if (eq? mnem 'neg) 3 2))
            (op (car opnds))
            (r-info (lookup-x86-reg (cadr op)))
            (rex (make-rex #t #f #f (reg-ext? r-info)))
            (modrm (make-modrm 3 ext (reg-id r-info))))
       (list (list rex 247 modrm) #f)))

    ;; INC, DEC: [66] [REX] FE/FF /0 (inc), FE/FF /1 (dec) on reg or mem
    ((inc dec)
     (let ((ext (if (eq? mnem 'inc) 0 1))
           (op (car opnds)))
       (cond
         ((op-is-reg? op)
          (let* ((r-info (lookup-x86-reg (cadr op)))
                 (sz (reg-size r-info))
                 (w (= sz 8))
                 (opc (if (= sz 1) 254 255))
                 (pfx16 (if (= sz 2) '(102) '()))
                 (need-rex? (or w (reg-ext? r-info) (reg-rex? r-info)))
                 (rex (make-rex w #f #f (reg-ext? r-info)))
                 (modrm (make-modrm 3 ext (reg-id r-info))))
            (list (asm-flatten (list pfx16 (if need-rex? (list rex) '()) (list opc modrm))) #f)))
         ((op-is-mem? op)
          (let* ((sz (mem-size op))
                 (w (= sz 8))
                 (opc (if (= sz 1) 254 255))
                 (pfx16 (if (= sz 2) '(102) '()))
                 (enc (encode-modrm-sib-disp w (list ext 8 #f) op)))
            (list (asm-flatten (list pfx16 (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
         (else (list '(144) #f)))))

    ;; BSF / BSR r64/32, r/m64/32: [REX] 0F BC/BD /r
    ((bsf bsr)
     (let* ((opc2 (if (eq? mnem 'bsf) 188 189))
            (dst (car opnds))
            (src (cadr opnds))
            (d-info (lookup-x86-reg (cadr dst)))
            (w (= (reg-size d-info) 8)))
       (cond
         ((op-is-reg? src)
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (need-rex? (or w (reg-ext? d-info) (reg-ext? s-info)))
                 (rex (make-rex w (reg-ext? d-info) #f (reg-ext? s-info)))
                 (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
            (list (append (if need-rex? (list rex) '()) (list 15 opc2 modrm)) #f)))
         ((op-is-mem? src)
          (let ((enc (encode-modrm-sib-disp w d-info src)))
            (list (asm-flatten (list (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
         (else (list '(144) #f)))))

    ;; PCMPEQD xmm, xmm/m128: 66 [REX] 0F 76 /r
    ((pcmpeqd)
     (let ((dst (car opnds)) (src (cadr opnds)))
       (if (and (op-is-reg? dst) (op-is-reg? src))
           (let* ((d-info (lookup-x86-reg (cadr dst)))
                  (s-info (lookup-x86-reg (cadr src)))
                  (need-rex? (or (reg-ext? d-info) (reg-ext? s-info)))
                  (rex (make-rex #f (reg-ext? d-info) #f (reg-ext? s-info)))
                  (modrm (make-modrm 3 (reg-id d-info) (reg-id s-info))))
             (list (asm-flatten (list '(102) (if need-rex? (list rex) '()) (list 15 118 modrm))) #f))
           (let ((d-info (lookup-x86-reg (cadr dst))))
             (asm-emit-sse2-modrm-mem '(102) #f '(15 118) d-info src curr-off)))))

    ;; PSRLQ / PSLLQ xmm, imm8: 66 [REX] 0F 73 /2 imm8 (/6 imm8)
    ((psrlq psllq)
     (let* ((ext (if (eq? mnem 'psrlq) 2 6))
            (dst (car opnds))
            (src (cadr opnds))
            (d-info (lookup-x86-reg (cadr dst)))
            (imm8 (modulo (if (op-is-imm? src) (cadr src) 0) 256))
            (rex (make-rex #f #f #f (reg-ext? d-info)))
            (modrm (make-modrm 3 ext (reg-id d-info))))
       (list (asm-flatten (list '(102) (if (reg-ext? d-info) (list rex) '()) (list 15 115 modrm imm8))) #f)))

    ;; MFENCE / LFENCE / SFENCE / PAUSE / CPUID / RDTSC / RDTSCP
    ((mfence)
     (list '(15 174 240) #f))
    ((lfence)
     (list '(15 174 232) #f))
    ((sfence)
     (list '(15 174 248) #f))
    ((pause)
     (list '(243 144) #f))
    ((cpuid)
     (list '(15 162) #f))
    ((rdtsc)
     (list '(15 49) #f))
    ((rdtscp)
     (list '(15 1 249) #f))

    ;; BSWAP r32/r64: [REX] 0F C8+rd
    ((bswap)
     (let* ((op (car opnds))
            (r-info (lookup-x86-reg (if (pair? op) (cadr op) op)))
            (sz (reg-size r-info))
            (w (= sz 8))
            (rid (modulo (reg-id r-info) 8))
            (opc (+ 200 rid)))
       (if (or w (reg-ext? r-info))
           (list (list (make-rex w #f #f (reg-ext? r-info)) 15 opc) #f)
           (list (list 15 opc) #f))))

    ;; XCHG r/m, r or r, r/m: [66] [REX] 86/87 /r
    ((xchg)
     (let ((op1 (car opnds))
           (op2 (cadr opnds)))
       (cond
         ((and (op-is-reg? op1) (op-is-reg? op2))
          (let* ((d-info (lookup-x86-reg (cadr op1)))
                 (s-info (lookup-x86-reg (cadr op2)))
                 (sz (reg-size d-info))
                 (w (= sz 8))
                 (opc (if (= sz 1) 134 135))
                 (need-rex? (or w (reg-ext? d-info) (reg-ext? s-info) (reg-rex? d-info) (reg-rex? s-info)))
                 (rex (make-rex w (reg-ext? s-info) #f (reg-ext? d-info)))
                 (modrm (make-modrm 3 (reg-id s-info) (reg-id d-info))))
            (list (append (if (= sz 2) '(102) '())
                          (append (if need-rex? (list rex) '())
                                  (list opc modrm)))
                  #f)))
         ((and (op-is-mem? op1) (op-is-reg? op2))
          (let* ((r-info (lookup-x86-reg (cadr op2)))
                 (sz (reg-size r-info))
                 (opc (if (= sz 1) 134 135))
                 (enc (encode-modrm-sib-disp (= sz 8) r-info op1)))
            (list (asm-flatten (list (if (= sz 2) '(102) '()) (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
         ((and (op-is-reg? op1) (op-is-mem? op2))
          (let* ((r-info (lookup-x86-reg (cadr op1)))
                 (sz (reg-size r-info))
                 (opc (if (= sz 1) 134 135))
                 (enc (encode-modrm-sib-disp (= sz 8) r-info op2)))
            (list (asm-flatten (list (if (= sz 2) '(102) '()) (enc-rex enc) (list opc) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
         (else
          (list '(144) #f)))))

    ;; XADD r/m, r: [66] [REX] 0F C0/C1 /r
    ((xadd)
     (let ((dst (car opnds))
           (src (cadr opnds)))
       (cond
         ((and (op-is-reg? dst) (op-is-reg? src))
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (s-info (lookup-x86-reg (cadr src)))
                 (sz (reg-size d-info))
                 (w (= sz 8))
                 (opc2 (if (= sz 1) 192 193))
                 (need-rex? (or w (reg-ext? d-info) (reg-ext? s-info) (reg-rex? d-info) (reg-rex? s-info)))
                 (rex (make-rex w (reg-ext? s-info) #f (reg-ext? d-info)))
                 (modrm (make-modrm 3 (reg-id s-info) (reg-id d-info))))
            (list (append (if (= sz 2) '(102) '())
                          (append (if need-rex? (list rex) '())
                                  (list 15 opc2 modrm)))
                  #f)))
         ((and (op-is-mem? dst) (op-is-reg? src))
          (let* ((s-info (lookup-x86-reg (cadr src)))
                 (sz (reg-size s-info))
                 (opc2 (if (= sz 1) 192 193))
                 (enc (encode-modrm-sib-disp (= sz 8) s-info dst)))
            (list (asm-flatten (list (if (= sz 2) '(102) '()) (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
         (else
          (list '(144) #f)))))

    ;; CMPXCHG r/m, r: [66] [REX] 0F B0/B1 /r (supports 8/16/32/64-bit widths)
    ((cmpxchg)
     (let* ((dst (car opnds))
            (src (cadr opnds))
            (s-info (lookup-x86-reg (cadr src)))
            (sz (reg-size s-info))
            (w (= sz 8))
            (opc2 (if (= sz 1) 176 177))
            (pfx16 (if (= sz 2) '(102) '())))
       (case (car dst)
         ((mem)
          (let ((enc (encode-modrm-sib-disp w s-info dst)))
            (list (asm-flatten (list pfx16 (enc-rex enc) (list 15 opc2) (enc-modrm enc) (enc-sib enc) (enc-disp enc))) #f)))
         ((reg)
          (let* ((d-info (lookup-x86-reg (cadr dst)))
                 (need-rex? (or w (reg-ext? s-info) (reg-ext? d-info) (reg-rex? s-info) (reg-rex? d-info)))
                 (rex (make-rex w (reg-ext? s-info) #f (reg-ext? d-info)))
                 (modrm (make-modrm 3 (reg-id s-info) (reg-id d-info))))
            (list (asm-flatten (list pfx16 (if need-rex? (list rex) '()) (list 15 opc2 modrm))) #f)))
         (else
          (list '(144) #f)))))

    (else
     (list '(144) #f)))))

