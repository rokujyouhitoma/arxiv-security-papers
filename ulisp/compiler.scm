;;; Part 14: Hash-Consing Term DAG and Memoized Catamorphism (DSN-33-01 T5.2)
;;; -----------------------------------------------------------------------

;;; 14.1 Hash-Consing Constructor for Immutable S-expression Subterms
(define *nanopass-hash-cons-table* (cons '() '()))

(define (nanopass-hash-cons-reset!)
  (set-car! *nanopass-hash-cons-table* '()))

(define (nanopass-hash-cons a d)
  (let ((key (cons a d))
        (table (car *nanopass-hash-cons-table*)))
    (let ((existing (assoc key table)))
      (if existing
          (cdr existing)
          (let ((new-pair (cons a d)))
            (set-car! *nanopass-hash-cons-table*
                      (cons (cons key new-pair) table))
            new-pair)))))

(define (nanopass-hash-cons-list es)
  (if (null? es)
      '()
      (nanopass-hash-cons (car es) (nanopass-hash-cons-list (cdr es)))))

;;; 14.2 Scoped Term DAG Catamorphism Memoization (256-bucket O(1) hash table)
(define *nanopass-term-memo-bucket-count* 256)
(define *nanopass-term-memo-bucket-limit* 16)

(define (nanopass-make-term-memo-table)
  (make-vector *nanopass-term-memo-bucket-count* '()))

;; *nanopass-term-memo* stores (cons bucket-vector entry-count) for O(1) stats reporting.
(define *nanopass-term-memo* (cons (nanopass-make-term-memo-table) 0))
(define *nanopass-term-memo-enabled?* (cons #t '()))
(define *nanopass-term-memo-active?* (cons #f '()))
(define *nanopass-term-memo-stats* (cons 0 0)) ; (cons hits misses)

(define (nanopass-atom-hash x)
  (cond
    ((symbol? x) (symbol->hash-idx x))
    ((integer? x) (modulo (if (< x 0) (- 0 x) x) 1024))
    ((boolean? x) (if x 3 7))
    ((char? x) (modulo (char->integer x) 1024))
    ((null? x) 11)
    ((pair? x)
     (let ((a (car x)))
       (cond
         ((symbol? a) (+ 17 (symbol->hash-idx a)))
         ((and (pair? a) (symbol? (car a))) (+ 41 (* (symbol->hash-idx (car a)) 7)))
         (else 29))))
    (else 37)))

(define (nanopass-term-memo-bucket-idx node)
  (let* ((a (car node))
         (d (cdr node))
         (h1 (nanopass-atom-hash a))
         (h2 (if (pair? d) (nanopass-atom-hash (car d)) 13))
         (h3 (if (and (pair? d) (pair? (cdr d)))
                 (nanopass-atom-hash (cadr d))
                 19)))
    (modulo (+ h1 (+ (* h2 37) (* h3 131))) *nanopass-term-memo-bucket-count*)))

(define (enable-nanopass-term-memo!)
  (set-car! *nanopass-term-memo-enabled?* #t))

(define (disable-nanopass-term-memo!)
  (set-car! *nanopass-term-memo-enabled?* #f))

(define (nanopass-term-memo-reset!)
  (let ((tbl (car *nanopass-term-memo*)))
    (let loop ((i 0))
      (if (< i *nanopass-term-memo-bucket-count*)
          (begin
            (vector-set! tbl i '())
            (loop (+ i 1))))))
  (set-cdr! *nanopass-term-memo* 0)
  (set-car! *nanopass-term-memo-stats* 0)
  (set-cdr! *nanopass-term-memo-stats* 0))

(define (nanopass-term-memo-stats)
  (list (cons 'hits (car *nanopass-term-memo-stats*))
        (cons 'misses (cdr *nanopass-term-memo-stats*))
        (cons 'entries (cdr *nanopass-term-memo*))))

(define (nanopass-term-memo-hit-rate)
  (let ((hits (car *nanopass-term-memo-stats*))
        (misses (cdr *nanopass-term-memo-stats*)))
    (let ((total (+ hits misses)))
      (if (= total 0)
          0
          (quotient (* hits 100) total)))))

(define (with-nanopass-term-memo thunk)
  (let ((old-memo (car *nanopass-term-memo*))
        (old-count (cdr *nanopass-term-memo*))
        (old-active (car *nanopass-term-memo-active?*)))
    (set-car! *nanopass-term-memo* (nanopass-make-term-memo-table))
    (set-cdr! *nanopass-term-memo* 0)
    (set-car! *nanopass-term-memo-active?* #t)
    (let ((res (guard (ex (else
                            (set-car! *nanopass-term-memo* old-memo)
                            (set-cdr! *nanopass-term-memo* old-count)
                            (set-car! *nanopass-term-memo-active?* old-active)
                            (raise ex)))
                 (thunk))))
      (set-car! *nanopass-term-memo* old-memo)
      (set-cdr! *nanopass-term-memo* old-count)
      (set-car! *nanopass-term-memo-active?* old-active)
      res)))

(define (nanopass-memoize-step node transform-fn)
  (if (or (not (car *nanopass-term-memo-enabled?*))
          (not (car *nanopass-term-memo-active?*))
          (not (pair? node)))
      (transform-fn node)
      (let* ((tbl (car *nanopass-term-memo*))
             (b-idx (nanopass-term-memo-bucket-idx node))
             (bucket (vector-ref tbl b-idx))
             (hit (assq node bucket)))
        (if hit
            (begin
              (set-car! *nanopass-term-memo-stats* (+ (car *nanopass-term-memo-stats*) 1))
              (cdr hit))
            (begin
              (set-cdr! *nanopass-term-memo-stats* (+ (cdr *nanopass-term-memo-stats*) 1))
              (let* ((res (transform-fn node))
                     (cur-bucket (vector-ref tbl b-idx)))
                ;; Bound per-bucket chain depth so worst-case lookup stays O(1) on large ASTs.
                (if (< (length cur-bucket) *nanopass-term-memo-bucket-limit*)
                    (begin
                      (vector-set! tbl b-idx (cons (cons node res) cur-bucket))
                      (set-cdr! *nanopass-term-memo* (+ (cdr *nanopass-term-memo*) 1)))
                    (let loop ((cur cur-bucket) (i 1) (acc '()))
                      (if (or (null? cur) (>= i *nanopass-term-memo-bucket-limit*))
                          (vector-set! tbl b-idx (cons (cons node res) (reverse acc)))
                          (loop (cdr cur) (+ i 1) (cons (car cur) acc)))))
                res))))))

;;; =======================================================================
;;; Part 15: LIR Basic Block Data Dependency DAG & Reaching Store Forwarding (DSN-33-01 T5.3)
;;; =======================================================================

(define (lir-peephole-reg? opnd)
  (and (symbol? opnd)
       (case opnd
         ((%rax %rcx %rdx %rbx %rsp %rbp %rsi %rdi
           %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15)
          #t)
         (else
          (let ((s (symbol->string opnd)))
            (and (> (string-length s) 1)
                 (char=? (string-ref s 0) #\%)))))))

(define (lir-unconditional-terminator? inst)
  (and (pair? inst)
       (memq (car inst) '(%jump %direct-jump %return))))

(define (lir-label-inst? inst)
  (and (pair? inst)
       (memq (car inst) '(%label %block))))

(define (lir-reg-aliases? r1 r2)
  (or (equal? r1 r2)
      (and (eq? (current-target-arch) 'aarch64)
           (or (and (memq r1 '(%rax %rdi %al)) (memq r2 '(%rax %rdi %al)))
               (and (memq r1 '(%rbx %r12)) (memq r2 '(%rbx %r12)))))))

;;; -----------------------------------------------------------------------
;;; Shared %inline-asm Clause & Constraint Helpers (Issue #838)
;;; -----------------------------------------------------------------------
(define (inline-asm-inst? inst)
  (and (pair? inst) (eq? (car inst) '%inline-asm)))

(define (inline-asm-string-downcase s)
  (let* ((len (string-length s))
         (out (make-string len)))
    (let loop ((i 0))
      (if (< i len)
          (let* ((ch (string-ref s i))
                 (code (char->integer ch)))
            (string-set! out i
                         (if (and (>= code 65) (<= code 90))
                             (integer->char (+ code 32))
                             ch))
            (loop (+ i 1)))
          out))))

(define (inline-asm-parse-uint s)
  (let ((len (string-length s)))
    (if (= len 0)
        #f
        (let loop ((i 0) (acc 0))
          (if (= i len)
              acc
              (let ((c (char->integer (string-ref s i))))
                (if (and (>= c 48) (<= c 57))
                    (loop (+ i 1) (+ (* acc 10) (- c 48)))
                    #f)))))))

(define (inline-asm-normalize-reg-sym s)
  (cond
    ((and (pair? s) (eq? (car s) '%reg))
     (if (and (pair? (cdr s)) (pair? (cddr s)))
         (inline-asm-normalize-reg-sym (caddr s))
         (inline-asm-normalize-reg-sym (cadr s))))
    ((or (symbol? s) (string? s))
     (let* ((raw (inline-asm-string-downcase (if (symbol? s) (symbol->string s) s)))
            (len (string-length raw))
            (clean (if (and (> len 0) (char=? (string-ref raw 0) #\%))
                       (substring raw 1 len)
                       raw)))
       (cond
         ((or (string=? clean "rax") (string=? clean "eax") (string=? clean "ax") (string=? clean "al")) '%rax)
         ((or (string=? clean "rbx") (string=? clean "ebx") (string=? clean "bx") (string=? clean "bl")) '%rbx)
         ((or (string=? clean "rcx") (string=? clean "ecx") (string=? clean "cx") (string=? clean "cl")) '%rcx)
         ((or (string=? clean "rdx") (string=? clean "edx") (string=? clean "dx") (string=? clean "dl")) '%rdx)
         ((or (string=? clean "rsi") (string=? clean "esi") (string=? clean "si") (string=? clean "sil")) '%rsi)
         ((or (string=? clean "rdi") (string=? clean "edi") (string=? clean "di") (string=? clean "dil")) '%rdi)
         ((or (string=? clean "rbp") (string=? clean "ebp") (string=? clean "bp") (string=? clean "bpl")) '%rbp)
         ((or (string=? clean "rsp") (string=? clean "esp") (string=? clean "sp") (string=? clean "spl")) '%rsp)
         ((or (string=? clean "r8")  (string=? clean "r8d")  (string=? clean "r8w")  (string=? clean "r8b"))  '%r8)
         ((or (string=? clean "r9")  (string=? clean "r9d")  (string=? clean "r9w")  (string=? clean "r9b"))  '%r9)
         ((or (string=? clean "r10") (string=? clean "r10d") (string=? clean "r10w") (string=? clean "r10b")) '%r10)
         ((or (string=? clean "r11") (string=? clean "r11d") (string=? clean "r11w") (string=? clean "r11b")) '%r11)
         ((or (string=? clean "r12") (string=? clean "r12d") (string=? clean "r12w") (string=? clean "r12b")) '%r12)
         ((or (string=? clean "r13") (string=? clean "r13d") (string=? clean "r13w") (string=? clean "r13b")) '%r13)
         ((or (string=? clean "r14") (string=? clean "r14d") (string=? clean "r14w") (string=? clean "r14b")) '%r14)
         ((or (string=? clean "r15") (string=? clean "r15d") (string=? clean "r15w") (string=? clean "r15b")) '%r15)
         ((string=? clean "xmm0") '%xmm0) ((string=? clean "xmm1") '%xmm1)
         ((string=? clean "xmm2") '%xmm2) ((string=? clean "xmm3") '%xmm3)
         ((string=? clean "xmm4") '%xmm4) ((string=? clean "xmm5") '%xmm5)
         ((string=? clean "xmm6") '%xmm6) ((string=? clean "xmm7") '%xmm7)
         ((string=? clean "xmm8") '%xmm8) ((string=? clean "xmm9") '%xmm9)
         ((string=? clean "xmm10") '%xmm10) ((string=? clean "xmm11") '%xmm11)
         ((string=? clean "xmm12") '%xmm12) ((string=? clean "xmm13") '%xmm13)
         ((string=? clean "xmm14") '%xmm14) ((string=? clean "xmm15") '%xmm15)
         (else #f))))
    (else #f)))

(define (inline-asm-parse-braced-reg s)
  (let ((len (string-length s)))
    (if (and (>= len 3)
             (char=? (string-ref s 0) #\{)
             (char=? (string-ref s (- len 1)) #\}))
        (inline-asm-normalize-reg-sym (substring s 1 (- len 1)))
        #f)))

(define (inline-asm-parse-short-reg s)
  (cond
    ((string=? s "a") '%rax)
    ((string=? s "b") '%rbx)
    ((string=? s "c") '%rcx)
    ((string=? s "d") '%rdx)
    ((string=? s "S") '%rsi)
    ((string=? s "D") '%rdi)
    (else #f)))

(define (inline-asm-parse-output-constraint cstr)
  (if (not (and (string? cstr) (>= (string-length cstr) 2)))
      #f
      (let* ((c0 (string-ref cstr 0))
             (valid-prefix? (or (char=? c0 #\=) (char=? c0 #\+))))
        (if (not valid-prefix?)
            #f
            (let* ((rw? (char=? c0 #\+))
                   (raw-body (substring cstr 1 (string-length cstr)))
                   (body (if (and (> (string-length raw-body) 0)
                                  (char=? (string-ref raw-body 0) #\&))
                             (substring raw-body 1 (string-length raw-body))
                             raw-body))
                   (short-r (inline-asm-parse-short-reg body))
                   (braced-r (inline-asm-parse-braced-reg body)))
              (cond
                ((or (string=? body "r") (string=? body "q") (string=? body "rm") (string=? body "g")) (list '=any-reg rw?))
                ((string=? body "x") (list '=xmm rw?))
                ((string=? body "m") (list '=mem rw?))
                (short-r (list '=reg short-r rw?))
                (braced-r (list '=reg braced-r rw?))
                (else #f)))))))

(define (inline-asm-parse-input-constraint cstr num-outputs)
  (if (not (and (string? cstr) (>= (string-length cstr) 1)))
      #f
      (let ((short-r (inline-asm-parse-short-reg cstr))
            (braced-r (inline-asm-parse-braced-reg cstr))
            (tied-idx (inline-asm-parse-uint cstr)))
        (cond
          ((or (string=? cstr "r") (string=? cstr "q")
               (string=? cstr "ri") (string=? cstr "ir") (string=? cstr "r,i")
               (string=? cstr "rm") (string=? cstr "g"))
           '(any-reg))
          ((string=? cstr "x") '(xmm))
          ((string=? cstr "m") '(mem))
          ((or (string=? cstr "i") (string=? cstr "n")
               (string=? cstr "I") (string=? cstr "J") (string=? cstr "K"))
           '(imm))
          (short-r (list 'reg short-r))
          (braced-r (list 'reg braced-r))
          ((and tied-idx (< tied-idx num-outputs)) (list 'tied tied-idx))
          (else #f)))))

(define (inline-asm-parse-clobber item)
  (if (not (or (string? item) (symbol? item)))
      #f
      (let ((low (inline-asm-string-downcase (if (symbol? item) (symbol->string item) item))))
        (cond
          ((or (string=? low "cc") (string=? low "flags")) 'cc)
          ((string=? low "memory") 'memory)
          (else (inline-asm-normalize-reg-sym low))))))

(define (inline-asm-normalize-out-entry entry)
  (cond
    ((not (pair? entry)) #f)
    ((and (pair? (cdr entry)) (null? (cddr entry)))
     (list #f (car entry) (cadr entry)))
    ((and (pair? (cdr entry)) (pair? (cddr entry)) (null? (cdddr entry)))
     (list (car entry) (caddr entry) (cadr entry)))
    (else #f)))

(define (inline-asm-normalize-in-entry entry)
  (cond
    ((not (pair? entry)) #f)
    ((and (pair? (cdr entry)) (null? (cddr entry)))
     (list #f (car entry) (cadr entry)))
    ((and (pair? (cdr entry)) (pair? (cddr entry)) (null? (cdddr entry)))
     (list (car entry) (caddr entry) (cadr entry)))
    (else #f)))

(define (inline-asm-extract-clauses inst)
  (let ((template (if (pair? (cdr inst)) (cadr inst) ""))
        (clauses (if (pair? (cdr inst)) (cddr inst) '())))
    (let loop ((cs clauses) (outputs '()) (inputs '()) (clobbers '()) (volatile? #t))
      (if (null? cs)
          (list template outputs inputs clobbers volatile?)
          (let ((c (car cs)))
            (if (not (pair? c))
                (loop (cdr cs) outputs inputs clobbers volatile?)
                (case (car c)
                  ((:outputs)
                   (loop (cdr cs)
                         (if (and (pair? (cdr c)) (list? (cadr c))) (cadr c) outputs)
                         inputs clobbers volatile?))
                  ((:inputs)
                   (loop (cdr cs)
                         outputs
                         (if (and (pair? (cdr c)) (list? (cadr c))) (cadr c) inputs)
                         clobbers volatile?))
                  ((:clobbers)
                   (loop (cdr cs)
                         outputs inputs
                         (if (and (pair? (cdr c)) (list? (cadr c))) (cadr c) clobbers)
                         volatile?))
                  ((:volatile?)
                   (loop (cdr cs)
                         outputs inputs clobbers
                         (if (pair? (cdr c)) (cadr c) volatile?)))
                  (else
                   (loop (cdr cs) outputs inputs clobbers volatile?)))))))))

(define (lir-inline-asm-defines-reg? inst reg)
  (let* ((parsed (inline-asm-extract-clauses inst))
         (outs (cadr parsed))
         (ins (caddr parsed))
         (clobs (cadddr parsed))
         (num-outs (length outs)))
    (or
     (let oloop ((os outs))
       (if (null? os) #f
           (let ((no (inline-asm-normalize-out-entry (car os))))
             (if (not no)
                 (oloop (cdr os))
                 (let ((dst (cadr no))
                       (oc (inline-asm-parse-output-constraint (caddr no))))
                   (if (or (lir-reg-aliases? dst reg)
                           (and (symbol? reg)
                                (let ((nr (inline-asm-normalize-reg-sym dst)))
                                  (and nr (lir-reg-aliases? nr reg))))
                           (and oc (eq? (car oc) '=reg) (lir-reg-aliases? (cadr oc) reg)))
                       #t
                       (oloop (cdr os))))))))
     (let iloop ((is ins))
       (if (null? is) #f
           (let ((ni (inline-asm-normalize-in-entry (car is))))
             (if (not ni)
                 (iloop (cdr is))
                 (let ((ic (inline-asm-parse-input-constraint (caddr ni) num-outs)))
                   (if (and ic (eq? (car ic) 'reg) (lir-reg-aliases? (cadr ic) reg))
                       #t
                       (iloop (cdr is))))))))
     (let cloop ((cs clobs))
       (if (null? cs) #f
           (let ((cp (inline-asm-parse-clobber (car cs))))
             (if (and cp (not (eq? cp 'cc)) (not (eq? cp 'memory)) (lir-reg-aliases? cp reg))
                 #t
                 (cloop (cdr cs)))))))))

(define (lir-inline-asm-memory-barrier? inst)
  (let* ((parsed (inline-asm-extract-clauses inst))
         (outs (cadr parsed))
         (ins (caddr parsed))
         (clobs (cadddr parsed))
         (volatile? (car (cddddr parsed)))
         (num-outs (length outs)))
    (or volatile?
        (let cloop ((cs clobs))
          (cond ((null? cs) #f)
                ((eq? (inline-asm-parse-clobber (car cs)) 'memory) #t)
                (else (cloop (cdr cs)))))
        (let oloop ((os outs))
          (if (null? os) #f
              (let* ((no (inline-asm-normalize-out-entry (car os)))
                     (oc (and no (inline-asm-parse-output-constraint (caddr no)))))
                (if (and oc (eq? (car oc) '=mem)) #t (oloop (cdr os))))))
        (let iloop ((is ins))
          (if (null? is) #f
              (let* ((ni (inline-asm-normalize-in-entry (car is)))
                     (ic (and ni (inline-asm-parse-input-constraint (caddr ni) num-outs))))
                (if (and ic (eq? (car ic) 'mem)) #t (iloop (cdr is)))))))))

(define (inline-asm-canonical-gpr opnd)
  (let ((direct (inline-asm-normalize-reg-sym opnd)))
    (if direct
        direct
        (if (and (pair? opnd) (eq? (car opnd) '%reg) (pair? (cdr opnd)))
            (inline-asm-normalize-reg-sym (cadr opnd))
            #f))))

(define (inline-asm-collect-mem-bases opnd acc)
  (if (and (pair? opnd) (eq? (car opnd) '%mem) (pair? (cdr opnd)))
      (let ((br (inline-asm-canonical-gpr (cadr opnd))))
        (if (and br (not (eq? br '%rsp)) (not (memq br acc)))
            (cons br acc)
            acc))
      acc))

(define (inline-asm-xmm-pool)
  '(%xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15 %xmm6 %xmm7))

(define (inline-asm-first-free-xmm used)
  (let loop ((pool (inline-asm-xmm-pool)))
    (cond
      ((null? pool) #f)
      ((memq (car pool) used) (loop (cdr pool)))
      (else (car pool)))))

(define (inline-asm-gpr-pool)
  '(%r10 %r11 %rax %rcx %rdx %rsi %rdi %r8 %r9 %rbx %r13 %r14 %rbp %r15 %r12))

(define (inline-asm-first-free-gpr used)
  (let loop ((pool (inline-asm-gpr-pool)))
    (cond
      ((null? pool) #f)
      ((memq (car pool) used) (loop (cdr pool)))
      (else (car pool)))))

(define (inline-asm-dedup-regs regs)
  (let loop ((rs regs) (acc '()))
    (if (null? rs)
        (reverse acc)
        (let ((r (car rs)))
          (if (or (not (symbol? r)) (eq? r '%rsp) (memq r acc))
              (loop (cdr rs) acc)
              (loop (cdr rs) (cons r acc)))))))

;; Allocates physical carrier registers for %inline-asm operands.
;; Returns (list template out-plans in-plans clobbers volatile? used-regs),
;; where each out-plan is (list idx name dst rw? kind carrier raw-cstr)
;; and each in-plan is (list opnd-idx name src kind carrier tied-out-idx raw-cstr).
(define (inline-asm-allocate-plan inst)
  (let* ((parsed (inline-asm-extract-clauses inst))
         (template (car parsed))
         (outs (cadr parsed))
         (ins (caddr parsed))
         (raw-clobs (cadddr parsed))
         (volatile? (car (cddddr parsed)))
         (num-outs (length outs))
         (clobbers
          (let cloop ((cs raw-clobs) (acc '()))
            (if (null? cs)
                (reverse acc)
                (let ((cp (inline-asm-parse-clobber (car cs))))
                  (if cp (cloop (cdr cs) (cons cp acc)) (cloop (cdr cs) acc))))))
         (init-reserved
          (let loop-c ((cs clobbers)
                       (res (let loop-o ((os outs) (acc '()))
                              (if (null? os) acc
                                  (let ((no (inline-asm-normalize-out-entry (car os))))
                                    (if (not no)
                                        (loop-o (cdr os) acc)
                                        (let* ((dst (cadr no))
                                               (oc (inline-asm-parse-output-constraint (caddr no)))
                                               (acc1 (inline-asm-collect-mem-bases dst acc)))
                                          (if (and oc (eq? (car oc) '=reg) (not (memq (cadr oc) acc1)))
                                              (loop-o (cdr os) (cons (cadr oc) acc1))
                                              (loop-o (cdr os) acc1)))))))))
            (if (null? cs)
                (let loop-i ((is ins) (acc res))
                  (if (null? is) acc
                      (let ((ni (inline-asm-normalize-in-entry (car is))))
                        (if (not ni)
                            (loop-i (cdr is) acc)
                            (let* ((src (cadr ni))
                                   (ic (inline-asm-parse-input-constraint (caddr ni) num-outs))
                                   (acc1 (inline-asm-collect-mem-bases src acc)))
                              (if (and ic (eq? (car ic) 'reg) (not (memq (cadr ic) acc1)))
                                  (loop-i (cdr is) (cons (cadr ic) acc1))
                                  (loop-i (cdr is) acc1)))))))
                (let ((c (car cs)))
                  (if (and (symbol? c) (not (eq? c 'cc)) (not (eq? c 'memory)) (not (memq c res)))
                      (loop-c (cdr cs) (cons c res))
                      (loop-c (cdr cs) res))))))
         (out-res
          (let oloop ((os outs) (idx 0) (used init-reserved) (acc '()))
            (if (null? os)
                (cons (reverse acc) used)
                (let* ((no (inline-asm-normalize-out-entry (car os)))
                       (name (and no (car no)))
                       (dst (and no (cadr no)))
                       (cstr (if no (caddr no) "=r"))
                       (oc (inline-asm-parse-output-constraint cstr)))
                  (cond
                    ((not oc)
                     (error "Malformed output constraint in %inline-asm plan:" cstr))
                    ((eq? (car oc) '=reg)
                     (let* ((r (cadr oc))
                            (rw? (caddr oc))
                            (new-used (if (memq r used) used (cons r used))))
                       (oloop (cdr os) (+ idx 1) new-used
                              (cons (list idx name dst rw? 'reg r cstr) acc))))
                    ((eq? (car oc) '=mem)
                     (oloop (cdr os) (+ idx 1) used
                            (cons (list idx name dst (cadr oc) 'mem dst cstr) acc)))
                    ((eq? (car oc) '=xmm)
                     (let* ((rw? (cadr oc))
                            (x (inline-asm-first-free-xmm used)))
                       (if (not x)
                           (error "Exhausted XMM regs allocating %inline-asm output:" inst)
                           (oloop (cdr os) (+ idx 1) (cons x used)
                                  (cons (list idx name dst rw? 'reg x cstr) acc)))))
                    (else
                     (let* ((rw? (cadr oc))
                            (r (inline-asm-first-free-gpr used)))
                       (if (not r)
                           (error "Exhausted GPRs allocating %inline-asm output:" inst)
                           (oloop (cdr os) (+ idx 1) (cons r used)
                                  (cons (list idx name dst rw? 'reg r cstr) acc))))))))))
         (out-plans (car out-res))
         (used-after-outs (cdr out-res))
         (in-res
          (let iloop ((is ins) (idx num-outs) (used used-after-outs) (acc '()))
            (if (null? is)
                (cons (reverse acc) used)
                (let* ((ni (inline-asm-normalize-in-entry (car is)))
                       (name (and ni (car ni)))
                       (src (and ni (cadr ni)))
                       (cstr (if ni (caddr ni) "r"))
                       (ic (inline-asm-parse-input-constraint cstr num-outs)))
                  (cond
                    ((not ic)
                     (error "Malformed input constraint in %inline-asm plan:" cstr))
                    ((eq? (car ic) 'reg)
                     (let* ((r (cadr ic))
                            (new-used (if (memq r used) used (cons r used))))
                       (iloop (cdr is) (+ idx 1) new-used
                              (cons (list idx name src 'reg r #f cstr) acc))))
                    ((eq? (car ic) 'mem)
                     (iloop (cdr is) (+ idx 1) used
                            (cons (list idx name src 'mem src #f cstr) acc)))
                    ((eq? (car ic) 'imm)
                     (iloop (cdr is) (+ idx 1) used
                            (cons (list idx name src 'imm src #f cstr) acc)))
                    ((eq? (car ic) 'xmm)
                     (let ((x (inline-asm-first-free-xmm used)))
                       (if (not x)
                           (error "Exhausted XMM regs allocating %inline-asm input:" inst)
                           (iloop (cdr is) (+ idx 1) (cons x used)
                                  (cons (list idx name src 'reg x #f cstr) acc)))))
                    ((eq? (car ic) 'tied)
                     (let* ((t-idx (cadr ic))
                            (target-out (list-ref out-plans t-idx))
                            (t-kind (list-ref target-out 4))
                            (t-carrier (list-ref target-out 5)))
                       (iloop (cdr is) (+ idx 1) used
                              (cons (list idx name src 'tied
                                          (if (eq? t-kind 'reg) t-carrier (list-ref target-out 2))
                                          t-idx cstr)
                                    acc))))
                    (else
                     (let ((r (inline-asm-first-free-gpr used)))
                       (if (not r)
                           (error "Exhausted GPRs allocating %inline-asm input:" inst)
                           (iloop (cdr is) (+ idx 1) (cons r used)
                                  (cons (list idx name src 'reg r #f cstr) acc))))))))))
         (in-plans (car in-res))
         (all-used (inline-asm-dedup-regs
                    (append
                     (let collect-out ((ops out-plans) (acc '()))
                       (if (null? ops) acc
                           (if (eq? (list-ref (car ops) 4) 'reg)
                               (collect-out (cdr ops) (cons (list-ref (car ops) 5) acc))
                               (collect-out (cdr ops) acc))))
                     (append
                      (let collect-in ((ips in-plans) (acc '()))
                        (if (null? ips) acc
                            (let ((k (list-ref (car ips) 3))
                                  (c (list-ref (car ips) 4)))
                              (if (and (or (eq? k 'reg) (eq? k 'tied))
                                       (inline-asm-normalize-reg-sym c))
                                  (collect-in (cdr ips) (cons c acc))
                                  (collect-in (cdr ips) acc)))))
                      (let collect-clob ((cs clobbers) (acc '()))
                        (if (null? cs) acc
                            (if (and (symbol? (car cs)) (not (eq? (car cs) 'cc)) (not (eq? (car cs) 'memory)))
                                (collect-clob (cdr cs) (cons (car cs) acc))
                                (collect-clob (cdr cs) acc)))))))))
    (list template out-plans in-plans clobbers volatile? all-used)))

(define (inline-asm-reg->sized-str reg mod-ch)
  (let ((nr (inline-asm-normalize-reg-sym reg)))
    (if (not nr)
        (if (symbol? reg) (symbol->string reg) "rax")
        (cond
          ((or (not mod-ch) (char=? mod-ch #\q) (char=? mod-ch #\c) (char=? mod-ch #\n))
           (case nr
             ((%rax) "rax") ((%rbx) "rbx") ((%rcx) "rcx") ((%rdx) "rdx")
             ((%rsi) "rsi") ((%rdi) "rdi") ((%rbp) "rbp") ((%rsp) "rsp")
             ((%r8) "r8")   ((%r9) "r9")   ((%r10) "r10") ((%r11) "r11")
             ((%r12) "r12") ((%r13) "r13") ((%r14) "r14") ((%r15) "r15")
             (else (let ((s (symbol->string nr)))
                     (if (and (> (string-length s) 0) (char=? (string-ref s 0) #\%))
                         (substring s 1 (string-length s))
                         s)))))
          ((char=? mod-ch #\k)
           (case nr
             ((%rax) "eax") ((%rbx) "ebx") ((%rcx) "ecx") ((%rdx) "edx")
             ((%rsi) "esi") ((%rdi) "edi") ((%rbp) "ebp") ((%rsp) "esp")
             ((%r8) "r8d")  ((%r9) "r9d")  ((%r10) "r10d") ((%r11) "r11d")
             ((%r12) "r12d") ((%r13) "r13d") ((%r14) "r14d") ((%r15) "r15d")
             (else "eax")))
          ((char=? mod-ch #\w)
           (case nr
             ((%rax) "ax")  ((%rbx) "bx")  ((%rcx) "cx")  ((%rdx) "dx")
             ((%rsi) "si")  ((%rdi) "di")  ((%rbp) "bp")  ((%rsp) "sp")
             ((%r8) "r8w")  ((%r9) "r9w")  ((%r10) "r10w") ((%r11) "r11w")
             ((%r12) "r12w") ((%r13) "r13w") ((%r14) "r14w") ((%r15) "r15w")
             (else "ax")))
          ((or (char=? mod-ch #\b) (char=? mod-ch #\l))
           (case nr
             ((%rax) "al")  ((%rbx) "bl")  ((%rcx) "cl")  ((%rdx) "dl")
             ((%rsi) "sil") ((%rdi) "dil") ((%rbp) "bpl") ((%rsp) "spl")
             ((%r8) "r8b")  ((%r9) "r9b")  ((%r10) "r10b") ((%r11) "r11b")
             ((%r12) "r12b") ((%r13) "r13b") ((%r14) "r14b") ((%r15) "r15b")
             (else "al")))
          ((char=? mod-ch #\h)
           (case nr
             ((%rax) "ah") ((%rbx) "bh") ((%rcx) "ch") ((%rdx) "dh")
             (else (inline-asm-reg->sized-str nr #\b))))
          (else (inline-asm-reg->sized-str nr #f))))))

(define (inline-asm-format-mem-opnd opnd mod-ch mem-ptr-map idx)
  (let* ((ptr-entry (and mem-ptr-map (assv idx mem-ptr-map)))
         (size-prefix
          (cond
            ((not mod-ch) "")
            ((char=? mod-ch #\b) "byte ptr ")
            ((char=? mod-ch #\l) "byte ptr ")
            ((char=? mod-ch #\w) "word ptr ")
            ((char=? mod-ch #\k) "dword ptr ")
            ((char=? mod-ch #\q) "qword ptr ")
            (else ""))))
    (if ptr-entry
        (string-append size-prefix "[" (inline-asm-reg->sized-str (cdr ptr-entry) #f) "]")
        (let* ((base (if (and (pair? opnd) (eq? (car opnd) '%stack)) '%rsp (cadr opnd)))
               (off (if (and (pair? opnd) (eq? (car opnd) '%stack)) (cadr opnd) (caddr opnd)))
               (base-str (inline-asm-reg->sized-str base #f))
               (off-str (cond
                          ((integer? off)
                           (cond
                             ((= off 0) "")
                             ((> off 0) (string-append " + " (number->string off)))
                             (else (string-append " - " (number->string (- 0 off))))))
                          ((symbol? off) (string-append " + " (symbol->string off)))
                          (else ""))))
          (string-append size-prefix "[" base-str off-str "]")))))

(define (inline-asm-format-operand-by-idx idx mod-ch out-plans in-plans mem-ptr-map)
  (let ((num-outs (length out-plans)))
    (if (< idx num-outs)
        (let* ((op (list-ref out-plans idx))
               (kind (list-ref op 4))
               (carrier (list-ref op 5)))
          (if (eq? kind 'reg)
              (inline-asm-reg->sized-str carrier mod-ch)
              (inline-asm-format-mem-opnd (list-ref op 2) mod-ch mem-ptr-map idx)))
        (let* ((ip (list-ref in-plans (- idx num-outs)))
               (kind (list-ref ip 3))
               (carrier (list-ref ip 4)))
          (case kind
            ((reg) (inline-asm-reg->sized-str carrier mod-ch))
            ((imm) (number->string (if (integer? carrier) carrier 0)))
            ((mem) (inline-asm-format-mem-opnd (list-ref ip 2) mod-ch mem-ptr-map idx))
            ((tied)
             (let ((t-idx (list-ref ip 5)))
               (inline-asm-format-operand-by-idx t-idx mod-ch out-plans in-plans mem-ptr-map)))
            (else "0"))))))

(define (inline-asm-find-named-idx nm out-plans in-plans)
  (let oloop ((ops out-plans))
    (if (not (null? ops))
        (if (eq? (list-ref (car ops) 1) nm)
            (list-ref (car ops) 0)
            (oloop (cdr ops)))
        (let iloop ((ips in-plans))
          (if (null? ips)
              #f
              (if (eq? (list-ref (car ips) 1) nm)
                  (list-ref (car ips) 0)
                  (iloop (cdr ips))))))))

(define (inline-asm-alnum? ch)
  (or (and (char>=? ch #\0) (char<=? ch #\9))
      (and (char>=? ch #\a) (char<=? ch #\z))
      (and (char>=? ch #\A) (char<=? ch #\Z))))

(define (inline-asm-match-reg-token str start)
  (let ((len (string-length str)))
    (let scan ((j start))
      (if (and (< j len) (inline-asm-alnum? (string-ref str j)))
          (scan (+ j 1))
          (if (> j start)
              (let ((tok (substring str start j)))
                (if (inline-asm-normalize-reg-sym tok) tok #f))
              #f)))))

;; Expands %inline-asm template placeholders.
;; mode: 'x86 (%% -> % for literal, %%reg -> reg) or 'c (%% -> %% for literal, %%reg -> reg).
(define (inline-asm-expand-template template out-plans in-plans mode mem-ptr-map)
  (let ((len (string-length template)))
    (let loop ((i 0) (acc '()))
      (if (>= i len)
          (let join ((xs (reverse acc)) (res ""))
            (if (null? xs) res (join (cdr xs) (string-append res (car xs)))))
          (let ((ch (string-ref template i)))
            (if (not (char=? ch #\%))
                (let scan-plain ((j (+ i 1)))
                  (if (and (< j len) (not (char=? (string-ref template j) #\%)))
                      (scan-plain (+ j 1))
                      (loop j (cons (substring template i j) acc))))
                (let ((c1 (if (< (+ i 1) len) (string-ref template (+ i 1)) #\space)))
                  (cond
                    ((char=? c1 #\%)
                     (let ((reg-tok (inline-asm-match-reg-token template (+ i 2))))
                       (if reg-tok
                           (loop (+ (+ i 2) (string-length reg-tok))
                                 (cons (inline-asm-string-downcase reg-tok) acc))
                           (loop (+ i 2)
                                 (cons (if (eq? mode 'c) "%%" "%") acc)))))
                    ((char=? c1 #\[)
                     (let find-close ((j (+ i 2)))
                       (if (or (>= j len) (char=? (string-ref template j) #\]))
                           (let* ((nm-str (if (< (+ i 2) j) (substring template (+ i 2) j) ""))
                                  (idx (inline-asm-find-named-idx (string->symbol nm-str) out-plans in-plans))
                                  (repl (if idx
                                            (inline-asm-format-operand-by-idx idx #f out-plans in-plans mem-ptr-map)
                                            (string-append "%[" nm-str "]"))))
                             (loop (if (< j len) (+ j 1) j) (cons repl acc)))
                           (find-close (+ j 1)))))
                    ((and (char>=? c1 #\0) (char<=? c1 #\9))
                     (let scan-idx ((j (+ i 1)) (idx 0))
                       (if (and (< j len) (char>=? (string-ref template j) #\0) (char<=? (string-ref template j) #\9))
                           (scan-idx (+ j 1) (+ (* idx 10) (- (char->integer (string-ref template j)) 48)))
                           (loop j (cons (inline-asm-format-operand-by-idx idx #f out-plans in-plans mem-ptr-map) acc)))))
                    ((and (< (+ i 2) len)
                          (memv c1 '(#\b #\w #\k #\q #\h #\l #\c #\n))
                          (let ((c2 (string-ref template (+ i 2))))
                            (or (and (char>=? c2 #\0) (char<=? c2 #\9))
                                (char=? c2 #\[))))
                     (if (char=? (string-ref template (+ i 2)) #\[)
                         (let find-close2 ((j (+ i 3)))
                           (if (or (>= j len) (char=? (string-ref template j) #\]))
                               (let* ((nm-str (if (< (+ i 3) j) (substring template (+ i 3) j) ""))
                                      (idx (inline-asm-find-named-idx (string->symbol nm-str) out-plans in-plans))
                                      (repl (if idx
                                                (inline-asm-format-operand-by-idx idx c1 out-plans in-plans mem-ptr-map)
                                                (string-append "%" (string c1) "[" nm-str "]"))))
                                 (loop (if (< j len) (+ j 1) j) (cons repl acc)))
                               (find-close2 (+ j 1))))
                         (let scan-idx2 ((j (+ i 2)) (idx 0))
                           (if (and (< j len) (char>=? (string-ref template j) #\0) (char<=? (string-ref template j) #\9))
                               (scan-idx2 (+ j 1) (+ (* idx 10) (- (char->integer (string-ref template j)) 48)))
                               (loop j (cons (inline-asm-format-operand-by-idx idx c1 out-plans in-plans mem-ptr-map) acc))))))
                    (else
                     (loop (+ i 1) (cons (if (eq? mode 'c) "%%" "%") acc)))))))))))

(define (inline-asm-trim-ws s)
  (let ((len (string-length s)))
    (let left ((i 0))
      (if (and (< i len) (memv (string-ref s i) '(#\space #\tab #\return #\newline)))
          (left (+ i 1))
          (let right ((j len))
            (if (and (> j i) (memv (string-ref s (- j 1)) '(#\space #\tab #\return #\newline)))
                (right (- j 1))
                (substring s i j)))))))

(define (inline-asm-split-lines expanded)
  (let ((len (string-length expanded)))
    (let loop ((i 0) (start 0) (acc '()))
      (if (>= i len)
          (let* ((last-chunk (inline-asm-trim-ws (substring expanded start len)))
                 (final (if (string=? last-chunk "") acc (cons last-chunk acc))))
            (reverse final))
          (let ((ch (string-ref expanded i)))
            (if (or (char=? ch #\newline) (char=? ch #\return) (char=? ch #\;))
                (let ((chunk (inline-asm-trim-ws (substring expanded start i))))
                  (loop (+ i 1) (+ i 1)
                        (if (or (string=? chunk "") (char=? (string-ref chunk 0) #\#))
                            acc
                            (cons chunk acc))))
                (loop (+ i 1) start acc)))))))

(define (lir-inst-defines-reg? inst reg)
  (and (pair? inst)
       (let ((op (car inst)))
         (case op
           ((%mov %load %load-byte-zx %pop %code-ref %str-ref %global-addr %not
             %add %raw-add %sub %raw-sub %imul %raw-mul
             %bit-and %bit-or %bit-xor %shl %shr %sar
             %box-fixnum %unbox-fixnum %neg %inc
             %alloc %alloc-stack %managed-alloc %managed-alloc-stack
             %fmov %fadd %fsub %fmul %fdiv
             %sitofp %fptosi %bitcast-f64-to-i64 %bitcast-i64-to-f64 %box-flonum %unbox-flonum
             %fcmp-ogt %fcmp-oge)
            (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg)))
           ((%global-ref %setb %setbe %seta %setae)
            (or (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))
                (lir-reg-aliases? reg '%r11)))
           ((%fcmp-oeq %fcmp-une)
            (or (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))
                (lir-reg-aliases? reg '%r10)
                (lir-reg-aliases? reg '%r11)))
           ((%fcmp-olt %fcmp-ole)
            (or (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))
                (lir-reg-aliases? reg '%xmm14)
                (lir-reg-aliases? reg '%xmm15)))
           ((%uitofp)
            (or (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))
                (memq reg '(%rcx %r9 %r10 %r11))))
           ((%fptoui)
            (or (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))
                (memq reg '(%r10 %r11 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15))))
           ((%fneg)
            (or (and (pair? (cdr inst))
                     (pair? (cddr inst))
                     (lir-reg-aliases? (caddr inst) reg))
                (lir-reg-aliases? reg '%r10)
                (lir-reg-aliases? reg '%r11)))
           ((%load-typed %fpext %fptrunc %trunc %zext %sext %managed-box %managed-unbox)
            (and (pair? (cdr inst))
                 (pair? (cddr inst))
                 (lir-reg-aliases? (caddr inst) reg)))
           ((%add-overflow %sub-overflow %mul-overflow)
            (and (pair? (cdr inst))
                 (or (lir-reg-aliases? (cadr inst) reg)
                     (and (pair? (cddr inst)) (lir-reg-aliases? (caddr inst) reg)))))
           ((%set-boolean)
            (or (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))
                (lir-reg-aliases? reg '%rax)))
           ((%cqo %idiv %udiv %urem)
            (or (lir-reg-aliases? reg '%rax)
                (lir-reg-aliases? reg '%rdx)
                (lir-reg-aliases? reg '%r11)
                (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))))
           ((%cmp %raw-cmp)
            (lir-reg-aliases? reg '%r11))
           ((%atomic-cas!)
            (or (and (pair? (cdr inst)) (lir-reg-aliases? (cadr inst) reg))
                (lir-reg-aliases? reg '%rax)))
           ((%c-call %call-foreign %call-closure %direct-call %call-indirect %dispatch-consumer)
            (or (case reg
                  ((%rax %rcx %rdx %rsi %rdi %r8 %r9 %r10 %r11 %al
                    %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
                    %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15)
                   #t)
                  (else #f))
                (and (eq? (current-target-arch) 'aarch64)
                     (or (lir-reg-aliases? reg '%rax) (lir-reg-aliases? reg '%rbx)))))
           ((%syscall)
            (or (case reg ((%rax %rcx %r11) #t) (else #f))
                (and (eq? (current-target-arch) 'aarch64) (lir-reg-aliases? reg '%rax))))
           ((%set-values-count)
            (lir-reg-aliases? reg '%rdx))
           ((%global-set!)
            (lir-reg-aliases? reg '%r11))
           ((%inline-asm)
            (lir-inline-asm-defines-reg? inst reg))
           (else #f)))))

(define (lir-inst-memory-barrier? inst)
  (and (pair? inst)
       (or (case (car inst)
             ((%c-call %call-foreign %call-closure %direct-call %call-indirect %dispatch-consumer
               %syscall %memory-fence %managed-safepoint-poll %push %pop %raise
               %capture-cc %push-handler %pop-handler
               %store-values-buf)
              #t)
             (else #f))
           (and (eq? (car inst) '%inline-asm)
                (lir-inline-asm-memory-barrier? inst)))))

(define (lir-inst-may-alias-stack-slot? inst off)
  (and (pair? inst)
       (case (car inst)
         ((%store %store-byte)
          (if (and (pair? (cdr inst)) (pair? (cddr inst)))
              (let ((base (cadr inst))
                    (soff (caddr inst)))
                (or (not (eq? base '%rsp))
                    (not (integer? soff))
                    (not (integer? off))
                    (< (abs (- soff off)) 8)))
              #t))
         ((%store-typed)
          (if (and (pair? (cdr inst)) (pair? (cddr inst)) (pair? (cdddr inst)))
              (let ((base (caddr inst))
                    (soff (cadddr inst)))
                (or (not (eq? base '%rsp))
                    (not (integer? soff))
                    (not (integer? off))
                    (< (abs (- soff off)) 8)))
              #t))
         ((%inline-asm)
          (let* ((parsed (inline-asm-extract-clauses inst))
                 (outs (cadr parsed)))
            (let oloop ((os outs))
              (if (null? os)
                  #f
                  (let* ((no (inline-asm-normalize-out-entry (car os)))
                         (dst (and no (cadr no))))
                    (if (or (and (pair? dst) (eq? (car dst) '%mem))
                            (and (pair? dst) (eq? (car dst) '%stack)
                                 (or (not (integer? (cadr dst)))
                                     (not (integer? off))
                                     (< (abs (- (cadr dst) off)) 8))))
                        #t
                        (oloop (cdr os))))))))
         ((%box-flonum %managed-write-barrier %atomic-cas!)
          #t)
         (else #f))))

(define (lir-inst-terminates-block? inst)
  (and (pair? inst)
       (memq (car inst) '(%jump %direct-jump %jump-cond %jump-if %jump-if-false %jump-if-zero
                          %switch %return %raise %label %block))))

(define (lir-skip-to-next-label insts)
  (cond
    ((null? insts) '())
    ((lir-label-inst? (car insts)) insts)
    (else (lir-skip-to-next-label (cdr insts)))))

;;; Distance-independent Store-Reload Forwarding across instructions in basic block
(define (lir-dag-try-forward-store off src rest)
  (let loop ((cur rest)
             (prefix '()))
    (cond
      ((null? cur) #f)
      (else
       (let* ((inst (car cur))
              (tail (cdr cur)))
         (cond
           ;; 1. Block terminator: stop scanning
           ((lir-inst-terminates-block? inst)
            #f)

           ;; 2. Memory barrier: stop scanning
           ((lir-inst-memory-barrier? inst)
            #f)

           ;; 3. Memory store / alias check (includes %store, %store-byte, %store-typed):
           ((lir-inst-may-alias-stack-slot? inst off)
            #f)

           ;; 4. Load from matching stack slot (%load dst %rsp off)
           ;; Safely replace %load with (%mov dst src).
           ;; If dst == src, rule-lir-self-mov-elim will eliminate it monotonically.
           ((and (pair? inst)
                 (eq? (car inst) '%load)
                 (= (length inst) 4)
                 (eq? (caddr inst) '%rsp)
                 (equal? (cadddr inst) off))
            (let ((dst (cadr inst)))
              (append (reverse prefix) (cons (list '%mov dst src) tail))))

           ;; 5. Did inst clobber src register? Stop scanning
           ((lir-inst-defines-reg? inst src)
            #f)

           ;; 6. General instruction not defining src or aliasing off: continue scanning
           (else
            (loop tail (cons inst prefix)))))))))

;;; Extract registers/stack slots used by instruction
(define (lir-inst-extract-uses inst)
  (if (not (pair? inst))
      '()
      (case (car inst)
        ((%store %store-byte)
         (let ((base (cadr inst)) (val (cadddr inst)))
           (cond
             ((and (eq? base '%rsp) (lir-peephole-reg? val)) (list val))
             ((lir-peephole-reg? base) (if (lir-peephole-reg? val) (list base val) (list base)))
             (else (if (lir-peephole-reg? val) (list val) '())))))
        ((%store-typed)
         (let ((base (caddr inst)) (val (car (cddddr inst))))
           (cond
             ((and (eq? base '%rsp) (lir-peephole-reg? val)) (list val))
             ((lir-peephole-reg? base) (if (lir-peephole-reg? val) (list base val) (list base)))
             (else (if (lir-peephole-reg? val) (list val) '())))))
        ((%load %load-byte-zx)
         (let ((base (caddr inst)) (off (cadddr inst)))
           (if (eq? base '%rsp)
               (list (list 'stack off))
               (if (lir-peephole-reg? base) (list base) '()))))
        ((%load-typed)
         (let ((base (cadddr inst)) (off (car (cddddr inst))))
           (if (eq? base '%rsp)
               (list (list 'stack off))
               (if (lir-peephole-reg? base) (list base) '()))))
        ((%mov %fmov %sitofp %uitofp %fptosi %fptoui %bitcast-f64-to-i64 %bitcast-i64-to-f64 %unbox-flonum)
         (let ((src (caddr inst)))
           (if (lir-peephole-reg? src) (list src) '())))
        ((%fneg %fpext %fptrunc %trunc %zext %sext)
         (let ((src (cadddr inst)))
           (if (lir-peephole-reg? src) (list src) '())))
        ((%add %raw-add %sub %raw-sub %imul %raw-mul %bit-and %bit-or %bit-xor %shl %sar
          %fadd %fsub %fmul %fdiv)
         (let ((dst (cadr inst)) (src (caddr inst)))
           (cond
             ((and (lir-peephole-reg? dst) (lir-peephole-reg? src)) (list dst src))
             ((lir-peephole-reg? dst) (list dst))
             ((lir-peephole-reg? src) (list src))
             (else '()))))
        ((%shr)
         (if (= (length inst) 4)
             (let ((src (caddr inst)) (cnt (cadddr inst)))
               (cond
                 ((and (lir-peephole-reg? src) (lir-peephole-reg? cnt)) (list src cnt))
                 ((lir-peephole-reg? src) (list src))
                 ((lir-peephole-reg? cnt) (list cnt))
                 (else '())))
             (let ((dst (cadr inst)) (cnt (caddr inst)))
               (cond
                 ((and (lir-peephole-reg? dst) (lir-peephole-reg? cnt)) (list dst cnt))
                 ((lir-peephole-reg? dst) (list dst))
                 ((lir-peephole-reg? cnt) (list cnt))
                 (else '())))))
        ((%cmp %raw-cmp %fcmp)
         (let ((op1 (cadr inst)) (op2 (caddr inst)))
           (cond
             ((and (lir-peephole-reg? op1) (lir-peephole-reg? op2)) (list op1 op2))
             ((lir-peephole-reg? op1) (list op1))
             ((lir-peephole-reg? op2) (list op2))
             (else '()))))
        ((%fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge)
         (let ((op1 (caddr inst)) (op2 (cadddr inst)))
           (cond
             ((and (lir-peephole-reg? op1) (lir-peephole-reg? op2)) (list op1 op2))
             ((lir-peephole-reg? op1) (list op1))
             ((lir-peephole-reg? op2) (list op2))
             (else '()))))
        ((%inline-asm)
         (let* ((parsed (inline-asm-extract-clauses inst))
                (ins (caddr parsed)))
           (let loop ((is ins) (acc '()))
             (if (null? is)
                 (reverse acc)
                 (let* ((ni (inline-asm-normalize-in-entry (car is)))
                        (src (and ni (cadr ni))))
                   (cond
                     ((not ni) (loop (cdr is) acc))
                     ((lir-peephole-reg? src) (loop (cdr is) (cons src acc)))
                     ((and (pair? src) (eq? (car src) '%stack)) (loop (cdr is) (cons (list 'stack (cadr src)) acc)))
                     (else (loop (cdr is) acc))))))))
        (else '()))))

;;; Extract registers/stack slots defined by instruction
(define (lir-inst-extract-defs inst)
  (if (not (pair? inst))
      '()
      (case (car inst)
        ((%store %store-byte)
         (let ((base (cadr inst)) (off (caddr inst)))
           (if (eq? base '%rsp)
               (list (list 'stack off))
               '())))
        ((%store-typed)
         (let ((base (caddr inst)) (off (cadddr inst)))
           (if (eq? base '%rsp)
               (list (list 'stack off))
               '())))
        ((%load %load-byte-zx %pop %code-ref %str-ref %global-ref %global-addr %not %set-boolean %alloc %alloc-stack
          %setb %setbe %seta %setae %fmov %sitofp %uitofp %fptosi %fptoui %bitcast-f64-to-i64 %bitcast-i64-to-f64
          %fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge
          %unbox-flonum %fadd %fsub %fmul %fdiv %managed-alloc %managed-alloc-stack)
         (if (lir-peephole-reg? (cadr inst)) (list (cadr inst)) '()))
        ((%load-typed %fneg %fpext %fptrunc %trunc %zext %sext)
         (if (lir-peephole-reg? (caddr inst)) (list (caddr inst)) '()))
        ((%add-overflow %sub-overflow %mul-overflow)
         (list (cadr inst) (caddr inst)))
        ((%udiv %urem)
         (if (= (length inst) 4)
             (list (cadr inst))
             '(%rax %rdx)))
        ((%mov)
         (let ((dst (cadr inst)))
           (if (symbol? dst)
               (list dst)
               (if (and (pair? dst) (eq? (car dst) '%stack))
                   (list (list 'stack (cadr dst)))
                   '()))))
        ((%add %raw-add %sub %raw-sub %imul %raw-mul %bit-and %bit-or %bit-xor %shl %shr %sar %neg %inc)
         (list (cadr inst)))
        ((%inline-asm)
         (let* ((parsed (inline-asm-extract-clauses inst))
                (outs (cadr parsed)))
           (let loop ((os outs) (acc '()))
             (if (null? os)
                 (reverse acc)
                 (let* ((no (inline-asm-normalize-out-entry (car os)))
                        (dst (and no (cadr no))))
                   (cond
                     ((not no) (loop (cdr os) acc))
                     ((symbol? dst) (loop (cdr os) (cons dst acc)))
                     ((and (pair? dst) (eq? (car dst) '%stack)) (loop (cdr os) (cons (list 'stack (cadr dst)) acc)))
                     (else (loop (cdr os) acc))))))))
        (else '()))))

;;; Build basic block data dependency DAG: (list 'lir-data-dag insts raw-edges waw-edges)
(define (lir-build-block-data-dag insts)
  (let loop ((cur insts)
             (idx 0)
             (reg-producers '())   ; ((reg . idx) ...)
             (stack-producers '()) ; ((off . idx) ...)
             (raw-edges '())       ; ((producer-idx . consumer-idx) ...)
             (waw-edges '()))      ; ((earlier-idx . later-idx) ...)
    (if (null? cur)
        (list 'lir-data-dag insts (reverse raw-edges) (reverse waw-edges))
        (let* ((inst (car cur))
               (tail (cdr cur)))
          (cond
            ((lir-inst-terminates-block? inst)
             (list 'lir-data-dag insts (reverse raw-edges) (reverse waw-edges)))
            ((lir-inst-memory-barrier? inst)
             (loop tail (+ idx 1) '() '() raw-edges waw-edges))
            (else
             (let* ((uses (lir-inst-extract-uses inst))
                    (defs (lir-inst-extract-defs inst))
                    (new-raw
                     (let u-loop ((us uses) (edges raw-edges))
                       (if (null? us)
                           edges
                           (let* ((u (car us))
                                  (prod (if (pair? u)
                                            (assoc (cadr u) stack-producers)
                                            (assoc u reg-producers))))
                             (if prod
                                 (u-loop (cdr us) (cons (cons (cdr prod) idx) edges))
                                 (u-loop (cdr us) edges))))))
                    (new-waw
                     (let d-loop ((ds defs) (edges waw-edges))
                       (if (null? ds)
                           edges
                           (let* ((d (car ds))
                                  (prod (if (pair? d)
                                            (assoc (cadr d) stack-producers)
                                            (assoc d reg-producers))))
                             (if prod
                                 (d-loop (cdr ds) (cons (cons (cdr prod) idx) edges))
                                 (d-loop (cdr ds) edges))))))
                    (new-reg-prods
                     (let r-up ((ds defs) (prods reg-producers))
                       (if (null? ds)
                           prods
                           (let ((d (car ds)))
                             (if (symbol? d)
                                 (r-up (cdr ds) (cons (cons d idx) (filter (lambda (p) (not (equal? (car p) d))) prods)))
                                 (r-up (cdr ds) prods))))))
                    (new-stack-prods
                     (let s-up ((ds defs) (prods stack-producers))
                       (if (null? ds)
                           prods
                           (let ((d (car ds)))
                             (if (and (pair? d) (eq? (car d) 'stack))
                                 (s-up (cdr ds) (cons (cons (cadr d) idx) (filter (lambda (p) (not (equal? (car p) (cadr d)))) prods)))
                                 (s-up (cdr ds) prods)))))))
               (loop tail (+ idx 1) new-reg-prods new-stack-prods new-raw new-waw))))))))

(define (lir-data-dag-insts dag) (cadr dag))
(define (lir-data-dag-raw-edges dag) (caddr dag))
(define (lir-data-dag-waw-edges dag) (cadddr dag))

;;; -----------------------------------------------------------------------
;;; Part 17: Pass-Level Analysis Contracts & Cache Registry Hooks (Issue #840)
;;; -----------------------------------------------------------------------

(define *pass-analysis-contracts* (cons '() '()))
(define *pass-proc-analysis-contracts* (cons '() '()))
(define *nanopass-pre-pass-analysis-hook* (cons #f '()))
(define *nanopass-post-pass-analysis-hook* (cons #f '()))

(define (normalize-analysis-spec-list spec)
  (cond
    ((or (not spec) (null? spec)) '())
    ((eq? spec 'all) '(all))
    ((and (pair? spec) (eq? (car spec) 'quote) (pair? (cdr spec)))
     (normalize-analysis-spec-list (cadr spec)))
    ((and (list? spec) (= (length spec) 1) (list? (car spec)))
     (car spec))
    ((list? spec) spec)
    (else (list spec))))

(define (alist-upsert-eq alist key val)
  (let loop ((rem alist) (acc '()) (found? #f))
    (cond
      ((null? rem)
       (let ((rev (reverse acc)))
         (if found? rev (cons (cons key val) rev))))
      ((eq? (caar rem) key)
       (loop (cdr rem) (cons (cons key val) acc) #t))
      (else
       (loop (cdr rem) (cons (car rem) acc) found?)))))

(define (register-pass-analysis-contract! pass-id requires preserves invalidates)
  (let* ((req-list (normalize-analysis-spec-list requires))
         (pres-list (if preserves (normalize-analysis-spec-list preserves) #f))
         (inv-list (normalize-analysis-spec-list invalidates))
         (contract (list pass-id req-list pres-list inv-list)))
    (set-car! *pass-analysis-contracts*
              (alist-upsert-eq (car *pass-analysis-contracts*) pass-id contract))
    contract))

(define (register-pass-proc-analysis-contract! proc pass-id requires preserves invalidates)
  (let ((contract (register-pass-analysis-contract! pass-id requires preserves invalidates)))
    (if (procedure? proc)
        (set-car! *pass-proc-analysis-contracts*
                  (alist-upsert-eq (car *pass-proc-analysis-contracts*) proc contract)))
    contract))

(define (lookup-pass-analysis-contract key)
  (cond
    ((symbol? key)
     (let ((e (assq key (car *pass-analysis-contracts*))))
       (if e (cdr e) #f)))
    ((procedure? key)
     (let ((e (assq key (car *pass-proc-analysis-contracts*))))
       (if e (cdr e) #f)))
    (else #f)))

(define (reset-pass-analysis-contracts!)
  (set-car! *pass-analysis-contracts* '())
  (set-car! *pass-proc-analysis-contracts* '()))

(define (nanopass-invoke-pre-pass-analysis! pass-id ir)
  (let ((hook (car *nanopass-pre-pass-analysis-hook*)))
    (if (and (not (nanopass-in-pipeline-runner?))
             (procedure? hook))
        (hook pass-id ir)
        #f)))

(define (nanopass-invoke-post-pass-analysis! pass-id in-ir out-ir)
  (let ((hook (car *nanopass-post-pass-analysis-hook*)))
    (if (and (not (nanopass-in-pipeline-runner?))
             (procedure? hook))
        (hook pass-id in-ir out-ir)
        #f)))




;;; =======================================================================
;;; ULisp Compiler: Nanopass Framework Core DSL (define-language / define-pass)
;;; Conforms to DSN-33 Architecture Specification & Keep & Dybvig (2013)
;;; =======================================================================

;;; Helper to parse header of define-pass
;;; (define-pass pass-name : L_in (ir extra_in ...) -> L_out (extra_out ...) body ...)
;;; or (define-pass pass-name : L_in (ir extra_in ...) -> * (extra_out ...) body ...)
;;; or (define-pass pass-name (ir extra_in ...) body ...)
;;; Also supports declarative analysis contracts (:requires ...), (:preserves ...), (:invalidates ...).
(define (nanopass-analysis-contract-clause? c)
  (and (pair? c)
       (memq (car c) '(:requires requires :preserves preserves :invalidates invalidates))))

(define (nanopass-analysis-contract-keyword? x)
  (and (symbol? x)
       (memq x '(:requires :preserves :invalidates))))

(define (nanopass-extract-analysis-contracts clauses)
  (let loop ((rem clauses)
             (clean-rev '())
             (has-contract? #f)
             (reqs '())
             (pres #f)
             (invs '()))
    (if (null? rem)
        (list (reverse clean-rev) has-contract? reqs pres invs)
        (let ((c (car rem)))
          (cond
            ((nanopass-analysis-contract-clause? c)
             (let ((tag (car c))
                   (vals (normalize-analysis-spec-list (cdr c))))
               (cond
                 ((memq tag '(:requires requires))
                  (loop (cdr rem) clean-rev #t (append reqs vals) pres invs))
                 ((memq tag '(:preserves preserves))
                  (let ((cur-pres (if pres pres '())))
                    (loop (cdr rem) clean-rev #t reqs (append cur-pres vals) invs)))
                 (else
                  (loop (cdr rem) clean-rev #t reqs pres (append invs vals))))))
            ((and (nanopass-analysis-contract-keyword? c) (pair? (cdr rem)))
             (let ((vals (normalize-analysis-spec-list (cadr rem))))
               (cond
                 ((eq? c ':requires)
                  (loop (cddr rem) clean-rev #t (append reqs vals) pres invs))
                 ((eq? c ':preserves)
                  (let ((cur-pres (if pres pres '())))
                    (loop (cddr rem) clean-rev #t reqs (append cur-pres vals) invs)))
                 (else
                  (loop (cddr rem) clean-rev #t reqs pres (append invs vals))))))
            (else
             (loop (cdr rem) (cons c clean-rev) has-contract? reqs pres invs)))))))

(define (nanopass-split-leading-contracts forms)
  (let loop ((rem forms) (c-rev '()))
    (cond
      ((null? rem) (cons (reverse c-rev) '()))
      ((nanopass-analysis-contract-clause? (car rem))
       (loop (cdr rem) (cons (car rem) c-rev)))
      ((and (nanopass-analysis-contract-keyword? (car rem)) (pair? (cdr rem)))
       (loop (cddr rem) (cons (list (car rem) (cadr rem)) c-rev)))
      (else (cons (reverse c-rev) rem)))))

(define (nanopass-parse-pass-header form)
  (let* ((name (cadr form))
         (rest (cddr form))
         (split (nanopass-split-leading-contracts rest))
         (leading-contracts (car split))
         (rest-after (cdr split)))
    (cond
      ((and (pair? rest-after) (eq? (car rest-after) ':))
       (let* ((l-in (cadr rest-after))
              (in-args (caddr rest-after))
              (in-arg-list (if (pair? in-args) in-args (list in-args)))
              (after-arrow (cddddr rest-after))
              (l-out (car after-arrow))
              (has-extra-out? (and (pair? (cdr after-arrow)) (list? (cadr after-arrow))))
              (extra-out (if has-extra-out? (cadr after-arrow) '()))
              (clauses (if has-extra-out? (cddr after-arrow) (cdr after-arrow))))
         (list name l-in in-arg-list l-out extra-out (append leading-contracts clauses))))
      ((and (pair? rest-after)
            (pair? (car rest-after))
            (not (nanopass-analysis-contract-clause? (car rest-after)))
            (not (memq (caar rest-after)
                       '(definitions entry fuse-rules fuse-tree-rules fuse-post-rules fuse-window-rules
                         Expr Stmt Program TopLevel Instruction InstructionList))))
       (let* ((in-args (car rest-after))
              (in-arg-list (if (pair? in-args) in-args (list in-args)))
              (clauses (cdr rest-after)))
         (list name 'L_src in-arg-list 'L_core '() (append leading-contracts clauses))))
      (else
       (list name 'L_src '(ir) 'L_core '() (append leading-contracts rest-after))))))

;;; Linearize pattern to handle duplicate variables (e.g. ((%mov ,r ,r) . ,rest))
(define (nanopass-linearize-pattern pat)
  (letrec ((walk
            (lambda (p seen extra-guards)
              (cond
                ((pair? p)
                 (if (eq? (car p) 'unquote)
                     (let ((sub (cadr p)))
                       (cond
                         ((symbol? sub)
                          (if (memq sub seen)
                              (let ((fresh (unique-symbol (string-append (symbol->raw-name sub) "_dup_"))))
                                (list (list 'unquote fresh)
                                      seen
                                      (cons (list 'equal? sub fresh) extra-guards)))
                              (list p (cons sub seen) extra-guards)))
                         (else (list p seen extra-guards))))
                     (let* ((car-res (walk (car p) seen extra-guards))
                            (new-car (car car-res))
                            (seen-car (cadr car-res))
                            (guards-car (caddr car-res))
                            (cdr-res (walk (cdr p) seen-car guards-car))
                            (new-cdr (car cdr-res))
                            (seen-cdr (cadr cdr-res))
                            (guards-cdr (caddr cdr-res)))
                       (list (cons new-car new-cdr) seen-cdr guards-cdr))))
                (else
                 (list p seen extra-guards))))))
    (let ((res (walk pat '() '())))
      (list (car res) (reverse (caddr res))))))

;;; Expand a single rule in a nonterminal transformer
(define (nanopass-expand-rule rule nt-name rule-name)
  (let* ((orig-pat (car rule))
         (rest (cdr rule))
         (has-guard? (and (pair? rest)
                          (pair? (car rest))
                          (eq? (car (car rest)) 'guard)))
         (orig-guard (if has-guard? (cadr (car rest)) #t))
         (raw-body (if has-guard?
                       (if (null? (cddr rest)) (cadr rest) (cons 'begin (cdr rest)))
                       (if (null? (cdr rest)) (car rest) (cons 'begin rest))))
         (lin (nanopass-linearize-pattern orig-pat))
         (pat (car lin))
         (extra-guards (cadr lin))
         (guard-expr
          (if (null? extra-guards)
              orig-guard
              (if (eq? orig-guard #t)
                  (if (= (length extra-guards) 1)
                      (car extra-guards)
                      (cons 'and extra-guards))
                  (cons 'and (append extra-guards (list orig-guard))))))
         (vars (nanopass-extract-pattern-vars pat))
         (body-expr (nanopass-expand-template raw-body vars)))
    (if rule-name
        (list pat vars guard-expr body-expr rule-name)
        (list pat vars guard-expr body-expr))))

;;; Bind matched pattern variables from list `m-var` without allocating a closure
(define (nanopass-var-ref-expr m-var idx)
  (cond
    ((= idx 0) (list 'car m-var))
    ((= idx 1) (list 'cadr m-var))
    ((= idx 2) (list 'caddr m-var))
    ((= idx 3) (list 'cadddr m-var))
    (else (list 'list-ref m-var idx))))

(define (nanopass-bind-matched-vars vars m-var body-expr)
  (if (null? vars)
      body-expr
      (list 'let
            (let loop ((vs vars) (i 0) (acc '()))
              (if (null? vs)
                  (reverse acc)
                  (loop (cdr vs) (+ i 1)
                        (cons (list (car vs) (nanopass-var-ref-expr m-var i)) acc))))
            body-expr)))

;;; Build cascaded if-expression for nonterminal transformer rules
(define (nanopass-rule-head-symbol pat)
  (cond
    ((not (pair? pat)) #f)
    ((eq? (car pat) 'unquote) #f)
    ((eq? (car pat) '_) #f)
    ((eq? (car pat) '...) #f)
    ((symbol? (car pat)) (car pat))
    (else #f)))

;;; Check if pattern can potentially match a pair
(define (nanopass-rule-can-match-pair? pat)
  (or (pair? pat) (eq? pat '_)))

;;; Check if pattern can potentially match an atom
(define (nanopass-rule-can-match-atom? pat)
  (or (not (pair? pat)) (eq? (car pat) 'unquote)))

;;; Append a rule into the appropriate tag bucket preserving tag & rule order
(define (nanopass-add-rule-to-bucket tag rule buckets)
  (let loop ((rem buckets) (acc '()))
    (cond
      ((null? rem)
       (append buckets (list (list tag rule))))
      ((eq? (caar rem) tag)
       (append (reverse acc)
               (cons (append (car rem) (list rule))
                     (cdr rem))))
      (else
       (loop (cdr rem) (cons (car rem) acc))))))

;;; Partition a list of expanded rules into:
;;; (list buckets pair-fallbacks atom-rules)
;;; where buckets is ((tag r1 r2 ...) ...)
(define (nanopass-partition-rules rules)
  (let loop ((rem rules)
             (buckets '())
             (pair-fallbacks '())
             (atom-rules '()))
    (if (null? rem)
        (list buckets (reverse pair-fallbacks) (reverse atom-rules))
        (let* ((r (car rem))
               (pat (car r))
               (tag (nanopass-rule-head-symbol pat)))
          (if tag
              (loop (cdr rem)
                    (nanopass-add-rule-to-bucket tag r buckets)
                    pair-fallbacks
                    atom-rules)
              (loop (cdr rem)
                    buckets
                    (if (nanopass-rule-can-match-pair? pat)
                        (cons r pair-fallbacks)
                        pair-fallbacks)
                    (if (nanopass-rule-can-match-atom? pat)
                        (cons r atom-rules)
                        atom-rules)))))))

;;; Compile a single expanded rule into an if-check with fallback.
;;; When loop-var and fuel-var are non-#f, performs Local Re-dispatch on rewritten nodes (DSN-33-01 T3.2).
(define (nanopass-unquote-var? pat)
  (and (pair? pat)
       (eq? (car pat) 'unquote)
       (pair? (cdr pat))
       (symbol? (cadr pat))
       (null? (cddr pat))))

(define (nanopass-direct-matchable-pattern? pat)
  (cond
    ((eq? pat '_) #t)
    ((symbol? pat) (not (eq? pat '...)))
    ((null? pat) #t)
    ((pair? pat)
     (cond
       ((eq? (car pat) 'unquote)
        (nanopass-unquote-var? pat))
       ((eq? (car pat) 'unquote-splicing) #f)
       ((and (pair? (cdr pat)) (eq? (cadr pat) '...)) #f)
       (else
        (and (nanopass-direct-matchable-pattern? (car pat))
             (nanopass-direct-matchable-pattern? (cdr pat))))))
    (else #t)))

(define (nanopass-compile-direct-pattern pat target-expr success-thunk)
  (let ((root-var (unique-symbol "__dpr_")))
    (letrec ((emit
              (lambda (p cur bound k)
                (cond
                  ((eq? p '_)
                   (k bound))
                  ((nanopass-unquote-var? p)
                   (let ((v (cadr p)))
                     (if (memq v bound)
                         (list 'if (list (string->symbol "equal?") cur v)
                               (k bound)
                               #f)
                         (list 'let (list (list v cur))
                               (k (cons v bound))))))
                  ((symbol? p)
                   (list 'if (list 'eq? cur (list 'quote p))
                         (k bound)
                         #f))
                  ((null? p)
                   (list 'if (list 'null? cur)
                         (k bound)
                         #f))
                  ((not (pair? p))
                   (list 'if (list (string->symbol "equal?") cur (list 'quote p))
                         (k bound)
                         #f))
                  (else
                   (let ((a-var (unique-symbol "__dpa_"))
                         (d-var (unique-symbol "__dpd_")))
                     (list 'if (list 'pair? cur)
                           (list 'let (list (list a-var (list 'car cur))
                                            (list d-var (list 'cdr cur)))
                                 (emit (car p) a-var bound
                                       (lambda (bound2)
                                         (emit (cdr p) d-var bound2 k))))
                           #f)))))))
      (list 'let (list (list root-var target-expr))
            (emit pat root-var '() (lambda (_bound) (success-thunk)))))))

(define (nanopass-compile-single-rule-cascade r ir-var nt-name fallback-expr loop-var fuel-var)
  (let* ((pat (car r))
         (vars (cadr r))
         (guard-expr (caddr r))
         (body-expr (cadddr r))
         (rule-name (if (pair? (cddddr r)) (car (cddddr r)) #f))
         (m-var (unique-symbol "__m_"))
         (direct? (nanopass-direct-matchable-pattern? pat))
         (body-with-firing
          (if rule-name
              (let ((res-val (unique-symbol "__rres_")))
                (list 'let (list (list res-val body-expr))
                      (list (string->symbol "record-picopass-firing!")
                            (list 'quote rule-name)
                            ir-var
                            res-val)
                      res-val))
              body-expr))
         (wrap-loop-result
          (lambda (val-expr)
            (if (and loop-var fuel-var)
                (let ((res-var (unique-symbol "__rw_")))
                  (list 'let (list (list res-var val-expr))
                        (list 'if (list 'or
                                        (list 'eq? res-var ir-var)
                                        (list (string->symbol "equal?") res-var ir-var))
                              res-var
                              (list loop-var res-var (list '- fuel-var 1)))))
                val-expr)))
         (cascade-core
          (cond
            (direct?
             (let* ((c-var (unique-symbol "__dc_"))
                    (match-expr
                     (nanopass-compile-direct-pattern
                      pat ir-var
                      (lambda ()
                        (if (eq? guard-expr #t)
                            (list 'cons #t body-with-firing)
                            (list 'if guard-expr
                                  (list 'cons #t body-with-firing)
                                  #f))))))
               (list 'let (list (list c-var match-expr))
                     (list 'if c-var
                           (wrap-loop-result (list 'cdr c-var))
                           fallback-expr))))
            ((eq? guard-expr #t)
             (list 'let (list (list m-var
                                    (list (string->symbol "nanopass-match-clause")
                                          (list 'quote pat)
                                          ir-var
                                          (list 'quote vars)
                                          nt-name)))
                   (list 'if m-var
                         (nanopass-bind-matched-vars vars m-var (wrap-loop-result body-with-firing))
                         fallback-expr)))
            (else
             (let ((c-var (unique-symbol "__c_")))
               (list 'let (list (list c-var
                                      (list 'let (list (list m-var
                                                             (list (string->symbol "nanopass-match-clause")
                                                                   (list 'quote pat)
                                                                   ir-var
                                                                   (list 'quote vars)
                                                                   nt-name)))
                                            (list 'if m-var
                                                  (nanopass-bind-matched-vars
                                                   vars m-var
                                                   (list 'if guard-expr
                                                         (list 'cons #t body-with-firing)
                                                         #f))
                                                  #f))))
                     (list 'if c-var
                           (wrap-loop-result (list 'cdr c-var))
                           fallback-expr)))))))
    (if rule-name
        (list 'if (list (string->symbol "picopass-enabled?") (list 'quote rule-name))
              cascade-core
              fallback-expr)
        cascade-core)))

;;; Compile a list of expanded rules sequentially with fallback-expr at the tail
(define (nanopass-compile-rule-list rs ir-var nt-name fallback-expr loop-var fuel-var)
  (let loop ((rem rs))
    (if (null? rem)
        fallback-expr
        (nanopass-compile-single-rule-cascade (car rem) ir-var nt-name (loop (cdr rem)) loop-var fuel-var))))

;;; Make catamorphism recursive call
(define (nanopass-make-catamorphism-call l-in l-out nt-name ir-var in-arg-list extra-out)
  (let ((extra-in (cdr in-arg-list)))
    (if (null? extra-in)
        (list (string->symbol "nanopass-catamorphism-step")
              (list 'quote l-in)
              (list 'quote l-out)
              (list 'quote nt-name)
              ir-var
              nt-name
              ''()
              (list 'quote extra-out))
        (list (string->symbol "nanopass-catamorphism-step")
              (list 'quote l-in)
              (list 'quote l-out)
              (list 'quote nt-name)
              ir-var
              nt-name
              (cons 'list extra-in)
              (list 'quote extra-out)))))

;;; Parse optional :order keyword from fuse-rules specification list.
;;; Returns (cons order-sym clean-specs) where order-sym is 'pre or 'post.
(define (nanopass-parse-fuse-rules-specs specs)
  (let ((flat (if (and (= (length specs) 1) (list? (car specs)))
                  (car specs)
                  specs)))
    (if (and (pair? flat)
             (pair? (cdr flat))
             (memq (car flat) '(:order order)))
        (let ((ord (cadr flat))
              (rest (cddr flat)))
          (if (or (eq? ord 'post) (eq? ord ':post) (equal? ord ''post))
              (cons 'post rest)
              (cons 'pre rest)))
        (cons 'pre flat))))

;;; Extract expanded clauses from a list of rule names or descriptors
(define (nanopass-extract-fused-clauses specs nt-name)
  (let ((flat-specs (cdr (nanopass-parse-fuse-rules-specs specs))))
    (let loop ((rem flat-specs) (acc '()))
      (if (null? rem)
          (reverse acc)
          (let* ((spec (car rem))
                 (desc (nanopass-lookup-rule spec))
                 (r-name (if desc (rule-name desc) (if (symbol? spec) spec #f)))
                 (clauses (if desc (rule-clauses desc) '())))
            (let ((tagged-clauses
                   (map (lambda (c)
                          (if (and r-name (null? (cddddr c)))
                              (append c (list r-name))
                              c))
                        clauses)))
              (loop (cdr rem) (append (reverse tagged-clauses) acc))))))))

;;; Extract head opcode from a window pattern, e.g. ((%mov ...) . ,rest) -> '%mov
(define (nanopass-window-rule-head-symbol pat)
  (cond
    ((not (pair? pat)) #f)
    ((pair? (car pat))
     (let ((first-inst (car pat)))
       (cond
         ((not (pair? first-inst)) #f)
         ((eq? (car first-inst) 'unquote) #f)
         ((eq? (car first-inst) '_) #f)
         ((symbol? (car first-inst)) (car first-inst))
         (else #f))))
    (else #f)))

;;; Extract expanded clauses for window rules from specs
(define (nanopass-extract-fused-window-rules specs)
  (let ((flat-specs (if (and (= (length specs) 1) (list? (car specs)))
                        (car specs)
                        specs)))
    (let loop ((rem flat-specs) (acc '()))
      (if (null? rem)
          (reverse acc)
          (let ((spec (car rem)))
            (cond
              ((symbol? spec)
               (let* ((desc (nanopass-lookup-rule spec))
                      (r-name (if desc (rule-name desc) spec))
                      (cls (if desc (rule-clauses desc) '())))
                 (let ((tagged-cls
                        (map (lambda (c)
                               (if (and r-name (null? (cddddr c)))
                                   (append c (list r-name))
                                   c))
                             cls)))
                   (loop (cdr rem) (append (reverse tagged-cls) acc)))))
              ((pair? spec)
               (let ((expanded (nanopass-expand-rule spec 'InstWindow #f)))
                 (loop (cdr rem) (cons expanded acc))))
              (else
               (loop (cdr rem) acc))))))))

;;; Partition window rules by head opcode symbol
(define (nanopass-partition-window-rules rules)
  (let loop ((rem rules)
             (buckets '())
             (fallbacks '()))
    (if (null? rem)
        (list buckets (reverse fallbacks))
        (let* ((r (car rem))
               (pat (car r))
               (tag (nanopass-window-rule-head-symbol pat)))
          (if tag
              (loop (cdr rem)
                    (nanopass-add-rule-to-bucket tag r buckets)
                    fallbacks)
              (loop (cdr rem)
                    buckets
                    (cons r fallbacks)))))))

;;; Compile a list of window rules into an if-check chain returning (cons #t new-insts) or fallback
(define (nanopass-compile-window-rule-chain rules insts-var fallback-expr)
  (if (null? rules)
      fallback-expr
      (let* ((r (car rules))
             (pat (car r))
             (vars (cadr r))
             (guard-expr (caddr r))
             (body-expr (cadddr r))
             (rule-name (if (pair? (cddddr r)) (car (cddddr r)) #f))
             (rest-chain (nanopass-compile-window-rule-chain (cdr rules) insts-var fallback-expr))
             (m-var (unique-symbol "__wm_"))
             (body-with-firing
              (if rule-name
                  (let ((rres (unique-symbol "__wr_")))
                    (list 'let (list (list rres body-expr))
                          (list (string->symbol "record-picopass-firing!")
                                (list 'quote rule-name)
                                insts-var
                                rres)
                          rres))
                  body-expr))
             (rule-core
              (if (nanopass-direct-matchable-pattern? pat)
                  (let ((wres-var (unique-symbol "__wres_"))
                        (success-expr
                         (if (eq? guard-expr #t)
                             (list 'cons #t body-with-firing)
                             (list 'if guard-expr
                                   (list 'cons #t body-with-firing)
                                   #f))))
                    (list 'let (list (list wres-var
                                           (nanopass-compile-direct-pattern
                                            pat insts-var (lambda () success-expr))))
                          (list 'if wres-var wres-var rest-chain)))
                  (if (eq? guard-expr #t)
                      (list 'let (list (list m-var
                                             (list (string->symbol "nanopass-match-clause")
                                                   (list 'quote pat)
                                                   insts-var
                                                   (list 'quote vars)
                                                   '(lambda (x) x))))
                            (list 'if m-var
                                  (nanopass-bind-matched-vars vars m-var (list 'cons #t body-with-firing))
                                  rest-chain))
                      (list 'let (list (list m-var
                                             (list (string->symbol "nanopass-match-clause")
                                                   (list 'quote pat)
                                                   insts-var
                                                   (list 'quote vars)
                                                   '(lambda (x) x))))
                            (list 'if m-var
                                  (nanopass-bind-matched-vars
                                   vars m-var
                                   (list 'if guard-expr
                                         (list 'cons #t body-with-firing)
                                         rest-chain))
                                  rest-chain))))))
        (if rule-name
            (list 'if (list (string->symbol "picopass-enabled?") (list 'quote rule-name))
                  rule-core
                  rest-chain)
            rule-core))))

;;; Build cascaded dispatch expression for window rules
(define (nanopass-build-window-rules-cascade rules insts-var)
  (let* ((partitioned (nanopass-partition-window-rules rules))
         (buckets (car partitioned))
         (fallbacks (cadr partitioned))
         (fallback-expr (nanopass-compile-window-rule-chain fallbacks insts-var #f)))
    (if (null? buckets)
        fallback-expr
        (let* ((first-inst-var (unique-symbol "__w_first_"))
               (op-var (unique-symbol "__w_op_"))
               (case-expr
                (cons 'case
                      (cons op-var
                            (append (map (lambda (b)
                                           (list (list (car b))
                                                 (nanopass-compile-window-rule-chain (cdr b) insts-var fallback-expr)))
                                         buckets)
                                    (list (list 'else fallback-expr)))))))
          (list 'if (list 'pair? insts-var)
                (list 'let (list (list first-inst-var (list 'car insts-var)))
                      (list 'if (list 'pair? first-inst-var)
                            (list 'let (list (list op-var (list 'car first-inst-var)))
                                  (list 'if (list 'symbol? op-var)
                                        case-expr
                                        fallback-expr))
                            fallback-expr))
                #f)))))

;;; Build procedure binding for window pass (InstructionList / Program transformer)
(define (nanopass-build-window-pass-binding specs entry-name in-arg-list)
  (let* ((rules (nanopass-extract-fused-window-rules specs))
         (ir-var (car in-arg-list))
         (insts-var (unique-symbol "__insts_"))
         (try-match-body (nanopass-build-window-rules-cascade rules insts-var))
         (try-match-proc (list 'lambda (list insts-var) try-match-body))
         (fixpoint-call (list (string->symbol "nanopass-sliding-window-fixpoint")
                              try-match-proc
                              insts-var))
         (opt-core-proc (list 'lambda (list insts-var) fixpoint-call))
         (body-expr (list (string->symbol "nanopass-wrap-window-rules-input")
                          opt-core-proc
                          ir-var)))
    (list entry-name (list 'lambda in-arg-list body-expr))))

;;; Flatten NT rules: inline (fuse-rules ...), (fuse-tree-rules ...), and (fuse-post-rules ...),
;;; and expand regular rules
(define (nanopass-flatten-nt-rules raw-rules nt-name)
  (let loop ((rem raw-rules) (acc '()))
    (cond
      ((null? rem)
       (reverse acc))
      ((and (pair? (car rem)) (memq (caar rem) '(fuse-rules fuse-tree-rules fuse-post-rules)))
       (let* ((specs (cdar rem))
              (fused-clauses (nanopass-extract-fused-clauses specs nt-name)))
         (loop (cdr rem) (append (reverse fused-clauses) acc))))
      ((and (pair? (car rem)) (eq? (caar rem) 'fuse-window-rules))
       (let* ((specs (cdar rem))
              (fused-clauses (nanopass-extract-fused-window-rules specs)))
         (loop (cdr rem) (append (reverse fused-clauses) acc))))
      ((and (pair? (car rem)) (memq (caar rem) '(redispatch :redispatch :order order)))
       (loop (cdr rem) acc))
      (else
       (let ((expanded (nanopass-expand-rule (car rem) nt-name #f)))
         (loop (cdr rem) (cons expanded acc)))))))

;;; Detect rule application order ('pre or 'post) from NT rules
(define (nanopass-nt-rules-detect-order raw-rules)
  (let loop ((rem raw-rules))
    (cond
      ((null? rem) 'pre)
      ((and (pair? (car rem)) (eq? (caar rem) 'fuse-post-rules))
       'post)
      ((and (pair? (car rem)) (memq (caar rem) '(fuse-rules fuse-tree-rules)))
       (let ((parsed (nanopass-parse-fuse-rules-specs (cdar rem))))
         (if (eq? (car parsed) 'post)
             'post
             (loop (cdr rem)))))
      ((and (pair? (car rem)) (memq (caar rem) '(:order order)) (pair? (cdar rem)))
       (let ((ord (cadar rem)))
         (if (or (eq? ord 'post) (eq? ord ':post) (equal? ord ''post))
             'post
             (loop (cdr rem)))))
      (else
       (loop (cdr rem))))))

;;; Group rule descriptors by target NT name for top-level fuse-rules
(define (nanopass-group-rules-by-nt specs default-nt)
  (let loop ((rem specs) (groups '()))
    (if (null? rem)
        (reverse (map (lambda (g) (cons (car g) (reverse (cdr g)))) groups))
        (let* ((spec (car rem))
               (desc (nanopass-lookup-rule spec))
               (nt (if (rule-nt-name desc) (rule-nt-name desc) default-nt))
               (cls (rule-clauses desc)))
          (let add-to-groups ((gs groups) (acc '()))
            (cond
              ((null? gs)
               (loop (cdr rem) (cons (cons nt (reverse cls)) groups)))
              ((eq? (caar gs) nt)
               (loop (cdr rem)
                     (append (reverse acc)
                             (cons (cons nt (append (reverse cls) (cdar gs)))
                                   (cdr gs)))))
              (else
               (add-to-groups (cdr gs) (cons (car gs) acc)))))))))

;;; Build cascaded dispatch expression for nonterminal transformer rules
;;; Incorporates O(1) Head-Tag bucketing (case dispatch), pair fallback, atom fast-path,
;;; Local Re-dispatch with bounded fuel counter (Fuel Guard, DSN-33-01 T3.2),
;;; and traversal order ('pre top-down vs 'post bottom-up).
(define (nanopass-build-rules-cascade-with-order rules l-in l-out nt-name in-arg-list extra-out enable-redispatch? order)
  (let* ((ir-var (car in-arg-list))
         (post? (eq? order 'post))
         (cata-call (nanopass-make-catamorphism-call l-in l-out nt-name ir-var in-arg-list extra-out))
         (leaf-fallback (if post? ir-var cata-call))
         (cascade-res
          (if (or (null? rules) (eq? l-out '*) (not enable-redispatch?))
              (let* ((partitioned (nanopass-partition-rules rules))
                     (buckets (car partitioned))
                     (pair-fallbacks (cadr partitioned))
                     (atom-rules (caddr partitioned))
                     (pair-fallback-expr (nanopass-compile-rule-list pair-fallbacks ir-var nt-name leaf-fallback #f #f))
                     (atom-fallback-expr (nanopass-compile-rule-list atom-rules ir-var nt-name leaf-fallback #f #f))
                     (core-expr
                      (if (null? buckets)
                          (if (and (null? pair-fallbacks) (null? atom-rules))
                              leaf-fallback
                              (if (equal? pair-fallbacks atom-rules)
                                  pair-fallback-expr
                                  (list 'if (list 'pair? ir-var)
                                        pair-fallback-expr
                                        atom-fallback-expr)))
                          (let ((case-expr
                                 (cons 'case
                                       (cons (list 'car ir-var)
                                             (append (map (lambda (b)
                                                            (list (list (car b))
                                                                  (nanopass-compile-rule-list (cdr b) ir-var nt-name pair-fallback-expr #f #f)))
                                                          buckets)
                                                     (list (list 'else pair-fallback-expr)))))))
                            (list 'if (list 'pair? ir-var)
                                  (list 'if (list 'symbol? (list 'car ir-var))
                                        case-expr
                                        pair-fallback-expr)
                                  atom-fallback-expr)))))
                (if post?
                    (list 'let (list (list ir-var cata-call)) core-expr)
                    core-expr))
              (let* ((loop-var (unique-symbol "__redispatch_loop_"))
                     (fuel-var (unique-symbol "__fuel_"))
                     (partitioned (nanopass-partition-rules rules))
                     (buckets (car partitioned))
                     (pair-fallbacks (cadr partitioned))
                     (atom-rules (caddr partitioned))
                     (pair-fallback-expr (nanopass-compile-rule-list pair-fallbacks ir-var nt-name leaf-fallback loop-var fuel-var))
                     (atom-fallback-expr (nanopass-compile-rule-list atom-rules ir-var nt-name leaf-fallback loop-var fuel-var))
                     (cascade-body
                      (if (null? buckets)
                          (if (and (null? pair-fallbacks) (null? atom-rules))
                              leaf-fallback
                              (if (equal? pair-fallbacks atom-rules)
                                  pair-fallback-expr
                                  (list 'if (list 'pair? ir-var)
                                        pair-fallback-expr
                                        atom-fallback-expr)))
                          (let ((case-expr
                                 (cons 'case
                                       (cons (list 'car ir-var)
                                             (append (map (lambda (b)
                                                            (list (list (car b))
                                                                  (nanopass-compile-rule-list (cdr b) ir-var nt-name pair-fallback-expr loop-var fuel-var)))
                                                          buckets)
                                                     (list (list 'else pair-fallback-expr)))))))
                            (list 'if (list 'pair? ir-var)
                                  (list 'if (list 'symbol? (list 'car ir-var))
                                        case-expr
                                        pair-fallback-expr)
                                  atom-fallback-expr))))
                     (redispatch-expr
                      (list 'letrec
                            (list (list loop-var
                                        (list 'lambda (list ir-var fuel-var)
                                              (list 'if (list '<= fuel-var 0)
                                                    (list (string->symbol "picopass-fail")
                                                          "nanopass: local re-dispatch fuel exhausted on node"
                                                          ir-var)
                                                    cascade-body))))
                            (list loop-var ir-var (string->symbol "*nanopass-redispatch-limit*")))))
                (if post?
                    (list 'let (list (list ir-var cata-call)) redispatch-expr)
                    redispatch-expr)))))
    (if (eq? l-out '*)
        cascade-res
        (let ((s-var (unique-symbol "__span_"))
              (inner-var (unique-symbol "__inner_"))
              (res-var (unique-symbol "__res_")))
          (list 'if (list 'or
                          (list (string->symbol "ast-has-span?") ir-var)
                          (list (string->symbol "source-loc?") ir-var))
                (list 'let (list (list s-var (list (string->symbol "ast-source-span") ir-var))
                                 (list inner-var (list (string->symbol "ast-strip-span") ir-var)))
                      (list 'let (list (list ir-var inner-var))
                            (list 'let (list (list res-var cascade-res))
                                  (list 'if (list (string->symbol "ast-has-span?") res-var)
                                        res-var
                                        (list (string->symbol "ast-with-span") res-var s-var)))))
                cascade-res)))))

(define (nanopass-build-rules-cascade rules l-in l-out nt-name in-arg-list extra-out enable-redispatch?)
  (nanopass-build-rules-cascade-with-order rules l-in l-out nt-name in-arg-list extra-out enable-redispatch? 'pre))

;;; Normalize rules whether passed as list of rules or single wrapped list
(define (nanopass-normalize-rules raw-rules)
  (if (and (= (length raw-rules) 1)
           (pair? (car raw-rules))
           (> (length (car raw-rules)) 1)
           (pair? (caar raw-rules))
           (pair? (cadar raw-rules))
           (pair? (cddar raw-rules))
           (not (eq? (caar raw-rules) 'unquote))
           (not (and (pair? (cadar raw-rules)) (eq? (caadar raw-rules) 'guard))))
      (car raw-rules)
      raw-rules))

;;; Parse a nonterminal clause in define-pass
(define (nanopass-parse-nt-clause clause)
  (let ((nt-name (car clause))
        (rest (cdr clause)))
    (if (and (pair? rest) (eq? (car rest) ':))
        ;; (NT : NT_in (ir extra1 ...) -> NT_out (extra_out ...) rules ...)
        ;; or (NT : NT_in (ir extra1 ...) -> * (extra_out ...) rules ...)
        (let* ((nt-in (cadr rest))
               (in-args (caddr rest))
               (in-arg-list (if (pair? in-args) in-args (list in-args)))
               (after-arrow (cddddr rest))
               (nt-out (car after-arrow))
               (has-extra-out? (and (pair? (cdr after-arrow)) (list? (cadr after-arrow))))
               (extra-out (if has-extra-out? (cadr after-arrow) '()))
               (raw-rules (if has-extra-out? (cddr after-arrow) (cdr after-arrow)))
               (rules (nanopass-normalize-rules raw-rules)))
          (list nt-name in-arg-list nt-out extra-out rules))
        ;; Shorthand: (NT (ir extra1 ...) rules ...)
        (let* ((in-args (car rest))
               (in-arg-list (if (pair? in-args) in-args (list in-args)))
               (rules (nanopass-normalize-rules (cdr rest))))
          (list nt-name in-arg-list nt-name '() rules)))))

;;; Extract all fused rule specifications from pass clauses
(define (nanopass-extract-all-pass-rule-specs clauses)
  (let loop ((rem clauses) (acc '()))
    (if (null? rem)
        (reverse acc)
        (let ((c (car rem)))
          (cond
            ((and (pair? c) (memq (car c) '(fuse-rules fuse-tree-rules fuse-post-rules)))
             (let ((flat (cdr (nanopass-parse-fuse-rules-specs (cdr c)))))
               (loop (cdr rem) (append (reverse flat) acc))))
            ((and (pair? c) (eq? (car c) 'fuse-window-rules))
             (let* ((specs (cdr c))
                    (flat (if (and (= (length specs) 1) (list? (car specs))) (car specs) specs)))
               (loop (cdr rem) (append (reverse flat) acc))))
            ((and (pair? c) (symbol? (car c)))
             (let* ((parsed (nanopass-parse-nt-clause c))
                    (raw-rules (car (cddddr parsed))))
               (let in-loop ((rs raw-rules) (in-acc acc))
                 (cond
                   ((null? rs) (loop (cdr rem) in-acc))
                   ((and (pair? (car rs)) (memq (caar rs) '(fuse-rules fuse-tree-rules fuse-post-rules)))
                    (let ((fl (cdr (nanopass-parse-fuse-rules-specs (cdar rs)))))
                      (in-loop (cdr rs) (append (reverse fl) in-acc))))
                   ((and (pair? (car rs)) (eq? (caar rs) 'fuse-window-rules))
                    (let* ((sp (cdar rs))
                           (fl (if (and (= (length sp) 1) (list? (car sp))) (car sp) sp)))
                      (in-loop (cdr rs) (append (reverse fl) in-acc))))
                   (else (in-loop (cdr rs) in-acc))))))
            (else
             (loop (cdr rem) acc)))))))

;;; Expand define-pass AST
(define (nanopass-expand-define-pass-with-trace form force-trace?)
  (let* ((parsed (nanopass-parse-pass-header form))
         (name (car parsed))
         (l-in (cadr parsed))
         (in-arg-list (caddr parsed))
         (l-out (cadddr parsed))
         (extra-out (car (cddddr parsed)))
         (raw-clauses (cadr (cddddr parsed)))
         (contract-info (nanopass-extract-analysis-contracts raw-clauses))
         (clauses (car contract-info))
         (has-contract? (cadr contract-info))
         (req-list (caddr contract-info))
         (pres-list (cadddr contract-info))
         (inv-list (car (cddddr contract-info)))
         (all-fused-specs (nanopass-extract-all-pass-rule-specs clauses)))
    (if has-contract?
        (register-pass-analysis-contract! name req-list pres-list inv-list))
    ;; Validate schema coverage between l-in and l-out against eliminated rules (DSN-33-01 T3.2)
    (if (and (pair? all-fused-specs)
             (symbol? l-in) (symbol? l-out)
             (not (eq? l-out '*)))
        (let ((missing (nanopass-verify-fusion-coverage l-in l-out all-fused-specs)))
          (if (pair? missing)
              (let* ((port (cond
                             ((and (procedure? current-error-port) (not (null? (current-error-port))))
                              (current-error-port))
                             (else (current-output-port))))
                     (formatted-missing (let loop ((rem missing) (acc "("))
                                          (if (null? rem)
                                              (string-append acc ")")
                                              (let* ((s (if (symbol? (car rem)) (symbol->string (car rem)) "?"))
                                                     (next-acc (if (string=? acc "(")
                                                                   (string-append acc s)
                                                                   (string-append acc " " s))))
                                                (loop (cdr rem) next-acc))))))
                (display (string-append "[WARN] define-pass "
                                        (if (symbol? name) (symbol->string name) "?")
                                        ": missing desugar rules for eliminated forms: "
                                        formatted-missing
                                        "\n")
                         port)))))
    (let loop ((rest clauses)
               (defs '())
               (nt-procs '())
               (entry-nt #f))
      (if (null? rest)
          (let* ((final-entry (if entry-nt entry-nt 'Expr))
                 (ir-var (car in-arg-list))
                 (res-var (unique-symbol "__res_"))
                 (body-call (cons final-entry in-arg-list))
                 (trace-tail
                  (if force-trace?
                      (list 'begin
                            (list 'if (list 'not (list (string->symbol "nanopass-in-pipeline-runner?")))
                                  (list (string->symbol "nanopass-display-ast-diff") (list 'quote name) ir-var res-var)
                                  #f)
                            res-var)
                      (list 'begin
                            (list 'if (list 'and (list (string->symbol "nanopass-trace-enabled?"))
                                                 (list 'not (list (string->symbol "nanopass-in-pipeline-runner?"))))
                                  (list (string->symbol "nanopass-display-ast-diff") (list 'quote name) ir-var res-var)
                                  #f)
                            res-var)))
                 (inner-let
                  (list 'let (list (list res-var body-call))
                        (list 'begin
                              (if has-contract?
                                  (list (string->symbol "nanopass-invoke-post-pass-analysis!") (list 'quote name) ir-var res-var)
                                  #f)
                              (list 'if (list (string->symbol "nanopass-verifier-enabled?"))
                                    (list (string->symbol "nanopass-verify-ast") (list 'quote name) (list 'quote l-out) res-var ''exit)
                                    #f)
                              trace-tail)))
                 (frame-thunk
                  (if has-contract?
                      (list 'lambda '()
                            (list 'begin
                                  (list (string->symbol "nanopass-invoke-pre-pass-analysis!") (list 'quote name) ir-var)
                                  inner-let))
                      (list 'lambda '() inner-let)))
                 (def-form
                  (list 'define (cons name in-arg-list)
                        (list 'letrec
                              (append (reverse defs) (reverse nt-procs))
                              (list 'begin
                                    (list (string->symbol "set-current-pass!") (list 'quote name))
                                    (list 'if (list (string->symbol "nanopass-verifier-enabled?"))
                                          (list (string->symbol "nanopass-verify-ast") (list 'quote name) (list 'quote l-in) ir-var ''entry)
                                          #f)
                                    (list (string->symbol "with-call-frame") (list 'quote name) ir-var frame-thunk))))))
            (if has-contract?
                (list 'begin
                      def-form
                      (list (string->symbol "register-pass-proc-analysis-contract!")
                            name
                            (list 'quote name)
                            (list 'quote req-list)
                            (list 'quote pres-list)
                            (list 'quote inv-list)))
                def-form))
          (let ((c (car rest)))
            (cond
              ;; (definitions def1 def2 ...)
              ((and (pair? c) (eq? (car c) 'definitions))
               (let ((norm-defs
                      (map (lambda (d)
                             (if (and (pair? d) (eq? (car d) 'define))
                                 (let ((spec (cadr d)))
                                   (if (pair? spec)
                                       (list (car spec) (cons 'lambda (cons (cdr spec) (cddr d))))
                                       (list spec (caddr d))))
                                 d))
                           (cdr c))))
                 (loop (cdr rest) (append (reverse norm-defs) defs) nt-procs entry-nt)))
              ;; (entry EntryNT)
              ((and (pair? c) (eq? (car c) 'entry))
               (loop (cdr rest) defs nt-procs (cadr c)))
              ;; (fuse-rules [:order post] r1 r2 ...), (fuse-tree-rules ...), or (fuse-post-rules ...) at top-level
              ((and (pair? c) (memq (car c) '(fuse-rules fuse-tree-rules fuse-post-rules)))
               (let* ((parsed-specs (nanopass-parse-fuse-rules-specs (cdr c)))
                      (order (if (eq? (car c) 'fuse-post-rules) 'post (car parsed-specs)))
                      (flat-specs (cdr parsed-specs))
                      (groups (nanopass-group-rules-by-nt flat-specs (if entry-nt entry-nt 'Expr))))
                 (let group-loop ((gs groups) (cur-procs nt-procs) (cur-entry entry-nt))
                   (if (null? gs)
                       (loop (cdr rest) defs cur-procs cur-entry)
                       (let* ((g (car gs))
                              (g-nt (car g))
                              (g-clauses (cdr g))
                              (body-expr (nanopass-build-rules-cascade-with-order g-clauses l-in l-out g-nt in-arg-list extra-out #t order))
                              (proc-binding (list g-nt (list 'lambda in-arg-list body-expr))))
                         (group-loop (cdr gs)
                                     (cons proc-binding cur-procs)
                                     (if cur-entry cur-entry g-nt)))))))
              ;; (fuse-window-rules r1 r2 ...) at top-level
              ((and (pair? c) (eq? (car c) 'fuse-window-rules))
               (let* ((specs (cdr c))
                      (flat-specs (if (and (= (length specs) 1) (list? (car specs))) (car specs) specs))
                      (entry-name (if entry-nt entry-nt 'InstructionList))
                      (proc-binding (nanopass-build-window-pass-binding flat-specs entry-name in-arg-list)))
                 (loop (cdr rest) defs (cons proc-binding nt-procs) (if entry-nt entry-nt entry-name))))
              ;; (NT : NT_in (ir extra ...) -> NT_out (extra_out ...) rules ...)
              ;; or (NT (ir extra ...) rules ...)
              ((and (pair? c) (symbol? (car c)))
               (let* ((parsed-nt (nanopass-parse-nt-clause c))
                      (nt-name (car parsed-nt))
                      (nt-in-args (cadr parsed-nt))
                      (nt-out (caddr parsed-nt))
                      (nt-extra-out (cadddr parsed-nt))
                      (raw-rules (car (cddddr parsed-nt)))
                      (has-window-fused?
                       (let check ((rs raw-rules))
                         (and (pair? rs)
                              (or (and (pair? (car rs)) (eq? (caar rs) 'fuse-window-rules))
                                  (check (cdr rs)))))))
                 (if has-window-fused?
                     (let* ((window-specs
                             (let extract ((rs raw-rules) (wacc '()))
                               (cond
                                 ((null? rs) (reverse wacc))
                                 ((and (pair? (car rs)) (eq? (caar rs) 'fuse-window-rules))
                                  (let ((sp (cdar rs)))
                                    (extract (cdr rs) (append (reverse (if (and (= (length sp) 1) (list? (car sp))) (car sp) sp)) wacc))))
                                 (else (extract (cdr rs) (cons (car rs) wacc))))))
                            (proc-binding (nanopass-build-window-pass-binding window-specs nt-name nt-in-args)))
                       (loop (cdr rest)
                             defs
                             (cons proc-binding nt-procs)
                             (if entry-nt entry-nt nt-name)))
                     (let* ((has-fused?
                             (let check ((rs raw-rules))
                               (and (pair? rs)
                                    (or (and (pair? (car rs)) (memq (caar rs) '(fuse-rules fuse-tree-rules fuse-post-rules redispatch :redispatch)))
                                        (check (cdr rs))))))
                            (nt-order (nanopass-nt-rules-detect-order raw-rules))
                            (expanded-rules (nanopass-flatten-nt-rules raw-rules nt-name))
                            (body-expr (nanopass-build-rules-cascade-with-order expanded-rules l-in nt-out nt-name nt-in-args (if (pair? nt-extra-out) nt-extra-out extra-out) has-fused? nt-order))
                            (proc-binding (list nt-name (list 'lambda nt-in-args body-expr))))
                       (loop (cdr rest)
                             defs
                             (cons proc-binding nt-procs)
                             (if entry-nt entry-nt nt-name))))))
              (else
               (loop (cdr rest) defs nt-procs entry-nt))))))))

(define (nanopass-expand-define-pass form)
  (nanopass-expand-define-pass-with-trace form #f))

(define (nanopass-expand-trace-define-pass form)
  (let ((pass-form (cons 'define-pass (cdr form))))
    (nanopass-expand-define-pass-with-trace pass-form #t)))

;;; Expand define-language AST
(define (nanopass-expand-define-language form)
  (let* ((name (cadr form))
         (clauses (cddr form)))
    (list 'begin
          (list 'define (string->symbol (string-append "__lang_" (symbol->raw-name name)))
                (list (string->symbol "nanopass-register-language!")
                      (list (string->symbol "nanopass-parse-language-spec")
                            (list 'quote name)
                            (list 'quote clauses))))
          (list 'define (string->symbol (string-append "parse-" (symbol->raw-name name)))
                (list 'lambda (list 'expr)
                      (list (string->symbol "nanopass-parse") (list 'quote name) 'expr)))
          (list 'define (string->symbol (string-append "unparse-" (symbol->raw-name name)))
                (list 'lambda (list 'ir)
                      (list (string->symbol "nanopass-unparse") (list 'quote name) 'ir)))
          (list 'define (string->symbol (string-append (symbol->raw-name name) "?"))
                (list 'lambda (list 'expr)
                      (list (string->symbol "nanopass-ast-valid?") (list 'quote name) 'expr))))))

;;; Expand define-parser AST
(define (nanopass-expand-define-parser form)
  (let ((proc-name (cadr form))
        (lang-name (caddr form)))
    (list 'define (list proc-name 'expr)
          (list (string->symbol "nanopass-parse") (list 'quote lang-name) 'expr))))

;;; Expand define-unparser AST
(define (nanopass-expand-define-unparser form)
  (let ((proc-name (cadr form))
        (lang-name (caddr form)))
    (list 'define (list proc-name 'ir)
          (list (string->symbol "nanopass-unparse") (list 'quote lang-name) 'ir))))

;;; =======================================================================
;;; Picopass / Femtopass / Attopass DSL Expanders (DSN-33-01 T2.1)
;;; =======================================================================

(define (nanopass-keyword-symbol? s)
  (if (not (symbol? s))
      #f
      (let ((str (symbol->raw-name s)))
        (and (> (string-length str) 1)
             (char=? (string-ref str 0) #\:)))))

(define (nanopass-parse-rule-spec form default-kind)
  (let ((name (cadr form))
        (rest (cddr form)))
    (let loop ((rem rest)
               (opts '())
               (nt-name 'Expr)
               (in-attrs '())
               (out-attrs '())
               (clauses '()))
      (cond
        ((null? rem)
         (list name default-kind nt-name in-attrs out-attrs clauses opts))
        ;; Keyword options: :reads, :writes, :eliminates, :head-tags, :nt
        ((and (nanopass-keyword-symbol? (car rem)) (pair? (cdr rem)))
         (loop (cddr rem) (cons (cons (car rem) (cadr rem)) opts) nt-name in-attrs out-attrs clauses))
        ((and (pair? (car rem)) (nanopass-keyword-symbol? (caar rem)))
         (loop (cdr rem) (cons (car rem) opts) nt-name in-attrs out-attrs clauses))
        ;; NT clause: (Expr ...) or (Expr : (in) -> (out) ...)
        ((pair? (car rem))
         (let ((spec (car rem)))
           (cond
             ((and (pair? spec) (symbol? (car spec)) (pair? (cdr spec)) (eq? (cadr spec) ':))
              ;; (NT : (in-attrs ...) -> (out-attrs ...) clauses ...)
              (let* ((parsed-nt (car spec))
                     (after-colon (cddr spec))
                     (ins (if (pair? after-colon) (car after-colon) '()))
                     (after-arrow (if (and (pair? after-colon) (pair? (cdr after-colon)))
                                      (cddr after-colon)
                                      '()))
                     (outs (if (and (pair? after-arrow) (eq? (car after-arrow) '->) (pair? (cdr after-arrow)))
                               (cadr after-arrow)
                               '()))
                     (cs (if (and (pair? after-arrow) (eq? (car after-arrow) '->) (pair? (cdr after-arrow)))
                             (cddr after-arrow)
                             (if (pair? after-arrow) (cdr after-arrow) '()))))
                (loop (cdr rem) opts parsed-nt ins outs cs)))
             ((and (pair? spec) (symbol? (car spec)))
              ;; (NT clauses ...)
              (loop (cdr rem) opts (car spec) in-attrs out-attrs (cdr spec)))
             (else
              ;; List of clauses directly
              (loop (cdr rem) opts nt-name in-attrs out-attrs spec)))))
        ((symbol? (car rem))
         ;; (define-picopass name NT clauses ...)
         (loop (cddr rem) opts (car rem) in-attrs out-attrs (cadr rem)))
        (else
         (loop (cdr rem) opts nt-name in-attrs out-attrs clauses))))))

(define (nanopass-build-rule-cascade rules kind nt-name ir-var)
  (let loop ((rs rules))
    (if (null? rs)
        (cond
          ((eq? kind 'pico) #f)
          ((eq? kind 'femto) #f)
          ((eq? kind 'atto) #t)
          (else #f))
        (let* ((r (car rs))
               (pat (car r))
               (vars (cadr r))
               (guard-expr (caddr r))
               (body-expr (cadddr r)))
          (if (nanopass-direct-matchable-pattern? pat)
              (let ((c-var (unique-symbol "__dc_"))
                    (tail-expr (loop (cdr rs))))
                (list 'let (list (list c-var
                                       (nanopass-compile-direct-pattern
                                        pat ir-var
                                        (lambda ()
                                          (if (eq? guard-expr #t)
                                              (list 'cons #t body-expr)
                                              (list 'if guard-expr
                                                    (list 'cons #t body-expr)
                                                    #f))))))
                      (list 'if c-var (list 'cdr c-var) tail-expr)))
              (let ((m-var (unique-symbol "__m_")))
                (list 'let (list (list m-var
                                       (list (string->symbol "nanopass-match-clause")
                                             (list 'quote pat)
                                             ir-var
                                             (list 'quote vars)
                                             (list 'quote nt-name))))
                      (list 'if m-var
                            (if (eq? guard-expr #t)
                                (nanopass-bind-matched-vars vars m-var body-expr)
                                (nanopass-bind-matched-vars vars m-var
                                                            (list 'if guard-expr
                                                                  body-expr
                                                                  (loop (cdr rs)))))
                            (loop (cdr rs))))))))))

(define (nanopass-expand-rule-dsl form default-kind)
  (let* ((parsed (nanopass-parse-rule-spec form default-kind))
         (name (car parsed))
         (rule-kind (cadr parsed))
         (nt-name (caddr parsed))
         (in-attrs (cadddr parsed))
         (raw-clauses (car (cddddr (cdr parsed))))
         (opts (cadr (cddddr (cdr parsed))))
         (expanded-rules (map (lambda (r) (nanopass-expand-rule r nt-name name)) raw-clauses))
         (opt-head-tags (let ((e (assq ':head-tags opts))) (if e (cdr e) #f)))
         (opt-reads (let ((e (assq ':reads opts))) (if e (cdr e) #f)))
         (opt-writes (let ((e (assq ':writes opts))) (if e (cdr e) #f)))
         (opt-eliminates (let ((e (assq ':eliminates opts))) (if e (cdr e) #f)))
         (opt-mandatory (let ((e (or (assq ':mandatory opts) (assq ':mandatory? opts)))) (if e (cdr e) #f)))
         (head-tags (if opt-head-tags opt-head-tags (nanopass-extract-head-tags expanded-rules)))
         (reads (if opt-reads opt-reads (nanopass-extract-pattern-reads expanded-rules)))
         (writes (if opt-writes opt-writes (nanopass-extract-template-writes expanded-rules)))
         (eliminates (if opt-eliminates opt-eliminates (nanopass-infer-eliminates head-tags writes)))
         (desc-var (unique-symbol (string-append "__desc_" (symbol->raw-name name))))
         (cascade (nanopass-build-rule-cascade expanded-rules rule-kind nt-name 'ir))
         (proc-body
          (cond
            ((eq? rule-kind 'femto)
             (let* ((recurse-params (cons 'sub-node in-attrs))
                    (recurse-binding
                     (list 'femto-recurse
                           (list 'lambda recurse-params
                                 (cons name recurse-params))))
                    (inner-body (list 'letrec (list recurse-binding) cascade)))
               (if (null? in-attrs)
                   (list (string->symbol "femto-get-cached-attr")
                         (list 'quote name)
                         'ir
                         (list 'lambda '() inner-body))
                   inner-body)))
            ((eq? rule-kind 'pico)
             (let ((s-var (unique-symbol "__pico_span_"))
                   (inner-var (unique-symbol "__pico_inner_"))
                   (res-var (unique-symbol "__pico_res_")))
               (list 'if (list 'or
                               (list (string->symbol "ast-has-span?") 'ir)
                               (list (string->symbol "source-loc?") 'ir))
                     (list 'let (list (list s-var (list (string->symbol "ast-source-span") 'ir))
                                      (list inner-var (list (string->symbol "ast-strip-span") 'ir)))
                           (list 'let (list (list 'ir inner-var))
                                 (list 'let (list (list res-var cascade))
                                       (list 'if (list 'and res-var (list 'not (list (string->symbol "ast-has-span?") res-var)))
                                             (list (string->symbol "ast-with-span") res-var s-var)
                                             res-var))))
                     cascade)))
            (else cascade))))
    ;; Register rule descriptor at compile-time for downstream pass fusion (e.g. fuse-rules)
    (if opt-mandatory
        (register-mandatory-picopass! name))
    (if (and (eq? rule-kind 'femto) (pair? reads))
        (femto-register-attr-dependencies! name reads))
    (nanopass-register-rule!
      (nanopass-make-rule-descriptor name rule-kind nt-name head-tags reads writes eliminates expanded-rules #f))
    (cons 'begin
          (append
            (list (list 'define desc-var
                        (list (string->symbol "nanopass-make-rule-descriptor")
                              (list 'quote name)
                              (list 'quote rule-kind)
                              (list 'quote nt-name)
                              (list 'quote head-tags)
                              (list 'quote reads)
                              (list 'quote writes)
                              (list 'quote eliminates)
                              (list 'quote expanded-rules)
                              #f))
                  (list 'define (cons name (if (null? in-attrs) '(ir) (cons 'ir in-attrs)))
                        proc-body)
                  (list (string->symbol "nanopass-rule-set-proc!") desc-var name)
                  (list (string->symbol "nanopass-register-rule!") desc-var))
            (append
              (if (and (eq? rule-kind 'femto) (pair? reads))
                  (list (list (string->symbol "femto-register-attr-dependencies!")
                              (list 'quote name)
                              (list 'quote reads)))
                  '())
              (append
                (if opt-mandatory
                    (list (list (string->symbol "register-mandatory-picopass!") (list 'quote name)))
                    '())
                (list (list 'quote name))))))))

(define (nanopass-expand-define-picopass form)
  (nanopass-expand-rule-dsl form 'pico))

(define (nanopass-expand-define-femtopass form)
  (nanopass-expand-rule-dsl form 'femto))

(define (nanopass-expand-define-attopass form)
  (nanopass-expand-rule-dsl form 'atto))

;;; -----------------------------------------------------------------------
;;; define-pipeline DSL Expander (DSN-33-01 T6.1 / Issue #768)
;;; -----------------------------------------------------------------------
(define (nanopass-parse-pipeline-clauses clauses)
  (let loop ((rest clauses)
             (doc "No documentation provided")
             (target-ir 'lir)
             (passes '())
             (options '()))
    (if (null? rest)
        (list doc target-ir passes options)
        (let ((clause (car rest)))
          (cond
            ((and (pair? clause) (or (eq? (car clause) 'doc) (eq? (car clause) 'docstring)))
             (loop (cdr rest) (cadr clause) target-ir passes options))
            ((and (pair? clause) (eq? (car clause) 'target-ir))
             (loop (cdr rest) doc (cadr clause) passes options))
            ((and (pair? clause) (eq? (car clause) 'options))
             (loop (cdr rest) doc target-ir passes (cdr clause)))
            ((and (pair? clause) (eq? (car clause) 'passes))
             (loop (cdr rest) doc target-ir (cdr clause) options))
            (else
             (loop (cdr rest) doc target-ir passes options)))))))

(define (nanopass-expand-define-pipeline form)
  (let* ((name (cadr form))
         (clauses (cddr form))
         (parsed (nanopass-parse-pipeline-clauses clauses))
         (doc (car parsed))
         (target-ir (cadr parsed))
         (passes (caddr parsed))
         (options (cadddr parsed)))
    (list 'begin
          (list 'register-pipeline!
                (list 'make-pipeline-descriptor
                      (list 'quote name)
                      doc
                      (list 'quote passes)
                      (list 'quote target-ir)
                      (list 'quote options)))
          (list 'define (list name 'forms 'verify-mode 'trace-mode)
                (list 'run-named-pipeline (list 'quote name) 'forms 'verify-mode 'trace-mode)))))

