              (list '%raw-asm "    lea r8, [rip + ulisp_current_task_top]")
              (list '%raw-asm "    add r8, rcx")
              (list '%raw-asm "1:")
              (list '%raw-asm "    mov r11, [r8]")
              (list '%raw-asm "    test r11, r11")
              (list '%raw-asm "    jz 3f")
              (list '%raw-asm "    mov rcx, [r11 - 72]")
              (list '%raw-asm "    test rcx, rcx")
              (list '%raw-asm "    jnz 4f")
              (list '%raw-asm "    lea rcx, [r11 - 65536]")
              (list '%raw-asm "4:")
              (list '%raw-asm "    cmp rbx, rcx")
              (list '%raw-asm "    jb 2f")
              (list '%raw-asm "    cmp rbx, r11")
              (list '%raw-asm "    jae 2f")
              (list '%raw-asm "    jmp 3f")
              (list '%raw-asm "2:")
              (list '%raw-asm "    mov qword ptr [r11 - 24], 3")
              (list '%raw-asm "    mov qword ptr [r11 - 32], 0")
              (list '%raw-asm "    mov rdi, [r11 - 48]")
              (list '%raw-asm "    cmp rdi, r11")
              (list '%raw-asm "    jne 5f")
              (list '%raw-asm "    xor rdi, rdi")
              (list '%raw-asm "5:")
              (list '%raw-asm "    mov [r8], rdi")
              (list '%raw-asm "    jmp 1b")
              (list '%raw-asm "3:")
              (list '%raw-asm "    mov rdi, rax")
              (list '%raw-asm "    mov rsp, [rbx + 8]")
              (list '%raw-asm "    mov rbp, [rbx + 16]")
              (list '%raw-asm "    mov r10, [rbx + 24]")
              (list '%raw-asm "    mov rax, [rbx + 32]")
              (list '%raw-asm "    jmp r10")))

      ((%set-values-count)
