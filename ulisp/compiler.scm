(define repr-pointer-align
  (case-lambda
    (() (value-repr-prop (current-value-repr) 'pointer ':align 8))
    ((opt-repr) (value-repr-prop (get-value-repr opt-repr) 'pointer ':align 8))))

(define repr-pointer-mask
  (case-lambda
    (() (value-repr-prop (current-value-repr) 'pointer ':tag-mask 7))
    ((opt-repr) (value-repr-prop (get-value-repr opt-repr) 'pointer ':tag-mask 7))))

(define (repr-pointer-untag-mask-with r)
  (value-repr-prop r 'pointer ':untag-mask (- (value-repr-prop r 'pointer ':align 8))))

(define repr-pointer-untag-mask
  (case-lambda
    (() (repr-pointer-untag-mask-with (current-value-repr)))
    ((opt-repr) (repr-pointer-untag-mask-with (get-value-repr opt-repr)))))

(define (repr-heap-tag-with kind r)
  (case kind
    ((pair)       (value-repr-prop r 'pointer ':pair-tag 1))
    ((closure procedure) (value-repr-prop r 'pointer ':closure-tag 1))
    ((string)     (value-repr-prop r 'pointer ':string-tag 3))
    ((vector)     (value-repr-prop r 'pointer ':vector-tag 5))
    ((bytevector) (value-repr-prop r 'pointer ':bytevector-tag 7))
    ((flonum)     (value-repr-prop r 'pointer ':flonum-tag 11))
    (else         (value-repr-prop r 'pointer ':tag-bits 0))))

(define repr-heap-tag
  (case-lambda
    ((kind) (repr-heap-tag-with kind (current-value-repr)))
    ((kind opt-repr) (repr-heap-tag-with kind (get-value-repr opt-repr)))))

(define (repr-field-offset-with kind byte-offset r)
  (- byte-offset (repr-heap-tag-with kind r)))

(define repr-field-offset
  (case-lambda
    ((kind byte-offset) (repr-field-offset-with kind byte-offset (current-value-repr)))
    ((kind byte-offset opt-repr) (repr-field-offset-with kind byte-offset (get-value-repr opt-repr)))))

;;; -----------------------------------------------------------------------
;;; 8. Boxing & Unboxing LIR Code Generators
;;; -----------------------------------------------------------------------

(define (repr-emit-box-fixnum-with dst src r)
  (let ((shift (value-repr-prop r 'fixnum ':shift 0))
        (tag (value-repr-prop r 'fixnum ':tag-bits 0))
        (mov-prefix (if (equal? dst src) '() (list (list '%mov dst src)))))
    (cond
      ((and (= shift 0) (= tag 0))
       mov-prefix)
      ((= tag 0)
       (append mov-prefix (list (list '%shl dst shift))))
      ((= shift 0)
       (append mov-prefix (list (list '%bit-or dst tag))))
      (else
       (append mov-prefix
               (list (list '%shl dst shift)
                     (list '%bit-or dst tag)))))))

(define repr-emit-box-fixnum
  (case-lambda
    ((dst src) (repr-emit-box-fixnum-with dst src (current-value-repr)))
    ((dst src opt-repr) (repr-emit-box-fixnum-with dst src (get-value-repr opt-repr)))))

(define (repr-emit-unbox-fixnum-with dst src r)
  (let ((shift (value-repr-prop r 'fixnum ':shift 0))
        (mov-prefix (if (equal? dst src) '() (list (list '%mov dst src)))))
    (if (= shift 0)
        mov-prefix
        (append mov-prefix (list (list '%sar dst shift))))))

(define repr-emit-unbox-fixnum
  (case-lambda
    ((dst src) (repr-emit-unbox-fixnum-with dst src (current-value-repr)))
    ((dst src opt-repr) (repr-emit-unbox-fixnum-with dst src (get-value-repr opt-repr)))))

(define (repr-emit-box-flonum-with dst src r)
  (let* ((fl-tag (repr-heap-tag-with 'flonum r))
         (cell-bytes (value-repr-prop r 'pointer ':flonum-cell-bytes 16))
         (fl-offset (value-repr-prop r 'pointer ':flonum-offset (- 8 fl-tag))))
    (if (or (not (repr-requires-boxing-with? r)) (repr-nan-boxed-with? r) (= fl-tag 0))
        ;; Unboxed or NaN-boxed float representation: no heap allocation needed
        (if (equal? dst src)
            '()
            (list (list '%fmov dst src)))
        ;; Heap-allocated boxed flonum cell
        (list (list '%mov dst '%r12)
              (list '%add dst fl-tag)
              (list '%add '%r12 cell-bytes)
              (list '%store-typed 'f64 dst fl-offset src)))))

(define repr-emit-box-flonum
  (case-lambda
    ((dst src) (repr-emit-box-flonum-with dst src (current-value-repr)))
    ((dst src opt-repr) (repr-emit-box-flonum-with dst src (get-value-repr opt-repr)))))

(define (repr-emit-unbox-flonum-with dst src r)
  (let* ((fl-tag (repr-heap-tag-with 'flonum r))
         (fl-offset (value-repr-prop r 'pointer ':flonum-offset (- 8 fl-tag))))
    (if (or (not (repr-requires-boxing-with? r)) (repr-nan-boxed-with? r) (= fl-tag 0))
        (if (equal? dst src)
            '()
            (list (list '%fmov dst src)))
        (list (list '%load-typed 'f64 dst src fl-offset)))))

(define repr-emit-unbox-flonum
  (case-lambda
    ((dst src) (repr-emit-unbox-flonum-with dst src (current-value-repr)))
    ((dst src opt-repr) (repr-emit-unbox-flonum-with dst src (get-value-repr opt-repr)))))

(define (repr-emit-type-tag-check dst src mask expected-tag)
  (let ((mov-prefix (if (equal? dst src) '() (list (list '%mov dst src)))))
    (append mov-prefix
            (list (list '%bit-and dst mask)
                  (list '%cmp dst expected-tag)
                  (list '%set-boolean dst "sete")))))

;;; =======================================================================
;;; Data Plane 64-bit Single-Word Representation & Tag Stripping Engine
;;; Conforms to DSN-33-03 §7.3 & Issue #884
;;; =======================================================================

(define *dataplane-tag-mask* 7)     ; 0b111 (3-bit tag)
(define *dataplane-ptr-mask* -8)    ; 0xFFFFFFFFFFFFFFF8

(define (data-plane-pack-word ptr tag)
  (bitwise-ior (bitwise-and ptr *dataplane-ptr-mask*)
               (bitwise-and tag *dataplane-tag-mask*)))

(define (data-plane-strip-tag word)
  (bitwise-and word *dataplane-ptr-mask*))

(define (data-plane-extract-tag word)
  (bitwise-and word *dataplane-tag-mask*))

(define (data-plane-tag-match? word expected-tag)
  (= (data-plane-extract-tag word) expected-tag))

;; LIR-level Tag Stripping Optimizer:
;; Eliminates redundant type-tag check sequences (%bit-and + %cmp + %set-boolean)
;; when accessing variables that are statically proven to conform to known Data Plane types.
(define (optimize-dataplane-tag-stripping insts known-typed-vars)
  (let loop ((is insts) (acc '()))
    (cond
      ((null? is) (reverse acc))
      ;; Detect pattern:
      ;;   (%bit-and dst src 7)
      ;;   (%cmp dst expected-tag)
      ;;   (%set-boolean dst "sete")
      ((and (pair? is)
            (pair? (cdr is))
            (pair? (cddr is))
            (let ((i1 (car is))
                  (i2 (cadr is))
                  (i3 (caddr is)))
              (and (pair? i1) (eq? (car i1) '%bit-and)
                   (pair? (cdddr i1)) (equal? (cadddr i1) 7)
                   (pair? i2) (eq? (car i2) '%cmp)
                   (pair? i3) (eq? (car i3) '%set-boolean)
                   (let ((src (caddr i1)))
                     (memq src known-typed-vars)))))
       (let* ((i1 (car is))
              (dst (cadr i1))
              (rest (cdddr is)))
         (loop rest (cons (list '%mov dst 1) acc))))
      (else
       (loop (cdr is) (cons (car is) acc))))))
;;; =======================================================================
;;; ULisp Compiler: Scheme Binary Interface (.sbi v2) IR Serialization Engine
;;; Conforms to DSN-33-02, DSN-38, and Issue #839
;;; =======================================================================
;;; Provides:
;;;   1. Portable pure-Scheme FIPS 180-4 SHA-256 checksum engine
;;;   2. Bounded ULEB128 / SLEB128 varint codecs & UTF-8 codecs
;;;   3. Topological Acyclic DAG IR Serializer / Deserializer (".sbi" v2)
;;;      covering CST, HIR (L_src/L_core), MIR (L_anf/L_lifted), Typed LIR
;;;      (L_lir_core/L_lir_canonical including %inline-asm), <source-span>,
;;;      and <binding> records
;;;   4. Precompiled Header (PCH) dependency SHA-256 cache validation
;;;   5. Multi-module LIR Link-Time Optimization (LTO) merger
;;;   6. Legacy text .sbi v1 backward compatibility fallback
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Constants & Structured Error Reporting
;;; -----------------------------------------------------------------------

(define *sbi-magic-0* #x55) ; 'U'
(define *sbi-magic-1* #x53) ; 'S'
(define *sbi-magic-2* #x42) ; 'B'
(define *sbi-magic-3* #x49) ; 'I'
(define *sbi-version* 2)
(define *sbi-header-size* 56)

;; Security bounds (THREAT-839-2)
(define *sbi-max-entries* 1000000)
(define *sbi-max-bytes* 67108864)

;; IR kind codes
(define *sbi-ir-pch* 0)
(define *sbi-ir-cst* 1)
(define *sbi-ir-hir* 2)
(define *sbi-ir-mir* 3)
(define *sbi-ir-lir* 4)
(define *sbi-ir-bundle* 5)

;; DAG Node Type Tags
(define *sbi-tag-nil* #x00)
(define *sbi-tag-bool* #x01)
(define *sbi-tag-fixnum* #x02)
(define *sbi-tag-flonum* #x03)
(define *sbi-tag-char* #x04)
(define *sbi-tag-string* #x05)
(define *sbi-tag-symbol* #x06)
(define *sbi-tag-pair* #x07)
(define *sbi-tag-list* #x08)
(define *sbi-tag-vector* #x09)
(define *sbi-tag-bytevector* #x0A)
(define *sbi-tag-source-span* #x0B)
(define *sbi-tag-binding* #x0C)
(define *sbi-tag-bignum* #x0D)

;; Fixnum range fitting comfortably inside exact double-precision & 64-bit SLEB128
(define *sbi-fixnum-min* -140737488355328)
(define *sbi-fixnum-max* 140737488355327)

(define (sbi-error! msg detail)
  (raise (list 'sbi-error msg detail)))

(define (sbi-mod-pos a m)
  (let ((r (modulo a m)))
    (if (< r 0) (+ r m) r)))

;;; -----------------------------------------------------------------------
;;; 2. Portable Deep Equality & Hash Tables
;;; -----------------------------------------------------------------------
;;; Note: helpers.scm redefines equal? without vector?/bytevector?, so
;;; sbi-equal? provides complete R7RS structural comparison everywhere.

(define (sbi-bytevector=? a b)
  (let ((la (bytevector-length a))
        (lb (bytevector-length b)))
    (if (not (= la lb))
        #f
        (let loop ((i 0))
          (cond
            ((>= i la) #t)
            ((= (bytevector-u8-ref a i) (bytevector-u8-ref b i))
             (loop (+ i 1)))
            (else #f))))))

(define (sbi-equal? a b)
  (cond
    ((eq? a b) #t)
    ((and (number? a) (number? b))
     (and (eq? (exact? a) (exact? b))
          (= a b)))
    ((and (string? a) (string? b))
     (string=? a b))
    ((and (char? a) (char? b))
     (char=? a b))
    ((and (bytevector? a) (bytevector? b))
     (sbi-bytevector=? a b))
    ((and (vector? a) (vector? b))
     (let ((la (vector-length a))
           (lb (vector-length b)))
       (if (not (= la lb))
           #f
           (let loop ((i 0))
             (cond
               ((>= i la) #t)
               ((sbi-equal? (vector-ref a i) (vector-ref b i))
                (loop (+ i 1)))
               (else #f))))))
    ((and (pair? a) (pair? b))
     (and (sbi-equal? (car a) (car b))
          (sbi-equal? (cdr a) (cdr b))))
    (else #f)))

;; Portable FNV-1a-style string & integer-list hashes (kept within 28-bit positive range)
(define (sbi-hash-string s)
  (let ((len (string-length s)))
    (let loop ((i 0) (h 5381))
      (if (>= i len)
          h
          (let ((c (char->integer (string-ref s i))))
            (loop (+ i 1)
                  (sbi-mod-pos (+ (* h 33) c) 268435455)))))))

(define (sbi-hash-int-list ls)
  (let loop ((cur ls) (h 216613626))
    (if (null? cur)
        h
        (loop (cdr cur)
              (sbi-mod-pos (+ (* h 131) (sbi-mod-pos (car cur) 268435455))
                           268435455)))))

(define (sbi-hash-key k)
  (cond
    ((integer? k) (sbi-mod-pos (if (< k 0) (- 0 k) k) 268435455))
    ((string? k) (sbi-hash-string k))
    ((pair? k) (sbi-hash-int-list k))
    (else 0)))

(define (sbi-key=? a b)
  (cond
    ((and (integer? a) (integer? b)) (= a b))
    ((and (string? a) (string? b)) (string=? a b))
    ((and (pair? a) (pair? b))
     (let loop ((xs a) (ys b))
       (cond
         ((and (null? xs) (null? ys)) #t)
         ((or (null? xs) (null? ys) (not (pair? xs)) (not (pair? ys))) #f)
         ((= (car xs) (car ys)) (loop (cdr xs) (cdr ys)))
         (else #f))))
    (else #f)))

;; Hash Table: (vector buckets count cap)
(define (sbi-make-ht initial-cap)
  (vector (make-vector initial-cap '()) 0 initial-cap))

(define (sbi-ht-rehash! ht)
  (let* ((old-b (vector-ref ht 0))
         (old-cap (vector-ref ht 2))
         (new-cap (* old-cap 2))
         (new-b (make-vector new-cap '())))
    (let loop-idx ((i 0))
      (if (< i old-cap)
          (begin
            (let loop-entries ((es (vector-ref old-b i)))
              (if (pair? es)
                  (let* ((e (car es))
                         (h (sbi-mod-pos (sbi-hash-key (car e)) new-cap)))
                    (vector-set! new-b h (cons e (vector-ref new-b h)))
                    (loop-entries (cdr es)))))
            (loop-idx (+ i 1)))))
    (vector-set! ht 0 new-b)
    (vector-set! ht 2 new-cap)))

(define (sbi-ht-ref ht key default-val)
  (let* ((buckets (vector-ref ht 0))
         (cap (vector-ref ht 2))
         (idx (sbi-mod-pos (sbi-hash-key key) cap)))
    (let loop ((es (vector-ref buckets idx)))
      (cond
        ((null? es) default-val)
        ((sbi-key=? (car (car es)) key) (cdr (car es)))
        (else (loop (cdr es)))))))

(define (sbi-ht-set! ht key val)
  (let* ((cap (vector-ref ht 2))
         (count (vector-ref ht 1)))
    (if (> (* (+ count 1) 4) (* cap 3))
        (sbi-ht-rehash! ht))
    (let* ((buckets (vector-ref ht 0))
           (new-cap (vector-ref ht 2))
           (idx (sbi-mod-pos (sbi-hash-key key) new-cap))
           (bucket (vector-ref buckets idx)))
      (let loop ((es bucket))
        (cond
          ((null? es)
           (vector-set! buckets idx (cons (cons key val) bucket))
           (vector-set! ht 1 (+ count 1)))
          ((sbi-key=? (car (car es)) key)
           (set-cdr! (car es) val))
          (else (loop (cdr es))))))))

;;; -----------------------------------------------------------------------
;;; 3. Chunked Mutable Bytebuffer Writer
;;; -----------------------------------------------------------------------

(define *sbi-chunk-size* 4096)

(define (sbi-make-writer)
  ;; (vector cur-bv cur-pos completed-chunks-rev total-len)
  (vector (make-bytevector *sbi-chunk-size* 0) 0 '() 0))

(define (sbi-writer-length w)
  (+ (vector-ref w 3) (vector-ref w 1)))

(define (sbi-buf-u8! w b)
  (let ((pos (vector-ref w 1))
        (bv (vector-ref w 0)))
    (if (>= pos *sbi-chunk-size*)
        (let ((next-bv (make-bytevector *sbi-chunk-size* 0)))
          (vector-set! w 2 (cons (cons bv *sbi-chunk-size*) (vector-ref w 2)))
          (vector-set! w 3 (+ (vector-ref w 3) *sbi-chunk-size*))
          (bytevector-u8-set! next-bv 0 (sbi-mod-pos b 256))
          (vector-set! w 0 next-bv)
          (vector-set! w 1 1))
        (begin
          (bytevector-u8-set! bv pos (sbi-mod-pos b 256))
          (vector-set! w 1 (+ pos 1))))))

(define (sbi-buf-bytes! w src)
  (let ((slen (bytevector-length src)))
    (let loop ((i 0))
      (if (< i slen)
          (begin
            (sbi-buf-u8! w (bytevector-u8-ref src i))
            (loop (+ i 1)))))))

(define (sbi-buf-u16-le! w val)
  (let ((u (sbi-mod-pos val 65536)))
    (sbi-buf-u8! w (modulo u 256))
    (sbi-buf-u8! w (quotient u 256))))

(define (sbi-buf-u32-le! w val)
  (let* ((u (sbi-mod-pos val 4294967296))
         (b0 (modulo u 256))
         (q0 (quotient u 256))
         (b1 (modulo q0 256))
         (q1 (quotient q0 256))
         (b2 (modulo q1 256))
         (b3 (quotient q1 256)))
    (sbi-buf-u8! w b0)
    (sbi-buf-u8! w b1)
    (sbi-buf-u8! w b2)
    (sbi-buf-u8! w b3)))

(define (sbi-writer->bytevector w)
  (let* ((tail-bv (vector-ref w 0))
         (tail-len (vector-ref w 1))
         (chunks (reverse (cons (cons tail-bv tail-len) (vector-ref w 2))))
         (total (+ (vector-ref w 3) tail-len))
         (out (make-bytevector total 0)))
    (let loop ((cs chunks) (off 0))
      (if (null? cs)
          out
          (let* ((c (car cs))
                 (cbv (car c))
                 (clen (cdr c)))
            (let copy-loop ((i 0))
              (if (< i clen)
                  (begin
                    (bytevector-u8-set! out (+ off i) (bytevector-u8-ref cbv i))
                    (copy-loop (+ i 1)))))
            (loop (cdr cs) (+ off clen)))))))

;;; -----------------------------------------------------------------------
;;; 4. Bounded ULEB128 / SLEB128 Varint Codecs
;;; -----------------------------------------------------------------------

(define (sbi-buf-uleb128! w n)
  (if (< n 0)
      (sbi-error! "sbi-buf-uleb128!: negative value" n))
  (let loop ((val n))
    (let ((b (modulo val 128))
          (rest (quotient val 128)))
      (if (= rest 0)
          (sbi-buf-u8! w b)
          (begin
            (sbi-buf-u8! w (+ b 128))
            (loop rest))))))

(define (sbi-buf-sleb128! w n)
  (let loop ((val n))
    (let* ((byte (sbi-mod-pos val 128))
           (q (quotient (- val byte) 128))
           (sign-bit (>= byte 64))
           (done? (or (and (= q 0) (not sign-bit))
                      (and (= q -1) sign-bit))))
      (if done?
          (sbi-buf-u8! w byte)
          (begin
            (sbi-buf-u8! w (+ byte 128))
            (loop q))))))

(define (sbi-write-uleb128 n)
  (let ((w (sbi-make-writer)))
    (sbi-buf-uleb128! w n)
    (sbi-writer->bytevector w)))

(define (sbi-write-sleb128 n)
  (let ((w (sbi-make-writer)))
    (sbi-buf-sleb128! w n)
    (sbi-writer->bytevector w)))

(define (sbi-read-uleb128 bv offset)
  (let ((len (bytevector-length bv)))
    (let loop ((pos offset) (shift 0) (acc 0) (pow 1))
      (if (>= shift 64)
          (sbi-error! "ULEB128 integer overflow (>64 bits)" pos))
      (if (>= pos len)
          (sbi-error! "Unexpected EOF while reading ULEB128" pos))
      (let ((b (bytevector-u8-ref bv pos)))
        (if (< b 128)
            (cons (+ acc (* b pow)) (+ pos 1))
            (loop (+ pos 1)
                  (+ shift 7)
                  (+ acc (* (- b 128) pow))
                  (* pow 128)))))))

(define (sbi-read-sleb128 bv offset)
  (let ((len (bytevector-length bv)))
    (let loop ((pos offset) (shift 0) (acc 0) (pow 1))
      (if (>= shift 64)
          (sbi-error! "SLEB128 integer overflow (>64 bits)" pos))
      (if (>= pos len)
          (sbi-error! "Unexpected EOF while reading SLEB128" pos))
      (let* ((b (bytevector-u8-ref bv pos))
             (low (modulo b 128))
             (next-acc (+ acc (* low pow)))
             (next-pow (* pow 128)))
        (if (< b 128)
            (let ((val (if (>= b 64) (- next-acc next-pow) next-acc)))
              (cons val (+ pos 1)))
            (loop (+ pos 1) (+ shift 7) next-acc next-pow))))))

;;; -----------------------------------------------------------------------
;;; 5. Portable UTF-8 Encoder & Decoder
;;; -----------------------------------------------------------------------

(define (sbi-string->utf8-bytes str)
  (let* ((slen (string-length str))
         (ascii? (let check ((i 0))
                   (cond
                     ((>= i slen) #t)
                     ((< (char->integer (string-ref str i)) 128) (check (+ i 1)))
                     (else #f)))))
    (if ascii?
        (let ((bv (make-bytevector slen 0)))
          (let loop ((i 0))
            (if (< i slen)
                (begin
                  (bytevector-u8-set! bv i (char->integer (string-ref str i)))
                  (loop (+ i 1)))))
          bv)
        (let ((w (sbi-make-writer)))
          (let loop ((i 0))
            (if (< i slen)
                (let ((cp (char->integer (string-ref str i))))
                  (cond
                    ((< cp #x80)
                     (sbi-buf-u8! w cp))
                    ((< cp #x800)
                     (sbi-buf-u8! w (+ #xC0 (quotient cp 64)))
                     (sbi-buf-u8! w (+ #x80 (modulo cp 64))))
                    ((< cp #x10000)
                     (sbi-buf-u8! w (+ #xE0 (quotient cp 4096)))
                     (sbi-buf-u8! w (+ #x80 (modulo (quotient cp 64) 64)))
                     (sbi-buf-u8! w (+ #x80 (modulo cp 64))))
                    (else
                     (sbi-buf-u8! w (+ #xF0 (quotient cp 262144)))
                     (sbi-buf-u8! w (+ #x80 (modulo (quotient cp 4096) 64)))
                     (sbi-buf-u8! w (+ #x80 (modulo (quotient cp 64) 64)))
                     (sbi-buf-u8! w (+ #x80 (modulo cp 64)))))
                  (loop (+ i 1)))))
          (sbi-writer->bytevector w)))))

(define (sbi-utf8-slice->string bv start end)
  (let ((blen (bytevector-length bv)))
    (if (or (< start 0) (< end start) (> end blen))
        (sbi-error! "UTF-8 slice out of bounds" (list start end blen)))
    (let ((ascii? (let check ((i start))
                    (cond
                      ((>= i end) #t)
                      ((< (bytevector-u8-ref bv i) 128) (check (+ i 1)))
                      (else #f)))))
      (if ascii?
          (let* ((slen (- end start))
                 (s (make-string slen)))
            (let loop ((i 0))
              (if (< i slen)
                  (begin
                    (string-set! s i (integer->char (bytevector-u8-ref bv (+ start i))))
                    (loop (+ i 1)))))
            s)
          (let loop ((i start) (acc '()))
            (if (>= i end)
                (list->string (reverse acc))
                (let ((b0 (bytevector-u8-ref bv i)))
                  (cond
                    ((< b0 #x80)
                     (loop (+ i 1) (cons (integer->char b0) acc)))
                    ((and (>= b0 #xC2) (<= b0 #xDF) (< (+ i 1) end))
                     (let ((b1 (bytevector-u8-ref bv (+ i 1))))
                       (if (not (= (quotient b1 64) 2))
                           (sbi-error! "Malformed 2-byte UTF-8 sequence" i))
                       (loop (+ i 2)
                             (cons (integer->char (+ (* (- b0 #xC0) 64) (- b1 #x80)))
                                   acc))))
                    ((and (>= b0 #xE0) (<= b0 #xEF) (< (+ i 2) end))
                     (let ((b1 (bytevector-u8-ref bv (+ i 1)))
                           (b2 (bytevector-u8-ref bv (+ i 2))))
                       (if (or (not (= (quotient b1 64) 2))
                               (not (= (quotient b2 64) 2)))
                           (sbi-error! "Malformed 3-byte UTF-8 sequence" i))
                       (loop (+ i 3)
                             (cons (integer->char (+ (* (- b0 #xE0) 4096)
                                                     (+ (* (- b1 #x80) 64) (- b2 #x80))))
                                   acc))))
                    ((and (>= b0 #xF0) (<= b0 #xF4) (< (+ i 3) end))
                     (let ((b1 (bytevector-u8-ref bv (+ i 1)))
                           (b2 (bytevector-u8-ref bv (+ i 2)))
                           (b3 (bytevector-u8-ref bv (+ i 3))))
                       (if (or (not (= (quotient b1 64) 2))
                               (not (= (quotient b2 64) 2))
                               (not (= (quotient b3 64) 2)))
                           (sbi-error! "Malformed 4-byte UTF-8 sequence" i))
                       (loop (+ i 4)
                             (cons (integer->char (+ (* (- b0 #xF0) 262144)
                                                     (+ (* (- b1 #x80) 4096)
                                                        (+ (* (- b2 #x80) 64) (- b3 #x80)))))
                                   acc))))
                    (else
                     (sbi-error! "Invalid UTF-8 byte sequence in SBI pool" i))))))))))

;;; -----------------------------------------------------------------------
;;; 6. Portable Pure-Scheme FIPS 180-4 SHA-256 Checksum Engine
;;; -----------------------------------------------------------------------

(define *sbi-pow2*
  (let ((v (make-vector 33 1)))
    (let loop ((i 1) (p 1))
      (if (<= i 32)
          (let ((np (* p 2)))
            (vector-set! v i np)
            (loop (+ i 1) np))))
    v))

(define (sbi-u32-add a b)
  (bitwise-and (+ a b) 4294967295))

(define (sbi-u32-rotr x n)
  (let* ((p (vector-ref *sbi-pow2* n))
         (q (quotient x p))
         (r (bitwise-and x (- p 1))))
    (+ (* r (vector-ref *sbi-pow2* (- 32 n))) q)))

(define (sbi-u32-shr x n)
  (quotient x (vector-ref *sbi-pow2* n)))

(define (sbi-u32-and x y)
  (bitwise-and x y))

(define (sbi-u32-xor x y)
  (- (bitwise-ior x y) (bitwise-and x y)))

(define (sbi-u32-xor3 x y z)
  (let ((xy (- (bitwise-ior x y) (bitwise-and x y))))
    (- (bitwise-ior xy z) (bitwise-and xy z))))

(define (sbi-sha256-sigma0 x)
  (let* ((q3 (quotient x 8))
         (q7 (quotient q3 16))
         (r7 (+ (* (bitwise-and x 127) 33554432) q7))
         (q18 (quotient q7 2048))
         (r18 (+ (* (bitwise-and x 262143) 16384) q18)))
    (sbi-u32-xor3 r7 r18 q3)))

(define (sbi-sha256-sigma1 x)
  (let* ((q10 (quotient x 1024))
         (q17 (quotient q10 128))
         (r17 (+ (* (bitwise-and x 131071) 32768) q17))
         (q19 (quotient q17 4))
         (r19 (+ (* (bitwise-and x 524287) 8192) q19)))
    (sbi-u32-xor3 r17 r19 q10)))

(define (sbi-sha256-Sigma0 x)
  (let* ((q2 (quotient x 4))
         (r2 (+ (* (bitwise-and x 3) 1073741824) q2))
         (q13 (quotient q2 2048))
         (r13 (+ (* (bitwise-and x 8191) 524288) q13))
         (q22 (quotient q13 512))
         (r22 (+ (* (bitwise-and x 4194303) 1024) q22)))
    (sbi-u32-xor3 r2 r13 r22)))

(define (sbi-sha256-Sigma1 x)
  (let* ((q6 (quotient x 64))
         (r6 (+ (* (bitwise-and x 63) 67108864) q6))
         (q11 (quotient q6 32))
         (r11 (+ (* (bitwise-and x 2047) 2097152) q11))
         (q25 (quotient q11 16384))
         (r25 (+ (* (bitwise-and x 33554431) 128) q25)))
    (sbi-u32-xor3 r6 r11 r25)))

(define *sbi-sha256-k*
  (vector
    #x428a2f98 #x71374491 #xb5c0fbcf #xe9b5dba5 #x3956c25b #x59f111f1 #x923f82a4 #xab1c5ed5
    #xd807aa98 #x12835b01 #x243185be #x550c7dc3 #x72be5d74 #x80deb1fe #x9bdc06a7 #xc19bf174
    #xe49b69c1 #xefbe4786 #x0fc19dc6 #x240ca1cc #x2de92c6f #x4a7484aa #x5cb0a9dc #x76f988da
    #x983e5152 #xa831c66d #xb00327c8 #xbf597fc7 #xc6e00bf3 #xd5a79147 #x06ca6351 #x14292967
    #x27b70a85 #x2e1b2138 #x4d2c6dfc #x53380d13 #x650a7354 #x766a0abb #x81c2c92e #x92722c85
    #xa2bfe8a1 #xa81a664b #xc24b8b70 #xc76c51a3 #xd192e819 #xd6990624 #xf40e3585 #x106aa070
    #x19a4c116 #x1e376c08 #x2748774c #x34b0bcb5 #x391c0cb3 #x4ed8aa4a #x5b9cca4f #x682e6ff3
    #x748f82ee #x78a5636f #x84c87814 #x8cc70208 #x90befffa #xa4506ceb #xbef9a3f7 #xc67178f2))

(define (sbi-sha256-pad-bytevector bv start-off total-len)
  (let* ((rem (- total-len start-off))
         (mod64 (modulo (+ rem 9) 64))
         (pad-zeros (if (= mod64 0) 0 (- 64 mod64)))
         (padded-len (+ (+ (+ rem 1) pad-zeros) 8))
         (out (make-bytevector padded-len 0)))
    (let copy-loop ((i 0))
      (if (< i rem)
          (begin
            (bytevector-u8-set! out i (bytevector-u8-ref bv (+ start-off i)))
            (copy-loop (+ i 1)))))
    (bytevector-u8-set! out rem #x80)
    ;; Append 64-bit big-endian bit length
    (let ((bit-len (* rem 8))
          (tail-pos (- padded-len 8)))
      (let bit-loop ((k 7) (v bit-len))
        (if (>= k 0)
            (begin
              (bytevector-u8-set! out (+ tail-pos k) (modulo v 256))
              (bit-loop (- k 1) (quotient v 256))))))
    out))

(define (sbi-sha256-bytevector-range bv start-off end-off)
  (let* ((padded (sbi-sha256-pad-bytevector bv start-off end-off))
         (plen (bytevector-length padded))
         (num-blocks (quotient plen 64))
         (h (vector #x6a09e667 #xbb67ae85 #x3c6ef372 #xa54ff53a
                    #x510e527f #x9b05688c #x1f83d9ab #x5be0cd19))
         (w (make-vector 64 0)))
    (let block-loop ((blk 0))
      (if (< blk num-blocks)
          (let ((base (* blk 64)))
            ;; W[0..15] from big-endian 32-bit words
            (let load-loop ((i 0))
              (if (< i 16)
                  (let* ((p (+ base (* i 4)))
                         (wval (+ (+ (* (bytevector-u8-ref padded p) 16777216)
                                     (* (bytevector-u8-ref padded (+ p 1)) 65536))
                                  (+ (* (bytevector-u8-ref padded (+ p 2)) 256)
                                     (bytevector-u8-ref padded (+ p 3))))))
                    (vector-set! w i wval)
                    (load-loop (+ i 1)))))
            ;; W[16..63]
            (let exp-loop ((i 16))
              (if (< i 64)
                  (let* ((w15 (vector-ref w (- i 15)))
                         (w2 (vector-ref w (- i 2)))
                         (s0 (sbi-sha256-sigma0 w15))
                         (s1 (sbi-sha256-sigma1 w2))
                         (wval (sbi-u32-add
                                 (sbi-u32-add (vector-ref w (- i 16)) s0)
                                 (sbi-u32-add (vector-ref w (- i 7)) s1))))
                    (vector-set! w i wval)
                    (exp-loop (+ i 1)))))
            ;; Compression rounds
            (let round-loop ((i 0)
                             (a (vector-ref h 0)) (b (vector-ref h 1))
                             (c (vector-ref h 2)) (d (vector-ref h 3))
                             (e (vector-ref h 4)) (f (vector-ref h 5))
                             (g (vector-ref h 6)) (hh (vector-ref h 7)))
              (if (< i 64)
                  (let* ((S1 (sbi-sha256-Sigma1 e))
                         ;; Ch(e,f,g) = g ^ (e & (f ^ g))
                         (ch (sbi-u32-xor g (sbi-u32-and e (sbi-u32-xor f g))))
                         (temp1 (sbi-u32-add
                                  (sbi-u32-add hh S1)
                                  (sbi-u32-add
                                    (sbi-u32-add ch (vector-ref *sbi-sha256-k* i))
                                    (vector-ref w i))))
                         (S0 (sbi-sha256-Sigma0 a))
                         ;; Maj(a,b,c) = (a & b) + ((a ^ b) & c)
                         (maj (+ (sbi-u32-and a b)
                                 (sbi-u32-and (sbi-u32-xor a b) c)))
                         (temp2 (sbi-u32-add S0 maj)))
                    (round-loop (+ i 1)
                                (sbi-u32-add temp1 temp2) a b c
                                (sbi-u32-add d temp1) e f g))
                  (begin
                    (vector-set! h 0 (sbi-u32-add (vector-ref h 0) a))
                    (vector-set! h 1 (sbi-u32-add (vector-ref h 1) b))
                    (vector-set! h 2 (sbi-u32-add (vector-ref h 2) c))
                    (vector-set! h 3 (sbi-u32-add (vector-ref h 3) d))
                    (vector-set! h 4 (sbi-u32-add (vector-ref h 4) e))
                    (vector-set! h 5 (sbi-u32-add (vector-ref h 5) f))
                    (vector-set! h 6 (sbi-u32-add (vector-ref h 6) g))
                    (vector-set! h 7 (sbi-u32-add (vector-ref h 7) hh)))))
            (block-loop (+ blk 1)))))
    ;; Pack 8x u32 big-endian words into 32-byte digest
    (let ((digest (make-bytevector 32 0)))
      (let pack-loop ((i 0))
        (if (< i 8)
            (let* ((word (vector-ref h i))
                   (base (* i 4))
                   (b3 (quotient word 16777216)) (r3 (- word (* b3 16777216)))
                   (b2 (quotient r3 65536))      (r2 (- r3 (* b2 65536)))
                   (b1 (quotient r2 256))        (b0 (- r2 (* b1 256))))
              (bytevector-u8-set! digest base b3)
              (bytevector-u8-set! digest (+ base 1) b2)
              (bytevector-u8-set! digest (+ base 2) b1)
              (bytevector-u8-set! digest (+ base 3) b0)
              (pack-loop (+ i 1)))))
      digest)))

(define (sbi-sha256-bytevector bv)
  (sbi-sha256-bytevector-range bv 0 (bytevector-length bv)))

(define (sbi-sha256-string str)
  (sbi-sha256-bytevector (sbi-string->utf8-bytes str)))

(define (sbi-bytes->hex bv)
  (let* ((hex-chars "0123456789abcdef")
         (len (bytevector-length bv))
         (out (make-string (* len 2))))
    (let loop ((i 0))
      (if (< i len)
          (let ((b (bytevector-u8-ref bv i)))
            (string-set! out (* i 2) (string-ref hex-chars (quotient b 16)))
            (string-set! out (+ (* i 2) 1) (string-ref hex-chars (modulo b 16)))
            (loop (+ i 1)))))
    out))

(define (sbi-sha256-hex x)
  (cond
    ((bytevector? x) (sbi-bytes->hex (sbi-sha256-bytevector x)))
    ((string? x) (sbi-bytes->hex (sbi-sha256-string x)))
    (else (sbi-error! "sbi-sha256-hex: expected bytevector or string" x))))

;;; -----------------------------------------------------------------------
;;; 7. Binary File I/O Helpers & Dependency Path Security
;;; -----------------------------------------------------------------------

(define (sbi-coerce-path path)
  (if (and (string? path) (> (string-length path) 0))
      (symbol->string (string->symbol path))
      path))

(define (sbi-read-file-bytes path)
  (let ((port (guard (ex (else #f)) (open-binary-input-file (sbi-coerce-path path)))))
    (if (not port)
        #f
        (let ((w (sbi-make-writer)))
          (guard (ex (else
                       (guard (ex2 (else #f)) (close-input-port port))
                       (sbi-writer->bytevector w)))
            (let loop ()
              (let ((b (read-u8 port)))
                (if (eof-object? b)
                    (begin
                      (guard (ex (else #f)) (close-input-port port))
                      (sbi-writer->bytevector w))
                    (begin
                      (sbi-buf-u8! w b)
                      (loop))))))))))

(define (sbi-write-file-bytes path bv)
  (let ((port (open-binary-output-file (sbi-coerce-path path))))
    (write-bytevector bv port)
    (close-output-port port)
    #t))

(define (sbi-sha256-file path)
  (let ((bytes (sbi-read-file-bytes path)))
    (if bytes
        (sbi-sha256-bytevector bytes)
        #f)))

(define (sbi-safe-dep-path? p)
  (if (or (not (string? p)) (= (string-length p) 0))
      #f
      (let ((len (string-length p)))
        (let loop ((i 0))
          (cond
            ((>= i len) #t)
            ((= (char->integer (string-ref p i)) 0) #f)
            ((and (char=? (string-ref p i) #\.)
                  (< (+ i 1) len)
                  (char=? (string-ref p (+ i 1)) #\.))
             (let ((prev-sep? (or (= i 0)
                                  (char=? (string-ref p (- i 1)) #\/)
                                  (char=? (string-ref p (- i 1)) #\\)))
                   (next-sep? (or (= (+ i 2) len)
                                  (char=? (string-ref p (+ i 2)) #\/)
                                  (char=? (string-ref p (+ i 2)) #\\))))
               (if (and prev-sep? next-sep?)
                   #f
                   (loop (+ i 1)))))
            (else (loop (+ i 1))))))))

(define (sbi-ir-kind->code kind)
  (cond
    ((integer? kind)
     (if (and (>= kind 0) (<= kind 5))
         kind
         (sbi-error! "Invalid SBI IR kind code" kind)))
    ((eq? kind 'pch) *sbi-ir-pch*)
    ((eq? kind 'cst) *sbi-ir-cst*)
    ((eq? kind 'hir) *sbi-ir-hir*)
    ((eq? kind 'mir) *sbi-ir-mir*)
    ((eq? kind 'lir) *sbi-ir-lir*)
    ((eq? kind 'bundle) *sbi-ir-bundle*)
    (else (sbi-error! "Unknown SBI IR kind symbol" kind))))

(define (sbi-code->ir-kind code)
  (cond
    ((= code *sbi-ir-pch*) 'pch)
    ((= code *sbi-ir-cst*) 'cst)
    ((= code *sbi-ir-hir*) 'hir)
    ((= code *sbi-ir-mir*) 'mir)
    ((= code *sbi-ir-lir*) 'lir)
    ((= code *sbi-ir-bundle*) 'bundle)
    (else (sbi-error! "Unsupported SBI IR kind code in header" code))))

;;; -----------------------------------------------------------------------
;;; 8. Acyclic DAG IR Serializer (.sbi v2 Writer)
;;; -----------------------------------------------------------------------

(define (sbi-split-list xs)
  (let loop ((cur xs) (steps 0) (acc '()))
    (cond
      ((>= steps *sbi-max-entries*)
       (sbi-error! "SBI serialization exceeded maximum list length / cycle guard" steps))
      ((null? cur)
       (cons #t (reverse acc)))
      ((pair? cur)
       ;; Break before descending into a <binding> inside an improper tail
       (if (and (> steps 0) (binding? cur))
           (cons #f (cons cur acc))
           (loop (cdr cur) (+ steps 1) (cons (car cur) acc))))
      (else
       (cons #f (cons cur acc))))))

(define (sbi-normalize-deps deps)
  (if (not (list? deps))
      (sbi-error! "sbi-serialize: deps must be a list" deps))
  (let loop ((ds deps) (acc '()))
    (if (null? ds)
        (reverse acc)
        (let ((d (car ds)))
          (cond
            ((string? d)
             (if (not (sbi-safe-dep-path? d))
                 (sbi-error! "Path traversal rejected in SBI dependency path" d))
             (let ((h (sbi-sha256-file d)))
               (if (not h)
                   (sbi-error! "Missing dependency file when building SBI header checksum" d))
               (loop (cdr ds) (cons (cons d h) acc))))
            ((and (pair? d) (string? (car d)) (bytevector? (cdr d))
                  (= (bytevector-length (cdr d)) 32))
             (if (not (sbi-safe-dep-path? (car d)))
                 (sbi-error! "Path traversal rejected in SBI dependency path" (car d)))
             (loop (cdr ds) (cons d acc)))
            (else
             (sbi-error! "Invalid dependency entry (expected path string or (path . 32B-sha256))" d)))))))

(define (sbi-make-enc-state)
  ;; #(sym-ht sym-count sym-writer node-ht node-count node-writer
  ;;   nil-idx false-idx true-idx fix-ht symnode-ht strnode-ht char-ht has-spans? has-bindings?)
  (vector (sbi-make-ht 128)
          0
          (sbi-make-writer)
          (sbi-make-ht 256)
          0
          (sbi-make-writer)
          -1
          -1
          -1
          (sbi-make-ht 64)
          (sbi-make-ht 128)
          (sbi-make-ht 64)
          (sbi-make-ht 32)
          #f
          #f))

(define (sbi-intern-string! st str)
  (let ((sym-ht (vector-ref st 0)))
    (let ((existing (sbi-ht-ref sym-ht str #f)))
      (if existing
          existing
          (let ((idx (vector-ref st 1))
                (sw (vector-ref st 2))
                (utf8 (sbi-string->utf8-bytes str)))
            (if (>= idx *sbi-max-entries*)
                (sbi-error! "SBI string pool exceeded max entries" idx))
            (sbi-buf-uleb128! sw (bytevector-length utf8))
            (sbi-buf-bytes! sw utf8)
            (sbi-ht-set! sym-ht str idx)
            (vector-set! st 1 (+ idx 1))
            idx)))))

(define (sbi-alloc-node-idx! st)
  (let ((idx (vector-ref st 4)))
    (if (>= idx *sbi-max-entries*)
        (sbi-error! "SBI DAG node table exceeded max entries" idx))
    (vector-set! st 4 (+ idx 1))
    idx))

(define (sbi-encode-compound-node! st key emit-fn)
  (let* ((node-ht (vector-ref st 3))
         (existing (sbi-ht-ref node-ht key #f)))
    (if existing
        existing
        (let ((idx (sbi-alloc-node-idx! st)))
          (emit-fn (vector-ref st 5))
          (sbi-ht-set! node-ht key idx)
          idx))))

(define (%sbi-make-pos-inf)
  (let loop ((i 0) (v 2.0))
    (if (= i 10) v (loop (+ i 1) (* v v)))))

(define (%sbi-canonical-flonum-string x)
  (cond
    ((not (= x x)) "+nan.0")
    ((and (not (= x 0.0)) (= x (* 2.0 x)))
     (if (< x 0.0) "-inf.0" "+inf.0"))
    (else
     (let* ((s (number->string x))
            (n (string-length s))
            (e-pos
             (let loop ((i 0))
               (if (>= i n)
                   #f
                   (let ((c (string-ref s i)))
                     (if (or (char=? c #\e) (char=? c #\E)
                             (char=? c #\d) (char=? c #\D)
                             (char=? c #\f) (char=? c #\F))
                         i
                         (loop (+ i 1))))))))
       (if (not e-pos)
           s
           (let* ((mant (substring s 0 e-pos))
                  (after (+ e-pos 1))
                  (has-sign? (and (< after n)
                                  (or (char=? (string-ref s after) #\+)
                                      (char=? (string-ref s after) #\-))))
                  (neg-exp? (and has-sign? (char=? (string-ref s after) #\-)))
                  (dstart (if has-sign? (+ after 1) after))
                  (digits
                   (let skip0 ((j dstart))
                     (cond
                       ((>= j n) "0")
                       ((and (char=? (string-ref s j) #\0) (< (+ j 1) n))
                        (skip0 (+ j 1)))
                       (else (substring s j n))))))
             (string-append mant "e" (if neg-exp? "-" "") digits)))))))

(define (sbi-emit-node! st x depth)
  (if (> depth 4096)
      (sbi-error! "SBI DAG nesting depth limit exceeded (possible cycle)" depth))
  (cond
    ((null? x)
     (let ((c (vector-ref st 6)))
       (if (>= c 0)
           c
           (let ((idx (sbi-alloc-node-idx! st)))
             (sbi-buf-u8! (vector-ref st 5) *sbi-tag-nil*)
             (vector-set! st 6 idx)
             idx))))

    ((boolean? x)
     (let* ((slot (if x 8 7))
            (c (vector-ref st slot)))
       (if (>= c 0)
           c
           (let ((idx (sbi-alloc-node-idx! st)))
             (sbi-buf-u8! (vector-ref st 5) *sbi-tag-bool*)
             (sbi-buf-u8! (vector-ref st 5) (if x 1 0))
             (vector-set! st slot idx)
             idx))))

    ;; <source-span> MUST precede (vector? x) because it is an SRFI-9 vector record
    ((source-span? x)
     (vector-set! st 13 #t)
     (let* ((f-idx (sbi-emit-node! st (span-file x) (+ depth 1)))
            (mo-idx (sbi-emit-node! st (span-macro-origin x) (+ depth 1)))
            (sl (span-start-line x))
            (sc (span-start-col x))
            (el (span-end-line x))
            (ec (span-end-col x))
            (nid (span-node-id x))
            (sline (if (and (integer? sl) (>= sl 0)) sl 1))
            (scol (if (and (integer? sc) (>= sc 0)) sc 1))
            (eline (if (and (integer? el) (>= el 0)) el 1))
            (ecol (if (and (integer? ec) (>= ec 0)) ec 1))
            (n-id (if (integer? nid) nid 0))
            (key (list *sbi-tag-source-span* f-idx sline scol eline ecol mo-idx n-id)))
       (sbi-encode-compound-node! st key
         (lambda (nw)
           (sbi-buf-u8! nw *sbi-tag-source-span*)
           (sbi-buf-uleb128! nw f-idx)
           (sbi-buf-uleb128! nw sline)
           (sbi-buf-uleb128! nw scol)
           (sbi-buf-uleb128! nw eline)
           (sbi-buf-uleb128! nw ecol)
           (sbi-buf-uleb128! nw mo-idx)
           (sbi-buf-sleb128! nw n-id)))))

    ;; <binding> MUST precede (pair? x) because it is a tagged list
    ((binding? x)
     (vector-set! st 14 #t)
     (let* ((bid (binding-id x))
            (sname-idx (sbi-emit-node! st (binding-source-name x) (+ depth 1)))
            (usym-idx (sbi-emit-node! st (binding-unique-sym x) (+ depth 1)))
            (kind-idx (sbi-emit-node! st (binding-kind x) (+ depth 1)))
            (ns-idx (sbi-emit-node! st (binding-namespace x) (+ depth 1)))
            (sid (let ((v (binding-scope-id x))) (if (integer? v) v 0)))
            (sc-idx (sbi-emit-node! st (binding-storage-class x) (+ depth 1)))
            (ty-idx (sbi-emit-node! st (binding-type-attr x) (+ depth 1)))
            (vis-idx (sbi-emit-node! st (binding-visibility x) (+ depth 1)))
            (sset-idx (sbi-emit-node! st (binding-scope-set x) (+ depth 1)))
            (span-idx (sbi-emit-node! st (binding-source-span x) (+ depth 1)))
            (key (list *sbi-tag-binding* bid sname-idx usym-idx kind-idx ns-idx
                       sid sc-idx ty-idx vis-idx sset-idx span-idx)))
       (sbi-encode-compound-node! st key
         (lambda (nw)
           (sbi-buf-u8! nw *sbi-tag-binding*)
           (sbi-buf-uleb128! nw bid)
           (sbi-buf-uleb128! nw sname-idx)
           (sbi-buf-uleb128! nw usym-idx)
           (sbi-buf-uleb128! nw kind-idx)
           (sbi-buf-uleb128! nw ns-idx)
           (sbi-buf-sleb128! nw sid)
           (sbi-buf-uleb128! nw sc-idx)
           (sbi-buf-uleb128! nw ty-idx)
           (sbi-buf-uleb128! nw vis-idx)
           (sbi-buf-uleb128! nw sset-idx)
           (sbi-buf-uleb128! nw span-idx)))))

    ((symbol? x)
     (let* ((sidx (sbi-intern-string! st (symbol->string x)))
            (sym-node-ht (vector-ref st 10))
            (existing (sbi-ht-ref sym-node-ht sidx #f)))
       (if existing
           existing
           (let ((idx (sbi-alloc-node-idx! st))
                 (nw (vector-ref st 5)))
             (sbi-buf-u8! nw *sbi-tag-symbol*)
             (sbi-buf-uleb128! nw sidx)
             (sbi-ht-set! sym-node-ht sidx idx)
             idx))))

    ((string? x)
     (let* ((sidx (sbi-intern-string! st x))
            (str-node-ht (vector-ref st 11))
            (existing (sbi-ht-ref str-node-ht sidx #f)))
       (if existing
           existing
           (let ((idx (sbi-alloc-node-idx! st))
                 (nw (vector-ref st 5)))
             (sbi-buf-u8! nw *sbi-tag-string*)
             (sbi-buf-uleb128! nw sidx)
             (sbi-ht-set! str-node-ht sidx idx)
             idx))))

    ((char? x)
     (let* ((cp (char->integer x))
            (cht (vector-ref st 12))
            (existing (sbi-ht-ref cht cp #f)))
       (if existing
           existing
           (let ((idx (sbi-alloc-node-idx! st))
                 (nw (vector-ref st 5)))
             (sbi-buf-u8! nw *sbi-tag-char*)
             (sbi-buf-uleb128! nw cp)
             (sbi-ht-set! cht cp idx)
             idx))))

    ((number? x)
     (cond
       ((and (exact? x) (integer? x) (>= x *sbi-fixnum-min*) (<= x *sbi-fixnum-max*))
        (let* ((fht (vector-ref st 9))
               (existing (sbi-ht-ref fht x #f)))
          (if existing
              existing
              (let ((idx (sbi-alloc-node-idx! st))
                    (nw (vector-ref st 5)))
                (sbi-buf-u8! nw *sbi-tag-fixnum*)
                (sbi-buf-sleb128! nw x)
                (sbi-ht-set! fht x idx)
                idx))))
       ((or (inexact? x)
            (and (vector? x) (= (vector-length x) 2) (eq? (vector-ref x 0) 'ulisp-flonum-tag)))
        (let* ((sidx (sbi-intern-string! st (%sbi-canonical-flonum-string x)))
               (key (list *sbi-tag-flonum* sidx)))
          (sbi-encode-compound-node! st key
            (lambda (nw)
              (sbi-buf-u8! nw *sbi-tag-flonum*)
              (sbi-buf-uleb128! nw sidx)))))
       (else
        (let* ((sidx (sbi-intern-string! st (number->string x)))
               (key (list *sbi-tag-bignum* sidx)))
          (sbi-encode-compound-node! st key
            (lambda (nw)
              (sbi-buf-u8! nw *sbi-tag-bignum*)
              (sbi-buf-uleb128! nw sidx)))))))

    ((bytevector? x)
     (let ((idx (sbi-alloc-node-idx! st))
           (nw (vector-ref st 5)))
       (sbi-buf-u8! nw *sbi-tag-bytevector*)
       (sbi-buf-uleb128! nw (bytevector-length x))
       (sbi-buf-bytes! nw x)
       idx))

    ((vector? x)
     (let ((vlen (vector-length x)))
       (let loop ((i 0) (rev-idxs '()))
         (if (< i vlen)
             (loop (+ i 1)
                   (cons (sbi-emit-node! st (vector-ref x i) (+ depth 1))
                         rev-idxs))
             (let* ((elem-idxs (reverse rev-idxs))
                    (key (cons *sbi-tag-vector* (cons vlen elem-idxs))))
               (sbi-encode-compound-node! st key
                 (lambda (nw)
                   (sbi-buf-u8! nw *sbi-tag-vector*)
                   (sbi-buf-uleb128! nw vlen)
                   (for-each (lambda (ei) (sbi-buf-uleb128! nw ei)) elem-idxs))))))))

    ((pair? x)
     (let ((split (sbi-split-list x)))
       (if (car split)
           ;; Proper list (O(1) recursion depth along the spine!)
           (let ((elems (cdr split)))
             (let loop ((es elems) (cnt 0) (rev-idxs '()))
               (if (pair? es)
                   (loop (cdr es)
                         (+ cnt 1)
                         (cons (sbi-emit-node! st (car es) (+ depth 1))
                               rev-idxs))
                   (let* ((elem-idxs (reverse rev-idxs))
                          (key (cons *sbi-tag-list* (cons cnt elem-idxs))))
                     (sbi-encode-compound-node! st key
                       (lambda (nw)
                         (sbi-buf-u8! nw *sbi-tag-list*)
                         (sbi-buf-uleb128! nw cnt)
                         (for-each (lambda (ei) (sbi-buf-uleb128! nw ei)) elem-idxs)))))))
           ;; Dotted pair spine: (cdr split) is (tail rev-elems...)
           (let* ((rev-all (cdr split))
                  (tail-datum (car rev-all))
                  (rev-heads (cdr rev-all))
                  (init-cdr-idx (sbi-emit-node! st tail-datum (+ depth 1))))
             (let loop ((hs rev-heads) (cur-cdr-idx init-cdr-idx))
               (if (null? hs)
                   cur-cdr-idx
                   (let* ((car-idx (sbi-emit-node! st (car hs) (+ depth 1)))
                          (key (list *sbi-tag-pair* car-idx cur-cdr-idx))
                          (pair-idx
                            (sbi-encode-compound-node! st key
                              (lambda (nw)
                                (sbi-buf-u8! nw *sbi-tag-pair*)
                                (sbi-buf-uleb128! nw car-idx)
                                (sbi-buf-uleb128! nw cur-cdr-idx)))))
                     (loop (cdr hs) pair-idx))))))))

    (else
     (sbi-error! "Unsupported Scheme object type in SBI serializer" x))))

(define (sbi-serialize-impl ir rest)
  (let* ((ir-kind (if (pair? rest) (sbi-ir-kind->code (car rest)) *sbi-ir-hir*))
         (raw-deps (if (and (pair? rest) (pair? (cdr rest))) (cadr rest) '()))
         (deps (sbi-normalize-deps raw-deps))
         (st (sbi-make-enc-state))
         (root-idx (sbi-emit-node! st ir 0))
         (dep-count (length deps))
         (sym-count (vector-ref st 1))
         (node-count (vector-ref st 4))
         (flags (+ (+ (if (vector-ref st 13) 1 0)
                      (if (vector-ref st 14) 2 0))
                   (if (> dep-count 0) 4 0)))
         (payload-w (sbi-make-writer)))
    ;; Section 1: Dependency header table
    (for-each
      (lambda (d)
        (let ((pbytes (sbi-string->utf8-bytes (car d))))
          (sbi-buf-uleb128! payload-w (bytevector-length pbytes))
          (sbi-buf-bytes! payload-w pbytes)
          (sbi-buf-bytes! payload-w (cdr d))))
      deps)
    ;; Section 2: Interned string / symbol pool
    (let ((sym-bv (sbi-writer->bytevector (vector-ref st 2))))
      (sbi-buf-bytes! payload-w sym-bv))
    ;; Section 3: Acyclic DAG node table
    (let ((node-bv (sbi-writer->bytevector (vector-ref st 5))))
      (sbi-buf-bytes! payload-w node-bv))
    (let* ((payload-bv (sbi-writer->bytevector payload-w))
           (digest (sbi-sha256-bytevector payload-bv))
           (hdr-w (sbi-make-writer)))
      (sbi-buf-u8! hdr-w *sbi-magic-0*)
      (sbi-buf-u8! hdr-w *sbi-magic-1*)
      (sbi-buf-u8! hdr-w *sbi-magic-2*)
      (sbi-buf-u8! hdr-w *sbi-magic-3*)
      (sbi-buf-u16-le! hdr-w *sbi-version*)
      (sbi-buf-u8! hdr-w ir-kind)
      (sbi-buf-u8! hdr-w flags)
      (sbi-buf-u32-le! hdr-w dep-count)
      (sbi-buf-u32-le! hdr-w sym-count)
      (sbi-buf-u32-le! hdr-w node-count)
      (sbi-buf-u32-le! hdr-w root-idx)
      (sbi-buf-bytes! hdr-w digest)
      (sbi-buf-bytes! hdr-w payload-bv)
      (sbi-writer->bytevector hdr-w))))

(define sbi-serialize
  (case-lambda
    ((ir) (sbi-serialize-impl ir '()))
    ((ir ir-kind) (sbi-serialize-impl ir (list ir-kind)))
    ((ir ir-kind deps) (sbi-serialize-impl ir (list ir-kind deps)))))

;;; -----------------------------------------------------------------------
;;; 9. Acyclic DAG IR Deserializer (.sbi v2 Reader & Security Verifier)
;;; -----------------------------------------------------------------------

(define (sbi-read-u16-le bv off)
  (+ (bytevector-u8-ref bv off)
     (* (bytevector-u8-ref bv (+ off 1)) 256)))

(define (sbi-read-u32-le bv off)
  (+ (+ (bytevector-u8-ref bv off)
        (* (bytevector-u8-ref bv (+ off 1)) 256))
     (+ (* (bytevector-u8-ref bv (+ off 2)) 65536)
        (* (bytevector-u8-ref bv (+ off 3)) 16777216))))

(define (sbi-binary-bytevector? bv)
  (and (bytevector? bv)
       (>= (bytevector-length bv) 4)
       (= (bytevector-u8-ref bv 0) *sbi-magic-0*)
       (= (bytevector-u8-ref bv 1) *sbi-magic-1*)
       (= (bytevector-u8-ref bv 2) *sbi-magic-2*)
       (= (bytevector-u8-ref bv 3) *sbi-magic-3*)))

(define (sbi-binary-file? path)
  (let ((port (guard (ex (else #f)) (open-binary-input-file (sbi-coerce-path path)))))
    (if (not port)
        #f
        (let* ((b0 (guard (ex (else -1)) (read-u8 port)))
               (b1 (guard (ex (else -1)) (read-u8 port)))
               (b2 (guard (ex (else -1)) (read-u8 port)))
               (b3 (guard (ex (else -1)) (read-u8 port))))
          (guard (ex (else #f)) (close-input-port port))
          (and (integer? b0) (= b0 *sbi-magic-0*)
               (integer? b1) (= b1 *sbi-magic-1*)
               (integer? b2) (= b2 *sbi-magic-2*)
               (integer? b3) (= b3 *sbi-magic-3*))))))

(define (sbi-sub-bytevector bv start len)
  (let ((out (make-bytevector len 0)))
    (let loop ((i 0))
      (if (< i len)
          (begin
            (bytevector-u8-set! out i (bytevector-u8-ref bv (+ start i)))
            (loop (+ i 1)))))
    out))

(define (sbi-verify-header-and-digest bv)
  (if (not (bytevector? bv))
      (sbi-error! "sbi-deserialize: expected bytevector" bv))
  (let ((total-len (bytevector-length bv)))
    (if (< total-len *sbi-header-size*)
        (sbi-error! "Truncated SBI header (< 56 bytes)" total-len))
    (if (> total-len *sbi-max-bytes*)
        (sbi-error! "SBI payload exceeds security size limit" total-len))
    (if (not (sbi-binary-bytevector? bv))
        (sbi-error! "Invalid SBI magic bytes (expected USBI)"
                    (list (bytevector-u8-ref bv 0) (bytevector-u8-ref bv 1)
                          (bytevector-u8-ref bv 2) (bytevector-u8-ref bv 3))))
    (let ((version (sbi-read-u16-le bv 4)))
      (if (not (= version *sbi-version*))
          (sbi-error! "Unsupported SBI format version" version)))
    (let* ((ir-kind-code (bytevector-u8-ref bv 6))
           (ir-kind (sbi-code->ir-kind ir-kind-code))
           (flags (bytevector-u8-ref bv 7))
           (dep-count (sbi-read-u32-le bv 8))
           (sym-count (sbi-read-u32-le bv 12))
           (node-count (sbi-read-u32-le bv 16))
           (root-idx (sbi-read-u32-le bv 20)))
      (if (or (> dep-count *sbi-max-entries*)
              (> sym-count *sbi-max-entries*)
              (> node-count *sbi-max-entries*))
          (sbi-error! "SBI header section count exceeds security bound"
                      (list dep-count sym-count node-count)))
      (if (= node-count 0)
          (sbi-error! "SBI node table cannot be empty" node-count))
      (if (>= root-idx node-count)
          (sbi-error! "SBI root node index out of bounds" (list root-idx node-count)))
      ;; Verify payload SHA-256 (THREAT-839-1)
      (let* ((expected-digest (sbi-sub-bytevector bv 24 32))
             (actual-digest (sbi-sha256-bytevector-range bv *sbi-header-size* total-len)))
        (if (not (sbi-bytevector=? expected-digest actual-digest))
            (sbi-error! "SBI SHA-256 payload integrity verification failed"
                        (sbi-bytes->hex actual-digest))))
      (list ir-kind flags dep-count sym-count node-count root-idx total-len))))

(define (sbi-read-deps-section bv start-pos dep-count total-len)
  (let loop ((i 0) (pos start-pos) (acc '()))
    (if (>= i dep-count)
        (cons (reverse acc) pos)
        (let* ((len-res (sbi-read-uleb128 bv pos))
               (plen (car len-res))
               (p-start (cdr len-res))
               (p-end (+ p-start plen)))
          (if (or (> plen 65536) (> (+ p-end 32) total-len))
              (sbi-error! "Corrupted SBI dependency entry length" plen))
          (let ((dep-path (sbi-utf8-slice->string bv p-start p-end)))
            (if (not (sbi-safe-dep-path? dep-path))
                (sbi-error! "Path traversal rejected in SBI dependency table" dep-path))
            (let ((sha (sbi-sub-bytevector bv p-end 32)))
              (loop (+ i 1) (+ p-end 32) (cons (cons dep-path sha) acc))))))))

(define (sbi-read-child-idx bv pos max-idx)
  (let* ((res (sbi-read-uleb128 bv pos))
         (cidx (car res)))
    (if (or (< cidx 0) (>= cidx max-idx))
        (sbi-error! "Cyclic or out-of-bounds DAG child reference" (list cidx max-idx)))
    res))

(define (%sbi-deserialize-after-deps bv hdr deps pos-sec2)
  (let* ((ir-kind (car hdr))
         (flags (cadr hdr))
         (sym-count (cadddr hdr))
         (node-count (list-ref hdr 4))
         (root-idx (list-ref hdr 5))
         (total-len (list-ref hdr 6))
         ;; Section 2: Interned string/symbol pool
         (strs (make-vector sym-count ""))
         (syms (make-vector sym-count 'sbi-uninit))
         (pos-sec3
           (let loop ((i 0) (pos pos-sec2))
             (if (>= i sym-count)
                 pos
                 (let* ((len-res (sbi-read-uleb128 bv pos))
                        (slen (car len-res))
                        (s-start (cdr len-res))
                        (s-end (+ s-start slen)))
                   (if (or (> slen *sbi-max-bytes*) (> s-end total-len))
                       (sbi-error! "Corrupted SBI string pool entry length" slen))
                   (let ((s (sbi-utf8-slice->string bv s-start s-end)))
                     (vector-set! strs i s)
                     (vector-set! syms i (string->symbol s))
                     (loop (+ i 1) s-end))))))
         ;; Section 3: Acyclic DAG nodes
         (nodes (make-vector node-count #f)))
    (let node-loop ((i 0) (pos pos-sec3))
      (if (>= i node-count)
          (if (not (= pos total-len))
              (sbi-error! "Trailing bytes after SBI DAG node table" (list pos total-len)))
          (begin
            (if (>= pos total-len)
                (sbi-error! "Unexpected EOF inside SBI DAG node table" i))
            (let ((tag (bytevector-u8-ref bv pos))
                  (p1 (+ pos 1)))
              (cond
                ((= tag *sbi-tag-nil*)
                 (vector-set! nodes i '())
                 (node-loop (+ i 1) p1))

                ((= tag *sbi-tag-bool*)
                 (if (>= p1 total-len)
                     (sbi-error! "Unexpected EOF reading boolean node" i))
                 (let ((b (bytevector-u8-ref bv p1)))
                   (vector-set! nodes i (if (= b 0) #f #t))
                   (node-loop (+ i 1) (+ p1 1))))

                ((= tag *sbi-tag-fixnum*)
                 (let ((r (sbi-read-sleb128 bv p1)))
                   (vector-set! nodes i (car r))
                   (node-loop (+ i 1) (cdr r))))

                ((or (= tag *sbi-tag-flonum*) (= tag *sbi-tag-bignum*))
                 (let* ((r (sbi-read-uleb128 bv p1))
                        (sidx (car r)))
                   (if (>= sidx sym-count)
                       (sbi-error! "Number string pool index out of bounds" sidx))
                   (let* ((str (vector-ref strs sidx))
                          (num (cond
                                 ((string=? str "+inf.0") (%sbi-make-pos-inf))
                                 ((string=? str "-inf.0") (- 0.0 (%sbi-make-pos-inf)))
                                 ((or (string=? str "+nan.0") (string=? str "-nan.0"))
                                  (let ((pinf (%sbi-make-pos-inf)))
                                    (- pinf pinf)))
                                 (else (string->number str)))))
                     (if (not num)
                         (sbi-error! "Invalid numeric representation in SBI pool" str))
                     (vector-set! nodes i num)
                     (node-loop (+ i 1) (cdr r)))))

                ((= tag *sbi-tag-char*)
                 (let* ((r (sbi-read-uleb128 bv p1))
                        (cp (car r)))
                   (if (or (< cp 0) (> cp #x10FFFF))
                       (sbi-error! "Invalid Unicode code point in SBI char node" cp))
                   (vector-set! nodes i (integer->char cp))
                   (node-loop (+ i 1) (cdr r))))

                ((= tag *sbi-tag-string*)
                 (let* ((r (sbi-read-uleb128 bv p1))
                        (sidx (car r)))
                   (if (>= sidx sym-count)
                       (sbi-error! "String pool index out of bounds" sidx))
                   (vector-set! nodes i (vector-ref strs sidx))
                   (node-loop (+ i 1) (cdr r))))

                ((= tag *sbi-tag-symbol*)
                 (let* ((r (sbi-read-uleb128 bv p1))
                        (sidx (car r)))
                   (if (>= sidx sym-count)
                       (sbi-error! "Symbol pool index out of bounds" sidx))
                   (vector-set! nodes i (vector-ref syms sidx))
                   (node-loop (+ i 1) (cdr r))))

                ((= tag *sbi-tag-pair*)
                 (let* ((r1 (sbi-read-child-idx bv p1 i))
                        (r2 (sbi-read-child-idx bv (cdr r1) i)))
                   (vector-set! nodes i (cons (vector-ref nodes (car r1))
                                              (vector-ref nodes (car r2))))
                   (node-loop (+ i 1) (cdr r2))))

                ((= tag *sbi-tag-list*)
                 (let* ((lr (sbi-read-uleb128 bv p1))
                        (cnt (car lr)))
                   (if (> cnt *sbi-max-entries*)
                       (sbi-error! "SBI list length exceeds security limit" cnt))
                   (let elem-loop ((k 0) (ep (cdr lr)) (rev-acc '()))
                     (if (< k cnt)
                         (let ((er (sbi-read-child-idx bv ep i)))
                           (elem-loop (+ k 1)
                                      (cdr er)
                                      (cons (vector-ref nodes (car er)) rev-acc)))
                         (begin
                           (vector-set! nodes i (reverse rev-acc))
                           (node-loop (+ i 1) ep))))))

                ((= tag *sbi-tag-vector*)
                 (let* ((lr (sbi-read-uleb128 bv p1))
                        (cnt (car lr)))
                   (if (> cnt *sbi-max-entries*)
                       (sbi-error! "SBI vector length exceeds security limit" cnt))
                   (let ((vec (make-vector cnt #f)))
                     (let elem-loop ((k 0) (ep (cdr lr)))
                       (if (< k cnt)
                           (let ((er (sbi-read-child-idx bv ep i)))
                             (vector-set! vec k (vector-ref nodes (car er)))
                             (elem-loop (+ k 1) (cdr er)))
                           (begin
                             (vector-set! nodes i vec)
                             (node-loop (+ i 1) ep)))))))

                ((= tag *sbi-tag-bytevector*)
                 (let* ((lr (sbi-read-uleb128 bv p1))
                        (blen (car lr))
                        (b-start (cdr lr))
                        (b-end (+ b-start blen)))
                   (if (or (> blen *sbi-max-bytes*) (> b-end total-len))
                       (sbi-error! "SBI bytevector node out of bounds" blen))
                   (vector-set! nodes i (sbi-sub-bytevector bv b-start blen))
                   (node-loop (+ i 1) b-end)))

                ((= tag *sbi-tag-source-span*)
                 (let* ((r-file (sbi-read-child-idx bv p1 i))
                        (r-sl (sbi-read-uleb128 bv (cdr r-file)))
                        (r-sc (sbi-read-uleb128 bv (cdr r-sl)))
                        (r-el (sbi-read-uleb128 bv (cdr r-sc)))
                        (r-ec (sbi-read-uleb128 bv (cdr r-el)))
                        (r-mo (sbi-read-child-idx bv (cdr r-ec) i))
                        (r-id (sbi-read-sleb128 bv (cdr r-mo)))
                        (fval (vector-ref nodes (car r-file)))
                        (moval (vector-ref nodes (car r-mo)))
                        (clean-f (if (string? fval)
                                     (begin
                                       (if (not (sbi-safe-dep-path? fval))
                                           (sbi-error! "Unsafe source path in deserialized span" fval))
                                       fval)
                                     "<unknown>"))
                        (span (if (or (not moval) (source-span? moval))
                                  (make-source-span clean-f (car r-sl) (car r-sc)
                                                    (car r-el) (car r-ec) moval (car r-id))
                                  (%make-source-span-raw clean-f (car r-sl) (car r-sc)
                                                         (car r-el) (car r-ec) moval (car r-id)))))
                   (vector-set! nodes i span)
                   (node-loop (+ i 1) (cdr r-id))))

                ((= tag *sbi-tag-binding*)
                 (let* ((r-id (sbi-read-uleb128 bv p1))
                        (r-sname (sbi-read-child-idx bv (cdr r-id) i))
                        (r-usym (sbi-read-child-idx bv (cdr r-sname) i))
                        (r-kind (sbi-read-child-idx bv (cdr r-usym) i))
                        (r-ns (sbi-read-child-idx bv (cdr r-kind) i))
                        (r-sid (sbi-read-sleb128 bv (cdr r-ns)))
                        (r-sc (sbi-read-child-idx bv (cdr r-sid) i))
                        (r-ty (sbi-read-child-idx bv (cdr r-sc) i))
                        (r-vis (sbi-read-child-idx bv (cdr r-ty) i))
                        (r-sset (sbi-read-child-idx bv (cdr r-vis) i))
                        (r-span (sbi-read-child-idx bv (cdr r-sset) i))
                        (b (make-binding
                             (car r-id)
                             (vector-ref nodes (car r-sname))
                             (vector-ref nodes (car r-usym))
                             (vector-ref nodes (car r-kind))
                             (vector-ref nodes (car r-ns))
                             (car r-sid)
                             (vector-ref nodes (car r-sc))
                             (vector-ref nodes (car r-ty))
                             (vector-ref nodes (car r-vis))
                             (vector-ref nodes (car r-sset))
                             (vector-ref nodes (car r-span)))))
                   (vector-set! nodes i b)
                   (node-loop (+ i 1) (cdr r-span))))

                (else
                 (sbi-error! "Unknown SBI DAG node tag" tag)))))))
    (list (cons 'ir (vector-ref nodes root-idx))
          (cons 'ir-kind ir-kind)
          (cons 'version *sbi-version*)
          (cons 'flags flags)
          (cons 'deps deps)
          (cons 'node-count node-count)
          (cons 'sym-count sym-count))))

(define (sbi-deserialize-full bv)
  (let* ((hdr (sbi-verify-header-and-digest bv))
         (dep-count (caddr hdr))
         (total-len (list-ref hdr 6))
         (dep-res (sbi-read-deps-section bv *sbi-header-size* dep-count total-len))
         (deps (car dep-res))
         (pos-sec2 (cdr dep-res)))
    (%sbi-deserialize-after-deps bv hdr deps pos-sec2)))

(define (sbi-deserialize bv)
  (cdr (assq 'ir (sbi-deserialize-full bv))))

;;; -----------------------------------------------------------------------
;;; 10. File Read/Write API, PCH Cache Validation & Compatibility Layer
;;; -----------------------------------------------------------------------

(define sbi-write-file
  (case-lambda
    ((path ir)
     (let ((bv (sbi-serialize-impl ir '())))
       (sbi-write-file-bytes path bv)
       bv))
    ((path ir ir-kind)
     (let ((bv (sbi-serialize-impl ir (list ir-kind))))
       (sbi-write-file-bytes path bv)
       bv))
    ((path ir ir-kind deps)
     (let ((bv (sbi-serialize-impl ir (list ir-kind deps))))
       (sbi-write-file-bytes path bv)
       bv))))

(define (sbi-read-file-full path)
  (let ((bytes (sbi-read-file-bytes path)))
    (if (not bytes)
        (sbi-error! "Cannot read SBI file" path))
    (sbi-deserialize-full bytes)))

(define (sbi-read-file path)
  (cdr (assq 'ir (sbi-read-file-full path))))

(define (sbi-deps-all-fresh? deps)
  (let loop ((ds deps))
    (if (null? ds)
        #t
        (let* ((d (car ds))
               (dep-path (car d))
               (expected-sha (cdr d)))
          (if (not (sbi-safe-dep-path? dep-path))
              #f
              (let ((actual-sha (sbi-sha256-file dep-path)))
                (if (and actual-sha (sbi-bytevector=? expected-sha actual-sha))
                    (loop (cdr ds))
                    #f)))))))

(define (sbi-cache-valid? sbi-path)
  (guard (ex (else #f))
    (if (not (sbi-binary-file? sbi-path))
        #f
        (let* ((meta (sbi-read-file-full sbi-path))
               (deps (cdr (assq 'deps meta))))
          (sbi-deps-all-fresh? deps)))))

(define (sbi-deps-cover? cached-deps required-paths)
  (let loop ((ps required-paths))
    (if (null? ps)
        #t
        (let* ((p (car ps))
               (found (assoc p cached-deps)))
          (if found
              (loop (cdr ps))
              #f)))))

(define (sbi-load-or-build-pch sbi-path dep-paths builder-thunk)
  (let ((cached
          (guard (ex (else #f))
            (if (sbi-binary-file? sbi-path)
                (let* ((meta (sbi-read-file-full sbi-path))
                       (deps (cdr (assq 'deps meta))))
                  (if (and (sbi-deps-cover? deps dep-paths)
                           (sbi-deps-all-fresh? deps))
                      (cdr (assq 'ir meta))
                      #f))
                #f))))
    (if cached
        cached
        (let ((ir (builder-thunk)))
          (sbi-write-file sbi-path ir 'pch dep-paths)
          ir))))

(define (sbi-read-pch-validated sbi-path)
  (let ((cpath (sbi-coerce-path sbi-path)))
    (if (not (file-exists? cpath))
        (list 'error 'missing (string-append "PCH file does not exist: " sbi-path))
        (let ((bytes (sbi-read-file-bytes cpath)))
          (if (not bytes)
              (list 'error 'corrupt (string-append "Unable to read PCH file: " sbi-path))
              (guard (ex
                      (else
                       (let ((msg (if (and (pair? ex) (eq? (car ex) 'sbi-error) (pair? (cdr ex)))
                                      (cadr ex)
                                      "Invalid or corrupted .sbi PCH binary")))
                         (list 'error 'corrupt msg))))
                (let* ((hdr (sbi-verify-header-and-digest bytes))
                       (ir-kind (car hdr))
                       (dep-count (caddr hdr))
                       (total-len (list-ref hdr 6)))
                  (if (not (eq? ir-kind 'pch))
                      (list 'error 'corrupt
                            (string-append "SBI file is not a precompiled header (ir-kind="
                                           (symbol->string ir-kind) ")"))
                      (let* ((dep-res (sbi-read-deps-section bytes *sbi-header-size* dep-count total-len))
                             (deps (car dep-res)))
                        (if (not (sbi-deps-all-fresh? deps))
                            (list 'stale deps)
                            (let* ((full (%sbi-deserialize-after-deps bytes hdr deps (cdr dep-res)))
                                   (ir (cdr (assq 'ir full))))
                              (list 'ok ir deps))))))))))))

(define (sbi-import-forms path)
  (let ((cpath (sbi-coerce-path path)))
    (if (sbi-binary-file? cpath)
        (let ((datum (sbi-read-file cpath)))
          (cond
            ((null? datum) '())
            ((and (pair? datum) (eq? (car datum) '%lir-program)) (list datum))
            ((list? datum) datum)
            (else (list datum))))
        ;; Backward compatibility with legacy text S-expression .sbi v1 headers
        (slurp-single-file cpath))))

;;; -----------------------------------------------------------------------
;;; 11. Multi-Module LTO LIR Merger (sbi-merge-lir-modules)
;;; -----------------------------------------------------------------------

(define (sbi-coerce-lir-program mod)
  (let ((prog (cond
                ((bytevector? mod) (sbi-deserialize mod))
                ((string? mod) (sbi-read-file mod))
                (else mod))))
    (if (or (not (pair? prog))
            (not (eq? (car prog) '%lir-program))
            (< (length prog) 5))
        (sbi-error! "sbi-merge-lir-modules: expected %lir-program form" prog))
    prog))

(define (sbi-merge-assoc-by-key entries get-key)
  (let ((ht (sbi-make-ht 64)))
    (let loop ((es entries) (order-rev '()))
      (if (null? es)
          (map (lambda (k) (sbi-ht-ref ht k #f)) (reverse order-rev))
          (let* ((e (car es))
                 (k (symbol->string (get-key e)))
                 (seen? (sbi-ht-ref ht k #f)))
            (sbi-ht-set! ht k e)
            (loop (cdr es) (if seen? order-rev (cons k order-rev))))))))

(define (sbi-strip-trailing-main-ret insts)
  (let loop ((is insts) (acc '()))
    (cond
      ((null? is) (reverse acc))
      ((and (null? (cdr is))
            (pair? (car is))
            (eq? (caar is) '%return))
       (reverse acc))
      (else (loop (cdr is) (cons (car is) acc))))))

(define (sbi-extract-lir-clause-list decl head)
  (if (and (pair? decl) (eq? (car decl) head) (pair? (cdr decl)))
      (cadr decl)
      '()))

(define (sbi-merge-lir-modules modules)
  (if (or (not (list? modules)) (null? modules))
      (sbi-error! "sbi-merge-lir-modules: expected non-empty module list" modules))
  (let loop ((ms modules)
             (all-strings-rev '())
             (all-stackmaps-rev '())
             (all-funcs-rev '())
             (max-frame 0)
             (main-bodies-rev '()))
    (if (null? ms)
        (let* ((merged-strings (sbi-merge-assoc-by-key
                                 (reverse all-strings-rev) car*))
               (merged-stackmaps (reverse all-stackmaps-rev))
               (merged-funcs (sbi-merge-assoc-by-key
                               (reverse all-funcs-rev) cadr))
               (ordered-bodies (reverse main-bodies-rev))
               (combined-main
                 (let mloop ((bs ordered-bodies) (acc '()))
                   (cond
                     ((null? bs) (reverse acc))
                     ((null? (cdr bs))
                      (let append-tail ((ts (car bs)) (out acc))
                        (if (null? ts)
                            (reverse out)
                            (append-tail (cdr ts) (cons (car ts) out)))))
                     (else
                      (let append-init ((ts (sbi-strip-trailing-main-ret (car bs))) (out acc))
                        (if (null? ts)
                            (mloop (cdr bs) out)
                            (append-init (cdr ts) (cons (car ts) out)))))))))
          (list '%lir-program
                (list 'strings merged-strings)
                (list 'stackmaps merged-stackmaps)
                (cons '%lir-functions merged-funcs)
                (list '%lir-main
                      (list 'frame-size max-frame)
                      (cons 'body combined-main))))
        (let* ((prog (sbi-coerce-lir-program (car ms)))
               (strings-decl (list-ref prog 1))
               (stackmaps-decl (list-ref prog 2))
               (funcs-decl (list-ref prog 3))
               (main-decl (list-ref prog 4))
               (strs (sbi-extract-lir-clause-list strings-decl 'strings))
               (smaps (sbi-extract-lir-clause-list stackmaps-decl 'stackmaps))
               (fns (if (and (pair? funcs-decl) (eq? (car funcs-decl) '%lir-functions))
                        (cdr funcs-decl)
                        '()))
               (m-frame (if (and (pair? main-decl) (pair? (cdr main-decl))
                                 (pair? (cadr main-decl)) (eq? (caadr main-decl) 'frame-size))
                            (cadr (cadr main-decl))
                            0))
               (m-body (if (and (pair? main-decl) (>= (length main-decl) 3)
                                (pair? (caddr main-decl)) (eq? (car (caddr main-decl)) 'body))
                           (cdr (caddr main-decl))
                           '()))
               (s1 (let push-loop ((xs strs) (acc all-strings-rev))
                     (if (null? xs) acc (push-loop (cdr xs) (cons (car xs) acc)))))
               (s2 (let push-loop ((xs smaps) (acc all-stackmaps-rev))
                     (if (null? xs) acc (push-loop (cdr xs) (cons (car xs) acc)))))
               (f1 (let push-loop ((xs fns) (acc all-funcs-rev))
                     (if (null? xs) acc (push-loop (cdr xs) (cons (car xs) acc))))))
          (loop (cdr ms)
                s1
                s2
                f1
                (if (> m-frame max-frame) m-frame max-frame)
                (cons m-body main-bodies-rev))))))

;;; =======================================================================
;;; Freeze Graph Serialization & .rodata Bloat Guard
;;; Conforms to DSN-33-03 §7.3 & Issue #883
;;; =======================================================================

(define *max-rodata-size* 67108864) ; 64MB

(define (sbi-node-byte-size node)
  (cond
    ((number? node) 8)
    ((boolean? node) 8)
    ((char? node) 8)
    ((symbol? node) (+ 8 (string-length (symbol->string node))))
    ((string? node) (+ 8 (string-length node)))
    ((bytevector? node) (+ 8 (bytevector-length node)))
    ((pair? node) 16)
    ((vector? node) (+ 8 (* (vector-length node) 8)))
    (else 8)))

(define (freeze-graph-internal obj id-counter visited size-box max-size)
  (let ((cur-size (car size-box)))
    (if (> cur-size max-size)
        (error "E-RODATA-OVERFLOW" cur-size)
        (cond
          ((or (number? obj) (boolean? obj) (char? obj) (null? obj))
           (set-car! size-box (+ cur-size (sbi-node-byte-size obj)))
           obj)
          ((symbol? obj)
           (set-car! size-box (+ cur-size (sbi-node-byte-size obj)))
           obj)
          ((string? obj)
           (set-car! size-box (+ cur-size (sbi-node-byte-size obj)))
           obj)
          ((bytevector? obj)
           (set-car! size-box (+ cur-size (sbi-node-byte-size obj)))
           obj)
          ((pair? obj)
           (let ((entry (assq obj (car visited))))
             (if entry
                 ;; Cycle detected: return cycle-ref placeholder
                 (list 'cycle-ref (cdr entry))
                 (let* ((node-id (car id-counter))
                        (_1 (set-car! id-counter (+ node-id 1)))
                        (_2 (set-car! visited (cons (cons obj node-id) (car visited))))
                        (_3 (set-car! size-box (+ (car size-box) 16)))
                        (frozen-car (freeze-graph-internal (car obj) id-counter visited size-box max-size))
                        (frozen-cdr (freeze-graph-internal (cdr obj) id-counter visited size-box max-size)))
                   (cons frozen-car frozen-cdr)))))
          ((vector? obj)
           (let ((entry (assq obj (car visited))))
             (if entry
                 (list 'cycle-ref (cdr entry))
                 (let* ((node-id (car id-counter))
                        (len (vector-length obj))
                        (_1 (set-car! id-counter (+ node-id 1)))
                        (_2 (set-car! visited (cons (cons obj node-id) (car visited))))
                        (_3 (set-car! size-box (+ (car size-box) (+ 8 (* len 8)))))
                        (new-vec (make-vector len)))
                   (let vloop ((i 0))
                     (if (< i len)
                         (begin
                           (vector-set! new-vec i
                             (freeze-graph-internal (vector-ref obj i) id-counter visited size-box max-size))
                           (vloop (+ i 1)))
                         new-vec))))))
          (else
           (set-car! size-box (+ cur-size 8))
           obj)))))

(define (freeze! obj)
  (let ((id-counter (cons 1 '()))
        (visited (cons '() '()))
        (size-box (cons 0 '())))
    (freeze-graph-internal obj id-counter visited size-box *max-rodata-size*)))

(define (freeze-serialize-to-rodata obj max-size)
  (let* ((id-counter (cons 1 '()))
         (visited (cons '() '()))
         (size-box (cons 0 '()))
         (limit (if max-size max-size *max-rodata-size*))
         (frozen (freeze-graph-internal obj id-counter visited size-box limit)))
    (if (> (car size-box) limit)
        (error "E-RODATA-OVERFLOW" (car size-box))
        (list 'rodata-segment
              (cons 'size (car size-box))
              (cons 'max-limit limit)
              (cons 'payload frozen)))))

;;; -----------------------------------------------------------------------
;;; Binary Bytevector Packaging for Frozen .rodata (Issue #890 / DSN-33 §11.1)
;;; -----------------------------------------------------------------------

(define (sbi-buf-u64-le! w val)
  (let ((lo (sbi-mod-pos (modulo val 4294967296) 4294967296))
        (hi (sbi-mod-pos (quotient val 4294967296) 4294967296)))
    (sbi-buf-u32-le! w lo)
    (sbi-buf-u32-le! w hi)))

(define (freeze-encode-element! w elem)
  (cond
    ((number? elem)
     ;; 64-bit tagged fixnum: elem << 2
     (sbi-buf-u64-le! w (* elem 4)))
    ((boolean? elem)
     (sbi-buf-u64-le! w (if elem #x6F #x2F)))
    ((null? elem)
     (sbi-buf-u64-le! w #x3F))
    ((char? elem)
     (sbi-buf-u64-le! w (+ (* (char->integer elem) 256) #x0E)))
    ((and (pair? elem) (eq? (car elem) 'cycle-ref))
     (let ((id (if (pair? (cdr elem)) (cadr elem) 0)))
       ;; Pointer tagged placeholder: (id << 3) | 0x01
       (sbi-buf-u64-le! w (+ (* id 8) 1))))
    ((string? elem)
     (let* ((bytes (sbi-string->utf8-bytes elem))
            (len (bytevector-length bytes)))
       (sbi-buf-u64-le! w len)
       (sbi-buf-bytes! w bytes)
       (let ((pad (modulo (- 8 (modulo len 8)) 8)))
         (let loop ((p pad))
           (if (> p 0)
               (begin (sbi-buf-u8! w 0) (loop (- p 1))))))))
    ((symbol? elem)
     (let* ((bytes (sbi-string->utf8-bytes (symbol->string elem)))
            (len (bytevector-length bytes)))
       (sbi-buf-u64-le! w len)
       (sbi-buf-bytes! w bytes)
       (let ((pad (modulo (- 8 (modulo len 8)) 8)))
         (let loop ((p pad))
           (if (> p 0)
               (begin (sbi-buf-u8! w 0) (loop (- p 1))))))))
    ((bytevector? elem)
     (let ((len (bytevector-length elem)))
       (sbi-buf-u64-le! w len)
       (sbi-buf-bytes! w elem)
       (let ((pad (modulo (- 8 (modulo len 8)) 8)))
         (let loop ((p pad))
           (if (> p 0)
               (begin (sbi-buf-u8! w 0) (loop (- p 1))))))))
    ((vector? elem)
     (let ((len (vector-length elem)))
       (sbi-buf-u64-le! w len)
       (let loop ((i 0))
         (if (< i len)
             (begin
               (freeze-encode-element! w (vector-ref elem i))
               (loop (+ i 1)))))))
    ((pair? elem)
     (freeze-encode-element! w (car elem))
     (freeze-encode-element! w (cdr elem)))
    (else
     (sbi-buf-u64-le! w 0))))

(define (freeze-serialized->bytevector rodata-seg)
  (let* ((is-seg (and (pair? rodata-seg) (eq? (car rodata-seg) 'rodata-segment)))
         (size (if is-seg (cdr (cadr rodata-seg)) 0))
         (max-limit (if is-seg (cdr (caddr rodata-seg)) *max-rodata-size*))
         (payload (if is-seg (cdr (cadddr rodata-seg)) rodata-seg)))
    (if (> size max-limit)
        (error "E-RODATA-OVERFLOW" size)
        (let ((w (sbi-make-writer)))
          ;; 16-byte header:
          ;; 8 bytes: 'ULFRZDAT' (#x554c46525a444154)
          (sbi-buf-u8! w #x55)
          (sbi-buf-u8! w #x4C)
          (sbi-buf-u8! w #x46)
          (sbi-buf-u8! w #x52)
          (sbi-buf-u8! w #x5A)
          (sbi-buf-u8! w #x44)
          (sbi-buf-u8! w #x41)
          (sbi-buf-u8! w #x54)
          ;; 8 bytes: size
          (sbi-buf-u64-le! w size)
          ;; Encode payload elements
          (freeze-encode-element! w payload)
          (let ((res-bv (sbi-writer->bytevector w)))
            (if (> (bytevector-length res-bv) max-limit)
                (error "E-RODATA-OVERFLOW" (bytevector-length res-bv))
                res-bv))))))
;;; =======================================================================
;;; ULisp Compiler: Frontend Intermediate Languages Specification
;;; (L_cst -> L_src -> L_core -> L_anf -> L_lifted)
;;; Conforms to DSN-33, DSN-33-01 Architecture Specification & Issues #594, #753
;;; =======================================================================
;;; Formal intermediate language definitions for the entire Frontend pipeline
;;; using Nanopass DSL (define-language) with a continuous `extends` chain:
;;; - L_cst:    Concrete Syntax Tree (surface syntax including library declarations,
;;;             hygienic macros, and Nanopass/Picopass DSL forms).
;;; - L_src:    Source HIR after library/import desugaring and macro/DSL expansion.
;;; - L_core:   Core HIR where all 18 high-level syntactic sugar forms are removed.
;;; - L_anf:    A-Normal Form intermediate language where all function/primitive
;;;             arguments and conditional tests are atomic operands.
;;; - L_lifted: Flat procedure intermediate language where local lambda abstractions
;;;             have been hoisted into top-level %function definitions, and closures
;;;             are explicitly instantiated via %make-closure / %make-closure-env.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. L_cst: Concrete Syntax Tree (Surface Language)
;;; -----------------------------------------------------------------------
(define-language L_cst
  (entry Program)
  (terminals
    (symbol (x lbl var))
    (constant (c)))
  (Def (d)
    (define-library (x ...) d ...)
    (import d ...)
    (export x ...)
    (include c)
    (include-ci c)
    (define-syntax x e)
    (define-language x d ...)
    (define-pass x d ...)
    (define-picopass x d ...)
    (define-femtopass x d ...)
    (define-attopass x d ...)
    (define x e)
    (define (x x1 ...) e ...)
    e)
  (Expr (e)
    x
    c
    (quote datum)
    (quasiquote datum)
    (let-syntax ((x e1) ...) e ...)
    (letrec-syntax ((x e1) ...) e ...)
    (syntax-rules (x ...) (e1 e2) ...)
    (if e1 e2 e3)
    (if e1 e2)
    (begin e ...)
    (lambda (x ...) e ...)
    (set! x e)
    (let ((x e1) ...) e ...)
    (let x ((x1 e1) ...) e ...)
    (letrec ((x e1) ...) e ...)
    (letrec* ((x e1) ...) e ...)
    (let* ((x e1) ...) e ...)
    (do ((x e1 e2) ...) (e_test e_res ...) e_cmd ...)
    (cond (e1 e2) ... (else e_else))
    (cond-expand (e1 e2 ...) ...)
    (case key (dat e ...) ... (else e_else))
    (and e ...)
    (or e ...)
    (when e1 e2 ...)
    (unless e1 e2 ...)
    (delay e)
    (delay-force e)
    (list e ...)
    (vector e ...)
    (bytevector e ...)
    (vector-append e ...)
    (bytevector-append e ...)
    (string-append e ...)
    (guard (x c ...) e ...)
    (let-values (((x ...) e1) ...) e ...)
    (let*-values (((x ...) e1) ...) e ...)
    (parameterize ((x e1) ...) e ...)
    (define x e)
    (define (x x1 ...) e ...)
    (e0 e1 ...))
  (Program (p)
    (%program (d ...) e)
    d
    e))

;;; -----------------------------------------------------------------------
;;; 2. L_src: Source HIR (Post-Library & Post-Macro Expansion)
;;; -----------------------------------------------------------------------
(define-language L_src
  (extends L_cst)
  (entry Program)
  (Def (d)
    (- (define-library (x ...) d ...)
       (import d ...)
       (export x ...)
       (include c)
       (include-ci c)
       (define-syntax x e)
       (define-language x d ...)
       (define-pass x d ...)
       (define-picopass x d ...)
       (define-femtopass x d ...)
       (define-attopass x d ...)))
  (Expr (e)
    (- (let-syntax ((x e1) ...) e ...)
       (letrec-syntax ((x e1) ...) e ...)
       (syntax-rules (x ...) (e1 e2) ...))))

;;; -----------------------------------------------------------------------
;;; 3. L_core: Core HIR (All Syntactic Sugar Removed)
;;; -----------------------------------------------------------------------
(define-language L_core
  (extends L_src)
  (entry Program)
  (Def (d)
    (- (define (x x1 ...) e ...)))
  (Expr (e)
    (- (quasiquote datum)
       (let x ((x1 e1) ...) e ...)
       (letrec* ((x e1) ...) e ...)
       (let* ((x e1) ...) e ...)
       (do ((x e1 e2) ...) (e_test e_res ...) e_cmd ...)
       (cond (e1 e2) ... (else e_else))
       (cond-expand (e1 e2 ...) ...)
       (case key (dat e ...) ... (else e_else))
       (and e ...)
       (or e ...)
       (when e1 e2 ...)
       (unless e1 e2 ...)
       (delay e)
       (delay-force e)
       (list e ...)
       (vector e ...)
       (bytevector e ...)
       (vector-append e ...)
       (bytevector-append e ...)
       (string-append e ...)
       (guard (x c ...) e ...)
       (let-values (((x ...) e1) ...) e ...)
       (let*-values (((x ...) e1) ...) e ...)
       (parameterize ((x e1) ...) e ...)
       (define (x x1 ...) e ...))))

;;; -----------------------------------------------------------------------
;;; 4. L_anf: 3-Address Code / A-Normal Form Language
;;; -----------------------------------------------------------------------
(define-language L_anf
  (extends L_core)
  (entry Program)
  (Atom (a)
    x
    lbl
    var
    c
    (quote datum)
    (%closure-ref a c)
    (%global-ref x))
  (Expr (e)
    (- x
       c
       (quote datum)
       (if e1 e2 e3)
       (if e1 e2)
       (define x e)
       (e0 e1 ...))
    (+ a
       (if a e1 e2)
       (if a e1)
       (%make-closure a1 a ...)
       (%make-closure-env a1 a ...)
       (%closure-ref a c)
       (%closure-set! a1 c a2)
       (%cont-fun x (x ...) e1 e2)
       (%cont-call x a ...)
       (%with-handler a1 a2)
       (%raw-call/cc a)
       (%call-with-values a1 a2)
       (%values a ...)
       (%direct-call a1 a ...)
       (%global-ref x)
       (%global-set! x e)
       (a0 a ...)))
  (Program (p)
    (- d)))

;;; -----------------------------------------------------------------------
;;; 5. L_lifted: Lambda-Lifted & Explicit Closure Converted Language
;;; -----------------------------------------------------------------------
(define-language L_lifted
  (extends L_anf)
  (entry Program)
  (FunctionDecl (fn)
    (%function x (x ...) e))
  (Atom (a)
    (+ (%unbox-fixnum a)))
  (Expr (e)
    (- (lambda (x ...) e ...))
    (+ (if e1 e2 e3)
       (if e1 e2)
       (%direct-call a1 e ...)
       (annotate x e)
       (%stack-cons a1 a2)
       (%box-fixnum e)
       (%unbox-fixnum e)
       (e0 e1 ...)))
  (Program (p)
    (- (%program (d ...) e))
    (+ (%program (fn ...) e))))

;;; -----------------------------------------------------------------------
;;; 6. L-StagePoly: Stage-Polymorphic Meta-Language (DSN-33-03 §6.1)
;;; -----------------------------------------------------------------------
(define-language L-StagePoly
  (entry Expr)
  (terminals
    (symbol (x var lbl call-target))
    (constant (c))
    (primitive (prim)))
  (Expr (e body)
    x
    c
    (if e0 e1 e2)
    (let ((x e)) body)
    (lambda (x ...) body)
    (prim e ...)
    (call e0 e1 ...)
    ;; Meta-Stage Syntax (DSN-33-03 §6.1)
    (stage-now e)
    (stage-later e)
    (stage-lift e)
    (stage-quasiquote e)))

;;; -----------------------------------------------------------------------
;;; 7. L-Residual-ANF: Subtractive Residual ANF Language (DSN-33-03 §6.2)
;;; -----------------------------------------------------------------------
(define-language L-Residual-ANF
  (extends L-StagePoly)
  (entry Expr)
  (Atom (e-atom)
    x
    c)
  (Expr (e body)
    ;; Complete elimination of meta-stage constructs & non-ANF forms
    (- (stage-now e)
       (stage-later e)
       (stage-lift e)
       (stage-quasiquote e)
       (call e0 e1 ...)
       (let ((x e)) body))
    ;; Strict A-Normal Form productions
    (+ (let-anf ((x (prim e-atom ...))) body)
       (let-call ((x (call-target e-atom ...))) body)
       (atom-value e-atom))))
;;; =======================================================================
;;; ULisp Compiler Pass 0a: R7RS define-library & import Desugaring Pass
;;; Conforms to DSN-33 Architecture Specification & Issue #548 (R7RS 5.6)
;;;
;;; Transforms R7RS-small modular library definitions and import sets
;;; into a flat, deterministic sequence of top-level definitions and expressions.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Library Identification & Built-in Predicates
;;; -----------------------------------------------------------------------

(define (define-library-form? form)
  (and (pair? form) (eq? (car form) 'define-library)))

(define (import-form? form)
  (and (pair? form) (eq? (car form) 'import)))

;;; Built-in R7RS standard libraries that are inherently supported by ULisp runtime
(define (builtin-library-name? name)
  (and (pair? name)
       (or (and (eq? (car name) 'scheme)
                (memq (cadr name) '(base write read time file process-context cxr inexact complex char lazy case-lambda eval repl r5rs load)))
           (and (eq? (car name) 'ulisp)
                (memq (cadr name) '(base core native))))))

;;; Convert library name list e.g. (math matrix) to prefix string "math_matrix__"
(define (library-name->prefix-str lib-name)
  (let loop ((rest lib-name) (acc "__lib_"))
    (if (null? rest)
        (string-append acc "_")
        (let* ((elem (car rest))
               (part (cond
                       ((symbol? elem) (symbol->string elem))
                       ((number? elem) (number->string elem))
                       (else "sub"))))
          (loop (cdr rest) (string-append acc part "_"))))))

;;; -----------------------------------------------------------------------
;;; 2. Library Record Representation
;;; -----------------------------------------------------------------------

;;; Record: (list 'library-rec name exports imports body-forms)
(define (make-library-rec name exports imports body-forms)
  (list 'library-rec name exports imports body-forms))

(define (lib-rec? r)
  (and (pair? r) (eq? (car r) 'library-rec)))

(define (lib-rec-name r) (cadr r))
(define (lib-rec-exports r) (caddr r))
(define (lib-rec-imports r) (cadddr r))
(define (lib-rec-body r) (car (cddddr r)))

;;; Parse (export <export-spec> ...)
;;; Each export-spec is <identifier> or (rename <orig> <new>)
;;; Returns list of (cons <internal-name> <exported-public-name>)
(define (parse-export-specs specs)
  (let loop ((rest specs) (acc '()))
    (if (null? rest)
        (reverse acc)
        (let ((spec (car rest)))
          (cond
            ((symbol? spec)
             (loop (cdr rest) (cons (cons spec spec) acc)))
            ((and (pair? spec)
                  (eq? (car spec) 'rename)
                  (pair? (cdr spec))
                  (pair? (cddr spec)))
             (loop (cdr rest) (cons (cons (cadr spec) (caddr spec)) acc)))
            (else
             (loop (cdr rest) acc)))))))

;;; Parse a complete define-library form into a library-rec
(define (parse-define-library-form form)
  (let* ((name (cadr form))
         (decls (cddr form)))
    (let loop ((rest decls)
               (exports '())
               (imports '())
               (body-forms '()))
      (if (null? rest)
          (make-library-rec name (reverse exports) (reverse imports) (reverse body-forms))
          (let ((d (car rest)))
            (cond
              ;; (export spec ...)
              ((and (pair? d) (eq? (car d) 'export))
               (loop (cdr rest)
                     (append (reverse (parse-export-specs (cdr d))) exports)
                     imports
                     body-forms))

              ;; (import iset ...)
              ((and (pair? d) (eq? (car d) 'import))
               (loop (cdr rest)
                     exports
                     (append (reverse (cdr d)) imports)
                     body-forms))

              ;; (begin expr ...)
              ((and (pair? d) (eq? (car d) 'begin))
               (loop (cdr rest)
                     exports
                     imports
                     (append (reverse (cdr d)) body-forms)))

              ;; (include "path" ...) or (include-ci "path" ...)
              ((and (pair? d) (or (eq? (car d) 'include) (eq? (car d) 'include-ci)))
               (let* ((case-fold? (eq? (car d) 'include-ci))
                      (included-forms (slurp-included-files-mode (cdr d) case-fold?))
                      (clean-included (map strip-source-loc included-forms)))
                 (loop (cdr rest)
                       exports
                       imports
                       (append (reverse clean-included) body-forms))))

              ;; (include-library-declarations "path" ...) (R7RS §5.6.1, Issue #706)
              ((and (pair? d) (eq? (car d) 'include-library-declarations))
               (let* ((included-decls (slurp-included-files-mode (cdr d) #f))
                      (clean-decls (map strip-source-loc included-decls)))
                 (loop (append clean-decls (cdr rest))
                       exports
                       imports
                       body-forms)))

              ;; (cond-expand <ce-clause> ...)
              ((and (pair? d) (eq? (car d) 'cond-expand))
               (let ((matched-decls (expand-cond-expand (cdr d))))
                 (loop (append matched-decls (cdr rest))
                       exports
                       imports
                       body-forms)))

              (else
               ;; Skip unrecognized or unsupported declaration silently
               (loop (cdr rest) exports imports body-forms))))))))

;;; -----------------------------------------------------------------------
;;; 2.5 File Inclusion & Path Resolution (R7RS Section 4.1.7 & 5.6.1)
;;; -----------------------------------------------------------------------

(define (include-form? form)
  (and (pair? form)
       (or (eq? (car form) 'include)
           (eq? (car form) 'include-ci)
           (and (eq? (car form) 'load)
                (pair? (cdr form))
                (string? (cadr form))))))

(define *include-path-stack* (cons '() '()))

(define (member-string? s ls)
  (cond
    ((null? ls) #f)
    ((not (pair? ls)) #f)
    ((string=? s (car ls)) #t)
    (else (member-string? s (cdr ls)))))

(define (extract-dir-path path)
  (let loop ((i (- (string-length path) 1)))
    (cond
      ((< i 0) "")
      ((char=? (string-ref path i) #\/)
       (substring path 0 (+ i 1)))
      (else (loop (- i 1))))))

(define (path-traversal? p)
  (if (string-ends-with? p "stdlib_macros.scm")
      #f
      (if (and (> (string-length p) 0) (char=? (string-ref p 0) #\/))
          #t
          (let loop ((i 0))
            (if (>= (+ i 3) (string-length p))
                #f
                (if (and (char=? (string-ref p i) #\.)
                         (char=? (string-ref p (+ i 1)) #\.)
                         (char=? (string-ref p (+ i 2)) #\/))
                    #t
                    (loop (+ i 1))))))))

(define (find-included-file path)
  (let ((try-file (lambda (p) (if (file-exists? p) p #f))))
    (or (try-file path)
        (try-file (string-append "ulisp/" path))
        (if (string-starts-with? path "ulisp/")
            (try-file (substring path 6 (string-length path)))
            #f)
        path)))

(define (resolve-include-path path)
  (if (path-traversal? path)
      (error "include: path traversal outside allowed directory rejected" path)
      (let ((stack (car *include-path-stack*)))
        (if (and (pair? stack) (not (string=? (extract-dir-path (car stack)) "")))
            (let* ((parent-dir (extract-dir-path (car stack)))
                   (relative-path (string-append parent-dir path)))
              (if (file-exists? relative-path)
                  relative-path
                  (find-included-file path)))
            (find-included-file path)))))

;;; Case-Folding helper for include-ci (R7RS Section 4.1.7)
(define (char-downcase-ascii c)
  (let ((n (char->integer c)))
    (if (and (>= n 65) (<= n 90))
        (integer->char (+ n 32))
        c)))

(define (string-downcase-ascii s)
  (let* ((len (string-length s))
         (res (make-string len)))
    (let loop ((i 0))
      (if (= i len)
          res
          (begin
            (string-set! res i (char-downcase-ascii (string-ref s i)))
            (loop (+ i 1)))))))

(define (fold-case-datum x)
  (cond
    ((symbol? x)
     (string->symbol (string-downcase-ascii (symbol->string x))))
    ((pair? x)
     (cond
       ((eq? (car x) '%source-loc)
        (list '%source-loc (cadr x) (caddr x) (cadddr x) (fold-case-datum (car (cddddr x)))))
       ((eq? (car x) '%source-span)
        (list '%source-span (cadr x) (fold-case-datum (caddr x))))
       (else
        (cons (fold-case-datum (car x)) (fold-case-datum (cdr x))))))
    ((vector? x)
     (let* ((len (vector-length x))
            (v (make-vector len)))
       (let loop ((i 0))
         (if (= i len)
             v
             (begin
               (vector-set! v i (fold-case-datum (vector-ref x i)))
               (loop (+ i 1)))))))
    (else x)))

(define (expand-includes-in-forms forms)
  (let loop ((fs forms) (acc '()))
    (if (null? fs)
        (reverse acc)
        (let ((f (car fs)))
          (cond
            ((include-form? f)
             (let* ((case-fold? (eq? (car f) 'include-ci))
                    (included (slurp-included-files-mode (cdr f) case-fold?)))
               (loop (append included (cdr fs)) acc)))
            ((and (source-loc? f) (include-form? (source-loc-form f)))
             (let* ((inner (source-loc-form f))
                    (case-fold? (eq? (car inner) 'include-ci))
                    (included (slurp-included-files-mode (cdr inner) case-fold?)))
               (loop (append included (cdr fs)) acc)))
            ((and (ast-has-span? f) (include-form? (ast-strip-span f)))
             (let* ((inner (ast-strip-span f))
                    (case-fold? (eq? (car inner) 'include-ci))
                    (included (slurp-included-files-mode (cdr inner) case-fold?)))
               (loop (append included (cdr fs)) acc)))
            (else
             (loop (cdr fs) (cons f acc))))))))

(define (expand-cond-expands-in-forms forms)
  (let loop ((fs forms) (acc '()))
    (if (null? fs)
        (reverse acc)
        (let ((f (car fs)))
          (cond
            ((and (pair? f) (eq? (car f) 'cond-expand))
             (let ((matched (expand-cond-expand (cdr f))))
               (loop (append matched (cdr fs)) acc)))
            ((and (source-loc? f) (pair? (source-loc-form f)) (eq? (car (source-loc-form f)) 'cond-expand))
             (let ((matched (expand-cond-expand (cdr (source-loc-form f)))))
               (loop (append matched (cdr fs)) acc)))
            ((and (ast-has-span? f) (pair? (ast-strip-span f)) (eq? (car (ast-strip-span f)) 'cond-expand))
             (let ((matched (expand-cond-expand (cdr (ast-strip-span f)))))
               (loop (append matched (cdr fs)) acc)))
            (else
             (loop (cdr fs) (cons f acc))))))))

;;; File inclusion helper: safely read forms from given files
(define (slurp-included-files paths)
  (slurp-included-files-mode paths #f))

(define (slurp-included-files-mode paths case-fold?)
  (let loop ((ps paths) (acc '()))
    (if (null? ps)
        (reverse acc)
        (let ((forms (slurp-single-file-mode (car ps) case-fold?)))
          (loop (cdr ps) (append (reverse forms) acc))))))

(define (read-datum-or-source-loc p path line)
  (let ((cur-line (if (file-input-port? p) (port-line p) line))
        (cur-col (if (file-input-port? p) (port-col p) 1))
        (expr (sanitize-reader-form (read p))))
    (if (eof-object? expr)
        expr
        (let* ((end-line (if (file-input-port? p) (port-line p) cur-line))
               (end-col (if (file-input-port? p) (port-col p) cur-col))
               (span (make-source-span path cur-line cur-col end-line end-col #f (next-source-span-id!))))
          (list '%source-span span expr)))))

(define (slurp-single-file raw-path)
  (slurp-single-file-mode raw-path #f))

(define (slurp-single-file-mode raw-path case-fold?)
  (let ((path (resolve-include-path raw-path)))
    (if (member-string? path (car *include-path-stack*))
        (error "include: circular dependency detected" path)
        (let ((p (open-input-file path)))
          (if (not p)
              (error "include: failed to open source file" path)
              (begin
                (set-car! *include-path-stack* (cons path (car *include-path-stack*)))
                (let loop ((acc '()) (line 1))
                  (let ((expr (read-datum-or-source-loc p path line)))
                    (if (eof-object? expr)
                        (begin
                          (close-input-port p)
                          (set-car! *include-path-stack* (cdr (car *include-path-stack*)))
                          (let ((expanded (expand-includes-in-forms (reverse acc))))
                            (if case-fold?
                                (map fold-case-datum expanded)
                                expanded)))
                        (loop (cons expr acc) (+ line 1)))))))))))

;;; -----------------------------------------------------------------------
;;; 3. Import-Set Resolution & Name Mapping
;;; -----------------------------------------------------------------------

;;; Convert library name list e.g. (ulisp concurrency arena) to "lib/ulisp/concurrency/arena.sld"
(define (library-name->sld-path lib-name)
  (let loop ((rest lib-name) (acc "lib"))
    (if (null? rest)
        (string-append acc ".sld")
        (let* ((elem (car rest))
               (part (cond
                       ((symbol? elem) (symbol->string elem))
                       ((number? elem) (number->string elem))
                       (else "sub"))))
          (loop (cdr rest) (string-append acc "/" part))))))

;;; Attempt to locate and parse an external .sld file for lib-name
(define (try-load-external-library lib-name)
  (let* ((sld-rel (library-name->sld-path lib-name))
         (resolved (find-included-file sld-rel)))
    (if (not (file-exists? resolved))
        #f
        (let ((forms (slurp-single-file resolved)))
          (let loop ((fs forms))
            (if (null? fs)
                #f
                (let ((f (strip-source-loc (car fs))))
                  (if (and (define-library-form? f)
                           (equal? (cadr f) lib-name))
                      (parse-define-library-form f)
                      (loop (cdr fs))))))))))

;;; Lookup library record in registry, or lazily load from .sld if available
(define (lookup-or-load-library lib-name lib-registry)
  (let ((entry (assoc lib-name lib-registry)))
    (if entry
        (cdr entry)
        (try-load-external-library lib-name))))

;;; Given an import-set and the library registry alist:
;;; Returns (cons <library-name> <symbol-mapping>)
;;; where symbol-mapping is ((<exported-name> . <local-bound-name>) ...)
(define (resolve-import-set iset lib-registry)
  (cond
    ((null? iset) (cons '() '()))
    ((not (pair? iset)) (cons '() '()))

    ;; (only <import-set> <id> ...)
    ((eq? (car iset) 'only)
     (let* ((sub (resolve-import-set (cadr iset) lib-registry))
            (lib-name (car sub))
            (sub-map (cdr sub))
            (only-ids (cddr iset)))
       (cons lib-name
             (filter (lambda (entry) (memq (car entry) only-ids)) sub-map))))

    ;; (except <import-set> <id> ...)
    ((eq? (car iset) 'except)
     (let* ((sub (resolve-import-set (cadr iset) lib-registry))
            (lib-name (car sub))
            (sub-map (cdr sub))
            (except-ids (cddr iset)))
       (cons lib-name
             (filter (lambda (entry) (not (memq (car entry) except-ids))) sub-map))))

    ;; (prefix <import-set> <prefix-id>)
    ((eq? (car iset) 'prefix)
     (let* ((sub (resolve-import-set (cadr iset) lib-registry))
            (lib-name (car sub))
            (sub-map (cdr sub))
            (pfx-sym (caddr iset))
            (pfx-str (symbol->string pfx-sym)))
       (cons lib-name
             (map (lambda (entry)
                    (let* ((exp-name (car entry))
                           (loc-name (cdr entry))
                           (new-loc (string->symbol (string-append pfx-str (symbol->string loc-name)))))
                      (cons exp-name new-loc)))
                  sub-map))))

    ;; (rename <import-set> (<orig> <new>) ...)
    ((eq? (car iset) 'rename)
     (let* ((sub (resolve-import-set (cadr iset) lib-registry))
            (lib-name (car sub))
            (sub-map (cdr sub))
            (renames (cddr iset)))
       (cons lib-name
             (map (lambda (entry)
                    (let* ((exp-name (car entry))
                           (loc-name (cdr entry))
                           (rn (assoc loc-name renames)))
                      (if rn
                          (cons exp-name (cadr rn))
                          entry)))
                  sub-map))))

    ;; Library name: (ident ...)
    (else
     (let ((lib-name iset))
       (if (builtin-library-name? lib-name)
           (cons lib-name '())
           (let ((rec (lookup-or-load-library lib-name lib-registry)))
             (if rec
                 (let* ((exports (lib-rec-exports rec))
                        (mapping (map (lambda (e) (cons (cdr e) (cdr e))) exports)))
                   (cons lib-name mapping))
                 ;; Library not found in current compilation unit
                 (cons lib-name '()))))))))

;;; -----------------------------------------------------------------------
;;; 4. Library Alpha-Renaming & Static Flattening
;;; -----------------------------------------------------------------------

;;; Rename symbols in an expression based on a substitution alist: ((orig . new) ...)
(define (alpha-rename-expr expr subst)
  (cond
    ((null? expr) '())
    ((symbol? expr)
     (let ((entry (assq expr subst)))
       (if entry (cdr entry) expr)))
    ((not (pair? expr))
     expr)
    ((eq? (car expr) 'quote)
     expr)
    ((eq? (car expr) 'define-syntax)
     ;; Do not rename the syntax-rules keyword/pattern structure, only the defined macro name
     (if (and (pair? (cdr expr)) (symbol? (cadr expr)))
         (let* ((orig-name (cadr expr))
                (entry (assq orig-name subst))
                (new-name (if entry (cdr entry) orig-name)))
           (cons 'define-syntax (cons new-name (cddr expr))))
         expr))
    ((eq? (car expr) 'define-record-type)
     ;; (define-record-type <name> (<ctor> <ctor-args> ...) <pred> (<f> <getter> [<setter>]) ...)
     (let* ((type-name (cadr expr))
            (ctor-spec (caddr expr))
            (ctor-name (if (pair? ctor-spec) (car ctor-spec) ctor-spec))
            (ctor-args (if (pair? ctor-spec) (cdr ctor-spec) '()))
            (new-ctor-name (let ((e (assq ctor-name subst))) (if e (cdr e) ctor-name)))
            (pred-name (cadddr expr))
            (new-pred-name (let ((e (assq pred-name subst))) (if e (cdr e) pred-name)))
            (field-specs (cddddr expr))
            (new-field-specs
             (map (lambda (spec)
                    (let* ((fname (car spec))
                           (getter (cadr spec))
                           (new-getter (let ((e (assq getter subst))) (if e (cdr e) getter)))
                           (has-setter? (pair? (cddr spec))))
                      (if has-setter?
                          (let* ((setter (caddr spec))
                                 (new-setter (let ((e (assq setter subst))) (if e (cdr e) setter))))
                            (list fname new-getter new-setter))
                          (list fname new-getter))))
                  field-specs)))
       (cons 'define-record-type
             (cons type-name
                   (cons (cons new-ctor-name ctor-args)
                         (cons new-pred-name new-field-specs))))))
    ((eq? (car expr) 'define-values)
     (let* ((formals (cadr expr))
            (body-expr (caddr expr))
            (new-formals (alpha-rename-expr formals subst))
            (new-body (alpha-rename-expr body-expr subst)))
       (list 'define-values new-formals new-body)))
    (else
     (cons (alpha-rename-expr (car expr) subst)
           (alpha-rename-expr (cdr expr) subst)))))

;;; Extract all defined variable/macro names from a body of definitions
(define (extract-defined-names-in-body body-forms)
  (let loop ((rest body-forms) (acc '()))
    (if (null? rest)
        (reverse acc)
        (let ((form (car rest)))
          (cond
            ((and (pair? form) (eq? (car form) 'define) (pair? (cdr form)))
             (let ((def-target (cadr form)))
               (if (pair? def-target)
                   (loop (cdr rest) (cons (car def-target) acc))
                   (loop (cdr rest) (cons def-target acc)))))
            ((and (pair? form) (eq? (car form) 'define-values) (pair? (cdr form)))
             (let ((formals (cadr form)))
               (let formal-loop ((fs formals) (f-acc acc))
                 (cond
                   ((null? fs) (loop (cdr rest) f-acc))
                   ((pair? fs) (formal-loop (cdr fs) (cons (car fs) f-acc)))
                   ((symbol? fs) (loop (cdr rest) (cons fs f-acc)))
                   (else (loop (cdr rest) f-acc))))))
            ((and (pair? form) (eq? (car form) 'define-syntax) (pair? (cdr form)))
             (loop (cdr rest) (cons (cadr form) acc)))
            ((and (pair? form) (eq? (car form) 'define-record-type) (pair? (cdr form)))
             (let* ((ctor-spec (caddr form))
                    (ctor-name (if (pair? ctor-spec) (car ctor-spec) ctor-spec))
                    (pred-name (cadddr form))
                    (field-specs (cddddr form))
                    (acc1 (cons pred-name (cons ctor-name acc))))
               (let field-loop ((specs field-specs) (acc2 acc1))
                 (if (null? specs)
                     (loop (cdr rest) acc2)
                     (let* ((spec (car specs))
                            (getter (cadr spec))
                            (has-setter? (pair? (cddr spec)))
                            (acc3 (cons getter acc2))
                            (acc4 (if has-setter? (cons (caddr spec) acc3) acc3)))
                       (field-loop (cdr specs) acc4))))))
            (else
             (loop (cdr rest) acc)))))))

;;; Flatten a library definition into a sequence of namespaced top-level forms
;;; Returns (values internal-defs export-aliases)
;;; where export-aliases is ((<exported-public-name> . <namespaced-internal-name>) ...)
(define (instantiate-library lib-rec)
  (let* ((lib-name (lib-rec-name lib-rec))
         (prefix-str (library-name->prefix-str lib-name))
         (exports (lib-rec-exports lib-rec)) ; list of (internal-orig . exported-public)
         (body (lib-rec-body lib-rec))
         (defined-names (extract-defined-names-in-body body)))

    ;; Build substitution mapping for ALL defined names:
    ;; orig-name -> <prefix-str>_orig-name
    (let* ((subst
            (map (lambda (name)
                   (cons name (string->symbol (string-append prefix-str (symbol->string name)))))
                 defined-names))
           ;; Transform the body forms with the substitution mapping
           (renamed-body
            (map (lambda (f) (alpha-rename-expr f subst)) body))
           ;; Build export alias mapping: (exported-public . namespaced-internal-name)
           (export-aliases
            (map (lambda (e)
                   (let* ((internal-orig (car e))
                          (exported-public (cdr e))
                          (entry (assq internal-orig subst))
                          (namespaced-name (if entry (cdr entry) internal-orig)))
                     (cons exported-public namespaced-name)))
                 exports)))
      (cons renamed-body export-aliases))))

;;; -----------------------------------------------------------------------
;;; 5. Main Desugaring Entrypoint: desugar-libraries-and-imports
;;; -----------------------------------------------------------------------

;;; Traverses raw top-level forms:
;;; 1. Collects all (define-library ...) declarations into a registry
;;; 2. Instantiates imported libraries on demand, deduplicating them
;;; 3. Emits namespaced definitions and local binding aliases
;;; Returns a flat list of Scheme forms ready for macro expansion (Pass 00b).
(define (desugar-libraries-and-imports forms)
  ;; Pre-Step: Expand all top-level (cond-expand ...) and (include ...) forms recursively
  (let ((all-forms (expand-includes-in-forms (expand-cond-expands-in-forms forms))))
    ;; Step 1: Extract all library definitions into an alist: ((name . lib-rec) ...)
    (let loop-collect ((rest all-forms) (registry '()) (non-lib-forms '()))
      (if (not (null? rest))
          (let ((f (car rest)))
            (if (define-library-form? (strip-source-loc f))
                (let* ((actual-f (strip-source-loc f))
                       (rec (parse-define-library-form actual-f))
                       (name (lib-rec-name rec)))
                  (loop-collect (cdr rest) (cons (cons name rec) registry) non-lib-forms))
                (loop-collect (cdr rest) registry (cons f non-lib-forms))))

        ;; Step 2: Expand all imports and emit flat forms
        (let ((clean-forms (reverse non-lib-forms)))
          (let loop-expand ((fs clean-forms)
                            (instantiated-libs '())
                            (lib-aliases '())
                            (out-forms '()))
            (if (null? fs)
                (reverse out-forms)
                (let ((f (car fs)))
                  (if (import-form? f)
                      ;; Process (import iset ...)
                      (let loop-isets ((isets (cdr f))
                                       (cur-inst instantiated-libs)
                                       (cur-aliases lib-aliases)
                                       (acc-forms out-forms))
                        (if (null? isets)
                            (loop-expand (cdr fs) cur-inst cur-aliases acc-forms)
                            (let* ((iset (car isets))
                                   (res (resolve-import-set iset registry))
                                   (lib-name (car res))
                                   (sym-map (cdr res)))
                              (if (or (null? lib-name) (builtin-library-name? lib-name))
                                  (loop-isets (cdr isets) cur-inst cur-aliases acc-forms)
                                  (let* ((already-inst (assoc lib-name cur-aliases))
                                         (inst-info
                                          (if already-inst
                                              (cons (car already-inst) (cdr already-inst))
                                              (let ((rec (lookup-or-load-library lib-name registry)))
                                                (if rec
                                                    (let* ((inst-res (instantiate-library rec))
                                                           (lib-defs (car inst-res))
                                                           (aliases (cdr inst-res)))
                                                      (cons lib-defs aliases))
                                                    (cons '() '())))))
                                         (new-defs (if already-inst '() (car inst-info)))
                                         (export-aliases (if already-inst (cdr already-inst) (cdr inst-info)))
                                         (updated-aliases (if already-inst
                                                              cur-aliases
                                                              (cons (cons lib-name export-aliases) cur-aliases)))
                                         (updated-inst (if (memq lib-name cur-inst)
                                                           cur-inst
                                                           (cons lib-name cur-inst)))
                                         (alias-bindings
                                          (map (lambda (entry)
                                                 (let* ((exp-name (car entry))
                                                        (loc-name (cdr entry))
                                                        (ea (assq exp-name export-aliases)))
                                                   (if ea
                                                       (list 'define loc-name (cdr ea))
                                                       #f)))
                                               sym-map))
                                         (valid-bindings (filter (lambda (b) (pair? b)) alias-bindings)))
                                    (loop-isets (cdr isets)
                                                updated-inst
                                                updated-aliases
                                                (append (reverse valid-bindings)
                                                        (append (reverse new-defs) acc-forms))))))))
                      ;; Normal non-import form
                      (loop-expand (cdr fs)
                                   instantiated-libs
                                   lib-aliases
                                   (cons f out-forms)))))))))))
;;; =======================================================================
;;; ULisp Compiler Pass 015: Nanopass DSL Procedural Expander
;;; Conforms to DSN-33 Architecture Specification & Issues #587, #758
;;;
;;; Pre-emptively expands Nanopass DSL forms (define-language, define-pass,
;;; define-parser, define-unparser, define-picopass, define-femtopass,
;;; define-attopass) into canonical Scheme definitions
;;; before syntax-rules macro expansion (Pass 020). Also filters out
;;; host-only define-macro declarations to keep downstream passes pure.
;;; =======================================================================

(define (expand-dsl-forms forms)
  (let loop ((fs forms) (res '()))
    (if (null? fs)
        (reverse res)
        (let ((f (car fs)))
          (cond
            ((ast-has-span? f)
             (let ((span (ast-source-span f))
                   (inner (ast-strip-span f)))
               (cond
                 ((and (pair? inner) (memq (car inner) '(define-language define-pass trace-define-pass define-parser define-unparser define-picopass define-femtopass define-attopass define-pipeline define-value-repr)))
                  (let ((exp-inner (expand-dsl-forms (list inner))))
                    (loop (append (map (lambda (x) (ast-with-span x span)) exp-inner)
                                  (cdr fs))
                          res)))
                 ((and (pair? inner) (eq? (car inner) 'define-macro))
                  (loop (cdr fs) res))
                 (else
                  (loop (cdr fs) (cons f res))))))
            ((and (pair? f) (eq? (car f) '%source-loc))
             (let ((file (cadr f))
                   (line (caddr f))
                   (col (cadddr f))
                   (inner (car (cddddr f))))
               (cond
                 ((and (pair? inner) (memq (car inner) '(define-language define-pass trace-define-pass define-parser define-unparser define-picopass define-femtopass define-attopass define-pipeline define-value-repr)))
                  (let ((exp-inner (expand-dsl-forms (list inner))))
                    (loop (append (map (lambda (x) (list '%source-loc file line col x)) exp-inner)
                                  (cdr fs))
                          res)))
                 ((and (pair? inner) (eq? (car inner) 'define-macro))
                  (loop (cdr fs) res))
                 (else
                  (loop (cdr fs) (cons f res))))))
            ((and (pair? f) (eq? (car f) 'begin))
             (loop (append (cdr f) (cdr fs)) res))
            ((and (pair? f) (eq? (car f) 'define-macro))
             ;; Discard host-only macro definitions in compiler pipeline
             (loop (cdr fs) res))
            ((and (pair? f) (eq? (car f) 'define-language))
             (let ((expanded (nanopass-expand-define-language f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            ((and (pair? f) (eq? (car f) 'define-pass))
             (let ((expanded (nanopass-expand-define-pass f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            ((and (pair? f) (eq? (car f) 'trace-define-pass))
             (let ((expanded (nanopass-expand-trace-define-pass f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            ((and (pair? f) (eq? (car f) 'define-parser))
             (let ((expanded (nanopass-expand-define-parser f)))
               (loop (cons expanded (cdr fs)) res)))
            ((and (pair? f) (eq? (car f) 'define-unparser))
             (let ((expanded (nanopass-expand-define-unparser f)))
               (loop (cons expanded (cdr fs)) res)))
            ((and (pair? f) (eq? (car f) 'define-picopass))
             (let ((expanded (nanopass-expand-define-picopass f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            ((and (pair? f) (eq? (car f) 'define-femtopass))
             (let ((expanded (nanopass-expand-define-femtopass f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            ((and (pair? f) (eq? (car f) 'define-attopass))
             (let ((expanded (nanopass-expand-define-attopass f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            ((and (pair? f) (eq? (car f) 'define-pipeline))
             (let ((expanded (nanopass-expand-define-pipeline f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            ((and (pair? f) (eq? (car f) 'define-value-repr))
             (let ((expanded (expand-define-value-repr f)))
               (loop (append (if (and (pair? expanded) (eq? (car expanded) 'begin))
                                 (cdr expanded)
                                 (list expanded))
                             (cdr fs))
                     res)))
            (else
             (loop (cdr fs) (cons f res))))))))
;;; =======================================================================
;;; ULisp Compiler Pass 0b: Hygienic syntax-rules Macro Expander
;;; Conforms to DSN-33 Architecture Specification & Issue #533 (R7RS 4.3)
;;;
;;; Provides self-contained compile-time hygienic macro expansion
;;; without relying on host runtime eval. Fully operational in both host
;;; Scheme (ILisp) and self-hosted native AOT binaries (Stage 1/2/3).
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Hygiene & Unique Identifier Generation
;;; -----------------------------------------------------------------------

(define *hygiene-counter* (cons 0 '()))

(define (reset-hygiene-counter!)
  (set-car! *hygiene-counter* 0))

(define (hygiene-gensym sym)
  (let ((cnt (car *hygiene-counter*)))
    (set-car! *hygiene-counter* (+ cnt 1))
    (string->symbol (string-append "__hyg_" (symbol->string sym) "_" (number->string cnt)))))

;;; Built-in core keywords and primitives that must NOT be renamed during hygienic expansion
(define (core-form-or-primitive? sym)
  (case sym
    ((if begin lambda let let* letrec letrec* quote set! define define-values define-syntax syntax-rules syntax-error define-record-type
      let-syntax letrec-syntax cond-expand include include-ci assume assert
      cond case and or when unless delay delay-force do case-lambda
      receive rec and-let* cut cute <> <...>
      cons car cdr pair? null? list append not eq? eqv? equal?
      list-copy make-list
      vector vector-ref vector-set! vector-length make-vector vector-copy vector-copy! vector-append vector-fill! vector-map vector-for-each vector->list list->vector vector->string vector->string-range
      string string-ref string-set! string-length make-string string-append string-copy string-copy! string-fill! string-map string-for-each substring string=? string<? string>? string<=? string>=? string->symbol symbol->string string->list string->list-range list->string string->vector string->vector-range
      bytevector bytevector-u8-ref bytevector-u8-set! bytevector-length make-bytevector bytevector-copy bytevector-copy! bytevector-append bytevector=?
      + - * = < > <= >= modulo quotient / square remainder gcd gcd-2 lcm lcm-2 expt %math-abs
      zero? fixnum? integer? number? exact? exact-integer? inexact? real? rational? complex?
      boolean? char? symbol? string? list? vector? bytevector?
      write-char %write-char write-string %write-string read-char %read-char peek-char %peek-char eof-object?
      values call-with-values dynamic-wind call/cc call-with-current-continuation
      guard raise %raw-call/cc %with-handler
      %memory-fence %atomic-cas!)
     #t)
    (else #f)))

;;; -----------------------------------------------------------------------
;;; 2. Pattern Matching Utilities
;;; -----------------------------------------------------------------------

(define (ellipsis? x)
  (and (symbol? x) (eq? x '...)))

(define (underscore? x)
  (and (symbol? x) (eq? x '_)))

(define (literal? sym literals)
  (and (symbol? sym) (memq sym literals)))

;;; Extract all pattern variables from a pattern
(define (extract-pattern-vars pat literals)
  (cond
    ((null? pat) '())
    ((underscore? pat) '())
    ((ellipsis? pat) '())
    ((symbol? pat)
     (if (literal? pat literals)
         '()
         (list pat)))
    ((pair? pat)
     (append (extract-pattern-vars (car pat) literals)
             (extract-pattern-vars (cdr pat) literals)))
    (else '())))

;;; Compute length of a proper or dotted list
(define (pattern-length p)
  (let loop ((cur p) (len 0))
    (cond
      ((null? cur) len)
      ((pair? cur) (loop (cdr cur) (+ len 1)))
      (else (+ len 1)))))

;;; Match a single element pattern against input
(define (match-element pat input literals env)
  (cond
    ((underscore? pat)
     (cons #t env))
    ((literal? pat literals)
     (if (and (symbol? input) (eq? pat input))
         (cons #t env)
         (cons #f '())))
    ((symbol? pat)
     (cons #t (cons (cons pat input) env)))
    ((pair? pat)
     (if (pair? input)
         (match-pattern-sequence pat input literals env)
         (cons #f '())))
    (else
     (if (equal? pat input)
         (cons #t env)
         (cons #f '())))))

;;; Match a sequence of pattern elements against input list
(define (match-pattern-sequence pat input literals env)
  (cond
    ((and (null? pat) (null? input))
     (cons #t env))
    ((null? pat)
     (cons #f '()))
    ((not (pair? pat))
     ;; Dotted tail match
     (match-element pat input literals env))
    ;; Ellipsis pattern: (elem ... . rest-pat)
    ((and (pair? (cdr pat)) (ellipsis? (cadr pat)))
     (let* ((elem-pat (car pat))
            (rest-pat (cddr pat))
            (elem-vars (extract-pattern-vars elem-pat literals))
            (min-rest-len (length (if (pair? rest-pat) rest-pat '())))
            (input-len (if (list? input) (length input) 0)))
       (if (< input-len min-rest-len)
           (cons #f '())
           (let* ((num-ellipsis (- input-len min-rest-len))
                  ;; Split input into ellipsis items and rest items
                  (ellipsis-items (let take ((n num-ellipsis) (cur input))
                                    (if (<= n 0) '()
                                        (cons (car cur) (take (- n 1) (cdr cur))))))
                  (rest-items (let drop ((n num-ellipsis) (cur input))
                                (if (<= n 0) cur
                                    (drop (- n 1) (cdr cur))))))
             ;; Match each ellipsis item against elem-pat
             (let loop ((items ellipsis-items) (matched-envs '()))
               (if (null? items)
                   ;; Aggregate matched variables into lists
                   (let* ((agg-bindings
                           (map (lambda (var)
                                  (cons var
                                        (map (lambda (sub-env)
                                               (let ((p (assq var sub-env)))
                                                 (if p (cdr p) #f)))
                                             (reverse matched-envs))))
                                elem-vars))
                          (env-with-ellipsis (append agg-bindings env)))
                     ;; Match rest of pattern
                     (match-pattern-sequence rest-pat rest-items literals env-with-ellipsis))
                   (let ((sub-match (match-element elem-pat (car items) literals '())))
                     (if (car sub-match)
                         (loop (cdr items) (cons (cdr sub-match) matched-envs))
                         (cons #f '())))))))))
    ;; Normal element
    ((pair? input)
     (let ((head-match (match-element (car pat) (car input) literals env)))
       (if (car head-match)
           (match-pattern-sequence (cdr pat) (cdr input) literals (cdr head-match))
           (cons #f '()))))
    (else
     (cons #f '()))))

;;; Match an entire macro pattern against input form
;;; Pattern starts with keyword or underscore: (_ a b ...)
(define (match-macro-pattern pat input literals)
  (if (and (pair? pat) (pair? input))
      (match-pattern-sequence (cdr pat) (cdr input) literals '())
      (cons #f '())))

;;; -----------------------------------------------------------------------
;;; 3. Template Expansion and Hygienic Renaming
;;; -----------------------------------------------------------------------

(define (extract-formals formals pat-vars)
  (cond
    ((null? formals) '())
    ((symbol? formals)
     (if (memq formals pat-vars) '() (list formals)))
    ((pair? formals)
     (append (extract-formals (car formals) pat-vars)
             (extract-formals (cdr formals) pat-vars)))
    (else '())))

(define (extract-binding-vars bindings pat-vars)
  (cond
    ((null? bindings) '())
    ((pair? bindings)
     (let ((b (car bindings)))
       (append (if (and (pair? b) (symbol? (car b)) (not (memq (car b) pat-vars)))
                   (list (car b))
                   '())
               (extract-binding-vars (cdr bindings) pat-vars))))
    (else '())))

;;; Collect all variables introduced by binding forms in a template that need renaming (macro-introduced local identifiers)
(define (collect-template-binders tmpl pat-vars literals)
  (cond
    ((not (pair? tmpl)) '())
    ((eq? (car tmpl) 'quote) '())
    ;; (lambda <formals> <body> ...)
    ((and (eq? (car tmpl) 'lambda) (pair? (cdr tmpl)))
     (let ((formals (cadr tmpl))
           (body (cddr tmpl)))
       (append (extract-formals formals pat-vars)
               (collect-template-binders body pat-vars literals))))
    ;; (let ((<var> <init>) ...) <body> ...)
    ;; or named let: (let <name> ((<var> <init>) ...) <body> ...)
    ((and (memq (car tmpl) '(let let* letrec letrec*)) (pair? (cdr tmpl)))
     (cond
       ;; named let: (let <name> ((<var> <init>) ...) ...)
       ((and (eq? (car tmpl) 'let) (symbol? (cadr tmpl)) (pair? (cddr tmpl)))
        (let ((name (cadr tmpl))
              (bindings (caddr tmpl))
              (body (cdddr tmpl)))
          (append (if (memq name pat-vars) '() (list name))
                  (append (extract-binding-vars bindings pat-vars)
                          (append (collect-template-binders bindings pat-vars literals)
                                  (collect-template-binders body pat-vars literals))))))
       ;; normal let / let* / letrec: (let ((<var> <init>) ...) ...)
       ((pair? (cdr tmpl))
        (let ((bindings (cadr tmpl))
              (body (cddr tmpl)))
          (append (extract-binding-vars bindings pat-vars)
                  (append (collect-template-binders bindings pat-vars literals)
                          (collect-template-binders body pat-vars literals)))))
       (else '())))
    (else
     (append (collect-template-binders (car tmpl) pat-vars literals)
             (collect-template-binders (cdr tmpl) pat-vars literals)))))

(define (remove-duplicates ls)
  (let loop ((cur ls) (res '()))
    (cond
      ((null? cur) (reverse res))
      ((memq (car cur) res) (loop (cdr cur) res))
      (else (loop (cdr cur) (cons (car cur) res))))))

;;; Expand a template with given pattern environment and renaming map
(define (expand-template tmpl env literals rename-map)
  (cond
    ((null? tmpl) '())
    ((symbol? tmpl)
     (let ((p (assq tmpl env)))
       (if p
           (cdr p)
           (let ((r (assq tmpl rename-map)))
             (if r
                 (cdr r)
                 tmpl)))))
    ((pair? tmpl)
     (cond
       ;; Quote preserves literal symbols without hygienic renaming, but expands pattern variables
       ((eq? (car tmpl) 'quote)
        (cons 'quote
              (map (lambda (x) (expand-template x env literals '()))
                   (cdr tmpl))))
       ;; Ellipsis repetition in template: (elem ... . rest)
       ((and (pair? (cdr tmpl)) (ellipsis? (cadr tmpl)))
        (let* ((elem-tmpl (car tmpl))
               (rest-tmpl (cddr tmpl))
               ;; Find variables used in elem-tmpl that are lists in env
               (vars-in-elem (remove-duplicates (extract-pattern-vars elem-tmpl literals)))
               (ellipsis-vars (filter (lambda (v)
                                        (let ((p (assq v env)))
                                          (and p (list? (cdr p)))))
                                      vars-in-elem)))
          (if (null? ellipsis-vars)
              ;; Zero repetitions or non-ellipsis variable
              (expand-template rest-tmpl env literals rename-map)
              (let* ((first-v (car ellipsis-vars))
                     (repeat-count (length (cdr (assq first-v env))))
                     (repeated-elements
                      (let loop ((i 0) (acc '()))
                        (if (>= i repeat-count)
                            (reverse acc)
                            (let* ((sub-env
                                    (map (lambda (v)
                                           (cons v (list-ref (cdr (assq v env)) i)))
                                         ellipsis-vars))
                                   (merged-env (append sub-env env))
                                   (expanded-elem (expand-template elem-tmpl merged-env literals rename-map)))
                              (loop (+ i 1) (cons expanded-elem acc)))))))
                (append repeated-elements (expand-template rest-tmpl env literals rename-map))))))
       (else
        (cons (expand-template (car tmpl) env literals rename-map)
              (expand-template (cdr tmpl) env literals rename-map)))))
    (else tmpl)))

;;; -----------------------------------------------------------------------
;;; 4. syntax-rules Macro Transformer
;;; -----------------------------------------------------------------------

;;; Representation: ('syntax-rules-macro name literals rules)
;;; rule: (pattern template)
(define (syntax-rules-macro? obj)
  (and (pair? obj) (eq? (car obj) 'syntax-rules-macro)))

(define (macro-name m) (cadr m))
(define (macro-literals m) (caddr m))
(define (macro-rules m) (cadddr m))

(define (apply-syntax-rules-macro m input)
  (let ((literals (macro-literals m))
        (rules (macro-rules m)))
    (let loop ((rls rules))
      (if (null? rls)
          (error "apply-syntax-rules-macro [R7RS §4.3.2]: no matching syntax-rules pattern for" input)
          (let* ((rule (car rls))
                 (pat (car rule))
                 (tmpl (cadr rule))
                 (match-res (match-macro-pattern pat input literals)))
            (if (car match-res)
                (let* ((env (cdr match-res))
                       (pat-vars (extract-pattern-vars pat literals))
                       (binders-to-rename (remove-duplicates (collect-template-binders tmpl pat-vars literals)))
                       (rename-map (map (lambda (s) (cons s (hygiene-gensym s))) binders-to-rename)))
                  (expand-template tmpl env literals rename-map))
                (loop (cdr rls))))))))

;;; -----------------------------------------------------------------------
;;; 5. Macro Definition Parsing and Top-level Expansion Pass
;;; -----------------------------------------------------------------------

(define (macro-def? form)
  (and (pair? form)
       (eq? (car form) 'define-syntax)))

(define (parse-syntax-rules-def form)
  ;; (define-syntax <name> (syntax-rules (<literal> ...) (<pattern> <template>) ...))
  (if (and (pair? (cdr form))
           (symbol? (cadr form))
           (pair? (cddr form))
           (pair? (caddr form))
           (eq? (car (caddr form)) 'syntax-rules))
      (let* ((name (cadr form))
             (sr-spec (caddr form))
             (literals (cadr sr-spec))
             (rules (cddr sr-spec)))
        (list 'syntax-rules-macro name literals rules))
      (error "parse-syntax-rules-def [R7RS §5.4]: invalid define-syntax syntax" form)))

(define (rename-symbol-in-tree tree old-sym new-sym)
  (cond
    ((null? tree) '())
    ((eq? tree old-sym) new-sym)
    ((pair? tree)
     (cons (rename-symbol-in-tree (car tree) old-sym new-sym)
           (rename-symbol-in-tree (cdr tree) old-sym new-sym)))
    ((vector? tree)
     (let* ((len (vector-length tree))
            (new-v (%make-vector len)))
       (let loop ((i 0))
         (if (< i len)
             (begin
               (vector-set! new-v i (rename-symbol-in-tree (vector-ref tree i) old-sym new-sym))
               (loop (+ i 1)))
             new-v))))
    (else tree)))

(define (apply-rename-map tree rename-map)
  (let loop ((cur rename-map) (res tree))
    (if (null? cur)
        res
        (let* ((entry (car cur))
               (old-sym (car entry))
               (new-sym (cdr entry)))
          (loop (cdr cur) (rename-symbol-in-tree res old-sym new-sym))))))

(define (parse-macro-binding b)
  ;; b is (<name> (syntax-rules (<literal> ...) (<pattern> <template>) ...))
  (if (and (pair? b)
           (symbol? (car b))
           (pair? (cdr b))
           (pair? (cadr b))
           (eq? (car (cadr b)) 'syntax-rules)
           (pair? (cdr (cadr b))))
      (let* ((name (car b))
             (sr-spec (cadr b))
             (literals (cadr sr-spec))
             (rules (cddr sr-spec)))
        (cons name (list 'syntax-rules-macro name literals rules)))
      (error "syntax-error [R7RS §4.3.1]: invalid macro binding syntax" b)))

(define (expand-let-syntax expr macro-table is-rec)
  (if (and (pair? (cdr expr))
           (list? (cadr expr))
           (pair? (cddr expr)))
      (let* ((raw-bindings (cadr expr))
             (body (cddr expr)))
        (if is-rec
            ;; letrec-syntax: transformers and body share the new-macro-table
            (let* ((local-entries (map parse-macro-binding raw-bindings))
                   (new-macro-table (append local-entries macro-table))
                   (expanded-body
                    (if (null? (cdr body))
                        (macro-expand-all (car body) new-macro-table)
                        (cons 'begin
                              (map (lambda (e) (macro-expand-all e new-macro-table)) body)))))
              expanded-body)
            ;; let-syntax: transformers are in outer scope, body is in new scope
            (let loop ((bs raw-bindings)
                       (local-entries '())
                       (extra-outer '())
                       (restore-map '()))
              (if (null? bs)
                  (let* ((new-macro-table (append local-entries (append extra-outer macro-table)))
                         (expanded-body
                          (if (null? (cdr body))
                              (macro-expand-all (car body) new-macro-table)
                              (cons 'begin
                                    (map (lambda (e) (macro-expand-all e new-macro-table)) body)))))
                    (apply-rename-map expanded-body restore-map))
                  (let* ((b (car bs))
                         (parsed (parse-macro-binding b))
                         (name (car parsed))
                         (macro-desc (cdr parsed))
                         (literals (macro-literals macro-desc))
                         (rules (macro-rules macro-desc))
                         (outer-entry (assq name macro-table)))
                    (if outer-entry
                        ;; Outer macro exists: rename name in template to alias pointing to outer macro
                        (let* ((alias (hygiene-gensym name))
                               (renamed-rules
                                (map (lambda (r)
                                       (list (car r)
                                             (rename-symbol-in-tree (cadr r) name alias)))
                                     rules))
                               (new-desc (list 'syntax-rules-macro name literals renamed-rules)))
                          (loop (cdr bs)
                                (cons (cons name new-desc) local-entries)
                                (cons (cons alias (cdr outer-entry)) extra-outer)
                                restore-map))
                        ;; No outer macro: rename name in template to restore-alias so it is not re-expanded locally
                        (let* ((restore-alias (hygiene-gensym name))
                               (renamed-rules
                                (map (lambda (r)
                                       (list (car r)
                                             (rename-symbol-in-tree (cadr r) name restore-alias)))
                                     rules))
                               (new-desc (list 'syntax-rules-macro name literals renamed-rules)))
                          (loop (cdr bs)
                                (cons (cons name new-desc) local-entries)
                                extra-outer
                                (cons (cons restore-alias name) restore-map)))))))))
      (error "syntax-error [R7RS §4.3.1]: invalid let-syntax/letrec-syntax syntax" expr)))

(define (macro-expand-1 expr macro-table)
  (let* ((has-span? (or (ast-has-span? expr) (source-loc? expr)))
         (span (if has-span? (ast-source-span expr) #f))
         (clean-expr (if has-span? (ast-strip-span expr) expr)))
    (if (and (pair? clean-expr) (symbol? (car clean-expr)))
        (let ((entry (assq (car clean-expr) macro-table)))
          (if entry
              (let* ((macro-desc (cdr entry))
                     (expanded (apply-syntax-rules-macro macro-desc clean-expr)))
                (if span
                    (let ((new-span (make-source-span (span-file span)
                                                      (span-start-line span)
                                                      (span-start-col span)
                                                      (span-end-line span)
                                                      (span-end-col span)
                                                      span
                                                      (next-source-span-id!))))
                      (cons #t (ast-with-span expanded new-span)))
                    (cons #t expanded)))
              (cons #f expr)))
        (cons #f expr))))

(define (macro-expand-top-expr expr macro-table)
  (let ((res (macro-expand-1 expr macro-table)))
    (if (car res)
        (macro-expand-top-expr (cdr res) macro-table)
        (cdr res))))

(define (safe-macro-expand-list ls macro-table)
  (let loop ((cur ls) (acc (quote ())))
    (cond
      ((null? cur) (reverse acc))
      ((not (pair? cur)) (append (reverse acc) (macro-expand-all cur macro-table)))
      (else
       (loop (cdr cur) (cons (macro-expand-all (car cur) macro-table) acc))))))

;;; Expand case clauses: datum lists (and `else`) are preserved verbatim,
;;; only clause bodies are macro-expanded.
(define (safe-macro-expand-case-clauses clauses macro-table)
  (let loop ((cur clauses) (acc (quote ())))
    (cond
      ((null? cur) (reverse acc))
      ((not (pair? cur)) (append (reverse acc) cur))
      ((pair? (car cur))
       (let ((clause (car cur)))
         (loop (cdr cur)
               (cons (cons (car clause)
                           (safe-macro-expand-list (cdr clause) macro-table))
                     acc))))
      (else
       (loop (cdr cur) (cons (car cur) acc))))))

(define (safe-macro-expand-bindings bs macro-table)
  (let loop ((cur bs) (acc (quote ())))
    (cond
      ((null? cur) (reverse acc))
      ((not (pair? cur)) (append (reverse acc) cur))
      ((pair? (car cur))
       (let* ((b (car cur))
              (var (car b))
              (val-exprs (safe-macro-expand-list (cdr b) macro-table)))
         (loop (cdr cur) (cons (cons var val-exprs) acc))))
      (else
       (loop (cdr cur) (cons (car cur) acc))))))

(define (macro-expand-all expr macro-table)
  (let ((expanded (macro-expand-top-expr expr macro-table)))
    (cond
      ((not (pair? expanded))
       (if (vector? expanded)
           (cons (quote vector)
                 (map (lambda (x)
                        (if (symbol? x)
                            (list (quote quote) x)
                            (macro-expand-all x macro-table)))
                      (vector->list expanded)))
           expanded))
      ((eq? (car expanded) (quote quote))
       expanded)
      ((eq? (car expanded) (quote syntax-error))
       (let ((msg (if (and (pair? (cdr expanded)) (string? (cadr expanded)))
                      (cadr expanded)
                      "invalid syntax"))
             (irritants (if (and (pair? (cdr expanded)) (string? (cadr expanded)))
                            (cddr expanded)
                            (cdr expanded))))
         (error (string-append "syntax-error [R7RS §4.3.1]: " msg) irritants)))
      ((eq? (car expanded) (quote case))
       (if (and (pair? (cdr expanded)) (pair? (cddr expanded)))
           (cons (quote case)
                 (cons (macro-expand-all (cadr expanded) macro-table)
                       (safe-macro-expand-case-clauses (cddr expanded) macro-table)))
           expanded))
      ((eq? (car expanded) (quote case-lambda))
       (cons (quote case-lambda)
             (map (lambda (clause)
                    (if (pair? clause)
                        (cons (car clause)
                              (safe-macro-expand-list (cdr clause) macro-table))
                        clause))
                  (cdr expanded))))
      ((eq? (car expanded) (quote lambda))
       (if (and (pair? (cdr expanded)) (pair? (cddr expanded)))
           (cons (quote lambda)
                 (cons (cadr expanded)
                       (safe-macro-expand-list (cddr expanded) macro-table)))
           expanded))
      ((eq? (car expanded) (quote define))
       (if (and (pair? (cdr expanded)) (pair? (cddr expanded)))
           (if (vector? (cadr expanded))
               (quote #t)
               (cons (quote define)
                     (cons (cadr expanded)
                           (safe-macro-expand-list (cddr expanded) macro-table))))
           expanded))
      ((eq? (car expanded) (quote define-record-type))
       expanded)
      ((eq? (car expanded) (quote let-syntax))
       (expand-let-syntax expanded macro-table #f))
      ((eq? (car expanded) (quote letrec-syntax))
       (expand-let-syntax expanded macro-table #t))
      ((eq? (car expanded) (quote cond-expand))
       (macro-expand-all (desugar-cond-expand (cdr expanded)) macro-table))
      ((or (eq? (car expanded) (quote let))
           (eq? (car expanded) (quote let*))
           (eq? (car expanded) (quote letrec))
           (eq? (car expanded) (quote letrec*)))
       (if (and (pair? (cdr expanded)) (symbol? (cadr expanded)))
           (if (and (pair? (cddr expanded)) (pair? (cdddr expanded)))
               (cons (car expanded)
                     (cons (cadr expanded)
                           (cons (safe-macro-expand-bindings (caddr expanded) macro-table)
                                 (safe-macro-expand-list (cdddr expanded) macro-table))))
               expanded)
           (if (and (pair? (cdr expanded)) (pair? (cddr expanded)))
               (cons (car expanded)
                     (cons (safe-macro-expand-bindings (cadr expanded) macro-table)
                           (safe-macro-expand-list (cddr expanded) macro-table)))
               expanded)))
      (else
       (safe-macro-expand-list expanded macro-table)))))


(define (expand-macros-in-forms forms)
  (let loop ((fs forms) (macro-table '()) (res '()))
    (if (null? fs)
        (reverse res)
        (let ((f (car fs)))
          (cond
            ((ast-has-span? f)
             (let* ((span (ast-source-span f))
                    (inner (ast-strip-span f)))
               (if (macro-def? inner)
                   (let* ((macro-desc (parse-syntax-rules-def inner))
                          (name (macro-name macro-desc)))
                     (loop (cdr fs) (cons (cons name macro-desc) macro-table) res))
                   (let ((exp-f (macro-expand-all inner macro-table)))
                     (loop (cdr fs) macro-table (cons (ast-with-span exp-f span) res))))))
            ((source-loc? f)
             (let* ((file (source-loc-file f))
                    (line (source-loc-line f))
                    (col (source-loc-col f))
                    (inner (source-loc-form f)))
               (if (macro-def? inner)
                   (let* ((macro-desc (parse-syntax-rules-def inner))
                          (name (macro-name macro-desc)))
                     (loop (cdr fs) (cons (cons name macro-desc) macro-table) res))
                   (let ((exp-f (macro-expand-all inner macro-table)))
                     (loop (cdr fs) macro-table (cons (list '%source-loc file line col exp-f) res))))))
            ((macro-def? f)
             (let* ((macro-desc (parse-syntax-rules-def f))
                    (name (macro-name macro-desc)))
               (loop (cdr fs) (cons (cons name macro-desc) macro-table) res)))
            (else
             (let ((exp-f (macro-expand-all f macro-table)))
               (loop (cdr fs) macro-table (cons exp-f res)))))))))

;;; =======================================================================
;;; ULisp Compiler Pass 025: Top-Level Definition Lifting & Normalization
;;; Conforms to DSN-33 Architecture Specification & Issue #570
;;; Hoists all top-level (define ...) forms into canonical (%program ...) AST.
;;; =======================================================================

;; Names declared (declare (no-safepoints)); consulted by the safepoint pass.
(define *declared-no-safepoint-names* (cons '() '()))

(define (register-no-safepoints-name! name)
  (if (not (memq name (car *declared-no-safepoint-names*)))
      (set-car! *declared-no-safepoint-names*
                (cons name (car *declared-no-safepoint-names*)))))

(define (no-safepoints-decl-form? e)
  (and (pair? e)
       (eq? (car e) 'declare)
       (pair? (cdr e))
       (let ((d (cadr e)))
         (or (eq? d 'no-safepoints)
             (eq? d 'no-safepoint)
             (and (pair? d) (or (eq? (car d) 'no-safepoints) (eq? (car d) 'no-safepoint)))))))

(define (record-type-tag-symbol type-name)
  (string->symbol (string-append "%%record-type-" (symbol->string type-name))))

(define (expand-define-record-type form)
  ;; form: (define-record-type <name> (<ctor> <ctor-args> ...) <pred> <field-spec> ...)
  ;; each field-spec: (<fname> <getter>) or (<fname> <getter> <setter>)
  (let* ((type-name (cadr form))
         (ctor-spec (caddr form))
         (ctor-name (if (pair? ctor-spec) (car ctor-spec) ctor-spec))
         (ctor-args (if (pair? ctor-spec) (cdr ctor-spec) '()))
         (pred-name (cadddr form))
         (field-specs (cddddr form))
         (tag (record-type-tag-symbol type-name))
         (field-names (map car* field-specs)))
    (let* ((ctor-def
            (let ((vec-args
                   (map (lambda (f)
                          (if (memq f ctor-args)
                              f
                              #f))
                        field-names)))
              (list 'define (cons ctor-name ctor-args)
                    '(declare (no-safepoints))
                    (cons 'vector (cons (list 'quote tag) vec-args)))))
           (pred-arg (unique-symbol "rec_"))
           (pred-def
            (list 'define (list pred-name pred-arg)
                  '(declare (no-safepoints))
                  (list 'and
                        (list 'vector? pred-arg)
                        (list '> (list 'vector-length pred-arg) 0)
                        (list 'eq? (list 'vector-ref pred-arg 0) (list 'quote tag))))))
      (let loop ((specs field-specs) (idx 1) (acc (list ctor-def pred-def)))
        (if (null? specs)
            (reverse acc)
            (let* ((spec (car specs))
                   (fname (car spec))
                   (getter (cadr spec))
                   (has-setter? (pair? (cddr spec)))
                   (setter (if has-setter? (caddr spec) #f))
                   (get-arg (unique-symbol "rec_"))
                   (get-def (list 'define (list getter get-arg)
                                  '(declare (no-safepoints))
                                  (list 'vector-ref get-arg idx)))
                   (set-defs
                    (if has-setter?
                        (let ((set-arg (unique-symbol "rec_"))
                              (val-arg (unique-symbol "val_")))
                          (list (list 'define (list setter set-arg val-arg)
                                      '(declare (no-safepoints))
                                      (list 'vector-set! set-arg idx val-arg))))
                        '())))
              (loop (cdr specs)
                    (+ idx 1)
                    (append (reverse set-defs) (cons get-def acc)))))))))

(define (expand-define-values form)
  (let* ((formals (cadr form))
         (expr (caddr form)))
    (cond
      ((null? formals)
       (let ((dummy (unique-symbol "dummy_vals_")))
         (list (list 'define dummy
                     (list 'call-with-values
                           (list 'lambda '() expr)
                           (list 'lambda '() #f))))))
      ((and (pair? formals) (null? (cdr formals)))
       ;; Single formal: (define-values (x) expr)
       (let ((var (car formals)))
         (list (list 'define var
                     (list 'call-with-values
                           (list 'lambda '() expr)
                           (list 'lambda (list var) var))))))
      ((list? formals)
       ;; Proper list of formals: (define-values (x y ...) expr)
       (let* ((temp (unique-symbol "tmp_vals_"))
              (producer (list 'lambda '() expr))
              (consumer (list 'lambda formals (cons 'vector formals)))
              (temp-def (list 'define temp (list 'call-with-values producer consumer))))
         (let loop ((idx 0) (vars formals) (acc (list temp-def)))
           (if (null? vars)
               (reverse acc)
               (loop (+ idx 1)
                     (cdr vars)
                     (cons (list 'define (car vars)
                                 (list 'vector-ref temp idx))
                           acc))))))
      (else
       (error "define-values: invalid formals" formals)))))

(define (symbol-directive? sym)
  (if (symbol? sym)
      (let ((s (symbol->raw-name sym)))
        (let ((len (string-length s)))
          (and (> len 0)
               (or (char=? (string-ref s 0) #\!)
                   (and (> len 1)
                        (char=? (string-ref s 0) #\-)
                        (char=? (string-ref s 1) #\-))))))
      #f))

(define (rewrite-top-level forms)
  (let loop ((fs forms) (defs '()) (bodies '()))
    (if (null? fs)
        (if (null? defs)
            (ast-strip-span-all (make-body-expr (reverse bodies)))
            (let* ((rev-defs (reverse defs))
                   (unique-defs
                    (let dedup ((ds (reverse rev-defs)) (seen '()) (acc '()))
                      (if (null? ds)
                          acc
                          (let* ((d (car ds))
                                 (name (cadr d)))
                            (if (memq name seen)
                                (dedup (cdr ds) seen acc)
                                (dedup (cdr ds) (cons name seen) (cons d acc))))))))
              (list '%program (ast-strip-span-all unique-defs) (ast-strip-span-all (make-body-expr (reverse bodies))))))
        (let ((f (car fs)))
          (if (pair? f)
              (set-current-form! f))
          (cond
            ((ast-has-span? f)
             (let* ((span (ast-source-span f))
                    (inner (ast-strip-span f)))
               (set-current-source-file! (span-file span))
               (set-current-source-line! (span-start-line span))
               (set-current-source-col! (span-start-col span))
               (set-current-ast-span! span)
               (loop (cons inner (cdr fs)) defs bodies)))
            ((and (pair? f) (eq? (car f) '%source-loc))
             (let ((file (cadr f))
                   (line (caddr f))
                   (col (cadddr f))
                   (inner (car (cddddr f))))
               (set-current-source-file! file)
               (set-current-source-line! line)
               (set-current-source-col! col)
               (loop (cons inner (cdr fs)) defs bodies)))
            ((and (pair? f) (eq? (car f) 'begin))
             (loop (append (cdr f) (cdr fs)) defs bodies))
            ;; Skip compiler directives (!... or --...) appearing anywhere at top level
            ((or (and (pair? f)
                      (symbol? (car f))
                      (symbol-directive? (car f)))
                 (and (symbol? f)
                      (symbol-directive? f)))
             (loop (cdr fs) defs bodies))
            ((and (pair? f) (eq? (car f) 'define-record-type))
             (set-current-toplevel-name! (cadr f))
             (let ((expanded-defs (expand-define-record-type f)))
               (loop (append expanded-defs (cdr fs)) defs bodies)))
            ((and (pair? f) (eq? (car f) 'define-values))
             (set-current-toplevel-name! 'define-values)
             (let ((expanded-defs (expand-define-values f)))
               (loop (append expanded-defs (cdr fs)) defs bodies)))
            ((and (pair? f) (eq? (car f) 'define))
             (let ((def-spec (cadr f)))
               (if (pair? def-spec)
                   ;; (define (name . params) . body)
                   (let* ((name (car def-spec))
                          (params (cdr def-spec))
                          (raw-lbody (cddr f))
                          (decl? (and (pair? raw-lbody) (no-safepoints-decl-form? (car raw-lbody))))
                          (lbody (if decl?
                                     (if (null? (cdr raw-lbody)) (list #t) (cdr raw-lbody))
                                     raw-lbody)))
                     (if decl? (register-no-safepoints-name! name))
                     (set-current-toplevel-name! name)
                     (if (not (eq? (current-source-file) 'none))
                         (register-function-source-loc! name (current-source-file) (current-source-line) (current-source-col)))
                     (loop (cdr fs)
                           (cons (list 'define name (cons 'lambda (cons params lbody))) defs)
                           bodies))
                   ;; (define name val)
                   (let* ((name def-spec)
                          (raw-val (caddr f))
                          (decl? (and (pair? raw-val) (eq? (car raw-val) 'begin) (pair? (cdr raw-val))
                                      (no-safepoints-decl-form? (cadr raw-val))))
                          (val (if decl?
                                   (let ((rest (cddr raw-val)))
                                     (cond ((null? rest) #t)
                                           ((null? (cdr rest)) (car rest))
                                           (else (cons 'begin rest))))
                                   raw-val)))
                     (if decl? (register-no-safepoints-name! name))
                     (set-current-toplevel-name! name)
                     (if (not (eq? (current-source-file) 'none))
                         (register-function-source-loc! name (current-source-file) (current-source-line) (current-source-col)))
                     (loop (cdr fs)
                           (cons (list 'define name val) defs)
                           bodies)))))
            (else
             ;; Normal expression
             (set-current-toplevel-name! '%main)
             (if (and (not (eq? (current-source-file) 'none))
                      (not (lookup-function-source-loc '%main)))
                 (register-function-source-loc! '%main (current-source-file) (current-source-line) (current-source-col)))
             (loop (cdr fs) defs (cons f bodies))))))))
;;; =======================================================================
;;; ULisp Compiler Pass 026: Constructor Desugaring Pass
;;; Conforms to DSN-33 Architecture Specification & Nanopass Standard
;;; Desugars composite literal constructors (list, vector, bytevector,
;;; string operations, math variadics, format, CxR accessors)
;;; Refactored to define-picopass + fuse-rules per Issue #762 (DSN-33-01 T4.1)
;;; =======================================================================

(define (desugar-list args)
  (if (null? args)
      ''()
      (cons 'cons (cons (car args) (cons (desugar-list (cdr args)) '())))))

(define (desugar-string args)
  (let* ((len (length args))
         (str-sym (unique-symbol "str_")))
    (let loop ((rest args) (idx 0) (sets '()))
      (if (null? rest)
          (list 'let (list (list str-sym (list 'make-string len)))
                (cons 'begin (reverse (cons str-sym sets))))
          (loop (cdr rest)
                (+ idx 1)
                (cons (list 'string-set! str-sym idx (car rest)) sets))))))

(define (desugar-string-append args)
  (cond
    ((null? args) "")
    ((null? (cdr args)) (car args))
    ((null? (cddr args)) (list (string->symbol "string-append2") (car args) (cadr args)))
    (else
     ;; Split args into two halves to keep tree depth O(log N)
     (let* ((len (length args))
            (half (quotient len 2)))
       (let loop ((rest args) (i 0) (left '()))
         (if (< i half)
             (loop (cdr rest) (+ i 1) (cons (car rest) left))
             (list (string->symbol "string-append2")
                   (desugar-string-append (reverse left))
                   (desugar-string-append rest))))))))

(define (desugar-string-copy args)
  (cond
    ((null? (cdr args))
     (let ((s-sym (unique-symbol "s_")))
       (list 'let (list (list s-sym (car args)))
             (list 'string-copy-range s-sym 0 (list 'string-length s-sym)))))
    ((null? (cddr args))
     (let ((s-sym (unique-symbol "s_")))
       (list 'let (list (list s-sym (car args)))
             (list 'string-copy-range s-sym (cadr args) (list 'string-length s-sym)))))
    (else
     (cons 'string-copy-range args))))

(define (desugar-string-copy! args)
  (if (null? (cdddr args))
      (let ((from-sym (unique-symbol "from_")))
        (list 'let (list (list from-sym (caddr args)))
              (list 'string-copy-range! (car args) (cadr args)
                    from-sym 0 (list 'string-length from-sym))))
      (cons 'string-copy-range! args)))

