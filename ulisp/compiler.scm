(define (desugar-vector->list args)
  (cond
    ((null? (cdr args))
     (let ((v-sym (unique-symbol "v_")))
       (list 'let (list (list v-sym (car args)))
             (list 'vector->list-range v-sym 0 (list 'vector-length v-sym)))))
    ((null? (cddr args))
     (let ((v-sym (unique-symbol "v_")))
       (list 'let (list (list v-sym (car args)))
             (list 'vector->list-range v-sym (cadr args) (list 'vector-length v-sym)))))
    (else
     (cons 'vector->list-range args))))

(define (desugar-vector->string args)
  (cond
    ((null? (cdr args))
     (let ((v-sym (unique-symbol "v_")))
       (list 'let (list (list v-sym (car args)))
             (list 'vector->string-range v-sym 0 (list 'vector-length v-sym)))))
    ((null? (cddr args))
     (let ((v-sym (unique-symbol "v_")))
       (list 'let (list (list v-sym (car args)))
             (list 'vector->string-range v-sym (cadr args) (list 'vector-length v-sym)))))
    (else
     (cons 'vector->string-range args))))

(define (desugar-make-list args)
  (if (null? (cdr args))
      (list 'make-list-fill (car args) #f)
      (list 'make-list-fill (car args) (cadr args))))

(define (desugar-gcd args)
  (cond
    ((null? args) 0)
    ((null? (cdr args)) (list '%math-abs (car args)))
    ((null? (cddr args)) (list 'gcd-2 (car args) (cadr args)))
    (else
     (let loop ((curr (list 'gcd-2 (car args) (cadr args)))
                (rest (cddr args)))
       (if (null? rest)
           curr
           (loop (list 'gcd-2 curr (car rest)) (cdr rest)))))))

(define (desugar-lcm args)
  (cond
    ((null? args) 1)
    ((null? (cdr args)) (list '%math-abs (car args)))
    ((null? (cddr args)) (list 'lcm-2 (car args) (cadr args)))
    (else
     (let loop ((curr (list 'lcm-2 (car args) (cadr args)))
                (rest (cddr args)))
       (if (null? rest)
           curr
           (loop (list 'lcm-2 curr (car rest)) (cdr rest)))))))

(define (desugar-max args)
  (cond
    ((null? args) (error "max [R7RS §6.2.6]: requires at least one argument"))
    ((null? (cdr args)) (car args))
    ((null? (cddr args)) (list 'max-2 (car args) (cadr args)))
    (else
     (let loop ((curr (list 'max-2 (car args) (cadr args)))
                (rest (cddr args)))
       (if (null? rest)
           curr
           (loop (list 'max-2 curr (car rest)) (cdr rest)))))))

(define (desugar-min args)
  (cond
    ((null? args) (error "min [R7RS §6.2.6]: requires at least one argument"))
    ((null? (cdr args)) (car args))
    ((null? (cddr args)) (list 'min-2 (car args) (cadr args)))
    (else
     (let loop ((curr (list 'min-2 (car args) (cadr args)))
                (rest (cddr args)))
       (if (null? rest)
           curr
           (loop (list 'min-2 curr (car rest)) (cdr rest)))))))

(define (desugar-format args)
  (if (null? args)
      (error "format [SRFI 28]: too few arguments (requires format-string)")
      (list '%format (car args) (cons 'list (cdr args)))))

(define (desugar-math-binop-fold op a b c rest)
  (let loop ((acc (list op a b)) (xs (cons c rest)))
    (if (null? xs)
        acc
        (loop (list op acc (car xs)) (cdr xs)))))

(define (desugar-make-string-fill k ch)
  (let ((n-sym (unique-symbol "ms_n_"))
        (c-sym (unique-symbol "ms_c_"))
        (s-sym (unique-symbol "ms_s_"))
        (i-sym (unique-symbol "ms_i_"))
        (loop-sym (unique-symbol "%ms_loop_")))
    (list 'let (list (list n-sym k) (list c-sym ch))
          (list 'let (list (list s-sym (list 'make-string n-sym)))
                (list 'letrec
                      (list (list loop-sym
                                  (list 'lambda (list i-sym)
                                        (list 'if (list '< i-sym n-sym)
                                              (list 'begin
                                                    (list 'string-set! s-sym i-sym c-sym)
                                                    (list loop-sym (list '+ i-sym 1)))
                                              s-sym))))
                      (list loop-sym 0))))))

;;; -----------------------------------------------------------------------
;;; Pass 026 Picopass Rule Definitions (DSN-33-01 T4.1)
;;; -----------------------------------------------------------------------

(define-picopass rule-desugar-list
  (Expr
    ((list . ,args) (desugar-list args))))

(define-picopass rule-desugar-vector
  (Expr
    ((vector . ,args) (desugar-vector args))
    ((vector-append . ,args) (desugar-vector-append args))
    ((make-vector . ,args) (desugar-make-vector args))))

(define-picopass rule-desugar-bytevector
  (Expr
    ((bytevector . ,args) (desugar-bytevector args))
    ((bytevector-append . ,args) (desugar-bytevector-append args))
    ((make-bytevector . ,args) (desugar-make-bytevector args))))

(define-picopass rule-desugar-string-ops
  (Expr
    ((make-string ,k ,ch) (desugar-make-string-fill k ch))
    ((string . ,args) (desugar-string args))
    ((string-append . ,args) (desugar-string-append args))
    ((string-copy . ,args) (desugar-string-copy args))
    ((string-copy! . ,args) (desugar-string-copy! args))
    ((string-fill! . ,args) (desugar-string-fill! args))
    ((string->utf8 . ,args) (desugar-string->utf8 args))
    ((utf8->string . ,args) (desugar-utf8->string args))
    ((string->list . ,args) (desugar-string->list args))
    ((string->vector . ,args) (desugar-string->vector args))))

(define-picopass rule-desugar-vector-ops
  (Expr
    ((vector-copy . ,args) (desugar-vector-copy args))
    ((vector-copy! . ,args) (desugar-vector-copy! args))
    ((vector-fill! . ,args) (desugar-vector-fill! args))
    ((vector->list . ,args) (desugar-vector->list args))
    ((vector->string . ,args) (desugar-vector->string args))
    ((make-list . ,args) (desugar-make-list args))))

(define-picopass rule-desugar-bytevector-ops
  (Expr
    ((bytevector-copy . ,args) (desugar-bytevector-copy args))
    ((bytevector-copy! . ,args) (desugar-bytevector-copy! args))))

(define-picopass rule-desugar-math-variadic
  (Expr
    ((+) 0)
    ((+ ,a) a)
    ((+ ,a ,b ,c . ,rest) (desugar-math-binop-fold '+ a b c rest))
    ((- ,a ,b ,c . ,rest) (desugar-math-binop-fold '- a b c rest))
    ((*) 1)
    ((* ,a) a)
    ((* ,a ,b ,c . ,rest) (desugar-math-binop-fold '* a b c rest))
    ((/ ,a) (list '/ 1 a))
    ((/ ,a ,b ,c . ,rest) (desugar-math-binop-fold '/ a b c rest))
    ((bitwise-and) -1)
    ((bitwise-and ,a) a)
    ((bitwise-and ,a ,b ,c . ,rest) (desugar-math-binop-fold 'bitwise-and a b c rest))
    ((bitwise-ior) 0)
    ((bitwise-ior ,a) a)
    ((bitwise-ior ,a ,b ,c . ,rest) (desugar-math-binop-fold 'bitwise-ior a b c rest))
    ((bitwise-xor) 0)
    ((bitwise-xor ,a) a)
    ((bitwise-xor ,a ,b ,c . ,rest) (desugar-math-binop-fold 'bitwise-xor a b c rest))
    ((bitwise-eqv) -1)
    ((bitwise-eqv ,a) a)
    ((bitwise-eqv ,a ,b ,c . ,rest) (desugar-math-binop-fold 'bitwise-eqv a b c rest))
    ((gcd . ,args) (desugar-gcd args))
    ((lcm . ,args) (desugar-lcm args))
    ((max . ,args) (desugar-max args))
    ((min . ,args) (desugar-min args))))

(define-picopass rule-desugar-format
  (Expr
    ((format . ,args) (desugar-format args))))

(define-picopass rule-desugar-cxr
  (Expr
    ((caar ,x) (list 'car (list 'car x)))
    ((cadr ,x) (list 'car (list 'cdr x)))
    ((cdar ,x) (list 'cdr (list 'car x)))
    ((cddr ,x) (list 'cdr (list 'cdr x)))
    ((caddr ,x) (list 'car (list 'cdr (list 'cdr x))))
    ((cdddr ,x) (list 'cdr (list 'cdr (list 'cdr x))))
    ((cadddr ,x) (list 'car (list 'cdr (list 'cdr (list 'cdr x)))))))

;;; -----------------------------------------------------------------------
;;; Pass 026 Quasiquote Lowering
;;; -----------------------------------------------------------------------

(define (desugar-quasiquote-datum datum depth)
  (cond
    ((pair? datum)
     (let ((head (car datum)))
       (cond
         ((eq? head 'quasiquote)
          (list 'list ''quasiquote (desugar-quasiquote-datum (cadr datum) (+ depth 1))))
         ((eq? head 'unquote)
          (if (= depth 0)
              (cadr datum)
              (list 'list ''unquote (desugar-quasiquote-datum (cadr datum) (- depth 1)))))
         ((and (pair? head) (eq? (car head) 'unquote-splicing))
          (if (= depth 0)
              (list 'append (cadr head) (desugar-quasiquote-datum (cdr datum) depth))
              (list 'cons
                    (list 'list ''unquote-splicing (desugar-quasiquote-datum (cadr head) (- depth 1)))
                    (desugar-quasiquote-datum (cdr datum) depth))))
         (else
          (list 'cons
                (desugar-quasiquote-datum head depth)
                (desugar-quasiquote-datum (cdr datum) depth))))))
    ((vector? datum)
     (list 'list->vector (desugar-quasiquote-datum (vector->list datum) depth)))
    (else
     (list 'quote datum))))

(define (desugar-quasiquote datum)
  (desugar-quasiquote-datum datum 0))

(define-picopass rule-desugar-quasiquote
  (Expr
    ((quasiquote ,datum) (desugar-quasiquote datum))))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass Definition: Desugar Constructors (fuse-rules)
;;; -----------------------------------------------------------------------
(define-pass desugar-constructors : L_src (ir) -> L_src ()
  (fuse-rules
    rule-desugar-list
    rule-desugar-vector
    rule-desugar-bytevector
    rule-desugar-string-ops
    rule-desugar-vector-ops
    rule-desugar-bytevector-ops
    rule-desugar-math-variadic
    rule-desugar-format
    rule-desugar-cxr
    rule-desugar-quasiquote))
;;; =======================================================================
;;; ULisp Compiler Pass 027: Conditionals Desugaring Pass
;;; Conforms to DSN-33 Architecture Specification & Nanopass Standard
;;; Desugars conditional branching constructs (cond, case, and, or, chain comparisons, cond-expand)
;;; Refactored to define-picopass + fuse-rules per Issue #762 (DSN-33-01 T4.1)
;;; =======================================================================

(define (desugar-cond clauses)
  (if (or (null? clauses) (not (pair? clauses)))
      #f
      (let ((c (car clauses)))
        (cond
          ((not (pair? c))
           (desugar-cond (cdr clauses)))
          ((eq? (car c) 'else)
           (cons 'begin (cdr c)))
          ;; SRFI 61: (<generator> <guard> => <receiver>)
          ((and (pair? (cdr c)) (pair? (cddr c)) (eq? (caddr c) '=>) (pair? (cdddr c)))
           (let ((gen (car c))
                 (guard (cadr c))
                 (receiver (cadddr c))
                 (vals-sym (unique-symbol "cond_vals_")))
             (list 'call-with-values (list 'lambda '() gen)
                   (list 'case-lambda
                         (list vals-sym
                               (list 'if (cons 'apply (cons guard (list vals-sym)))
                                     (cons 'apply (cons receiver (list vals-sym)))
                                     (desugar-cond (cdr clauses))))))))
          ((and (pair? (cdr c)) (eq? (cadr c) '=>))
           (let ((tmp (unique-symbol "cond_tmp_")))
             (list 'let (list (list tmp (car c)))
                   (list 'if tmp
                         (list (caddr c) tmp)
                         (desugar-cond (cdr clauses))))))
          (else
           (list 'if (car c)
                 (cons 'begin (cdr c))
                 (desugar-cond (cdr clauses))))))))

(define (desugar-case-test k-var datum-list)
  (cond
    ((null? datum-list) #f)
    ((not (pair? datum-list))
     (list 'eqv? k-var (list 'quote datum-list)))
    ((null? (cdr datum-list))
     (list 'eqv? k-var (list 'quote (car datum-list))))
    (else
     ;; Emit direct nested (if (eqv? ...) #t ...) instead of (or ...) so case-tests
     ;; do not generate per-arm let/or_tmp wrappers or temporary stack spills.
     (let loop ((ds datum-list))
       (if (null? (cdr ds))
           (list 'eqv? k-var (list 'quote (car ds)))
           (list 'if (list 'eqv? k-var (list 'quote (car ds)))
                 #t
                 (loop (cdr ds))))))))

(define (desugar-case key clauses)
  (let ((k-var (unique-symbol "case_key_")))
    (list 'let (list (list k-var key))
          (let loop ((cls clauses))
            (if (or (null? cls) (not (pair? cls)))
                #f
                (let ((c (car cls)))
                  (if (not (pair? c))
                      (loop (cdr cls))
                      (if (eq? (car c) 'else)
                          (if (and (pair? (cdr c)) (eq? (cadr c) '=>))
                              (list (caddr c) k-var)
                              (cons 'begin (cdr c)))
                          (if (and (pair? (cdr c)) (eq? (cadr c) '=>))
                              (list 'if (desugar-case-test k-var (car c))
                                    (list (caddr c) k-var)
                                    (loop (cdr cls)))
                              (list 'if (desugar-case-test k-var (car c))
                                    (cons 'begin (cdr c))
                                    (loop (cdr cls))))))))))))

(define (desugar-and args)
  (cond
    ((null? args) #t)
    ((not (pair? args)) args)
    ((null? (cdr args)) (car args))
    (else
     (list 'if (car args) (desugar-and (cdr args)) #f))))

(define (desugar-or args)
  (cond
    ((null? args) #f)
    ((not (pair? args)) args)
    ((null? (cdr args)) (car args))
    (else
     (let ((tmp (unique-symbol "or_tmp_")))
       (list 'let (list (list tmp (car args)))
             (list 'if tmp tmp (desugar-or (cdr args))))))))

(define (desugar-chain-cmp op args)
  (cond
    ((null? args) #t)
    ((not (pair? args)) #t)
    ((null? (cdr args)) #t)
    ((null? (cddr args))
     (cons op args))
    (else
     (let* ((vars (map (lambda (a) (unique-symbol "cmp_")) args))
            (bindings (let b-loop ((vs vars) (as args))
                        (if (or (null? vs) (not (pair? vs)))
                            '()
                            (cons (list (car vs) (car as))
                                  (b-loop (cdr vs) (cdr as))))))
            (pairs (let loop ((vs vars))
                     (if (or (null? (cdr vs)) (not (pair? (cdr vs))))
                         '()
                         (cons (list op (car vs) (cadr vs))
                               (loop (cdr vs)))))))
        (list 'let bindings
              (cons 'and pairs))))))

(define (desugar-cond-expand clauses)
  (let ((matched (expand-cond-expand clauses)))
    (cond
      ((null? matched) #f)
      ((null? (cdr matched)) (car matched))
      (else (cons 'begin matched)))))

;;; -----------------------------------------------------------------------
;;; Pass 027 Picopass Rule Definitions (DSN-33-01 T4.1)
;;; -----------------------------------------------------------------------

(define-picopass rule-desugar-cond-expand
  (Expr
    ((cond-expand ,clauses ...) (desugar-cond-expand clauses))
    ((cond-expand . ,clauses) (desugar-cond-expand clauses))))

(define-picopass rule-desugar-cond
  (Expr
    ((cond ,clauses ...) (desugar-cond clauses))
    ((cond . ,clauses) (desugar-cond clauses))))

(define-picopass rule-desugar-case
  (Expr
    ((case ,key ,clauses ...) (desugar-case key clauses))
    ((case ,key . ,clauses) (desugar-case key clauses))))

(define-picopass rule-desugar-and
  (Expr
    ((and ,args ...) (desugar-and args))
    ((and . ,args) (desugar-and args))))

(define-picopass rule-desugar-or
  (Expr
    ((or ,args ...) (desugar-or args))
    ((or . ,args) (desugar-or args))))

(define-picopass rule-desugar-chain-cmp
  (Expr
    ((char<? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char<? (cons a1 (cons a2 (cons a3 rest)))))
    ((char<=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char<=? (cons a1 (cons a2 (cons a3 rest)))))
    ((char>? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char>? (cons a1 (cons a2 (cons a3 rest)))))
    ((char>=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char>=? (cons a1 (cons a2 (cons a3 rest)))))
    ((char=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char=? (cons a1 (cons a2 (cons a3 rest)))))
    ((char-ci<? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char-ci<? (cons a1 (cons a2 (cons a3 rest)))))
    ((char-ci<=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char-ci<=? (cons a1 (cons a2 (cons a3 rest)))))
    ((char-ci>? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char-ci>? (cons a1 (cons a2 (cons a3 rest)))))
    ((char-ci>=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char-ci>=? (cons a1 (cons a2 (cons a3 rest)))))
    ((char-ci=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'char-ci=? (cons a1 (cons a2 (cons a3 rest)))))
    ((string<? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string<? (cons a1 (cons a2 (cons a3 rest)))))
    ((string<=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string<=? (cons a1 (cons a2 (cons a3 rest)))))
    ((string>? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string>? (cons a1 (cons a2 (cons a3 rest)))))
    ((string>=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string>=? (cons a1 (cons a2 (cons a3 rest)))))
    ((string=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string=? (cons a1 (cons a2 (cons a3 rest)))))
    ((string-ci<? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string-ci<? (cons a1 (cons a2 (cons a3 rest)))))
    ((string-ci<=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string-ci<=? (cons a1 (cons a2 (cons a3 rest)))))
    ((string-ci>? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string-ci>? (cons a1 (cons a2 (cons a3 rest)))))
    ((string-ci>=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string-ci>=? (cons a1 (cons a2 (cons a3 rest)))))
    ((string-ci=? ,a1 ,a2 ,a3 . ,rest) (desugar-chain-cmp 'string-ci=? (cons a1 (cons a2 (cons a3 rest)))))))

(define (desugar-when test body)
  (if (null? body)
      (list 'if test #f #f)
      (list 'if test (cons 'begin body) #f)))

(define (desugar-unless test body)
  (if (null? body)
      (list 'if test #f #f)
      (list 'if test #f (cons 'begin body))))

(define-picopass rule-desugar-when-unless
  (Expr
    ((when ,test . ,body) (desugar-when test body))
    ((unless ,test . ,body) (desugar-unless test body))))

;;; -----------------------------------------------------------------------
;;; SRFI 2: AND-LET* (Conditional binding short-circuit syntax)
;;; -----------------------------------------------------------------------

(define (desugar-and-let* claws bodies)
  (cond
    ((null? claws)
     (make-body-expr (if (null? bodies) (list #t) bodies)))
    ((not (pair? claws))
     (error "Malformed and-let* claw list:" claws))
    (else
     (let ((claw (car claws))
           (rest (cdr claws)))
       (cond
         ;; 1. (<variable> <expression>)
         ((and (pair? claw) (pair? (cdr claw)) (null? (cddr claw)) (symbol? (car claw)))
          (let ((var (car claw))
                (expr (cadr claw)))
            (list 'let (list (list var expr))
                  (list 'if var
                        (desugar-and-let* rest bodies)
                        #f))))
         ;; 2. (<expression>)
         ((and (pair? claw) (null? (cdr claw)))
          (let ((expr (car claw)))
            (list 'if expr
                  (desugar-and-let* rest bodies)
                  #f)))
         ;; 3. <variable> (symbol)
         ((symbol? claw)
          (list 'if claw
                (desugar-and-let* rest bodies)
                #f))
         (else
          (error "Malformed and-let* claw:" claw)))))))

(define-picopass rule-desugar-and-let*
  (Expr
    ((and-let* ,claws . ,bodies) (guard (list? claws))
     (desugar-and-let* claws bodies))))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass Definition: Desugar Conditionals (fuse-rules)
;;; -----------------------------------------------------------------------
(define-pass desugar-conditionals : L_src (ir) -> L_src ()
  (fuse-rules
    rule-desugar-cond-expand
    rule-desugar-cond
    rule-desugar-case
    rule-desugar-and
    rule-desugar-or
    rule-desugar-chain-cmp
    rule-desugar-when-unless
    rule-desugar-and-let*))
;;; =======================================================================
;;; ULisp Compiler Pass 028: Local Bindings Desugaring Pass
;;; Conforms to DSN-33 Architecture Specification & Nanopass Standard
;;; Desugars local binding constructs (let*, named let, letrec*, case-lambda, do, internal define)
;;; and normalizes 0/multi-body expressions
;;; Refactored to define-picopass + fuse-rules per Issue #762 (DSN-33-01 T4.1)
;;; =======================================================================

(define (make-body-expr bodies)
  (cond
    ((null? bodies) (list 'begin))
    ((null? (cdr bodies)) (car bodies))
    (else (cons 'begin bodies))))

(define (desugar-let* bindings bodies)
  (if (null? bindings)
      (make-body-expr bodies)
      (list 'let (list (car bindings))
            (desugar-let* (cdr bindings) bodies))))

(define (desugar-letrec* bindings bodies)
  (list 'letrec bindings (make-body-expr bodies)))

(define (desugar-named-let expr)
  (let* ((name (cadr expr))
         (bindings (caddr expr))
         (bodies (cdddr expr))
         (params (map car* bindings))
         (inits (map cadr bindings))
         (name-str (if (symbol? name) (symbol->string name) ""))
         (is-internal? (and (> (string-length name-str) 0)
                            (char=? (string-ref name-str 0) #\%)))
         (clean-bodies (if is-internal?
                           (cons '(declare (no-safepoints)) bodies)
                           bodies)))
    (list 'letrec
          (list (list name (cons 'lambda (cons params clean-bodies))))
          (cons name inits))))

(define (desugar-do bindings exit-clause commands)
  (let* ((loop-sym (unique-symbol "do_loop_"))
         (init-bindings
          (map (lambda (b) (list (car b) (cadr b))) bindings))
         (test (car exit-clause))
         (res (cdr exit-clause))
         (then-expr
          (if (null? res)
              #f
              (make-body-expr res)))
         (step-exprs
          (map (lambda (b)
                 (if (pair? (cddr b))
                     (caddr b)
                     (car b)))
               bindings))
         (loop-call (cons loop-sym step-exprs))
         (else-expr
          (make-body-expr (append commands (list loop-call)))))
    (list 'let loop-sym init-bindings
          (list 'if test
                then-expr
                else-expr))))

(define (normalize-define-spec spec bodies)
  (cond
    ((pair? spec)
     (let ((actual-bodies (if (null? bodies) (list #f) bodies)))
       (if (pair? (car spec))
           ;; カリー化短縮構文: (define ((f x) y) ...) -> (define (f x) (lambda (y) ...))
           (normalize-define-spec (car spec) (list (cons 'lambda (cons (cdr spec) actual-bodies))))
           ;; 通常短縮構文: (define (f x ...) ...) -> (define f (lambda (x ...) ...))
           (cons (car spec) (cons 'lambda (cons (cdr spec) actual-bodies))))))
    ((symbol? spec)
     ;; 変数定義: (define x val)
     (cons spec (if (pair? bodies) (car bodies) #f)))
    (else
     (error "Malformed define specification in internal define:" spec))))

(define (desugar-internal-define spec rest-def rest)
  (let* ((norm (normalize-define-spec spec rest-def))
         (name (car norm))
         (val (cdr norm))
         (is-proc? (and (pair? val) (eq? (car val) 'lambda))))
    (if is-proc?
        ;; 連続する手続き定義を単一の letrec 節へ集約（相互再帰対応）
        (let loop ((cur-rest rest)
                   (proc-bindings (list (list name val))))
          (if (and (pair? cur-rest)
                   (pair? (car cur-rest))
                   (eq? (caar cur-rest) 'define)
                   (pair? (cdar cur-rest)))
              (let* ((next-def (car cur-rest))
                     (next-norm (normalize-define-spec (cadr next-def) (cddr next-def)))
                     (next-name (car next-norm))
                     (next-val (cdr next-norm)))
                (if (and (pair? next-val) (eq? (car next-val) 'lambda))
                    (loop (cdr cur-rest) (cons (list next-name next-val) proc-bindings))
                    (list 'letrec (reverse proc-bindings) (if (null? cur-rest) #f (make-body-expr cur-rest)))))
              (list 'letrec (reverse proc-bindings) (if (null? cur-rest) #f (make-body-expr cur-rest)))))
        ;; 通常の変数定義: let で包み、後続の定義・式を body に配置
        (list 'let (list (list name val)) (if (null? rest) #f (make-body-expr rest))))))

;;; -----------------------------------------------------------------------
;;; R7RS case-lambda Desugaring (Issue #609)
;;; -----------------------------------------------------------------------

(define (analyze-case-lambda-formals formals)
  (cond
    ((null? formals)
     (list 'exact 0 '() #f))
    ((symbol? formals)
     (list 'rest 0 '() formals))
    ((pair? formals)
     (let loop ((cur formals) (fixed '()))
       (cond
         ((null? cur)
          (list 'exact (length fixed) (reverse fixed) #f))
         ((symbol? cur)
          (list 'rest (length fixed) (reverse fixed) cur))
         ((pair? cur)
          (loop (cdr cur) (cons (car cur) fixed)))
         (else
          (error "Malformed formals in case-lambda:" formals)))))
    (else
     (error "Malformed formals in case-lambda:" formals))))

(define (make-cl-params count)
  (let loop ((i 0) (acc '()))
    (if (>= i count)
        (reverse acc)
        (loop (+ i 1)
              (cons (string->symbol (string-append "__cl_p" (number->string i)))
                    acc)))))

(define (symbols->cons-expr syms)
  (if (null? syms)
      ''()
      (list 'cons (car syms) (symbols->cons-expr (cdr syms)))))

(define (build-cl-rest-expr n-sym k num-params params)
  (let ((sub-params (let loop ((ps params) (i 0))
                      (cond
                        ((null? ps) '())
                        ((< i k) (loop (cdr ps) (+ i 1)))
                        (else ps)))))
    (let loop ((i 0))
      (let ((actual-cnt (+ k i)))
        (if (>= actual-cnt num-params)
            (symbols->cons-expr sub-params)
            (let ((slice (let take-loop ((ps sub-params) (cnt 0) (acc '()))
                           (if (or (null? ps) (>= cnt i))
                               (reverse acc)
                               (take-loop (cdr ps) (+ cnt 1) (cons (car ps) acc))))))
              (list 'if (list '= n-sym actual-cnt)
                    (symbols->cons-expr slice)
                    (loop (+ i 1)))))))))

(define (desugar-case-lambda-clause clause n-sym num-params params)
  (if (or (not (pair? clause)) (null? (cdr clause)))
      (error "Malformed case-lambda clause:" clause)
      (let* ((formals (car clause))
             (bodies (cdr clause))
             (info (analyze-case-lambda-formals formals))
             (type (car info))
             (k (cadr info))
             (fixed-vars (caddr info))
             (rest-var (cadddr info))
             (test-expr
              (if (eq? type 'exact)
                  (list '= n-sym k)
                  (if (= k 0)
                      #t
                      (list '>= n-sym k))))
             (fixed-bindings
              (let loop ((fvs fixed-vars) (ps params) (acc '()))
                (if (null? fvs)
                    (reverse acc)
                    (loop (cdr fvs) (cdr ps) (cons (list (car fvs) (car ps)) acc)))))
             (all-bindings
              (if (eq? type 'rest)
                  (append fixed-bindings
                          (list (list rest-var (build-cl-rest-expr n-sym k num-params params))))
                  fixed-bindings))
             (clause-body
              (if (null? all-bindings)
                  (make-body-expr bodies)
                  (list 'let all-bindings (make-body-expr bodies)))))
        (list test-expr clause-body))))

;; NOTE: Fixed >6-arg case-lambda without rest uses exact max-k so caller/callee
;; stack param counts agree cleanly (keeping 8 for <=6/rest per Issue #609).
;; Compiler self-hosting sources must stay <= 6 fixed parameters on mixed-arity
;; case-lambda for bin/ulisp-boot SysV ABI register-only compatibility.
(define (desugar-case-lambda clauses)
  (if (null? clauses)
      (let ((n-sym (unique-symbol "cl_n_")))
        (list 'lambda '()
              (list 'let (list (list n-sym '(%num-args)))
                    (list 'error "case-lambda: no matching clause for arity" n-sym))))
      (let* ((clause-infos
              (map (lambda (cl) (analyze-case-lambda-formals (car cl))) clauses))
             (has-rest? (let loop ((infos clause-infos))
                          (and (pair? infos)
                               (or (eq? (caar infos) 'rest)
                                   (loop (cdr infos))))))
             (max-k (let loop ((infos clause-infos) (m 0))
                      (if (null? infos)
                          m
                          (let ((k (cadar infos)))
                            (loop (cdr infos) (if (> k m) k m))))))
             (num-params (let ((target (if has-rest? (+ max-k 4) max-k)))
                           (if (or has-rest? (<= target 6))
                               (if (> target 8) target 8)
                               target)))
             (params (make-cl-params num-params))
             (n-sym (unique-symbol "cl_n_"))
             (dispatch-expr
              (let loop ((cls clauses))
                (if (null? cls)
                    (list 'error "case-lambda: no matching clause for arity" n-sym)
                    (let* ((cl (car cls))
                           (desugared-cl (desugar-case-lambda-clause cl n-sym num-params params))
                           (test (car desugared-cl))
                           (body (cadr desugared-cl)))
                      (if (eq? test #t)
                          body
                          (list 'if test
                                body
                                (loop (cdr cls))))))))
             (sanitized-bindings
              (let loop ((ps params) (i 0) (acc '()))
                (if (null? ps)
                    (reverse acc)
                    (loop (cdr ps) (+ i 1)
                          (cons (list (car ps) (list 'if (list '< i n-sym) (car ps) #f))
                                acc))))))
        (list 'lambda params
              (list 'let (list (list n-sym '(%num-args)))
                    (list 'let sanitized-bindings
                          dispatch-expr))))))

;;; -----------------------------------------------------------------------
;;; Pass 028 Picopass Rule Definitions (DSN-33-01 T4.1)
;;; -----------------------------------------------------------------------

(define-picopass rule-desugar-case-lambda
  (Expr
    ((case-lambda . ,clauses) (desugar-case-lambda clauses))))

(define-picopass rule-desugar-let*
  (Expr
    ((let* ,bindings . ,bodies) (desugar-let* bindings bodies))))

(define-picopass rule-desugar-letrec*
  (Expr
    ((letrec* ,bindings . ,bodies) (guard (list? bindings))
     (desugar-letrec* bindings bodies))))

(define-picopass rule-desugar-named-let
  (Expr
    ((let ,name ,bindings . ,bodies) (guard (symbol? name))
     (desugar-named-let (cons 'let (cons name (cons bindings bodies)))))))

(define-picopass rule-desugar-multi-body
  (Expr
    ((let ,bindings) (guard (list? bindings))
     (list 'let bindings '(begin)))
    ((let ,bindings ,b1 ,b2 . ,rest) (guard (list? bindings))
     (list 'let bindings (cons 'begin (cons b1 (cons b2 rest)))))
    ((letrec ,bindings) (guard (list? bindings))
     (list 'letrec bindings '(begin)))
    ((letrec ,bindings ,b1 ,b2 . ,rest) (guard (list? bindings))
     (list 'letrec bindings (cons 'begin (cons b1 (cons b2 rest)))))
    ((lambda ,params)
     (list 'lambda params '(begin)))
    ((lambda ,params ,b1 ,b2 . ,rest)
     (list 'lambda params (cons 'begin (cons b1 (cons b2 rest)))))))

(define-picopass rule-desugar-do
  (Expr
    ((do ,bindings ,exit-clause . ,commands)
     (desugar-do bindings exit-clause commands))))

(define-picopass rule-desugar-internal-define
  (Expr
    ((begin (begin . ,inner) . ,rest)
     (cons 'begin (append inner rest)))
    ((begin (define ,spec . ,rest-def) . ,rest)
     (desugar-internal-define spec rest-def rest))
    ((define ,spec . ,rest-def)
     (desugar-internal-define spec rest-def '()))))

;;; -----------------------------------------------------------------------
;;; SRFI 31: REC (Recursive evaluation special form)
;;; -----------------------------------------------------------------------

(define (desugar-rec spec bodies)
  (cond
    ;; (rec (<var> . <formals>) . <body>)
    ((pair? spec)
     (let* ((var (car spec))
            (formals (cdr spec))
            (self-sym (unique-symbol "rec_self_")))
       (if (list? formals)
           (let ((inner-args (map (lambda (p) (unique-symbol "rec_arg_")) formals)))
             (list 'let
                   (list (list self-sym
                               (list 'lambda (cons self-sym formals)
                                     (list 'let (list (list var (list 'lambda inner-args
                                                                      (cons self-sym (cons self-sym inner-args)))))
                                           (make-body-expr bodies)))))
                   (list 'lambda formals
                         (cons self-sym (cons self-sym formals)))))
           (let ((rest-arg (unique-symbol "rec_rest_")))
             (list 'let
                   (list (list self-sym
                               (list 'case-lambda
                                     (list (cons self-sym formals)
                                           (list 'let (list (list var (list 'case-lambda
                                                                            (list rest-arg
                                                                                  (cons 'apply (cons self-sym (cons self-sym (list rest-arg))))))))
                                                 (make-body-expr bodies))))))
                   (list 'case-lambda
                         (list formals
                               (list 'let (list (list rest-arg formals))
                                     (cons 'apply (cons self-sym (cons self-sym (list rest-arg))))))))))))
    ;; (rec <var> (lambda <formals> . <body>)) -> redirect to procedure rec
    ((and (symbol? spec) (pair? bodies) (pair? (car bodies)) (eq? (caar bodies) 'lambda))
     (let ((lambda-form (car bodies)))
       (desugar-rec (cons spec (cadr lambda-form)) (cddr lambda-form))))
    ;; (rec <var> <expr>)
    ((symbol? spec)
     (let ((expr (if (pair? bodies) (car bodies) #f)))
       (list 'letrec
             (list (list spec expr))
             spec)))
    (else
     (error "Malformed rec form:" spec))))

(define-picopass rule-desugar-rec
  (Expr
    ((rec ,spec . ,bodies) (desugar-rec spec bodies))))

;;; -----------------------------------------------------------------------
;;; SRFI 26: CUT / CUTE (Parameter specialization without currying)
;;; -----------------------------------------------------------------------

(define (%cut-slot? x) (and (symbol? x) (eq? x '<>)))
(define (%cut-rest-slot? x) (and (symbol? x) (eq? x '<...>)))

(define (desugar-cut args)
  (if (null? args)
      (error "cut: expected at least one argument (procedure or slot)")
      (let loop ((rest args)
                 (params '())
                 (call-args '())
                 (rest-var #f))
        (if (null? rest)
            (if rest-var
                (let ((formals (if (null? params)
                                   rest-var
                                   (let build-formals ((ps params))
                                     (if (null? (cdr ps))
                                         (cons (car ps) rest-var)
                                         (cons (car ps) (build-formals (cdr ps))))))))
                  (list 'case-lambda
                        (list formals
                              (cons 'apply (cons (car call-args) (append (cdr call-args) (list rest-var)))))))
                (list 'lambda params call-args))
            (let ((a (car rest)))
              (cond
                ((%cut-slot? a)
                 (let ((v (unique-symbol "cut_arg_")))
                   (loop (cdr rest) (append params (list v)) (append call-args (list v)) rest-var)))
                ((%cut-rest-slot? a)
                 (if (not (null? (cdr rest)))
                     (error "cut: <...> must be the last argument in cut/cute:" args)
                     (let ((rv (unique-symbol "cut_rest_")))
                       (loop (cdr rest) params call-args rv))))
                (else
                 (loop (cdr rest) params (append call-args (list a)) rest-var))))))))

(define (desugar-cute args)
  (if (null? args)
      (error "cute: expected at least one argument (procedure or slot)")
      (let loop ((rest args)
                 (let-bindings '())
                 (cut-args '()))
        (if (null? rest)
            (let ((cut-expr (desugar-cut (reverse cut-args))))
              (if (null? let-bindings)
                  cut-expr
                  (list 'let (reverse let-bindings) cut-expr)))
            (let ((a (car rest)))
              (cond
                ((or (%cut-slot? a) (%cut-rest-slot? a))
                 (loop (cdr rest) let-bindings (cons a cut-args)))
                (else
                 (let ((t (unique-symbol "cute_tmp_")))
                   (loop (cdr rest)
                         (cons (list t a) let-bindings)
                         (cons t cut-args))))))))))

(define-picopass rule-desugar-cut
  (Expr
    ((cut . ,args) (desugar-cut args))))

(define-picopass rule-desugar-cute
  (Expr
    ((cute . ,args) (desugar-cute args))))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass Definition: Desugar Bindings (fuse-rules)
;;; -----------------------------------------------------------------------
(define-pass desugar-bindings : L_src (ir) -> L_src ()
  (fuse-rules
    rule-desugar-case-lambda
    rule-desugar-let*
    rule-desugar-letrec*
    rule-desugar-named-let
    rule-desugar-multi-body
    rule-desugar-do
    rule-desugar-internal-define
    rule-desugar-rec
    rule-desugar-cut
    rule-desugar-cute))
;;; =======================================================================
;;; ULisp Compiler Pass 029: Dynamic Environment & Multiple Values Desugaring Pass
;;; Conforms to DSN-33 Architecture Specification & Nanopass Standard
;;; Desugars let-values, let*-values, define-values, guard, parameterize,
;;; delay, delay-force, make-parameter, values, error, assume, syntax-error
;;; Refactored to define-picopass + fuse-rules per Issue #762 (DSN-33-01 T4.1)
;;; =======================================================================

(define (desugar-guard-clauses var clauses)
  (let loop ((cls clauses))
    (cond
      ((null? cls)
       (list (list 'else (list 'raise var))))
      ((eq? (caar cls) 'else)
       cls)
      (else
       (cons (car cls) (loop (cdr cls)))))))

(define (desugar-guard spec bodies)
  (let ((var (car spec))
        (clauses (cdr spec)))
    (list '%with-handler
          (list 'lambda (list var)
                (cons 'cond (desugar-guard-clauses var clauses)))
          (cons 'lambda (cons '() bodies)))))

(define (desugar-let-values bindings bodies)
  (if (null? bindings)
      (make-body-expr bodies)
      (let ((b (car bindings)))
        (list 'call-with-values
              (list 'lambda '() (cadr b))
              (list 'lambda (car b)
                    (desugar-let-values (cdr bindings) bodies))))))

(define (desugar-let*-values bindings bodies)
  (if (null? bindings)
      (make-body-expr bodies)
      (desugar-let-values (list (car bindings))
                          (list (desugar-let*-values (cdr bindings) bodies)))))

(define (desugar-parameterize bindings bodies)
  (if (null? bindings)
      (make-body-expr bodies)
      (let loop ((rest bindings)
                 (let-bindings '())
                 (save-and-set '())
                 (restore '()))
        (if (null? rest)
            (let* ((before-thunk
                    (list 'lambda '() (cons 'begin (reverse save-and-set))))
                   (after-thunk
                    (list 'lambda '() (cons 'begin (reverse restore))))
                   (exc-sym (unique-symbol "exc_"))
                   (body-expr
                    (list 'guard (list exc-sym (list 'else (cons 'begin (append (reverse restore) (list (list 'raise exc-sym))))))
                          (make-body-expr bodies)))
                   (body-thunk
                    (list 'lambda '() body-expr)))
              (list 'let (reverse let-bindings)
                    (list 'dynamic-wind before-thunk body-thunk after-thunk)))
            (let* ((b (car rest))
                   (param-expr (car b))
                   (val-expr (cadr b))
                   (p-sym (unique-symbol "param_"))
                   (v-sym (unique-symbol "newval_"))
                   (old-sym (unique-symbol "oldcell_")))
              (loop (cdr rest)
                    (cons (list old-sym (list 'cons #f ''()))
                          (cons (list v-sym val-expr)
                                (cons (list p-sym param-expr)
                                      let-bindings)))
                    (cons (list p-sym v-sym)
                          (cons (list 'set-car! old-sym (list p-sym))
                                save-and-set))
                    (cons (list p-sym (list 'car old-sym))
                          restore)))))))

(define (desugar-define-values formals expr rest)
  (if (null? rest)
      (list 'call-with-values
            (list 'lambda '() expr)
            (list 'lambda (if (list? formals) formals (list formals)) #f))
      (list 'let-values
            (list (list formals expr))
            (make-body-expr rest))))

(define (desugar-delay expr)
  (let ((body (if (null? (cddr expr))
                  (cadr expr)
                  (cons 'begin (cdr expr)))))
    (list '%%make-promise ''lazy (list 'lambda '() (list '%%make-promise ''eager body)))))

(define (desugar-delay-force expr)
  (let ((body (if (null? (cddr expr))
                  (cadr expr)
                  (cons 'begin (cdr expr)))))
    (list '%%make-promise ''lazy (list 'lambda '() body))))

(define (desugar-make-parameter args)
  (if (null? (cdr args))
      (list 'make-parameter-1 (car args))
      (list 'make-parameter-2 (car args) (cadr args))))

(define (desugar-values args)
  (cond
    ((null? args) (list '%values))
    ((null? (cdr args)) (car args))
    (else (cons '%values args))))

(define (desugar-error expr)
  (let ((msg (cadr expr))
        (irritants (cddr expr)))
    (list 'raise (cons 'list (cons ''error-object (cons msg irritants))))))

(define (desugar-syntax-error expr)
  (let ((msg (if (and (pair? (cdr expr)) (string? (cadr expr)))
                 (cadr expr)
                 "invalid syntax"))
        (irritants (if (and (pair? (cdr expr)) (string? (cadr expr)))
                       (cddr expr)
                       (cdr expr))))
    (error (string-append "syntax-error [R7RS §4.3.1]: " msg) irritants)))

(define (desugar-assume expr)
  (let ((condition (cadr expr))
        (rest (cddr expr)))
    (let ((tmp (unique-symbol "assume_tmp_")))
      (let* ((msg (if (pair? rest) (car rest) "invalid assumption [SRFI 145]"))
             (objs (if (pair? rest) (cdr rest) '()))
             (err-call (cons 'error (cons msg (cons (list 'quote condition) objs)))))
        (list 'let (list (list tmp condition))
              (list 'if tmp
                    tmp
                    err-call))))))

;;; -----------------------------------------------------------------------
;;; Pass 029 Picopass & Attopass Rule Definitions (DSN-33-01 T4.1)
;;; -----------------------------------------------------------------------

(define-picopass rule-desugar-let-values
  (Expr
    ((let-values ,bindings . ,bodies) (desugar-let-values bindings bodies))
    ((let*-values ,bindings . ,bodies) (desugar-let*-values bindings bodies))))

(define-picopass rule-desugar-define-values
  (Expr
    ((begin (define-values ,formals ,expr) . ,rest)
      (desugar-define-values formals expr rest))
    ((define-values ,formals ,expr)
      (desugar-define-values formals expr '()))))

(define-picopass rule-desugar-guard
  (Expr
    ((guard ,spec . ,bodies) (desugar-guard spec bodies))))

(define-picopass rule-desugar-parameterize
  (Expr
    ((parameterize ,bindings . ,bodies) (desugar-parameterize bindings bodies))))

(define-picopass rule-desugar-delay
  (Expr
    ((delay . ,args) (desugar-delay (cons 'delay args)))
    ((delay-force . ,args) (desugar-delay-force (cons 'delay-force args)))))

(define-picopass rule-desugar-parameter-ops
  (Expr
    ((make-parameter . ,args) (desugar-make-parameter args))))

(define-picopass rule-desugar-values
  (Expr
    ((values . ,args) (desugar-values args))
    ((call-with-values ,producer ,consumer)
      (list '%call-with-values producer consumer))))

(define-picopass rule-desugar-error-assume
  (Expr
    ((error . ,args) (desugar-error (cons 'error args)))
    ((assume . ,args) (desugar-assume (cons 'assume args)))
    ((assert . ,args) (desugar-assume (cons 'assert args)))
    ((syntax-error . ,args) (desugar-syntax-error (cons 'syntax-error args)))
    ((with-exception-handler ,handler ,thunk)
      (list '%with-handler handler thunk))))

;; 未展開の let-syntax / letrec-syntax を拒絶する不変条件 Attopass
(define-attopass atto-no-unexpanded-let-syntax
  (Expr
    ((let-syntax . ,args)
      (error "syntax-error [R7RS §4.3.1]: unexpanded let-syntax encountered in desugar" args))
    ((letrec-syntax . ,args)
      (error "syntax-error [R7RS §4.3.1]: unexpanded let-syntax encountered in desugar" args))))

;;; -----------------------------------------------------------------------
;;; SRFI 8: RECEIVE (Binding to multiple values)
;;; -----------------------------------------------------------------------

(define (desugar-receive formals expr bodies)
  (if (list? formals)
      (list 'call-with-values
            (list 'lambda '() expr)
            (cons 'lambda (cons formals bodies)))
      (list 'call-with-values
            (list 'lambda '() expr)
            (list 'case-lambda (cons formals bodies)))))

(define-picopass rule-desugar-receive
  (Expr
    ((receive ,formals ,expr . ,bodies)
     (desugar-receive formals expr bodies))))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass Definition: Desugar Dynamic (fuse-rules)
;;; -----------------------------------------------------------------------
(define-pass desugar-dynamic : L_src (ir) -> L_src ()
  (fuse-rules
    rule-desugar-let-values
    rule-desugar-define-values
    rule-desugar-guard
    rule-desugar-parameterize
    rule-desugar-delay
    rule-desugar-parameter-ops
    rule-desugar-values
    rule-desugar-error-assume
    rule-desugar-receive
    atto-no-unexpanded-let-syntax))
;;; =======================================================================
;;; ULisp Compiler Pass 030: Core Syntax Desugaring & Normalization Pass
;;; Conforms to DSN-33 Architecture Specification & Nanopass Framework Standard
;;; Implements derived expression lowering per [R7RS §4.2] and [R7RS §7.3].
;;; Migrated to Declarative Pass Fusion (fuse-rules) per Issue #763 (DSN-33-01 T4.2).
;;; Automatically combines all 31 Picopasses/Attopasses from Passes 026-029 into
;;; a single O(1) Head-Tag dispatch traversal with local re-dispatch.
;;; =======================================================================

(define-pass desugar-all : L_src (ir) -> L_core ()
  (Program : Program (ir) -> Program ()
    ((%program (,d ...) ,e)
     (let ((map-def (lambda (def)
                      (if (and (pair? def) (eq? (car def) 'define))
                          (list 'define (cadr def) (Expr (caddr def)))
                          (Expr def)))))
       (list '%program (map map-def d) (Expr e))))
    (,e (Expr e)))
  (Expr : Expr (ir) -> Expr ()
    (fuse-rules
      ;; --- Pass 026: Composite Literals & Constructors ---
      rule-desugar-list
      rule-desugar-vector
      rule-desugar-bytevector
      rule-desugar-string-ops
      rule-desugar-vector-ops
      rule-desugar-bytevector-ops
      rule-desugar-math-variadic
      rule-desugar-format
      rule-desugar-cxr
      rule-desugar-quasiquote

      ;; --- Pass 027: Conditionals & Comparisons ---
      rule-desugar-cond-expand
      rule-desugar-cond
      rule-desugar-case
      rule-desugar-and
      rule-desugar-or
      rule-desugar-chain-cmp
      rule-desugar-when-unless
      rule-desugar-and-let*

      ;; --- Pass 028: Bindings & Internal Definitions ---
      rule-desugar-case-lambda
      rule-desugar-let*
      rule-desugar-letrec*
      rule-desugar-named-let
      rule-desugar-multi-body
      rule-desugar-do
      rule-desugar-internal-define
      rule-desugar-rec
      rule-desugar-cut
      rule-desugar-cute

      ;; --- Pass 029: Dynamic Environment & Values ---
      rule-desugar-let-values
      rule-desugar-define-values
      rule-desugar-guard
      rule-desugar-parameterize
      rule-desugar-delay
      rule-desugar-parameter-ops
      rule-desugar-values
      rule-desugar-error-assume
      rule-desugar-receive
      atto-no-unexpanded-let-syntax)))
;;; =======================================================================
;;; ULisp Compiler Pass 2: Static Scope & Free-Variable Analysis Pass
;;; Conforms to DSN-33 Architecture Specification & Nanopass Framework DSL (Phase 3)
;;; Note: Operates strictly on Canonical Core AST produced by Pass 1 (desugar-all)
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: free-vars-acc
;;; Computes free variables using an accumulator thread across L_core AST.
;;; -----------------------------------------------------------------------
(define-pass free-vars-acc : L_core (ir bound acc) -> * (acc)
  (definitions
    (define (free-vars-list es b cur-acc)
      (if (null? es)
          cur-acc
          (free-vars-list (cdr es) b (free-vars-acc (car es) b cur-acc)))))
  (Expr : Expr (ir bound acc) -> * (acc)
    ((quote ,datum)
     acc)
    (,x (guard (symbol? x))
     (if (or (memq x bound) (memq x acc))
         acc
         (cons x acc)))
    (,c (guard (not (pair? c)))
     acc)
    ((if ,test ,then ,else-expr)
     (free-vars-acc else-expr bound (free-vars-acc then bound (free-vars-acc test bound acc))))
    ((if ,test ,then)
     (free-vars-acc then bound (free-vars-acc test bound acc)))
    ((begin ,es ...)
     (free-vars-list es bound acc))
    ((let ((,x* ,e*) ...) ,body)
     (let* ((b-acc (free-vars-list e* bound acc))
            (new-bound (set-union x* bound)))
       (free-vars-acc body new-bound b-acc)))
    ((letrec ((,x* ,e*) ...) ,body)
     (let* ((new-bound (set-union x* bound))
            (b-acc (free-vars-list e* new-bound acc)))
       (free-vars-acc body new-bound b-acc)))
    ((lambda (,params ...) ,body)
     (free-vars-acc body (set-union params bound) acc))
    ((%make-closure ,tag ,es ...)
     (free-vars-list es bound acc))
    ((%make-closure-env ,tag ,es ...)
     (free-vars-list es bound acc))
    ((%cont-fun ,f-name (,params ...) ,f-body ,in-body)
     (let* ((f-bound (set-union params bound))
            (f-acc (free-vars-acc f-body f-bound acc)))
       (free-vars-acc in-body bound f-acc)))
    ((%cont-call ,target ,es ...)
     (free-vars-list es bound acc))
    ((%with-handler ,h ,body)
     (free-vars-acc body bound (free-vars-acc h bound acc)))
    ((%raw-call/cc ,arg)
     (free-vars-acc arg bound acc))
    ((%call-with-values ,prod ,cons-fn)
     (free-vars-acc cons-fn bound (free-vars-acc prod bound acc)))
    ((%program ,defs ,main)
     (let* ((d-acc (let loop ((ds defs) (cur-acc acc))
                     (if (null? ds) cur-acc
                         (let ((d (car ds)))
                           (loop (cdr ds)
                                 (if (and (pair? d) (eq? (car d) 'define))
                                     (free-vars-acc (caddr d) bound cur-acc)
                                     (free-vars-acc d bound cur-acc))))))))
       (free-vars-acc main bound d-acc)))
    ((%values ,es ...)
     (free-vars-list es bound acc))
    ((,op ,args ...)
     (cond
       ((zero-arg-prim? op)
        acc)
       ((or (unary-prim? op) (or (binop-prim? op) (or (triop-prim? op) (septop-prim? op))))
        (free-vars-list args bound acc))
       (else
        (let ((op-acc (free-vars-acc op bound acc)))
          (free-vars-list args bound op-acc)))))))

(define (free-vars expr bound)
  (reverse (free-vars-acc expr bound '())))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: analyze-escapes
;;; Checks whether `var` escapes (appears in non-operator position) within `expr`.
;;; -----------------------------------------------------------------------
(define-pass analyze-escapes : L_core (ir var) -> * (escapes?)
  (Expr : Expr (ir var) -> * (escapes?)
    ((quote ,datum) #f)
    (,x (guard (symbol? x))
     (eq? x var))
    (,c (guard (not (pair? c)))
     #f)
    ((if ,test ,then ,else-expr)
     (or (Expr test var) (or (Expr then var) (Expr else-expr var))))
    ((if ,test ,then)
     (or (Expr test var) (Expr then var)))
    ((begin ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((let ((,x* ,e*) ...) ,body)
     (or (let loop ((rest e*))
           (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest)))))
         (if (memq var x*) #f (Expr body var))))
    ((letrec ((,x* ,e*) ...) ,body)
     (if (memq var x*)
         #f
         (or (let loop ((rest e*))
               (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest)))))
             (Expr body var))))
    ((lambda (,params ...) ,body)
     (if (memq var params)
         #f
         (if (memq var (free-vars body params))
             #t
             (Expr body var))))
    ((%make-closure ,tag ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((%make-closure-env ,tag ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((%cont-fun ,f-name (,params ...) ,f-body ,in-body)
     (if (eq? f-name var)
         #f
         (or (if (memq var params) #f (Expr f-body var))
             (Expr in-body var))))
    ((%cont-call ,target ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((%with-handler ,h ,body)
     (or (Expr h var) (Expr body var)))
    ((%raw-call/cc ,arg)
     (Expr arg var))
    ((%call-with-values ,prod ,cons-fn)
     (or (Expr prod var) (Expr cons-fn var)))
    ((%values ,es ...)
     (let loop ((rest es))
       (and (pair? rest) (or (Expr (car rest) var) (loop (cdr rest))))))
    ((%program ,defs ,main)
     (or (let loop ((ds defs))
           (and (pair? ds)
                (or (let ((d (car ds)))
                      (if (and (pair? d) (eq? (car d) 'define))
                          (Expr (caddr d) var)
                          (Expr d var)))
                    (loop (cdr ds)))))
         (Expr main var)))
    ((,op ,args ...)
     (if (eq? op var)
         (let loop ((as args))
           (and (pair? as) (or (Expr (car as) var) (loop (cdr as)))))
         (or (Expr op var)
             (let loop ((as args))
               (and (pair? as) (or (Expr (car as) var) (loop (cdr as))))))))))

(define (escapes? var expr)
  (analyze-escapes expr var))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: tail-calls-only?
;;; Checks whether all call sites of `var` in `expr` are in tail position.
;;; -----------------------------------------------------------------------
(define-pass tail-calls-only-impl : L_core (ir var tail?) -> * (ok?)
  (definitions
    (define (all-non-tail es v)
      (or (null? es)
          (and (tail-calls-only-impl (car es) v #f)
               (all-non-tail (cdr es) v)))))
  (Expr : Expr (ir var tail?) -> * (ok?)
    ((quote ,datum) #t)
    (,x (guard (symbol? x)) #t)
    (,c (guard (not (pair? c))) #t)
    ((if ,test ,then ,else-expr)
     (and (tail-calls-only-impl test var #f)
          (tail-calls-only-impl then var tail?)
          (tail-calls-only-impl else-expr var tail?)))
    ((if ,test ,then)
     (and (tail-calls-only-impl test var #f)
          (tail-calls-only-impl then var tail?)))
    ((begin ,es ...)
     (let loop ((rest es))
       (cond
         ((null? rest) #t)
         ((null? (cdr rest)) (tail-calls-only-impl (car rest) var tail?))
         (else (and (tail-calls-only-impl (car rest) var #f) (loop (cdr rest)))))))
    ((let ((,x* ,e*) ...) ,body)
     (and (all-non-tail e* var)
          (if (memq var x*) #t (tail-calls-only-impl body var tail?))))
    ((letrec ((,x* ,e*) ...) ,body)
     (if (memq var x*)
         #t
         (and (all-non-tail e* var)
              (tail-calls-only-impl body var tail?))))
    ((lambda (,params ...) ,body)
     (if (memq var params) #t (tail-calls-only-impl body var #t)))
    ((%cont-fun ,f-name (,params ...) ,f-body ,in-body)
     (if (eq? f-name var)
         #t
         (and (if (memq var params) #t (tail-calls-only-impl f-body var tail?))
              (tail-calls-only-impl in-body var tail?))))
    ((%cont-call ,target ,es ...)
     (all-non-tail es var))
    ((%with-handler ,h ,body)
     (and (tail-calls-only-impl h var #f) (tail-calls-only-impl body var #f)))
    ((%raw-call/cc ,arg)
     (tail-calls-only-impl arg var #f))
    ((%call-with-values ,prod ,cons-fn)
     (and (tail-calls-only-impl prod var #f) (tail-calls-only-impl cons-fn var #f)))
    ((%values ,es ...)
     (all-non-tail es var))
    ((%program ,defs ,main)
     (and (let loop ((ds defs))
            (or (null? ds)
                (let ((d (car ds)))
                  (and (if (and (pair? d) (eq? (car d) 'define))
                           (tail-calls-only-impl (caddr d) var #f)
                           (tail-calls-only-impl d var #f))
                       (loop (cdr ds))))))
          (tail-calls-only-impl main var tail?)))
    ((,op ,args ...)
     (if (eq? op var)
         (and tail? (all-non-tail args var))
         (and (tail-calls-only-impl op var #f) (all-non-tail args var))))))

(define (tail-calls-only? var expr)
  (tail-calls-only-impl expr var #t))

;;; Checks whether a binding `(var val)` in `(letrec ... body)` is contifiable.
(define (contifiable-binding? var val body)
  (and (pair? val)
       (eq? (car val) 'lambda)
       (pair? (cdr val))
       (pair? (cddr val))
       (not (escapes? var body))
       (not (escapes? var (caddr val)))
       (tail-calls-only? var body)
       (tail-calls-only? var (caddr val))))

;;; -----------------------------------------------------------------------
;;; Static Arity Checker (Issue #629)
;;; Validates call sites against builtin primitives and known procedures.
;;; -----------------------------------------------------------------------

(define (ast-contains-num-args? expr)
  (cond
    ((not (pair? expr)) #f)
    ((eq? (car expr) '%num-args) #t)
    (else
     (or (ast-contains-num-args? (car expr))
         (ast-contains-num-args? (cdr expr))))))

(define (formal-params-arity params)
  (cond
    ((symbol? params) (cons 'min 0))
    ((null? params) (cons 'exact 0))
    ((pair? params)
     (let loop ((ps params) (cnt 0))
       (cond
         ((null? ps) (cons 'exact cnt))
         ((symbol? ps) (cons 'min cnt))
         ((pair? ps) (loop (cdr ps) (+ cnt 1)))
         (else (cons 'exact cnt)))))
    (else #f)))

(define (check-arity-expr expr top-env local-env)
  (cond
    ((not (pair? expr)) #t)
    (else
     (let ((op (car expr)))
       (case op
         ((quote) #t)
         ((if)
          (check-arity-expr (cadr expr) top-env local-env)
          (check-arity-expr (caddr expr) top-env local-env)
          (if (pair? (cdddr expr))
              (check-arity-expr (cadddr expr) top-env local-env)
              #t))
         ((begin)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cdr expr)))
         ((let)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (new-local
                  (let loop ((bs bindings) (acc local-env))
                    (if (null? bs) acc
                        (let* ((b (car bs))
                               (var (car b))
                               (val (cadr b)))
                          (check-arity-expr val top-env local-env)
                          (if (and (pair? val)
                                   (eq? (car val) 'lambda)
                                   (pair? (cdr val))
                                   (not (and (pair? (cddr val)) (ast-contains-num-args? (caddr val)))))
                              (let ((ar (formal-params-arity (cadr val))))
                                (if ar (loop (cdr bs) (cons (cons var ar) acc))
                                    (loop (cdr bs) acc)))
                              (loop (cdr bs) acc)))))))
            (check-arity-expr body top-env new-local)))
         ((letrec)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (rec-local
                  (let loop ((bs bindings) (acc local-env))
                    (if (null? bs) acc
                        (let* ((b (car bs))
                               (var (car b))
                               (val (cadr b)))
                          (if (and (pair? val)
                                   (eq? (car val) 'lambda)
                                   (pair? (cdr val))
                                   (not (and (pair? (cddr val)) (ast-contains-num-args? (caddr val)))))
                              (let ((ar (formal-params-arity (cadr val))))
                                (if ar (loop (cdr bs) (cons (cons var ar) acc))
                                    (loop (cdr bs) acc)))
                              (loop (cdr bs) acc)))))))
            (for-each (lambda (b) (check-arity-expr (cadr b) top-env rec-local)) bindings)
            (check-arity-expr body top-env rec-local)))
         ((lambda)
          (let ((body (caddr expr)))
            (check-arity-expr body top-env local-env)))
         ((%make-closure %make-closure-env)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cddr expr)))
         ((%cont-fun)
          (let ((f-body (cadddr expr))
                (in-body (cadr (cdddr expr))))
            (check-arity-expr f-body top-env local-env)
            (check-arity-expr in-body top-env local-env)))
         ((%cont-call)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cddr expr)))
         ((%with-handler)
          (check-arity-expr (cadr expr) top-env local-env)
          (check-arity-expr (caddr expr) top-env local-env))
         ((%raw-call/cc)
          (check-arity-expr (cadr expr) top-env local-env))
         ((%call-with-values)
          (check-arity-expr (cadr expr) top-env local-env)
          (check-arity-expr (caddr expr) top-env local-env))
         ((%values)
          (for-each (lambda (e) (check-arity-expr e top-env local-env)) (cdr expr)))
         ((%program)
          (let* ((defs (cadr expr))
                 (main (caddr expr))
                 (new-top
                  (let loop ((ds defs) (acc top-env))
                    (if (null? ds) acc
                        (let ((d (car ds)))
                          (if (and (pair? d) (eq? (car d) 'define) (pair? (cdr d)) (pair? (cddr d)))
                              (let ((name (cadr d))
                                    (val (caddr d)))
                                (if (and (pair? val)
                                         (eq? (car val) 'lambda)
                                         (pair? (cdr val))
                                         (not (and (pair? (cddr val)) (ast-contains-num-args? (caddr val)))))
                                    (let ((ar (formal-params-arity (cadr val))))
                                      (if ar (loop (cdr ds) (cons (cons name ar) acc))
                                          (loop (cdr ds) acc)))
                                    (loop (cdr ds) acc)))
                              (loop (cdr ds) acc)))))))
            (for-each (lambda (d)
                        (if (and (pair? d) (eq? (car d) 'define))
                            (check-arity-expr (caddr d) new-top local-env)
                            (check-arity-expr d new-top local-env)))
                      defs)
            (check-arity-expr main new-top local-env)))
         (else
          ;; Call site: (op arg1 ... argN)
          (let* ((args (cdr expr))
                 (actual (length args)))
            (if (symbol? op)
                (let ((fixed (builtin-fixed-arity op))
                      (min-a (builtin-min-arity op))
                      (top-fn (assq op top-env))
                      (loc-fn (assq op local-env)))
                  (cond
                    ((eq? op '-)
                     (if (not (or (= actual 1) (= actual 2)))
                         (error (string-append "[ULISP ARITY ERROR] Builtin procedure '-' expects 1 or 2 argument(s), but got "
                                               (number->string actual))
                                expr)))
                    ((number? fixed)
                     (if (not (= actual fixed))
                         (error (string-append "[ULISP ARITY ERROR] Builtin procedure '"
                                               (symbol->string op) "' expects "
                                               (number->string fixed) " argument(s), but got "
                                               (number->string actual))
                                expr)))
                    ((number? min-a)
                     (if (< actual min-a)
                         (error (string-append "[ULISP ARITY ERROR] Builtin procedure '"
                                               (symbol->string op) "' requires at least "
                                               (number->string min-a) " argument(s), but got "
                                               (number->string actual))
                                expr)))
                    (loc-fn
                     (let ((sig (cdr loc-fn)))
                       (if (eq? (car sig) 'exact)
                           (if (not (= actual (cdr sig)))
                               (error (string-append "[ULISP ARITY ERROR] Local procedure '"
                                                     (symbol->string op) "' expects "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr))
                           (if (< actual (cdr sig))
                               (error (string-append "[ULISP ARITY ERROR] Local procedure '"
                                                     (symbol->string op) "' requires at least "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr)))))
                    (top-fn
                     (let ((sig (cdr top-fn)))
                       (if (eq? (car sig) 'exact)
                           (if (not (= actual (cdr sig)))
                               (error (string-append "[ULISP ARITY ERROR] Procedure '"
                                                     (symbol->string op) "' expects "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr))
                           (if (< actual (cdr sig))
                               (error (string-append "[ULISP ARITY ERROR] Procedure '"
                                                     (symbol->string op) "' requires at least "
                                                     (number->string (cdr sig)) " argument(s), but got "
                                                     (number->string actual))
                                      expr))))))))
            (if (pair? op)
                (check-arity-expr op top-env local-env))
            (for-each (lambda (a) (check-arity-expr a top-env local-env)) args))))))))

(define (check-arity-all ast)
  (check-arity-expr ast '() '())
  ast)

;;; -----------------------------------------------------------------------
;;; Binding ID Set Free-Variable & Closure Capture Extraction (Issue #837)
;;; -----------------------------------------------------------------------

(define (free-binding-ids expr bound-syms)
  (symbols->binding-id-set (free-vars expr bound-syms)))

(define (closure-capture-binding-ids expr bound-syms)
  (let ((fvars (free-vars expr bound-syms)))
    (let loop ((vs fvars) (acc binding-id-set-empty))
      (if (null? vs)
          acc
          (let ((b (lookup-binding-by-symbol (car vs))))
            (if (and b (eq? (binding-storage-class b) 'lexical))
                (loop (cdr vs) (binding-id-set-add (binding-id b) acc))
                (loop (cdr vs) acc)))))))
;;; =======================================================================
;;; Synapse Concurrency Library: Safepoint Injection Pass
;;; Path: lib/ulisp/concurrency/passes/pass_inject_safepoints.scm
;;; Conforms to DSN-37 Section 7.2, 12.4 & Phase 3 Task 3.4 (Issue #640)
;;;
;;; Pluggable Compiler Pass provided by (ulisp concurrency):
;;; Injected after pass-synapse-fbip via
;;; (inject-synapse-safepoints-pass!).
;;;
;;; Injects deterministic reduction budget decrement & preemption polling
;;; (%synapse-safepoint-poll!) into all ASC kernel function entries,
;;; lambda prologues, and loop backedges (named-let, recursion).
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Utilities & AST Predicates
;;; -----------------------------------------------------------------------

(define (safepoint-poll-form? expr)
  (and (pair? expr)
       (or (eq? (car expr) '%synapse-safepoint-poll!)
           (eq? (car expr) '%safepoint-poll!))))

(define (make-safepoint-poll)
  '(%synapse-safepoint-poll!))

(define (safepoint-string-starts-with? str prefix)
  (let ((s-len (string-length str))
        (p-len (string-length prefix)))
    (if (< s-len p-len)
        #f
        (let loop ((i 0))
          (if (= i p-len)
              #t
              (if (char=? (string-ref str i) (string-ref prefix i))
                  (loop (+ i 1))
                  #f))))))

(define *safepoint-excluded-exact-symbols*
  '(sys-poll
    task-yield!
    yield
    current-synapse-task
    check-safepoint!
    safepoint-poll!
    task-state
    task-state-set!
    task-reductions
    task-reductions-set!
    task-replenish!
    task-target-obj
    task-id
    task-initial-budget
    task-exhaustion-count
    task-exhausted?
    budgeted-task?
    task-context?
    %synapse-safepoint-poll!
    %safepoint-poll!
    synapse-safepoint-poll!))

(define (safepoint-excluded-name? sym)
  (if (not (symbol? sym))
      #f
      (let ((str (symbol->string sym)))
        (or
          ;; All low-level %-prefixed runtime primitives are strictly excluded to prevent reentrancy cycles
          (safepoint-string-starts-with? str "%")
          (if (memq sym *safepoint-excluded-exact-symbols*) #t #f)
          (if (memq sym (car *declared-no-safepoint-names*)) #t #f)))))

(define (safepoint-no-safepoint-decl? expr)
  (and (pair? expr)
       (or (and (eq? (car expr) 'declare)
                (pair? (cdr expr))
                (let ((decl (cadr expr)))
                  (or (eq? decl 'no-safepoint)
                      (eq? decl 'no-safepoints)
                      (and (pair? decl)
                           (or (eq? (car decl) 'no-safepoint)
                               (eq? (car decl) 'no-safepoints))))))
           (eq? (car expr) 'no-safepoint)
           (eq? (car expr) 'no-safepoints)
           (eq? (car expr) '%no-safepoint))))

(define (safepoint-has-decl? expr)
  (cond
    ((safepoint-no-safepoint-decl? expr) #t)
    ((and (pair? expr) (eq? (car expr) 'begin) (pair? (cdr expr)))
     (or (safepoint-no-safepoint-decl? (cadr expr))
         (safepoint-has-decl? (cadr expr))))
    (else #f)))

(define (safepoint-strip-decl expr)
  (cond
    ((safepoint-no-safepoint-decl? expr)
     '(begin))
    ((and (pair? expr) (eq? (car expr) 'begin) (pair? (cdr expr)))
     (if (safepoint-no-safepoint-decl? (cadr expr))
         (let ((rest (cddr expr)))
           (cond
             ((null? rest) '(begin))
             ((null? (cdr rest)) (car rest))
             (else (cons 'begin rest))))
         (if (safepoint-has-decl? (cadr expr))
             (let ((stripped-first (safepoint-strip-decl (cadr expr))))
               (cons 'begin (cons stripped-first (cddr expr))))
             expr)))
    (else expr)))

(define (safepoint-body-has-decl? body-list)
  (and (pair? body-list)
       (or (safepoint-no-safepoint-decl? (car body-list))
           (safepoint-has-decl? (car body-list)))))

(define (safepoint-body-strip-decl body-list)
  (cond
    ((null? body-list) '())
    ((safepoint-no-safepoint-decl? (car body-list))
     (if (null? (cdr body-list))
         '(#t)
         (cdr body-list)))
    ((safepoint-has-decl? (car body-list))
     (cons (safepoint-strip-decl (car body-list)) (cdr body-list)))
    (else body-list)))

(define *safepoint-trivial-accessors*
  '(car cdr caar cadr cdar cddr caaar caadr cadar caddr cdaar cdadr cddar cdddr
    vector-ref string-ref bytevector-u8-ref slot-ref))

(define (safepoint-trivial-atom? expr)
  (or (symbol? expr)
      (number? expr)
      (boolean? expr)
      (string? expr)
      (null? expr)
      (and (pair? expr) (eq? (car expr) 'quote))))

(define (safepoint-trivial-leaf-expr? expr)
  (and (pair? expr)
       (let ((op (car expr))
             (args (cdr expr)))
         (and (symbol? op)
              (memq op *safepoint-trivial-accessors*)
              (not (null? args))
              (let loop ((as args))
                (cond
                  ((null? as) #t)
                  ((symbol? (car as)) (loop (cdr as)))
                  ((number? (car as)) (loop (cdr as)))
                  (else #f)))))))

(define (safepoint-trivial-body? body-list)
  (and (pair? body-list)
       (null? (cdr body-list))
       (safepoint-trivial-leaf-expr? (car body-list))))

(define (lambda-form? expr)
  (and (pair? expr)
       (eq? (car expr) 'lambda)
       (pair? (cdr expr))))

(define (named-let-form? expr)
  (and (pair? expr)
       (eq? (car expr) 'let)
       (pair? (cdr expr))
       (symbol? (cadr expr))
       (pair? (cddr expr))))

(define (let-form? expr)
  (and (pair? expr)
       (eq? (car expr) 'let)
       (pair? (cdr expr))
       (not (symbol? (cadr expr)))))

(define (let*-form? expr)
  (and (pair? expr)
       (eq? (car expr) 'let*)
       (pair? (cdr expr))))

(define (begin-form? expr)
  (and (pair? expr)
       (eq? (car expr) 'begin)))

(define (if-form? expr)
  (and (pair? expr)
       (eq? (car expr) 'if)
       (pair? (cdr expr))
       (pair? (cddr expr))))

(define (asc-kernel-form? expr)
  (and (pair? expr)
       (eq? (car expr) '%asc-kernel)
       (pair? (cdr expr))
       (pair? (cddr expr))))

;;; -----------------------------------------------------------------------
;;; 2. Body Sequence Injection Helpers
;;; -----------------------------------------------------------------------

(define (prepend-safepoint-to-list expr-list)
  (if (null? expr-list)
      (list (make-safepoint-poll))
      (if (safepoint-poll-form? (car expr-list))
          expr-list
          (cons (make-safepoint-poll) expr-list))))

(define (wrap-with-safepoint-prologue body-expr)
  (cond
    ((safepoint-poll-form? body-expr)
     body-expr)
    ((begin-form? body-expr)
     (cons 'begin (prepend-safepoint-to-list (cdr body-expr))))
    (else
     (list 'begin (make-safepoint-poll) body-expr))))

;;; -----------------------------------------------------------------------
;;; 3. Recursive AST Traversal & Loop Backedge Injection
;;; -----------------------------------------------------------------------

(define (inject-safepoints-expr expr loop-names)
  (cond
    ((not (pair? expr))
     expr)

    ;; Quoted literals: do not touch
    ((eq? (car expr) 'quote)
     expr)

    ;; Improper / dotted pairs: cannot be function applications, leave intact
    ((not (list? expr))
     expr)

    ;; Safepoint poll already present: leave intact
    ((safepoint-poll-form? expr)
     expr)

    ;; Lambda abstraction: inject safepoint into prologue (skipping explicit no-safepoint)
    ((lambda-form? expr)
     (let* ((formals (cadr expr))
            (raw-body (cddr expr))
            (has-decl? (safepoint-body-has-decl? raw-body))
            (clean-body-list (if has-decl?
                                 (safepoint-body-strip-decl raw-body)
                                 raw-body))
            (skip? (or has-decl? (safepoint-trivial-body? clean-body-list)))
            (single-body (if (null? (cdr clean-body-list))
                             (car clean-body-list)
                             (cons 'begin clean-body-list)))
            (injected-body (if skip?
                               single-body
                               (wrap-with-safepoint-prologue single-body)))
            (trans-body (inject-safepoints-expr injected-body loop-names)))
       (list 'lambda formals trans-body)))

    ;; Named let (loop construct): inject into loop entry & track loop identifier
    ((named-let-form? expr)
     (let* ((loop-name (cadr expr))
            (bindings (caddr expr))
            (raw-body (cdddr expr))
            (has-decl? (safepoint-body-has-decl? raw-body))
            (clean-body-list (if has-decl?
                                 (safepoint-body-strip-decl raw-body)
                                 raw-body))
            (skip? (or (safepoint-excluded-name? loop-name)
                       has-decl?
                       (safepoint-trivial-body? clean-body-list)))
            (single-body (if (null? (cdr clean-body-list))
                             (car clean-body-list)
                             (cons 'begin clean-body-list)))
            (new-loop-names (if (memq loop-name loop-names)
                                loop-names
                                (cons loop-name loop-names)))
            ;; Transform bindings
            (trans-bindings
              (map (lambda (b)
                     (if (pair? b)
                         (list (car b) (inject-safepoints-expr (cadr b) loop-names))
                         b))
                   bindings))
            ;; Inject safepoint at loop entry
            (injected-body (if skip?
                               single-body
                               (wrap-with-safepoint-prologue single-body)))
            (trans-body (if skip?
                            single-body
                            (inject-safepoints-expr injected-body new-loop-names))))
       (list 'let loop-name trans-bindings trans-body)))

    ;; Standard let
    ((let-form? expr)
     (let* ((bindings (cadr expr))
            (body (cddr expr))
            (trans-bindings
              (map (lambda (b)
                     (if (pair? b)
                         (list (car b) (inject-safepoints-expr (cadr b) loop-names))
                         b))
                   bindings))
            (trans-body (map (lambda (e) (inject-safepoints-expr e loop-names)) body)))
       (cons 'let (cons trans-bindings trans-body))))

    ;; Standard let*
    ((let*-form? expr)
     (let* ((bindings (cadr expr))
            (body (cddr expr))
            (trans-bindings
              (map (lambda (b)
                     (if (pair? b)
                         (list (car b) (inject-safepoints-expr (cadr b) loop-names))
                         b))
                   bindings))
            (trans-body (map (lambda (e) (inject-safepoints-expr e loop-names)) body)))
       (cons 'let* (cons trans-bindings trans-body))))

    ;; Standard letrec / letrec*
    ((or (and (pair? expr) (eq? (car expr) 'letrec) (pair? (cdr expr)))
         (and (pair? expr) (eq? (car expr) 'letrec*) (pair? (cdr expr))))
     (let* ((op (car expr))
            (bindings (cadr expr))
            (body (cddr expr))
            (trans-bindings
              (map (lambda (b)
                     (if (and (pair? b) (pair? (cdr b)))
                         (let* ((var (car b))
                                (val (cadr b))
                                (skip-binding? (safepoint-excluded-name? var)))
                           (if (and skip-binding? (pair? val) (eq? (car val) 'lambda))
                               b
                               (list var (inject-safepoints-expr val loop-names))))
                         b))
                   bindings))
            (trans-body (map (lambda (e) (inject-safepoints-expr e loop-names)) body)))
       (cons op (cons trans-bindings trans-body))))

    ;; Begin block
    ((begin-form? expr)
     (cons 'begin (map (lambda (e) (inject-safepoints-expr e loop-names)) (cdr expr))))

    ;; If conditional
    ((if-form? expr)
     (let ((test (cadr expr))
           (conseq (caddr expr))
           (alt (if (null? (cdddr expr)) #f (cadddr expr))))
       (if alt
           (list 'if
                 (inject-safepoints-expr test loop-names)
                 (inject-safepoints-expr conseq loop-names)
                 (inject-safepoints-expr alt loop-names))
           (list 'if
                 (inject-safepoints-expr test loop-names)
                 (inject-safepoints-expr conseq loop-names)))))

    ;; Loop backedge call (e.g. (loop-name arg1 arg2))
    ((and (symbol? (car expr)) (memq (car expr) loop-names))
     ;; Explicitly wrap with (%synapse-safepoint-poll!) before the recursive loop backedge
     (let ((trans-args (map (lambda (e) (inject-safepoints-expr e loop-names)) (cdr expr))))
       (list 'begin
             (make-safepoint-poll)
             (cons (car expr) trans-args))))

    ;; General application
    (else
     (map (lambda (e) (inject-safepoints-expr e loop-names)) expr))))

;;; -----------------------------------------------------------------------
;;; 4. Form & ASC Kernel Transformation (Layer 1 & Layer 2)
;;; -----------------------------------------------------------------------

(define (inject-safepoints-kernel kernel-node)
  (if (not (asc-kernel-form? kernel-node))
      kernel-node
      (let* ((header (cadr kernel-node))
             (raw-bodies (cddr kernel-node))
             (body (if (null? (cdr raw-bodies))
                       (car raw-bodies)
                       (cons 'begin raw-bodies)))
             ;; Wrap kernel prologue
             (prologue-wrapped (wrap-with-safepoint-prologue body))
             ;; Traverse and inject loop backedges
             (trans-body (inject-safepoints-expr prologue-wrapped '())))
        (list '%asc-kernel header trans-body))))

(define (inject-safepoints-named-expr name expr loop-names)
  (cond
    ;; (define name (begin (declare (no-safepoints)) value)): leave value untouched
    ((and (pair? expr) (eq? (car expr) 'begin) (pair? (cdr expr))
          (safepoint-no-safepoint-decl? (cadr expr)))
     (let ((rest (cddr expr)))
       (cond ((null? rest) #t)
             ((null? (cdr rest)) (car rest))
             (else (cons 'begin rest)))))
    ((and (lambda-form? expr) (safepoint-excluded-name? name))
     ;; Excluded by name (e.g. %-prefix or *safepoint-excluded-exact-symbols*):
     ;; Do not inject safepoint into prologue, but strip declarations and traverse body.
     (let* ((formals (cadr expr))
            (raw-body (cddr expr))
            (has-decl? (safepoint-body-has-decl? raw-body))
            (clean-body-list (if has-decl?
                                 (safepoint-body-strip-decl raw-body)
                                 raw-body))
            (single-body (if (null? (cdr clean-body-list))
                             (car clean-body-list)
                             (cons 'begin clean-body-list))))
       ;; Body is intentionally NOT traversed: nested lambdas (e.g. from case-lambda)
       ;; of excluded runtime primitives must not receive safepoints (reentrancy).
       (list 'lambda formals single-body)))
    ((safepoint-excluded-name? name)
     expr)
    (else
     (inject-safepoints-expr expr loop-names))))

(define (inject-safepoints-form form)
  (cond
    ((not (pair? form))
     form)
    ;; Quoted forms: leave intact
    ((eq? (car form) 'quote)
     form)
    ;; Improper / dotted pairs: cannot be top-level forms, leave intact
    ((not (list? form))
     form)
    ;; %program wrapper from Pass 025: (%program defs-list body-expr)
    ((and (eq? (car form) '%program)
          (pair? (cdr form))
          (pair? (cddr form)))
     (let* ((defs (cadr form))
            (body-expr (caddr form))
            (trans-defs (map inject-safepoints-form defs))
            (trans-body (inject-safepoints-expr body-expr '())))
       (list '%program trans-defs trans-body)))
    ;; ASC Kernel block: preserve %asc-kernel wrapper
    ((asc-kernel-form? form)
     (inject-safepoints-kernel form))
    ;; define procedure: (define (name . formals) body ...)
    ((and (eq? (car form) 'define)
          (pair? (cdr form))
          (pair? (cadr form)))
     (let* ((sig (cadr form))
            (proc-name (car sig))
            (raw-body (cddr form))
            (has-decl? (safepoint-body-has-decl? raw-body))
            (clean-body (if has-decl?
                            (safepoint-body-strip-decl raw-body)
                            raw-body))
            (skip? (or (safepoint-excluded-name? proc-name)
                       (safepoint-trivial-body? clean-body)
                       has-decl?))
            (injected-body (if skip?
                               clean-body
                               (prepend-safepoint-to-list clean-body)))
            (trans-body (if skip?
                            clean-body
                            (map (lambda (e) (inject-safepoints-expr e '())) injected-body))))
       (cons 'define (cons sig trans-body))))
    ;; define variable: (define name expr)
    ((and (eq? (car form) 'define)
          (pair? (cdr form))
          (symbol? (cadr form))
          (pair? (cddr form)))
     (let* ((name (cadr form))
            (val-expr (caddr form))
            (trans-val (inject-safepoints-named-expr name val-expr '())))
       (list 'define name trans-val)))
    ;; begin block: (begin form ...)
    ((begin-form? form)
     (cons 'begin (map inject-safepoints-form (cdr form))))
    ;; Generic R7RS expressions (let, named-let, lambda, calls, etc.)
    (else
     (inject-safepoints-expr form '()))))

(define (inject-safepoints-pass ir)
  (cond
    ((and (pair? ir) (eq? (car ir) '%program))
     (inject-safepoints-form ir))
    ((and (list? ir) (pair? ir) (pair? (car ir))
          (or (eq? (caar ir) 'define)
              (eq? (caar ir) '%asc-kernel)
              (eq? (caar ir) 'module)))
     (map inject-safepoints-form ir))
    (else
     (inject-safepoints-form ir))))

;;; -----------------------------------------------------------------------
;;; 5. Pluggable Pass Injection & Registration API
;;; -----------------------------------------------------------------------

(define (synapse-safepoint-prerequisites)
  (cond
    ((pass-registered? 'pass-synapse-inline-hotpath) '(pass-synapse-inline-hotpath))
    ((pass-registered? 'pass-synapse-fbip) '(pass-synapse-fbip))
    ((pass-registered? 'pass-040-analysis) '(pass-040-analysis))
    ((pass-registered? 'pass-035-scope-resolve) '(pass-035-scope-resolve))
    (else '(pass-030-desugar))))

(define (synapse-inject-safepoints-descriptor)
  (make-pass-descriptor
    'pass-synapse-inject-safepoints
    "Synapse Reduction Safepoint Injection Pass"
    'frontend
    0
    inject-safepoints-pass
    #f
    'L_core
    'L_core
    (synapse-safepoint-prerequisites)
    #t))

(define (inject-synapse-safepoints-pass!)
  ;; Canonical order: fbip -> inline-hotpath (Issue #682) -> inject-safepoints.
  ;; When Synapse passes are absent, inject into standard frontend Core phase.
  (cond
    ((pass-registered? 'pass-synapse-inline-hotpath)
     (inject-pass-after! 'pass-synapse-inline-hotpath (synapse-inject-safepoints-descriptor)))
    ((pass-registered? 'pass-synapse-fbip)
     (inject-pass-after! 'pass-synapse-fbip (synapse-inject-safepoints-descriptor)))
    ((pass-registered? 'pass-040-analysis)
     (inject-pass-after! 'pass-040-analysis (synapse-inject-safepoints-descriptor)))
    ((pass-registered? 'pass-035-scope-resolve)
     (inject-pass-after! 'pass-035-scope-resolve (synapse-inject-safepoints-descriptor)))
    (else
     (inject-pass-after! 'pass-030-desugar (synapse-inject-safepoints-descriptor)))))

(define (remove-synapse-safepoints-pass!)
  (unregister-pass-registry-init-hook! inject-synapse-safepoints-pass!)
  (remove-injected-pass! 'pass-synapse-inject-safepoints))

;; Automatically register hook for pipeline reinitialization
(register-pass-registry-init-hook! inject-synapse-safepoints-pass!)

;; If registry is already initialized with Core passes, inject immediately
(if (pass-registered? 'pass-030-desugar)
    (inject-synapse-safepoints-pass!))


;;; =======================================================================
;;; ULisp Compiler Pass 3: CP0 Source-Level Optimization Nanopass
;;; Conforms to DSN-33 Architecture Specification
;;; Note: Performs Constant Folding, Dead Branch Pruning, and Dead Let
;;;       Elimination on Canonical Core AST.
;;; =======================================================================

;;; Note: extract-const-val, val->ast-const, pure-expr?, and fold-const-op
;;;       are provided canonically by passes/00_helpers.scm.

;;; Top-level & nested letrec Dead Code Elimination (DCE) based on Reachability Call Graph
(define (dce-letrec bindings body)
  (let* ((rec-vars (map car* bindings))
         (rec-filter (lambda (vars)
                       (filter (lambda (v) (memq v rec-vars)) vars)))
         ;; Map each binding var to its immediate dependencies within rec-vars
         (dep-alist (map (lambda (b)
                           (cons (car b) (rec-filter (free-vars (cadr b) '()))))
                         bindings))
         ;; Root variables:
         ;; 1. Variables in rec-vars that appear free in the body
         (body-roots (rec-filter (free-vars body '())))
         ;; 2. Variables in rec-vars whose initialization is impure (has side effects)
         (impure-roots (let loop ((bs bindings) (acc '()))
                         (cond
                           ((null? bs) acc)
                           ((not (pure-expr? (cadar bs)))
                            (loop (cdr bs) (cons (caar bs) acc)))
                           (else
                            (loop (cdr bs) acc)))))
         (initial-roots (set-union body-roots impure-roots)))
    ;; Transitive closure via worklist
    (let ((reachable
           (let loop ((worklist initial-roots) (visited '()))
             (if (null? worklist)
                 visited
                 (let ((v (car worklist))
                       (rest (cdr worklist)))
                   (if (memq v visited)
                       (loop rest visited)
                       (let* ((v-deps (let ((entry (assq v dep-alist)))
                                        (if entry (cdr entry) '())))
                              (new-worklist (append v-deps rest)))
                         (loop new-worklist (cons v visited)))))))))
      ;; Retain only bindings in reachable set
      (let ((kept-bindings (filter (lambda (b) (memq (car b) reachable)) bindings)))
        (if (null? kept-bindings)
            body
            (list 'letrec kept-bindings body))))))

;;; -----------------------------------------------------------------------
;;; Top-level helpers for CP0 optimization
;;; -----------------------------------------------------------------------
(define (cp0-flatten-begin-list es)
  (let loop ((rest es) (acc '()))
    (cond
      ((null? rest) (reverse acc))
      ((and (pair? (car rest)) (eq? (caar rest) 'begin))
       (loop (append (cdar rest) (cdr rest)) acc))
      (else (loop (cdr rest) (cons (car rest) acc))))))

(define (cp0-zip-bindings xs es)
  (let loop ((x xs) (e es) (acc '()))
    (if (or (null? x) (null? e))
        (reverse acc)
        (loop (cdr x) (cdr e) (cons (list (car x) (car e)) acc)))))

;;; -----------------------------------------------------------------------
;;; Guard predicates for CP0 Picopass rules (preserving eq? sharing)
;;; -----------------------------------------------------------------------
(define (cp0-can-flatten-begin? es)
  (and (pair? es)
       (or (null? (cdr es))
           (let loop ((rest es))
             (and (pair? rest)
                  (or (and (pair? (car rest)) (eq? (caar rest) 'begin))
                      (loop (cdr rest))))))))

(define (cp0-has-dead-let-binding? x* e* body)
  (or (null? x*)
      (and (let has-pure? ((es e*))
             (and (pair? es)
                  (or (pure-expr? (car es))
                      (has-pure? (cdr es)))))
           (let ((body-frees (free-vars body '())))
             (let loop ((xs x*) (es e*))
               (and (pair? xs) (pair? es)
                    (or (and (pure-expr? (car es))
                             (not (memq (car xs) body-frees)))
                        (loop (cdr xs) (cdr es)))))))))

(define (cp0-has-dead-letrec-binding? x* e* body)
  (if (and (pair? x*)
           (null? (cdr x*))
           (pair? body)
           (eq? (car body) (car x*)))
      #f
      (let* ((bindings (cp0-zip-bindings x* e*))
             (reduced (dce-letrec bindings body)))
        (not (and (pair? reduced)
                  (eq? (car reduced) 'letrec)
                  (eq? (caddr reduced) body)
                  (= (length (cadr reduced)) (length bindings)))))))

(define (cp0-inlineable-unary-lambda? fn)
  (and (pair? fn)
       (eq? (car fn) 'lambda)
       (pair? (cdr fn))
       (pair? (cadr fn))
       (symbol? (caadr fn))
       (null? (cdadr fn))
       (pair? (cddr fn))
       (null? (cdddr fn))))

(define (cp0-call-values-reducible? p c)
  (or (and (pair? p) (eq? (car p) 'lambda) (null? (cadr p))
           (pair? (caddr p)) (memq (car (caddr p)) '(%values values))
           (pair? c) (eq? (car c) 'lambda) (list? (cadr c))
           (= (length (cdr (caddr p))) (length (cadr c))))
      (and (pair? p) (eq? (car p) 'lambda) (null? (cadr p))
           (not (and (pair? (caddr p)) (memq (car (caddr p)) '(%values values))))
           (pair? c) (eq? (car c) 'lambda) (list? (cadr c))
           (= (length (cadr c)) 1))))

;;; -----------------------------------------------------------------------
;;; First-Class Picopass Rules for CP0 Optimization (DSN-33-01 T5.2)
;;; -----------------------------------------------------------------------

(define-picopass rule-cp0-prune-if-3
  :reads '(if) :writes '(if)
  (Expr
    ((if ,test ,then ,else-val) (guard (const? test))
     (let ((v (extract-const-val test)))
       (if (eq? v #f) else-val then)))))

(define-picopass rule-cp0-prune-if-2
  :reads '(if) :writes '(if)
  (Expr
    ((if ,test ,then)
     (if (const? test)
         (let ((v (extract-const-val test)))
           (if (eq? v #f) #f then))
         (list 'if test then #f)))))

(define (cp0-eq-testable-const-list? lst)
  (let loop ((xs lst) (n 0))
    (cond
      ((null? xs) #t)
      ((> n 256) #f)
      ((not (pair? xs)) #f)
      (else
       (let ((k (car xs)))
         (and (or (symbol? k) (boolean? k) (null? k))
              (loop (cdr xs) (+ n 1))))))))

(define (cp0-build-eq-chain var lst)
  (let loop ((xs lst))
    (cond
      ((null? xs) #f)
      ((null? (cdr xs))
       (list 'eq? var (val->ast-const (car xs))))
      (else
       (list 'if
             (list 'eq? var (val->ast-const (car xs)))
             #t
             (loop (cdr xs)))))))

(define (cp0-lower-memq-bool expr lst then-expr else-expr)
  (cond
    ((const? expr)
     (if (memq (extract-const-val expr) lst)
         then-expr
         else-expr))
    ((null? lst)
     (if (pure-expr? expr)
         else-expr
         (list 'begin expr else-expr)))
    ((symbol? expr)
     (if (and (eq? then-expr #t) (eq? else-expr #f))
         (cp0-build-eq-chain expr lst)
         (list 'if (cp0-build-eq-chain expr lst) then-expr else-expr)))
    (else
     (let ((tmp (unique-symbol "__cp0_mq_")))
       (list 'let (list (list tmp expr))
             (if (and (eq? then-expr #t) (eq? else-expr #f))
                 (cp0-build-eq-chain tmp lst)
                 (list 'if (cp0-build-eq-chain tmp lst) then-expr else-expr)))))))

(define-picopass rule-cp0-memq-quoted-bool
  :reads '(if not memq) :writes '(if let begin eq?)
  (Expr
    ((if (memq ,expr (quote ,lst)) ,then ,else-val)
     (guard (cp0-eq-testable-const-list? lst))
     (cp0-lower-memq-bool expr lst then else-val))
    ((if (memq ,expr (quote ,lst)) ,then)
     (guard (cp0-eq-testable-const-list? lst))
     (cp0-lower-memq-bool expr lst then #f))
    ((not (memq ,expr (quote ,lst)))
     (guard (cp0-eq-testable-const-list? lst))
     (cp0-lower-memq-bool expr lst #f #t))))

(define-picopass rule-cp0-flatten-begin
  :reads '(begin) :writes '(begin)
  (Expr
    ((begin ,es ...) (guard (cp0-can-flatten-begin? es))
     (let ((flat (cp0-flatten-begin-list es)))
       (cond
         ((null? flat) '(begin))
         ((null? (cdr flat)) (car flat))
         (else (cons 'begin flat)))))))

(define-picopass rule-cp0-dead-let
  :reads '(let) :writes '(let)
  (Expr
    ((let ((,x* ,e*) ...) ,body) (guard (cp0-has-dead-let-binding? x* e* body))
     (let* ((bindings (cp0-zip-bindings x* e*))
            (body-frees (free-vars body '()))
            (kept (filter (lambda (b)
                            (or (not (pure-expr? (cadr b)))
                                (memq (car b) body-frees)))
                          bindings)))
       (if (null? kept)
           body
           (list 'let kept body))))))

(define-picopass rule-cp0-dead-letrec
  :reads '(letrec) :writes '(letrec)
  (Expr
    ((letrec ((,x* ,e*) ...) ,body) (guard (cp0-has-dead-letrec-binding? x* e* body))
     (let ((bindings (cp0-zip-bindings x* e*)))
       (dce-letrec bindings body)))))

(define-picopass rule-cp0-call-values
  :reads '(%call-with-values) :writes '(let)
  (Expr
    ((%call-with-values ,producer ,consumer) (guard (cp0-call-values-reducible? producer consumer))
     (let ((p producer) (c consumer))
       (if (and (pair? (caddr p)) (memq (car (caddr p)) '(%values values)))
           (let* ((vals (cdr (caddr p)))
                  (vars (cadr c))
                  (cbody (caddr c))
                  (bindings (cp0-zip-bindings vars vals)))
             (list 'let bindings cbody))
           (let ((val (caddr p))
                 (var (car (cadr c)))
                 (cbody (caddr c)))
             (list 'let (list (list var val)) cbody)))))))

(define (cp0-all-const-args? args)
  (let loop ((as args))
    (if (null? as)
        #t
        (and (const? (car as)) (loop (cdr as))))))

(define (cp0-fold-expr op args)
  (let ((folded (fold-const-op op args)))
    (if folded
        folded
        (if (and (symbol? op) (cp0-all-const-args? args) (ctfe-pure-prim? op))
            (eval-in-language 'L_core (cons op args))
            #f))))

(define-picopass rule-cp0-const-fold
  :reads '() :writes '()
  (Expr
    ((,op ,args ...) (guard (and (symbol? op) (cp0-fold-expr op args)))
     (cp0-fold-expr op args))))

(define-picopass rule-cp0-inline-map-for-each
  :reads '(map for-each lambda) :writes '(letrec lambda if let begin)
  (Expr
    ((map ,fn ,ls) (guard (cp0-inlineable-unary-lambda? fn))
     (let ((param (caadr fn))
           (fbody (caddr fn))
           (loop-sym (unique-symbol "__cp0_map_loop_"))
           (cur-sym (unique-symbol "__cp0_map_cur_"))
           (acc-sym (unique-symbol "__cp0_map_acc_"))
           (val-sym (unique-symbol "__cp0_map_val_")))
       (list 'letrec
             (list (list loop-sym
                         (list 'lambda (list cur-sym acc-sym)
                               (list 'if (list 'pair? cur-sym)
                                     (list 'let (list (list val-sym (list 'let (list (list param (list 'car cur-sym))) fbody)))
                                           (list loop-sym (list 'cdr cur-sym) (list 'cons val-sym acc-sym)))
                                     (list 'reverse acc-sym)))))
             (list loop-sym ls ''()))))
    ((for-each ,fn ,ls) (guard (cp0-inlineable-unary-lambda? fn))
     (let ((param (caadr fn))
           (fbody (caddr fn))
           (loop-sym (unique-symbol "__cp0_fe_loop_"))
           (cur-sym (unique-symbol "__cp0_fe_cur_")))
       (list 'letrec
             (list (list loop-sym
                         (list 'lambda (list cur-sym)
                               (list 'if (list 'pair? cur-sym)
                                     (list 'begin
                                           (list 'let (list (list param (list 'car cur-sym))) fbody)
                                           (list loop-sym (list 'cdr cur-sym)))
                                     #f))))
             (list loop-sym ls))))))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: cp0-opt
;;; Bottom-up CP0 optimization: Constant Folding, Branch Pruning, and DCE
;;; -----------------------------------------------------------------------
(define-pass cp0-opt : L_core (ir) -> L_core ()
  (Expr : Expr (ir) -> Expr ()
    (fuse-rules :order post
      rule-cp0-prune-if-3
      rule-cp0-prune-if-2
      rule-cp0-memq-quoted-bool
      rule-cp0-flatten-begin
      rule-cp0-dead-let
      rule-cp0-dead-letrec
      rule-cp0-call-values
      rule-cp0-inline-map-for-each
      rule-cp0-const-fold)))

(define (cp0-expr expr)
  (cp0-opt expr))

;;; Top-level entrypoint for CP0 optimization
(define (cp0-optimize form)
  (cp0-opt form))
;;; =======================================================================
;;; ULisp Compiler Pass 3b: Extended Local Value Numbering (LVN) Nanopass
;;; Conforms to DSN-33 Architecture Specification (Section 8.2) & Issue #521
;;;
;;; Features:
;;; 1. Local Value Numbering (LVN) & Scoped Dominance (DVN) environment
;;; 2. Unified Constant Folding, Copy Propagation & Common Subexpression Elimination (CSE)
;;; 3. Immutable Pair Accessor Memoization (car/cdr deduplication & cons reduction)
;;; 4. Type Predicate Folding (fixnum?, pair?, null?, etc. in dominance scopes)
;;; 5. Algebraic Equivalence & Identity Normalization (+, -, *, =, eq?, char=?)
;;; 6. Sound Pair Mutation Invalidation (set-car!, set-cdr!)
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. LVN Environment Data Structure & Accessors
;;; -----------------------------------------------------------------------
;;; Environment layout: (list var-env tuple-env vn-env next-id)
;;;   var-env:   ((var . vn) ...)
;;;   tuple-env: ((canonical-tuple . vn) ...)
;;;   vn-env:    ((vn . (canonical-expr . info)) ...)
;;;   next-id:   integer (1, 2, 3...)

(define (make-lvn-env)
  (list '() '() '() 1))

(define (lvn-env-vars env) (car env))
(define (lvn-env-tuples env) (cadr env))
(define (lvn-env-vns env) (caddr env))
(define (lvn-env-next-id env) (cadddr env))

(define (lvn-set-vars env vars)
  (list vars (cadr env) (caddr env) (cadddr env)))
(define (lvn-set-tuples env tuples)
  (list (car env) tuples (caddr env) (cadddr env)))
(define (lvn-set-vns env vns)
  (list (car env) (cadr env) vns (cadddr env)))

(define (lvn-alloc-vn env canon-expr info)
  (let* ((id (lvn-env-next-id env))
         (new-vns (cons (cons id (cons canon-expr info)) (lvn-env-vns env)))
         (new-env (list (lvn-env-vars env)
                        (lvn-env-tuples env)
                        new-vns
                        (+ id 1))))
    (cons id new-env)))

(define (tree-contains? tree sym)
  (cond
    ((eq? tree sym) #t)
    ((pair? tree)
     (or (tree-contains? (car tree) sym)
         (tree-contains? (cdr tree) sym)))
    (else #f)))

(define (lvn-bind-var env var vn)
  (if (or (not vn) (<= vn 0))
      env
      (let* ((vars (cons (cons var vn) (lvn-env-vars env)))
         (env1 (lvn-set-vars env vars))
         (vn-entry (assq vn (lvn-env-vns env1))))
    ;; If this VN does not have a canonical variable yet (or has a compound expr),
    ;; set its canonical representation to var
    (if (and vn-entry (not (symbol? (cadr vn-entry))))
        (let ((new-vns (cons (cons vn (cons var (cddr vn-entry)))
                             (lvn-env-vns env1))))
          (lvn-set-vns env1 new-vns))
        env1))))

(define (lvn-record-tuple env tuple vn)
  (lvn-set-tuples env (cons (cons tuple vn) (lvn-env-tuples env))))

(define (lvn-lookup-tuple env tuple)
  (let ((entry (assoc tuple (lvn-env-tuples env))))
    (if entry (cdr entry) #f)))

(define (lvn-vn-entry env vn)
  (assq vn (lvn-env-vns env)))

(define (lvn-vn-canon-expr env vn)
  (let ((e (lvn-vn-entry env vn)))
    (if e (cadr e) #f)))

(define (lvn-vn-info env vn)
  (let ((e (lvn-vn-entry env vn)))
    (if e (cddr e) '())))

(define (lvn-vn-is-const? env vn)
  (let ((info (lvn-vn-info env vn)))
    (and (pair? info) (eq? (car info) 'const))))

(define (lvn-vn-const-val env vn)
  (let ((info (lvn-vn-info env vn)))
    (if (and (pair? info) (eq? (car info) 'const))
        (cadr info)
        #f)))

(define (lvn-vn-is-pair? env vn)
  (let ((info (lvn-vn-info env vn)))
    (and (pair? info) (eq? (car info) 'pair))))

(define (lvn-vn-pair-car-vn env vn)
  (let ((info (lvn-vn-info env vn)))
    (if (and (pair? info) (eq? (car info) 'pair))
        (cadr info)
        #f)))

(define (lvn-vn-pair-cdr-vn env vn)
  (let ((info (lvn-vn-info env vn)))
    (if (and (pair? info) (eq? (car info) 'pair))
        (caddr info)
        #f)))

(define (lvn-invalidate-pairs env)
  (let* ((tuples (lvn-env-tuples env))
         (vns (lvn-env-vns env))
         (env1 (lvn-set-tuples env
                 (filter (lambda (entry)
                           (let ((key (car entry)))
                             (not (and (pair? key) (memq (car key) '(car cdr))))))
                         tuples)))
         (env2 (lvn-set-vns env1
                 (map (lambda (entry)
                        (let* ((vn (car entry))
                               (canon (cadr entry))
                               (info (cddr entry)))
                          (if (and (pair? info) (eq? (car info) 'pair))
                              (cons vn (cons canon '(type pair)))
                              entry)))
                      vns))))
    env2))

;;; -----------------------------------------------------------------------
;;; 2. Literal & Variable Value Evaluation
;;; -----------------------------------------------------------------------

(define (lvn-eval-const c env)
  (let* ((v (extract-const-val c))
         (key (list 'const v))
         (existing-vn (lvn-lookup-tuple env key)))
    (if existing-vn
        (list (val->ast-const v) existing-vn env)
        (let* ((alloc-res (lvn-alloc-vn env (val->ast-const v) (list 'const v)))
               (vn (car alloc-res))
               (env1 (cdr alloc-res))
               (env2 (lvn-record-tuple env1 key vn)))
          (list (val->ast-const v) vn env2)))))

(define (lvn-eval-var var env)
  (let ((entry (assq var (lvn-env-vars env))))
    (if entry
        (let* ((vn (cdr entry))
               (is-c (lvn-vn-is-const? env vn)))
          (if is-c
              ;; Constant propagation
              (list (val->ast-const (lvn-vn-const-val env vn)) vn env)
              (let ((canon-var (lvn-vn-canon-expr env vn)))
                ;; Copy propagation if canonical variable is currently in scope
                (if (and (symbol? canon-var)
                         (assq canon-var (lvn-env-vars env)))
                    (list canon-var vn env)
                    (list var vn env)))))
        ;; Unbound parameter / free variable entering scope
        (let* ((alloc-res (lvn-alloc-vn env var '()))
               (vn (car alloc-res))
               (env1 (cdr alloc-res))
               (env2 (lvn-bind-var env1 var vn)))
          (list var vn env2)))))

;;; -----------------------------------------------------------------------
;;; 3. Algebraic Simplification & Identity Normalization
;;; -----------------------------------------------------------------------

(define (lvn-try-algebraic-simplification op opt-args vn-args env)
  (let ((nargs (length opt-args)))
    (cond
      ((= nargs 2)
       (let* ((a1 (car opt-args))
              (a2 (cadr opt-args))
              (vn1 (car vn-args))
              (vn2 (cadr vn-args))
              (is-c1 (lvn-vn-is-const? env vn1))
              (c1 (if is-c1 (lvn-vn-const-val env vn1) #f))
              (is-c2 (lvn-vn-is-const? env vn2))
              (c2 (if is-c2 (lvn-vn-const-val env vn2) #f)))
         (case op
           ((+)
            (cond
              ;; (+ x 0) -> x
              ((and is-c2 (equal? c2 0))
               (list #t a1 vn1 env))
              ;; (+ 0 x) -> x
              ((and is-c1 (equal? c1 0))
               (list #t a2 vn2 env))
              (else (list #f #f #f env))))
           ((*)
            (cond
              ;; (* x 1) -> x
              ((and is-c2 (equal? c2 1))
               (list #t a1 vn1 env))
              ;; (* 1 x) -> x
              ((and is-c1 (equal? c1 1))
               (list #t a2 vn2 env))
              ;; (* x 0) -> 0
              ((and is-c2 (equal? c2 0))
               (let ((zero-res (lvn-eval-const 0 env)))
                 (list #t (car zero-res) (cadr zero-res) (caddr zero-res))))
              ;; (* 0 x) -> 0
              ((and is-c1 (equal? c1 0))
               (let ((zero-res (lvn-eval-const 0 env)))
                 (list #t (car zero-res) (cadr zero-res) (caddr zero-res))))
              (else (list #f #f #f env))))
           ((-)
            (cond
              ;; (- x 0) -> x
              ((and is-c2 (equal? c2 0))
               (list #t a1 vn1 env))
              ;; (- x x) -> 0
              ((= vn1 vn2)
               (let ((zero-res (lvn-eval-const 0 env)))
                 (list #t (car zero-res) (cadr zero-res) (caddr zero-res))))
              (else (list #f #f #f env))))
           ((= eq? eqv? char=?)
            (cond
              ;; (= x x) -> #t, (eq? x x) -> #t, (eqv? x x) -> #t
              ((and (> vn1 0) (> vn2 0) (= vn1 vn2))
               (let ((true-res (lvn-eval-const #t env)))
                 (list #t (car true-res) (cadr true-res) (caddr true-res))))
              (else (list #f #f #f env))))
           (else (list #f #f #f env)))))
      (else (list #f #f #f env)))))

;;; -----------------------------------------------------------------------
;;; 4. Immutable Pair Accessor Memoization
;;; -----------------------------------------------------------------------

(define (lvn-try-accessor-memoization op opt-args vn-args env)
  (let ((nargs (length opt-args)))
    (if (and (= nargs 1) (pure-accessor-op? op))
        (let* ((arg (car opt-args))
               (vn-p (car vn-args)))
          (if (and vn-p (> vn-p 0))
              (cond
            ;; 1. Check if vn-p is known to be constructed by (cons vn-a vn-b)
            ((lvn-vn-is-pair? env vn-p)
             (let* ((target-vn (if (eq? op 'car)
                                   (lvn-vn-pair-car-vn env vn-p)
                                   (lvn-vn-pair-cdr-vn env vn-p)))
                    (canon (lvn-vn-canon-expr env target-vn)))
               (if (and (symbol? canon) (assq canon (lvn-env-vars env)))
                   (list #t canon target-vn env)
                   (if (lvn-vn-is-const? env target-vn)
                       (list #t (val->ast-const (lvn-vn-const-val env target-vn)) target-vn env)
                       (list #t canon target-vn env)))))
            ;; 2. Check if (op vn-p) was already memoized in this basic block / scope
            (else
             (let* ((tuple-key (list op vn-p))
                    (existing-vn (lvn-lookup-tuple env tuple-key)))
               (if existing-vn
                   (let ((canon (lvn-vn-canon-expr env existing-vn)))
                     (if (and (symbol? canon) (assq canon (lvn-env-vars env)))
                         (list #t canon existing-vn env)
                         (if (lvn-vn-is-const? env existing-vn)
                             (list #t (val->ast-const (lvn-vn-const-val env existing-vn)) existing-vn env)
                             (list #t (list op arg) existing-vn env))))
                   ;; Not yet memoized: allocate fresh VN and record (op vn-p)
                   (let* ((alloc-res (lvn-alloc-vn env (list op arg) '()))
                          (new-vn (car alloc-res))
                          (env1 (cdr alloc-res))
                          (env2 (lvn-record-tuple env1 tuple-key new-vn)))
                     (list #t (list op arg) new-vn env2))))))
              (list #f #f #f env)))
        (list #f #f #f env))))

;;; -----------------------------------------------------------------------
;;; 5. Type Predicate Folding
;;; -----------------------------------------------------------------------

(define (lvn-try-predicate-folding op opt-args vn-args env)
  (let ((nargs (length opt-args)))
    (if (and (= nargs 1) (type-predicate-op? op))
        (let* ((arg (car opt-args))
               (vn-x (car vn-args))
               (tuple-key (list op vn-x))
               (existing-vn (lvn-lookup-tuple env tuple-key)))
          (cond
            ;; 1. If (op vn-x) is already recorded as #t in dominance scope
            ((and existing-vn (equal? (lvn-vn-const-val env existing-vn) #t))
             (let ((true-res (lvn-eval-const #t env)))
               (list #t (car true-res) (cadr true-res) (caddr true-res))))
            ;; 2. Check if vn-x has known constant literal
            ((lvn-vn-is-const? env vn-x)
             (let* ((v (lvn-vn-const-val env vn-x))
                    (ans (case op
                           ((fixnum? integer? number? exact? exact-integer? real? rational? complex?) (number? v))
                           ((inexact?) #f)
                           ((pair?) (pair? v))
                           ((null?) (null? v))
                           ((list?) (list? v))
                           ((boolean?) (boolean? v))
                           ((char?) (char? v))
                           ((symbol?) (symbol? v))
                           ((string?) (string? v))
                           ((zero?) (and (number? v) (= v 0)))
                           (else 'unknown))))
               (if (eq? ans 'unknown)
                   (list #f #f #f env)
                   (let ((ans-res (lvn-eval-const ans env)))
                     (list #t (car ans-res) (cadr ans-res) (caddr ans-res))))))
            ;; 3. Check if vn-x has known pair constructor
            ((lvn-vn-is-pair? env vn-x)
             (case op
               ((pair?)
                (let ((t-res (lvn-eval-const #t env)))
                  (list #t (car t-res) (cadr t-res) (caddr t-res))))
               ((null? fixnum? integer? number? boolean? char? symbol?)
                (let ((f-res (lvn-eval-const #f env)))
                  (list #t (car f-res) (cadr f-res) (caddr f-res))))
               (else (list #f #f #f env))))
            ;; 4. Check if producer was fixnum-only arithmetic or generic arithmetic
            ((let ((info (lvn-vn-info env vn-x)))
               (and (pair? info) (eq? (car info) 'type) (eq? (cadr info) 'fixnum)))
             (case op
               ((fixnum? integer? number?)
                (let ((t-res (lvn-eval-const #t env)))
                  (list #t (car t-res) (cadr t-res) (caddr t-res))))
               ((pair? null? boolean? char? symbol?)
                (let ((f-res (lvn-eval-const #f env)))
                  (list #t (car f-res) (cadr f-res) (caddr f-res))))
               (else (list #f #f #f env))))
            ((let ((info (lvn-vn-info env vn-x)))
               (and (pair? info) (eq? (car info) 'type) (eq? (cadr info) 'number)))
             (case op
               ((number?)
                (let ((t-res (lvn-eval-const #t env)))
                  (list #t (car t-res) (cadr t-res) (caddr t-res))))
               ((pair? null? boolean? char? symbol?)
                (let ((f-res (lvn-eval-const #f env)))
                  (list #t (car f-res) (cadr f-res) (caddr f-res))))
               (else (list #f #f #f env))))
            (else
             (list #f #f #f env))))
        (list #f #f #f env))))

;;; -----------------------------------------------------------------------
;;; 6. Call & Common Subexpression Elimination (CSE)
;;; -----------------------------------------------------------------------

(define (lvn-eval-call op opt-args vn-args env)
  ;; 1. Check if all args are constants -> Constant Folding via fold-const-op
  (let ((folded (if (let loop ((as opt-args))
                      (if (null? as) #t
                          (and (const? (car as)) (loop (cdr as)))))
                    (fold-const-op op opt-args)
                    #f)))
    (if folded
        (lvn-eval-const folded env)
        ;; 2. Try algebraic identities
        (let ((alg (lvn-try-algebraic-simplification op opt-args vn-args env)))
          (if (car alg)
              (cdr alg)
              ;; 3. Try accessor memoization
              (let ((acc (lvn-try-accessor-memoization op opt-args vn-args env)))
                (if (car acc)
                    (cdr acc)
                    ;; 4. Try type predicate folding
                    (let ((pred (lvn-try-predicate-folding op opt-args vn-args env)))
                      (if (car pred)
                          (cdr pred)
                          ;; 5. General CSE for pure primitives (and allocation info for cons)
                          (if (or (pure-prim? op) (eq? op 'cons))
                              (let* ((sorted-vns
                                      (if (and (commutative-op? op) (= (length vn-args) 2))
                                          (if (> (car vn-args) (cadr vn-args))
                                              (list (cadr vn-args) (car vn-args))
                                              vn-args)
                                          vn-args))
                                     (sorted-args
                                      (if (and (commutative-op? op) (= (length vn-args) 2))
                                          (if (> (car vn-args) (cadr vn-args))
                                              (list (cadr opt-args) (car opt-args))
                                              opt-args)
                                          opt-args))
                                     (tuple-key (cons op sorted-vns))
                                     (existing-vn (lvn-lookup-tuple env tuple-key)))
                                (if existing-vn
                                    (let ((canon (lvn-vn-canon-expr env existing-vn)))
                                      (if (and (symbol? canon) (assq canon (lvn-env-vars env)))
                                          (list canon existing-vn env)
                                          (if (lvn-vn-is-const? env existing-vn)
                                              (list (val->ast-const (lvn-vn-const-val env existing-vn)) existing-vn env)
                                              (list (cons op sorted-args) existing-vn env))))
                                    ;; Fresh pure tuple
                                    (let* ((ret-info
                                            (cond
                                              ((eq? op 'cons)
                                               (list 'pair (car sorted-vns) (cadr sorted-vns)))
                                              ((memq op '(fxadd1 fxsub1))
                                               (list 'type 'fixnum))
                                              ((memq op '(+ - * modulo quotient))
                                               (list 'type 'number))
                                              (else '())))
                                           (alloc-res (lvn-alloc-vn env (cons op sorted-args) ret-info))
                                           (new-vn (car alloc-res))
                                           (env1 (cdr alloc-res))
                                           (env2 (if (eq? op 'cons)
                                                     env1
                                                     (lvn-record-tuple env1 tuple-key new-vn))))
                                      (list (cons op sorted-args) new-vn env2))))
                              ;; Non-pure or side-effecting call
                              (let* ((env1 (if (or (memq op '(set-car! set-cdr!))
                                                   (not (pure-prim? op)))
                                               (lvn-invalidate-pairs env)
                                               env))
                                     (alloc-res (lvn-alloc-vn env1 (cons op opt-args) '()))
                                     (new-vn (car alloc-res))
                                     (env2 (cdr alloc-res)))
                                (list (cons op opt-args) new-vn env2))))))))))))

;;; -----------------------------------------------------------------------
;;; 7. Core Recursive Evaluator (lvn-eval)
;;; -----------------------------------------------------------------------
;;; Returns (list optimized-ast vn updated-env)

(define (lvn-eval expr env)
  (cond
    ((const? expr)
     (lvn-eval-const expr env))
    ((symbol? expr)
     (lvn-eval-var expr env))
    ((pair? expr)
     (let ((op (car expr)))
       (case op
         ((quote)
          (lvn-eval-const expr env))
         ((if)
          (let* ((test-res (lvn-eval (cadr expr) env))
                 (opt-test (car test-res))
                 (vn-test (cadr test-res))
                 (env-test (caddr test-res)))
            (cond
              ;; Constant condition pruning
              ((const? opt-test)
               (if (eq? (extract-const-val opt-test) #f)
                   (if (null? (cdddr expr))
                       (list #f vn-test env-test)
                       (lvn-eval (cadddr expr) env-test))
                   (lvn-eval (caddr expr) env-test)))
              (else
               ;; Branch-specialized dominance environment
               (let* ((then-env
                       (if (and (pair? opt-test) (type-predicate-op? (car opt-test)) (pair? (cdr opt-test)))
                           (let ((arg-entry (assq (cadr opt-test) (lvn-env-vars env-test))))
                             (if arg-entry
                                 (let* ((t-vn (cadr (lvn-eval-const #t env-test)))
                                        (e1 (lvn-record-tuple env-test (list (car opt-test) (cdr arg-entry)) t-vn)))
                                   (if (eq? (car opt-test) 'fixnum?)
                                       (let ((vns (cons (cons (cdr arg-entry) (cons (cadr opt-test) (list 'type 'fixnum)))
                                                        (filter (lambda (e) (not (eq? (car e) (cdr arg-entry))))
                                                                (lvn-env-vns e1)))))
                                         (lvn-set-vns e1 vns))
                                       e1))
                                 env-test))
                           env-test))
                      (then-res (lvn-eval (caddr expr) then-env))
                      (opt-then (car then-res))
                      (else-res (if (null? (cdddr expr))
                                    (list #f (cadr then-res) env-test)
                                    (lvn-eval (cadddr expr) env-test)))
                      (opt-else (car else-res))
                      (alloc-res (lvn-alloc-vn env-test (list 'if opt-test opt-then opt-else) '()))
                      (new-vn (car alloc-res))
                      (new-env (cdr alloc-res)))
                 (list (list 'if opt-test opt-then opt-else) new-vn new-env))))))
         ((let)
          (let ((bindings (cadr expr))
                (body (caddr expr)))
            (cond
              ((null? bindings)
               (lvn-eval body env))
              ((= (length bindings) 1)
               (let* ((var (caar bindings))
                      (val (cadar bindings))
                      (val-res (lvn-eval val env))
                      (opt-val (car val-res))
                      (vn-val (cadr val-res))
                      (env-val (caddr val-res))
                      ;; Bind variable to vn-val
                      (env-body (lvn-bind-var env-val var vn-val))
                      (body-res (lvn-eval body env-body))
                      (opt-body (car body-res))
                      (vn-body (cadr body-res))
                      (orig-vars (lvn-env-vars env-val))
                      ;; Dead let elimination: pure binding whose var is unused in body
                      (dead? (and (atomic-expr? opt-val)
                                  (not (tree-contains? opt-body var)))))
                 (if dead?
                     (list opt-body vn-body (lvn-set-vars (caddr body-res) orig-vars))
                     (list (list 'let (list (list var opt-val)) opt-body)
                           vn-body
                           (lvn-set-vars (caddr body-res) orig-vars)))))
              (else
               ;; Multi-binding let: expand into nested single-binding lets
               (let ((nested-let
                      (let loop ((bs bindings))
                        (if (null? bs)
                            body
                            (list 'let (list (car bs)) (loop (cdr bs)))))))
                 (lvn-eval nested-let env))))))
         ((letrec)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (opt-bindings
                  (map (lambda (b)
                         (list (car b) (lvn-expr (cadr b) (make-lvn-env))))
                       bindings))
                 (opt-body (lvn-expr body (make-lvn-env)))
                 (alloc-res (lvn-alloc-vn env (list 'letrec opt-bindings opt-body) '())))
            (list (list 'letrec opt-bindings opt-body) (car alloc-res) (cdr alloc-res))))
         ((lambda)
          (let* ((params (cadr expr))
                 (body (caddr expr))
                 (child-env (let loop ((ps params) (cur-env (make-lvn-env)))
                              (cond
                                ((null? ps) cur-env)
                                ((symbol? ps)
                                 (let* ((alloc (lvn-alloc-vn cur-env ps '()))
                                        (vn (car alloc))
                                        (e1 (cdr alloc)))
                                   (lvn-bind-var e1 ps vn)))
                                (else
                                 (let* ((p (car ps))
                                        (alloc (lvn-alloc-vn cur-env p '()))
                                        (vn (car alloc))
                                        (e1 (cdr alloc))
                                        (e2 (lvn-bind-var e1 p vn)))
                                   (loop (cdr ps) e2))))))
                 (body-res (lvn-eval body child-env))
                 (opt-body (car body-res))
                 (alloc-lam (lvn-alloc-vn env 'lambda-closure '()))
                 (lam-vn (car alloc-lam))
                 (env-lam (cdr alloc-lam)))
            (list (list 'lambda params opt-body) lam-vn env-lam)))
         ((begin)
          (let loop ((es (cdr expr)) (cur-env env) (acc '()))
            (if (null? es)
                (cond
                  ((null? acc) (list #f 0 cur-env))
                  ((null? (cdr acc)) (list (car acc) 0 cur-env))
                  (else (list (cons 'begin acc) 0 cur-env)))
                (let* ((res (lvn-eval (car es) cur-env))
                       (opt-e (car res))
                       (next-env (caddr res)))
                  (loop (cdr es) next-env (append acc (list opt-e)))))))
         ((%make-closure %make-closure-env)
          (let* ((label (cadr expr))
                 (env-args (cddr expr))
                 (evaluated-args
                  (let loop ((as env-args) (cur-env env) (opt-acc '()) (vn-acc '()))
                    (if (null? as)
                        (list (reverse opt-acc) (reverse vn-acc) cur-env)
                        (let ((res (lvn-eval (car as) cur-env)))
                          (loop (cdr as)
                                (caddr res)
                                (cons (car res) opt-acc)
                                (cons (cadr res) vn-acc))))))
                 (opt-env-args (car evaluated-args))
                 (res-env (caddr evaluated-args))
                 (alloc-res (lvn-alloc-vn res-env (car expr) '())))
            (list (cons (car expr) (cons label opt-env-args))
                  (car alloc-res)
                  (cdr alloc-res))))
         (else
          ;; Primitive or function application: (op arg1 arg2 ...)
          (let* ((opt-op (if (symbol? op) op (car (lvn-eval op env))))
                 (args (cdr expr))
                 (evaluated-args
                  (let loop ((as args) (cur-env env) (opt-acc '()) (vn-acc '()))
                    (if (null? as)
                        (list (reverse opt-acc) (reverse vn-acc) cur-env)
                        (let ((res (lvn-eval (car as) cur-env)))
                          (loop (cdr as)
                                (caddr res)
                                (cons (car res) opt-acc)
                                (cons (cadr res) vn-acc))))))
                 (opt-args (car evaluated-args))
                 (vn-args (cadr evaluated-args))
                 (cur-env (caddr evaluated-args)))
            (if (symbol? opt-op)
                (lvn-eval-call opt-op opt-args vn-args cur-env)
                (let* ((call-expr (cons opt-op opt-args))
                       (alloc-res (lvn-alloc-vn cur-env call-expr '())))
                  (list call-expr (car alloc-res) (cdr alloc-res)))))))))
    (else
     (list expr 0 env))))

(define (lvn-expr expr env)
  (car (lvn-eval expr env)))

;;; -----------------------------------------------------------------------
;;; 8. Top-level Pass Entrypoint: lvn-all
;;; -----------------------------------------------------------------------

(define (lvn-all form)
  (cond
    ((not (pair? form)) form)
    ((eq? (car form) '%program)
     (let ((defs (cadr form))
           (main (caddr form)))
       (list '%program
             (map (lambda (d)
                    (if (and (pair? d) (eq? (car d) 'define))
                        (list 'define (cadr d) (lvn-expr (caddr d) (make-lvn-env)))
                        (lvn-expr d (make-lvn-env))))
                  defs)
             (lvn-expr main (make-lvn-env)))))
    ((eq? (car form) 'define)
     (list 'define (cadr form) (lvn-expr (caddr form) (make-lvn-env))))
    (else
     (lvn-expr form (make-lvn-env)))))
;;; =======================================================================
;;; ULisp Compiler Pass 4: ANF (A-Normal Form) Normalization Nanopass
;;; Conforms to DSN-33 Architecture Specification
;;; Note: Normalizes complex expressions so that all function/primitive
;;;       arguments are atomic (symbols or immediate constants).
;;;       Uses a scoped temporary variable pool (%t0..%t8) to eliminate
;;;       string->symbol heap allocation overhead during bootstrap.
;;; =======================================================================

;;; Fixed pool of temporary variables by nesting depth (Zero heap allocation for depth < 64)
(define (%t-var depth)
  (case depth
    ((0) '%t0)   ((1) '%t1)   ((2) '%t2)   ((3) '%t3)
    ((4) '%t4)   ((5) '%t5)   ((6) '%t6)   ((7) '%t7)
    ((8) '%t8)   ((9) '%t9)   ((10) '%t10) ((11) '%t11)
    ((12) '%t12) ((13) '%t13) ((14) '%t14) ((15) '%t15)
    ((16) '%t16) ((17) '%t17) ((18) '%t18) ((19) '%t19)
    ((20) '%t20) ((21) '%t21) ((22) '%t22) ((23) '%t23)
    ((24) '%t24) ((25) '%t25) ((26) '%t26) ((27) '%t27)
    ((28) '%t28) ((29) '%t29) ((30) '%t30) ((31) '%t31)
    ((32) '%t32) ((33) '%t33) ((34) '%t34) ((35) '%t35)
    ((36) '%t36) ((37) '%t37) ((38) '%t38) ((39) '%t39)
    ((40) '%t40) ((41) '%t41) ((42) '%t42) ((43) '%t43)
    ((44) '%t44) ((45) '%t45) ((46) '%t46) ((47) '%t47)
    ((48) '%t48) ((49) '%t49) ((50) '%t50) ((51) '%t51)
    ((52) '%t52) ((53) '%t53) ((54) '%t54) ((55) '%t55)
    ((56) '%t56) ((57) '%t57) ((58) '%t58) ((59) '%t59)
    ((60) '%t60) ((61) '%t61) ((62) '%t62) ((63) '%t63)
    (else (string->symbol (string-append "__anf_t_" (number->string depth))))))

;;; Collects bindings for non-atomic expressions among a list of arguments.
;;; Returns a pair (bindings . atomic-args).
(define (anf-flatten-args args depth)
  (let loop ((rest args) (d depth) (bindings '()) (atom-args '()))
    (if (null? rest)
        (cons (reverse bindings) (reverse atom-args))
        (let ((arg (car rest)))
          (if (atomic-expr? arg)
              (loop (cdr rest) d bindings (cons arg atom-args))
              (let* ((flat-arg (anf-expr-depth arg (+ d 1)))
                     (tmp (%t-var d)))
                (loop (cdr rest)
                      (+ d 1)
                      (cons (list tmp flat-arg) bindings)
                      (cons tmp atom-args))))))))

;;; Wraps an expression with let-bindings if any exist
(define (anf-wrap-bindings bindings body)
  (if (null? bindings)
      body
      (list 'let bindings body)))

;;; Recursively normalizes an arbitrary expression into A-Normal Form with nesting depth tracking
(define (anf-expr-depth expr depth)
  (cond
    ((atomic-expr? expr) expr)
    ((pair? expr)
     (let ((op (car expr)))
       (case op
         ((quote) expr)
         ((if)
          (let ((test (cadr expr))
                (then (caddr expr))
                (else-val (if (null? (cdddr expr)) #f (cadddr expr))))
            (if (atomic-expr? test)
                (list 'if test (anf-expr-depth then depth) (anf-expr-depth else-val depth))
                (let* ((flat-test (anf-expr-depth test (+ depth 1)))
                       (tmp (%t-var depth)))
                  (list 'let (list (list tmp flat-test))
                        (list 'if tmp (anf-expr-depth then depth) (anf-expr-depth else-val depth)))))))
         ((begin)
          (let ((body (cdr expr)))
            (cond
              ((null? body) #f)
              ((null? (cdr body)) (anf-expr-depth (car body) depth))
              (else (cons 'begin (map (lambda (e) (anf-expr-depth e depth)) body))))))
         ((let)
          (let ((bindings (cadr expr))
                (body (caddr expr)))
            (list 'let
                  (map (lambda (b) (list (car b) (anf-expr-depth (cadr b) depth))) bindings)
                  (anf-expr-depth body depth))))
         ((letrec)
          (let ((bindings (cadr expr))
                (body (caddr expr)))
            (list 'letrec
                  (map (lambda (b) (list (car b) (anf-expr-depth (cadr b) depth))) bindings)
                  (anf-expr-depth body depth))))
         ((lambda)
          (let ((params (cadr expr))
                (body (caddr expr)))
            (list 'lambda params (anf-expr-depth body 0))))
         ((%make-closure %make-closure-env)
          (let* ((op-tag (car expr))
                 (label (cadr expr))
                 (env-args (cddr expr))
                 (res (anf-flatten-args env-args depth))
                 (bindings (car res))
                 (atom-env (cdr res)))
            (anf-wrap-bindings bindings (cons op-tag (cons label atom-env)))))
         ((%with-handler %call-with-values %values %raw-call/cc)
          (let* ((res (anf-flatten-args (cdr expr) depth))
                 (bindings (car res))
                 (atom-args (cdr res)))
            (anf-wrap-bindings bindings (cons (car expr) atom-args))))
         (else
          ;; Primitive or function application: (op e1 e2 ...)
          (let* ((args-res (anf-flatten-args (cdr expr) depth))
                 (args-bindings (car args-res))
                 (atom-args (cdr args-res))
                 (flat-op (if (atomic-expr? op) op (anf-expr-depth op (+ depth (length args-bindings)))))
                 (call (cons flat-op atom-args)))
            (anf-wrap-bindings args-bindings call))))))
    (else expr)))

;;; Top-level entrypoint for ANF normalization
(define (anf-all form)
  (let ((res
         (cond
           ((not (pair? form)) form)
           ((eq? (car form) '%program)
            (let ((defs (cadr form))
                  (main (caddr form)))
              (list '%program
                    (map (lambda (d)
                           (if (and (pair? d) (eq? (car d) 'define))
                               (if (pair? (cadr d))
                                   (list 'define (caadr d) (anf-expr-depth (cons 'lambda (cons (cdadr d) (cddr d))) 0))
                                   (list 'define (cadr d) (anf-expr-depth (caddr d) 0)))
                               (anf-expr-depth d 0)))
                         defs)
                    (anf-expr-depth main 0))))
           ((eq? (car form) 'define)
            (if (pair? (cadr form))
                (list 'define (caadr form) (anf-expr-depth (cons 'lambda (cons (cdadr form) (cddr form))) 0))
                (list 'define (cadr form) (anf-expr-depth (caddr form) 0))))
           (else
            (anf-expr-depth form 0)))))
    (if (and (verifier-enabled?) (assq 'L_anf (nanopass-get-languages)))
        (if (not (nanopass-ast-valid? 'L_anf res))
            (verifier-error 'anf "Pass 070 output violates L_anf schema invariants" res)))
    res))
;;; =======================================================================
;;; ULisp Compiler Pass 4b: S-Annotator (Abstract Interpretation Type Inference)
;;; Conforms to DSN-33 Architecture Specification & Issue #517
;;; Note: Performs abstract interpretation on ANF-normalized Scheme AST.
;;;       Infers types and range intervals using a monotone lattice (LUB),
;;;       populates type annotations, and supports R-Scheme type checking.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Type Lattice Constructors & Predicates
;;; -----------------------------------------------------------------------

(define (type-bot) 'bot)
(define (type-top) 'top)
(define (type-fixnum) 'fixnum)
(define (type-fixnum-range min-val max-val) (list 'fixnum min-val max-val))
(define (type-boolean) 'boolean)
(define (type-pair car-t cdr-t) (list 'pair car-t cdr-t))
(define (type-null) 'null)
(define (type-string) 'string)
(define (type-symbol) 'symbol)
(define (type-char) 'char)
(define (type-closure id arg-types ret-type) (list 'closure id arg-types ret-type))

(define (type-bot? t) (eq? t 'bot))
(define (type-top? t) (eq? t 'top))
(define (type-fixnum? t)
  (or (eq? t 'fixnum)
      (and (pair? t) (eq? (car t) 'fixnum))))
(define (type-has-range? t)
  (and (pair? t) (eq? (car t) 'fixnum) (= (length t) 3)))
(define (type-range-min t) (cadr t))
(define (type-range-max t) (caddr t))

(define (type-boolean? t) (eq? t 'boolean))
(define (type-pair? t) (and (pair? t) (eq? (car t) 'pair)))
(define (type-pair-car t) (if (type-pair? t) (cadr t) (type-top)))
(define (type-pair-cdr t) (if (type-pair? t) (caddr t) (type-top)))

(define (type-null? t) (eq? t 'null))
(define (type-string? t) (eq? t 'string))
(define (type-symbol? t) (eq? t 'symbol))
(define (type-char? t) (eq? t 'char))
(define (type-closure? t) (and (pair? t) (eq? (car t) 'closure)))

(define (temp-var? sym)
  (and (symbol? sym)
       (let ((str (symbol->string sym)))
         (and (> (string-length str) 1)
              (char=? (string-ref str 0) #\%)
              (char=? (string-ref str 1) #\t)))))

;;; -----------------------------------------------------------------------
;;; 2. Lattice Join (Least Upper Bound: LUB, \sqcup) & Meet (GLB, \sqcap)
;;; -----------------------------------------------------------------------

(define (type-equal? t1 t2)
  (cond
    ((and (symbol? t1) (symbol? t2)) (eq? t1 t2))
    ((and (number? t1) (number? t2)) (= t1 t2))
    ((and (boolean? t1) (boolean? t2)) (eq? t1 t2))
    ((and (null? t1) (null? t2)) #t)
    ((and (pair? t1) (pair? t2))
     (and (type-equal? (car t1) (car t2))
          (type-equal? (cdr t1) (cdr t2))))
    (else (eq? t1 t2))))

(define (type-lub t1 t2)
  (cond
    ((type-bot? t1) t2)
    ((type-bot? t2) t1)
    ((type-top? t1) (type-top))
    ((type-top? t2) (type-top))
    ((type-equal? t1 t2) t1)
    ;; Range & Fixnum unification
    ((and (type-fixnum? t1) (type-fixnum? t2))
     (if (and (type-has-range? t1) (type-has-range? t2))
         (let ((min1 (type-range-min t1))
               (max1 (type-range-max t1))
               (min2 (type-range-min t2))
               (max2 (type-range-max t2)))
           (type-fixnum-range (if (< min1 min2) min1 min2)
                              (if (> max1 max2) max1 max2)))
         (type-fixnum)))
    ;; Pair unification
    ((and (type-pair? t1) (type-pair? t2))
     (type-pair (type-lub (type-pair-car t1) (type-pair-car t2))
                (type-lub (type-pair-cdr t1) (type-pair-cdr t2))))
    ;; List-like: Pair and Null join to Pair(top, top) or Top
    ((and (or (type-pair? t1) (type-null? t1))
          (or (type-pair? t2) (type-null? t2)))
     (type-top))
    ;; Disjoint types join to Top (dynamic / any)
    (else (type-top))))

(define (type-meet t1 t2)
  (cond
    ((type-bot? t1) (type-bot))
    ((type-bot? t2) (type-bot))
    ((type-top? t1) t2)
    ((type-top? t2) t1)
    ((type-equal? t1 t2) t1)
    ;; Range & Fixnum meet
    ((and (type-fixnum? t1) (type-fixnum? t2))
     (cond
       ((and (type-has-range? t1) (type-has-range? t2))
        (let* ((min1 (type-range-min t1))
               (max1 (type-range-max t1))
               (min2 (type-range-min t2))
               (max2 (type-range-max t2))
               (new-min (if (> min1 min2) min1 min2))
               (new-max (if (< max1 max2) max1 max2)))
          (if (> new-min new-max)
              (type-bot)
              (type-fixnum-range new-min new-max))))
       ((type-has-range? t1) t1)
       ((type-has-range? t2) t2)
       (else (type-fixnum))))
    ;; Pair meet
    ((and (type-pair? t1) (type-pair? t2))
     (let ((car-m (type-meet (type-pair-car t1) (type-pair-car t2)))
           (cdr-m (type-meet (type-pair-cdr t1) (type-pair-cdr t2))))
       (if (or (type-bot? car-m) (type-bot? cdr-m))
           (type-bot)
           (type-pair car-m cdr-m))))
    ;; Disjoint types meet to Bottom
    (else (type-bot))))

;;; -----------------------------------------------------------------------
;;; 3. Type Environment Management & Predicate Extraction
;;; -----------------------------------------------------------------------

(define (type-env-lookup var env)
  (let ((entry (assq var env)))
    (if entry
        (cdr entry)
        (type-top))))

(define (type-env-lookup-fact var env)
  (let loop ((rest env))
    (cond
      ((null? rest) #f)
      ((and (pair? (car rest))
            (pair? (caar rest))
            (eq? (car (caar rest)) '%fact)
            (eq? (cdr (caar rest)) var))
       (cdar rest))
      (else (loop (cdr rest))))))

(define (type-env-extend var type env)
  (cons (cons var type) env))

(define (type-env-extend-with-fact var type fact env)
  (cons (cons (cons '%fact var) fact)
        (cons (cons var type) env)))

(define (type-env-extend-multi vars types env)
  (if (or (null? vars) (null? types))
      env
      (cons (cons (car vars) (car types))
            (type-env-extend-multi (cdr vars) (cdr types) env))))

(define (type-env-merge env1 env2)
  (let loop ((rest env1) (acc '()))
    (if (null? rest)
        acc
        (let* ((var (caar rest))
               (t1 (type-env-lookup var env1))
               (t2 (type-env-lookup var env2)))
          (loop (cdr rest) (cons (cons var (type-lub t1 t2)) acc))))))

(define (predicate-op? op)
  (memq op '(fixnum? integer? number? pair? boolean? null? symbol? string? char? procedure? zero? = < <= > >= not)))

(define (extract-predicate-narrowing test env)
  (cond
    ;; Variable lookup: check if variable was bound to a predicate fact in ANF let
    ((symbol? test)
     (let ((fact (type-env-lookup-fact test env)))
       (if fact
           (extract-predicate-narrowing fact env)
           (cons #f #f))))
    ((not (pair? test))
     (cons #f #f))
    (else
     (let ((op (car test)))
       (cond
         ((memq op '(fixnum? integer? number?))
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-fixnum))
                      (cons var (if (type-fixnum? (type-env-lookup var env)) (type-bot) (type-env-lookup var env)))))
              (cons #f #f)))
         ((eq? op 'pair?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-pair (type-top) (type-top)))
                      (cons var (if (type-pair? (type-env-lookup var env)) (type-bot) (type-env-lookup var env)))))
              (cons #f #f)))
         ((eq? op 'boolean?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-boolean))
                      (cons var (if (type-boolean? (type-env-lookup var env)) (type-bot) (type-env-lookup var env)))))
              (cons #f #f)))
         ((eq? op 'null?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-null))
                      (cons var (if (type-null? (type-env-lookup var env)) (type-bot) (type-env-lookup var env)))))
              (cons #f #f)))
         ((eq? op 'symbol?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-symbol))
                      (cons var (if (type-symbol? (type-env-lookup var env)) (type-bot) (type-env-lookup var env)))))
              (cons #f #f)))
         ((eq? op 'string?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-string))
                      (cons var (if (type-string? (type-env-lookup var env)) (type-bot) (type-env-lookup var env)))))
              (cons #f #f)))
         ((eq? op 'char?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-char))
                      (cons var (if (type-char? (type-env-lookup var env)) (type-bot) (type-env-lookup var env)))))
              (cons #f #f)))
         ((eq? op 'procedure?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-closure 'any '() (type-top)))
                      (cons var (type-env-lookup var env))))
              (cons #f #f)))
         ((eq? op 'zero?)
          (if (and (pair? (cdr test)) (symbol? (cadr test)))
              (let ((var (cadr test)))
                (cons (cons var (type-fixnum-range 0 0))
                      (cons var (type-env-lookup var env))))
              (cons #f #f)))
         ((eq? op '=)
          (cond
            ((and (pair? (cdr test)) (pair? (cddr test))
                  (symbol? (cadr test)) (number? (caddr test)))
             (let ((var (cadr test)) (n (caddr test)))
               (cons (cons var (type-fixnum-range n n))
                     (cons var (type-env-lookup var env)))))
            ((and (pair? (cdr test)) (pair? (cddr test))
                  (number? (cadr test)) (symbol? (caddr test)))
             (let ((var (caddr test)) (n (cadr test)))
               (cons (cons var (type-fixnum-range n n))
                     (cons var (type-env-lookup var env)))))
            (else (cons #f #f))))
         ((eq? op 'not)
          (if (pair? (cdr test))
              (let ((sub (extract-predicate-narrowing (cadr test) env)))
                (cons (cdr sub) (car sub)))
              (cons #f #f)))
         (else (cons #f #f)))))))

(define (narrow-var-in-branch var test branch-then? env)
  (let* ((narrowing (extract-predicate-narrowing test env))
         (info (if branch-then? (car narrowing) (cdr narrowing))))
    (if (and (pair? info) (eq? (car info) var))
        (type-meet (type-env-lookup var env) (cdr info))
        (type-env-lookup var env))))

;;; Global Type Tables for Whole-Program Traceability (256-slot hash buckets)
(define *annotator-bucket-count* 256)
(define *global-type-env* (make-vector 256 '()))
(define *expr-type-table* (make-vector 256 '()))

(define (annotator-bucket-idx sym)
  (modulo (symbol->hash-idx sym) *annotator-bucket-count*))

(define (reset-type-annotations!)
  (let loop ((i 0))
    (if (< i *annotator-bucket-count*)
        (begin
          (vector-set! *global-type-env* i '())
          (vector-set! *expr-type-table* i '())
          (loop (+ i 1))))))

(define (record-var-type! var type)
  (let ((idx (annotator-bucket-idx var)))
    (vector-set! *global-type-env* idx
                 (cons (cons var type) (vector-ref *global-type-env* idx)))))

(define (get-var-type var)
  (type-env-lookup var (vector-ref *global-type-env* (annotator-bucket-idx var))))

(define (record-expr-type! expr-id type)
  (let ((idx (annotator-bucket-idx expr-id)))
    (vector-set! *expr-type-table* idx
                 (cons (cons expr-id type) (vector-ref *expr-type-table* idx)))))

(define (get-expr-type expr-id)
  (type-env-lookup expr-id (vector-ref *expr-type-table* (annotator-bucket-idx expr-id))))

;;; -----------------------------------------------------------------------
;;; 4. Abstract Evaluation Engine for ANF Expressions
;;; -----------------------------------------------------------------------

;;; Arithmetic abstract transfer functions
(define (abstract-eval-arith op t1 t2)
  (if (and (type-fixnum? t1) (type-fixnum? t2))
      (if (and (type-has-range? t1) (type-has-range? t2))
          (let ((min1 (type-range-min t1))
                (max1 (type-range-max t1))
                (min2 (type-range-min t2))
                (max2 (type-range-max t2)))
            (if (and (integer? min1) (<= min1 536870911) (>= min1 -536870911)
                     (integer? max1) (<= max1 536870911) (>= max1 -536870911)
                     (integer? min2) (<= min2 536870911) (>= min2 -536870911)
                     (integer? max2) (<= max2 536870911) (>= max2 -536870911))
                (case op
                  ((+) (type-fixnum-range (+ min1 min2) (+ max1 max2)))
                  ((-) (type-fixnum-range (- min1 max2) (- max1 min2)))
                  ((*) (type-fixnum))
                  (else (type-fixnum)))
                (type-fixnum)))
          (type-fixnum))
      (type-fixnum)))

;;; Primitive procedure abstract evaluation
(define (abstract-eval-prim op arg-types)
  (cond
    ;; Arithmetic
    ((memq op '(+ - * modulo quotient / bitwise-and bitwise-ior bitwise-arithmetic-shift))
     (let ((t1 (if (pair? arg-types) (car arg-types) (type-top)))
           (t2 (if (and (pair? arg-types) (pair? (cdr arg-types))) (cadr arg-types) (type-top))))
       (abstract-eval-arith op t1 t2)))
    ((memq op '(fxadd1 fxsub1 %to-raw %to-fixnum))
     (type-fixnum))
    ;; Predicates -> Boolean
    ((memq op '(= < <= > >= eq? eqv? char=? boolean=? symbol=? zero? fixnum? integer? number? exact? exact-integer? inexact? real? rational? complex? boolean? char? null? not symbol? pair? procedure? string? list? eof-object?))
     (type-boolean))
    ;; Data structure primitives
    ((eq? op 'cons)
     (let ((t1 (if (pair? arg-types) (car arg-types) (type-top)))
           (t2 (if (and (pair? arg-types) (pair? (cdr arg-types))) (cadr arg-types) (type-top))))
       (type-pair t1 t2)))
    ((eq? op 'car)
     (let ((t (if (pair? arg-types) (car arg-types) (type-top))))
       (type-pair-car t)))
    ((eq? op 'cdr)
     (let ((t (if (pair? arg-types) (car arg-types) (type-top))))
       (type-pair-cdr t)))
    ((memq op '(string-length bytevector-length bytevector-u8-ref vector-length %num-args))
     (type-fixnum))
    ((memq op '(bytevector? vector?))
     (type-boolean))
    ((memq op '(make-string string-ref))
     (if (eq? op 'make-string) (type-string) (type-char)))
    ((memq op '(%get-rsp %get-heap-ptr %get-gc-state-ptr %get-environ-ptr %get-initial-heap-ptr %get-initial-heap sys-initial-heap %raw-load %raw-load-u8 %ptr-add %ptr-tag-add))
     (type-fixnum))
    (else (type-top))))

;;; Abstract evaluation of arbitrary ANF expression
(define (abstract-eval-expr expr env)
  (cond
    ;; Integer literal
    ((number? expr)
     (type-fixnum-range expr expr))
    ;; Boolean literal
    ((boolean? expr)
     (type-boolean))
    ;; Char literal
    ((char? expr)
     (type-char))
    ;; String literal
    ((string? expr)
     (type-string))
    ;; Null literal
    ((null? expr)
     (type-null))
    ;; Symbol lookup
    ((symbol? expr)
     (type-env-lookup expr env))
    ;; Quoted constant
    ((and (pair? expr) (eq? (car expr) 'quote))
     (let ((datum (cadr expr)))
       (cond
         ((number? datum) (type-fixnum-range datum datum))
         ((boolean? datum) (type-boolean))
         ((char? datum) (type-char))
         ((string? datum) (type-string))
         ((null? datum) (type-null))
         ((symbol? datum) (type-symbol))
         ((pair? datum) (type-pair (type-top) (type-top)))
         (else (type-top)))))
    ;; Compound ANF forms
    ((pair? expr)
     (let ((op (car expr)))
       (case op
         ;; Conditional branching with flow-sensitive narrowing
         ((if)
          (let* ((test-expr (cadr expr))
                 (narrowing (extract-predicate-narrowing test-expr env))
                 (then-narrow (car narrowing))
                 (else-narrow (cdr narrowing))
                 (then-env (if (pair? then-narrow)
                               (let* ((var (car then-narrow))
                                      (curr-t (type-env-lookup var env))
                                      (new-t (type-meet curr-t (cdr then-narrow))))
                                 (type-env-extend var new-t env))
                               env))
                 (else-env (if (pair? else-narrow)
                               (let* ((var (car else-narrow))
                                      (curr-t (type-env-lookup var env))
                                      (new-t (type-meet curr-t (cdr else-narrow))))
                                 (type-env-extend var new-t env))
                               env))
                 (then-t (abstract-eval-expr (caddr expr) then-env))
                 (else-t (if (null? (cdddr expr))
                             (type-boolean)
                             (abstract-eval-expr (cadddr expr) else-env))))
            (type-lub then-t else-t)))
         ;; Sequential execution
         ((begin)
          (let loop ((rest (cdr expr)) (last-t (type-top)))
            (if (null? rest)
                last-t
                (loop (cdr rest) (abstract-eval-expr (car rest) env)))))
         ;; Local let bindings
         ((let)
          (if (symbol? (cadr expr))
              ;; Named let (loop): Fixpoint iteration
              (abstract-eval-named-let (cadr expr) (caddr expr) (cdddr expr) env)
              ;; Standard let
              (let* ((bindings (cadr expr))
                     (body (cddr expr))
                     (new-env (let bind-loop ((bs bindings) (e env))
                                (if (null? bs)
                                    e
                                    (let* ((b (car bs))
                                           (var (car b))
                                           (rhs (cadr b))
                                           (val-t (abstract-eval-expr rhs env))
                                           (fact (if (and (pair? rhs) (predicate-op? (car rhs)))
                                                     rhs
                                                     #f)))
                                      (if (not (temp-var? var))
                                          (record-var-type! var val-t))
                                      (bind-loop (cdr bs)
                                                 (if fact
                                                     (type-env-extend-with-fact var val-t fact e)
                                                     (type-env-extend var val-t e))))))))
                (let body-loop ((rest body) (last-t (type-top)))
                  (if (null? rest)
                      last-t
                      (body-loop (cdr rest) (abstract-eval-expr (car rest) new-env)))))))
         ;; Mutual recursion (letrec)
         ((letrec)
          (let* ((bindings (cadr expr))
                 (body-expr (if (null? (cddr expr)) #f (caddr expr)))
                 (init-call-args
                  (if (and (= (length bindings) 1)
                           (let* ((b (car bindings))
                                  (val (cadr b)))
                             (and (pair? val) (eq? (car val) 'lambda))))
                      (extract-initial-call-args (caar bindings) body-expr)
                      #f)))
            (if (and init-call-args
                     (let* ((b (car bindings))
                            (val (cadr b))
                            (params (cadr val)))
                       (and (= (length init-call-args) (length params))
                            (let check-nums ((is init-call-args))
                              (if (null? is) #t
                                  (let ((arg-t (abstract-eval-expr (car is) env)))
                                    (if (or (number? (car is)) (type-fixnum? arg-t))
                                        (check-nums (cdr is))
                                        #f)))))))
                ;; Desugared named-let loop or single recursive numeric function
                (let* ((b (car bindings))
                       (fn-name (car b))
                       (fn-val (cadr b))
                       (params (cadr fn-val))
                       (lbodies (cddr fn-val))
                       (inits init-call-args)
                       (named-bindings (let make-bs ((ps params) (is inits) (acc '()))
                                         (if (or (null? ps) (null? is))
                                             (reverse acc)
                                             (make-bs (cdr ps) (cdr is) (cons (list (car ps) (car is)) acc)))))
                       (fn-ret-t (abstract-eval-named-let fn-name named-bindings lbodies env)))
                  (if (and (pair? body-expr) (eq? (car body-expr) fn-name))
                      fn-ret-t
                      (let ((ext-env (type-env-extend fn-name (type-closure fn-name params fn-ret-t) env))
                            (body (cddr expr)))
                        (let body-loop ((rest body) (last-t (type-top)))
                          (if (null? rest)
                              last-t
                              (body-loop (cdr rest) (abstract-eval-expr (car rest) ext-env)))))))
                ;; General letrec
                (let* ((body (cddr expr))
                       (new-env (let bind-loop ((bs bindings) (e env))
                                  (if (null? bs)
                                      e
                                      (let ((var (caar bs)))
                                        (bind-loop (cdr bs) (type-env-extend var (type-top) e)))))))
                  (let body-loop ((rest body) (last-t (type-top)))
                    (if (null? rest)
                        last-t
                        (body-loop (cdr rest) (abstract-eval-expr (car rest) new-env))))))))
         ;; Lambda abstraction
         ((lambda)
          (let ((params (cadr expr)))
            (type-closure (unique-label-sym "lam") params (type-top))))
         ((%with-handler %call-with-values %values %raw-call/cc)
          (type-top))
         ;; Procedure call or primitive
         (else
          (let ((arg-types (map (lambda (a) (abstract-eval-expr a env)) (cdr expr))))
            (if (or (unary-prim? op) (binop-prim? op) (triop-prim? op) (zero-arg-prim? op) (septop-prim? op))
                (abstract-eval-prim op arg-types)
                (let ((fn-t (abstract-eval-expr op env)))
                  (if (type-closure? fn-t)
                      (cadddr fn-t)
                      (type-top)))))))))
    (else (type-top))))

;;; -----------------------------------------------------------------------
;;; 5. Named-let & Loop Fixpoint Iteration
;;; -----------------------------------------------------------------------

(define (extract-initial-call-args fn-name expr)
  (cond
    ((not (pair? expr)) #f)
    ((eq? (car expr) fn-name) (cdr expr))
    ((eq? (car expr) 'let)
     (let ((bindings (cadr expr))
           (body (if (pair? (cddr expr)) (caddr expr) #f)))
       (let loop ((bs bindings))
         (if (null? bs)
             (extract-initial-call-args fn-name body)
             (let ((res (extract-initial-call-args fn-name (cadar bs))))
               (if res res (loop (cdr bs))))))))
    ((eq? (car expr) 'begin)
     (let loop ((es (cdr expr)))
       (if (null? es) #f
           (let ((res (extract-initial-call-args fn-name (car es))))
             (if res res (loop (cdr es)))))))
    (else #f)))

(define (abstract-eval-named-let loop-name bindings body env)
  (let* ((vars (map car* bindings))
         (init-types (map (lambda (b) (abstract-eval-expr (cadr b) env)) bindings)))
    ;; Iterative fixpoint loop up to 5 steps
    (let fixpoint-loop ((step 0)
                        (current-arg-types init-types)
                        (current-ret-type (type-bot)))
      (let* ((loop-closure (type-closure loop-name vars current-ret-type))
             (loop-env (type-env-extend loop-name loop-closure
                                        (type-env-extend-multi vars current-arg-types env)))
             ;; Evaluate body expressions under loop-env
             (body-type (let eval-body ((rest body) (last-t (type-bot)))
                          (if (null? rest)
                              last-t
                              (eval-body (cdr rest) (abstract-eval-expr (car rest) loop-env)))))
             (next-ret-type (type-lub current-ret-type body-type)))
        (if (or (>= step 4)
                (type-equal? next-ret-type current-ret-type))
            ;; Fixpoint reached or widened
            (begin
              (let rec-rec ((vs vars) (ts current-arg-types))
                (if (and (pair? vs) (pair? ts))
                    (begin
                      (record-var-type! (car vs) (car ts))
                      (rec-rec (cdr vs) (cdr ts)))))
              (if (type-bot? next-ret-type) (type-top) next-ret-type))
            ;; Continue fixpoint iteration
            (fixpoint-loop (+ step 1) current-arg-types next-ret-type))))))

;;; -----------------------------------------------------------------------
;;; 6. Whole-Form Annotation Driver Pass
;;; -----------------------------------------------------------------------

(define (annotate-form form)
  (cond
    ((and (pair? form) (eq? (car form) 'define))
     (let ((head (cadr form))
           (body (cddr form)))
       (if (pair? head)
           ;; (define (name args...) body...)
           (let* ((fn-name (car head))
                  (params (cdr head))
                  (param-types (map (lambda (p) (type-top)) params))
                  (fn-env (type-env-extend-multi params param-types '()))
                  (ret-type (let eval-b ((rest body) (last-t (type-top)))
                              (if (null? rest)
                                  last-t
                                  (eval-b (cdr rest) (abstract-eval-expr (car rest) fn-env))))))
             (record-var-type! fn-name (type-closure fn-name params ret-type))
             form)
           ;; (define name val)
           (let* ((var head)
                  (val-t (abstract-eval-expr (car body) '())))
             (record-var-type! var val-t)
             form))))
    (else
     (abstract-eval-expr form '())
     form)))

(define (annotate-all form-or-forms)
  (reset-type-annotations!)
  (cond
    ((null? form-or-forms) '())
    ((not (pair? form-or-forms))
     (abstract-eval-expr form-or-forms '())
     form-or-forms)
    ((eq? (car form-or-forms) '%program)
     (let ((defs (cadr form-or-forms))
           (main (caddr form-or-forms)))
       (let rec ((ds defs))
         (if (pair? ds)
             (begin
               (annotate-form (car ds))
               (rec (cdr ds)))))
       (abstract-eval-expr main '())
       form-or-forms))
    ((eq? (car form-or-forms) 'define)
     (annotate-form form-or-forms))
    ((eq? (car form-or-forms) 'letrec)
     (let ((bindings (cadr form-or-forms))
           (body (cddr form-or-forms)))
       (if (= (length bindings) 1)
           (abstract-eval-expr form-or-forms '())
           (let rec ((bs bindings))
             (if (pair? bs)
                 (let* ((b (car bs))
                        (var (car b))
                        (val (cadr b)))
                   (if (and (pair? val) (eq? (car val) 'lambda))
                       (let* ((params (cadr val))
                              (param-types (map (lambda (p) (type-top)) params)))
                         (record-var-type! var (type-closure var params (type-top))))
                       (record-var-type! var (type-top)))
                   (rec (cdr bs))))))
       form-or-forms))
    (else
     (abstract-eval-expr form-or-forms '())
     form-or-forms)))
;;; =======================================================================
;;; ULisp Compiler Pass 5b: S-RTyper (Representation Typer & Unboxing Lowering)
;;; Conforms to DSN-33 Architecture Specification & Issue #518
;;; Note: Lowers high-level abstract types (inferred by S-Annotator Pass 4b)
;;;       to concrete hardware representations (%raw-i64, untagged registers).
;;;       Eliminates sar/sal tagging overhead in pure arithmetic loops and
;;;       inserts explicit boxing/unboxing boundaries at Scheme dynamic edges.
;;; =======================================================================

(define *unboxed-functions* (cons '() '()))
(define *unboxed-ret-functions* (cons '() '()))
(define *rtyper-fact-bucket-count* 256)
(define *rtyper-facts* (make-vector 256 '()))

(define (rtyper-fact-bucket-idx sym)
  (modulo (symbol->hash-idx sym) *rtyper-fact-bucket-count*))

(define (reset-rtyper!)
  (set-car! *unboxed-functions* '())
  (set-car! *unboxed-ret-functions* '())
  (let loop ((i 0))
    (if (< i *rtyper-fact-bucket-count*)
        (begin
          (vector-set! *rtyper-facts* i '())
          (loop (+ i 1))))))

(define (rtyper-current-repr-requires-boxing?)
  (repr-requires-boxing? (current-value-repr)))

(define (rtyper-wrap-box-fixnum expr)
  (if (rtyper-current-repr-requires-boxing?)
      (list '%box-fixnum expr)
      expr))

(define (rtyper-wrap-unbox-fixnum expr)
  (if (rtyper-current-repr-requires-boxing?)
      (list '%unbox-fixnum expr)
      expr))

(define (record-rtyper-fact! var fact)
  (let ((idx (rtyper-fact-bucket-idx var)))
    (vector-set! *rtyper-facts* idx
                 (cons (cons var fact) (vector-ref *rtyper-facts* idx)))))

(define (get-rtyper-fact var)
  (let ((e (assq var (vector-ref *rtyper-facts* (rtyper-fact-bucket-idx var)))))
    (if e (cdr e) #f)))

(define (record-unboxed-fn! name)
  (set-car! *unboxed-functions* (cons name (car *unboxed-functions*))))

(define (unboxed-fn? name)
  (memq name (car *unboxed-functions*)))

(define (record-unboxed-ret-fn! name)
  (set-car! *unboxed-ret-functions* (cons name (car *unboxed-ret-functions*))))

(define (unboxed-ret-fn? name)
  (memq name (car *unboxed-ret-functions*)))

(define (unboxed-box-ret-call? op unboxed-fns)
  (let loop ((fs unboxed-fns))
    (cond
      ((null? fs) #f)
      ((and (pair? (car fs)) (eq? (caar fs) '%box-ret) (eq? (cdar fs) op)) #t)
      (else (loop (cdr fs))))))

(define (rtyper-raw-value-expr? expr raw-env)
  (cond
    ((symbol? expr) (raw-var? expr raw-env))
    ((not (pair? expr)) #f)
    ((memq (car expr) '(%raw-add %raw-sub %raw-mul %unbox-fixnum)) #t)
    ((and (symbol? (car expr)) (unboxed-ret-fn? (car expr))) #t)
    ((eq? (car expr) 'let)
     (rtyper-raw-value-expr? (caddr expr) raw-env))
    ((eq? (car expr) 'if)
     (and (rtyper-raw-value-expr? (caddr expr) raw-env)
          (pair? (cdddr expr))
          (rtyper-raw-value-expr? (cadddr expr) raw-env)))
    ((eq? (car expr) 'begin)
     (let loop ((es (cdr expr)))
       (if (null? (cdr es))
           (rtyper-raw-value-expr? (car es) raw-env)
           (loop (cdr es)))))
    (else #f)))

(define (raw-var? var raw-env)
  (memq var raw-env))

(define (fixnum-test-var test)
  (cond
    ((symbol? test)
     (let ((fact (get-rtyper-fact test)))
       (if fact (fixnum-test-var fact) #f)))
    ((and (pair? test) (memq (car test) '(fixnum? integer? number?)) (pair? (cdr test)) (symbol? (cadr test)))
     (cadr test))
    (else #f)))

(define (fold-type-pred op arg)
  (case op
    ((fixnum? integer? number?)
     (cond ((integer? arg) #t)
           ((or (string? arg) (boolean? arg) (null? arg) (pair? arg)) #f)
           (else 'unknown)))
    ((string?)
     (cond ((string? arg) #t)
           ((or (integer? arg) (boolean? arg) (null? arg) (pair? arg)) #f)
           (else 'unknown)))
    ((boolean?)
     (cond ((boolean? arg) #t)
           ((or (integer? arg) (string? arg) (null? arg) (pair? arg)) #f)
           (else 'unknown)))
    ((null?)
     (cond ((null? arg) #t)
           ((or (integer? arg) (string? arg) (boolean? arg) (pair? arg)) #f)
           (else 'unknown)))
    ((pair?)
     (cond ((pair? arg) #t)
           ((or (integer? arg) (string? arg) (boolean? arg) (null? arg)) #f)
           (else 'unknown)))
    ((zero?)
     (cond ((integer? arg) (if (= arg 0) #t #f))
           (else 'unknown)))
    (else 'unknown)))

(define (specialize-var-in-body body var val)
  (cond
    ((eq? body var) val)
    ((not (pair? body)) body)
    ((eq? (car body) 'quote) body)
    ;; Type predicate test on var
    ((and (memq (car body) '(fixnum? integer? number? string? boolean? null? pair? zero?))
          (pair? (cdr body))
          (eq? (cadr body) var))
     (let ((folded (fold-type-pred (car body) val)))
       (if (eq? folded 'unknown)
           (list (car body) (specialize-var-in-body (cadr body) var val))
           folded)))
    ;; Conditional branch pruning
    ((eq? (car body) 'if)
     (let* ((test (specialize-var-in-body (cadr body) var val))
            (then (specialize-var-in-body (caddr body) var val))
            (else-part (if (null? (cdddr body)) #f (specialize-var-in-body (cadddr body) var val))))
       (cond
         ((eq? test #t) then)
         ((eq? test #f) else-part)
         (else (list 'if test then else-part)))))
    (else
     (cons (specialize-var-in-body (car body) var val)
           (specialize-var-in-body (cdr body) var val)))))

(define (all-fixnum-params? params)
  (let loop ((ps params))
    (if (null? ps)
        #t
        (let ((t (get-var-type (car ps))))
          (if (and t (type-fixnum? t))
              (loop (cdr ps))
              #f)))))

;;; Checks whether fn-name is invoked in a non-tail position within expr
(define (non-tail-call-to? fn-name expr)
  (cond
    ((not (pair? expr)) #f)
    ((eq? (car expr) 'quote) #f)
    ((eq? (car expr) 'let)
     (or (occurs-in? fn-name (cadr expr))
         (non-tail-call-to? fn-name (caddr expr))))
    ((eq? (car expr) 'if)
     (let ((test (cadr expr))
           (then (caddr expr))
           (else-opt (if (null? (cdddr expr)) '() (cadddr expr))))
       (or (occurs-in? fn-name test)
           (non-tail-call-to? fn-name then)
           (if (null? else-opt) #f (non-tail-call-to? fn-name else-opt)))))
    ((eq? (car expr) 'begin)
     (let loop ((es (cdr expr)))
       (cond
         ((null? es) #f)
         ((null? (cdr es)) (non-tail-call-to? fn-name (car es)))
         (else (or (occurs-in? fn-name (car es))
                   (loop (cdr es)))))))
    (else
     (occurs-in? fn-name (cdr expr)))))

;;; Fast O(1) detection of pure tail-recursive loops (maximum depth 30)
(define (pure-tail-loop? fn-name lbody)
  (and (not (non-tail-call-to? fn-name lbody))
       (let loop-chk ((e lbody) (depth 0))
         (cond
           ((> depth 30) #f)
           ((not (pair? e)) #f)
           ((eq? (car e) fn-name) #t)
           ((eq? (car e) 'let)
            (loop-chk (caddr e) (+ depth 1)))
           ((eq? (car e) 'if)
            (let ((test (cadr e))
                  (then (caddr e))
                  (else-opt (if (null? (cdddr e)) '() (cadddr e))))
              (and (not (and (pair? test) (eq? (car test) fn-name)))
                   (or (loop-chk then (+ depth 1))
                       (if (null? else-opt) #f (loop-chk else-opt (+ depth 1)))))))
           (else #f)))))

;;; Pure integer recursive function analysis (Interprocedural Unboxing: int64_t -> int64_t)
(define (pure-int-atom? e int-vars)
  (or (integer? e)
      (and (symbol? e) (memq e int-vars))))

(define (pure-int-cmp-expr? e int-vars)
  (and (pair? e)
       (cond
         ((memq (car e) '(= < <= > >=))
          (and (= (length e) 3)
               (pure-int-atom? (cadr e) int-vars)
               (pure-int-atom? (caddr e) int-vars)))
         ((eq? (car e) 'zero?)
          (and (= (length e) 2)
               (pure-int-atom? (cadr e) int-vars)))
         (else #f))))

(define (expr-has-int-gt? expr limit)
  (cond
    ((integer? expr)
     (or (> expr limit) (< expr (- 0 limit))))
    ((not (pair? expr)) #f)
    ((eq? (car expr) 'quote) #f)
    (else
     (or (expr-has-int-gt? (car expr) limit)
         (expr-has-int-gt? (cdr expr) limit)))))

(define (pure-int-expr? expr fn-name-or-names int-vars bool-vars depth)
  (cond
    ((> depth 40) #f)
    ((integer? expr) (and (<= expr 536870911) (>= expr -536870911)))
    ((symbol? expr) (memq expr int-vars))
    ((not (pair? expr)) #f)
    (else
     (let ((op (car expr)))
       (cond
         ((eq? op 'if)
          (let ((test (cadr expr))
                (then (caddr expr))
                (else-opt (cdddr expr)))
            (and (pair? else-opt)
                 (or (and (symbol? test) (memq test bool-vars))
                     (pure-int-cmp-expr? test int-vars))
                 (pure-int-expr? then fn-name-or-names int-vars bool-vars (+ depth 1))
                 (pure-int-expr? (car else-opt) fn-name-or-names int-vars bool-vars (+ depth 1)))))
         ((eq? op 'let)
          (let ((bindings (cadr expr))
                (body (caddr expr)))
            (let loop ((bs bindings) (ivs int-vars) (bvs bool-vars))
              (if (null? bs)
                  (pure-int-expr? body fn-name-or-names ivs bvs (+ depth 1))
                  (let* ((b (car bs))
                         (v (car b))
                         (rhs (cadr b)))
                    (cond
                      ((pure-int-cmp-expr? rhs ivs)
                       (loop (cdr bs) ivs (cons v bvs)))
                      ((pure-int-expr? rhs fn-name-or-names ivs bvs (+ depth 1))
                       (loop (cdr bs) (cons v ivs) bvs))
                      (else #f)))))))
         ((memq op '(+ - * %raw-add %raw-sub %raw-mul))
          (and (= (length expr) 3)
               (pure-int-expr? (cadr expr) fn-name-or-names int-vars bool-vars (+ depth 1))
               (pure-int-expr? (caddr expr) fn-name-or-names int-vars bool-vars (+ depth 1))))
         ((if (pair? fn-name-or-names) (memq op fn-name-or-names) (eq? op fn-name-or-names))
          (let loop ((as (cdr expr)))
            (if (null? as)
                #t
                (and (pure-int-expr? (car as) fn-name-or-names int-vars bool-vars (+ depth 1))
                     (loop (cdr as))))))
         (else #f))))))

(define (rtyper-let-binds-var? name bindings)
  (let loop ((bs bindings))
    (cond
      ((null? bs) #f)
      ((and (pair? (car bs)) (eq? (caar bs) name)) #t)
      (else (loop (cdr bs))))))

(define (fn-escapes-in-expr? fn-name expr)
  (cond
    ((symbol? expr) (eq? expr fn-name))
    ((not (pair? expr)) #f)
    ((eq? (car expr) 'quote) #f)
    ((eq? (car expr) 'define)
     (let ((body (cddr expr)))
       (let loop ((es body))
         (if (null? es) #f
             (or (fn-escapes-in-expr? fn-name (car es))
                 (loop (cdr es)))))))
    ((eq? (car expr) 'let)
     (or (let loop ((bs (cadr expr)))
           (if (null? bs) #f
               (or (fn-escapes-in-expr? fn-name (cadar bs))
                   (loop (cdr bs)))))
         (if (rtyper-let-binds-var? fn-name (cadr expr))
             #f
             (fn-escapes-in-expr? fn-name (caddr expr)))))
    ((eq? (car expr) 'if)
     (or (fn-escapes-in-expr? fn-name (cadr expr))
         (fn-escapes-in-expr? fn-name (caddr expr))
         (if (null? (cdddr expr)) #f (fn-escapes-in-expr? fn-name (cadddr expr)))))
    ((eq? (car expr) 'begin)
     (let loop ((es (cdr expr)))
       (if (null? es) #f
           (or (fn-escapes-in-expr? fn-name (car es))
               (loop (cdr es))))))
    ((eq? (car expr) 'lambda)
     (if (memq fn-name (cadr expr))
         #f
         (occurs-in? fn-name (caddr expr))))
    (else
     (if (eq? (car expr) fn-name)
         (let loop ((as (cdr expr)))
           (if (null? as) #f
               (or (fn-escapes-in-expr? fn-name (car as))
                   (loop (cdr as)))))
         (or (fn-escapes-in-expr? fn-name (car expr))
             (let loop ((as (cdr expr)))
               (if (null? as) #f
                   (or (fn-escapes-in-expr? fn-name (car as))
                       (loop (cdr as))))))))))

(define (pure-int-known-fn? fn-name params lbody body-or-env known-fns)
  (and (pair? params)
       (let loop ((ps params))
         (if (null? ps) #t
             (and (occurs-in? (car ps) lbody)
                  (loop (cdr ps)))))
       (not (fn-escapes-in-expr? fn-name lbody))
       (not (fn-escapes-in-expr? fn-name body-or-env))
       (pure-int-expr? lbody (if (pair? known-fns) (cons fn-name known-fns) fn-name) params '() 0)))

(define (pure-int-recursive-fn? fn-name params lbody body)
  (pure-int-known-fn? fn-name params lbody body '()))

(define (rtyper-valid-int-params? params)
  (and (pair? params)
       (let loop ((ps params))
         (cond
           ((null? ps) #t)
           ((and (pair? ps) (symbol? (car ps))) (loop (cdr ps)))
           (else #f)))))

(define (rtyper-all-params-occur? params lbody)
  (let loop ((ps params))
    (if (null? ps) #t
        (and (occurs-in? (car ps) lbody)
             (loop (cdr ps))))))

(define (rtyper-prune-pure-cands active-cands known-pure-fns)
  (let prune-loop ((cands active-cands))
    (if (null? cands)
        '()
        (let* ((active-names (map car* cands))
               (allowed-fns (append active-names known-pure-fns))
               (survivors
                (let filter-loop ((cs cands) (acc '()))
                  (if (null? cs) (reverse acc)
                      (let* ((c (car cs))
                             (fn-name (car c))
                             (params (cadr c))
                             (lbody (caddr c)))
                        (if (pure-int-expr? lbody (cons fn-name allowed-fns) params '() 0)
                            (filter-loop (cdr cs) (cons c acc))
                            (filter-loop (cdr cs) acc)))))))
          (cond
            ((null? survivors) '())
            ((= (length survivors) (length cands)) survivors)
            (else (prune-loop survivors)))))))

;;; Fixed-Point Iterative Pruning for Interprocedural Unboxing
;;; Check local purity & self-escape BEFORE O(F*N) full-program escape scan.
(define (find-pure-int-fns candidate-defs scope-exprs known-pure-fns)
  (let* ((param-cands
          (let loop ((cs candidate-defs) (acc '()))
            (if (null? cs) (reverse acc)
                (let ((c (car cs)))
                  (if (rtyper-valid-int-params? (cadr c))
                      (loop (cdr cs) (cons c acc))
                      (loop (cdr cs) acc))))))
         (init-allowed (append (map car* param-cands) known-pure-fns))
         (local-cands
          (let loop ((cs param-cands) (acc '()))
            (if (null? cs) (reverse acc)
                (let* ((c (car cs))
                       (fn-name (car c))
                       (params (cadr c))
                       (lbody (caddr c)))
                  (if (and (pure-int-expr? lbody (cons fn-name init-allowed) params '() 0)
                           (rtyper-all-params-occur? params lbody)
                           (not (fn-escapes-in-expr? fn-name lbody))
                           (or (not (occurs-in? '* lbody))
                               (and (not (expr-has-int-gt? lbody 20))
                                    (not (expr-has-int-gt? scope-exprs 20)))))
                      (loop (cdr cs) (cons c acc))
                      (loop (cdr cs) acc))))))
         (local-survivors (rtyper-prune-pure-cands local-cands known-pure-fns)))
    (if (null? local-survivors)
        '()
        (let ((non-escaping
               (let loop ((cs local-survivors) (acc '()))
                 (if (null? cs) (reverse acc)
                     (let* ((c (car cs))
                            (fn-name (car c)))
                       (if (let esc-loop ((es scope-exprs))
                             (if (null? es) #f
                                 (or (fn-escapes-in-expr? fn-name (car es))
                                     (esc-loop (cdr es)))))
                           (loop (cdr cs) acc)
                           (loop (cdr cs) (cons c acc))))))))
          (cond
            ((null? non-escaping) '())
            ((= (length non-escaping) (length local-survivors))
             (map car* non-escaping))
            (else
             (map car* (rtyper-prune-pure-cands non-escaping known-pure-fns))))))))

;;; Ensures integer constants at exit branches of an unboxed-return function are raw
(define (unbox-const-exit expr)
  (cond
    ((integer? expr)
     (list '%unbox-fixnum expr))
    ((not (pair? expr))
     expr)
    ((eq? (car expr) 'if)
     (let ((test (cadr expr))
           (then (caddr expr))
           (else-part (if (null? (cdddr expr)) '() (cadddr expr))))
       (list 'if test
             (unbox-const-exit then)
             (if (null? else-part) '() (unbox-const-exit else-part)))))
    ((eq? (car expr) 'let)
     (list 'let (cadr expr) (unbox-const-exit (caddr expr))))
    ((eq? (car expr) 'begin)
     (let loop ((rest (cdr expr)) (acc '()))
       (if (null? (cdr rest))
           (cons 'begin (append (reverse acc) (list (unbox-const-exit (car rest)))))
           (loop (cdr rest) (cons (car rest) acc)))))
    (else expr)))

;;; Traverses loop body to box any raw loop-variable returned at loop exit boundaries
(define (box-raw-exit expr raw-vars fn-name)
  (cond
    ((not (pair? expr))
     (if (and (symbol? expr) (memq expr raw-vars))
         (list '%box-fixnum expr)
         expr))
    ((eq? (car expr) fn-name)
     ;; Tail-recursive loop jump: keep unboxed raw integers
     expr)
    ((eq? (car expr) '%box-fixnum)
     expr)
    ((memq (car expr) '(%raw-add %raw-sub %raw-mul))
     (list '%box-fixnum expr))
    ((eq? (car expr) 'if)
     (let ((test (cadr expr))
           (then (caddr expr))
           (else-part (if (null? (cdddr expr)) '() (cadddr expr))))
       (list 'if test
             (box-raw-exit then raw-vars fn-name)
             (if (null? else-part) '() (box-raw-exit else-part raw-vars fn-name)))))
    ((eq? (car expr) 'let)
     (let ((bindings (cadr expr))
           (body (caddr expr)))
       (list 'let bindings (box-raw-exit body raw-vars fn-name))))
    ((eq? (car expr) 'begin)
     (let ((stmts (cdr expr)))
       (let loop ((rest stmts) (acc '()))
         (if (null? (cdr rest))
             (cons 'begin (append (reverse acc) (list (box-raw-exit (car rest) raw-vars fn-name))))
             (loop (cdr rest) (cons (car rest) acc))))))
    (else
     expr)))

;;; Lowers binary arithmetic operators to raw integer primitives when operands are raw
(define (rtyper-binop op e1 e2 raw-env)
  (cond
    ((memq op '(+ - *))
     (let ((raw1? (or (and (integer? e1) (<= e1 536870911) (>= e1 -536870911))
                      (and (symbol? e1) (raw-var? e1 raw-env))))
           (raw2? (or (and (integer? e2) (<= e2 536870911) (>= e2 -536870911))
                      (and (symbol? e2) (raw-var? e2 raw-env)))))
       (if (and raw1? raw2?)
           (case op
             ((+) (list '%raw-add e1 e2))
             ((-) (list '%raw-sub e1 e2))
             ((*) (list '%raw-mul e1 e2)))
           (list op e1 e2))))
    ((memq op '(= < <= > >=))
     (let ((raw1? (and (symbol? e1) (raw-var? e1 raw-env)))
           (raw2? (and (symbol? e2) (raw-var? e2 raw-env))))
       (cond
         ((and raw1? (integer? e2))
          (list op e1 (list '%unbox-fixnum e2)))
         ((and (integer? e1) raw2?)
          (list op (list '%unbox-fixnum e1) e2))
         (else
          (list op e1 e2)))))
    (else
     (list op e1 e2))))

(define (rtyper-standard-let-bindings op bindings body raw-env unboxed-fns)
  (let* ((new-bindings
          (map (lambda (b)
                 (let ((v (car b)) (rhs (cadr b)))
                   (if (and (pair? rhs) (memq (car rhs) '(fixnum? integer? number?))
                            (pair? (cdr rhs)) (symbol? (cadr rhs)))
                       (record-rtyper-fact! v (cadr rhs)))
                   (list v (rtyper-expr-scoped rhs raw-env unboxed-fns))))
               bindings))
         ;; Extend raw-env with newly bound variables that hold raw values
         (extended-raw-env
          (let loop ((bs new-bindings) (acc raw-env))
            (if (null? bs) acc
                (let* ((b (car bs))
                       (var (car b))
                       (val (cadr b)))
                  (if (rtyper-raw-value-expr? val acc)
                      (loop (cdr bs) (cons var acc))
                      (loop (cdr bs) acc))))))
         (new-body (rtyper-expr-scoped body extended-raw-env unboxed-fns)))
    (list op new-bindings new-body)))

;;; Recursively rewrites ANF AST to Typed LIR representation
(define (rtyper-expr-scoped expr raw-env unboxed-fns)
    (cond
      ((not (pair? expr)) expr)
    (else
     (let ((op (car expr)))
       (cond
         ((eq? op 'quote) expr)
         ((eq? op 'if)
          (let* ((test (cadr expr))
                 (then (caddr expr))
                 (else-expr (if (null? (cdddr expr)) '() (cadddr expr)))
                 (fvar (fixnum-test-var test)))
            (if (and fvar (not (raw-var? fvar raw-env)) (expr-has-arithmetic-on-var? then fvar))
                ;; Flow-sensitive narrowing: fvar is proven to be Fixnum in then-branch!
                ;; Unbox fvar at the then-branch boundary and lower internal arithmetic to raw ops.
                (let* ((then-raw-env (cons fvar raw-env))
                       (lowered-then (rtyper-expr-scoped then then-raw-env unboxed-fns))
                       (boxed-then (if (and (pair? lowered-then)
                                            (memq (car lowered-then) '(%raw-add %raw-sub %raw-mul)))
                                       (list '%box-fixnum lowered-then)
                                       (box-raw-exit lowered-then (list fvar) '%no-fn)))
                       (unboxed-then (list 'let (list (list fvar (list '%unbox-fixnum fvar))) boxed-then))
                       (r-test (rtyper-expr-scoped test raw-env unboxed-fns))
                       (r-else (if (null? else-expr) '() (rtyper-expr-scoped else-expr raw-env unboxed-fns))))
                  (if (null? r-else)
                      (list 'if r-test unboxed-then)
                      (list 'if r-test unboxed-then r-else)))
                ;; Standard if
                (let ((r-test (rtyper-expr-scoped test raw-env unboxed-fns))
                      (r-then (rtyper-expr-scoped then raw-env unboxed-fns))
                      (r-else (if (null? else-expr) '() (rtyper-expr-scoped else-expr raw-env unboxed-fns))))
                  (if (null? r-else)
                      (list 'if r-test r-then)
                      (list 'if r-test r-then r-else))))))
         ((eq? op 'begin)
          (cons 'begin (map (lambda (e) (rtyper-expr-scoped e raw-env unboxed-fns)) (cdr expr))))
         ((memq op '(let letrec))
          (let* ((bindings (cadr expr))
                 (body (caddr expr)))
            (cond
              ;; Path Splitting (合流点メッセージ分割 / Chambers & Ungar 1989):
              ;; When single binding is (v (if cond e1 e2)) and body has conditional/pred on v:
              ((and (eq? op 'let)
                    (= (length bindings) 1)
                    (pair? (cadar bindings))
                    (eq? (car (cadar bindings)) 'if)
                    (expr-size-le? body 40)
                    (let ((var (caar bindings)))
                      (expr-has-conditional-or-pred-on-var? body var)))
               (let* ((b (car bindings))
                      (var (car b))
                      (if-expr (cadr b))
                      (cond-part (cadr if-expr))
                      (e1 (caddr if-expr))
                      (e2 (if (null? (cdddr if-expr)) #f (cadddr if-expr)))
                      ;; Specialize body along both paths
                      (spec-then (specialize-var-in-body body var e1))
                      (spec-else (specialize-var-in-body body var e2))
                      (split-then (rtyper-expr-scoped (list 'let (list (list var e1)) spec-then) raw-env unboxed-fns))
                      (split-else (rtyper-expr-scoped (list 'let (list (list var e2)) spec-else) raw-env unboxed-fns)))
                 (list 'if (rtyper-expr-scoped cond-part raw-env unboxed-fns) split-then split-else)))
              ((and (= (length bindings) 1)
                    (let* ((b (car bindings))
                           (val (cadr b)))
                      (and (pair? val)
                           (eq? (car val) 'lambda)
                           (pair? (cadr val))
                           (all-fixnum-params? (cadr val))
                           (pure-tail-loop? (car b) (caddr val))
                           (or (not (occurs-in? '* (caddr val)))
                               (and (not (expr-has-int-gt? (caddr val) 20))
                                    (not (expr-has-int-gt? body 20)))))))
               ;; Named-let loop with 100% fixnum parameters and pure tail-recursion:
               ;; Lower all loop variables to raw %raw-i64 hardware representation.
               ;; Lexically scope fn-name to its definition body and continuation.
               (let* ((b (car bindings))
                      (fn-name (car b))
                      (fn-val (cadr b))
                      (params (cadr fn-val))
                      (lbody (caddr fn-val))
                      (loop-raw-env (append params raw-env))
                      (inner-unboxed-fns (cons fn-name unboxed-fns)))
                 (record-unboxed-fn! fn-name)
                 (let* ((typed-lbody (rtyper-expr-scoped lbody loop-raw-env inner-unboxed-fns))
                        (boxed-lbody (box-raw-exit typed-lbody params fn-name))
                        (new-fn-val (list 'lambda params boxed-lbody))
                        (new-body (rtyper-expr-scoped body raw-env inner-unboxed-fns)))
                   (list op (list (list fn-name new-fn-val)) new-body))))
              ((and (eq? op 'letrec) (pair? bindings))
               ;; Interprocedural Unboxing (int64_t -> int64_t) for pure integer functions in letrec
               (let* ((cand-defs
                       (let loop ((bs bindings) (acc '()))
                         (if (null? bs) (reverse acc)
                             (let* ((b (car bs))
                                    (fn-name (car b))
                                    (val (cadr b)))
                               (if (and (pair? val) (eq? (car val) 'lambda)
                                        (pair? (cdr val)) (pair? (cddr val)))
                                   (loop (cdr bs) (cons (list fn-name (cadr val) (caddr val)) acc))
                                   (loop (cdr bs) acc))))))
                      (unboxed-names
                       (if (null? cand-defs)
                           '()
                           (find-pure-int-fns cand-defs (list body) unboxed-fns))))
                 (if (pair? unboxed-names)
                     (let ((inner-unboxed-fns (append unboxed-names unboxed-fns))
                           (ext-unboxed-fns (append (map (lambda (f) (cons '%box-ret f)) unboxed-names) unboxed-fns)))
                       (for-each (lambda (f)
                                   (record-unboxed-fn! f)
                                   (record-unboxed-ret-fn! f))
                                 unboxed-names)
                       (let* ((new-bindings
                               (map (lambda (b)
                                      (let* ((fn-name (car b))
                                             (fn-val (cadr b)))
                                        (if (memq fn-name unboxed-names)
                                            (let* ((params (cadr fn-val))
                                                   (lbody (caddr fn-val))
                                                   (loop-raw-env (append params raw-env))
                                                   (typed-lbody (rtyper-expr-scoped lbody loop-raw-env inner-unboxed-fns))
                                                   (raw-lbody (unbox-const-exit typed-lbody)))
                                              (list fn-name (list 'lambda params raw-lbody)))
                                            (list fn-name (rtyper-expr-scoped fn-val raw-env ext-unboxed-fns)))))
                                    bindings))
                              (new-body (rtyper-expr-scoped body raw-env ext-unboxed-fns)))
                         (list op new-bindings new-body)))
                     (rtyper-standard-let-bindings op bindings body raw-env unboxed-fns))))
              (else
               (rtyper-standard-let-bindings op bindings body raw-env unboxed-fns)))))
         ((eq? op '-)
          (if (null? (cddr expr))
              (list '- (rtyper-expr-scoped (cadr expr) raw-env unboxed-fns))
              (rtyper-binop op (rtyper-expr-scoped (cadr expr) raw-env unboxed-fns) (rtyper-expr-scoped (caddr expr) raw-env unboxed-fns) raw-env)))
         ((binop-prim? op)
          (rtyper-binop op (rtyper-expr-scoped (cadr expr) raw-env unboxed-fns) (rtyper-expr-scoped (caddr expr) raw-env unboxed-fns) raw-env))
         ((unboxed-box-ret-call? op unboxed-fns)
          ;; External boundary call into an unboxed-return function: unbox args and box result
          (let ((args (cdr expr)))
            (list '%box-fixnum
                  (cons op
                        (map (lambda (arg)
                               (if (and (symbol? arg) (raw-var? arg raw-env))
                                   arg
                                   (list '%unbox-fixnum (rtyper-expr-scoped arg raw-env unboxed-fns))))
                             args)))))
         ((memq op unboxed-fns)
          ;; Boundary call into an unboxed loop: unbox non-raw arguments at entry
          (let ((args (cdr expr)))
            (cons op
                  (map (lambda (arg)
                         (if (and (symbol? arg) (raw-var? arg raw-env))
                             arg
                             (list '%unbox-fixnum (rtyper-expr-scoped arg raw-env unboxed-fns))))
                       args))))
         (else
          ;; General procedure call or syntax
          (cons op (map (lambda (e) (rtyper-expr-scoped e raw-env unboxed-fns)) (cdr expr)))))))))


(define (rtyper-expr expr raw-env)
  (rtyper-expr-scoped expr raw-env '()))

;;; Pass 5b Entrypoint: Transforms S-Annotated AST into Lowered Typed AST
(define (rtyper-all form-or-forms)
  (reset-rtyper!)
  (cond
    ((null? form-or-forms) '())
    ((not (pair? form-or-forms)) form-or-forms)
    ((eq? (car form-or-forms) '%program)
     (let* ((defs (cadr form-or-forms))
            (main (caddr form-or-forms))
            ;; 1. Collect top-level function definitions
            (top-fn-defs
             (let loop ((ds defs) (acc '()))
               (if (null? ds) (reverse acc)
                   (let ((d (car ds)))
                     (if (and (pair? d) (eq? (car d) 'define)
                              (symbol? (cadr d))
                              (pair? (caddr d)) (eq? (car (caddr d)) 'lambda)
                              (pair? (cdr (caddr d))) (pair? (cddr (caddr d))))
                         (loop (cdr ds) (cons (list (cadr d) (cadr (caddr d)) (caddr (caddr d))) acc))
                         (loop (cdr ds) acc))))))
            ;; 2. Detect pure-int top-level functions using fixed-point pruning
            (top-pure-int-fns (find-pure-int-fns top-fn-defs (cons main defs) '())))
       ;; 3. Register unboxed top-level functions
       (for-each (lambda (fn-name)
                   (record-unboxed-fn! fn-name)
                   (record-unboxed-ret-fn! fn-name))
                 top-pure-int-fns)
       (let* ((inner-unboxed-fns top-pure-int-fns)
              (ext-unboxed-fns (map (lambda (f) (cons '%box-ret f)) top-pure-int-fns))
              (new-defs
               (map (lambda (d)
                      (if (and (pair? d) (eq? (car d) 'define))
                          (let ((var (cadr d))
                                (val (caddr d)))
                            (if (and (symbol? var) (pair? val) (eq? (car val) 'lambda) (memq var top-pure-int-fns))
                                ;; Unboxed top-level function
                                (let* ((params (cadr val))
                                       (lbody (caddr val))
                                       (typed-lbody (rtyper-expr-scoped lbody params inner-unboxed-fns))
                                       (raw-lbody (unbox-const-exit typed-lbody)))
                                  (list 'define var (list 'lambda params raw-lbody)))
                                ;; Normal define
                                (list 'define var (rtyper-expr-scoped val '() ext-unboxed-fns))))
                          (rtyper-expr-scoped d '() ext-unboxed-fns)))
                    defs))
              (new-main (rtyper-expr-scoped main '() ext-unboxed-fns)))
         (list '%program new-defs new-main))))
    ((eq? (car form-or-forms) 'define)
     (let ((head (cadr form-or-forms))
           (body (cddr form-or-forms)))
       (cons 'define
             (cons head
                   (map (lambda (e) (rtyper-expr-scoped e '() '())) body)))))
    (else
     (rtyper-expr-scoped form-or-forms '() '()))))
;;; =======================================================================
;;; ULisp Compiler Pass 4c: Contification & Local Closure Elimination Nanopass
;;; Conforms to DSN-33 Architecture Specification & Issue #522
;;; Note: Identifies local functions whose call sites are dominated by a
;;;       common continuation context and transforms them into local control
;;;       flow (%cont-fun / %cont-call), eliminating flat closure allocation
;;;       and indirect calls completely.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: contify-subst
;;; Substitutes call sites of `var` into `(%cont-call var . args)` within `expr`.
;;; -----------------------------------------------------------------------
(define-pass contify-subst : L_core (ir var) -> L_core ()
  (Expr : Expr (ir var) -> Expr ()
    ((quote ,datum)
     ir)
    ((lambda (,params ...) ,body)
     ir) ; Do not cross lambda boundaries into separate procedure CFGs
    ((let ((,x* ,e*) ...) ,body)
     (let ((opt-bindings (let loop ((xs x*) (es e*) (acc '()))
                           (if (or (null? xs) (null? es))
                               (reverse acc)
                               (loop (cdr xs) (cdr es) (cons (list (car xs) (Expr (car es) var)) acc))))))
       (if (memq var x*)
           (list 'let opt-bindings body) ; shadowed
           (list 'let opt-bindings (Expr body var)))))
    ((letrec ((,x* ,e*) ...) ,body)
     (if (memq var x*)
         ir ; shadowed
         (let ((opt-bindings (let loop ((xs x*) (es e*) (acc '()))
                               (if (or (null? xs) (null? es))
                                   (reverse acc)
                                   (loop (cdr xs) (cdr es) (cons (list (car xs) (Expr (car es) var)) acc))))))
           (list 'letrec opt-bindings (Expr body var)))))
    ((%cont-fun ,f-name (,params ...) ,f-body ,in-body)
     (if (eq? f-name var)
         ir ; shadowed
         (list '%cont-fun f-name params
               (Expr f-body var)
               (Expr in-body var))))
    ((%cont-call ,target ,es ...)
     (cons '%cont-call (cons target (map (lambda (e) (Expr e var)) es))))
    ((,op ,args ...)
     (if (eq? op var)
         (cons '%cont-call (cons var (map (lambda (e) (Expr e var)) args)))
         (cons (Expr op var) (map (lambda (e) (Expr e var)) args))))))

(define (contify-calls var expr)
  (contify-subst expr var))

(define (occurs-in-other-bindings? var bindings)
  (let loop ((bs bindings))
    (if (null? bs)
        #f
        (let ((b (car bs)))
          (if (eq? (car b) var)
              (loop (cdr bs))
              (if (occurs-in? var (cadr b))
                  #t
                  (loop (cdr bs))))))))

(define (has-call? var expr)
  (cond
    ((not (pair? expr)) #f)
    (else
     (if (eq? (car expr) var)
         #t
         (let loop ((es expr))
           (and (pair? es)
                (or (has-call? var (car es))
                    (loop (cdr es)))))))))

;;; -----------------------------------------------------------------------
;;; First-Class Femtopass & Picopass Rules for Contification (DSN-33-01 T5.2)
;;; -----------------------------------------------------------------------

(define-femtopass femto-contifiable?
  :reads '(lambda)
  (Expr
    ((letrec ((,x* ,e*) ...) ,body)
     (let loop ((xs x*) (es e*) (acc '()))
       (if (null? xs)
           (reverse acc)
           (let ((v (car xs))
                 (val (car es)))
             (if (contifiable-binding? v val body)
                 (loop (cdr xs) (cdr es) (cons v acc))
                 (loop (cdr xs) (cdr es) acc))))))))

(define (contify-letrec-reducible? ir x* body)
  (and (= (length x*) 1)
       (has-call? (car x*) body)
       (pair? (femto-contifiable? ir))))

(define-picopass rule-contify-letrec
  :reads '(letrec) :writes '(%cont-fun)
  (Expr
    ((letrec ((,x* ,e*) ...) ,body) (guard (contify-letrec-reducible? ir x* body))
     (let* ((contifiable-vars (femto-contifiable? ir))
            (var (car contifiable-vars))
            (val (car e*))
            (params (cadr val))
            (lbody (caddr val))
            (opt-lbody (contify-calls var lbody))
            (opt-body (contify-calls var body)))
       (list '%cont-fun var params opt-lbody opt-body)))))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: contify-opt
;;; Bottom-up Contification using fused Picopass + Femtopass cache (DSN-33-01)
;;; -----------------------------------------------------------------------
(define-pass contify-opt : L_core (ir) -> L_core ()
  (Expr : Expr (ir) -> Expr ()
    (fuse-rules :order post
      rule-contify-letrec)))

(define (contify-expr expr)
  (contify-opt expr))

;;; Pass 4c Entrypoint: Contification & local closure elimination across all expressions.
(define (contify-all form)
  (contify-opt form))
;;; =======================================================================
;;; ULisp Compiler Pass 3: Explicit Closure Conversion Nanopass
;;; Conforms to DSN-33 Architecture Specification
;;; Note: Lifts nested lambdas to flat %function definitions, transforms
;;;       closure instantiation to %make-closure, free variable accesses
;;;       to %closure-ref, and mutual recursion (letrec) to %closure-set!.
;;; =======================================================================

;;; Boxed global accumulator for lambda-lifted procedure definitions
(define *lifted-functions* (cons '() '()))

(define (reset-lifted-functions!)
  (set-car! *lifted-functions* '()))

(define (add-lifted-function! fn)
  (set-car! *lifted-functions* (cons fn (car *lifted-functions*))))

;;; Top-level functions & variables registry for %direct-call optimization
(define *top-level-fns* (cons '() '()))   ; ((name . label) ...)
(define *top-level-vars* (cons '() '()))  ; (name ...)

(define (reset-top-level-env!)
  (set-car! *top-level-fns* '())
  (set-car! *top-level-vars* '()))

(define (free-vars-with-globals expr bound)
  (let ((top-bound (append (map car* (car *top-level-fns*)) (car *top-level-vars*))))
    (free-vars expr (set-union bound top-bound))))

;;; Checks whether `var` escapes (appears in non-operator position) within `expr`.
(define (var-escapes? var expr)
  (cond
    ((symbol? expr)
     (eq? expr var))
    ((not (pair? expr))
     #f)
    (else
     (let ((op (car expr)))
       (case op
         ((quote) #f)
         ((if)
          (or (var-escapes? var (cadr expr))
              (var-escapes? var (caddr expr))
              (if (null? (cdddr expr)) #f (var-escapes? var (cadddr expr)))))
         ((begin)
          (let loop ((es (cdr expr)))
            (and (pair? es)
                 (or (var-escapes? var (car es))
                     (loop (cdr es))))))
         ((let)
          (let ((bindings (cadr expr))
                (body (caddr expr)))
            (or (let loop ((bs bindings))
                  (and (pair? bs)
                       (or (var-escapes? var (cadar bs))
                           (loop (cdr bs)))))
                (if (memq var (map car* bindings))
                    #f
                    (var-escapes? var body)))))
         ((letrec)
          (let ((bindings (cadr expr))
                (body (caddr expr)))
            (if (memq var (map car* bindings))
                #f
                (or (let loop ((bs bindings))
                      (and (pair? bs)
                           (or (var-escapes? var (cadar bs))
                               (loop (cdr bs)))))
                    (var-escapes? var body)))))
         ((lambda)
          (let ((params (cadr expr))
                (body (caddr expr)))
            (if (memq var params)
                #f
                (occurs-in? var body))))
         (else
          (if (eq? op var)
              (let loop ((as (cdr expr)))
                (and (pair? as)
                     (or (var-escapes? var (car as))
                         (loop (cdr as)))))
              (or (var-escapes? var op)
                  (let loop ((as (cdr expr)))
                    (and (pair? as)
                         (or (var-escapes? var (car as))
                             (loop (cdr as)))))))))))))

(define (binding-lambda? val)
  (and (pair? val) (eq? (car val) 'lambda)))

(define (known-fn-binding? var val rec-vars)
  (if (binding-lambda? val)
      (let* ((params (cadr val))
             (lbody (caddr val))
             (bound (append rec-vars params))
             (frees (free-vars-with-globals lbody bound)))
        (null? frees))
      #f))

;;; Variable environment lookup (linear alist, latest bindings shadow older ones)
(define (lookup-var var var-map)
  (let ((entry (assq var var-map)))
    (cond
      ((and entry (pair? (cdr entry)) (eq? (cadr entry) '%known-fn))
       ;; Known function referenced as first-class value: instantiate static closure
       (list '%make-closure-env (caddr entry)))
      (entry (cdr entry))
      ((assq var (car *top-level-fns*))
       ;; Top-level function referenced as first-class value: instantiate static closure
       (list '%make-closure-env (cdr (assq var (car *top-level-fns*)))))
      ((memq var (car *top-level-vars*))
       ;; Top-level global variable reference
       (list '%global-ref var))
      ((lir-primitive? var)
       var)
      ((or (allow-extern-symbols?) (stdlib-symbol? var))
       ;; External reference fallback: treat as external global variable
       (list '%global-ref var))
      (else var))))

(define (check-direct-call-arity op actual expr)
  (if (symbol? op)
      (let ((fixed (builtin-fixed-arity op))
            (min-a (builtin-min-arity op)))
        (cond
          ((number? fixed)
           (if (not (= actual fixed))
               (error (string-append "[ULISP ARITY ERROR] Builtin procedure '"
                                     (symbol->string op) "' expects "
                                     (number->string fixed) " argument(s), but got "
                                     (number->string actual))
                      expr)))
          ((number? min-a)
           (if (< actual min-a)
               (error (string-append "[ULISP ARITY ERROR] Builtin procedure '"
                                     (symbol->string op) "' requires at least "
                                     (number->string min-a) " argument(s), but got "
                                     (number->string actual))
                      expr)))))))

;;; Forward declarations / helpers for mutual recursion in closure conversion
(define (convert-expr expr var-map)
  (cond
    ((symbol? expr)
     (lookup-var expr var-map))
    ((not (pair? expr))
     expr)
    (else
     (let ((op (car expr)))
       (case op
         ((quote)
          expr)
         ((if)
          (let ((test (convert-expr (cadr expr) var-map))
                (then (convert-expr (caddr expr) var-map))
                (else-expr (if (null? (cdddr expr))
                               #f
                               (convert-expr (cadddr expr) var-map))))
            (list 'if test then else-expr)))
         ((begin)
          (cons 'begin (map (lambda (e) (convert-expr e var-map)) (cdr expr))))
         ((let)
          (convert-let (cadr expr) (caddr expr) var-map))
         ((letrec)
          (convert-letrec (cadr expr) (caddr expr) var-map))
         ((%cont-fun)
          (let* ((f-name (cadr expr))
                 (params (caddr expr))
                 (f-body (cadddr expr))
                 (in-body (cadr (cdddr expr)))
                 (lbody-map
                  (let loop ((ps params) (acc var-map))
                    (if (null? ps) acc
                        (loop (cdr ps) (cons (cons (car ps) (car ps)) acc)))))
                 (new-f-body (convert-expr f-body lbody-map))
                 (new-in-body (convert-expr in-body var-map)))
            (list '%cont-fun f-name params new-f-body new-in-body)))
         ((%cont-call)
          (cons '%cont-call
                (cons (cadr expr)
                      (map (lambda (e) (convert-expr e var-map)) (cddr expr)))))
         ((%with-handler)
          (list '%with-handler
                (convert-expr (cadr expr) var-map)
                (convert-expr (caddr expr) var-map)))
         ((%raw-call/cc)
          (list '%raw-call/cc
                (convert-expr (cadr expr) var-map)))
         ((%call-with-values)
          (list '%call-with-values
                (convert-expr (cadr expr) var-map)
                (convert-expr (caddr expr) var-map)))
         ((%values)
          (cons '%values
                (map (lambda (e) (convert-expr e var-map)) (cdr expr))))
         ((%make-closure %make-closure-env)
          (cons op (cons (cadr expr) (map (lambda (e) (convert-expr e var-map)) (cddr expr)))))
         ((lambda)
          (convert-lambda #f (cadr expr) (caddr expr) var-map))
         (else
          (if (symbol? op)
              (check-direct-call-arity op (length (cdr expr)) expr))
          (let ((known-entry (and (symbol? op) (assq op var-map))))
            (cond
              ;; 1. Local known function via var-map (%known-fn label)
              ((and known-entry (pair? (cdr known-entry)) (eq? (cadr known-entry) '%known-fn))
               (let ((label (caddr known-entry))
                     (args (map (lambda (e) (convert-expr e var-map)) (cdr expr))))
                 (cons '%direct-call (cons label args))))
              ;; 2. Top-level known function or extern function
              ((and (symbol? op)
                    (not known-entry)
                    (not (lir-primitive? op)))
               (cond
                 ((assq op (car *top-level-fns*))
                  (let ((label (cdr (assq op (car *top-level-fns*))))
                        (args (map (lambda (e) (convert-expr e var-map)) (cdr expr))))
                    (cons '%direct-call (cons label args))))
                 ((or (allow-extern-symbols?) (stdlib-symbol? op))
                  (let ((label (mangle-fn-label op))
                        (args (map (lambda (e) (convert-expr e var-map)) (cdr expr))))
                    (cons '%direct-call (cons label args))))
                 (else
                  (cons (convert-expr op var-map)
                        (map (lambda (e) (convert-expr e var-map)) (cdr expr))))))
              (else
               (cons (convert-expr op var-map)
                     (map (lambda (e) (convert-expr e var-map)) (cdr expr))))))))))))

;;; Convert a lambda expression, lift it as a top-level %function, and return %make-closure
(define (convert-lambda self-name params body var-map)
  (let* ((bound-vars (if self-name (cons self-name params) params))
         (frees (free-vars-with-globals body bound-vars))
         (label (unique-label-sym "L_lambda"))
         ;; Build callee inner var-map:
         ;; 1. Params shadow outer bindings (map to themselves)
         (env-p (let loop ((ps params) (acc '()))
                  (if (null? ps) acc
                      (loop (cdr ps) (cons (cons (car ps) (car ps)) acc)))))
         ;; 2. Self name (if recursive) maps to %self
         (env-s (if self-name
                    (cons (cons self-name '%self) env-p)
                    env-p))
         ;; 3. Free variables map to (%closure-ref %self idx)
         (inner-var-map
          (let loop ((fs frees) (idx 1) (acc env-s))
            (if (null? fs)
                acc
                (let ((fv (car fs)))
                  (loop (cdr fs) (+ idx 1)
                        (cons (cons fv (list '%closure-ref '%self idx)) acc))))))
         (new-body (convert-expr body inner-var-map))
         (fn-def (list '%function label params new-body)))
    (add-lifted-function! fn-def)
    ;; Instantiation expression: (%make-closure-env 'label captured-args...)
    (let ((captured-args
           (map (lambda (fv) (convert-expr fv var-map)) frees)))
      (cons '%make-closure-env (cons label captured-args)))))

;;; Convert let expression, identifying non-escaping lambdas as known functions
(define (convert-let bindings body var-map)
  (let* ((known-info
          (map (lambda (b)
                 (let ((var (car b)) (val (cadr b)))
                   (if (and (binding-lambda? val)
                            (null? (free-vars-with-globals (caddr val) (cadr val)))
                            (not (var-escapes? var body))
                            (not (var-escapes? var (caddr val))))
                       (let ((label (unique-label-sym (string-append "L_known_" (sanitize-label-str (symbol->string var))))))
                         (list var label val))
                       #f)))
               bindings))
         (known-env-entries
          (let loop ((kis known-info) (acc '()))
            (cond
              ((null? kis) (reverse acc))
              ((car kis)
               (let ((ki (car kis)))
                 (loop (cdr kis) (cons (cons (car ki) (list '%known-fn (cadr ki))) acc))))
              (else (loop (cdr kis) acc))))))
    ;; Lift each known function
    (let loop ((kis known-info))
      (if (pair? kis)
          (begin
            (if (car kis)
                (let* ((ki (car kis))
                       (label (cadr ki))
                       (val (caddr ki))
                       (params (cadr val))
                       (lbody (caddr val))
                       (inner-map (append (map (lambda (p) (cons p p)) params)
                                          (append known-env-entries var-map)))
                       (new-lbody (convert-expr lbody inner-map))
                       (fn-def (list '%function label params new-lbody)))
                  (if (unboxed-fn? (car ki))
                      (record-unboxed-fn! label))
                  (if (unboxed-ret-fn? (car ki))
                      (record-unboxed-ret-fn! label))
                  (add-lifted-function! fn-def)))
            (loop (cdr kis)))))
    ;; Prepare let-bindings for non-known bindings
    (let* ((normal-bindings
            (let loop ((bs bindings) (kis known-info) (acc '()))
              (cond
                ((null? bs) (reverse acc))
                ((not (car kis))
                 (let ((b (car bs)))
                   (loop (cdr bs) (cdr kis) (cons (list (car b) (convert-expr (cadr b) var-map)) acc))))
                (else
                 ;; Non-escaping known function: omit binding!
                 (loop (cdr bs) (cdr kis) acc)))))
           (body-var-map
            (let loop ((bs normal-bindings) (acc (append known-env-entries var-map)))
              (if (null? bs) acc
                  (let ((v (caar bs)))
                    (loop (cdr bs) (cons (cons v v) acc))))))
           (new-body (convert-expr body body-var-map)))
      (if (null? normal-bindings)
          new-body
          (list 'let normal-bindings new-body)))))

;;; ;;; Convert letrec expression into direct known function calls + %make-closure backpatching
(define (convert-letrec bindings body var-map)
  (let* ((rec-vars (map car* bindings))
         (rec-fn-vars (let loop ((bs bindings) (acc '()))
                        (if (null? bs) (reverse acc)
                            (let ((b (car bs)))
                              (if (binding-lambda? (cadr b))
                                  (loop (cdr bs) (cons (car b) acc))
                                  (loop (cdr bs) acc))))))
         ;; 1. Identify known functions: must be a closed lambda, and must NOT escape from body or any binding!
         (known-info
          (map (lambda (b)
                 (let ((var (car b)) (val (cadr b)))
                   (if (known-fn-binding? var val rec-fn-vars)
                       (let ((esc? (or (var-escapes? var body)
                                       (let loop ((bs bindings))
                                         (and (pair? bs)
                                              (or (let* ((other-b (car bs))
                                                         (other-var (car other-b))
                                                         (other-val (cadr other-b)))
                                                    (if (eq? other-var var)
                                                        (var-escapes? var (caddr other-val))
                                                        (if (binding-lambda? other-val)
                                                            (var-escapes? var (caddr other-val))
                                                            (var-escapes? var other-val))))
                                                  (loop (cdr bs))))))))
                         (if esc?
                             #f
                             (let ((label (unique-label-sym (string-append "L_known_" (sanitize-label-str (symbol->string var))))))
                               (list var label val))))
                       #f)))
               bindings))
         (known-env-entries
          (let loop ((kis known-info) (acc '()))
            (cond
              ((null? kis) (reverse acc))
              ((car kis)
               (let ((ki (car kis)))
                 (loop (cdr kis) (cons (cons (car ki) (list '%known-fn (cadr ki))) acc))))
              (else (loop (cdr kis) acc))))))
    ;; 2. Convert and lift each known function
    (let loop ((kis known-info))
      (if (pair? kis)
          (begin
            (if (car kis)
                (let* ((ki (car kis))
                       (label (cadr ki))
                       (val (caddr ki))
                       (params (cadr val))
                       (lbody (caddr val))
                       (inner-map
                        (append (map (lambda (p) (cons p p)) params)
                                (append known-env-entries var-map)))
                       (new-lbody (convert-expr lbody inner-map))
                       (fn-def (list '%function label params new-lbody)))
                  (if (unboxed-fn? (car ki))
                      (record-unboxed-fn! label))
                  (if (unboxed-ret-fn? (car ki))
                      (record-unboxed-ret-fn! label))
                  (add-lifted-function! fn-def)))
            (loop (cdr kis)))))
    ;; 3. Filter non-known bindings and process them with original closure conversion
    (let* ((non-known-bindings
            (let loop ((bs bindings) (kis known-info) (acc '()))
              (cond
                ((null? bs) (reverse acc))
                ((not (car kis))
                 (loop (cdr bs) (cdr kis) (cons (car bs) acc)))
                (else
                 (loop (cdr bs) (cdr kis) acc)))))
           (base-outer-var-map (append known-env-entries var-map)))
      (if (null? non-known-bindings)
          ;; Fast path: ALL bindings are known non-escaping functions! ZERO closures allocated!
          (convert-expr body base-outer-var-map)
          ;; Mixed or escaping path: standard closure conversion for non-known bindings
          (let* ((outer-var-map
                  (let loop ((rvs rec-vars) (acc base-outer-var-map))
                    (cond
                      ((null? rvs) acc)
                      ((assq (car rvs) known-env-entries)
                       (loop (cdr rvs) acc))
                      (else
                       (loop (cdr rvs) (cons (cons (car rvs) (car rvs)) acc))))))
                 (processed-bindings
                  (map (lambda (b)
                         (let ((var (car b)) (val (cadr b)))
                           (if (and (pair? val) (eq? (car val) 'lambda))
                               (let* ((params (cadr val))
                                      (lbody (caddr val))
                                      (bound (cons var params))
                                      (raw-frees (free-vars-with-globals lbody bound))
                                      ;; Exclude known-fn bindings from closure environment since they are statically lifted
                                      (frees (let loop-kf ((fs raw-frees) (acc '()))
                                               (cond
                                                 ((null? fs) (reverse acc))
                                                 ((assq (car fs) known-env-entries)
                                                  (loop-kf (cdr fs) acc))
                                                 (else
                                                  (loop-kf (cdr fs) (cons (car fs) acc))))))
                                      (label (unique-label-sym "L_lambda"))
                                      (env-p (map (lambda (p) (cons p p)) params))
                                      (env-s (cons (cons var '%self) env-p))
                                      (inner-var-map
                                       (let loop ((fs frees) (idx 1) (acc (append env-s known-env-entries)))
                                         (if (null? fs) acc
                                             (let ((fv (car fs)))
                                               (loop (cdr fs) (+ idx 1)
                                                     (cons (cons fv (list '%closure-ref '%self idx)) acc))))))
                                      (new-lbody (convert-expr lbody inner-var-map))
                                      (fn-def (list '%function label params new-lbody)))
                                 (add-lifted-function! fn-def)
                                 (let ((init-args
                                        (map (lambda (fv)
                                               (if (memq fv rec-vars) #f (convert-expr fv outer-var-map)))
                                             frees)))
                                   (list var (cons '%make-closure-env (cons label init-args)) frees)))
                               (list var (convert-expr val outer-var-map) '()))))
                       non-known-bindings))
                 (let-bindings
                  (map (lambda (pb) (list (car pb) (cadr pb))) processed-bindings))
                 (backpatches
                  (let loop-b ((pbs processed-bindings) (acc '()))
                    (if (null? pbs) (reverse acc)
                        (let* ((pb (car pbs))
                               (var (car pb))
                               (frees (caddr pb))
                               (patches
                                (let loop-f ((fs frees) (idx 1) (p-acc '()))
                                  (if (null? fs) (reverse p-acc)
                                      (let ((fv (car fs)))
                                        (if (and (memq fv rec-vars) (not (assq fv known-env-entries)))
                                            (loop-f (cdr fs) (+ idx 1)
                                                    (cons (list '%closure-set! var idx fv) p-acc))
                                            (loop-f (cdr fs) (+ idx 1) p-acc)))))))
                          (loop-b (cdr pbs) (append (reverse patches) acc))))))
                 (new-body (convert-expr body outer-var-map)))
            (if (null? backpatches)
                (list 'let let-bindings new-body)
                (list 'let let-bindings
                      (cons 'begin (append backpatches (list new-body))))))))))

;;; Pass 5 Entrypoint: Takes Canonical Core AST or (%program defs main-expr), returns (%program functions main-expr)
(define (closure-convert ast)
  (reset-lifted-functions!)
  (reset-top-level-env!)
  (let ((res
         (if (and (pair? ast) (eq? (car ast) '%program))
             (let* ((defs (cadr ast))
                    (main-expr (caddr ast)))
               ;; 1. Scan defs and populate *top-level-fns* and *top-level-vars*
               (let loop ((ds defs))
                 (if (pair? ds)
                     (begin
                       (let ((d (car ds)))
                         (if (and (pair? d) (eq? (car d) 'define))
                             (let ((name (cadr d))
                                   (val (caddr d)))
                               (if (and (pair? val) (eq? (car val) 'lambda))
                                   (if (not (assq name (car *top-level-fns*)))
                                       (let ((label (mangle-fn-label name)))
                                         (set-car! *top-level-fns* (cons (cons name label) (car *top-level-fns*)))))
                                   (if (not (memq name (car *top-level-vars*)))
                                       (set-car! *top-level-vars* (cons name (car *top-level-vars*))))))))
                       (loop (cdr ds)))))
               ;; 2. Convert each top-level function and add to lifted-functions
               (let loop ((ds defs))
                 (if (pair? ds)
                     (begin
                       (let ((d (car ds)))
                         (if (and (pair? d) (eq? (car d) 'define))
                             (let ((name (cadr d))
                                   (val (caddr d)))
                               (if (and (pair? val) (eq? (car val) 'lambda))
                                   (let* ((label (cdr (assq name (car *top-level-fns*))))
                                          (params (cadr val))
                                          (lbody (caddr val))
                                          (inner-map (map (lambda (p) (cons p p)) params))
                                          (new-body (convert-expr lbody inner-map))
                                          (fn-def (list '%function label params new-body)))
                                     (if (unboxed-fn? name)
                                         (record-unboxed-fn! label))
                                     (if (unboxed-ret-fn? name)
                                         (record-unboxed-ret-fn! label))
                                     (add-lifted-function! fn-def))))))
                       (loop (cdr ds)))))
               ;; 3. Convert variable inits and main-expr
               (let* ((inits (let loop ((ds defs) (acc '()))
                               (if (null? ds)
                                   (reverse acc)
                                   (let ((d (car ds)))
                                     (if (and (pair? d) (eq? (car d) 'define) (not (assq (cadr d) (car *top-level-fns*))))
                                         (loop (cdr ds) (cons (list '%global-set! (cadr d) (convert-expr (caddr d) '())) acc))
                                         (loop (cdr ds) acc))))))
                      (conv-main (convert-expr main-expr '()))
                      (final-main (if (null? inits) conv-main (cons 'begin (append inits (list conv-main))))))
                 (list '%program (reverse (car *lifted-functions*)) final-main)))
             (let ((main-expr (convert-expr ast '())))
               (list '%program (reverse (car *lifted-functions*)) main-expr)))))
    (if (and (verifier-enabled?) (assq 'L_lifted (nanopass-get-languages)))
        (if (not (nanopass-ast-valid? 'L_lifted res))
            (verifier-error 'closure "Pass 110 output violates L_lifted schema invariants" res)))
    res))
;;; =======================================================================
;;; ULisp Compiler Pass 6b: TBAA & Escape Analysis Nanopass
;;; Conforms to DSN-33 Section 8.5 & Issue #525
;;; Based on Cornell CS 6120 (Lesson 10 Alias Analysis) & Bacon's Unified Theory
;;;
;;; Features:
;;; 1. Type-Based Alias Analysis (TBAA): Proves non-interference between
;;;    disjoint Scheme type heaps (Pair, Closure, Vector, Raw memory).
;;;    Enables Redundant Load Elimination (RLE) across stores of disjoint types.
;;; 2. Flow-Sensitive Escape Analysis: Identifies local non-escaping `cons`
;;;    and `%make-closure` instances and promotes them to stack-allocated objects
;;;    (`%stack-cons`, `%make-stack-closure`), completely bypassing heap bump allocation.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; Part 1: Type-Based Alias Analysis (TBAA) & Redundant Load Elimination
;;; -----------------------------------------------------------------------

;;; Returns the TBAA type class of a memory expression
;;; Returns 'pair, 'closure, 'vector, 'raw, or 'unknown
(define (tbaa-type-class expr)
  (if (not (pair? expr))
      'unknown
      (case (car expr)
        ((annotate) (tbaa-type-class (caddr expr)))
        ((car cdr set-car! set-cdr!) 'pair)
        ((%closure-ref %closure-set!) 'closure)
        ((vector-ref vector-set! %atomic-cas!) 'vector)
        ((bytevector-u8-ref bytevector-u8-set!) 'bytevector)
        ((%raw-load %raw-load-u8 %raw-store!) 'raw)
        (else 'unknown))))

;;; Predicate: Are two memory operations provably disjoint by type?
(define (tbaa-disjoint? t1 t2)
  (cond
    ((or (eq? t1 'unknown) (eq? t2 'unknown)) #f)
    ((eq? t1 t2) #f)
    (else #t)))

;;; Invalidate cached loads affected by a store expression
;;; If store is of type 'T, all cached loads of type 'T (or unknown) are invalidated,
;;; but cached loads of disjoint types are PRESERVED!
(define (tbaa-invalidate-loads store-expr avail-loads)
  (let ((st-type (tbaa-type-class store-expr)))
    (if (eq? st-type 'unknown)
        ;; Unknown store (e.g. arbitrary function call): conservative purge
        '()
        ;; Disjoint type store: retain all loads whose type class is disjoint
        (let loop ((loads avail-loads) (acc '()))
          (if (null? loads)
              (reverse acc)
              (let* ((entry (car loads))
                     (load-type (cadr entry)))
                (if (tbaa-disjoint? st-type load-type)
                    (loop (cdr loads) (cons entry acc))
                    (loop (cdr loads) acc))))))))

;;; Search for an available load matching (op target index/offset)
;;; Entry format: (load-expr type-class var-name)
(define (tbaa-find-load op-expr avail-loads)
  (let loop ((loads avail-loads))
    (if (null? loads)
        #f
        (let ((entry (car loads)))
          (if (equal? (car entry) op-expr)
              (caddr entry)
              (loop (cdr loads)))))))

;;; -----------------------------------------------------------------------
;;; Part 2: Flow-Sensitive Escape Analysis (Monotone Framework)
;;; -----------------------------------------------------------------------

(define *stack-alloc-attr* (string->symbol ":stack-alloc"))

;;; Lattice for escape analysis: Powerset of escaped variable symbols
(define *escape-lattice* (make-powerset-lattice 'escape-analysis #f))
(define (escape-lattice) *escape-lattice*)

;;; Collect all variables that escape a given expression context
;;; An object escapes if:
;;; - It is returned from the function (in tail position)
;;; - It is passed as an argument to an external call (non-primitive / escaping op)
;;; - It is stored into another escaping data structure or global
;;; Employs the Monotone Framework Lattice Join to ensure set deduplication and monotonicity.
(define (collect-escaped-vars expr is-tail)
  (let ((lat (escape-lattice)))
    (cond
      ((symbol? expr)
       (if is-tail (list expr) (lattice-bottom lat)))
      ((not (pair? expr))
       (lattice-bottom lat))
      (else
       (let ((op (car expr)))
         (case op
           ((quote) (lattice-bottom lat))
           ((annotate)
            (collect-escaped-vars (caddr expr) is-tail))
           ((if)
            (let ((test-esc (collect-escaped-vars (cadr expr) #f))
                  (then-esc (collect-escaped-vars (caddr expr) is-tail))
                  (else-esc (if (null? (cdddr expr))
                                (lattice-bottom lat)
                                (collect-escaped-vars (cadddr expr) is-tail))))
              (lattice-join lat test-esc (lattice-join lat then-esc else-esc))))
           ((begin)
            (let loop ((es (cdr expr)) (acc (lattice-bottom lat)))
              (if (null? es)
                  acc
                  (let ((tail? (and is-tail (null? (cdr es)))))
                    (loop (cdr es)
                          (lattice-join lat acc (collect-escaped-vars (car es) tail?)))))))
         ((let)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (b-escs
                  (let loop ((bs bindings) (acc (lattice-bottom lat)))
                    (if (null? bs) acc
                        (loop (cdr bs)
                              (lattice-join lat acc (collect-escaped-vars (cadar bs) #f))))))
                 (body-escs (collect-escaped-vars body is-tail)))
            (lattice-join lat b-escs body-escs)))
         ;; Safe local destructors: car, cdr, %closure-ref, null?, pair? do NOT cause target to escape
         ((car cdr null? pair? not zero? fixnum? integer? string? boolean?)
          (collect-escaped-vars (cadr expr) #f))
         ((%closure-ref %global-ref)
          (lattice-bottom lat))
         ((%direct-call)
          (let loop ((args (cddr expr)) (acc (lattice-bottom lat)))
            (if (null? args) acc
                (let ((arg (car args)))
                  (loop (cdr args)
                        (if (symbol? arg)
                            (lattice-join lat (list arg) acc)
                            (lattice-join lat (collect-escaped-vars arg #f) acc)))))))
         ((%global-set!)
          (let ((stored-val (caddr expr)))
            (if (symbol? stored-val)
                (list stored-val)
                (collect-escaped-vars stored-val #f))))
         ;; Mutations: if storing a value into a heap object, the stored value escapes!
         ((set-car! set-cdr!)
          (let ((stored-val (caddr expr)))
            (if (symbol? stored-val)
                (lattice-join lat (list stored-val) (collect-escaped-vars (cadr expr) #f))
                (collect-escaped-vars stored-val #f))))
         ((vector-set!)
          (let ((stored-val (cadddr expr)))
            (if (symbol? stored-val)
                (lattice-join lat (list stored-val)
                              (lattice-join lat (collect-escaped-vars (cadr expr) #f)
                                            (collect-escaped-vars (caddr expr) #f)))
                (lattice-join lat (collect-escaped-vars (cadr expr) #f)
                              (lattice-join lat (collect-escaped-vars (caddr expr) #f)
                                            (collect-escaped-vars stored-val #f))))))
         ;; Standard function call or primitive: all arguments escape unless known safe
         (else
          (let ((args-esc
                 (let loop ((args (cdr expr)) (acc (lattice-bottom lat)))
                   (if (null? args) acc
                       (let ((arg (car args)))
                         (loop (cdr args)
                               (if (symbol? arg)
                                   (lattice-join lat (list arg) acc)
                                   (lattice-join lat (collect-escaped-vars arg #f) acc))))))))
            (if (symbol? op)
                args-esc
                (lattice-join lat (collect-escaped-vars op #f) args-esc))))))))))

;;; -----------------------------------------------------------------------
;;; Part 3: AST Transformation (Stack Promotion & Redundant Load Elimination)
;;; -----------------------------------------------------------------------

(define (alias-escape-transform-expr expr escaped-set avail-loads)
  (cond
    ((not (pair? expr)) expr)
    (else
     (let ((op (car expr)))
       (case op
         ((quote) expr)
         ((annotate)
          (list 'annotate (cadr expr)
                (alias-escape-transform-expr (caddr expr) escaped-set avail-loads)))

         ;; TBAA Load: (car p), (cdr p), (%closure-ref c i)
         ((car cdr %closure-ref)
          (let ((cached-var (tbaa-find-load expr avail-loads)))
            (if cached-var
                cached-var
                (cons op (map (lambda (e) (alias-escape-transform-expr e escaped-set avail-loads))
                              (cdr expr))))))

         ;; TBAA Store: invalidates only non-disjoint types
         ((set-car! set-cdr! %closure-set! vector-set! bytevector-u8-set! %raw-store! %atomic-cas! %memory-fence)
          (cons op (map (lambda (e) (alias-escape-transform-expr e escaped-set avail-loads))
                        (cdr expr))))

         ((%direct-call)
          (cons '%direct-call
                (cons (cadr expr)
                      (map (lambda (e) (alias-escape-transform-expr e escaped-set avail-loads))
                           (cddr expr)))))

         ((%global-ref)
          expr)

         ((%global-set!)
          (list '%global-set! (cadr expr)
                (alias-escape-transform-expr (caddr expr) escaped-set avail-loads)))

         ((if)
          (let* ((test (alias-escape-transform-expr (cadr expr) escaped-set avail-loads))
                 (then (alias-escape-transform-expr (caddr expr) escaped-set avail-loads))
                 (else-part (if (null? (cdddr expr))
                                #f
                                (alias-escape-transform-expr (cadddr expr) escaped-set avail-loads))))
            (list 'if test then else-part)))

         ((begin)
          (let loop ((es (cdr expr)) (cur-loads avail-loads) (acc '()))
            (if (null? es)
                (cons 'begin (reverse acc))
                (let* ((e (car es))
                       (transformed (alias-escape-transform-expr e escaped-set cur-loads))
                       (next-loads
                        (if (and (pair? e) (memq (car e) '(set-car! set-cdr! %closure-set! vector-set! bytevector-u8-set! %raw-store! %atomic-cas! %memory-fence)))
                            (tbaa-invalidate-loads e cur-loads)
                            cur-loads)))
                  (loop (cdr es) next-loads (cons transformed acc))))))

         ((let)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 ;; Process bindings and detect Stack Allocations
                 (trans-bindings
                  (map
                   (lambda (b)
                     (let* ((var (car b))
                            (val (cadr b))
                            (escapes? (memq var escaped-set)))
                       (cond
                         ;; Non-escaping pair: promote to %stack-cons
                         ((and (not escapes?) (pair? val) (eq? (car val) 'cons))
                          (list var (cons '%stack-cons
                                          (map (lambda (e) (alias-escape-transform-expr e escaped-set avail-loads))
                                               (cdr val)))))
                         ;; Non-escaping %make-closure-env: promote to (annotate #:stack-alloc (%make-closure-env ...))
                         ((and (not escapes?) (pair? val) (eq? (car val) '%make-closure-env))
                          (list var (list 'annotate *stack-alloc-attr*
                                          (cons '%make-closure-env
                                                (map (lambda (e) (alias-escape-transform-expr e escaped-set avail-loads))
                                                     (cdr val))))))
                         ;; Non-escaping closure: promote to %make-stack-closure
                         ((and (not escapes?) (pair? val) (eq? (car val) '%make-closure))
                          (list var (cons '%make-stack-closure
                                          (map (lambda (e) (alias-escape-transform-expr e escaped-set avail-loads))
                                               (cdr val)))))
                         (else
                          (list var (alias-escape-transform-expr val escaped-set avail-loads))))))
                   bindings))
                 ;; Record available loads from bindings
                 (new-avail-loads
                  (let loop ((bs trans-bindings) (cur-loads avail-loads))
                    (if (null? bs) cur-loads
                        (let* ((b (car bs))
                               (v (car b))
                               (raw-rhs (cadr b))
                               (rhs (if (and (pair? raw-rhs) (eq? (car raw-rhs) 'annotate))
                                        (caddr raw-rhs)
                                        raw-rhs)))
                          (if (and (pair? rhs) (memq (car rhs) '(car cdr %closure-ref)))
                              (let ((tc (tbaa-type-class rhs)))
                                (loop (cdr bs) (cons (list rhs tc v) cur-loads)))
                              (loop (cdr bs) cur-loads))))))
                 (new-body (alias-escape-transform-expr body escaped-set new-avail-loads)))
            (list 'let trans-bindings new-body)))

         ((%cont-fun)
          (let* ((f-name (cadr expr))
                 (params (caddr expr))
                 (f-body (cadddr expr))
                 (in-body (cadr (cdddr expr)))
                 (f-esc (collect-escaped-vars f-body #t))
                 (new-f-body (alias-escape-transform-expr f-body f-esc avail-loads))
                 (new-in-body (alias-escape-transform-expr in-body escaped-set avail-loads)))
            (list '%cont-fun f-name params new-f-body new-in-body)))

         (else
          (cons (alias-escape-transform-expr op escaped-set avail-loads)
                (map (lambda (e) (alias-escape-transform-expr e escaped-set avail-loads))
                     (cdr expr)))))))))

;;; Optimize a single procedure or top-level expression
(define (alias-escape-optimize-function fn-def)
  (let* ((label (cadr fn-def))
         (params (caddr fn-def))
         (body (cadddr fn-def))
         (escaped-set (collect-escaped-vars body #t))
         (optimized-body (alias-escape-transform-expr body escaped-set '())))
    (list '%function label params optimized-body)))

;;; Pass 6b Main Entrypoint
;;; Input: (%program functions main-expr)
;;; Output: (%program optimized-functions optimized-main-expr)
(define (alias-escape-all program)
  (if (and (pair? program) (eq? (car program) '%program))
      (let* ((functions (cadr program))
             (main-expr (caddr program))
             (opt-functions (map alias-escape-optimize-function functions))
             (main-esc (collect-escaped-vars main-expr #t))
             (opt-main (alias-escape-transform-expr main-expr main-esc '())))
        (list '%program opt-functions opt-main))
      ;; Fallback if single expression
      (let ((esc (collect-escaped-vars program #t)))
        (alias-escape-transform-expr program esc '()))))
;;; =======================================================================
;;; ULisp Compiler: Low-Level IR (LIR) Language Specifications
;;; (L_lir_core -> L_lir_managed, L_lir_raw -> L_lir_canonical)
;;; Conforms to DSN-33, DSN-38 Architecture Specifications & Issues #593, #753, #826, #835
;;; =======================================================================
;;; Formal intermediate language definitions using Nanopass DSL (define-language):
;;; - L_lir_core:      Pure Core Machine LIR without GC, tagging or managed runtime
;;;                    opcodes, serving as the target for unmanaged/C frontends and
;;;                    the lowered output of Pass 131.
;;; - L_lir_managed:   Managed Runtime Dialect LIR extending L_lir_core with high-level
;;;                    GC, allocation (%alloc), tagging (%box-*), and safepoint opcodes.
;;; - L_lir_raw:       Initial LIR emitted by Pass 130 before branch fusion and
;;;                    peephole normalization.
;;; - L_lir_canonical: Canonical LIR after Pass 128 (branch fusion) and Pass 133
;;;                    (peephole optimization / dead code elimination), serving
;;;                    as the contract for low-level code generation backends.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. L_lir_core: Pure Core Machine LIR (Issue #835)
;;; -----------------------------------------------------------------------
(define-language L_lir_core
  (entry Program)
  (terminals
    (symbol (x lbl var cond_op sp_lbl mty))
    (integer (n offset shift frame_size tag si cnt bitmap line col al_val))
    (string (str fn_name))
    (boolean (bool_val)))
  (Register (reg)
    %rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp
    %r8  %r9  %r10 %r11 %r12 %r13 %r14 %r15 %al
    %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
    %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15
    (%reg x)
    (%reg mty x)
    (%freg x))
  (StackSlot (stk)
    (%stack offset))
  (MemRef (mem)
    (%mem reg offset)
    (%mem reg reg))
  (LValue (lval)
    reg
    stk
    mem)
  (Operand (opnd)
    lval
    n
    lbl)
  (AsmOutSpec (asm_out)
    (lval str)
    (x str)
    (x str lval))
  (AsmInSpec (asm_in)
    (opnd str)
    (x str opnd))
  (AsmClobber (asm_clob)
    str
    x)
  (AsmClause (asm_clause)
    (:outputs (asm_out ...))
    (:inputs (asm_in ...))
    (:clobbers (asm_clob ...))
    (:volatile? bool_val))
  (Inst (inst)
    ;; Debug & Source Location
    (%loc n line col)

    ;; Control Flow
    (%label lbl)
    (%block lbl (x ...) inst ...)
    (%jump lbl)
    (%jump lbl (opnd ...))
    (%jump-if-false reg lbl)
    (%jump-if-false reg lbl (opnd ...))
    (%jump-if reg lbl1 (opnd1 ...) lbl2 (opnd2 ...))
    (%jump-cond cond_op lbl)
    (%jump-cond str lbl)
    (%jump-if-zero lbl)
    (%direct-jump lbl)
    (%switch opnd lbl (opnd ...) (sc ...))
    (%switch opnd lbl (sc ...))
    (%return)
    (%return opnd)

    ;; Calls & ABI
    (%c-call fn_name shift)
    (%c-call fn_name shift al_val)
    (%call-foreign fn_name shift)
    (%call-foreign fn_name shift al_val)
    (%call-indirect reg shift)
    (%call-indirect reg shift al_val)
    (%call-closure shift)
    (%call-closure shift sp_lbl)
    (%call-closure shift str)
    (%direct-call lbl shift)
    (%direct-call lbl shift sp_lbl)
    (%direct-call lbl shift str)
    (%dispatch-consumer si1 si2 shift)

    ;; Memory & Data Transfer
    (%mov lval opnd)
    (%load reg1 reg2 offset)
    (%store reg1 offset opnd)
    (%load-byte-zx reg1 reg2 offset)
    (%store-byte reg1 offset opnd)
    (%push reg)
    (%pop reg)
    (%code-ref reg lbl)
    (%str-ref reg lbl)
    (%global-ref reg var)
    (%global-addr reg var)
    (%global-set! var reg)

    ;; Arithmetic / Logic / Primitives
    (%add opnd1 opnd2)
    (%raw-add opnd1 opnd2)
    (%sub opnd1 opnd2)
    (%raw-sub opnd1 opnd2)
    (%imul opnd1 opnd2)
    (%raw-mul opnd1 opnd2)
    (%neg opnd)
    (%inc opnd)
    (%cqo)
    (%idiv opnd)
    (%shl opnd shift)
    (%shl opnd %rcx)
    (%shr opnd shift)
    (%shr opnd %rcx)
    (%shr reg opnd shift)
    (%shr reg opnd %rcx)
    (%sar opnd shift)
    (%sar opnd %rcx)
    (%bit-and opnd1 opnd2)
    (%bit-or opnd1 opnd2)
    (%bit-xor opnd1 opnd2)
    (%cmp opnd1 opnd2)
    (%raw-cmp opnd1 opnd2)
    (%set-boolean opnd cond_op)

    ;; Overflow-Checked Arithmetic & Unsigned Operations (Issue #828)
    (%add-overflow reg1 reg2 opnd1 opnd2)
    (%sub-overflow reg1 reg2 opnd1 opnd2)
    (%mul-overflow reg1 reg2 opnd1 opnd2)
    (%udiv opnd)
    (%udiv reg opnd1 opnd2)
    (%urem opnd)
    (%urem reg opnd1 opnd2)
    (%setb reg)
    (%setb reg opnd1 opnd2)
    (%setbe reg)
    (%setbe reg opnd1 opnd2)
    (%seta reg)
    (%seta reg opnd1 opnd2)
    (%setae reg)
    (%setae reg opnd1 opnd2)
    (%load-typed mty reg1 reg2 offset)
    (%store-typed mty reg1 offset opnd)
    (%fmov reg1 reg2)
    (%fadd opnd1 opnd2)
    (%fsub opnd1 opnd2)
    (%fmul opnd1 opnd2)
    (%fdiv opnd1 opnd2)
    (%fcmp opnd1 opnd2)
    (%fneg mty reg1 opnd2)
    (%fpext mty reg1 opnd2)
    (%fptrunc mty reg1 opnd2)
    (%sitofp reg1 opnd2)
    (%uitofp reg1 opnd2)
    (%fptosi reg1 opnd2)
    (%fptoui reg1 opnd2)
    (%fcmp-oeq reg1 opnd2 opnd3)
