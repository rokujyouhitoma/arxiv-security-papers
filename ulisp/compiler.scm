  (emit "    mov [r10], r11")
  (emit "    inc r9")
  (emit "    jmp .L_gc_minor_remset_loop")
  ;; Cheney scan mature space
  (emit ".L_gc_minor_cheney:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov qword ptr [r11 + 184], 0")     ; pending_ephemerons = 0
  (emit ".L_gc_minor_cheney_loop:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    cmp rbx, [r11 + 40]")
  (emit "    jae .L_gc_minor_ephem_resolve")
  (emit "    mov r10, [rbx]")
  (emit "    mov rax, r10")
  (emit "    shr rax, 2")
  (emit "    mov rdx, rax")
  (emit "    and rdx, 255")
  (emit "    mov r13, rax")
  (emit "    shr r13, 16")
  (emit "    add r13, 8")
  (emit "    lea r14, [rbx + 8]")
  (emit "    cmp rdx, 1")
  (emit "    jne .L_gc_minor_check_closure")
  (emit "    mov rdi, [r14]")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    pop rbx")
  (emit "    mov [r14], rax")
  (emit "    mov rdi, [r14 + 8]")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    pop rbx")
  (emit "    mov [r14 + 8], rax")
  (emit "    jmp .L_gc_minor_cheney_next")
  (emit ".L_gc_minor_check_closure:")
  (emit "    cmp rdx, 2")
  (emit "    jne .L_gc_minor_check_vector")
  (emit "    mov rax, r10")
  (emit "    shr rax, 2")
  (emit "    shr rax, 8")
  (emit "    and rax, 255")
  (emit "    cmp rax, 1")
  (emit "    jle .L_gc_minor_cheney_next")
  (emit "    mov r15, 1")
  (emit ".L_gc_minor_closure_fields:")
  (emit "    cmp r15, rax")
  (emit "    jae .L_gc_minor_cheney_next")
  (emit "    mov rdi, [r14 + r15*8]")
  (emit "    push rax")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    push r15")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop r15")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rbx")
  (emit "    pop rax")
  (emit "    mov [r14 + r15*8], r11")
  (emit "    inc r15")
  (emit "    jmp .L_gc_minor_closure_fields")
  (emit ".L_gc_minor_check_vector:")
  (emit "    cmp rdx, 5")
  (emit "    jne .L_gc_minor_cheney_next")
  (emit "    mov rax, [r14]")
  (emit "    shr rax, 2")                       ; vec_len
  (emit "    cmp rax, 5")
  (emit "    jb .L_gc_minor_vector_normal")
  (emit "    mov rcx, [r14 + 8]")               ; slot 0 (tag symbol)
  (let ((ephem-sym-id (intern-symbol '%%record-type-<ephemeron>)))
    (emit (string-append "    mov rdx, " (number->string ephem-sym-id))))
  (emit "    cmp rcx, rdx")
  (emit "    jne .L_gc_minor_vector_normal")
  ;; Ephemeron: enqueue into intrusive pending list at [r11 + 184]
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov rcx, [r11 + 184]")
  (emit "    mov [r14 + 40], rcx")              ; slot 4 (next) = pending_head
  (emit "    mov [r11 + 184], r14")             ; pending_head = this ephemeron
  (emit "    jmp .L_gc_minor_cheney_next")
  (emit ".L_gc_minor_vector_normal:")
  (emit "    test rax, rax")
  (emit "    jle .L_gc_minor_cheney_next")
  (emit "    xor r15, r15")
  (emit ".L_gc_minor_vector_elems:")
  (emit "    cmp r15, rax")
  (emit "    jae .L_gc_minor_cheney_next")
  (emit "    mov rdi, [r14 + 8 + r15*8]")
  (emit "    push rax")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    push r15")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop r15")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rbx")
  (emit "    pop rax")
  (emit "    mov [r14 + 8 + r15*8], r11")
  (emit "    inc r15")
  (emit "    jmp .L_gc_minor_vector_elems")
  (emit ".L_gc_minor_cheney_next:")
  (emit "    add rbx, r13")
  (emit "    jmp .L_gc_minor_cheney_loop")
  ;; Fixed-point ephemeron resolution for Minor GC
  (emit ".L_gc_minor_ephem_resolve:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov r8, [r11 + 184]")              ; curr = pending_ephemerons
  (emit "    xor r9, r9")                       ; prev = 0
  (emit ".L_gc_minor_ephem_loop:")
  (emit "    test r8, r8")
  (emit "    jz .L_gc_minor_ephem_break_all")   ; fixed-point reached: break all remaining
  (emit "    mov r10, [r8 + 40]")               ; next = curr->next
  (emit "    mov rdi, [r8 + 16]")               ; key = curr->key
  ;; Check if key is reachable in Generational Minor GC
  (emit "    test dil, 1")                      ; is key a heap pointer?
  (emit "    jz .L_gc_minor_ephem_found_reachable") ; immediate -> reachable!
  (emit "    mov rax, rdi")
  (emit "    and rax, -8")                      ; orig = untag(key)
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    cmp rax, [r11 + 0]")               ; < nursery_base?
  (emit "    jb .L_gc_minor_ephem_found_reachable") ; outside nursery (already mature) -> reachable!
  (emit "    mov rdx, [r11 + 0]")
  (emit "    add rdx, [r11 + 8]")               ; nursery_base + nursery_size
  (emit "    cmp rax, rdx")
  (emit "    jae .L_gc_minor_ephem_found_reachable") ; outside nursery -> reachable!
  ;; Inside nursery: check if promoted to mature space
  (emit "    mov rdx, [rax - 8]")               ; hdr = key->header
  (emit "    test dl, 1")                       ; is hdr a forwarding pointer?
  (emit "    jz .L_gc_minor_ephem_next")        ; not promoted yet -> not reachable
  (emit "    mov rax, rdx")
  (emit "    and rax, -8")                      ; promoted_addr
  (emit "    cmp rax, [r11 + 16]")              ; >= mature_from?
  (emit "    jb .L_gc_minor_ephem_next")
  (emit "    mov rcx, [r11 + 16]")
  (emit "    add rcx, [r11 + 32]")              ; mature_from + mature_size
  (emit "    cmp rax, rcx")                     ; < mature_from + mature_size?
  (emit "    jae .L_gc_minor_ephem_next")
  (emit ".L_gc_minor_ephem_found_reachable:")
  ;; Key is reachable!
  ;; 1. If key was in nursery, update key slot to promoted pointer rdx
  (emit "    test dil, 1")
  (emit "    jz .L_gc_minor_ephem_do_datum")
  (emit "    mov rax, rdi")
  (emit "    and rax, -8")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    cmp rax, [r11 + 0]")
  (emit "    jb .L_gc_minor_ephem_do_datum")
  (emit "    mov rcx, [r11 + 0]")
  (emit "    add rcx, [r11 + 8]")
  (emit "    cmp rax, rcx")
  (emit "    jae .L_gc_minor_ephem_do_datum")
  ;; Key was inside nursery and promoted to rdx
  (emit "    mov [r8 + 16], rdx")
  (emit ".L_gc_minor_ephem_do_datum:")
  ;; 2. Promote datum if it is in nursery
  (emit "    mov rdi, [r8 + 24]")
  (emit "    push r8")
  (emit "    push r9")
  (emit "    push r10")
  (emit "    push rbx")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop rbx")
  (emit "    pop r10")
  (emit "    pop r9")
  (emit "    pop r8")
  (emit "    mov [r8 + 24], rax")
  ;; 3. Unlink curr (r8) from pending list
  (emit "    test r9, r9")
  (emit "    jnz .L_gc_minor_ephem_unlink_mid")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov [r11 + 184], r10")
  (emit "    jmp .L_gc_minor_ephem_resume_cheney")
  (emit ".L_gc_minor_ephem_unlink_mid:")
  (emit "    mov [r9 + 40], r10")
  (emit ".L_gc_minor_ephem_resume_cheney:")
  ;; Resume Cheney scan to transitively promote datum's children!
  (emit "    jmp .L_gc_minor_cheney_loop")
  (emit ".L_gc_minor_ephem_next:")
  (emit "    mov r9, r8")                       ; prev = curr
  (emit "    mov r8, r10")                      ; curr = next
  (emit "    jmp .L_gc_minor_ephem_loop")
  ;; Fixed-point reached: break all remaining ephemerons in pending list
  (emit ".L_gc_minor_ephem_break_all:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov r8, [r11 + 184]")
  (emit ".L_gc_minor_ephem_break_loop:")
  (emit "    test r8, r8")
  (emit "    jz .L_gc_minor_finish")
  (emit "    mov r10, [r8 + 40]")
  (emit "    mov qword ptr [r8 + 16], 47")      ; key = #f
  (emit "    mov qword ptr [r8 + 24], 47")      ; datum = #f
  (emit "    mov qword ptr [r8 + 32], 111")     ; broken? = #t
  (emit "    mov qword ptr [r8 + 40], 47")      ; next = #f
  (emit "    mov r8, r10")
  (emit "    jmp .L_gc_minor_ephem_break_loop")
  (emit ".L_gc_minor_finish:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  ;; Issue #566: Check mature occupancy & dynamic growth
  (emit "    mov rax, [r11 + 40]")              ; mature_free
  (emit "    sub rax, [r11 + 16]")              ; mature_from (rax = used)
  (emit "    imul rax, 10")
  (emit "    mov rdx, [r11 + 32]")              ; mature_size
  (emit "    imul rdx, 7")
  (emit "    cmp rax, rdx")
  (emit "    jbe .L_gc_minor_growth_done")      ; used * 10 <= size * 7, no growth
  (emit "    mov rsi, [r11 + 32]")              ; old_size
  (emit "    mov rdx, rsi")
  (emit "    shl rdx, 1")                       ; new_size = old_size * 2
  (emit "    mov r8, [r11 + 96]")               ; max_size
  (emit "    test r8, r8")
  (emit "    jz .L_gc_minor_do_mremap")
  (emit "    cmp rdx, r8")
  (emit "    jbe .L_gc_minor_do_mremap")
  (emit "    mov rdx, r8")                      ; cap at max_size
  (emit ".L_gc_minor_do_mremap:")
  (emit "    cmp rdx, rsi")
  (emit "    jbe .L_gc_minor_growth_done")
  (emit "    mov rdi, [r11 + 16]")              ; mature_from
  (emit "    push r11")
  (emit "    push rdx")
  (emit "    push rsi")
  (emit "    mov rax, 25")                      ; sys_mremap
  (emit "    xor r10, r10")                     ; flags = 0 (in-place)
  (emit "    xor r8, r8")
  (emit "    xor r9, r9")
  (emit "    syscall")
  (emit "    pop rsi")
  (emit "    pop rdx")
  (emit "    pop r11")
  (emit "    cmp rax, [r11 + 16]")
  (emit "    je .L_gc_minor_mremap_ok")
  ;; In-place failed, try MREMAP_MAYMOVE (flags = 1)
  (emit "    mov rdi, [r11 + 16]")
  (emit "    push r11")
  (emit "    push rdx")
  (emit "    push rsi")
  (emit "    mov rax, 25")
  (emit "    mov r10, 1")                       ; MREMAP_MAYMOVE = 1
  (emit "    xor r8, r8")
  (emit "    xor r9, r9")
  (emit "    syscall")
  (emit "    pop rsi")
  (emit "    pop rdx")
  (emit "    pop r11")
  (emit "    cmp rax, -4096")
  (emit "    jae .L_gc_minor_growth_done")      ; syscall error
  (emit "    cmp rax, [r11 + 16]")
  (emit "    je .L_gc_minor_mremap_ok")
  (emit "    mov rcx, [r11 + 16]")
  (emit "    mov [r11 + 16], rax")              ; update mature_from
  (emit "    sub rax, rcx")                     ; diff = new - old
  (emit "    add [r11 + 40], rax")              ; mature_free += diff
  (emit "    add [rsp + 8], rax")               ; mature_free_start += diff
  (emit ".L_gc_minor_mremap_ok:")
  (emit "    mov [r11 + 32], rdx")              ; mature_size = new_size
  (emit "    inc qword ptr [r11 + 104]")        ; growth_count++
  (emit ".L_gc_minor_growth_done:")
  (emit "    mov r12, [r11 + 0]")              ; r12 = nursery_base
  (emit "    mov rax, r12")
  (emit "    add rax, [r11 + 8]")
  (emit "    lea rdx, [rip + ulisp_heap_limit]")
  (emit "    mov [rdx], rax")
  (emit "    mov qword ptr [r11 + 80], 0")
  (emit "    inc qword ptr [r11 + 56]")
  (emit "    mov rax, [r11 + 40]")              ; mature_free_end
  (emit "    sub rax, [rsp + 8]")               ; mature_free_end - mature_free_start
  (emit "    add [r11 + 144], rax")             ; total_survived_bytes += survived
  (emit ".L_gc_exit:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    cmp qword ptr [r11 + 160], 0")
  (emit "    je .L_gc_exit_no_stats")
  (emit "    mov rax, 228")                     ; sys_clock_gettime
  (emit "    mov rdi, 1")                       ; CLOCK_MONOTONIC
  (emit "    lea rsi, [rsp + 32]")              ; store end timespec in [rsp+32..40]
  (emit "    syscall")
  (emit "    mov rax, [rsp + 32]")              ; end_sec
  (emit "    sub rax, [rsp + 16]")              ; end_sec - start_sec
  (emit "    imul rax, 1000000000")
  (emit "    mov rcx, [rsp + 40]")              ; end_nsec
  (emit "    sub rcx, [rsp + 24]")              ; end_nsec - start_nsec
  (emit "    add rax, rcx")                     ; delta_ns
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    add [r11 + 152], rax")             ; total_gc_time_ns += delta_ns
  (emit ".L_gc_exit_no_stats:")
  (emit "    add rsp, 48")
  (emit "    pop r15")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop rbp")
  (emit "    pop rbx")
  (emit "    ret")

  ;; --- Helpers ---
  (emit ".L_gc_copy_if_heap_dual:")
  (emit "    mov rax, rdi")
  (emit "    and rax, 7")
  (emit "    cmp rax, 1")
  (emit "    je .L_gc_dual_tag_ok")
  (emit "    cmp rax, 3")
  (emit "    je .L_gc_dual_tag_ok")
  (emit "    cmp rax, 5")
  (emit "    je .L_gc_dual_tag_ok")
