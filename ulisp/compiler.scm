  (emit "    ret")

  (emit ".L_gc_promote_if_nursery:")
  (emit "    mov rax, rdi")
  (emit "    and rax, 7")
  (emit "    cmp rax, 1")
  (emit "    je .L_gc_nursery_tag_ok")
  (emit "    cmp rax, 3")
  (emit "    je .L_gc_nursery_tag_ok")
  (emit "    cmp rax, 5")
  (emit "    je .L_gc_nursery_tag_ok")
  (emit "    cmp rax, 7")
  (emit "    je .L_gc_nursery_tag_ok")
  (emit "    mov rax, rdi")
  (emit "    ret")
  (emit ".L_gc_nursery_tag_ok:")
  (emit "    mov r8, rdi")
  (emit "    and r8, -8")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov r9, [r11 + 0]")
  (emit "    mov r10, [r11 + 8]")
  (emit "    cmp r8, r9")
  (emit "    jb .L_gc_ret_nursery_orig")
  (emit "    add r10, r9")
  (emit "    cmp r8, r10")
  (emit "    jae .L_gc_ret_nursery_orig")
  (emit "    mov r10, [r8 - 8]")
  (emit "    mov rax, r10")
  (emit "    and rax, 7")
  (emit "    test rax, rax")
  (emit "    jz .L_gc_do_promote")
  (emit "    mov rax, r10")
  (emit "    and rax, -8")
  (emit "    mov r9, [r11 + 16]")
  (emit "    cmp rax, r9")
  (emit "    jb .L_gc_do_promote")
  (emit "    add r9, [r11 + 32]")
  (emit "    cmp rax, r9")
  (emit "    jae .L_gc_do_promote")
