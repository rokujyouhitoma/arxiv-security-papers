  (emit "    mov r8,  [r10 - 1 + 16]")
  (emit "    mov rbp, [r10 - 1 + 24]")
  (emit "    mov rbx, [r10 - 1 + 32]")
  (emit "    mov r13, [r10 - 1 + 48]")
  (emit "    mov r14, [r10 - 1 + 56]")
  (emit "    mov r15, [r10 - 1 + 64]")
