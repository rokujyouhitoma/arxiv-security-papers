;;; -----------------------------------------------------------------------
;;; 10. Rule-level Auto-Bisect (Delta Debugging) Engine (DSN-33-01 T6.2)
;;; -----------------------------------------------------------------------

(define (picopass-split-list lst k)
  (let loop ((rem lst) (i k) (acc '()))
    (if (or (null? rem) (<= i 0))
        (cons (reverse acc) rem)
        (loop (cdr rem) (- i 1) (cons (car rem) acc)))))

(define (auto-bisect-picopasses candidate-rules test-fn)
  (let* ((rule-ids (map (lambda (r) (if (rule-descriptor? r) (rule-name r) r)) candidate-rules))
         (saved-disabled (disabled-picopasses)))
    (dynamic-wind
      (lambda () (reset-disabled-picopasses!))
      (lambda ()
        ;; Step 1: Does the bug reproduce when all candidate rules are enabled?
        (if (test-fn)
            #f ; Bug is not reproduced (test-fn passed)
            ;; Step 2: Does the bug disappear when ALL candidate rules are disabled?
            (let ((passes-when-all-disabled?
                   (with-disabled-picopasses rule-ids test-fn)))
              (if (not passes-when-all-disabled?)
                  'cannot-isolate-all-disabled-still-fails
                  ;; Step 3: Delta debugging recursive bisection
                  (let bisect ((rules rule-ids))
                    (cond
                      ((null? rules) #f)
                      ((= (length rules) 1)
                       (car rules)) ; Isolated single culprit rule!
                      (else
                       (let* ((mid (quotient (length rules) 2))
                              (split (picopass-split-list rules mid))
                              (r1 (car split))
                              (r2 (cdr split)))
                         ;; Test if failure persists without r1
                         (let ((fails-without-r1?
                                (not (with-disabled-picopasses r1 test-fn))))
                           (if fails-without-r1?
                               (bisect r2)
                               ;; Otherwise test if failure persists without r2
                               (let ((fails-without-r2?
                                      (not (with-disabled-picopasses r2 test-fn))))
                                 (if fails-without-r2?
                                     (bisect r1)
                                     ;; Both subsets needed -> interaction bug
                                     (list 'interaction r1 r2)))))))))))))
      (lambda ()
        (set-car! *disabled-picopasses* saved-disabled)))))
;;; =======================================================================
;;; ULisp Compiler: Generic Dataflow Analysis Framework & Lattice Engine
;;; Conforms to DSN-33 Architecture Specification & Issue #599
;;; Based on Monotone Framework (Kam & Ullman 1977, Kildall 1973)
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; Part 1: Set Operations & Equality Helpers
;;; -----------------------------------------------------------------------

(define (dataflow-set-equal? s1 s2)
  (and (= (length s1) (length s2))
       (dataflow-set-subset? s1 s2)))

(define (dataflow-set-subset? s1 s2)
  (cond
    ((null? s1) #t)
    ((memq (car s1) s2)
     (dataflow-set-subset? (cdr s1) s2))
    (else #f)))

(define (dataflow-set-intersect s1 s2)
  (cond
    ((null? s1) '())
    ((null? s2) '())
    ((memq (car s1) s2)
     (cons (car s1) (dataflow-set-intersect (cdr s1) s2)))
    (else
     (dataflow-set-intersect (cdr s1) s2))))

;;; -----------------------------------------------------------------------
;;; Part 2: Semi-Lattice Record & Built-in Lattices
;;; -----------------------------------------------------------------------

;;; Lattice record:
;;;   (list 'lattice name bottom top leq? join meet)
(define (make-lattice name bottom top leq? join meet)
  (list 'lattice name bottom top leq? join meet))

(define (lattice? obj)
  (and (pair? obj) (eq? (car obj) 'lattice)))

(define (lattice-name l) (cadr l))
(define (lattice-bottom l) (caddr l))
(define (lattice-top l) (cadddr l))
(define (lattice-leq? l a b) ((car (cddddr l)) a b))
(define (lattice-join l a b) ((cadr (cddddr l)) a b))
(define (lattice-meet l a b) ((caddr (cddddr l)) a b))

;;; Built-in Sentinel symbols
(define *df-bottom* '*df-bottom*)
(define *df-top* '*df-top*)

(define (df-bottom? x) (eq? x *df-bottom*))
(define (df-top? x) (eq? x *df-top*))

;;; 2.1 Boolean Lattice
;;; Bottom = #f, Top = #t
;;; #f <= #f, #f <= #t, #t <= #t
;;; Join = or, Meet = and
(define (make-boolean-lattice name)
  (make-lattice
   name
   #f
   #t
   (lambda (a b)
     (if a (and b #t) #t))
   (lambda (a b)
     (or a b))
   (lambda (a b)
     (and a b))))

;;; 2.2 Flat Lattice (Constants / Single values)
;;; Elements: *df-bottom*, constants c, *df-top*
;;; *df-bottom* <= c <= *df-top*
;;; If c1 != c2, c1 join c2 = *df-top*
(define (make-flat-lattice name eq-fn)
  (make-lattice
   name
   *df-bottom*
   *df-top*
   (lambda (a b)
     (cond
       ((eq? a *df-bottom*) #t)
       ((eq? b *df-top*) #t)
       ((and (not (eq? a *df-top*)) (not (eq? b *df-bottom*)))
        (eq-fn a b))
       (else #f)))
   (lambda (a b)
     (cond
       ((eq? a *df-bottom*) b)
       ((eq? b *df-bottom*) a)
       ((or (eq? a *df-top*) (eq? b *df-top*)) *df-top*)
       ((eq-fn a b) a)
       (else *df-top*)))
   (lambda (a b)
     (cond
       ((eq? a *df-top*) b)
       ((eq? b *df-top*) a)
       ((or (eq? a *df-bottom*) (eq? b *df-bottom*)) *df-bottom*)
       ((eq-fn a b) a)
       (else *df-bottom*)))))

;;; 2.3 Powerset Lattice (Set of symbols / expressions)
;;; Bottom = '(), Top = universe-or-top
;;; Join = set-union, Meet = dataflow-set-intersect
;;; Order: a <= b iff a subseteq b
(define (make-powerset-lattice name universe)
  (make-lattice
   name
   '()
   (if universe universe *df-top*)
   (lambda (a b)
     (cond
       ((eq? b *df-top*) #t)
       ((eq? a *df-top*) (eq? b *df-top*))
       (else (dataflow-set-subset? a b))))
   (lambda (a b)
     (cond
       ((eq? a *df-top*) *df-top*)
       ((eq? b *df-top*) *df-top*)
       (else (set-union a b))))
   (lambda (a b)
     (cond
       ((eq? a *df-top*) b)
       ((eq? b *df-top*) a)
       (else (dataflow-set-intersect a b))))))

;;; 2.4 Map / Environment Lattice (Var -> Value Lattice)
;;; Represents mappings from symbols to elements of an inner lattice.
;;; An environment is an alist: ((var . val) ...)
;;; Unbound variable is treated as (lattice-bottom val-lat).
(define (make-map-lattice name val-lat)
  (let* ((v-bot (lattice-bottom val-lat))
         (lookup-val (lambda (env k)
                       (let ((entry (assq k env)))
                         (if entry (cdr entry) v-bot)))))
    (make-lattice
     name
     '()
     *df-top*
     ;; leq? env1 env2
     (lambda (env1 env2)
       (cond
         ((eq? env2 *df-top*) #t)
         ((eq? env1 *df-top*) (eq? env2 *df-top*))
         (else
          (let loop ((entries env1))
            (if (null? entries)
                #t
                (let* ((k (caar entries))
                       (v1 (cdar entries))
                       (v2 (lookup-val env2 k)))
                  (if (lattice-leq? val-lat v1 v2)
                      (loop (cdr entries))
                      #f)))))))
     ;; join env1 env2
     (lambda (env1 env2)
       (cond
         ((eq? env1 *df-top*) *df-top*)
         ((eq? env2 *df-top*) *df-top*)
         (else
          (let* ((all-keys (set-union (map car* env1) (map car* env2))))
            (let loop ((keys all-keys) (acc '()))
              (if (null? keys)
                  acc
                  (let* ((k (car keys))
                         (v1 (lookup-val env1 k))
                         (v2 (lookup-val env2 k))
                         (v-joined (lattice-join val-lat v1 v2)))
                    ;; If joined value is bottom, omit from map for compactness
                    (if (lattice-leq? val-lat v-joined v-bot)
                        (loop (cdr keys) acc)
                        (loop (cdr keys) (cons (cons k v-joined) acc))))))))))
     ;; meet env1 env2
     (lambda (env1 env2)
       (cond
         ((eq? env1 *df-top*) env2)
         ((eq? env2 *df-top*) env1)
         (else
          (let* ((all-keys (set-union (map car* env1) (map car* env2))))
            (let loop ((keys all-keys) (acc '()))
              (if (null? keys)
                  acc
                  (let* ((k (car keys))
                         (v1 (lookup-val env1 k))
                         (v2 (lookup-val env2 k))
                         (v-met (lattice-meet val-lat v1 v2)))
                    (if (lattice-leq? val-lat v-met v-bot)
                        (loop (cdr keys) acc)
                        (loop (cdr keys) (cons (cons k v-met) acc)))))))))))))

;;; 2.5 Product Lattice (Tuple of two lattices)
(define (make-product-lattice name lat1 lat2)
  (make-lattice
   name
   (cons (lattice-bottom lat1) (lattice-bottom lat2))
   (cons (lattice-top lat1) (lattice-top lat2))
   (lambda (p1 p2)
     (and (lattice-leq? lat1 (car p1) (car p2))
          (lattice-leq? lat2 (cdr p1) (cdr p2))))
   (lambda (p1 p2)
     (cons (lattice-join lat1 (car p1) (car p2))
           (lattice-join lat2 (cdr p1) (cdr p2))))
   (lambda (p1 p2)
     (cons (lattice-meet lat1 (car p1) (car p2))
           (lattice-meet lat2 (cdr p1) (cdr p2))))))

;;; 2.6 4-Valued Binding-Time Analysis (BTA) Lattice (DSN-33-03 §4.1)
;;; Elements: 'bot <= 'static <= 'psds <= 'dynamic <= 'top
;;;   bot     : unreachable / unanalyzed
;;;   static  : completely known at compile time (Now)
;;;   psds    : partially static (static spine, dynamic leaves)
;;;   dynamic : must be computed at runtime (Later)
;;;   top     : contradiction / over-generalized

(define (bta-level x)
  (case x
    ((bot) 0)
    ((static) 1)
    ((psds) 2)
    ((dynamic) 3)
    ((top) 4)
    (else 4)))

(define (bta-from-level lvl)
  (case lvl
    ((0) 'bot)
    ((1) 'static)
    ((2) 'psds)
    ((3) 'dynamic)
    ((4) 'top)
    (else 'top)))

(define (bta-elem? x)
  (if (memq x '(bot static psds dynamic top)) #t #f))

(define (bta-leq? a b)
  (<= (bta-level a) (bta-level b)))

(define (bta-join a b)
  (if (>= (bta-level a) (bta-level b))
      a
      b))

(define (bta-meet a b)
  (if (<= (bta-level a) (bta-level b))
      a
      b))

(define (make-bta-lattice name)
  (make-lattice
   name
   'bot
   'top
   bta-leq?
   bta-join
   bta-meet))

(define *bta-default-lattice* (make-bta-lattice 'bta-4val))

;;; -----------------------------------------------------------------------
;;; Part 3: Dataflow Problem Specification
;;; -----------------------------------------------------------------------

;;; Problem record:
;;;   (list 'dataflow-problem name direction lattice boundary-val init-val transfer-fn)
(define (make-dataflow-problem name direction lattice boundary-val init-val transfer-fn)
  (list 'dataflow-problem name direction lattice boundary-val init-val transfer-fn))

(define (dataflow-problem? obj)
  (and (pair? obj) (eq? (car obj) 'dataflow-problem)))

(define (df-problem-name p) (cadr p))
(define (df-problem-direction p) (caddr p))
(define (df-problem-lattice p) (cadddr p))
(define (df-problem-boundary-val p) (car (cddddr p)))
(define (df-problem-init-val p) (cadr (cddddr p)))
(define (df-problem-transfer-fn p) (caddr (cddddr p)))

;;; -----------------------------------------------------------------------
;;; Part 4: Generic Worklist Fixed-Point Engine
;;; -----------------------------------------------------------------------

;;; Max iteration safety bound to prevent infinite compilation loops
(define *dataflow-max-iterations* (cons 2000 '()))

(define (dataflow-get-max-iterations)
  (car *dataflow-max-iterations*))

(define (dataflow-set-max-iterations! limit)
  (set-car! *dataflow-max-iterations* limit))

;;; Lookup state in alist ((node . state) ...)
(define (df-lookup-state table node default-val)
  (let ((entry (assq node table)))
    (if entry (cdr entry) default-val)))

;;; Update or add state in alist
(define (df-set-state table node new-val)
  (let loop ((entries table) (acc '()))
    (cond
      ((null? entries)
       (cons (cons node new-val) acc))
      ((eq? (caar entries) node)
       (append (cdr entries) (cons (cons node new-val) acc)))
      (else
       (loop (cdr entries) (cons (car entries) acc))))))

;;; Equality of lattice values using leq in both directions
(define (df-lattice-equal? lat a b)
  (and (lattice-leq? lat a b)
       (lattice-leq? lat b a)))

;;; Worklist Solver
;;; Arguments:
;;;   problem:      dataflow-problem
;;;   nodes:        list of node symbols/identifiers
;;;   entry-nodes:  list of entry/source nodes (for forward) or exit nodes (for backward)
;;;   preds-fn:     (lambda (node) -> list of predecessor nodes)
;;;   succs-fn:     (lambda (node) -> list of successor nodes)
;;; Returns:
;;;   Result table: ((node (in . in-val) (out . out-val)) ...)
(define (dataflow-analyze problem nodes entry-nodes preds-fn succs-fn)
  (let* ((lat (df-problem-lattice problem))
         (direction (df-problem-direction problem))
         (forward? (eq? direction 'forward))
         (boundary-val (df-problem-boundary-val problem))
         (init-val (df-problem-init-val problem))
         (transfer-fn (df-problem-transfer-fn problem))
         (max-iters (dataflow-get-max-iterations)))

    ;; Initialize in-table and out-table
    ;; For forward:
    ;;   in-table of entry-nodes = boundary-val, others = init-val
    ;;   out-table of all nodes = init-val
    ;; For backward:
    ;;   out-table of exit-nodes = boundary-val, others = init-val
    ;;   in-table of all nodes = init-val
    (let* ((init-tables
            (let loop ((ns nodes) (in-acc '()) (out-acc '()))
              (if (null? ns)
                  (cons in-acc out-acc)
                  (let* ((n (car ns))
                         (is-boundary? (if (memq n entry-nodes) #t #f)))
                    (if forward?
                        (loop (cdr ns)
                              (cons (cons n (if is-boundary? boundary-val init-val)) in-acc)
                              (cons (cons n init-val) out-acc))
                        (loop (cdr ns)
                              (cons (cons n init-val) in-acc)
                              (cons (cons n (if is-boundary? boundary-val init-val)) out-acc)))))))
           (initial-in-table (car init-tables))
           (initial-out-table (cdr init-tables))
           ;; Worklist initially contains all nodes
           (initial-worklist nodes))

      ;; Worklist iteration loop
      (let solve-loop ((worklist initial-worklist)
                       (in-table initial-in-table)
                       (out-table initial-out-table)
                       (iter-count 0))
        (cond
          ((null? worklist)
           ;; Fixed-point reached: construct result table
           (let loop ((ns nodes) (res '()))
             (if (null? ns)
                 (reverse res)
                 (let* ((n (car ns))
                        (in-v (df-lookup-state in-table n init-val))
                        (out-v (df-lookup-state out-table n init-val)))
                   (loop (cdr ns)
                         (cons (list n (cons 'in in-v) (cons 'out out-v)) res))))))

          ((>= iter-count max-iters)
           ;; Exceeded maximum iterations: log diagnostic and return best-effort
           (let loop ((ns nodes) (res '()))
             (if (null? ns)
                 (reverse res)
                 (let* ((n (car ns))
                        (in-v (df-lookup-state in-table n (lattice-top lat)))
                        (out-v (df-lookup-state out-table n (lattice-top lat))))
                   (loop (cdr ns)
                         (cons (list n (cons 'in in-v) (cons 'out out-v)) res))))))

          (else
           (let* ((n (car worklist))
                  (rest-wl (cdr worklist)))
             (if forward?
                 ;; --- FORWARD ANALYSIS ---
                 (let* ((preds (preds-fn n))
                        ;; in[n] = join_{p in preds} out[p] (or boundary-val if entry)
                        (new-in
                         (if (memq n entry-nodes)
                             (if (null? preds)
                                 boundary-val
                                 (let loop-p ((ps preds) (acc boundary-val))
                                   (if (null? ps) acc
                                       (let ((p-out (df-lookup-state out-table (car ps) init-val)))
                                         (loop-p (cdr ps) (lattice-join lat acc p-out))))))
                             (let loop-p ((ps preds) (acc init-val))
                               (if (null? ps) acc
                                   (let ((p-out (df-lookup-state out-table (car ps) init-val)))
                                     (loop-p (cdr ps) (lattice-join lat acc p-out)))))))
                        ;; out[n] = transfer(n, in[n])
                        (new-out (transfer-fn n new-in))
                        (old-out (df-lookup-state out-table n init-val)))
                   (if (df-lattice-equal? lat old-out new-out)
                       ;; No change in out[n], continue
                       (solve-loop rest-wl
                                   (df-set-state in-table n new-in)
                                   out-table
                                   (+ iter-count 1))
                       ;; out[n] changed: add all successors to worklist
                       (let* ((succs (succs-fn n))
                              (new-wl (let add-loop ((ss succs) (cur-wl rest-wl))
                                        (cond
                                          ((null? ss) cur-wl)
                                          ((memq (car ss) cur-wl) (add-loop (cdr ss) cur-wl))
                                          (else (add-loop (cdr ss) (cons (car ss) cur-wl)))))))
                         (solve-loop new-wl
                                     (df-set-state in-table n new-in)
                                     (df-set-state out-table n new-out)
                                     (+ iter-count 1)))))

                 ;; --- BACKWARD ANALYSIS ---
                 (let* ((succs (succs-fn n))
                        ;; out[n] = join_{s in succs} in[s] (or boundary-val if exit)
                        (new-out
                         (if (memq n entry-nodes)
                             (if (null? succs)
                                 boundary-val
                                 (let loop-s ((ss succs) (acc boundary-val))
                                   (if (null? ss) acc
                                       (let ((s-in (df-lookup-state in-table (car ss) init-val)))
                                         (loop-s (cdr ss) (lattice-join lat acc s-in))))))
                             (let loop-s ((ss succs) (acc init-val))
                               (if (null? ss) acc
                                   (let ((s-in (df-lookup-state in-table (car ss) init-val)))
                                     (loop-s (cdr ss) (lattice-join lat acc s-in)))))))
                        ;; in[n] = transfer(n, out[n])
                        (new-in (transfer-fn n new-out))
                        (old-in (df-lookup-state in-table n init-val)))
                   (if (df-lattice-equal? lat old-in new-in)
                       ;; No change in in[n], continue
                       (solve-loop rest-wl
                                   in-table
                                   (df-set-state out-table n new-out)
                                   (+ iter-count 1))
                       ;; in[n] changed: add all predecessors to worklist
                       (let* ((preds (preds-fn n))
                              (new-wl (let add-loop ((ps preds) (cur-wl rest-wl))
                                        (cond
                                          ((null? ps) cur-wl)
                                          ((memq (car ps) cur-wl) (add-loop (cdr ps) cur-wl))
                                          (else (add-loop (cdr ps) (cons (car ps) cur-wl)))))))
                         (solve-loop new-wl
                                     (df-set-state in-table n new-in)
                                     (df-set-state out-table n new-out)
                                     (+ iter-count 1)))))))))))))

;;; -----------------------------------------------------------------------
;;; Part 5: Result Accessors & Query Helpers
;;; -----------------------------------------------------------------------

(define (dataflow-result-in results node)
  (let ((entry (assq node results)))
    (if entry
        (let ((in-pair (assq 'in (cdr entry))))
          (if in-pair (cdr in-pair) #f))
        #f)))

(define (dataflow-result-out results node)
  (let ((entry (assq node results)))
    (if entry
        (let ((out-pair (assq 'out (cdr entry))))
          (if out-pair (cdr out-pair) #f))
        #f)))

;;; -----------------------------------------------------------------------
;;; Part 6: High-Level Dataflow Problem Builders
;;; -----------------------------------------------------------------------

;;; 6.1 Liveness Analysis Problem (Backward)
;;; Lattice: Powerset of variables
;;; Transfer: In[n] = (Out[n] \ Def[n]) U Use[n]
(define (make-liveness-problem name def-use-table)
  (let ((lat (make-powerset-lattice (string->symbol (string-append (symbol->string name) "-liveness")) #f)))
    (make-dataflow-problem
     name
     'backward
     lat
     '()    ; boundary-val: exit has no live variables
     '()    ; init-val: bottom is empty set
     (lambda (node out-state)
       (let ((du (assq node def-use-table)))
         (if du
             (let* ((defs (cadr du))
                    (uses (caddr du)))
               (set-union (set-diff out-state defs) uses))
             out-state))))))

;;; 6.2 Reaching Definitions Problem (Forward)
;;; Lattice: Powerset of definition IDs
;;; Transfer: Out[n] = Gen[n] U (In[n] \ Kill[n])
(define (make-reaching-defs-problem name gen-kill-table)
  (let ((lat (make-powerset-lattice (string->symbol (string-append (symbol->string name) "-reaching")) #f)))
    (make-dataflow-problem
     name
     'forward
     lat
     '()    ; boundary-val: entry has no definitions
     '()    ; init-val: bottom is empty set
     (lambda (node in-state)
       (let ((gk (assq node gen-kill-table)))
         (if gk
             (let* ((gen (cadr gk))
                    (kill (caddr gk)))
               (set-union gen (set-diff in-state kill)))
             in-state))))))

;;; 6.3 Constant Propagation Problem (Forward)
;;; Lattice: Map from Var -> Flat Lattice
(define (make-constant-propagation-problem name const-transfer-fn)
  (let* ((flat-lat (make-flat-lattice 'const-val equal?))
         (map-lat (make-map-lattice 'const-env flat-lat)))
    (make-dataflow-problem
     name
     'forward
     map-lat
     '()    ; boundary-val: entry environment is empty
     '()    ; init-val: empty
     const-transfer-fn)))
;;; =======================================================================
;;; ULisp Compiler: Unified First-Class Symbol Binding & Scope Sets Engine
;;; Conforms to DSN-33-02 §3.2, DSN-38 §2 (B3/B4) & Issue #837
;;; =======================================================================
;;; Provides:
;;;   1. First-class <binding> records with monotonic Binding IDs
;;;   2. Global bidirectional *binding-registry* (by ID and unique symbol)
;;;   3. Canonical ascending integer set operations (binding-id-set-*)
;;;   4. Hygienic macro Scope Sets (Flatt 2016: "Binding as Sets of Scopes")
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Structured Error Helper & Monotonic Counters
;;; -----------------------------------------------------------------------

(define (binding-error! msg detail)
  (raise (list 'binding-error msg detail)))

(define *binding-id-counter* (cons 0 '()))
(define *hygiene-scope-counter* (cons 0 '()))

(define (reset-binding-id-counter!)
  (set-car! *binding-id-counter* 0))

(define (next-binding-id!)
  (let ((id (car *binding-id-counter*)))
    (set-car! *binding-id-counter* (+ id 1))
    id))

(define (reset-hygiene-scope-counter!)
  (set-car! *hygiene-scope-counter* 0))

(define (fresh-hygiene-scope!)
  (let ((next (+ (car *hygiene-scope-counter*) 1)))
    (set-car! *hygiene-scope-counter* next)
    next))

;;; -----------------------------------------------------------------------
;;; 2. Shared Strictly-Ascending Integer Set Algebra
;;; -----------------------------------------------------------------------

(define (int-set-member? x s)
  (cond
    ((null? s) #f)
    ((= x (car s)) #t)
    ((< x (car s)) #f)
    (else (int-set-member? x (cdr s)))))

(define (int-set-add x s)
  (cond
    ((null? s) (list x))
    ((< x (car s)) (cons x s))
    ((= x (car s)) s)
    (else (cons (car s) (int-set-add x (cdr s))))))

(define (int-set-remove x s)
  (cond
    ((null? s) '())
    ((< x (car s)) s)
    ((= x (car s)) (cdr s))
    (else (cons (car s) (int-set-remove x (cdr s))))))

(define (int-set-union s1 s2)
  (cond
    ((null? s1) s2)
    ((null? s2) s1)
    ((< (car s1) (car s2))
     (cons (car s1) (int-set-union (cdr s1) s2)))
    ((< (car s2) (car s1))
     (cons (car s2) (int-set-union s1 (cdr s2))))
    (else
     (cons (car s1) (int-set-union (cdr s1) (cdr s2))))))

(define (int-set-intersection s1 s2)
  (cond
    ((or (null? s1) (null? s2)) '())
    ((< (car s1) (car s2))
     (int-set-intersection (cdr s1) s2))
    ((< (car s2) (car s1))
     (int-set-intersection s1 (cdr s2)))
    (else
     (cons (car s1) (int-set-intersection (cdr s1) (cdr s2))))))

(define (int-set-difference s1 s2)
  (cond
    ((null? s1) '())
    ((null? s2) s1)
    ((< (car s1) (car s2))
     (cons (car s1) (int-set-difference (cdr s1) s2)))
    ((< (car s2) (car s1))
     (int-set-difference s1 (cdr s2)))
    (else
     (int-set-difference (cdr s1) (cdr s2)))))

(define (int-set-subset? s1 s2)
  (cond
    ((null? s1) #t)
    ((null? s2) #f)
    ((< (car s1) (car s2)) #f)
    ((= (car s1) (car s2))
     (int-set-subset? (cdr s1) (cdr s2)))
    (else
     (int-set-subset? s1 (cdr s2)))))

(define (int-set-equal? s1 s2)
  (cond
    ((and (null? s1) (null? s2)) #t)
    ((or (null? s1) (null? s2)) #f)
    ((= (car s1) (car s2))
     (int-set-equal? (cdr s1) (cdr s2)))
    (else #f)))

(define (normalize-int-set xs)
  (if (not (list? xs))
      '()
      (let loop ((rest xs) (acc '()))
        (if (null? rest)
            acc
            (if (integer? (car rest))
                (loop (cdr rest) (int-set-add (car rest) acc))
                (loop (cdr rest) acc))))))

;;; -----------------------------------------------------------------------
;;; 3. First-Class <binding> Record Definition & Accessors
;;; -----------------------------------------------------------------------

(define (infer-binding-namespace kind)
  (case kind
    ((tag-struct tag-union tag-enum) 'tag)
    ((label) 'label)
    ((macro) 'macro)
    (else 'ordinary)))

(define (make-binding id source-name unique-sym kind namespace scope-id
                      storage-class type-attr visibility scope-set source-span)
  (if (or (not (integer? id)) (< id 0))
      (binding-error! "make-binding: id must be a non-negative integer" id))
  (if (not (symbol? source-name))
      (binding-error! "make-binding: source-name must be a symbol" source-name))
  (if (not (symbol? unique-sym))
      (binding-error! "make-binding: unique-sym must be a symbol" unique-sym))
  (if (not (symbol? kind))
      (binding-error! "make-binding: kind must be a symbol" kind))
  (if (not (symbol? namespace))
      (binding-error! "make-binding: namespace must be a symbol" namespace))
  (list 'binding
        id
        source-name
        unique-sym
        kind
        namespace
        scope-id
        (cons storage-class '())
        (cons type-attr '())
        (cons visibility '())
        (cons (normalize-int-set scope-set) '())
        (cons source-span '())))

(define (binding? obj)
  (and (pair? obj)
       (eq? (car obj) 'binding)
       (>= (length obj) 12)))

(define (binding-id b)            (list-ref b 1))
(define (binding-source-name b)   (list-ref b 2))
(define (binding-unique-sym b)    (list-ref b 3))
(define (binding-kind b)          (list-ref b 4))
(define (binding-namespace b)     (list-ref b 5))
(define (binding-scope-id b)      (list-ref b 6))
(define (binding-storage-class b) (car (list-ref b 7)))
(define (binding-type-attr b)     (car (list-ref b 8)))
(define (binding-visibility b)    (car (list-ref b 9)))
(define (binding-scope-set b)     (car (list-ref b 10)))
(define (binding-source-span b)   (car (list-ref b 11)))

(define (set-binding-storage-class! b sc)
  (set-car! (list-ref b 7) sc))

(define (set-binding-type-attr! b ty)
  (set-car! (list-ref b 8) ty))

(define (set-binding-visibility! b vis)
  (set-car! (list-ref b 9) vis))

(define (set-binding-scope-set! b sset)
  (set-car! (list-ref b 10) (normalize-int-set sset)))

(define (set-binding-source-span! b span)
  (set-car! (list-ref b 11) span))

;;; -----------------------------------------------------------------------
;;; 4. Global Binding Registry (*binding-registry*)
;;; -----------------------------------------------------------------------

(define *binding-table-size* 1024)
(define *binding-by-id-buckets* (make-vector 1024 '()))
(define *binding-by-sym-buckets* (make-vector 1024 '()))
(define *all-bindings-list* (cons '() '()))

(define (reset-binding-registry!)
  (reset-binding-id-counter!)
  (reset-hygiene-scope-counter!)
  (let loop ((i 0))
    (if (< i *binding-table-size*)
        (begin
          (vector-set! *binding-by-id-buckets* i '())
          (vector-set! *binding-by-sym-buckets* i '())
          (loop (+ i 1)))))
  (set-car! *all-bindings-list* '()))

(define (register-binding! b)
  (if (not (binding? b))
      (binding-error! "register-binding!: expected <binding>" b))
  (let* ((id (binding-id b))
         (usym (binding-unique-sym b))
         (id-idx (modulo id *binding-table-size*))
         (id-bucket (vector-ref *binding-by-id-buckets* id-idx))
         (id-entry (assv id id-bucket))
         (sym-idx (symbol->hash-idx usym))
         (sym-bucket (vector-ref *binding-by-sym-buckets* sym-idx))
         (sym-entry (assq usym sym-bucket)))
    (if id-entry
        (set-cdr! id-entry b)
        (begin
          (vector-set! *binding-by-id-buckets* id-idx (cons (cons id b) id-bucket))
          (set-car! *all-bindings-list* (cons b (car *all-bindings-list*)))))
    (if sym-entry
        (set-cdr! sym-entry b)
        (vector-set! *binding-by-sym-buckets* sym-idx (cons (cons usym b) sym-bucket)))
    b))

(define (lookup-binding-by-id id)
  (if (integer? id)
      (let* ((idx (modulo id *binding-table-size*))
             (bucket (vector-ref *binding-by-id-buckets* idx))
             (entry (assv id bucket)))
        (if entry (cdr entry) #f))
      #f))

(define (lookup-binding-by-symbol sym)
  (if (symbol? sym)
      (let* ((idx (symbol->hash-idx sym))
             (bucket (vector-ref *binding-by-sym-buckets* idx))
             (entry (assq sym bucket)))
        (if entry (cdr entry) #f))
      #f))

(define (all-registered-bindings)
  (reverse (car *all-bindings-list*)))

;;; -----------------------------------------------------------------------
;;; 5. Binding ID Set Public API
;;; -----------------------------------------------------------------------

(define binding-id-set-empty '())

(define (binding-id-set-member? id bset)
  (int-set-member? id bset))

(define (binding-id-set-add id bset)
  (int-set-add id bset))

(define (binding-id-set-remove id bset)
  (int-set-remove id bset))

(define (binding-id-set-union bset1 bset2)
  (int-set-union bset1 bset2))

(define (binding-id-set-intersection bset1 bset2)
  (int-set-intersection bset1 bset2))

(define (binding-id-set-difference bset1 bset2)
  (int-set-difference bset1 bset2))

(define (binding-id-set-subset? bset1 bset2)
  (int-set-subset? bset1 bset2))

(define (binding-id-set-equal? bset1 bset2)
  (int-set-equal? bset1 bset2))

(define (symbols->binding-id-set syms)
  (let loop ((rest syms) (acc binding-id-set-empty))
    (if (null? rest)
        acc
        (let ((b (lookup-binding-by-symbol (car rest))))
          (if b
              (loop (cdr rest) (binding-id-set-add (binding-id b) acc))
              (loop (cdr rest) acc))))))

(define (binding-id-set->symbols bset)
  (let loop ((rest bset) (acc '()))
    (if (null? rest)
        (reverse acc)
        (let ((b (lookup-binding-by-id (car rest))))
          (if b
              (loop (cdr rest) (cons (binding-unique-sym b) acc))
              (loop (cdr rest) acc))))))

;;; -----------------------------------------------------------------------
;;; 6. Hygienic Macro Scope Sets ("Binding as Sets of Scopes")
;;; -----------------------------------------------------------------------

(define scope-set-empty '())

(define (scope-set-member? mark sset)
  (int-set-member? mark sset))

(define (scope-set-add mark sset)
  (int-set-add mark sset))

(define (scope-set-remove mark sset)
  (int-set-remove mark sset))

(define (scope-set-flip mark sset)
  (if (int-set-member? mark sset)
      (int-set-remove mark sset)
      (int-set-add mark sset)))

(define (scope-set-subset? sset1 sset2)
  (int-set-subset? sset1 sset2))

(define (scope-set-equal? sset1 sset2)
  (int-set-equal? sset1 sset2))

(define (scope-set-size sset)
  (length sset))

(define (resolve-hygienic-binding candidate-bindings use-scope-set)
  (let* ((use-set (normalize-int-set use-scope-set))
         (matching (filter (lambda (b)
                             (scope-set-subset? (binding-scope-set b) use-set))
                           candidate-bindings)))
    (if (null? matching)
        #f
        (let ((best (let loop ((rest (cdr matching))
                               (cur-best (car matching))
                               (cur-size (scope-set-size (binding-scope-set (car matching)))))
                      (if (null? rest)
                          cur-best
                          (let ((sz (scope-set-size (binding-scope-set (car rest)))))
                            (if (> sz cur-size)
                                (loop (cdr rest) (car rest) sz)
                                (loop (cdr rest) cur-best cur-size)))))))
          (let verify ((rest matching))
            (if (null? rest)
                best
                (if (not (scope-set-subset? (binding-scope-set (car rest))
                                            (binding-scope-set best)))
                    (binding-error! "Ambiguous hygienic binding resolution"
                                    (list use-set
                                          (binding-scope-set best)
                                          (binding-scope-set (car rest))))
                    (verify (cdr rest)))))))))
;;; =======================================================================
;;; ULisp Compiler: Unified Lexical Scope & Alpha-Conversion Engine (Pass 035)
;;; Conforms to DSN-33 Architecture Specification & Issue #600
;;; Guarantees Barendregt Variable Convention (globally unique bound variables)
;;; and performs early deterministic detection of unbound variables.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; Part 1: Scope Tree Data Structure & Lexical Contour Navigation
;;; -----------------------------------------------------------------------

;;; Scope node representation:
;;;   (list 'scope-node parent kind bindings-cell free-vars-cell children-cell
;;;         scope-id ns-bindings-cell free-binding-ids-cell)
;;;
;;; Fields:
;;;   - parent: enclosing scope-node or #f (for root/top-level)
;;;   - kind: symbol ('top-level, 'function, 'block, 'lambda, 'let, 'letrec, '%cont-fun)
;;;   - bindings-cell: (cons bindings '()) where bindings is ((orig-sym . alpha-sym) ...)
;;;   - free-vars-cell: (cons free-vars '()) where free-vars is (sym ...)
;;;   - children-cell: (cons children '()) where children is (scope-node ...)
;;;   - scope-id: monotonic non-negative integer scope identifier
;;;   - ns-bindings-cell: (cons bindings '()) where bindings is (<binding> ...)
;;;   - free-binding-ids-cell: (cons bset '()) sorted integer set of free <binding-id>s

(define *scope-id-counter* (cons 0 '()))
(define *scope-strict-redefinition* (cons #f '()))
(define *last-resolved-scope-tree* (cons #f '()))

(define (reset-scope-id-counter!)
  (set-car! *scope-id-counter* 0))

(define (next-scope-id!)
  (let ((id (car *scope-id-counter*)))
    (set-car! *scope-id-counter* (+ id 1))
    id))

(define (scope-error! msg detail)
  (raise (list 'scope-error msg detail)))

(define (set-scope-strict-redefinition! bool)
  (set-car! *scope-strict-redefinition* bool))

(define (scope-strict-redefinition?)
  (car *scope-strict-redefinition*))

(define (with-strict-scope-redefinition thunk)
  (let ((prev (scope-strict-redefinition?)))
    (set-scope-strict-redefinition! #t)
    (guard (ex (else
                (set-scope-strict-redefinition! prev)
                (raise ex)))
      (let ((res (thunk)))
        (set-scope-strict-redefinition! prev)
        res))))

(define (get-last-resolved-scope-tree)
  (car *last-resolved-scope-tree*))

(define (make-scope-node parent kind)
  (list 'scope-node
        parent
        kind
        (cons '() '())
        (cons '() '())
        (cons '() '())
        (next-scope-id!)
        (cons '() '())
        (cons '() '())))

(define (scope-node? obj)
  (and (pair? obj) (eq? (car obj) 'scope-node)))

(define (scope-node-parent node)
  (cadr node))

(define (scope-node-kind node)
  (caddr node))

(define (scope-node-bindings-cell node)
  (cadddr node))

(define (scope-node-bindings node)
  (car (scope-node-bindings-cell node)))

(define (scope-node-free-vars-cell node)
  (car (cddddr node)))

(define (scope-node-free-vars node)
  (car (scope-node-free-vars-cell node)))

(define (scope-node-children-cell node)
  (cadr (cddddr node)))

(define (scope-node-children node)
  (car (scope-node-children-cell node)))

(define (scope-node-id node)
  (list-ref node 6))

(define (scope-node-ns-bindings-cell node)
  (list-ref node 7))

(define (scope-node-ns-bindings node)
  (car (scope-node-ns-bindings-cell node)))

(define (scope-node-free-binding-ids-cell node)
  (list-ref node 8))

(define (scope-node-free-binding-ids node)
  (car (scope-node-free-binding-ids-cell node)))

(define (scope-enter parent kind)
  (let ((child (make-scope-node parent kind)))
    (if (scope-node? parent)
        (let ((cc (scope-node-children-cell parent)))
          (set-car! cc (append (car cc) (list child)))))
    child))

(define (scope-bind-impl! node orig-sym alpha-sym kind-opt)
  (let ((bc (scope-node-bindings-cell node)))
    (set-car! bc (cons (cons orig-sym alpha-sym) (car bc))))
  (let* ((existing (if (not (eq? orig-sym alpha-sym))
                       (lookup-binding-by-symbol alpha-sym)
                       #f))
         (b (or existing
                (let* ((k (if (pair? kind-opt)
                              (car kind-opt)
                              (if (eq? (scope-node-kind node) 'lambda)
                                  'parameter
                                  'variable)))
                       (is-top? (eq? (scope-node-kind node) 'top-level))
                       (sc (if is-top? 'global 'lexical))
                       (vis (if is-top? 'global 'local))
                       (nb (make-binding (next-binding-id!)
                                         orig-sym
                                         alpha-sym
                                         k
                                         'ordinary
                                         (scope-node-id node)
                                         sc
                                         #f
                                         vis
                                         scope-set-empty
                                         (current-ast-span))))
                  (register-binding! nb)))))
    (let ((nbc (scope-node-ns-bindings-cell node)))
      (set-car! nbc (cons b (car nbc))))
    b))

(define scope-bind!
  (case-lambda
    ((node orig-sym alpha-sym) (scope-bind-impl! node orig-sym alpha-sym '()))
    ((node orig-sym alpha-sym kind) (scope-bind-impl! node orig-sym alpha-sym (list kind)))))

(define (scope-lookup-local node orig-sym)
  (let ((entry (assq orig-sym (scope-node-bindings node))))
    (if entry
        (cdr entry)
        #f)))

(define (scope-lookup-lexical node orig-sym)
  (if (not (scope-node? node))
      #f
      (let ((entry (assq orig-sym (scope-node-bindings node))))
        (if entry
            (cons node (cdr entry))
            (scope-lookup-lexical (scope-node-parent node) orig-sym)))))

(define (scope-lookup node orig-sym)
  (let ((res (scope-lookup-lexical node orig-sym)))
    (if res
        (cdr res)
        #f)))

(define (scope-record-free-var! node sym)
  (if (scope-node? node)
      (let ((fc (scope-node-free-vars-cell node)))
        (if (not (memq sym (car fc)))
            (set-car! fc (cons sym (car fc)))))))

(define (scope-record-free-binding-id! node bid)
  (if (and (scope-node? node) (integer? bid))
      (let ((fc (scope-node-free-binding-ids-cell node)))
        (set-car! fc (binding-id-set-add bid (car fc))))))

;;; -----------------------------------------------------------------------
;;; Part 1b: Multi-Namespace Lookup, C99 Lexer Hack & Scope Manager
;;; -----------------------------------------------------------------------

(define (scope-find-function-contour node)
  (let loop ((curr node))
    (cond
      ((not (scope-node? curr)) node)
      ((memq (scope-node-kind curr) '(function lambda)) curr)
      ((not (scope-node? (scope-node-parent curr))) curr)
      (else (loop (scope-node-parent curr))))))

(define (scope-lookup-binding-local-ns node sym ns)
  (if (not (scope-node? node))
      #f
      (let loop ((bs (scope-node-ns-bindings node)))
        (cond
          ((null? bs) #f)
          ((and (eq? (binding-namespace (car bs)) ns)
                (eq? (binding-source-name (car bs)) sym))
           (car bs))
          (else (loop (cdr bs)))))))

(define scope-lookup-binding-local
  (case-lambda
    ((node sym) (scope-lookup-binding-local-ns node sym 'ordinary))
    ((node sym ns) (scope-lookup-binding-local-ns node sym ns))))

(define (scope-lookup-binding-ns node sym ns)
  (if (not (scope-node? node))
      #f
      (if (eq? ns 'label)
          (scope-lookup-binding-local-ns (scope-find-function-contour node) sym 'label)
          (let loop ((curr node))
            (if (not (scope-node? curr))
                #f
                (let ((found (scope-lookup-binding-local-ns curr sym ns)))
                  (if found
                      found
                      (loop (scope-node-parent curr)))))))))

(define scope-lookup-binding
  (case-lambda
    ((node sym) (scope-lookup-binding-ns node sym 'ordinary))
    ((node sym ns) (scope-lookup-binding-ns node sym ns))))

(define (scope-lookup-hygienic-ns node sym use-scope-set ns)
  (if (not (scope-node? node))
      #f
      (let collect ((curr node) (cands '()))
        (if (not (scope-node? curr))
            (resolve-hygienic-binding (reverse cands) use-scope-set)
            (let scan ((bs (scope-node-ns-bindings curr)) (acc cands))
              (if (null? bs)
                  (collect (scope-node-parent curr) acc)
                  (let ((b (car bs)))
                    (if (and (eq? (binding-namespace b) ns)
                             (eq? (binding-source-name b) sym))
                        (scan (cdr bs) (cons b acc))
                        (scan (cdr bs) acc)))))))))

(define scope-lookup-hygienic
  (case-lambda
    ((node sym use-scope-set) (scope-lookup-hygienic-ns node sym use-scope-set 'ordinary))
    ((node sym use-scope-set ns) (scope-lookup-hygienic-ns node sym use-scope-set ns))))

(define (scope-lookup-kind node sym)
  (let ((b (scope-lookup-binding node sym 'ordinary)))
    (if b (binding-kind b) #f)))

(define (scope-typedef-name? node sym)
  (eq? (scope-lookup-kind node sym) 'typedef))

(define (scope-parse-define-opts opts)
  (let loop ((rest opts)
             (ns #f)
             (u-sym #f)
             (sc #f)
             (ty #f)
             (vis #f)
             (sset scope-set-empty)
             (span #f)
             (strict? #f)
             (no-legacy? #f))
    (if (not (and (pair? rest) (pair? (cdr rest))))
        (list ns u-sym sc ty vis sset span strict? no-legacy?)
        (let ((k (car rest))
              (v (cadr rest))
              (tl (cddr rest)))
          (cond
            ((memq k '(:namespace namespace))
             (loop tl v u-sym sc ty vis sset span strict? no-legacy?))
            ((memq k '(:unique-sym unique-sym))
             (loop tl ns v sc ty vis sset span strict? no-legacy?))
            ((memq k '(:storage-class storage-class))
             (loop tl ns u-sym v ty vis sset span strict? no-legacy?))
            ((memq k '(:type-attr type-attr))
             (loop tl ns u-sym sc v vis sset span strict? no-legacy?))
            ((memq k '(:visibility visibility))
             (loop tl ns u-sym sc ty v sset span strict? no-legacy?))
            ((memq k '(:scope-set scope-set))
             (loop tl ns u-sym sc ty vis v span strict? no-legacy?))
            ((memq k '(:source-span source-span))
             (loop tl ns u-sym sc ty vis sset v strict? no-legacy?))
            ((memq k '(:strict strict))
             (loop tl ns u-sym sc ty vis sset span v no-legacy?))
            ((memq k '(:no-legacy-bind no-legacy-bind))
             (loop tl ns u-sym sc ty vis sset span strict? v))
            (else
             (loop tl ns u-sym sc ty vis sset span strict? no-legacy?)))))))

(define (scope-define-opts node source-name kind opts)
  (if (not (scope-node? node))
      (scope-error! "scope-define!: invalid scope-node" node))
  (let* ((parsed (scope-parse-define-opts opts))
         (opt-ns (list-ref parsed 0))
         (opt-usym (list-ref parsed 1))
         (opt-sc (list-ref parsed 2))
         (opt-ty (list-ref parsed 3))
         (opt-vis (list-ref parsed 4))
         (opt-sset (list-ref parsed 5))
         (opt-span (list-ref parsed 6))
         (opt-strict (list-ref parsed 7))
         (opt-no-legacy (list-ref parsed 8))
         (ns (or opt-ns (infer-binding-namespace kind)))
         (target-node (if (eq? ns 'label)
                          (scope-find-function-contour node)
                          node))
         (sset (if (list? opt-sset) opt-sset scope-set-empty))
         (vis (or opt-vis
                  (if (eq? (scope-node-kind target-node) 'top-level)
                      'global
                      'local)))
         (sc (or opt-sc
                 (cond
                   ((eq? kind 'typedef) 'typedef)
                   ((eq? (scope-node-kind target-node) 'top-level) 'global)
                   (else 'lexical))))
         (span (or opt-span (current-ast-span))))
    (if (or opt-strict (scope-strict-redefinition?))
        (let check ((bs (scope-node-ns-bindings target-node)))
          (if (pair? bs)
              (let ((existing (car bs)))
                (if (and (eq? (binding-namespace existing) ns)
                         (eq? (binding-source-name existing) source-name)
                         (scope-set-equal? (binding-scope-set existing) sset))
                    (scope-error! "Redefinition of symbol in same scope"
                                  (list source-name kind ns))
                    (check (cdr bs)))))))
    (let* ((u-sym (or opt-usym
                      (if (or (memq kind '(typedef enum-const tag-struct tag-union tag-enum label macro builtin))
                              (memq vis '(global extern)))
                          source-name
                          (make-alpha-symbol source-name))))
           (b (make-binding (next-binding-id!)
                            source-name
                            u-sym
                            kind
                            ns
                            (scope-node-id target-node)
                            sc
                            opt-ty
                            vis
                            sset
                            span)))
      (register-binding! b)
      (let ((nbc (scope-node-ns-bindings-cell target-node)))
        (set-car! nbc (cons b (car nbc))))
      (if (and (eq? ns 'ordinary) (not opt-no-legacy))
          (let ((bc (scope-node-bindings-cell target-node)))
            (set-car! bc (cons (cons source-name u-sym) (car bc)))))
      b)))

(define scope-define!
  (case-lambda
    ((node source-name kind)
     (scope-define-opts node source-name kind '()))
    ((node source-name kind o1)
     (scope-define-opts node source-name kind (list o1)))
    ((node source-name kind o1 o2)
     (scope-define-opts node source-name kind (list o1 o2)))))

(define (make-scope-manager)
  (let ((root (make-scope-node #f 'top-level)))
    (list 'scope-manager root (cons root '()))))

(define (scope-manager? obj)
  (and (pair? obj) (eq? (car obj) 'scope-manager)))

(define (scope-manager-root mgr)
  (cadr mgr))

(define (scope-manager-current mgr)
  (car (caddr mgr)))

(define (scope-manager-push! mgr kind)
  (let* ((curr (scope-manager-current mgr))
         (child (scope-enter curr kind)))
    (set-car! (caddr mgr) child)
    child))

(define (scope-manager-pop! mgr)
  (let* ((curr (scope-manager-current mgr))
         (parent (scope-node-parent curr)))
    (if (not (scope-node? parent))
        (scope-error! "Scope stack underflow: cannot pop root scope"
                      (list (scope-node-id curr) (scope-node-kind curr))))
    (set-car! (caddr mgr) parent)
    parent))

(define scope-manager-define!
  (case-lambda
    ((mgr sym kind)
     (scope-define-opts (scope-manager-current mgr) sym kind '()))
    ((mgr sym kind o1)
     (scope-define-opts (scope-manager-current mgr) sym kind (list o1)))
    ((mgr sym kind o1 o2)
     (scope-define-opts (scope-manager-current mgr) sym kind (list o1 o2)))))

(define scope-manager-lookup
  (case-lambda
    ((mgr sym)
     (scope-lookup-binding-ns (scope-manager-current mgr) sym 'ordinary))
    ((mgr sym ns)
     (scope-lookup-binding-ns (scope-manager-current mgr) sym ns))))

(define scope-manager-lookup-local
  (case-lambda
    ((mgr sym)
     (scope-lookup-binding-local-ns (scope-manager-current mgr) sym 'ordinary))
    ((mgr sym ns)
     (scope-lookup-binding-local-ns (scope-manager-current mgr) sym ns))))

(define (scope-manager-lookup-kind mgr sym)
  (scope-lookup-kind (scope-manager-current mgr) sym))

(define (scope-manager-typedef-name? mgr sym)
  (scope-typedef-name? (scope-manager-current mgr) sym))

;;; -----------------------------------------------------------------------
;;; Part 2: Deterministic Alpha Symbol Generator
;;; -----------------------------------------------------------------------

(define *alpha-symbol-counter* (cons 0 '()))

(define (reset-alpha-symbol-counter!)
  (set-car! *alpha-symbol-counter* 0)
  (reset-binding-registry!)
  (reset-scope-id-counter!))

(define (alpha-next-id!)
  (let ((c (car *alpha-symbol-counter*)))
    (set-car! *alpha-symbol-counter* (+ c 1))
    c))

(define (make-alpha-symbol orig-sym)
  (let* ((orig-str (symbol->string orig-sym))
         (id (alpha-next-id!))
         (new-str (string-append orig-str "$" (number->string id))))
    (string->symbol new-str)))

;;; -----------------------------------------------------------------------
;;; Part 3: Known Primitives, Runtime Built-ins & Global Definitions
;;; -----------------------------------------------------------------------

(define *scope-runtime-special-forms*
  '(quote if begin set! lambda let letrec letrec*
    %make-closure %make-closure-env %closure-ref %closure-set!
    %cont-fun %cont-call %with-handler %raw-call/cc %call-with-values
    %values %program define define-values define-record-type))

(define (scope-special-form? sym)
  (if (memq sym *scope-runtime-special-forms*) #t #f))

(define *scope-standard-builtins*
  '(+ - * / = < <= > >= modulo quotient remainder abs
    zero? not eq? eqv? equal? pair? null? boolean? char?
    string? vector? bytevector? procedure? symbol? number?
    integer? exact? inexact? real? rational? complex?
    fixnum? exact-integer? list?
    car cdr set-car! set-cdr! caar cadr cdar cddr caaar caadr cadar caddr cdaar cdadr cddar cdddr
    cons list append reverse length memq assq
    make-string string-length string-ref string-set! string-copy string-copy! string-fill! string-append
    string=? string<? string>? string<=? string>=?
    string-ci=? string-ci<? string-ci>? string-ci<=? string-ci>=?
    string-upcase string-downcase string-foldcase
    char=? char<? char>? char<=? char>=?
    char-ci=? char-ci<? char-ci>? char-ci<=? char-ci>=?
    char-alphabetic? char-numeric? char-whitespace? char-upper-case? char-lower-case?
    digit-value char-upcase char-downcase char-foldcase
    make-vector vector-length vector-ref vector-set! vector-copy vector-copy! vector-fill! vector-append
    vector->list list->vector string->list list->string
    make-bytevector bytevector-length bytevector-u8-ref bytevector-u8-set! bytevector-copy bytevector-copy! bytevector-append
    write-char read-char peek-char write-string display newline write read error raise
    call-with-values values call/cc dynamic-wind
    open-input-file flush-output-port eof-object eof-object?
    power-assert-report dump-lir-unbound-variable-diagnostic
    %raw-load %raw-load-u8 %raw-store! %raw-syscall %raw-add %raw-sub %raw-mul %raw-cmp
    %ptr-add %ptr-tag %ptr-untag %ptr-tag-add %to-raw %to-fixnum %box-fixnum %unbox-fixnum
    %num-args %get-rsp %get-heap-ptr %get-heap-limit-ptr %get-gc-state-ptr %get-environ-ptr %get-stackmap-table %get-initial-heap-ptr %get-initial-heap sys-initial-heap
    %memory-fence %atomic-cas!))

(define (scope-primitive-symbol? sym)
  (or (scope-special-form? sym)
      (if (memq sym *scope-standard-builtins*) #t #f)
      (zero-arg-prim? sym)
      (unary-prim? sym)
      (binop-prim? sym)
      (triop-prim? sym)
      (septop-prim? sym)
      (closure-prim? sym)
      (pure-prim? sym)
      ;; Any low-level compiler internal symbol starting with '%' is treated as a runtime builtin
      (let ((s (symbol->string sym)))
        (and (> (string-length s) 0)
             (char=? (string-ref s 0) #\%)))))

(define (collect-top-level-defines defs)
  (let loop ((ds defs) (acc '()))
    (if (null? ds)
        (reverse acc)
        (let ((d (ast-strip-span (car ds))))
          (cond
            ((and (pair? d) (eq? (car d) 'define) (pair? (cdr d)))
             (let ((spec (cadr d)))
               (if (pair? spec)
                   (loop (cdr ds) (cons (car spec) acc))
                   (loop (cdr ds) (cons spec acc)))))
            ((and (pair? d) (eq? (car d) 'define-values) (pair? (cdr d)))
             (let ((formals (cadr d)))
               (if (list? formals)
                   (loop (cdr ds) (append (reverse formals) acc))
                   (loop (cdr ds) acc))))
            (else
             (loop (cdr ds) acc)))))))

(define (scope-make-symbol-set syms)
  (let ((v (make-vector 1024 '())))
    (let loop ((xs syms))
      (if (pair? xs)
          (let* ((s (car xs))
                 (idx (symbol->hash-idx s))
                 (bucket (vector-ref v idx)))
            (if (not (memq s bucket))
                (vector-set! v idx (cons s bucket)))
            (loop (cdr xs)))
          v))))

(define (scope-symbol-set-contains? v sym)
  (if (and (vector? v) (symbol? sym))
      (let* ((idx (symbol->hash-idx sym))
             (bucket (vector-ref v idx)))
        (if (memq sym bucket) #t #f))
      #f))

(define (scope-known-global-or-prim? sym globals)
  (or (if (vector? globals)
          (scope-symbol-set-contains? globals sym)
          (if (memq sym globals) #t #f))
      (scope-primitive-symbol? sym)))

;;; -----------------------------------------------------------------------
;;; Part 4: Early Unbound Variable Detection
;;; -----------------------------------------------------------------------

(define *scope-unbound-vars* (cons '() '()))
(define *scope-strict-unbound-check* (cons #f '()))

(define (reset-scope-unbound-vars!)
  (set-car! *scope-unbound-vars* '()))

(define (record-scope-unbound-var! var context)
  (if (not (memq var (car *scope-unbound-vars*)))
      (set-car! *scope-unbound-vars* (cons var (car *scope-unbound-vars*)))))

(define (get-scope-unbound-vars)
  (reverse (car *scope-unbound-vars*)))

(define (set-scope-strict-unbound-check! bool)
  (set-car! *scope-strict-unbound-check* bool))

(define (scope-strict-unbound-check?)
  (car *scope-strict-unbound-check*))

;;; -----------------------------------------------------------------------
;;; Part 5: Alpha-Conversion Engine (Barendregt Variable Normalization)
;;; -----------------------------------------------------------------------

(define (alpha-convert-list es scope globals)
  (let loop ((rest es) (acc '()))
    (if (null? rest)
        (reverse acc)
        (loop (cdr rest) (cons (alpha-convert-expr (car rest) scope globals) acc)))))

(define (alpha-convert-expr expr scope globals)
  (cond
    ;; 0. Source Span / Loc Wrappers: preserve metadata & set current-ast-span
    ((ast-has-span? expr)
     (let ((span (ast-source-span expr))
           (inner (ast-strip-span expr)))
       (ast-with-span
        (with-ast-span span
          (lambda () (alpha-convert-expr inner scope globals)))
        span)))

    ((source-loc? expr)
     (let ((file (source-loc-file expr))
           (line (source-loc-line expr))
           (col (source-loc-col expr))
           (inner (source-loc-form expr))
           (span (ast-source-span expr)))
       (list '%source-loc file line col
             (with-ast-span span
               (lambda () (alpha-convert-expr inner scope globals))))))

    ;; 1. Literal Quote: datum inside (quote ...) is preserved verbatim
    ((and (pair? expr) (eq? (car expr) 'quote))
     expr)

    ;; 2. Atomic Symbol: Variable reference
    ((symbol? expr)
     (let ((alpha-sym (scope-lookup scope expr)))
       (cond
         (alpha-sym
          ;; Propagate free-variable usage & Binding IDs up the lexical contour tree
          (if (not (scope-lookup-local scope expr))
              (let ((b (lookup-binding-by-symbol alpha-sym)))
                (let propagate ((curr scope))
                  (if (and (scope-node? curr)
                           (not (eq? (scope-node-kind curr) 'top-level))
                           (not (scope-lookup-local curr expr)))
                      (if (memq expr (scope-node-free-vars curr))
                          #t
                          (begin
                            (scope-record-free-var! curr expr)
                            (if (binding? b)
                                (scope-record-free-binding-id! curr (binding-id b)))
                            (propagate (scope-node-parent curr))))))))
          alpha-sym)
         ((scope-known-global-or-prim? expr globals)
          expr)
         (else
          (record-scope-unbound-var! expr scope)
          (if (scope-strict-unbound-check?)
              (error (string-append "Static Scope Error: Unbound variable '" (symbol->string expr) "'") expr)
              expr)))))

    ;; 3. Non-symbol atomics (numbers, booleans, chars, strings, null)
    ((not (pair? expr))
     expr)

    ;; 4. Composite Forms
    (else
     (let ((op (car expr)))
       (case op
         ;; 4.1 Conditional: (if test then [else])
         ((if)
          (let ((test (alpha-convert-expr (cadr expr) scope globals))
                (then (alpha-convert-expr (caddr expr) scope globals))
                (else-expr (if (null? (cdddr expr))
                               #f
                               (alpha-convert-expr (cadddr expr) scope globals))))
            (if (null? (cdddr expr))
                (list 'if test then)
                (list 'if test then else-expr))))

         ;; 4.2 Sequencing: (begin e ...)
         ((begin)
          (cons 'begin (alpha-convert-list (cdr expr) scope globals)))

         ;; 4.3 Assignment: (set! var val)
         ((set!)
          (let* ((var (cadr expr))
                 (val (alpha-convert-expr (caddr expr) scope globals))
                 (alpha-var (scope-lookup scope var)))
            (if alpha-var
                (list 'set! alpha-var val)
                (if (scope-known-global-or-prim? var globals)
                    (list 'set! var val)
                    (begin
                      (record-scope-unbound-var! var scope)
                      (if (scope-strict-unbound-check?)
                          (error (string-append "Static Scope Error: Unbound variable in set! '" (symbol->string var) "'") var)
                          (list 'set! var val)))))))

         ;; 4.4 Abstraction: (lambda (params ...) body)
         ((lambda)
          (let* ((params (cadr expr))
                 (body (caddr expr))
                 (child-scope (scope-enter scope 'lambda))
                 (alpha-params
                  (let loop ((ps params) (acc '()))
                    (cond
                      ((null? ps)
                       (reverse acc))
                      ((symbol? ps)
                       (let ((a-p (make-alpha-symbol ps)))
                         (scope-bind! child-scope ps a-p)
                         (let append-dotted ((lst (reverse acc)))
                           (if (null? lst)
                               a-p
                               (cons (car lst) (append-dotted (cdr lst)))))))
                      (else
                       (let* ((p (car ps))
                              (a-p (make-alpha-symbol p)))
                         (scope-bind! child-scope p a-p)
                         (loop (cdr ps) (cons a-p acc)))))))
                 (converted-body (alpha-convert-expr body child-scope globals)))
            (list 'lambda alpha-params converted-body)))

         ;; 4.5 Local Binding: (let ((var expr) ...) body)
         ((let)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 ;; Binding RHS expressions are evaluated in the outer scope
                 (converted-rhs
                  (let loop ((bs bindings) (acc '()))
                    (if (null? bs)
                        (reverse acc)
                        (let* ((b (car bs))
                               (v (cadr b)))
                          (loop (cdr bs) (cons (alpha-convert-expr v scope globals) acc))))))
                 ;; Body is evaluated in the new child scope with alpha variables
                 (child-scope (scope-enter scope 'let))
                 (alpha-vars
                  (let loop ((bs bindings) (acc '()))
                    (if (null? bs)
                        (reverse acc)
                        (let* ((b (car bs))
                               (k (car b))
                               (a-k (make-alpha-symbol k)))
                          (scope-bind! child-scope k a-k)
                          (loop (cdr bs) (cons a-k acc))))))
                 (new-bindings
                  (let loop ((vars alpha-vars) (vals converted-rhs) (acc '()))
                    (if (null? vars)
                        (reverse acc)
                        (loop (cdr vars) (cdr vals) (cons (list (car vars) (car vals)) acc)))))
                 (converted-body (alpha-convert-expr body child-scope globals)))
            (list 'let new-bindings converted-body)))

         ;; 4.6 Recursive Binding: (letrec ((var expr) ...) body)
         ((letrec)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (child-scope (scope-enter scope 'letrec))
                 ;; All variables are bound in child-scope prior to RHS conversion
                 (alpha-vars
                  (let loop ((bs bindings) (acc '()))
                    (if (null? bs)
                        (reverse acc)
                        (let* ((b (car bs))
                               (k (car b))
                               (a-k (make-alpha-symbol k)))
                          (scope-bind! child-scope k a-k)
                          (loop (cdr bs) (cons a-k acc))))))
                 (converted-rhs
                  (let loop ((bs bindings) (acc '()))
                    (if (null? bs)
                        (reverse acc)
                        (let* ((b (car bs))
                               (v (cadr b)))
                          (loop (cdr bs) (cons (alpha-convert-expr v child-scope globals) acc))))))
                 (new-bindings
                  (let loop ((vars alpha-vars) (vals converted-rhs) (acc '()))
                    (if (null? vars)
                        (reverse acc)
                        (loop (cdr vars) (cdr vals) (cons (list (car vars) (car vals)) acc)))))
                 (converted-body (alpha-convert-expr body child-scope globals)))
            (list 'letrec new-bindings converted-body)))

         ;; 4.7 Continuation Function: (%cont-fun f-name (params ...) f-body in-body)
         ((%cont-fun)
          (let* ((f-name (cadr expr))
                 (params (caddr expr))
                 (f-body (cadddr expr))
                 (in-body (cadr (cdddr expr)))
                 (alpha-f (make-alpha-symbol f-name))
                 ;; f-body scope binds parameters and alpha-f
                 (f-scope (scope-enter scope '%cont-fun))
                 (alpha-params
                  (let loop ((ps params) (acc '()))
                    (if (null? ps)
                        (reverse acc)
                        (let* ((p (car ps))
                               (a-p (make-alpha-symbol p)))
                          (scope-bind! f-scope p a-p)
                          (loop (cdr ps) (cons a-p acc)))))))
            (scope-bind! f-scope f-name alpha-f)
            (let ((new-f-body (alpha-convert-expr f-body f-scope globals))
                  ;; in-body has alpha-f in scope
                  (in-scope (scope-enter scope '%cont-fun)))
              (scope-bind! in-scope f-name alpha-f)
              (let ((new-in-body (alpha-convert-expr in-body in-scope globals)))
                (list '%cont-fun alpha-f alpha-params new-f-body new-in-body)))))

         ;; 4.8 Continuation Call: (%cont-call target es ...)
         ((%cont-call)
          (let ((target (alpha-convert-expr (cadr expr) scope globals))
                (args (alpha-convert-list (cddr expr) scope globals)))
            (cons '%cont-call (cons target args))))

         ;; 4.9 Dynamic Exception Handler: (%with-handler h body)
         ((%with-handler)
          (list '%with-handler
                (alpha-convert-expr (cadr expr) scope globals)
                (alpha-convert-expr (caddr expr) scope globals)))

         ;; 4.10 Call/cc raw: (%raw-call/cc arg)
         ((%raw-call/cc)
          (list '%raw-call/cc (alpha-convert-expr (cadr expr) scope globals)))

         ;; 4.11 Values & Call-with-values
         ((%values)
          (cons '%values (alpha-convert-list (cdr expr) scope globals)))

         ((%call-with-values)
          (list '%call-with-values
                (alpha-convert-expr (cadr expr) scope globals)
                (alpha-convert-expr (caddr expr) scope globals)))

         ;; 4.12 Closures (lowered primitives)
         ((%make-closure)
          (cons '%make-closure (cons (cadr expr) (alpha-convert-list (cddr expr) scope globals))))

         ((%make-closure-env)
          (cons '%make-closure-env (cons (cadr expr) (alpha-convert-list (cddr expr) scope globals))))

         ;; 4.13 Program Container: (%program defs main)
         ((%program)
          (alpha-convert-program-node expr globals))

         ;; 4.14 General Function / Primitive Application: (op arg ...)
         (else
          (let ((conv-op (alpha-convert-expr op scope globals))
                (conv-args (alpha-convert-list (cdr expr) scope globals)))
            (cons conv-op conv-args))))))))

;;; -----------------------------------------------------------------------
;;; Part 6: Program-Level Conversion & Verification
;;; -----------------------------------------------------------------------

(define (alpha-convert-program-node prog-expr base-globals)
  (let* ((defs (cadr prog-expr))
         (main (caddr prog-expr))
         (top-defines (collect-top-level-defines defs))
         (all-globals (scope-make-symbol-set (append top-defines base-globals)))
         (top-scope (make-scope-node #f 'top-level))
         (_set-root (set-car! *last-resolved-scope-tree* top-scope))
         (_reg-defs
          (let reg-loop ((ds defs))
            (if (pair? ds)
                (let* ((raw-d (car ds))
                       (d (ast-strip-span raw-d))
                       (d-span (ast-source-span raw-d)))
                  (if (and (pair? d) (eq? (car d) 'define) (pair? (cdr d)) (pair? (cddr d)))
                      (let* ((spec (cadr d))
                             (def-name (if (pair? spec) (car spec) spec))
                             (val-stripped (ast-strip-span (caddr d)))
                             (kind (if (or (pair? spec)
                                           (and (pair? val-stripped) (eq? (car val-stripped) 'lambda)))
                                       'function
                                       'variable)))
                        (if (symbol? def-name)
                            (scope-define-opts top-scope def-name kind
                                               (list ':unique-sym def-name
                                                     ':storage-class 'global
                                                     ':visibility 'global
                                                     ':source-span d-span
                                                     ':no-legacy-bind #t)))))
                  (reg-loop (cdr ds))))))
         (converted-defs
          (let loop ((ds defs) (acc '()))
            (if (null? ds)
                (reverse acc)
                (let* ((raw-d (car ds))
                       (d (ast-strip-span raw-d))
                       (d-span (ast-source-span raw-d)))
                  (if (and (pair? d) (eq? (car d) 'define) (pair? (cdr d)) (pair? (cddr d)))
                      (let* ((name (cadr d))
                             (val (caddr d))
                             (conv-val (if d-span
                                           (with-ast-span d-span
                                             (lambda () (alpha-convert-expr val top-scope all-globals)))
                                           (alpha-convert-expr val top-scope all-globals)))
                             (res-def (list 'define name conv-val)))
                        (loop (cdr ds)
                              (cons (cond
                                      ((ast-has-span? raw-d) (ast-with-span res-def d-span))
                                      ((source-loc? raw-d)
                                       (list '%source-loc
                                             (source-loc-file raw-d)
                                             (source-loc-line raw-d)
                                             (source-loc-col raw-d)
                                             res-def))
                                      (else res-def))
                                    acc)))
                      (loop (cdr ds) (cons (alpha-convert-expr raw-d top-scope all-globals) acc)))))))
         (converted-main (alpha-convert-expr main top-scope all-globals)))
    (list '%program converted-defs converted-main)))

(define (alpha-convert-program ast)
  (reset-scope-unbound-vars!)
  (if (and (pair? ast) (eq? (car ast) '%program))
      (alpha-convert-program-node ast '())
      (let* ((top-scope (make-scope-node #f 'top-level)))
        (set-car! *last-resolved-scope-tree* top-scope)
        (alpha-convert-expr ast top-scope '()))))

;;; -----------------------------------------------------------------------
;;; Part 7: Public API & Pass 035 Integration Entry Point
;;; -----------------------------------------------------------------------

(define (scope-resolve-all ast)
  (reset-alpha-symbol-counter!)
  (alpha-convert-program ast))

(define (detect-unbound-variables ast)
  (let ((saved-strict (scope-strict-unbound-check?)))
    (set-scope-strict-unbound-check! #f)
    (reset-scope-unbound-vars!)
    (alpha-convert-program ast)
    (let ((unbounds (get-scope-unbound-vars)))
      (set-scope-strict-unbound-check! saved-strict)
      unbounds)))

(define (scope-check-unbound! ast)
  (let ((saved-strict (scope-strict-unbound-check?)))
    (set-scope-strict-unbound-check! #t)
    (reset-scope-unbound-vars!)
    (let ((res (alpha-convert-program ast)))
      (set-scope-strict-unbound-check! saved-strict)
      res)))
;;; =======================================================================
;;; ULisp Language Workbench: Guest Frame Descriptor & Slot Lowering
;;; Conforms to DSN-33-04 §2.1 & §2.2, DSN-33-03 §3.3 & Issue #892
;;; =======================================================================
;;; Provides:
;;; - <guest-frame-descriptor>: Compile-time static stack frame layout
;;; - gfd-empty, gfd-add-slot!, gfd-lookup-slot, gfd-mark-escape!
;;; - gfd-emit-slot-ref, gfd-emit-slot-set!: Lowering to vector-ref / local-slot-ref
;;; - lower-guest-env-to-frame: AST lowering eliminating dynamic alist lookups
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. <guest-frame-descriptor> Record Definition
;;; -----------------------------------------------------------------------

(define-record-type <guest-frame-descriptor>
  (%make-guest-frame-descriptor-raw num-slots slot-names slot-types escape-mask)
  guest-frame-descriptor?
  (num-slots   gfd-num-slots   gfd-num-slots-set!)
  (slot-names  gfd-slot-names  gfd-slot-names-set!)
  (slot-types  gfd-slot-types  gfd-slot-types-set!)
  (escape-mask gfd-escape-mask gfd-escape-mask-set!))

;;; Creates an empty frame descriptor with 0 slots
(define (gfd-empty)
  (%make-guest-frame-descriptor-raw 0 '() '() 0))

;;; Creates a frame descriptor with initial capacity / given slot names
(define (make-guest-frame-descriptor slot-names)
  (let loop ((names slot-names) (idx 0) (gfd (gfd-empty)))
    (if (null? names)
        gfd
        (begin
          (gfd-add-slot! gfd (car names) 'any)
          (loop (cdr names) (+ idx 1) gfd)))))

;;; -----------------------------------------------------------------------
;;; 2. Frame Descriptor Slot Operations
;;; -----------------------------------------------------------------------

;;; Returns the current slot count (Fixnum)
(define (gfd-slot-count gfd)
  (gfd-num-slots gfd))

;;; Finds the 0-based index of a variable name in the frame descriptor.
;;; Returns the integer slot index if found, or #f if not present.
(define (gfd-lookup-slot gfd name)
  (let ((names (gfd-slot-names gfd)))
    (let loop ((lst names) (idx 0))
      (cond
        ((null? lst) #f)
        ((eq? (car lst) name) idx)
        (else (loop (cdr lst) (+ idx 1)))))))

;;; Adds a new slot to the frame descriptor if not already present.
;;; Returns the assigned slot index (Fixnum).
(define gfd-add-slot!
  (case-lambda
    ((gfd name)
     (gfd-add-slot! gfd name 'any))
    ((gfd name type-hint)
     (let ((existing (gfd-lookup-slot gfd name)))
       (if existing
           existing
           (let* ((curr-cnt (gfd-num-slots gfd))
                  (new-names (append (gfd-slot-names gfd) (list name)))
                  (new-types (append (gfd-slot-types gfd) (list type-hint))))
             (gfd-num-slots-set! gfd (+ curr-cnt 1))
             (gfd-slot-names-set! gfd new-names)
             (gfd-slot-types-set! gfd new-types)
             curr-cnt))))))

;;; Marks a slot as escaping (captured in a closure, dynamic eval, etc.)
(define (gfd-mark-escape! gfd slot-idx)
  (let ((mask (gfd-escape-mask gfd)))
    ;; Set bit at slot-idx: mask | (1 << slot-idx)
    (let ((bit (bitwise-arithmetic-shift 1 slot-idx)))
      (gfd-escape-mask-set! gfd (bitwise-ior mask bit)))))

;;; Checks if a slot escapes
(define (gfd-escapes? gfd slot-idx)
  (let ((mask (gfd-escape-mask gfd)))
    (let ((bit (bitwise-arithmetic-shift 1 slot-idx)))
      (not (zero? (bitwise-and mask bit))))))

;;; Returns the variable name at slot-idx
(define (gfd-slot-name gfd slot-idx)
  (let ((names (gfd-slot-names gfd)))
    (if (and (>= slot-idx 0) (< slot-idx (gfd-num-slots gfd)))
        (list-ref names slot-idx)
        #f)))

;;; Returns the static type hint at slot-idx
(define (gfd-slot-type gfd slot-idx)
  (let ((types (gfd-slot-types gfd)))
    (if (and (>= slot-idx 0) (< slot-idx (gfd-num-slots gfd)))
        (list-ref types slot-idx)
        'any)))

;;; -----------------------------------------------------------------------
;;; 3. Residual Code Generation (Lowering to Vector / Local Slot)
;;; -----------------------------------------------------------------------

;;; Emits a residual slot reference expression:
;;; - Escaping: (vector-ref <frame-sym> <slot-idx>)
;;; - Non-escaping: (local-slot-ref <slot-idx>) or directly the virtual register
(define (gfd-emit-slot-ref frame-sym slot-idx escape?)
  (if escape?
      (list 'vector-ref frame-sym slot-idx)
      (list 'local-slot-ref slot-idx)))

;;; Emits a residual slot mutation expression:
;;; - Escaping: (vector-set! <frame-sym> <slot-idx> <val-expr>)
;;; - Non-escaping: (local-slot-set! <slot-idx> <val-expr>)
(define (gfd-emit-slot-set! frame-sym slot-idx val-expr escape?)
  (if escape?
      (list 'vector-set! frame-sym slot-idx val-expr)
      (list 'local-slot-set! slot-idx val-expr)))

;;; Emits initial frame allocation: (make-vector <num-slots> #f)
(define (gfd-emit-frame-alloc gfd)
  (list 'make-vector (gfd-num-slots gfd) #f))

;;; -----------------------------------------------------------------------
;;; 4. Global Dynamic Context for Stage-Poly Lowering Integration
;;; -----------------------------------------------------------------------

;; Cell holding current active <guest-frame-descriptor> during lowering
(define *current-guest-frame-descriptor-cell* (cons #f '()))

(define (get-current-guest-frame-descriptor)
  (car *current-guest-frame-descriptor-cell*))

(define (set-current-guest-frame-descriptor! gfd)
  (set-car! *current-guest-frame-descriptor-cell* gfd))

(define (with-guest-frame-descriptor gfd thunk)
  (let ((prev (get-current-guest-frame-descriptor)))
    (set-current-guest-frame-descriptor! gfd)
    (let ((result (thunk)))
      (set-current-guest-frame-descriptor! prev)
      result)))

;;; -----------------------------------------------------------------------
;;; 5. AST Lowering: Eliminating Dynamic Alist Lookups
;;; -----------------------------------------------------------------------

;;; Traverses an AST and lowers alist-based environment accesses:
;;; - (cdr (assq 'x env)) -> (vector-ref frame idx)
;;; - (assq 'x env) -> (cons 'x (vector-ref frame idx)) [if entry needed]
;;; - (env-lookup env 'x) -> (vector-ref frame idx)
;;; - (ctfe-env-lookup env 'x) -> (vector-ref frame idx)
(define (lower-guest-env-to-frame ast gfd frame-sym)
  (cond
    ((not (pair? ast)) ast)

    ;; Pattern 1: (cdr (assq 'var env))
    ((and (eq? (car ast) 'cdr)
          (pair? (cdr ast))
          (pair? (cadr ast))
          (eq? (car (cadr ast)) 'assq)
          (pair? (cdr (cadr ast)))
          (pair? (cddr (cadr ast))))
     (let* ((assq-node (cadr ast))
            (key-expr (cadr assq-node))
            (env-expr (caddr assq-node)))
       (let ((var-name (if (and (pair? key-expr) (eq? (car key-expr) 'quote))
                           (cadr key-expr)
                           (if (symbol? key-expr) key-expr #f))))
         (if (and var-name (eq? env-expr 'env))
             (let ((slot-idx (gfd-lookup-slot gfd var-name)))
               (if slot-idx
                   (let ((esc? (gfd-escapes? gfd slot-idx)))
                     (gfd-emit-slot-ref frame-sym slot-idx esc?))
                   ast))
             (cons 'cdr (list (lower-guest-env-to-frame (cadr ast) gfd frame-sym)))))))

    ;; Pattern 2: (assq 'var env) - when used directly as an entry
    ((and (eq? (car ast) 'assq)
          (pair? (cdr ast))
          (pair? (cddr ast)))
     (let* ((key-expr (cadr ast))
            (env-expr (caddr ast)))
       (let ((var-name (if (and (pair? key-expr) (eq? (car key-expr) 'quote))
                           (cadr key-expr)
                           (if (symbol? key-expr) key-expr #f))))
         (if (and var-name (eq? env-expr 'env))
             (let ((slot-idx (gfd-lookup-slot gfd var-name)))
               (if slot-idx
                   (let* ((esc? (gfd-escapes? gfd slot-idx))
                          (val-ref (gfd-emit-slot-ref frame-sym slot-idx esc?)))
                     (list 'cons (list 'quote var-name) val-ref))
                   ast))
             ast))))

    ;; Pattern 3: (env-lookup env 'var) or (ctfe-env-lookup env 'var)
    ((and (memq (car ast) '(env-lookup ctfe-env-lookup guest-env-lookup))
          (pair? (cdr ast))
          (pair? (cddr ast)))
     (let* ((env-expr (cadr ast))
            (key-expr (caddr ast)))
       (let ((var-name (if (and (pair? key-expr) (eq? (car key-expr) 'quote))
                           (cadr key-expr)
                           (if (symbol? key-expr) key-expr #f))))
         (if (and var-name (or (eq? env-expr 'env) (eq? env-expr frame-sym)))
             (let ((slot-idx (gfd-lookup-slot gfd var-name)))
               (if slot-idx
                   (let ((esc? (gfd-escapes? gfd slot-idx)))
                     (gfd-emit-slot-ref frame-sym slot-idx esc?))
                   ast))
             (cons (car ast) (map (lambda (x) (lower-guest-env-to-frame x gfd frame-sym)) (cdr ast)))))))

    ;; Recursively lower sub-expressions
    (else
     (cons (lower-guest-env-to-frame (car ast) gfd frame-sym)
           (lower-guest-env-to-frame (cdr ast) gfd frame-sym)))))
;;; =======================================================================
;;; ULisp Language Workbench: Guest Dynamic Value Tagging (3-bit Tagging)
;;; Conforms to DSN-33-04 §2.3, DSN-33-02 §5.1, DSN-33-03 §4.4 & Issue #893
;;; =======================================================================
;;; Provides:
;;; - 3-bit Tagged Pointer scheme for 64-bit architectures
;;; - Tag definitions: Fixnum (000), Pair (001), Symbol (010), Closure (011),
;;;   Vector (100), Instance (101), Flonum (110), Special/Immediates (111)
;;; - Pure Scheme packing, unpacking, type predicates, and assertions
;;; - Residual ANF / LIR code emission helpers with compile-time tag stripping
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. 3-bit Tag Constants (DSN-33-04 §2.3)
;;; -----------------------------------------------------------------------

(define GUEST_TAG_FIXNUM   0) ; 000: 61-bit signed int (n << 3 | 0)
(define GUEST_TAG_PAIR     1) ; 001: Pair / Cons cell (ptr | 1)
(define GUEST_TAG_SYMBOL   2) ; 010: Symbol / Interned string (ptr | 2)
(define GUEST_TAG_CLOSURE  3) ; 011: Guest Closure (ptr | 3)
(define GUEST_TAG_VECTOR   4) ; 100: Array / Vector (ptr | 4)
(define GUEST_TAG_INSTANCE 5) ; 101: Guest Object Instance (ptr | 5)
(define GUEST_TAG_FLONUM   6) ; 110: Heap Flonum (ptr | 6)
(define GUEST_TAG_SPECIAL  7) ; 111: Immediates (#f, #t, nil, undef)
(define GUEST_TAG_MASK     7) ; 3 bits mask: 0b111

;; Special immediate codes embedded in bits [5:3] with tag 7
(define GUEST_SPECIAL_FALSE 0) ; 0b000_111 = 7
(define GUEST_SPECIAL_TRUE  1) ; 0b001_111 = 15
(define GUEST_SPECIAL_NIL   2) ; 0b010_111 = 23
(define GUEST_SPECIAL_UNDEF 3) ; 0b011_111 = 31

;; Fixnum bounds for 61-bit signed integer (64 - 3 bits tag)
;; Max:  2^60 - 1 =  1152921504606846975
;; Min: -2^60     = -1152921504606846976
(define GUEST_FIXNUM_MAX  1152921504606846975)
(define GUEST_FIXNUM_MIN -1152921504606846976)

;;; -----------------------------------------------------------------------
;;; 2. Pure Scheme Helper Bitwise Wrappers & Error Handling
;;; -----------------------------------------------------------------------

(define (guest-tag-error! msg detail)
  (raise (list 'guest-tag-error msg detail)))

(define (%guest-bit-and a b)
  (if (and (number? a) (number? b))
      (bitwise-and a b)
      0))

(define (%guest-bit-ior a b)
  (if (and (number? a) (number? b))
      (bitwise-ior a b)
      0))

(define (%guest-bit-shift n bits)
  (if (number? n)
      (bitwise-arithmetic-shift n bits)
      0))

;;; -----------------------------------------------------------------------
;;; 3. Fixnum Packing & Unpacking (CWE-190 Defense)
;;; -----------------------------------------------------------------------

;;; Packs a signed integer into a 61-bit tagged fixnum.
;;; Raises an error on overflow to prevent silent tag corruption.
(define (guest-pack-fixnum n)
  (if (not (integer? n))
      (guest-tag-error! "guest-pack-fixnum: not an integer" n)
      (if (or (> n GUEST_FIXNUM_MAX) (< n GUEST_FIXNUM_MIN))
          (guest-tag-error! "guest-pack-fixnum: integer overflow for 61-bit representation" n)
          (%guest-bit-shift n 3))))

;;; Unpacks a 61-bit tagged fixnum into an integer.
;;; Arithmetic right shift preserves the sign bit.
(define (guest-unpack-fixnum v)
  (if (not (guest-fixnum? v))
      (guest-tag-error! "guest-unpack-fixnum: type assertion failure, not a tagged fixnum" v)
      (%guest-bit-shift v -3)))

;;; Tests whether value v has the Fixnum tag (000)
(define (guest-fixnum? v)
  (and (integer? v)
       (= (%guest-bit-and v GUEST_TAG_MASK) GUEST_TAG_FIXNUM)))

;;; -----------------------------------------------------------------------
;;; 4. Pointer Packing & Unpacking (CWE-843 Defense)
;;; -----------------------------------------------------------------------

;;; Packs an 8-byte aligned heap pointer with a 3-bit tag.
;;; Asserts that the lowest 3 bits of the raw pointer are zero.
(define (guest-pack-pointer ptr tag)
  (if (not (integer? ptr))
      (guest-tag-error! "guest-pack-pointer: invalid pointer address" ptr)
      (if (not (= (%guest-bit-and ptr GUEST_TAG_MASK) 0))
          (guest-tag-error! "guest-pack-pointer: unaligned pointer (lower 3 bits non-zero)" ptr)
          (%guest-bit-ior ptr (%guest-bit-and tag GUEST_TAG_MASK)))))

;;; Unpacks a pointer with a specific expected tag.
;;; Throws type assertion error if tag does not match (CWE-843 protection).
(define (guest-unpack-pointer v expected-tag)
  (if (not (guest-pointer-of-tag? v expected-tag))
      (guest-tag-error! "guest-unpack-pointer: type assertion failed" (list v expected-tag))
      (- v expected-tag)))

;;; Extracts the 3-bit tag from a tagged value
(define (guest-tag-of v)
  (if (integer? v)
      (%guest-bit-and v GUEST_TAG_MASK)
      #f))

;;; Checks if value v has the specified tag
(define (guest-pointer-of-tag? v tag)
  (and (integer? v)
       (= (%guest-bit-and v GUEST_TAG_MASK) tag)))

;; Type-specific predicates
(define (guest-pair? v)     (guest-pointer-of-tag? v GUEST_TAG_PAIR))
(define (guest-symbol? v)   (guest-pointer-of-tag? v GUEST_TAG_SYMBOL))
(define (guest-closure? v)  (guest-pointer-of-tag? v GUEST_TAG_CLOSURE))
(define (guest-vector? v)   (guest-pointer-of-tag? v GUEST_TAG_VECTOR))
(define (guest-instance? v) (guest-pointer-of-tag? v GUEST_TAG_INSTANCE))
(define (guest-flonum-ptr? v) (guest-pointer-of-tag? v GUEST_TAG_FLONUM))

;;; -----------------------------------------------------------------------
;;; 5. Special Immediates Packing & Unpacking
;;; -----------------------------------------------------------------------

;;; Packs an immediate code into a tagged special value
(define (guest-pack-special id)
  (%guest-bit-ior (%guest-bit-shift id 3) GUEST_TAG_SPECIAL))

;;; Unpacks an immediate code from a tagged special value
(define (guest-unpack-special v)
  (if (not (guest-special? v))
      (guest-tag-error! "guest-unpack-special: not a special immediate" v)
      (%guest-bit-shift v -3)))

;;; Predicate for special immediates
(define (guest-special? v)
  (and (integer? v)
       (= (%guest-bit-and v GUEST_TAG_MASK) GUEST_TAG_SPECIAL)))

(define (guest-false? v) (= v (guest-pack-special GUEST_SPECIAL_FALSE)))
(define (guest-true? v)  (= v (guest-pack-special GUEST_SPECIAL_TRUE)))
(define (guest-nil? v)   (= v (guest-pack-special GUEST_SPECIAL_NIL)))
(define (guest-undef? v) (= v (guest-pack-special GUEST_SPECIAL_UNDEF)))

;;; -----------------------------------------------------------------------
;;; 6. Type Assertion Guard (CWE-843 Runtime Attestation)
;;; -----------------------------------------------------------------------

(define (guest-tag-assert! v expected-tag msg)
  (if (not (= (%guest-bit-and v GUEST_TAG_MASK) expected-tag))
      (guest-tag-error! (string-append "guest-tag-assert: " msg) (list v expected-tag))
      #t))

;;; -----------------------------------------------------------------------
;;; 7. Residual Code / LIR Emitter Helpers (Compile-Time Lowering)
;;; -----------------------------------------------------------------------

;; Emits residual expression for tag check: (= (bitwise-and v 7) tag)
(define (guest-emit-tag-check v-expr tag)
  (list '= (list 'bitwise-and v-expr GUEST_TAG_MASK) tag))

;; Emits residual expression for untagging: (- v tag)
(define (guest-emit-untag v-expr tag)
  (if (= tag 0)
      v-expr
      (list '- v-expr tag)))

;; Emits residual expression for fixnum packing: (arithmetic-shift n 3)
(define (guest-emit-pack-fixnum n-expr)
  (list 'arithmetic-shift n-expr 3))

;; Emits residual expression for fixnum unpacking: (arithmetic-shift v -3)
(define (guest-emit-unpack-fixnum v-expr)
  (list 'arithmetic-shift v-expr -3))
;;; =======================================================================
;;; ULisp Language Workbench: Guest 64-bit Quiet NaN-Boxing Representation
;;; Conforms to DSN-33-04 §2.3, DSN-33-02 §5.1 & Issue #893
;;; =======================================================================
;;; Provides:
;;; - 64-bit IEEE-754 Quiet NaN-boxing for dynamic guest languages
;;; - Tag layout:
;;;     [63:48] = 0x7FF8 + Tag (16 bits)
;;;     [47:0]  = 48-bit Payload (pointer or 32-bit integer or immediate)
;;; - Tag classification:
;;;     Tag 0: Raw Flonum (IEEE-754 Double precision float)
;;;     Tag 1: 32-bit Integer (Fixnum)
;;;     Tag 2: Special Immediates (False, True, Nil, Undefined)
;;;     Tag 3: Heap Object Pointer (48-bit canonical pointer)
;;; - CWE-843 (Type Confusion), CWE-190 (Overflow), CWE-119 (OOB) defense
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. 64-bit NaN-Boxing Constants (DSN-33-04 §2.3)
;;; -----------------------------------------------------------------------

;; Quiet NaN base prefix: 0x7FF8000000000000
;; = (* 4095 2251799813685248) = 9221120237041090560
(define NAN_BOX_BASE 9221120237041090560)

;; 48-bit payload mask: 0x0000FFFFFFFFFFFF = 281474976710655
(define NAN_PAYLOAD_MASK 281474976710655)

;; 48-bit tag shift unit: 1 << 48 = 281474976710656
(define NAN_TAG_UNIT 281474976710656)

;; Tag IDs
(define NAN_TAG_FLONUM  0) ; Raw double / unboxed float
(define NAN_TAG_INT32   1) ; 32-bit signed int
(define NAN_TAG_SPECIAL 2) ; Immediates
(define NAN_TAG_POINTER 3) ; 48-bit heap pointer

;; Special Immediate Codes
(define NAN_SPECIAL_FALSE 0)
(define NAN_SPECIAL_TRUE  1)
(define NAN_SPECIAL_NIL   2)
(define NAN_SPECIAL_UNDEF 3)

;; 32-bit Integer Bounds
(define INT32_MIN -2147483648)
(define INT32_MAX  2147483647)
(define UINT32_MASK 4294967295) ; 0xFFFFFFFF

;;; -----------------------------------------------------------------------
;;; 2. Bitwise Helpers & Error Handling
;;; -----------------------------------------------------------------------

(define (nan-box-error! msg detail)
  (raise (list 'nan-box-error msg detail)))

(define (%nan-bit-and a b)
  (if (and (number? a) (number? b))
      (bitwise-and a b)
      0))

(define (%nan-bit-ior a b)
  (if (and (number? a) (number? b))
      (bitwise-ior a b)
      0))

;;; -----------------------------------------------------------------------
;;; 3. Tag Identification & Query
;;; -----------------------------------------------------------------------

;;; Returns #t if v is a NaN-boxed value (greater than or equal to NAN_BOX_BASE)
(define (nan-boxed? v)
  (and (integer? v)
       (>= v NAN_BOX_BASE)))

;;; Extracts the tag ID (0..3) from a NaN-boxed value.
;;; If v is a flonum or below NAN_BOX_BASE, returns 0 (NAN_TAG_FLONUM).
(define (nan-tag-of v)
  (if (not (nan-boxed? v))
      NAN_TAG_FLONUM
      (let* ((offset (- v NAN_BOX_BASE))
             (tag-idx (quotient offset NAN_TAG_UNIT)))
        tag-idx)))

;;; -----------------------------------------------------------------------
;;; 4. 32-bit Integer Packing & Unpacking (CWE-190 Defense)
;;; -----------------------------------------------------------------------

;;; Packs a 32-bit signed integer into a NaN-boxed word.
(define (nan-box-int32 n)
  (if (not (integer? n))
      (nan-box-error! "nan-box-int32: not an integer" n)
      (if (or (< n INT32_MIN) (> n INT32_MAX))
          (nan-box-error! "nan-box-int32: 32-bit integer overflow" n)
          (let ((u32 (if (< n 0) (+ n 4294967296) n)))
            (+ NAN_BOX_BASE (* NAN_TAG_INT32 NAN_TAG_UNIT) u32)))))

;;; Checks if v is a NaN-boxed 32-bit integer
(define (nan-is-int32? v)
  (and (nan-boxed? v)
       (= (nan-tag-of v) NAN_TAG_INT32)))

;;; Unpacks a NaN-boxed 32-bit integer.
;;; Converts unsigned 32-bit payload back to signed integer.
(define (nan-unbox-int32 v)
  (if (not (nan-is-int32? v))
      (nan-box-error! "nan-unbox-int32: type assertion failure, not a NaN-boxed int32" v)
      (let* ((payload (%nan-bit-and v UINT32_MASK)))
        (if (>= payload 2147483648)
            (- payload 4294967296)
            payload))))

;;; -----------------------------------------------------------------------
;;; 5. Heap Pointer Packing & Unpacking (CWE-843 & CWE-119 Defense)
;;; -----------------------------------------------------------------------

;;; Packs a 48-bit canonical pointer into a NaN-boxed word.
(define (nan-box-pointer ptr)
  (if (not (integer? ptr))
      (nan-box-error! "nan-box-pointer: invalid pointer" ptr)
      (if (or (< ptr 0) (> ptr NAN_PAYLOAD_MASK))
          (nan-box-error! "nan-box-pointer: non-canonical pointer exceeds 48 bits" ptr)
          (+ NAN_BOX_BASE (* NAN_TAG_POINTER NAN_TAG_UNIT) ptr))))

;;; Checks if v is a NaN-boxed heap pointer
(define (nan-is-pointer? v)
  (and (nan-boxed? v)
       (= (nan-tag-of v) NAN_TAG_POINTER)))

;;; Unpacks a 48-bit heap pointer
(define (nan-unbox-pointer v)
  (if (not (nan-is-pointer? v))
      (nan-box-error! "nan-unbox-pointer: type assertion failure, not a NaN-boxed pointer" v)
      (%nan-bit-and v NAN_PAYLOAD_MASK)))

;;; -----------------------------------------------------------------------
;;; 6. Special Immediates Packing & Unpacking
;;; -----------------------------------------------------------------------

;;; Packs a special immediate code into a NaN-boxed word
(define (nan-box-special id)
  (+ NAN_BOX_BASE (* NAN_TAG_SPECIAL NAN_TAG_UNIT) id))

;;; Checks if v is a NaN-boxed special immediate
(define (nan-is-special? v)
  (and (nan-boxed? v)
       (= (nan-tag-of v) NAN_TAG_SPECIAL)))

;;; Unpacks a special immediate code
(define (nan-unbox-special v)
  (if (not (nan-is-special? v))
      (nan-box-error! "nan-unbox-special: not a NaN-boxed special immediate" v)
      (%nan-bit-and v NAN_PAYLOAD_MASK)))

(define (nan-is-false? v) (= v (nan-box-special NAN_SPECIAL_FALSE)))
(define (nan-is-true? v)  (= v (nan-box-special NAN_SPECIAL_TRUE)))
(define (nan-is-nil? v)   (= v (nan-box-special NAN_SPECIAL_NIL)))
(define (nan-is-undef? v) (= v (nan-box-special NAN_SPECIAL_UNDEF)))

;;; -----------------------------------------------------------------------
;;; 7. Flonum (Double Float) Representation
;;; -----------------------------------------------------------------------

;;; Checks if v is treated as a double float.
;;; Any value not in the Quiet NaN-boxed payload space is a raw double float.
(define (nan-is-flonum? v)
  (or (real? v)
      (and (not (nan-boxed? v)))))

;;; Box a float: In pure Scheme / unboxed mode, a flonum is represented directly
(define (nan-box-flonum f)
  f)

;;; Unbox a float: Identity for unboxed IEEE-754 representation
(define (nan-unbox-flonum v)
  (if (nan-boxed? v)
      (nan-box-error! "nan-unbox-flonum: value is a boxed integer/pointer, not a float" v)
      v))

;;; -----------------------------------------------------------------------
;;; 8. Residual Code / LIR Emitter Helpers (Compile-Time Lowering)
;;; -----------------------------------------------------------------------

;; Emits residual expression for testing if v is int32:
;; (= (quotient (- v NAN_BOX_BASE) NAN_TAG_UNIT) NAN_TAG_INT32)
(define (nan-emit-is-int32 v-expr)
  (list 'nan-is-int32? v-expr))

;; Emits residual expression for unboxing int32:
(define (nan-emit-unbox-int32 v-expr)
  (list 'nan-unbox-int32 v-expr))

;; Emits residual expression for boxing int32:
(define (nan-emit-box-int32 n-expr)
  (list 'nan-box-int32 n-expr))

;; Emits residual expression for testing if v is a pointer:
(define (nan-emit-is-pointer v-expr)
  (list 'nan-is-pointer? v-expr))

;; Emits residual expression for unboxing pointer:
(define (nan-emit-unbox-pointer v-expr)
  (list 'nan-unbox-pointer v-expr))

;; Emits residual expression for boxing pointer:
(define (nan-emit-box-pointer ptr-expr)
  (list 'nan-box-pointer ptr-expr))
;;; =======================================================================
;;; Direct Cogen Engine: Second Futamura Projection for Language Workbench
;;; Conforms to DSN-33-04 §4.1 & DSN-33-03 §3, Issue #895 & #909
;;; Zero external dependencies. Pure Scheme.
;;; =======================================================================
;;; Provides:
;;; - LIR Instruction Representation (make-lir-*, lir-*)
;;; - Direct Cogen Compiler Derivation (derive-cogen-compiler, cogen-lower-ast)
;;; - Pure Scheme LIR Evaluator (lir-eval)
;;; - Standalone Compiler CLI Source Synthesis (synthesize-compiler-cli-source)
;;; - Unified Cogen Execution Engine (run-cogen-cli)
;;; - Security Path & Depth Validation (CWE-78, CWE-22, CWE-400)
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Security Threat Mitigations (CWE-78, CWE-22, CWE-400)
;;; -----------------------------------------------------------------------

(define *cogen-max-recursion-depth* 500)
(define *cogen-default-fuel* 100000)

;; CWE-78: Whitelist validation for path characters: only [a-zA-Z0-9_./-]
(define (cogen-safe-path-char? c)
  (or (and (char>=? c #\a) (char<=? c #\z))
      (and (char>=? c #\A) (char<=? c #\Z))
      (and (char>=? c #\0) (char<=? c #\9))
      (char=? c #\_)
      (char=? c #\-)
      (char=? c #\.)
      (char=? c #\/)))

(define (cogen-validate-path path)
  (if (not (string? path))
      (error "cogen-validate-path: path must be a string" 'invalid-path-type)
      (let ((len (string-length path)))
        (if (= len 0)
            (error "cogen-validate-path: empty path not allowed" 'empty-path)
            (let loop ((i 0))
              (if (= i len)
                  path
                  (let ((c (string-ref path i)))
                    (if (cogen-safe-path-char? c)
                        (loop (+ i 1))
                        (error "cogen-validate-path: unsafe character in path (CWE-78 mitigation)" 'unsafe-path-char)))))))))

;; CWE-22: Path traversal detection
(define (cogen-validate-output-path path)
  (let ((val (cogen-validate-path path)))
    (if (not (string? val))
        val
        (let ((len (string-length path)))
          (let loop ((i 0) (dot-count 0))
            (if (= i len)
                path
                (let ((c (string-ref path i)))
                  (cond
                    ((char=? c #\.)
                     (let ((new-dots (+ dot-count 1)))
                       (if (> new-dots 2)
                           (error "cogen-validate-output-path: suspicious path sequence (CWE-22 mitigation)" 'suspicious-path-sequence)
                           (loop (+ i 1) new-dots))))
                    ((char=? c #\/)
                     (if (> dot-count 2)
                         (error "cogen-validate-output-path: path traversal attempt (CWE-22 mitigation)" 'path-traversal-attempt)
                         (loop (+ i 1) 0)))
                    (else
                     (loop (+ i 1) 0))))))))))

;;; -----------------------------------------------------------------------
;;; 2. LIR Instruction Representation for Residual Code
;;; -----------------------------------------------------------------------

(define (make-lir-const val)
  (list 'LIR-CONST val))

(define (make-lir-slot-ref slot-idx name)
  (list 'LIR-SLOT-REF slot-idx name))

(define (make-lir-slot-set! slot-idx name expr)
  (list 'LIR-SLOT-SET! slot-idx name expr))

(define (make-lir-binop op lhs rhs)
  (list 'LIR-BINOP op lhs rhs))

(define (make-lir-unop op operand)
  (list 'LIR-UNOP op operand))

(define (make-lir-if cond-expr then-expr else-expr)
  (list 'LIR-IF cond-expr then-expr else-expr))

(define (make-lir-seq exprs)
  (list 'LIR-SEQ exprs))

(define (make-lir-call func-name args)
  (list 'LIR-CALL func-name args))

(define (make-lir-return expr)
  (list 'LIR-RETURN expr))

;; Predicates
(define (lir-node? node)
  (let ((n (if (ast-has-span? node) (ast-strip-span node) node)))
    (and (pair? n)
         (symbol? (car n))
         (memq (car n) '(LIR-CONST LIR-SLOT-REF LIR-SLOT-SET! LIR-BINOP
                           LIR-UNOP LIR-IF LIR-SEQ LIR-CALL LIR-RETURN)))))

;;; -----------------------------------------------------------------------
;;; Dual Source Span Integration (DSN-33-04 §5, Issue #896)
;;; -----------------------------------------------------------------------

(define (cogen-attach-dual-span expr guest-file g-line g-col interp-file i-line i-col)
  (let ((span (make-dual-source-span guest-file g-line g-col interp-file i-line i-col)))
    (ast-with-span expr span)))

(define (cogen-expr-span expr)
  (if (ast-has-span? expr)
      (ast-source-span expr)
      #f))

;;; -----------------------------------------------------------------------
;;; 3. Direct Cogen Specializer: Deriving Compiler from Interpreter Rules
;;; -----------------------------------------------------------------------

;; Compiles a guest AST node into LIR using interpreter semantic rules and GFD.
;; Includes recursion depth limit to mitigate CWE-400.
(define cogen-lower-ast
  (case-lambda
    ((node rules gfd runtime-model)
     (cogen-lower-ast node rules gfd runtime-model 0))
    ((node rules gfd runtime-model depth)
     (if (> depth *cogen-max-recursion-depth*)
         (error "cogen-lower-ast: recursion depth limit exceeded (CWE-400 mitigation)" 'depth-limit-exceeded)
         (if (ast-has-span? node)
             (let* ((span (ast-source-span node))
                    (inner (ast-strip-span node))
                    (res (cogen-lower-ast inner rules gfd runtime-model depth)))
               (if span
                   (ast-with-span res span)
                   res))
             (cond
               ((number? node)
                (make-lir-const node))
               ((boolean? node)
                (make-lir-const (if node 1 0)))
               ((string? node)
                (make-lir-const node))
               ((symbol? node)
               ;; Variable reference: resolve slot in frame descriptor
               (let ((slot-idx (gfd-lookup-slot gfd node)))
                 (if slot-idx
                     (make-lir-slot-ref slot-idx node)
                     ;; New slot allocated dynamically if not present
                     (let ((new-idx (gfd-add-slot! gfd node 'any)))
                       (make-lir-slot-ref new-idx node)))))
              ((pair? node)
               (let* ((tag (car node))
                      (handler (assoc tag rules)))
                 (if handler
                     ((cdr handler) node rules gfd runtime-model (+ depth 1))
                     (case tag
                       ;; Standard arithmetic & comparison operations
                       ((+ - * / % == != < <= > >=)
                        (let ((lhs (cogen-lower-ast (cadr node) rules gfd runtime-model (+ depth 1)))
                              (rhs (cogen-lower-ast (caddr node) rules gfd runtime-model (+ depth 1))))
                          (if (or (eq? lhs 'depth-limit-exceeded) (eq? rhs 'depth-limit-exceeded))
                              'depth-limit-exceeded
                              (make-lir-binop tag lhs rhs))))
                       ((AND and)
                        (let ((lhs (cogen-lower-ast (cadr node) rules gfd runtime-model (+ depth 1)))
                              (rhs (cogen-lower-ast (caddr node) rules gfd runtime-model (+ depth 1))))
                          (if (or (eq? lhs 'depth-limit-exceeded) (eq? rhs 'depth-limit-exceeded))
                              'depth-limit-exceeded
                              (make-lir-binop 'AND lhs rhs))))
                       ((OR or)
                        (let ((lhs (cogen-lower-ast (cadr node) rules gfd runtime-model (+ depth 1)))
                              (rhs (cogen-lower-ast (caddr node) rules gfd runtime-model (+ depth 1))))
                          (if (or (eq? lhs 'depth-limit-exceeded) (eq? rhs 'depth-limit-exceeded))
                              'depth-limit-exceeded
                              (make-lir-binop 'OR lhs rhs))))
                   ((not)
                    (let ((operand (cogen-lower-ast (cadr node) rules gfd runtime-model (+ depth 1))))
                      (if (eq? operand 'depth-limit-exceeded)
                          'depth-limit-exceeded
                          (make-lir-unop tag operand))))
                   ((if)
                    (let ((c (cogen-lower-ast (cadr node) rules gfd runtime-model (+ depth 1)))
                          (t (cogen-lower-ast (caddr node) rules gfd runtime-model (+ depth 1)))
                          (e (cogen-lower-ast (cadddr node) rules gfd runtime-model (+ depth 1))))
                      (if (or (eq? c 'depth-limit-exceeded) (eq? t 'depth-limit-exceeded) (eq? e 'depth-limit-exceeded))
                          'depth-limit-exceeded
                          (make-lir-if c t e))))
                   ((set! assign)
                    (let* ((var-name (cadr node))
                           (val-expr (cogen-lower-ast (caddr node) rules gfd runtime-model (+ depth 1)))
                           (slot-idx (gfd-add-slot! gfd var-name 'any)))
                      (if (eq? val-expr 'depth-limit-exceeded)
                          'depth-limit-exceeded
                          (make-lir-slot-set! slot-idx var-name val-expr))))
                   ((begin seq)
                    (let ((elts (map (lambda (e) (cogen-lower-ast e rules gfd runtime-model (+ depth 1)))
                                     (cdr node))))
                      (if (memq 'depth-limit-exceeded elts)
                          'depth-limit-exceeded
                          (make-lir-seq elts))))
                   (else
                    ;; Generic function call
                    (let ((compiled-args
                           (map (lambda (a) (cogen-lower-ast a rules gfd runtime-model (+ depth 1)))
                                (cdr node))))
                      (if (memq 'depth-limit-exceeded compiled-args)
                          'depth-limit-exceeded
                          (make-lir-call tag compiled-args))))))))
          (else
           (make-lir-const node))))))))

;;; Derives a compiler procedure from a declarative interpreter specification
(define derive-cogen-compiler
  (case-lambda
    ((interp-spec)
     (derive-cogen-compiler interp-spec 'tagging))
    ((interp-spec runtime-model)
     (lambda (ast-or-source gfd)
       (cogen-lower-ast ast-or-source interp-spec gfd runtime-model 0)))))

;;; -----------------------------------------------------------------------
;;; 4. LIR Evaluation & Verification Engine
;;; -----------------------------------------------------------------------

;; Pure Scheme reference interpreter for LIR trees (Ground Truth for Cogen)
(define (lir-eval lir frame)
  (let ((n (if (ast-has-span? lir) (ast-strip-span lir) lir)))
    (case (car n)
      ((LIR-CONST)
       (cadr n))
      ((LIR-SLOT-REF)
       (let ((idx (cadr n)))
         (vector-ref frame idx)))
      ((LIR-SLOT-SET!)
       (let* ((idx (cadr n))
              (val (lir-eval (cadddr n) frame)))
         (vector-set! frame idx val)
         val))
      ((LIR-BINOP)
       (let ((op (cadr n))
             (lhs (lir-eval (caddr n) frame))
             (rhs (lir-eval (cadddr n) frame)))
         (case op
           ((+) (+ lhs rhs))
           ((-) (- lhs rhs))
           ((*) (* lhs rhs))
           ((/) (quotient lhs rhs))
           ((%) (modulo lhs rhs))
           ((==) (if (and (number? lhs) (number? rhs)) (= lhs rhs) (equal? lhs rhs)))
           ((!=) (if (and (number? lhs) (number? rhs)) (not (= lhs rhs)) (not (equal? lhs rhs))))
           ((<) (< lhs rhs))
           ((<=) (<= lhs rhs))
           ((>) (> lhs rhs))
           ((>=) (>= lhs rhs))
           ((AND and) (if (and (and lhs (not (eq? lhs 0)))
                               (and rhs (not (eq? rhs 0))))
                          1 0))
           ((OR or) (if (or (and lhs (not (eq? lhs 0)))
                            (and rhs (not (eq? rhs 0))))
                        1 0))
           (else (error "Unsupported LIR binop" op)))))
      ((LIR-UNOP)
       (let ((op (cadr n))
             (val (lir-eval (caddr n) frame)))
         (case op
           ((not) (if val #f #t))
           ((-) (- val))
           (else (error "Unsupported LIR unop" op)))))
      ((LIR-IF)
       (let ((cond-val (lir-eval (cadr n) frame)))
         (if (and cond-val (not (eq? cond-val 0)))
             (lir-eval (caddr n) frame)
             (lir-eval (cadddr n) frame))))
      ((LIR-SEQ)
       (let loop ((elts (cadr n)) (last-val #f))
         (if (null? elts)
             last-val
             (loop (cdr elts) (lir-eval (car elts) frame)))))
      ((LIR-RETURN)
       (lir-eval (cadr n) frame))
      (else
       (error "Unknown LIR node in lir-eval" n)))))

