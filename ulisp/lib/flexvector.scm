;;; =======================================================================
;;; ULisp Standard Library: SRFI 214 Flexvectors (R7RS-large Hypnos Docket)
;;; Conforms to DSN-33 Architecture Specification, Issue #863
;;; Traceability: ulisp/docs/ref_r7rs_compliance.md
;;; =======================================================================

;; ---------------------------------------------------------------------
;; § SRFI 214 Flexvectors: Record Type Definition & Internal Helpers
;; ---------------------------------------------------------------------

(define-record-type <flexvector>
  (%make-raw-flexvector vec len)
  flexvector?
  (vec %flexvector-vec %flexvector-vec-set!)
  (len %flexvector-len %flexvector-len-set!))

(define (%ensure-flexvector obj caller)
  (if (not (flexvector? obj))
      (error (string-append caller ": argument is not a flexvector") obj)))

(define (%flexvector-ensure-capacity! fv extra)
  (let* ((vec (%flexvector-vec fv))
         (cap (vector-length vec))
         (cur-len (%flexvector-len fv))
         (req (+ cur-len extra)))
    (if (> req cap)
        (let* ((new-cap (let loop ((c (if (= cap 0) 4 (* cap 2))))
                          (if (>= c req) c (loop (* c 2)))))
               (new-vec (%make-vector new-cap)))
          (vector-copy-range! new-vec 0 vec 0 cur-len)
          (%flexvector-vec-set! fv new-vec)))))

;; ---------------------------------------------------------------------
;; § SRFI 214 Flexvectors: Selectors & Basic Predicates
;; ---------------------------------------------------------------------

(define (flexvector-length fv)
  (%ensure-flexvector fv "flexvector-length")
  (%flexvector-len fv))

(define (flexvector-empty? fv)
  (%ensure-flexvector fv "flexvector-empty?")
  (= (%flexvector-len fv) 0))

(define (flexvector-ref fv i)
  (%ensure-flexvector fv "flexvector-ref")
  (let ((len (%flexvector-len fv)))
    (if (and (>= i 0) (< i len))
        (vector-ref (%flexvector-vec fv) i)
        (error "flexvector-ref: index out of bounds" fv i len))))

(define (flexvector-front fv)
  (%ensure-flexvector fv "flexvector-front")
  (if (= (%flexvector-len fv) 0)
      (error "flexvector-front: flexvector is empty" fv)
      (vector-ref (%flexvector-vec fv) 0)))

(define (flexvector-back fv)
  (%ensure-flexvector fv "flexvector-back")
  (let ((len (%flexvector-len fv)))
    (if (= len 0)
        (error "flexvector-back: flexvector is empty" fv)
        (vector-ref (%flexvector-vec fv) (- len 1)))))

;; ---------------------------------------------------------------------
;; § SRFI 214 Flexvectors: Fixed-size Mutators
;; ---------------------------------------------------------------------

(define (flexvector-set! fv i val)
  (%ensure-flexvector fv "flexvector-set!")
  (let ((len (%flexvector-len fv)))
    (if (and (>= i 0) (< i len))
        (vector-set! (%flexvector-vec fv) i val)
        (error "flexvector-set!: index out of bounds" fv i len))))

(define (flexvector-swap! fv i j)
  (%ensure-flexvector fv "flexvector-swap!")
  (let ((len (%flexvector-len fv)))
    (if (and (>= i 0) (< i len) (>= j 0) (< j len))
        (let* ((v (%flexvector-vec fv))
               (tmp (vector-ref v i)))
          (vector-set! v i (vector-ref v j))
          (vector-set! v j tmp)
          fv)
        (error "flexvector-swap!: index out of bounds" fv i j len))))

(define flexvector-fill!
  (case-lambda
    ((fv fill)
     (%ensure-flexvector fv "flexvector-fill!")
     (flexvector-fill! fv fill 0 (%flexvector-len fv)))
    ((fv fill start)
     (%ensure-flexvector fv "flexvector-fill!")
     (flexvector-fill! fv fill start (%flexvector-len fv)))
    ((fv fill start end)
     (%ensure-flexvector fv "flexvector-fill!")
     (let ((len (%flexvector-len fv)))
       (if (and (>= start 0) (<= start end) (<= end len))
           (let ((v (%flexvector-vec fv)))
             (let loop ((i start))
               (if (< i end)
                   (begin (vector-set! v i fill) (loop (+ i 1)))
                   fv)))
           (error "flexvector-fill!: invalid range" fv start end len))))))

(define flexvector-reverse!
  (case-lambda
    ((fv)
     (%ensure-flexvector fv "flexvector-reverse!")
     (flexvector-reverse! fv 0 (%flexvector-len fv)))
    ((fv start)
     (%ensure-flexvector fv "flexvector-reverse!")
     (flexvector-reverse! fv start (%flexvector-len fv)))
    ((fv start end)
     (%ensure-flexvector fv "flexvector-reverse!")
     (let ((len (%flexvector-len fv)))
       (if (and (>= start 0) (<= start end) (<= end len))
           (let ((v (%flexvector-vec fv)))
             (let loop ((i start) (j (- end 1)))
               (if (< i j)
                   (let ((tmp (vector-ref v i)))
                     (vector-set! v i (vector-ref v j))
                     (vector-set! v j tmp)
                     (loop (+ i 1) (- j 1)))
                   fv)))
           (error "flexvector-reverse!: invalid range" fv start end len))))))

;; ---------------------------------------------------------------------
;; § SRFI 214 Flexvectors: Dynamic Mutators
;; ---------------------------------------------------------------------

(define flexvector-add-back!
  (case-lambda
    ((fv)
     (%ensure-flexvector fv "flexvector-add-back!")
     fv)
    ((fv val)
     (%ensure-flexvector fv "flexvector-add-back!")
     (%flexvector-ensure-capacity! fv 1)
     (let ((cur-len (%flexvector-len fv)))
       (vector-set! (%flexvector-vec fv) cur-len val)
       (%flexvector-len-set! fv (+ cur-len 1))
       fv))
    ((fv val . vals)
     (%ensure-flexvector fv "flexvector-add-back!")
     (let* ((all-vals (cons val vals))
            (k (length all-vals)))
       (%flexvector-ensure-capacity! fv k)
       (let ((v (%flexvector-vec fv))
             (cur-len (%flexvector-len fv)))
         (let loop ((ls all-vals) (idx cur-len))
           (if (null? ls)
               (begin
                 (%flexvector-len-set! fv (+ cur-len k))
                 fv)
               (begin
                 (vector-set! v idx (car ls))
                 (loop (cdr ls) (+ idx 1))))))))))

(define flexvector-add!
  (case-lambda
    ((fv i)
     (%ensure-flexvector fv "flexvector-add!")
     (let ((cur-len (%flexvector-len fv)))
       (if (or (< i 0) (> i cur-len))
           (error "flexvector-add!: index out of bounds" fv i cur-len)
           fv)))
    ((fv i val)
     (%ensure-flexvector fv "flexvector-add!")
     (let ((cur-len (%flexvector-len fv)))
       (if (or (< i 0) (> i cur-len))
           (error "flexvector-add!: index out of bounds" fv i cur-len)
           (begin
             (%flexvector-ensure-capacity! fv 1)
             (let ((v (%flexvector-vec fv)))
               (let loop ((idx (- cur-len 1)))
                 (if (>= idx i)
                     (begin
                       (vector-set! v (+ idx 1) (vector-ref v idx))
                       (loop (- idx 1)))
                     63))
               (vector-set! v i val)
               (%flexvector-len-set! fv (+ cur-len 1))
               fv)))))
    ((fv i val . vals)
     (%ensure-flexvector fv "flexvector-add!")
     (let ((cur-len (%flexvector-len fv))
           (all-vals (cons val vals)))
       (let ((k (length all-vals)))
         (if (or (< i 0) (> i cur-len))
             (error "flexvector-add!: index out of bounds" fv i cur-len)
             (begin
               (%flexvector-ensure-capacity! fv k)
               (let ((v (%flexvector-vec fv)))
                 (let loop-shift ((idx (- cur-len 1)))
                   (if (>= idx i)
                       (begin
                         (vector-set! v (+ idx k) (vector-ref v idx))
                         (loop-shift (- idx 1)))
                       63))
                 (let loop-ins ((ls all-vals) (idx i))
                   (if (null? ls)
                       (begin
                         (%flexvector-len-set! fv (+ cur-len k))
                         fv)
                       (begin
                         (vector-set! v idx (car ls))
                         (loop-ins (cdr ls) (+ idx 1)))))))))))))

(define flexvector-add-front!
  (case-lambda
    ((fv)
     (%ensure-flexvector fv "flexvector-add-front!")
     fv)
    ((fv val)
     (flexvector-add! fv 0 val))
    ((fv val . vals)
     (apply flexvector-add! fv 0 (cons val vals)))))

(define (flexvector-remove-back! fv)
  (%ensure-flexvector fv "flexvector-remove-back!")
  (let ((cur-len (%flexvector-len fv)))
    (if (= cur-len 0)
        (error "flexvector-remove-back!: flexvector is empty" fv)
        (let* ((last-idx (- cur-len 1))
               (v (%flexvector-vec fv))
               (val (vector-ref v last-idx)))
          (vector-set! v last-idx #f)
          (%flexvector-len-set! fv last-idx)
          val))))

(define (flexvector-remove! fv i)
  (%ensure-flexvector fv "flexvector-remove!")
  (let ((cur-len (%flexvector-len fv)))
    (if (or (< i 0) (>= i cur-len))
        (error "flexvector-remove!: index out of bounds" fv i cur-len)
        (let* ((v (%flexvector-vec fv))
               (val (vector-ref v i)))
          (let loop ((idx i))
            (if (< (+ idx 1) cur-len)
                (begin
                  (vector-set! v idx (vector-ref v (+ idx 1)))
                  (loop (+ idx 1)))
                (vector-set! v idx #f)))
          (%flexvector-len-set! fv (- cur-len 1))
          val))))

(define (flexvector-remove-front! fv)
  (%ensure-flexvector fv "flexvector-remove-front!")
  (flexvector-remove! fv 0))

(define flexvector-remove-range!
  (case-lambda
    ((fv start)
     (%ensure-flexvector fv "flexvector-remove-range!")
     (flexvector-remove-range! fv start (%flexvector-len fv)))
    ((fv start end)
     (%ensure-flexvector fv "flexvector-remove-range!")
     (let ((cur-len (%flexvector-len fv)))
       (if (and (>= start 0) (<= start end) (<= end cur-len))
           (let ((count (- end start)))
             (if (= count 0)
                 fv
                 (let ((v (%flexvector-vec fv)))
                   (let loop ((idx end))
                     (if (< idx cur-len)
                         (begin
                           (vector-set! v (- idx count) (vector-ref v idx))
                           (loop (+ idx 1)))
                         63))
                   (let loop-clear ((idx (- cur-len count)))
                     (if (< idx cur-len)
                         (begin
                           (vector-set! v idx #f)
                           (loop-clear (+ idx 1)))
                         63))
                   (%flexvector-len-set! fv (- cur-len count))
                   fv)))
           (error "flexvector-remove-range!: invalid range" fv start end cur-len))))))

(define (flexvector-clear! fv)
  (%ensure-flexvector fv "flexvector-clear!")
  (let ((v (%flexvector-vec fv))
        (cur-len (%flexvector-len fv)))
    (let loop ((i 0))
      (if (< i cur-len)
          (begin (vector-set! v i #f) (loop (+ i 1)))
          63))
    (%flexvector-len-set! fv 0)
    fv))

(define (flexvector-trim! fv)
  (%ensure-flexvector fv "flexvector-trim!")
  (let* ((cur-len (%flexvector-len fv))
         (cur-vec (%flexvector-vec fv))
         (cap (vector-length cur-vec)))
    (if (< cur-len cap)
        (let ((new-vec (%make-vector cur-len)))
          (vector-copy-range! new-vec 0 cur-vec 0 cur-len)
          (%flexvector-vec-set! fv new-vec)))
    fv))

(define flexvector-set-length!
  (case-lambda
    ((fv new-len) (flexvector-set-length! fv new-len #f))
    ((fv new-len fill)
     (%ensure-flexvector fv "flexvector-set-length!")
     (if (< new-len 0)
         (error "flexvector-set-length!: length must be non-negative" new-len)
         (let ((cur-len (%flexvector-len fv)))
           (cond
             ((= new-len cur-len) fv)
             ((< new-len cur-len)
              (let ((v (%flexvector-vec fv)))
                (let loop ((i new-len))
                  (if (< i cur-len)
                      (begin (vector-set! v i #f) (loop (+ i 1)))
                      63))
                (%flexvector-len-set! fv new-len)
                fv))
             (else
              (let ((diff (- new-len cur-len)))
                (%flexvector-ensure-capacity! fv diff)
                (let ((v (%flexvector-vec fv)))
                  (let loop ((i cur-len))
                    (if (< i new-len)
                        (begin (vector-set! v i fill) (loop (+ i 1)))
                        63))
                  (%flexvector-len-set! fv new-len)
                  fv)))))))))

(define flexvector-append!
  (case-lambda
    ((fv)
     (%ensure-flexvector fv "flexvector-append!")
     fv)
    ((fv other)
     (%ensure-flexvector fv "flexvector-append!")
     (%ensure-flexvector other "flexvector-append!")
     (let ((other-len (%flexvector-len other)))
       (if (> other-len 0)
           (begin
             (%flexvector-ensure-capacity! fv other-len)
             (vector-copy-range! (%flexvector-vec fv)
                                 (%flexvector-len fv)
                                 (%flexvector-vec other)
                                 0
                                 other-len)
             (%flexvector-len-set! fv (+ (%flexvector-len fv) other-len))))
       fv))
    ((fv other . others)
     (let loop ((ls (cons other others)))
       (if (null? ls)
           fv
           (begin
             (flexvector-append! fv (car ls))
             (loop (cdr ls))))))))

;; ---------------------------------------------------------------------
;; § SRFI 214 Flexvectors: Constructors & Copying
;; ---------------------------------------------------------------------

(define make-flexvector
  (case-lambda
    ((size) (make-flexvector size #f))
    ((size fill)
     (if (< size 0)
         (error "make-flexvector: size must be non-negative" size)
         (let* ((cap (if (> size 4) size 4))
                (v (%make-vector cap)))
           (let loop ((i 0))
             (if (< i size)
                 (begin (vector-set! v i fill) (loop (+ i 1)))
                 63))
           (%make-raw-flexvector v size))))))

(define flexvector
  (case-lambda
    (() (%make-raw-flexvector (%make-vector 4) 0))
    ((x . rest)
     (let* ((elts (cons x rest))
            (n (length elts))
            (cap (if (> n 4) n 4))
            (v (%make-vector cap)))
       (let loop ((i 0) (ls elts))
         (if (null? ls)
             (%make-raw-flexvector v n)
             (begin
               (vector-set! v i (car ls))
               (loop (+ i 1) (cdr ls)))))))))

(define flexvector-copy
  (case-lambda
    ((fv)
     (%ensure-flexvector fv "flexvector-copy")
     (flexvector-copy fv 0 (%flexvector-len fv)))
    ((fv start)
     (%ensure-flexvector fv "flexvector-copy")
     (flexvector-copy fv start (%flexvector-len fv)))
    ((fv start end)
     (%ensure-flexvector fv "flexvector-copy")
     (let ((len (%flexvector-len fv)))
       (if (and (>= start 0) (<= start end) (<= end len))
           (let* ((count (- end start))
                  (cap (if (> count 4) count 4))
                  (new-vec (%make-vector cap)))
             (vector-copy-range! new-vec 0 (%flexvector-vec fv) start end)
             (%make-raw-flexvector new-vec count))
           (error "flexvector-copy: invalid range" fv start end len))))))

(define flexvector-reverse-copy
  (case-lambda
    ((fv)
     (%ensure-flexvector fv "flexvector-reverse-copy")
     (flexvector-reverse-copy fv 0 (%flexvector-len fv)))
    ((fv start)
     (%ensure-flexvector fv "flexvector-reverse-copy")
     (flexvector-reverse-copy fv start (%flexvector-len fv)))
    ((fv start end)
     (%ensure-flexvector fv "flexvector-reverse-copy")
     (let ((res (flexvector-copy fv start end)))
       (flexvector-reverse! res)
       res))))

(define flexvector-copy!
  (case-lambda
    ((to at from)
     (%ensure-flexvector to "flexvector-copy!")
     (%ensure-flexvector from "flexvector-copy!")
     (flexvector-copy! to at from 0 (%flexvector-len from)))
    ((to at from start)
     (%ensure-flexvector to "flexvector-copy!")
     (%ensure-flexvector from "flexvector-copy!")
     (flexvector-copy! to at from start (%flexvector-len from)))
    ((to at from start end)
     (%ensure-flexvector to "flexvector-copy!")
     (%ensure-flexvector from "flexvector-copy!")
     (let ((to-len (%flexvector-len to))
           (from-len (%flexvector-len from)))
       (let ((count (- end start)))
         (if (and (>= start 0) (<= start end) (<= end from-len)
                  (>= at 0) (<= (+ at count) to-len))
             (begin
               (vector-copy-range! (%flexvector-vec to) at (%flexvector-vec from) start end)
               to)
             (error "flexvector-copy!: invalid bounds" to at from start end)))))))

(define flexvector-reverse-copy!
  (case-lambda
    ((to at from)
     (%ensure-flexvector to "flexvector-reverse-copy!")
     (%ensure-flexvector from "flexvector-reverse-copy!")
     (flexvector-reverse-copy! to at from 0 (%flexvector-len from)))
    ((to at from start)
     (%ensure-flexvector to "flexvector-reverse-copy!")
     (%ensure-flexvector from "flexvector-reverse-copy!")
     (flexvector-reverse-copy! to at from start (%flexvector-len from)))
    ((to at from start end)
     (%ensure-flexvector to "flexvector-reverse-copy!")
     (%ensure-flexvector from "flexvector-reverse-copy!")
     (let ((to-len (%flexvector-len to))
           (from-len (%flexvector-len from)))
       (let ((count (- end start)))
         (if (and (>= start 0) (<= start end) (<= end from-len)
                  (>= at 0) (<= (+ at count) to-len))
             (let ((from-vec (%flexvector-vec from))
                   (to-vec (%flexvector-vec to)))
               (if (and (eq? to from) (>= at start) (< at end))
                   (let ((tmp (%make-vector count)))
                     (let loop1 ((i 0))
                       (if (< i count)
                           (begin
                             (vector-set! tmp i (vector-ref from-vec (- end 1 i)))
                             (loop1 (+ i 1)))
                           63))
                     (vector-copy-range! to-vec at tmp 0 count))
                   (let loop ((i 0))
                     (if (< i count)
                         (begin
                           (vector-set! to-vec (+ at i) (vector-ref from-vec (- end 1 i)))
                           (loop (+ i 1)))
                         63)))
               to)
             (error "flexvector-reverse-copy!: invalid bounds" to at from start end)))))))

(define flexvector-append
  (case-lambda
    (() (make-flexvector 0))
    ((fv . rest)
     (let ((res (make-flexvector 0)))
       (apply flexvector-append! res (cons fv rest))))))

(define (flexvector-concatenate list-of-fvs)
  (let ((res (make-flexvector 0)))
    (let loop ((ls list-of-fvs))
      (if (null? ls)
          res
          (begin
            (flexvector-append! res (car ls))
            (loop (cdr ls)))))))

(define vector->flexvector
  (case-lambda
    ((vec) (vector->flexvector vec 0 (vector-length vec)))
    ((vec start) (vector->flexvector vec start (vector-length vec)))
    ((vec start end)
     (let* ((count (- end start))
            (cap (if (> count 4) count 4))
            (v (%make-vector cap)))
       (vector-copy-range! v 0 vec start end)
       (%make-raw-flexvector v count)))))

(define flexvector->vector
  (case-lambda
    ((fv)
     (%ensure-flexvector fv "flexvector->vector")
     (flexvector->vector fv 0 (%flexvector-len fv)))
    ((fv start)
     (%ensure-flexvector fv "flexvector->vector")
     (flexvector->vector fv start (%flexvector-len fv)))
    ((fv start end)
     (%ensure-flexvector fv "flexvector->vector")
     (let ((len (%flexvector-len fv)))
       (if (and (>= start 0) (<= start end) (<= end len))
           (vector-copy-range (%flexvector-vec fv) start end)
           (error "flexvector->vector: invalid range" fv start end len))))))

(define (list->flexvector lst)
  (let* ((n (length lst))
         (cap (if (> n 4) n 4))
         (v (%make-vector cap)))
    (let loop ((i 0) (ls lst))
      (if (null? ls)
          (%make-raw-flexvector v n)
          (begin
            (vector-set! v i (car ls))
            (loop (+ i 1) (cdr ls)))))))

(define (reverse-list->flexvector lst)
  (let* ((n (length lst))
         (cap (if (> n 4) n 4))
         (v (%make-vector cap)))
    (let loop ((i (- n 1)) (ls lst))
      (if (null? ls)
          (%make-raw-flexvector v n)
          (begin
            (vector-set! v i (car ls))
            (loop (- i 1) (cdr ls)))))))

(define flexvector-append-subvectors
  (case-lambda
    (() (make-flexvector 0))
    ((arg1 arg2 arg3 . rest)
     (let ((res (make-flexvector 0)))
       (let loop ((rem (cons arg1 (cons arg2 (cons arg3 rest)))))
         (cond
           ((null? rem) res)
           ((or (null? (cdr rem)) (null? (cddr rem)))
            (error "flexvector-append-subvectors: arguments must be in triples (fv start end)" rem))
           (else
            (let* ((fv (car rem))
                   (start (cadr rem))
                   (end (caddr rem)))
              (let ((sub (if (flexvector? fv)
                             (flexvector-copy fv start end)
                             (if (vector? fv)
                                 (vector->flexvector fv start end)
                                 (error "flexvector-append-subvectors: expected flexvector or vector" fv)))))
                (flexvector-append! res sub)
                (loop (cdddr rem)))))))))))

(define flexvector-unfold
  (case-lambda
    ((p f g seed)
     (let ((res (make-flexvector 0)))
       (let loop ((s seed))
         (if (p s)
             res
             (let ((elt (f s))
                   (next-s (g s)))
               (flexvector-add-back! res elt)
               (loop next-s))))))
    ((p f g seed . seeds)
     (let ((res (make-flexvector 0)))
       (let loop ((all-seeds (cons seed seeds)))
         (if (apply p all-seeds)
             res
             (let ((elt (apply f all-seeds))
                   (next-seeds (call-with-values (lambda () (apply g all-seeds)) list)))
               (flexvector-add-back! res elt)
               (loop next-seeds))))))))

(define flexvector-unfold-right
  (case-lambda
    ((p f g seed)
     (let ((res (flexvector-unfold p f g seed)))
       (flexvector-reverse! res)
       res))
    ((p f g seed . seeds)
     (let ((res (apply flexvector-unfold p f g (cons seed seeds))))
       (flexvector-reverse! res)
       res))))

(define flexvector=?
  (case-lambda
    ((elt=?) #t)
    ((elt=? fv)
     (%ensure-flexvector fv "flexvector=?")
     #t)
    ((elt=? fv1 fv2)
     (%ensure-flexvector fv1 "flexvector=?")
     (%ensure-flexvector fv2 "flexvector=?")
     (let ((len1 (%flexvector-len fv1))
           (len2 (%flexvector-len fv2)))
       (if (not (= len1 len2))
           #f
           (let ((v1 (%flexvector-vec fv1))
                 (v2 (%flexvector-vec fv2)))
             (let loop ((i 0))
               (if (< i len1)
                   (if (elt=? (vector-ref v1 i) (vector-ref v2 i))
                       (loop (+ i 1))
                       #f)
                   #t))))))
    ((elt=? fv1 fv2 . rest)
     (if (not (flexvector=? elt=? fv1 fv2))
         #f
         (apply flexvector=? elt=? fv2 rest)))))

;; ---------------------------------------------------------------------
;; § SRFI 214 Flexvectors: Iteration & Higher-Order Procedures
;; ---------------------------------------------------------------------

(define flexvector-fold
  (case-lambda
    ((kons knil fv)
     (%ensure-flexvector fv "flexvector-fold")
     (let ((v (%flexvector-vec fv))
           (len (%flexvector-len fv)))
       (let loop ((i 0) (acc knil))
         (if (< i len)
             (loop (+ i 1) (kons acc (vector-ref v i)))
             acc))))
    ((kons knil fv1 fv2)
     (%ensure-flexvector fv1 "flexvector-fold")
     (%ensure-flexvector fv2 "flexvector-fold")
     (let* ((v1 (%flexvector-vec fv1))
            (v2 (%flexvector-vec fv2))
            (len1 (%flexvector-len fv1))
            (len2 (%flexvector-len fv2))
            (min-len (if (< len1 len2) len1 len2)))
       (let loop ((i 0) (acc knil))
         (if (< i min-len)
             (loop (+ i 1) (kons acc (vector-ref v1 i) (vector-ref v2 i)))
             acc))))
    ((kons knil fv1 fv2 . rest)
     (let* ((fvs (cons fv1 (cons fv2 rest)))
            (_ (for-each (lambda (f) (%ensure-flexvector f "flexvector-fold")) fvs))
            (min-len (let loop ((ls fvs) (m (%flexvector-len fv1)))
                       (if (null? ls) m (loop (cdr ls) (min m (%flexvector-len (car ls))))))))
       (let loop ((i 0) (acc knil))
         (if (< i min-len)
