(define (%sym-assoc-string sym alist)
  (cond
    ((null? alist) #f)
    ((not (pair? alist)) #f)
    ((and (pair? (car alist)) (eq? (car (car alist)) sym))
     (cdr (car alist)))
    (else (%sym-assoc-string sym (cdr alist)))))

(define (%symbol-find-string sym entries)
  (let loop ((es entries))
    (if (or (null? es) (not (pair? es)))
        #f
        (let ((entry (car es)))
          (if (and (pair? entry) (eq? (cdr entry) sym))
              (car entry)
              (loop (cdr es)))))))

(define (symbol->string sym)
  (let* ((h (symbol->integer sym))
         (pos-h (if (< h 0) (- 0 h) h))
         (c-idx (bitwise-and pos-h 4095))
         (cached-sym (vector-ref *sym-cache-sym* c-idx)))
    (if (and cached-sym (eq? cached-sym sym))
        (vector-ref *sym-cache-str* c-idx)
        (let* ((known (%sym-assoc-string sym *known-runtime-symbols*))
               (res (if known
                        known
                        (let* ((b-idx (bitwise-and pos-h 16383))
                               (bucket (vector-ref *symbol-sym-buckets* b-idx))
                               (found (%symbol-find-string sym bucket)))
                          (if found
                              found
                              "?")))))
          (vector-set! *sym-cache-sym* c-idx sym)
          (vector-set! *sym-cache-str* c-idx res)
          res))))

(define (string-copy-range str start end)
  (substring str start end))

(define (string-copy-range! to at from start end)
  (let ((count (- end start)))
    (if (and (eq? to from) (> at start))
        ;; Backward copy to handle overlapping regions
        (let loop ((i (- count 1)))
          (if (>= i 0)
              (begin
                (string-set! to (+ at i) (string-ref from (+ start i)))
                (loop (- i 1)))
              63))
        ;; Forward copy
        (let loop ((i 0))
          (if (< i count)
              (begin
                (string-set! to (+ at i) (string-ref from (+ start i)))
                (loop (+ i 1)))
              63)))))

(define (string-fill-range! str fill start end)
  (let loop ((i start))
    (if (< i end)
        (begin
          (string-set! str i fill)
          (loop (+ i 1)))
        63)))

(define (string-map proc str)
  (let* ((len (string-length str))
         (res (make-string len)))
    (let loop ((i 0))
      (if (< i len)
          (begin
            (string-set! res i (proc (string-ref str i)))
            (loop (+ i 1)))
          res))))

(define (string-for-each proc str)
  (let ((len (string-length str)))
    (let loop ((i 0))
      (if (< i len)
          (begin
            (proc (string-ref str i))
            (loop (+ i 1)))
          63))))

(define (string-copy str)
  (string-copy-range str 0 (string-length str)))

(define (string-fill! str fill)
  (string-fill-range! str fill 0 (string-length str)))

;; ---------------------------------------------------------------------
;; §6.7 Strings: string->list-range / list->string
;; ---------------------------------------------------------------------
(define (string->list-range str start end)
  (let loop ((i (- end 1)) (acc '()))
    (if (< i start)
        acc
        (loop (- i 1) (cons (string-ref str i) acc)))))

(define (list->string lst)
  (let* ((len (length lst))
         (s (make-string len)))
    (let loop ((curr lst) (i 0))
      (if (null? curr)
          s
          (begin
            (string-set! s i (car curr))
            (loop (cdr curr) (+ i 1)))))))

(define string
  (case-lambda
    (() "")
    (chars (list->string chars))))

;; ---------------------------------------------------------------------
;; §6.7 Strings: Lexicographic Comparison (string<?, string>?, string<=?, string>=?)
;; ---------------------------------------------------------------------
(define (%string-compare s1 s2)
  (let ((len1 (string-length s1))
        (len2 (string-length s2)))
    (let ((min-len (if (< len1 len2) len1 len2)))
      (let loop ((i 0))
        (if (< i min-len)
            (let ((n1 (char->integer (string-ref s1 i)))
                  (n2 (char->integer (string-ref s2 i))))
              (cond
                ((< n1 n2) -1)
                ((> n1 n2) 1)
                (else (loop (+ i 1)))))
            (cond
              ((< len1 len2) -1)
              ((> len1 len2) 1)
              (else 0)))))))

(define (string<? s1 s2)
  (< (%string-compare s1 s2) 0))

(define (string>? s1 s2)
  (> (%string-compare s1 s2) 0))

(define (string<=? s1 s2)
  (<= (%string-compare s1 s2) 0))

(define (string>=? s1 s2)
  (>= (%string-compare s1 s2) 0))

;; ---------------------------------------------------------------------
;; §6.7 & §7.1.3 (scheme char): String Case Conversions & Case Folding
;; ---------------------------------------------------------------------
(define (string-upcase str)
  (string-map char-upcase str))

(define (string-downcase str)
  (string-map char-downcase str))

(define (string-foldcase str)
  (string-map char-foldcase str))

;; ---------------------------------------------------------------------
;; §6.7 & §7.1.3 (scheme char): Case-Insensitive String Comparisons
;; ---------------------------------------------------------------------
(define (%string-ci-compare s1 s2)
  (let ((len1 (string-length s1))
        (len2 (string-length s2)))
    (let ((min-len (if (< len1 len2) len1 len2)))
      (let loop ((i 0))
        (if (< i min-len)
            (let ((diff (%char-ci-compare (string-ref s1 i) (string-ref s2 i))))
              (cond
                ((< diff 0) -1)
                ((> diff 0) 1)
                (else (loop (+ i 1)))))
            (cond
              ((< len1 len2) -1)
              ((> len1 len2) 1)
              (else 0)))))))

(define (string-ci=? s1 s2)
  (let ((len1 (string-length s1))
        (len2 (string-length s2)))
    (if (= len1 len2)
        (= (%string-ci-compare s1 s2) 0)
        #f)))

(define (string-ci<? s1 s2)
  (< (%string-ci-compare s1 s2) 0))

(define (string-ci>? s1 s2)
  (> (%string-ci-compare s1 s2) 0))

(define (string-ci<=? s1 s2)
  (<= (%string-ci-compare s1 s2) 0))

(define (string-ci>=? s1 s2)
  (>= (%string-ci-compare s1 s2) 0))



