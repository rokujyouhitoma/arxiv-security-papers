;;; ULisp Standard Library: string.scm
;;; String and Symbol manipulation procedures implemented purely in Scheme
;;; =======================================================================

(define (length ls)
  (let loop ((l ls) (n 0))
    (if (null? l) n
        (loop (cdr l) (+ n 1)))))

(define (reverse ls)
  (let loop ((l ls) (acc '()))
    (if (null? l)
        acc
        (loop (cdr l) (cons (car l) acc)))))

(define (string-append2 s1 s2)
  (let* ((len1 (string-length s1))
         (len2 (string-length s2))
         (total (+ len1 len2))
         (res (make-string total)))
    (let loop1 ((i 0))
      (if (< i len1)
          (begin
            (string-set! res i (string-ref s1 i))
            (loop1 (+ i 1)))
          (let loop2 ((j 0))
            (if (< j len2)
                (begin
                  (string-set! res (+ len1 j) (string-ref s2 j))
                  (loop2 (+ j 1)))
                res))))))

(define string-append
  (case-lambda
    (() "")
    ((s) s)
    ((s1 s2) (string-append2 s1 s2))
    ((s1 s2 . rest)
     (let loop ((acc (string-append2 s1 s2)) (rs rest))
       (if (null? rs)
           acc
           (loop (string-append2 acc (car rs)) (cdr rs)))))))

(define (substring str start end)
  (let* ((len (- end start))
         (res (make-string len)))
    (let loop ((i 0))
      (if (< i len)
          (begin
            (string-set! res i (string-ref str (+ start i)))
            (loop (+ i 1)))
          res))))

(define (%fixnum->string-radix n radix)
  (if (not (or (= radix 2) (= radix 8) (= radix 10) (= radix 16)))
      (error "number->string: invalid radix" radix)
      (if (= n 0)
          "0"
          (let* ((neg? (< n 0))
                 (abs-n (if neg? (- 0 n) n)))
            (let loop ((curr abs-n) (digits '()))
              (if (= curr 0)
                  (let* ((chars (if neg? (cons #\- digits) digits))
                         (len (length chars))
                         (res (make-string len)))
                    (let copy-loop ((i 0) (cs chars))
                      (if (null? cs)
                          res
                          (begin
                            (string-set! res i (car cs))
                            (copy-loop (+ i 1) (cdr cs))))))
                  (let* ((rem (modulo curr radix))
                         (next-curr (quotient curr radix))
                         (ch (if (< rem 10)
                                 (integer->char (+ 48 rem))
                                 (integer->char (+ 97 (- rem 10))))))
                    (loop next-curr (cons ch digits)))))))))

(define (%flonum-micros->string v)
  (let* ((neg? (< v 0))
         (av (if neg? (- 0 v) v))
         (int-part (quotient av 1000000))
         (frac-part (modulo av 1000000))
         (sign-str (if neg? "-" ""))
         (int-str (%fixnum->string-radix int-part 10)))
    (if (= frac-part 0)
        (string-append sign-str (string-append int-str ".0"))
        (let* ((d5 (modulo frac-part 10))
               (q5 (quotient frac-part 10))
               (d4 (modulo q5 10))
               (q4 (quotient q5 10))
               (d3 (modulo q4 10))
               (q3 (quotient q4 10))
               (d2 (modulo q3 10))
               (q2 (quotient q3 10))
               (d1 (modulo q2 10))
               (d0 (quotient q2 10))
               (raw-digits (list (integer->char (+ 48 d0))
                                 (integer->char (+ 48 d1))
                                 (integer->char (+ 48 d2))
                                 (integer->char (+ 48 d3))
                                 (integer->char (+ 48 d4))
                                 (integer->char (+ 48 d5))))
               (trimmed-rev
                (let strip ((ls (reverse raw-digits)))
                  (if (and (pair? (cdr ls)) (char=? (car ls) #\0))
                      (strip (cdr ls))
                      ls)))
               (trimmed (reverse trimmed-rev))
               (flen (length trimmed))
               (fstr (make-string flen)))
          (let copy-f ((i 0) (cs trimmed))
            (if (null? cs)
                (string-append sign-str (string-append int-str (string-append "." fstr)))
                (begin
                  (string-set! fstr i (car cs))
                  (copy-f (+ i 1) (cdr cs)))))))))

(define (%str-ratnum? x)
  (and (vector? x)
       (= (vector-length x) 3)
       (eq? (vector-ref x 0) 'ulisp-ratnum-tag)))

(define (%str-flonum? x)
  (and (vector? x)
       (= (vector-length x) 2)
       (eq? (vector-ref x 0) 'ulisp-flonum-tag)))

(define (%str-compnum? x)
  (and (vector? x)
       (= (vector-length x) 3)
       (eq? (vector-ref x 0) 'ulisp-complex-tag)))

(define (%number->string-radix z radix)
  (cond
    ((fixnum? z)
     (%fixnum->string-radix z radix))
    ((%str-ratnum? z)
     (string-append (%fixnum->string-radix (vector-ref z 1) radix)
                    (string-append "/"
                                   (%fixnum->string-radix (vector-ref z 2) radix))))
    ((%str-flonum? z)
     (let ((v (vector-ref z 1)))
       (cond
         ((eq? v 'pos-inf) "+inf.0")
         ((eq? v 'neg-inf) "-inf.0")
         ((eq? v 'nan) "+nan.0")
         (else (%flonum-micros->string v)))))
    ((%str-compnum? z)
     (let* ((re (vector-ref z 1))
            (im (vector-ref z 2))
            (re-str (%number->string-radix re radix))
            (im-str (%number->string-radix im radix))
            (im-first (if (> (string-length im-str) 0) (string-ref im-str 0) #\+))
            (has-sign? (or (char=? im-first #\+) (char=? im-first #\-))))
       (string-append re-str
                      (string-append (if has-sign? "" "+")
                                     (string-append im-str "i")))))
    (else
     (error "number->string: expected a number" z))))

(define number->string
  (case-lambda
    ((z) (%number->string-radix z 10))
    ((z radix) (%number->string-radix z radix))))


(define (escape-gas-string s)
  (let* ((len (string-length s))
         ;; Count extra chars needed for escape
         (extra (let count-loop ((i 0) (acc 0))
                  (if (< i len)
                      (let ((c (string-ref s i)))
                        (if (or (char=? c #\newline)
                                (or (char=? c #\tab)
                                    (or (char=? c (integer->char 13))
                                        (or (char=? c #\\)
                                            (char=? c #\")))))
                            (count-loop (+ i 1) (+ acc 1))
                            (count-loop (+ i 1) acc)))
                      acc))))
    (if (= extra 0)
        s
        (let ((res (make-string (+ len extra))))
          (let loop ((i 0) (out-idx 0))
            (if (< i len)
                (let ((c (string-ref s i)))
                  (cond
                    ((char=? c #\newline)
                     (string-set! res out-idx #\\)
                     (string-set! res (+ out-idx 1) #\n)
                     (loop (+ i 1) (+ out-idx 2)))
                    ((char=? c #\tab)
                     (string-set! res out-idx #\\)
                     (string-set! res (+ out-idx 1) #\t)
                     (loop (+ i 1) (+ out-idx 2)))
                    ((char=? c (integer->char 13))
                     (string-set! res out-idx #\\)
                     (string-set! res (+ out-idx 1) #\r)
                     (loop (+ i 1) (+ out-idx 2)))
                    ((char=? c #\\)
                     (string-set! res out-idx #\\)
                     (string-set! res (+ out-idx 1) #\\)
                     (loop (+ i 1) (+ out-idx 2)))
                    ((char=? c #\")
                     (string-set! res out-idx #\\)
                     (string-set! res (+ out-idx 1) #\")
                     (loop (+ i 1) (+ out-idx 2)))
                    (else
                     (string-set! res out-idx c)
                     (loop (+ i 1) (+ out-idx 1)))))
                res))))))

(define (%string-eq-loop s1 s2 i len)
  (if (< i len)
      (if (char=? (string-ref s1 i) (string-ref s2 i))
          (%string-eq-loop s1 s2 (+ i 1) len)
          #f)
      #t))

(define (string=? s1 s2)
  (let ((len1 (string-length s1))
        (len2 (string-length s2)))
    (if (= len1 len2)
        (%string-eq-loop s1 s2 0 len1)
        #f)))

;;; Dynamic Symbol Registry in pure Scheme (Hash Table with 16384 buckets & Direct Cache - Issue #780)
(define *symbol-str-buckets*
  (let ((v (%make-vector 16384)))
    (let loop ((i 0))
      (if (< i 16384)
          (begin
            (vector-set! v i '())
            (loop (+ i 1)))
          v))))

(define *symbol-sym-buckets*
  (let ((v (%make-vector 16384)))
    (let loop ((i 0))
      (if (< i 16384)
          (begin
            (vector-set! v i '())
            (loop (+ i 1)))
          v))))

;; Direct-Mapped Symbol-to-String Cache (4096 entries, Issue #780)
(define *sym-cache-sym*
  (let ((v (%make-vector 4096)))
    (let loop ((i 0))
      (if (< i 4096)
          (begin
            (vector-set! v i #f)
            (loop (+ i 1)))
          v))))

(define *sym-cache-str*
  (let ((v (%make-vector 4096)))
    (let loop ((i 0))
      (if (< i 4096)
          (begin
            (vector-set! v i #f)
            (loop (+ i 1)))
          v))))

(define *symbol-registry* (cons '() '()))
(define *next-sym-id* (cons 100 '()))

(define (%string-find-symbol str entries)
  (if (or (null? entries) (not (pair? entries)))
      #f
      (let ((entry (car entries)))
        (if (and (pair? entry) (string=? (car entry) str))
            (cdr entry)
            (%string-find-symbol str (cdr entries))))))

(define (%symbol-hash-str str)
  (let ((len (string-length str)))
    (let loop ((i 0) (h 5381))
      (if (= i len)
          (modulo h 16777213)
          (let ((c (char->integer (string-ref str i))))
            (loop (+ i 1)
                  (modulo (+ (* h 33) c) 16777213)))))))

(define (%sym-id-taken? sym entries)
  (if (or (null? entries) (not (pair? entries)))
      #f
      (let ((entry (car entries)))
        (if (and (pair? entry) (eq? (cdr entry) sym))
            #t
            (%sym-id-taken? sym (cdr entries))))))

(define (string->symbol str)
  (let* ((h (%symbol-hash-str str))
         (pos-h (if (< h 0) (- 0 h) h))
         (b-idx (bitwise-and pos-h 16383))
         (bucket (vector-ref *symbol-str-buckets* b-idx))
         (found (%string-find-symbol str bucket)))
    (if found
        found
        (let loop ((cand-h h))
          (let* ((pos-cand (if (< cand-h 0) (- 0 cand-h) cand-h))
                 (candidate (integer->symbol cand-h))
                 (sym-b-idx (bitwise-and pos-cand 16383))
                 (sym-bucket (vector-ref *symbol-sym-buckets* sym-b-idx)))
            (if (%sym-id-taken? candidate sym-bucket)
                (loop (modulo (+ (* cand-h 33) 1) 16777213))
                (let ((entry (cons str candidate)))
                  (vector-set! *symbol-str-buckets* b-idx (cons entry bucket))
                  (vector-set! *symbol-sym-buckets* sym-b-idx (cons entry sym-bucket))
                  (set-car! *symbol-registry* (cons entry (car *symbol-registry*)))
                  candidate)))))))

