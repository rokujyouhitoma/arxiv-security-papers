                 (%c99-lower-emit! ctx (list '%label l-fold))
                 (%c99-lower-emit! ctx '(%mov %rcx %rax))
                 (%c99-lower-emit! ctx '(%bit-and %rcx #x7ff))
                 (%c99-lower-emit! ctx '(%cmp %rcx 0))
                 (%c99-lower-emit! ctx (list '%jump-cond 'je l-nofold))
