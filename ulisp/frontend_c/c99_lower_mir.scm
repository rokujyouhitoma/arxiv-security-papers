;;; =======================================================================
;;; ULisp C99 Frontend: L_c_typed -> Core Machine LIR Lowering Engine
;;; Conforms to DSN-33-11 §4.3, DSN-33-13 §2.1/§3.2/§4.1, DSN-33-32,
;;; Issue #916 and Issue #918 (Struct/Union/Enum/Bitfield/SysV ABI).
;;; Emits pure Core Machine LIR (L_lir_core) verified by lir_verifier.scm
;;; and executable on Reference VM (#834), x86-64 ELF, and C backends.
;;; Zero local `set!` (ULisp AOT safe).
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Lowering Context (<c99-lower-ctx>)
;;; -----------------------------------------------------------------------

(define *c99-gpr-temp-pool* '(%rdi %rsi %r8))
(define *c99-xmm-temp-pool* '(%xmm2 %xmm3 %xmm4 %xmm5))

(define-record-type <c99-lower-ctx>
  (%make-lower-ctx vars strings data-entries str-cnt lbl-cnt insts next-si min-si
                   internal-fns layout-env ret-lbl ret-plan sret-si va-meta
                   break-lbl continue-lbl user-labels
                   needs-setjmp? needs-longjmp?
                   sanitize-bounds? needs-san-trap? cold-insts
                   san-ptr-meta san-last-cap-si
                   gpr-temps xmm-temps)
  c99-lower-ctx?
  (vars             lower-ctx-vars             lower-ctx-vars-set!)
  (strings          lower-ctx-strings          lower-ctx-strings-set!)
  (data-entries     lower-ctx-data-entries     lower-ctx-data-entries-set!)
  (str-cnt          lower-ctx-str-cnt          lower-ctx-str-cnt-set!)
  (lbl-cnt          lower-ctx-lbl-cnt          lower-ctx-lbl-cnt-set!)
  (insts            lower-ctx-insts            lower-ctx-insts-set!)
  (next-si          lower-ctx-next-si          lower-ctx-next-si-set!)
  (min-si           lower-ctx-min-si           lower-ctx-min-si-set!)
  (internal-fns     lower-ctx-internal-fns     lower-ctx-internal-fns-set!)
  (layout-env       lower-ctx-layout-env       lower-ctx-layout-env-set!)
  (ret-lbl          lower-ctx-ret-lbl          lower-ctx-ret-lbl-set!)
  (ret-plan         lower-ctx-ret-plan         lower-ctx-ret-plan-set!)
  (sret-si          lower-ctx-sret-si          lower-ctx-sret-si-set!)
  (va-meta          lower-ctx-va-meta          lower-ctx-va-meta-set!)
  (break-lbl        lower-ctx-break-lbl        lower-ctx-break-lbl-set!)
  (continue-lbl     lower-ctx-continue-lbl     lower-ctx-continue-lbl-set!)
  (user-labels      lower-ctx-user-labels      lower-ctx-user-labels-set!)
  (needs-setjmp?    lower-ctx-needs-setjmp?    lower-ctx-needs-setjmp?-set!)
  (needs-longjmp?   lower-ctx-needs-longjmp?   lower-ctx-needs-longjmp?-set!)
  (sanitize-bounds? lower-ctx-sanitize-bounds? lower-ctx-sanitize-bounds?-set!)
  (needs-san-trap?  lower-ctx-needs-san-trap?  lower-ctx-needs-san-trap?-set!)
  (cold-insts       lower-ctx-cold-insts       lower-ctx-cold-insts-set!)
  (san-ptr-meta     lower-ctx-san-ptr-meta     lower-ctx-san-ptr-meta-set!)
  (san-last-cap-si  lower-ctx-san-last-cap-si  lower-ctx-san-last-cap-si-set!)
  (gpr-temps        lower-ctx-gpr-temps        lower-ctx-gpr-temps-set!)
  (xmm-temps        lower-ctx-xmm-temps        lower-ctx-xmm-temps-set!))

(define (make-c99-lower-ctx internal-fns layout-env . maybe-san)
  (let ((san? (if (and (pair? maybe-san) (car maybe-san)) #t #f)))
    (%make-lower-ctx '() '() '() 0 0 '() -16 -16 internal-fns
                     (or layout-env (make-c99-layout-env))
                     #f '(void) #f #f #f #f '() #f #f
                     san? #f '() '() #f
                     *c99-gpr-temp-pool* *c99-xmm-temp-pool*)))

(define (%c99-lower-alloc-gpr-temp! ctx)
  (let ((pool (lower-ctx-gpr-temps ctx)))
    (if (null? pool)
        #f
        (begin
          (lower-ctx-gpr-temps-set! ctx (cdr pool))
          (car pool)))))

(define (%c99-lower-alloc-xmm-temp! ctx)
  (let ((pool (lower-ctx-xmm-temps ctx)))
    (if (null? pool)
        #f
        (begin
          (lower-ctx-xmm-temps-set! ctx (cdr pool))
          (car pool)))))

(define (%c99-lower-resolve-runtime-fn! ctx sym)
  (cond
    ((memq sym (lower-ctx-internal-fns ctx)) sym)
    ((c99-setjmp-fn-sym? sym)
     (lower-ctx-needs-setjmp?-set! ctx #t)
     '__ulisp_setjmp)
    ((c99-longjmp-fn-sym? sym)
     (lower-ctx-needs-longjmp?-set! ctx #t)
     '__ulisp_longjmp)
    (else sym)))

(define (%c99-lower-emit! ctx inst)
  (lower-ctx-insts-set! ctx (cons inst (lower-ctx-insts ctx))))

(define (%c99-lower-new-label ctx prefix)
  (let ((n (lower-ctx-lbl-cnt ctx)))
    (lower-ctx-lbl-cnt-set! ctx (+ n 1))
    (string->symbol (string-append ".L_c99_" prefix "_" (number->string n)))))

(define (%c99-lower-user-label ctx c-lbl)
  (let ((slot (assq c-lbl (lower-ctx-user-labels ctx))))
    (if slot
        (cdr slot)
        (let ((lbl (%c99-lower-new-label ctx (string-append "u_" (symbol->string c-lbl)))))
          (lower-ctx-user-labels-set! ctx (cons (cons c-lbl lbl) (lower-ctx-user-labels ctx)))
          lbl))))

(define (%c99-lower-alloc-slot! ctx)
  (let ((si (lower-ctx-next-si ctx)))
    (lower-ctx-next-si-set! ctx (- si 8))
    (if (< si (lower-ctx-min-si ctx))
        (lower-ctx-min-si-set! ctx si))
    si))

(define (%c99-lower-alloc-bytes! ctx sz align)
  (let* ((alloc-sz (max 8 (c-type-align-up (max 1 sz) 8)))
         (a (max 8 align))
         (free-top (+ (lower-ctx-next-si ctx) 8))
         (raw-start (- free-top alloc-sz))
         (rem (modulo raw-start a))
         (base-si (if (= rem 0) raw-start (- raw-start rem))))
    (lower-ctx-next-si-set! ctx (- base-si 8))
    (if (< base-si (lower-ctx-min-si ctx))
        (lower-ctx-min-si-set! ctx base-si))
    base-si))

(define (%c99-list-tail ls k)
  (if (or (<= k 0) (not (pair? ls)))
      ls
      (%c99-list-tail (cdr ls) (- k 1))))

(define (%c99-lower-intern-str! ctx str-val)
  (let ((n (lower-ctx-str-cnt ctx)))
    (lower-ctx-str-cnt-set! ctx (+ n 1))
    (let ((lbl (string->symbol (string-append ".L_cstr_" (number->string n)))))
      (lower-ctx-strings-set! ctx (cons (list lbl str-val) (lower-ctx-strings ctx)))
      lbl)))

(define (%c99-lower-add-data-entry! ctx entry)
  (lower-ctx-data-entries-set! ctx (cons entry (lower-ctx-data-entries ctx))))

(define (%c99-lower-bind-local! ctx u-sym ty)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (sz (c-type-size-in lenv ty))
         (al (c-type-align-in lenv ty))
         (si (%c99-lower-alloc-bytes! ctx sz al)))
    (lower-ctx-vars-set! ctx (cons (list u-sym 'local si ty) (lower-ctx-vars ctx)))
    si))

(define (%c99-lower-bind-data-global! ctx u-sym ty)
  (lower-ctx-vars-set! ctx (cons (list u-sym 'data-global u-sym ty) (lower-ctx-vars ctx))))

(define (%c99-lower-lookup-var ctx u-sym)
  (let ((slot (assq u-sym (lower-ctx-vars ctx))))
    (if slot (cdr slot) #f)))

;;; -----------------------------------------------------------------------
;;; 2. Type Size/Width Normalization, Shifts, Memory & Float Helpers
;;; -----------------------------------------------------------------------

(define (%c99-lower-type-size ctx ty)
  (c-type-size-in (lower-ctx-layout-env ctx) ty))

(define (%c99-lower-type-align ctx ty)
  (max 1 (c-type-align-in (lower-ctx-layout-env ctx) ty)))

(define (%c99-lower-aggregate-like? ty)
  (or (c-struct-ref-type? ty)
      (c-union-ref-type? ty)
      (c-array-type? ty)))

(define (%c99-lower-emit-cast-reg! ctx to-ty reg)
  (case to-ty
    ((bool)
     (let ((l-zero (%c99-lower-new-label ctx "bool_z"))
           (l-done (%c99-lower-new-label ctx "bool_d")))
       (%c99-lower-emit! ctx (list '%cmp reg 0))
       (%c99-lower-emit! ctx (list '%jump-cond 'je l-zero))
       (%c99-lower-emit! ctx (list '%mov reg 1))
       (%c99-lower-emit! ctx (list '%direct-jump l-done))
       (%c99-lower-emit! ctx (list '%label l-zero))
       (%c99-lower-emit! ctx (list '%mov reg 0))
       (%c99-lower-emit! ctx (list '%label l-done))))
    ((i8)  (%c99-lower-emit! ctx (list '%sext 'i8 reg reg)))
    ((u8)  (%c99-lower-emit! ctx (list '%zext 'u8 reg reg)))
    ((i16) (%c99-lower-emit! ctx (list '%sext 'i16 reg reg)))
    ((u16) (%c99-lower-emit! ctx (list '%zext 'u16 reg reg)))
    ((i32) (%c99-lower-emit! ctx (list '%sext 'i32 reg reg)))
    ((u32) (%c99-lower-emit! ctx (list '%zext 'u32 reg reg)))
    (else #f)))

(define (%c99-lower-emit-cast! ctx to-ty)
  (%c99-lower-emit-cast-reg! ctx to-ty '%rax))

(define (%c99-normalize-int-val ty v)
  (case ty
    ((bool) (if (= v 0) 0 1))
    ((i8)   (let ((m (modulo v 256))) (if (>= m 128) (- m 256) m)))
    ((u8)   (modulo v 256))
    ((i16)  (let ((m (modulo v 65536))) (if (>= m 32768) (- m 65536) m)))
    ((u16)  (modulo v 65536))
    ((i32)  (let ((m (modulo v 4294967296))) (if (>= m 2147483648) (- m 4294967296) m)))
    ((u32)  (modulo v 4294967296))
    ((i64)  (let ((m (modulo v 18446744073709551616)))
              (if (>= m 9223372036854775808) (- m 18446744073709551616) m)))
    (else   (modulo v 18446744073709551616))))

(define (%c99-lower-eval-const-int node)
  (let ((ty (c-typed-type node))
        (inner (c-typed-inner node)))
    (cond
      ((not (or (c-integer-type? ty) (c-enum-type? ty) (c-pointer-type? ty)))
       #f)
      ((and (pair? inner) (eq? (car inner) 'c-const-val) (integer? (cadr inner)))
       (%c99-normalize-int-val (if (c-enum-type? ty) 'i32 ty) (cadr inner)))
      ((and (pair? inner) (eq? (car inner) 'c-enum-const) (integer? (cadr inner)))
       (%c99-normalize-int-val (if (c-enum-type? ty) 'i32 ty) (cadr inner)))
      ((and (pair? inner) (memq (car inner) '(c-implicit-cast c-cast)))
       (let ((sub (%c99-lower-eval-const-int (caddr inner))))
         (and sub (%c99-normalize-int-val (if (c-enum-type? ty) 'i32 ty) sub))))
      (else #f))))

(define (%c99-lower-extract-imm32 node)
  (let ((v (%c99-lower-eval-const-int node)))
    (if (and v (integer? v) (>= v -2147483648) (<= v 2147483647))
        v
        #f)))

(define (%c99-expr-preserves-temp-regs? ctx node)
  (let* ((ty (c-typed-type node))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (case tag
      ((c-const-val c-enum-const c-str-val c-fn-ref c-var-ref) #t)
      ((c-implicit-cast c-cast)
       (let ((sub (caddr inner)))
         (and (not (%c99-lower-aggregate-like? (c-typed-type sub)))
              (%c99-expr-preserves-temp-regs? ctx sub))))
      ((c-unop)
       (let ((op (cadr inner))
             (sub (caddr inner)))
         (cond
           ((memq op '(uplus neg bit-not lnot addr deref))
            (%c99-expr-preserves-temp-regs? ctx sub))
           ((memq op '(pre++ pre-- post++ post--))
            (and (not (%c99-lower-aggregate-like? (c-typed-type sub)))
                 (not (and (eq? (car (c-typed-inner sub)) 'c-member)
                           (c-field-layout-bit-width
                            (%c99-lower-member-field-layout ctx (c-typed-inner sub)))))
                 (%c99-expr-preserves-temp-regs? ctx sub)))
           (else #f))))
      ((c-member)
       (let ((base (cadr inner))
             (deref? (cadddr inner)))
         (if deref?
             (%c99-expr-preserves-temp-regs? ctx base)
             (and (%c99-lower-lvalue-has-addr? base)
                  (%c99-expr-preserves-temp-regs? ctx base)))))
      ((c-index)
       (let ((arr (cadr inner))
             (idx (caddr inner)))
         (and (or (not (c-array-type? (c-typed-type arr)))
                  (%c99-lower-lvalue-has-addr? arr))
              (%c99-expr-preserves-temp-regs? ctx arr)
              (%c99-expr-preserves-temp-regs? ctx idx))))
      ((c-binop)
       (let ((op (cadr inner))
             (lhs (caddr inner))
             (rhs (cadddr inner)))
         (and (or (not (eq? op 'comma))
                  (not (%c99-lower-aggregate-like? (c-typed-type lhs))))
              (%c99-expr-preserves-temp-regs? ctx lhs)
              (%c99-expr-preserves-temp-regs? ctx rhs))))
      ((c-ternary)
       (and (not (%c99-lower-aggregate-like? ty))
            (%c99-expr-preserves-temp-regs? ctx (cadr inner))
            (%c99-expr-preserves-temp-regs? ctx (caddr inner))
            (%c99-expr-preserves-temp-regs? ctx (cadddr inner))))
      (else #f))))

(define (%c99-lower-peel-member-chain ctx node)
  ;; Unwraps non-deref c-member hops accumulating total byte offset: (root . off) or #f if bitfield
  (let loop ((cur node) (acc 0))
    (let ((in (c-typed-inner cur)))
      (if (eq? (car in) 'c-member)
          (let ((fl (%c99-lower-member-field-layout ctx in)))
            (if (c-field-layout-bit-width fl)
                #f
                (let ((off (+ acc (c-field-layout-offset fl))))
                  (if (cadddr in)
                      (cons cur acc)
                      (loop (cadr in) off)))))
          (cons cur acc)))))

(define (%c99-lower-direct-addr-to-reg! ctx lval dst-reg scratch-reg emit?)
  (let* ((inner (c-typed-inner lval))
         (tag (car inner)))
    (cond
      ((eq? dst-reg scratch-reg) #f)
      ((eq? tag 'c-var-ref)
       (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
         (if (not ent)
             #f
             (begin
               (if emit?
                   (if (eq? (car ent) 'local)
                       (begin
                         (%c99-lower-emit! ctx (list '%mov dst-reg '%rsp))
                         (if (not (= (cadr ent) 0))
                             (%c99-lower-emit! ctx (list '%add dst-reg (cadr ent)))))
                       (%c99-lower-emit! ctx (list '%global-addr dst-reg (cadr ent)))))
               #t))))
      ((eq? tag 'c-fn-ref)
       (if emit?
           (%c99-lower-emit! ctx (list '%code-ref dst-reg (%c99-lower-resolve-runtime-fn! ctx (cadr inner)))))
       #t)
      ((eq? tag 'c-str-val)
       (if emit?
           (let ((lbl (%c99-lower-intern-str! ctx (cadr inner))))
             (%c99-lower-emit! ctx (list '%str-ref dst-reg lbl))
             (%c99-lower-emit! ctx (list '%sub dst-reg 3))))
       #t)
      ((eq? tag 'c-unop)
       (if (and (eq? (cadr inner) 'deref)
                (not (lower-ctx-sanitize-bounds? ctx)))
           (%c99-lower-direct-scalar-to-reg! ctx (caddr inner) dst-reg scratch-reg emit?)
           #f))
      ((eq? tag 'c-member)
       (let* ((chain (%c99-lower-peel-member-chain ctx lval)))
         (if (not chain)
             #f
             (let* ((root (car chain))
                    (off (cdr chain))
                    (rin (c-typed-inner root)))
               (cond
                 ((and (eq? (car rin) 'c-member) (cadddr rin))
                  (if (lower-ctx-sanitize-bounds? ctx)
                      #f
                      (let* ((fl (%c99-lower-member-field-layout ctx rin))
                             (total-off (+ off (c-field-layout-offset fl))))
                        (and (<= -2147483648 total-off)
                             (<= total-off 2147483647)
                             (%c99-lower-direct-scalar-to-reg! ctx (cadr rin) dst-reg scratch-reg emit?)
                             (begin
                               (if (and emit? (not (= total-off 0)))
                                   (%c99-lower-emit! ctx (list '%add dst-reg total-off)))
                               #t)))))
                 ((%c99-lower-lvalue-has-addr? root)
                  (and (<= -2147483648 off)
                       (<= off 2147483647)
                       (%c99-lower-direct-addr-to-reg! ctx root dst-reg scratch-reg emit?)
                       (begin
                         (if (and emit? (not (= off 0)))
                             (%c99-lower-emit! ctx (list '%add dst-reg off)))
                         #t)))
                 (else #f))))))
      ((eq? tag 'c-index)
       (if (lower-ctx-sanitize-bounds? ctx)
           #f
           (let ((arr (cadr inner))
                 (idx (caddr inner))
                 (k (%c99-lower-extract-imm32 (caddr inner)))
                 (elem-sz (max 1 (%c99-lower-type-size ctx (c-typed-type lval)))))
             (if (not k)
                 #f
                 (let ((byte-off (* k elem-sz)))
                   (and (<= -2147483648 byte-off)
                        (<= byte-off 2147483647)
                        (if (c-array-type? (c-typed-type arr))
                            (%c99-lower-direct-addr-to-reg! ctx arr dst-reg scratch-reg emit?)
                            (%c99-lower-direct-scalar-to-reg! ctx arr dst-reg scratch-reg emit?))
                        (begin
                          (if (and emit? (not (= byte-off 0)))
                              (%c99-lower-emit! ctx (list '%add dst-reg byte-off)))
                          #t)))))))
      ((memq tag '(c-implicit-cast c-cast))
       (let ((sub (caddr inner)))
         (and (%c99-lower-lvalue-has-addr? sub)
              (%c99-lower-direct-addr-to-reg! ctx sub dst-reg scratch-reg emit?))))
      (else #f))))

(define (%c99-lower-direct-scalar-to-reg! ctx node dst-reg scratch-reg emit?)
  (let* ((ty (c-typed-type node))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (cond
      ((or (eq? dst-reg scratch-reg)
           (c-float-type? ty)
           (%c99-lower-aggregate-like? ty)
           (eq? ty 'void))
       #f)
      ((or (c-array-type? ty) (c-function-type? ty))
       (and (memq tag '(c-var-ref c-member c-index c-fn-ref c-str-val))
            (%c99-lower-direct-addr-to-reg! ctx node dst-reg scratch-reg emit?)))
      ((eq? tag 'c-const-val)
       (if (not (integer? (cadr inner)))
           #f
           (let ((v (cadr inner)))
             (if emit?
                 (if (and (>= v -2147483648) (<= v 2147483647))
                     (%c99-lower-emit! ctx (list '%mov dst-reg v))
                     (%c99-lower-emit-u64-const! ctx dst-reg (modulo v 18446744073709551616))))
             #t)))
      ((eq? tag 'c-enum-const)
       (if emit?
           (%c99-lower-emit! ctx (list '%mov dst-reg (cadr inner))))
       #t)
      ((eq? tag 'c-str-val)
       (%c99-lower-direct-addr-to-reg! ctx node dst-reg scratch-reg emit?))
      ((eq? tag 'c-fn-ref)
       (%c99-lower-direct-addr-to-reg! ctx node dst-reg scratch-reg emit?))
      ((eq? tag 'c-var-ref)
       (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
         (if (not ent)
             #f
             (begin
               (if emit?
                   (if (eq? (car ent) 'local)
                       (%c99-lower-load-from-mem! ctx dst-reg '%rsp (cadr ent) ty)
                       (begin
                         (%c99-lower-emit! ctx (list '%global-addr scratch-reg (cadr ent)))
                         (%c99-lower-load-from-mem! ctx dst-reg scratch-reg 0 ty))))
               #t))))
      ((eq? tag 'c-unop)
       (let ((op (cadr inner))
             (sub (caddr inner)))
         (cond
           ((eq? op 'addr)
            (%c99-lower-direct-addr-to-reg! ctx sub dst-reg scratch-reg emit?))
           ((eq? op 'deref)
            (and (not (lower-ctx-sanitize-bounds? ctx))
                 (%c99-lower-direct-scalar-to-reg! ctx sub scratch-reg dst-reg emit?)
                 (begin
                   (if emit?
                       (%c99-lower-load-from-mem! ctx dst-reg scratch-reg 0 ty))
                   #t)))
           (else #f))))
      ((eq? tag 'c-member)
       (let ((chain (%c99-lower-peel-member-chain ctx node)))
         (if (not chain)
             #f
             (let* ((root (car chain))
                    (off (cdr chain))
                    (rin (c-typed-inner root)))
               (cond
                 ((and (eq? (car rin) 'c-var-ref)
                       (%c99-lower-lookup-var ctx (cadr rin)))
                  => (lambda (ent)
                       (if emit?
                           (if (eq? (car ent) 'local)
                               (%c99-lower-load-from-mem! ctx dst-reg '%rsp (+ (cadr ent) off) ty)
                               (begin
                                 (%c99-lower-emit! ctx (list '%global-addr scratch-reg (cadr ent)))
                                 (%c99-lower-load-from-mem! ctx dst-reg scratch-reg off ty))))
                       #t))
                 ((and (eq? (car rin) 'c-member) (cadddr rin))
                  (if (lower-ctx-sanitize-bounds? ctx)
                      #f
                      (let* ((fl (%c99-lower-member-field-layout ctx rin))
                             (total-off (+ off (c-field-layout-offset fl))))
                        (and (<= -2147483648 total-off)
                             (<= total-off 2147483647)
                             (%c99-lower-direct-scalar-to-reg! ctx (cadr rin) scratch-reg dst-reg emit?)
                             (begin
                               (if emit?
                                   (%c99-lower-load-from-mem! ctx dst-reg scratch-reg total-off ty))
                               #t)))))
                 ((%c99-lower-lvalue-has-addr? root)
                  (and (%c99-lower-direct-addr-to-reg! ctx root scratch-reg dst-reg emit?)
                       (begin
                         (if emit?
                             (%c99-lower-load-from-mem! ctx dst-reg scratch-reg off ty))
                         #t)))
                 (else #f))))))
      ((eq? tag 'c-index)
       (if (lower-ctx-sanitize-bounds? ctx)
           #f
           (let ((arr (cadr inner))
                 (k (%c99-lower-extract-imm32 (caddr inner)))
                 (elem-sz (max 1 (%c99-lower-type-size ctx ty))))
             (if (not k)
                 #f
                 (let ((byte-off (* k elem-sz)))
                   (and (<= -2147483648 byte-off)
                        (<= byte-off 2147483647)
                        (if (c-array-type? (c-typed-type arr))
                            (%c99-lower-direct-addr-to-reg! ctx arr scratch-reg dst-reg emit?)
                            (%c99-lower-direct-scalar-to-reg! ctx arr scratch-reg dst-reg emit?))
                        (begin
                          (if emit?
                              (%c99-lower-load-from-mem! ctx dst-reg scratch-reg byte-off ty))
                          #t)))))))
      ((memq tag '(c-implicit-cast c-cast))
       (let* ((target-ty ty)
              (sub (caddr inner))
              (src-ty (c-typed-type sub)))
         (cond
           ((eq? target-ty 'void) #f)
           ((and (c-pointer-type? target-ty) (c-array-type? src-ty))
            (%c99-lower-direct-addr-to-reg! ctx sub dst-reg scratch-reg emit?))
           ((and (c-pointer-type? target-ty) (c-function-type? src-ty))
            (%c99-lower-direct-addr-to-reg! ctx sub dst-reg scratch-reg emit?))
           ((or (c-float-type? src-ty) (%c99-lower-aggregate-like? src-ty)) #f)
           ((%c99-lower-direct-scalar-to-reg! ctx sub dst-reg scratch-reg emit?)
            (if emit?
                (cond
                  ((eq? target-ty 'bool)
                   (%c99-lower-emit-cast-reg! ctx 'bool dst-reg))
                  ((and (memq src-ty '(i8 i16 i32)) (memq target-ty '(u32 u64)))
                   (if (eq? target-ty 'u32)
                       (%c99-lower-emit! ctx (list '%zext 'u32 dst-reg dst-reg))))
                  ((memq target-ty '(i8 u8 i16 u16 i32 u32))
                   (%c99-lower-emit-cast-reg! ctx target-ty dst-reg))))
            #t)
           (else #f))))
      (else #f))))

(define (%c99-lower-direct-fp-to-reg! ctx node dst-xmm as-f64? emit?)
  ;; Clobbers only dst-xmm, %rdx, and %rcx. Never touches %rax or %xmm0.
  (let* ((ty (c-typed-type node))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (if (not (c-float-type? ty))
        #f
        (case tag
          ((c-const-val)
           (if emit?
               (begin
                 (let* ((flt (cadr inner))
                        (bits (cond
                                ((and (pair? flt) (eq? (car flt) 'c-float-bits)) (cadr flt))
                                ((eq? ty 'f32) (vm-f32->ieee754-u32 flt))
                                (else (vm-f64->ieee754-u64 flt))))
                        (lbl (%c99-lower-intern-fp-bits! ctx ty bits)))
                   (%c99-lower-emit! ctx (list '%global-addr '%rdx lbl))
                   (%c99-lower-emit! ctx (list '%load-typed (if (eq? ty 'f32) 'f32 'f64) dst-xmm '%rdx 0))
                   (if (and as-f64? (eq? ty 'f32))
                       (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm))))))
           #t)
          ((c-var-ref)
           (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
             (if (not ent)
                 #f
                 (begin
                   (if emit?
                       (begin
                         (if (eq? (car ent) 'local)
                             (%c99-lower-load-from-mem! ctx dst-xmm '%rsp (cadr ent) ty)
                             (begin
                               (%c99-lower-emit! ctx (list '%global-addr '%rdx (cadr ent)))
                               (%c99-lower-load-from-mem! ctx dst-xmm '%rdx 0 ty)))
                         (if (and as-f64? (eq? ty 'f32))
                             (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm)))))
                   #t))))
          ((c-unop)
           (if (and (eq? (cadr inner) 'deref)
                    (not (lower-ctx-sanitize-bounds? ctx)))
               (and (%c99-lower-direct-scalar-to-reg! ctx (caddr inner) '%rdx '%rcx emit?)
                    (begin
                      (if emit?
                          (begin
                            (%c99-lower-load-from-mem! ctx dst-xmm '%rdx 0 ty)
                            (if (and as-f64? (eq? ty 'f32))
                                (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm)))))
                      #t))
               #f))
          ((c-member)
           (let ((chain (%c99-lower-peel-member-chain ctx node)))
             (if (not chain)
                 #f
                 (let* ((root (car chain))
                        (off (cdr chain))
                        (rin (c-typed-inner root)))
                   (cond
                     ((and (eq? (car rin) 'c-var-ref)
                           (%c99-lower-lookup-var ctx (cadr rin)))
                      => (lambda (ent)
                           (if emit?
                               (begin
                                 (if (eq? (car ent) 'local)
                                     (%c99-lower-load-from-mem! ctx dst-xmm '%rsp (+ (cadr ent) off) ty)
                                     (begin
                                       (%c99-lower-emit! ctx (list '%global-addr '%rdx (cadr ent)))
                                       (%c99-lower-load-from-mem! ctx dst-xmm '%rdx off ty)))
                                 (if (and as-f64? (eq? ty 'f32))
                                     (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm)))))
                           #t))
                     ((and (eq? (car rin) 'c-member) (cadddr rin))
                      (if (lower-ctx-sanitize-bounds? ctx)
                          #f
                          (let* ((fl (%c99-lower-member-field-layout ctx rin))
                                 (total-off (+ off (c-field-layout-offset fl))))
                            (and (<= -2147483648 total-off)
                                 (<= total-off 2147483647)
                                 (%c99-lower-direct-scalar-to-reg! ctx (cadr rin) '%rdx '%rcx emit?)
                                 (begin
                                   (if emit?
                                       (begin
                                         (%c99-lower-load-from-mem! ctx dst-xmm '%rdx total-off ty)
                                         (if (and as-f64? (eq? ty 'f32))
                                             (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm)))))
                                   #t)))))
                     ((%c99-lower-lvalue-has-addr? root)
                      (and (%c99-lower-direct-addr-to-reg! ctx root '%rdx '%rcx emit?)
                           (begin
                             (if emit?
                                 (begin
                                   (%c99-lower-load-from-mem! ctx dst-xmm '%rdx off ty)
                                   (if (and as-f64? (eq? ty 'f32))
                                       (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm)))))
                             #t)))
                     (else #f))))))
          ((c-implicit-cast c-cast)
           (let* ((sub (caddr inner))
                  (src-ty (c-typed-type sub)))
             (and (c-float-type? src-ty)
                  (%c99-lower-direct-fp-to-reg! ctx sub dst-xmm #f emit?)
                  (begin
                    (if emit?
                        (cond
                          ((and (eq? src-ty 'f32) (or as-f64? (eq? ty 'f64)))
                           (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm)))
                          ((and (eq? src-ty 'f64) (eq? ty 'f32))
                           (%c99-lower-emit! ctx (list '%fptrunc 'f32 dst-xmm dst-xmm))
                           (if as-f64?
                               (%c99-lower-emit! ctx (list '%fpext 'f64 dst-xmm dst-xmm))))))
                    #t))))
          (else #f)))))

(define (%c99-lower-emit-parallel-moves! ctx move-op scratch-reg pairs)
  (let* ((is-float? (or (eq? move-op '%fmov) (lir-pmov-float-loc? scratch-reg)))
         (plan (lir-parallel-move-plan
                pairs
                (if is-float? '() (list scratch-reg))
                (if is-float? (list scratch-reg) '())
                #f)))
    (for-each (lambda (step)
                (%c99-lower-emit! ctx (list move-op (car step) (cdr step))))
              plan)))

(define (%c99-lower-emit-u64-const! ctx dst-reg uval)
  (let ((lo (modulo uval 4294967296))
        (hi (modulo (quotient uval 4294967296) 4294967296)))
    (if (and (= hi 0) (< lo 2147483648))
        (%c99-lower-emit! ctx (list '%mov dst-reg lo))
        (let ((tmp (%c99-lower-alloc-slot! ctx)))
          (%c99-lower-emit! ctx (list '%mov dst-reg (modulo lo 4294967296)))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 '%rsp tmp dst-reg))
          (%c99-lower-emit! ctx (list '%mov dst-reg (modulo hi 4294967296)))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 '%rsp (+ tmp 4) dst-reg))
          (%c99-lower-emit! ctx (list '%load dst-reg '%rsp tmp))))))

(define (%c99-lower-data-entry-exists? ctx lbl)
  (let loop ((es (lower-ctx-data-entries ctx)))
    (cond
      ((null? es) #f)
      ((and (pair? (car es)) (pair? (cdar es)) (eq? (cadar es) lbl)) #t)
      (else (loop (cdr es))))))

(define (%c99-lower-intern-fp-bits! ctx ty bits)
  (if (eq? ty 'f32)
      (let* ((u32 (bitwise-and bits #xffffffff))
             (lbl (string->symbol (string-append ".L_c99_fp32_" (c99-ieee754-u32->hex8 u32)))))
        (if (not (%c99-lower-data-entry-exists? ctx lbl))
            (%c99-lower-add-data-entry!
             ctx
             (cons 'bytes (cons lbl (cons 4 (c99-ieee754-bits->le-bytes u32 4))))))
        lbl)
      (let* ((u64 (bitwise-and bits #xffffffffffffffff))
             (lbl (string->symbol (string-append ".L_c99_fp64_" (c99-ieee754-u64->hex16 u64)))))
        (if (not (%c99-lower-data-entry-exists? ctx lbl))
            (%c99-lower-add-data-entry!
             ctx
             (cons 'bytes (cons lbl (cons 8 (c99-ieee754-bits->le-bytes u64 8))))))
        lbl)))

(define (%c99-lower-emit-float-const! ctx flt ty)
  (let* ((bits (cond
                 ((and (pair? flt) (eq? (car flt) 'c-float-bits)) (cadr flt))
                 ((eq? ty 'f32) (vm-f32->ieee754-u32 flt))
                 (else (vm-f64->ieee754-u64 flt))))
         (lbl (%c99-lower-intern-fp-bits! ctx ty bits)))
    (%c99-lower-emit! ctx (list '%global-addr '%rdx lbl))
    (%c99-lower-emit! ctx (list '%load-typed (if (eq? ty 'f32) 'f32 'f64) '%xmm0 '%rdx 0))))

(define (%c99-lower-eval-cond! ctx expr)
  (%c99-lower-expr! ctx expr)
  (let ((ty (c-typed-type expr)))
    (if (c-float-type? ty)
        (begin
          (if (eq? ty 'f32)
              (%c99-lower-emit! ctx '(%fpext f64 %xmm0 %xmm0)))
          (%c99-lower-emit! ctx '(%mov %rax 0))
          (%c99-lower-emit! ctx '(%sitofp %xmm1 %rax))
          (%c99-lower-emit! ctx '(%fcmp-une %rax %xmm0 %xmm1))))))

(define (%c99-lower-load-from-mem! ctx dst-reg base-reg disp ty)
  (cond
    ((c-float-type? ty)
     (%c99-lower-emit! ctx (list '%load-typed ty dst-reg base-reg disp)))
    ((memq ty '(bool i8 u8 i16 u16 i32 u32))
     (%c99-lower-emit! ctx (list '%load-typed (c-type->lir-ty ty) dst-reg base-reg disp)))
    ((c-enum-type? ty)
     (%c99-lower-emit! ctx (list '%load-typed 'i32 dst-reg base-reg disp)))
    (else
     (%c99-lower-emit! ctx (list '%load dst-reg base-reg disp)))))

(define (%c99-lower-store-to-mem! ctx base-reg disp src-reg ty)
  (cond
    ((c-float-type? ty)
     (%c99-lower-emit! ctx (list '%store-typed ty base-reg disp src-reg)))
    ((memq ty '(bool i8 u8 i16 u16 i32 u32))
     (%c99-lower-emit! ctx (list '%store-typed (c-type->lir-ty ty) base-reg disp src-reg)))
    ((c-enum-type? ty)
     (%c99-lower-emit! ctx (list '%store-typed 'i32 base-reg disp src-reg)))
    (else
     (%c99-lower-emit! ctx (list '%store base-reg disp src-reg)))))

(define (%c99-lower-memzero! ctx base-reg base-off sz)
  (cond
    ((<= sz 0) #f)
    ((> sz 64)
     (let ((qwords (quotient sz 8))
           (rem (modulo sz 8))
           (loop-lbl (%c99-lower-new-label ctx "mz_l"))
           (done-lbl (%c99-lower-new-label ctx "mz_d")))
       (if (not (eq? base-reg '%rdx))
           (%c99-lower-emit! ctx (list '%mov '%rdx base-reg)))
       (if (not (= base-off 0))
           (%c99-lower-emit! ctx (list '%add '%rdx base-off)))
       (%c99-lower-emit! ctx (list '%mov '%rcx qwords))
       (%c99-lower-emit! ctx '(%mov %rax 0))
       (%c99-lower-emit! ctx (list '%label loop-lbl))
       (%c99-lower-emit! ctx '(%cmp %rcx 0))
       (%c99-lower-emit! ctx (list '%jump-cond 'je done-lbl))
       (%c99-lower-emit! ctx '(%store %rdx 0 %rax))
       (%c99-lower-emit! ctx '(%add %rdx 8))
       (%c99-lower-emit! ctx '(%sub %rcx 1))
       (%c99-lower-emit! ctx (list '%direct-jump loop-lbl))
       (%c99-lower-emit! ctx (list '%label done-lbl))
       (%c99-lower-memzero! ctx '%rdx 0 rem)))
    (else
     (%c99-lower-emit! ctx '(%mov %rax 0))
     (let loop ((off base-off) (rem sz))
       (cond
         ((>= rem 8)
          (%c99-lower-emit! ctx (list '%store base-reg off '%rax))
          (loop (+ off 8) (- rem 8)))
         ((>= rem 4)
          (%c99-lower-emit! ctx (list '%store-typed 'u32 base-reg off '%rax))
          (loop (+ off 4) (- rem 4)))
         ((>= rem 2)
          (%c99-lower-emit! ctx (list '%store-typed 'u16 base-reg off '%rax))
          (loop (+ off 2) (- rem 2)))
         ((>= rem 1)
          (%c99-lower-emit! ctx (list '%store-typed 'u8 base-reg off '%rax))
          (loop (+ off 1) (- rem 1))))))))

;; Copies sz bytes from [src-reg + src-off] into [dst-reg + dst-off].
;; May clobber %rax, %r8, %r9, %r10, %r11. Preserves/reloads if >64 via ptr slots.
(define (%c99-lower-memcpy-regs! ctx dst-reg dst-off src-reg src-off sz)
  (cond
    ((<= sz 0) #f)
    ((> sz 64)
     (let ((dst-si (%c99-lower-alloc-slot! ctx))
           (src-si (%c99-lower-alloc-slot! ctx))
           (qwords (quotient sz 8))
           (rem (modulo sz 8))
           (loop-lbl (%c99-lower-new-label ctx "mc_l"))
           (done-lbl (%c99-lower-new-label ctx "mc_d")))
       (%c99-lower-emit! ctx (list '%mov '%rax dst-reg))
       (if (not (= dst-off 0)) (%c99-lower-emit! ctx (list '%add '%rax dst-off)))
       (%c99-lower-emit! ctx (list '%store '%rsp dst-si '%rax))
       (%c99-lower-emit! ctx (list '%mov '%rax src-reg))
       (if (not (= src-off 0)) (%c99-lower-emit! ctx (list '%add '%rax src-off)))
       (%c99-lower-emit! ctx (list '%store '%rsp src-si '%rax))
       (%c99-lower-emit! ctx (list '%load '%r8 '%rsp dst-si))
       (%c99-lower-emit! ctx (list '%load '%r9 '%rsp src-si))
       (%c99-lower-emit! ctx (list '%mov '%r10 qwords))
       (%c99-lower-emit! ctx (list '%label loop-lbl))
       (%c99-lower-emit! ctx '(%cmp %r10 0))
       (%c99-lower-emit! ctx (list '%jump-cond 'je done-lbl))
       (%c99-lower-emit! ctx '(%load %rax %r9 0))
       (%c99-lower-emit! ctx '(%store %r8 0 %rax))
       (%c99-lower-emit! ctx '(%add %r9 8))
       (%c99-lower-emit! ctx '(%add %r8 8))
       (%c99-lower-emit! ctx '(%sub %r10 1))
       (%c99-lower-emit! ctx (list '%direct-jump loop-lbl))
       (%c99-lower-emit! ctx (list '%label done-lbl))
       (%c99-lower-memcpy-regs! ctx '%r8 0 '%r9 0 rem)))
    (else
     (let loop ((k 0) (rem sz))
       (cond
         ((>= rem 8)
          (%c99-lower-emit! ctx (list '%load '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store dst-reg (+ dst-off k) '%rax))
          (loop (+ k 8) (- rem 8)))
         ((>= rem 4)
          (%c99-lower-emit! ctx (list '%load-typed 'u32 '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 dst-reg (+ dst-off k) '%rax))
          (loop (+ k 4) (- rem 4)))
         ((>= rem 2)
          (%c99-lower-emit! ctx (list '%load-typed 'u16 '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store-typed 'u16 dst-reg (+ dst-off k) '%rax))
          (loop (+ k 2) (- rem 2)))
         ((>= rem 1)
          (%c99-lower-emit! ctx (list '%load-typed 'u8 '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store-typed 'u8 dst-reg (+ dst-off k) '%rax))
          (loop (+ k 1) (- rem 1))))))))

;; Load 1..8 bytes from [base-reg + base-off] into dst-gpr (exact byte count, never OOB).
(define (%c99-lower-load-chunk-gpr! ctx dst-reg base-reg base-off csz)
  (cond
    ((= csz 8) (%c99-lower-emit! ctx (list '%load dst-reg base-reg base-off)))
    ((= csz 4) (%c99-lower-emit! ctx (list '%load-typed 'u32 dst-reg base-reg base-off)))
    ((= csz 2) (%c99-lower-emit! ctx (list '%load-typed 'u16 dst-reg base-reg base-off)))
    ((= csz 1) (%c99-lower-emit! ctx (list '%load-typed 'u8 dst-reg base-reg base-off)))
    (else
     (let ((safe-base (if (or (eq? base-reg dst-reg) (eq? base-reg '%rax) (eq? base-reg '%r10))
                          (begin
                            (%c99-lower-emit! ctx (list '%mov '%r11 base-reg))
                            '%r11)
                          base-reg)))
       (%c99-lower-emit! ctx '(%mov %rax 0))
       (let loop ((k (- csz 1)))
         (if (>= k 0)
             (begin
               (if (< k (- csz 1))
                   (%c99-lower-emit! ctx '(%shl %rax 8)))
               (%c99-lower-emit! ctx (list '%load-typed 'u8 '%r10 safe-base (+ base-off k)))
               (%c99-lower-emit! ctx '(%bit-or %rax %r10))
               (loop (- k 1)))))
       (if (not (eq? dst-reg '%rax))
           (%c99-lower-emit! ctx (list '%mov dst-reg '%rax)))))))

;; Store 1..8 bytes from src-gpr into [base-reg + base-off] (never OOB). Clobbers %rax, %r11.
(define (%c99-lower-store-chunk-gpr! ctx base-reg base-off src-reg csz)
  (cond
    ((= csz 8) (%c99-lower-emit! ctx (list '%store base-reg base-off src-reg)))
    ((= csz 4) (%c99-lower-emit! ctx (list '%store-typed 'u32 base-reg base-off src-reg)))
    ((= csz 2) (%c99-lower-emit! ctx (list '%store-typed 'u16 base-reg base-off src-reg)))
    ((= csz 1) (%c99-lower-emit! ctx (list '%store-typed 'u8 base-reg base-off src-reg)))
    (else
     (let ((safe-base (if (eq? base-reg '%rax)
                          (begin
                            (%c99-lower-emit! ctx '(%mov %r11 %rax))
                            '%r11)
                          base-reg)))
       (if (not (eq? src-reg '%rax))
           (%c99-lower-emit! ctx (list '%mov '%rax src-reg)))
       (let loop ((k 0))
         (if (< k csz)
             (begin
               (%c99-lower-emit! ctx (list '%store-typed 'u8 safe-base (+ base-off k) '%rax))
               (if (< (+ k 1) csz)
                   (%c99-lower-emit! ctx '(%shr %rax 8)))
               (loop (+ k 1)))))))))

(define (%c99-lower-extract-const-int typed-expr)
  (let ((inner (c-typed-inner typed-expr)))
    (cond
      ((and (pair? inner) (eq? (car inner) 'c-const-val) (integer? (cadr inner)))
       (cadr inner))
      ((and (pair? inner) (eq? (car inner) 'c-enum-const))
       (cadr inner))
      ((and (pair? inner) (eq? (car inner) 'c-implicit-cast))
       (%c99-lower-extract-const-int (caddr inner)))
      (else #f))))

(define (%c99-lower-emit-var-shift! ctx shift-op mask-64?)
  (if (not mask-64?)
      (begin
        (%c99-lower-emit! ctx '(%bit-and %rcx 31))
        (cond
          ((eq? shift-op '%shr) (%c99-lower-emit! ctx '(%zext u32 %rax %rax)))
          ((eq? shift-op '%sar) (%c99-lower-emit! ctx '(%sext i32 %rax %rax))))))
  (%c99-lower-emit! ctx (list shift-op '%rax '%rcx)))

;;; -----------------------------------------------------------------------
;;; 4. Address & Target Computation (Single-Evaluation Lvalues)
;;; -----------------------------------------------------------------------

;;; Bounds & NULL-Pointer Sanitizer Helpers (Issue #930)
(define (%c99-san-sanitize-filename str)
  (let* ((s (if (string? str) str "<unknown>"))
         (n (string-length s)))
    (let loop ((i 0) (acc '()))
      (if (>= i n)
          (list->string (reverse acc))
          (let* ((ch (string-ref s i))
                 (code (char->integer ch))
                 (clean (if (or (< code 32) (= code 127)) #\_ ch)))
            (loop (+ i 1) (cons clean acc)))))))

(define (%c99-san-format-loc sp)
  (if (source-span? sp)
      (string-append (%c99-san-sanitize-filename (span-file sp))
                     ":" (number->string (span-start-line sp))
                     ":" (number->string (span-start-col sp)))
      "<unknown>:0:0"))

(define (%c99-san-emit-cold! ctx inst)
  (lower-ctx-cold-insts-set! ctx (cons inst (lower-ctx-cold-insts ctx))))

(define (%c99-san-emit-insts! ctx insts)
  (for-each (lambda (inst) (%c99-lower-emit! ctx inst)) insts))

(define (%c99-san-emit-trap-block! ctx check-id detail sp)
  (lower-ctx-needs-san-trap?-set! ctx #t)
  (let* ((msg (mem-check-format-san-msg check-id detail (%c99-san-format-loc sp)))
         (msg-len (string-length msg))
         (msg-lbl (%c99-lower-intern-str! ctx msg))
         (trap-lbl (%c99-lower-new-label ctx "san_trap")))
    (%c99-san-emit-cold! ctx (list '%label trap-lbl))
    (%c99-san-emit-cold! ctx (list '%str-ref '%rdi msg-lbl))
    (%c99-san-emit-cold! ctx '(%sub %rdi 3))
    (%c99-san-emit-cold! ctx (list '%mov '%rsi msg-len))
    (%c99-san-emit-cold! ctx '(%direct-call __ulisp_san_trap 0))
    (%c99-san-emit-cold! ctx '(%return))
    trap-lbl))

(define (%c99-san-emit-null-check! ctx ptr-reg sp detail)
  (if (lower-ctx-sanitize-bounds? ctx)
      (let ((trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:null-pointer detail sp)))
        (%c99-san-emit-insts! ctx (mem-check-emit-null-lir 'mem-check:null-pointer ptr-reg trap-lbl)))))

(define (%c99-san-emit-bounds-check! ctx idx-reg arr-len one-past-end? sp)
  (if (and (lower-ctx-sanitize-bounds? ctx)
           (integer? arr-len)
           (> arr-len 0))
      (let* ((detail (string-append "array index out of bounds (length "
                                    (number->string arr-len) ")"))
             (trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:static-array-bounds detail sp)))
        (%c99-san-emit-insts! ctx
          (mem-check-emit-bounds-lir 'mem-check:static-array-bounds idx-reg arr-len one-past-end? trap-lbl)))))

(define (%c99-san-store-i64-slot! ctx si val)
  (%c99-lower-emit! ctx (list '%mov '%r10 val))
  (%c99-lower-emit! ctx (list '%store '%rsp si '%r10)))

(define (%c99-san-alloc-ptr-meta! ctx u-sym)
  (let ((existing (assq u-sym (lower-ctx-san-ptr-meta ctx))))
    (if existing
        (cdr existing)
        (let* ((prov-si (%c99-lower-alloc-slot! ctx))
               (cap-si (%c99-lower-alloc-slot! ctx))
               (freed-si (%c99-lower-alloc-slot! ctx))
               (meta (list prov-si cap-si freed-si)))
          (lower-ctx-san-ptr-meta-set! ctx (cons (cons u-sym meta) (lower-ctx-san-ptr-meta ctx)))
          meta))))

(define (%c99-san-init-ptr-meta-unknown! ctx u-sym)
  (let* ((meta (%c99-san-alloc-ptr-meta! ctx u-sym))
         (prov-si (list-ref meta 0))
         (cap-si (list-ref meta 1))
         (freed-si (list-ref meta 2)))
    (%c99-san-store-i64-slot! ctx prov-si 0)
    (%c99-san-store-i64-slot! ctx cap-si -1)
    (%c99-san-store-i64-slot! ctx freed-si 0)))

(define (%c99-san-unwrap-casts node)
  (let loop ((cur node))
    (if (not (c-typed? cur))
        cur
        (let ((in (c-typed-inner cur)))
          (if (and (pair? in) (memq (car in) '(c-cast c-implicit-cast)))
              (loop (caddr in))
              cur)))))

(define (%c99-san-unwrap-ptr-var node)
  (let ((cur (%c99-san-unwrap-casts node)))
    (if (c-typed? cur)
        (let ((in (c-typed-inner cur)))
          (if (and (pair? in) (eq? (car in) 'c-var-ref))
              (cadr in)
              #f))
        #f)))

(define (%c99-san-lookup-ptr-meta ctx node)
  (let ((u-sym (%c99-san-unwrap-ptr-var node)))
    (if u-sym
        (let ((ent (assq u-sym (lower-ctx-san-ptr-meta ctx))))
          (if ent (cdr ent) #f))
        #f)))

(define (%c99-san-tracked-ptr-expr? ctx node)
  (and (lower-ctx-sanitize-bounds? ctx)
       (%c99-san-lookup-ptr-meta ctx node)
       #t))

(define (%c99-san-static-str-len node)
  (let ((cur (%c99-san-unwrap-casts node)))
    (if (c-typed? cur)
        (let ((in (c-typed-inner cur)))
          (if (and (pair? in) (eq? (car in) 'c-str-val) (string? (cadr in)))
              (+ (string-length (cadr in)) 1)
              #f))
        #f)))

(define (%c99-san-classify-ptr-provenance ctx expr)
  (let ((imm0 (%c99-lower-extract-imm32 expr)))
    (if (and imm0 (= imm0 0))
        'null
        (let ((cur (%c99-san-unwrap-casts expr)))
          (if (not (c-typed? cur))
              'unknown
              (let ((in (c-typed-inner cur))
                    (cty (c-typed-type cur)))
                (case (car in)
                  ((c-call)
                   (let ((fsym (%c99-extract-direct-fn-sym (cadr in))))
                     (if (memq fsym '(malloc calloc realloc))
                         (list 'heap-alloc fsym)
                         'unknown)))
                  ((c-var-ref)
                   (cond
                     ((c-array-type? cty) 'stack)
                     ((assq (cadr in) (lower-ctx-san-ptr-meta ctx))
                      (list 'var-alias (cadr in)))
                     (else 'unknown)))
                  ((c-unop)
                   (if (eq? (cadr in) 'addr)
                       (let* ((tgt (%c99-san-unwrap-casts (caddr in)))
                              (tin (if (c-typed? tgt) (c-typed-inner tgt) '())))
                         (if (and (pair? tin) (eq? (car tin) 'c-index))
                             (let* ((base (cadr tin))
                                    (idx (caddr tin))
                                    (k (%c99-lower-extract-imm32 idx)))
                               (cond
                                 ((c-array-type? (c-typed-type base)) 'stack)
                                 ((and k (= k 0)) (%c99-san-classify-ptr-provenance ctx base))
                                 (else 'interior)))
                             'stack))
                       'unknown))
                  ((c-binop)
                   (let ((op (cadr in))
                         (lhs (caddr in))
                         (rhs (cadddr in)))
                     (if (memq op '(+ -))
                         (let ((lptr? (or (c-pointer-type? (c-typed-type lhs))
                                          (c-array-type? (c-typed-type lhs))))
                               (rptr? (and (eq? op '+)
                                           (or (c-pointer-type? (c-typed-type rhs))
                                               (c-array-type? (c-typed-type rhs))))))
                           (cond
                             (lptr?
                              (let ((k (%c99-lower-extract-imm32 rhs)))
                                (if (and k (= k 0))
                                    (%c99-san-classify-ptr-provenance ctx lhs)
                                    'interior)))
                             (rptr?
                              (let ((k (%c99-lower-extract-imm32 lhs)))
                                (if (and k (= k 0))
                                    (%c99-san-classify-ptr-provenance ctx rhs)
                                    'interior)))
                             (else 'unknown)))
                         'unknown)))
                  ((c-member)
                   (if (c-array-type? cty) 'interior 'unknown))
                  (else 'unknown))))))))

(define (%c99-san-update-ptr-var! ctx u-sym ty rhs-expr ptr-reg)
  (if (and (lower-ctx-sanitize-bounds? ctx)
           (c-pointer-type? ty))
      (let* ((meta (%c99-san-alloc-ptr-meta! ctx u-sym))
             (prov-si (list-ref meta 0))
             (cap-si (list-ref meta 1))
             (freed-si (list-ref meta 2))
             (cls (%c99-san-classify-ptr-provenance ctx rhs-expr)))
        (cond
          ((eq? cls 'null)
           (%c99-san-store-i64-slot! ctx prov-si 0)
           (%c99-san-store-i64-slot! ctx cap-si 0)
           (%c99-san-store-i64-slot! ctx freed-si 0))
          ((eq? cls 'stack)
           (%c99-san-store-i64-slot! ctx prov-si 2)
           (%c99-san-store-i64-slot! ctx cap-si -1)
           (%c99-san-store-i64-slot! ctx freed-si 0))
          ((eq? cls 'interior)
           (%c99-san-store-i64-slot! ctx prov-si 3)
           (%c99-san-store-i64-slot! ctx cap-si -1)
           (%c99-san-store-i64-slot! ctx freed-si 0))
          ((and (pair? cls) (eq? (car cls) 'var-alias))
           (let ((src-sym (cadr cls)))
             (if (not (eq? src-sym u-sym))
                 (let ((src-ent (assq src-sym (lower-ctx-san-ptr-meta ctx))))
                   (if src-ent
                       (let ((smeta (cdr src-ent)))
                         (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref smeta 0)))
                         (%c99-lower-emit! ctx (list '%store '%rsp prov-si '%r10))
                         (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref smeta 1)))
                         (%c99-lower-emit! ctx (list '%store '%rsp cap-si '%r10))
                         (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref smeta 2)))
                         (%c99-lower-emit! ctx (list '%store '%rsp freed-si '%r10)))
                       (begin
                         (%c99-san-store-i64-slot! ctx prov-si 0)
                         (%c99-san-store-i64-slot! ctx cap-si -1)
                         (%c99-san-store-i64-slot! ctx freed-si 0)))))))
          ((and (pair? cls) (eq? (car cls) 'heap-alloc))
           (let ((last-cap-si (lower-ctx-san-last-cap-si ctx))
                 (null-lbl (%c99-lower-new-label ctx "san_alloc_null"))
                 (done-lbl (%c99-lower-new-label ctx "san_alloc_done")))
             (%c99-lower-emit! ctx (list '%cmp ptr-reg 0))
             (%c99-lower-emit! ctx (list '%jump-cond 'je null-lbl))
             (%c99-san-store-i64-slot! ctx prov-si 1)
             (if last-cap-si
                 (begin
                   (%c99-lower-emit! ctx (list '%load '%r10 '%rsp last-cap-si))
                   (%c99-lower-emit! ctx (list '%store '%rsp cap-si '%r10)))
                 (%c99-san-store-i64-slot! ctx cap-si -1))
             (%c99-san-store-i64-slot! ctx freed-si 0)
             (%c99-lower-emit! ctx (list '%direct-jump done-lbl))
             (%c99-lower-emit! ctx (list '%label null-lbl))
             (%c99-san-store-i64-slot! ctx prov-si 0)
             (%c99-san-store-i64-slot! ctx cap-si 0)
             (%c99-san-store-i64-slot! ctx freed-si 0)
             (%c99-lower-emit! ctx (list '%label done-lbl))))
          (else
           (%c99-san-store-i64-slot! ctx prov-si 0)
           (%c99-san-store-i64-slot! ctx cap-si -1)
           (%c99-san-store-i64-slot! ctx freed-si 0))))))

(define (%c99-san-mark-ptr-mutated! ctx node)
  (if (lower-ctx-sanitize-bounds? ctx)
      (let ((meta (%c99-san-lookup-ptr-meta ctx node)))
        (if meta
            (begin
              (%c99-san-store-i64-slot! ctx (list-ref meta 0) 3)
              (%c99-san-store-i64-slot! ctx (list-ref meta 1) -1))))))

(define (%c99-san-check-ptr-var-uaf! ctx ptr-expr sp)
  (if (lower-ctx-sanitize-bounds? ctx)
      (let ((meta (%c99-san-lookup-ptr-meta ctx ptr-expr)))
        (if meta
            (let ((trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:use-after-free
                                                        "use of pointer after free" sp)))
              (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 2)))
              (%c99-san-emit-insts! ctx
                (mem-check-emit-flag-nz-lir 'mem-check:use-after-free '%r10 trap-lbl)))))))

(define (%c99-san-check-heap-min-bytes! ctx ptr-expr min-bytes sp)
  (if (and (lower-ctx-sanitize-bounds? ctx) (> min-bytes 0))
      (let ((meta (%c99-san-lookup-ptr-meta ctx ptr-expr)))
        (if meta
            (let ((skip-lbl (%c99-lower-new-label ctx "san_hb_skip"))
                  (trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:heap-bounds
                              "heap buffer dereference out of bounds" sp)))
              (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 0)))
              (%c99-lower-emit! ctx '(%cmp %r10 1))
              (%c99-lower-emit! ctx (list '%jump-cond 'jne skip-lbl))
              (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 1)))
              (%c99-lower-emit! ctx '(%cmp %r10 0))
              (%c99-lower-emit! ctx (list '%jump-cond 'jl skip-lbl))
              (%c99-lower-emit! ctx (list '%cmp '%r10 min-bytes))
              (%c99-lower-emit! ctx (list '%jump-cond 'jb trap-lbl))
              (%c99-lower-emit! ctx (list '%label skip-lbl)))))))

(define (%c99-san-check-heap-index! ctx arr-node idx-reg elem-sz one-past-end? sp)
  (if (and (lower-ctx-sanitize-bounds? ctx) (> elem-sz 0))
      (let ((meta (%c99-san-lookup-ptr-meta ctx arr-node)))
        (if meta
            (let ((skip-lbl (%c99-lower-new-label ctx "san_hi_skip"))
                  (trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:heap-bounds
                              (string-append "heap array index out of bounds (elem size "
                                             (number->string elem-sz) ")")
                              sp)))
              (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 0)))
              (%c99-lower-emit! ctx '(%cmp %r10 1))
              (%c99-lower-emit! ctx (list '%jump-cond 'jne skip-lbl))
              (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 1)))
              (%c99-lower-emit! ctx '(%cmp %r10 0))
              (%c99-lower-emit! ctx (list '%jump-cond 'jl skip-lbl))
              (if (not one-past-end?)
                  (begin
                    (%c99-lower-emit! ctx (list '%cmp '%r10 elem-sz))
                    (%c99-lower-emit! ctx (list '%jump-cond 'jb trap-lbl))))
              (%c99-san-emit-insts! ctx
                (mem-check-emit-bounds-lir 'mem-check:heap-bounds idx-reg '%r10 one-past-end? trap-lbl))
              (if (> elem-sz 1)
                  (begin
                    (%c99-lower-emit! ctx (list '%mov '%r11 idx-reg))
                    (%c99-lower-emit! ctx (list '%imul '%r11 elem-sz))
                    (if (not one-past-end?)
                        (%c99-lower-emit! ctx (list '%sub '%r10 elem-sz)))
                    (%c99-san-emit-insts! ctx
                      (mem-check-emit-bounds-lir 'mem-check:heap-bounds '%r11 '%r10 #t trap-lbl))))
              (%c99-lower-emit! ctx (list '%label skip-lbl)))))))

(define (%c99-san-emit-index-checks! ctx arr is-arr? check-bounds? idx-reg arr-len elem-sz one-past-end? sp)
  (if check-bounds?
      (%c99-san-emit-bounds-check! ctx idx-reg arr-len one-past-end? sp))
  (if (and (lower-ctx-sanitize-bounds? ctx) (not is-arr?))
      (%c99-san-check-heap-index! ctx arr idx-reg elem-sz one-past-end? sp)))

(define (%c99-san-validate-free-ptr! ctx ptr-arg sp caller-name)
  (let ((prov (%c99-san-classify-ptr-provenance ctx ptr-arg))
        (meta (%c99-san-lookup-ptr-meta ctx ptr-arg))
        (skip-lbl (%c99-lower-new-label ctx "san_free_null")))
    (%c99-lower-emit! ctx '(%cmp %rdi 0))
    (%c99-lower-emit! ctx (list '%jump-cond 'je skip-lbl))
    (cond
      ((memq prov '(stack interior))
       (let ((trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:invalid-free
                                                   (string-append "free of " (symbol->string prov)
                                                                  " pointer in " caller-name)
                                                   sp)))
         (%c99-san-emit-insts! ctx
           (mem-check-emit-unconditional-trap-lir 'mem-check:invalid-free trap-lbl))))
      (meta
       (let ((df-lbl (%c99-san-emit-trap-block! ctx 'mem-check:double-free
                                                 (string-append "double free in " caller-name)
                                                 sp))
             (inv-lbl (%c99-san-emit-trap-block! ctx 'mem-check:invalid-free
                                                  (string-append "non-heap pointer in " caller-name)
                                                  sp)))
         (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 2)))
         (%c99-san-emit-insts! ctx
           (mem-check-emit-flag-nz-lir 'mem-check:double-free '%r10 df-lbl))
         (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 0)))
         (%c99-lower-emit! ctx '(%cmp %r10 2))
         (%c99-lower-emit! ctx (list '%jump-cond 'jge inv-lbl))
         (%c99-san-store-i64-slot! ctx (list-ref meta 2) 1))))
    (%c99-lower-emit! ctx (list '%label skip-lbl))))

(define (%c99-san-check-heap-write-bytes! ctx dst-arg need-bytes-op sp detail)
  (let ((meta (%c99-san-lookup-ptr-meta ctx dst-arg)))
    (if meta
        (let ((skip-lbl (%c99-lower-new-label ctx "san_hw_skip"))
              (trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:heap-bounds detail sp)))
          (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 0)))
          (%c99-lower-emit! ctx '(%cmp %r10 1))
          (%c99-lower-emit! ctx (list '%jump-cond 'jne skip-lbl))
          (%c99-lower-emit! ctx (list '%load '%r10 '%rsp (list-ref meta 1)))
          (%c99-lower-emit! ctx '(%cmp %r10 0))
          (%c99-lower-emit! ctx (list '%jump-cond 'jl skip-lbl))
          (if (integer? need-bytes-op)
              (begin
                (%c99-lower-emit! ctx (list '%mov '%r11 need-bytes-op))
                (%c99-san-emit-insts! ctx
                  (mem-check-emit-bounds-lir 'mem-check:heap-bounds '%r11 '%r10 #t trap-lbl)))
              (%c99-san-emit-insts! ctx
                (mem-check-emit-bounds-lir 'mem-check:heap-bounds need-bytes-op '%r10 #t trap-lbl)))
          (%c99-lower-emit! ctx (list '%label skip-lbl))))))

(define (%c99-san-check-call! ctx fn-sym arg-nodes sp)
  (if (and fn-sym (lower-ctx-sanitize-bounds? ctx))
      (let ((last-cap-si (lower-ctx-san-last-cap-si ctx))
            (nargs (length arg-nodes)))
        (case fn-sym
          ((malloc)
           (if (and last-cap-si (>= nargs 1))
               (%c99-lower-emit! ctx (list '%store '%rsp last-cap-si '%rdi))))
          ((calloc)
           (if (and last-cap-si (>= nargs 2))
               (begin
                 (%c99-lower-emit! ctx '(%mov %r10 %rdi))
                 (%c99-lower-emit! ctx '(%imul %r10 %rsi))
                 (%c99-lower-emit! ctx (list '%store '%rsp last-cap-si '%r10)))))
          ((realloc)
           (if (>= nargs 2)
               (begin
                 (if last-cap-si
                     (%c99-lower-emit! ctx (list '%store '%rsp last-cap-si '%rsi)))
                 (%c99-san-validate-free-ptr! ctx (car arg-nodes) sp "realloc"))))
          ((free)
           (if (>= nargs 1)
               (%c99-san-validate-free-ptr! ctx (car arg-nodes) sp "free")))
          ((strlen)
           (if (>= nargs 1)
               (begin
                 (%c99-san-emit-null-check! ctx '%rdi sp "NULL pointer passed to strlen")
                 (%c99-san-check-ptr-var-uaf! ctx (car arg-nodes) sp))))
          ((strcmp)
           (if (>= nargs 2)
               (begin
                 (%c99-san-emit-null-check! ctx '%rdi sp "NULL pointer passed to strcmp")
                 (%c99-san-emit-null-check! ctx '%rsi sp "NULL pointer passed to strcmp")
                 (%c99-san-check-ptr-var-uaf! ctx (car arg-nodes) sp)
                 (%c99-san-check-ptr-var-uaf! ctx (cadr arg-nodes) sp))))
          ((strcpy)
           (if (>= nargs 2)
               (let* ((dst (car arg-nodes))
                      (src (cadr arg-nodes))
                      (needed (%c99-san-static-str-len src))
                      (dst-ty (c-typed-type dst)))
                 (%c99-san-emit-null-check! ctx '%rdi sp "NULL destination passed to strcpy")
                 (%c99-san-emit-null-check! ctx '%rsi sp "NULL source passed to strcpy")
                 (%c99-san-check-ptr-var-uaf! ctx dst sp)
                 (%c99-san-check-ptr-var-uaf! ctx src sp)
                 (if needed
                     (cond
                       ((and (c-array-type? dst-ty)
                             (integer? (c-array-length dst-ty))
                             (> (c-array-length dst-ty) 0))
                        (if (> needed (c-array-length dst-ty))
                            (let ((trap-lbl (%c99-san-emit-trap-block! ctx 'mem-check:static-array-bounds
                                                                        "strcpy stack buffer overflow" sp)))
                              (%c99-san-emit-insts! ctx
                                (mem-check-emit-unconditional-trap-lir 'mem-check:static-array-bounds trap-lbl)))))
                       (else
                        (%c99-san-check-heap-write-bytes! ctx dst needed sp "strcpy heap buffer overflow")))))))
          ((memcpy memmove)
           (if (>= nargs 3)
               (let ((skip-lbl (%c99-lower-new-label ctx "san_mem_zero")))
                 (%c99-lower-emit! ctx '(%cmp %rdx 0))
                 (%c99-lower-emit! ctx (list '%jump-cond 'je skip-lbl))
                 (%c99-san-emit-null-check! ctx '%rdi sp "NULL destination passed to memcpy/memmove")
                 (%c99-san-emit-null-check! ctx '%rsi sp "NULL source passed to memcpy/memmove")
                 (%c99-san-check-ptr-var-uaf! ctx (car arg-nodes) sp)
                 (%c99-san-check-ptr-var-uaf! ctx (cadr arg-nodes) sp)
                 (%c99-san-check-heap-write-bytes! ctx (car arg-nodes) '%rdx sp
                                                   "memcpy/memmove heap buffer overflow")
                 (%c99-lower-emit! ctx (list '%label skip-lbl)))))))))

(define (%c99-san-last-elem xs)
  (if (null? xs)
      #f
      (if (null? (cdr xs))
          (car xs)
          (%c99-san-last-elem (cdr xs)))))

(define (%c99-san-is-flexible-array-member? ctx arr-node)
  (let* ((arr-ty (c-typed-type arr-node))
         (len (c-array-length arr-ty)))
    (cond
      ((or (not (integer? len)) (<= len 0)) #t)
      ((> len 1) #f)
      (else
       (let ((in (c-typed-inner arr-node)))
         (if (not (and (pair? in) (eq? (car in) 'c-member)))
             #f
             (let* ((base (cadr in))
                    (fsym (caddr in))
                    (deref? (cadddr in))
                    (agg-ty (if deref?
                                (c-ptr-target (c99-array-decay (c-typed-type base)))
                                (c-typed-type base)))
                    (sl (c-type-layout-in (lower-ctx-layout-env ctx) agg-ty)))
               (if (and sl (eq? (c-struct-layout-kind sl) 'struct))
                   (let ((last-fl (%c99-san-last-elem (c-struct-layout-fields sl))))
                     (and last-fl (eq? (c-field-layout-name last-fl) fsym)))
                   #f))))))))

(define (%c99-lower-emit-var-addr! ctx var-entry dst-reg)
  (let ((kind (car var-entry))
        (loc (cadr var-entry)))
    (if (eq? kind 'local)
        (begin
          (%c99-lower-emit! ctx (list '%mov dst-reg '%rsp))
          (%c99-lower-emit! ctx (list '%add dst-reg loc)))
        (%c99-lower-emit! ctx (list '%global-addr dst-reg loc)))))

(define (%c99-lower-lvalue-addr! ctx lval-typed . maybe-one-past-end)
  (let* ((one-past-end? (if (and (pair? maybe-one-past-end) (car maybe-one-past-end)) #t #f))
         (sp (c-typed-span lval-typed))
         (inner (c-typed-inner lval-typed))
         (tag (car inner)))
    (case tag
      ((c-var-ref)
       (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
         (if (not ent)
             (error "Unbound variable in lvalue-addr" inner)
             (%c99-lower-emit-var-addr! ctx ent '%rax))))
      ((c-fn-ref)
       (%c99-lower-emit! ctx (list '%code-ref '%rax (%c99-lower-resolve-runtime-fn! ctx (cadr inner)))))
      ((c-unop)
       ;; deref: evaluate pointer expr directly
       (%c99-lower-expr! ctx (caddr inner))
       (if (and (eq? (cadr inner) 'deref)
                (not one-past-end?)
                (not (c-function-type? (c-typed-type lval-typed))))
           (begin
             (%c99-san-emit-null-check! ctx '%rax sp "NULL pointer dereference")
             (%c99-san-check-ptr-var-uaf! ctx (caddr inner) sp)
             (%c99-san-check-heap-min-bytes! ctx (caddr inner)
               (max 1 (%c99-lower-type-size ctx (c-typed-type lval-typed))) sp))))
      ((c-index)
       (let* ((arr (cadr inner))
              (idx (caddr inner))
              (arr-ty (c-typed-type arr))
              (is-arr? (c-array-type? arr-ty))
              (is-ptr? (c-pointer-type? arr-ty))
              (check-bounds? (and (lower-ctx-sanitize-bounds? ctx)
                                  is-arr?
                                  (not (%c99-san-is-flexible-array-member? ctx arr))))
              (arr-len (if check-bounds? (c-array-length arr-ty) #f))
              (check-ptr-null? (and is-ptr? (not one-past-end?)))
              (elem-sz (max 1 (%c99-lower-type-size ctx (c-typed-type lval-typed)))))
         (cond
           ((%c99-lower-extract-imm32 idx)
            => (lambda (k)
                 (let ((byte-off (* k elem-sz)))
                   (if is-arr?
                       (%c99-lower-lvalue-addr! ctx arr)
                       (begin
                         (%c99-lower-expr! ctx arr)
                         (if check-ptr-null?
                             (begin
                               (%c99-san-emit-null-check! ctx '%rax sp "NULL pointer subscript")
                               (%c99-san-check-ptr-var-uaf! ctx arr sp)))))
                   (if (or check-bounds?
                           (and (not is-arr?) (%c99-san-tracked-ptr-expr? ctx arr)))
                       (begin
                         (%c99-lower-emit! ctx (list '%mov '%rcx k))
                         (%c99-san-emit-index-checks! ctx arr is-arr? check-bounds? '%rcx arr-len elem-sz one-past-end? sp)))
                   (if (not (= byte-off 0))
                       (if (and (>= byte-off -2147483648) (<= byte-off 2147483647))
                           (%c99-lower-emit! ctx (list '%add '%rax byte-off))
                           (begin
                             (%c99-lower-emit-u64-const! ctx '%rcx (modulo byte-off 18446744073709551616))
                             (%c99-lower-emit! ctx '(%add %rax %rcx))))))))
           ((%c99-lower-direct-scalar-to-reg! ctx idx '%rcx '%rdx #f)
            (if is-arr?
                (%c99-lower-lvalue-addr! ctx arr)
                (begin
                  (%c99-lower-expr! ctx arr)
                  (if check-ptr-null?
                      (begin
                        (%c99-san-emit-null-check! ctx '%rax sp "NULL pointer subscript")
                        (%c99-san-check-ptr-var-uaf! ctx arr sp)))))
            (%c99-lower-direct-scalar-to-reg! ctx idx '%rcx '%rdx #t)
            (%c99-san-emit-index-checks! ctx arr is-arr? check-bounds? '%rcx arr-len elem-sz one-past-end? sp)
            (if (> elem-sz 1)
                (if (and (>= elem-sz -2147483648) (<= elem-sz 2147483647))
                    (%c99-lower-emit! ctx (list '%imul '%rcx elem-sz))
                    (begin
                      (%c99-lower-emit-u64-const! ctx '%rdx (modulo elem-sz 18446744073709551616))
                      (%c99-lower-emit! ctx '(%imul %rcx %rdx)))))
            (%c99-lower-emit! ctx '(%add %rax %rcx)))
           ((and (%c99-expr-preserves-temp-regs? ctx idx)
                 (pair? (lower-ctx-gpr-temps ctx)))
            (let* ((saved-gpr (lower-ctx-gpr-temps ctx))
                   (base-reg (%c99-lower-alloc-gpr-temp! ctx)))
              (if is-arr?
                  (%c99-lower-lvalue-addr! ctx arr)
                  (begin
                    (%c99-lower-expr! ctx arr)
                    (if check-ptr-null?
                        (begin
                          (%c99-san-emit-null-check! ctx '%rax sp "NULL pointer subscript")
                          (%c99-san-check-ptr-var-uaf! ctx arr sp)))))
              (%c99-lower-emit! ctx (list '%mov base-reg '%rax))
              (%c99-lower-expr! ctx idx)
              (%c99-san-emit-index-checks! ctx arr is-arr? check-bounds? '%rax arr-len elem-sz one-past-end? sp)
              (if (> elem-sz 1)
                  (%c99-lower-emit! ctx (list '%imul '%rax elem-sz)))
              (%c99-lower-emit! ctx (list '%add '%rax base-reg))
              (lower-ctx-gpr-temps-set! ctx saved-gpr)))
           (else
            (let ((base-si (%c99-lower-alloc-slot! ctx)))
              (if is-arr?
                  (%c99-lower-lvalue-addr! ctx arr)
                  (begin
                    (%c99-lower-expr! ctx arr)
                    (if check-ptr-null?
                        (begin
                          (%c99-san-emit-null-check! ctx '%rax sp "NULL pointer subscript")
                          (%c99-san-check-ptr-var-uaf! ctx arr sp)))))
              (%c99-lower-emit! ctx (list '%store '%rsp base-si '%rax))
              (%c99-lower-expr! ctx idx)
              (%c99-san-emit-index-checks! ctx arr is-arr? check-bounds? '%rax arr-len elem-sz one-past-end? sp)
              (if (> elem-sz 1)
                  (%c99-lower-emit! ctx (list '%imul '%rax elem-sz)))
              (%c99-lower-emit! ctx (list '%load '%rcx '%rsp base-si))
              (%c99-lower-emit! ctx '(%add %rax %rcx)))))))
      ((c-member)
       (let* ((base (cadr inner))
              (deref? (cadddr inner))
              (fl (%c99-lower-member-field-layout ctx inner))
              (off (c-field-layout-offset fl)))
         (if deref?
             (begin
               (%c99-lower-expr! ctx base)
               (if (not one-past-end?)
                   (begin
                     (%c99-san-emit-null-check! ctx '%rax sp "NULL pointer member access")
                     (%c99-san-check-ptr-var-uaf! ctx base sp)
                     (if (and (lower-ctx-sanitize-bounds? ctx)
                              (not (c-array-type? (c-typed-type lval-typed)))
                              (not (%c99-san-is-flexible-array-member? ctx lval-typed)))
                         (%c99-san-check-heap-min-bytes! ctx base
                           (+ off (max 1 (%c99-lower-type-size ctx (c-typed-type lval-typed)))) sp)))))
             (if (%c99-lower-lvalue-has-addr? base)
                 (%c99-lower-lvalue-addr! ctx base)
                 ;; Rvalue aggregate expression (e.g. make_pt().x): materialize into scratch slot
                 (let* ((bsz (%c99-lower-type-size ctx (c-typed-type base)))
                        (bal (%c99-lower-type-align ctx (c-typed-type base)))
                        (slot-si (%c99-lower-alloc-bytes! ctx bsz bal)))
                   (%c99-lower-expr-to-stack-slot! ctx base slot-si)
                   (%c99-lower-emit! ctx '(%mov %rax %rsp))
                   (%c99-lower-emit! ctx (list '%add '%rax slot-si)))))
         (if (not (= off 0))
             (%c99-lower-emit! ctx (list '%add '%rax off)))))
      ((c-compound-lit)
       (let* ((ty (cadr inner))
              (plan (caddr inner))
              (sz (%c99-lower-type-size ctx ty))
              (al (%c99-lower-type-align ctx ty))
              (slot-si (%c99-lower-alloc-bytes! ctx sz al)))
         (%c99-lower-expr-to-stack-slot! ctx plan slot-si)
         (%c99-lower-emit! ctx '(%mov %rax %rsp))
         (%c99-lower-emit! ctx (list '%add '%rax slot-si))))
      ((c-implicit-cast c-cast)
       (let ((sub (caddr inner)))
         (if (%c99-lower-lvalue-has-addr? sub)
             (%c99-lower-lvalue-addr! ctx sub)
             (%c99-lower-expr! ctx lval-typed))))
      (else
       (%c99-lower-expr! ctx lval-typed)))))

(define (%c99-lower-lvalue-has-addr? typed-expr)
  (let ((tag (car (c-typed-inner typed-expr))))
    (memq tag '(c-var-ref c-index c-member c-compound-lit c-fn-ref c-unop))))

;; Captures evaluation of an lvalue's location ONCE (returns '(var ent) | '(bf ptr-si fl) | '(addr ptr-si) | '(addr-reg reg))
(define (%c99-lower-capture-lvalue-target-for-rhs! ctx lval-typed rhs-preserves-temps?)
  (let ((inner (c-typed-inner lval-typed)))
    (cond
      ((eq? (car inner) 'c-var-ref)
       (list 'var (%c99-lower-lookup-var ctx (cadr inner))))
      ((eq? (car inner) 'c-member)
       (let ((fl (%c99-lower-member-field-layout ctx inner)))
         (if (c-field-layout-bit-width fl)
             (let ((ptr-si (%c99-lower-alloc-slot! ctx))
                   (base (cadr inner))
                   (deref? (cadddr inner)))
               (if deref?
                   (begin
                     (%c99-lower-expr! ctx base)
                     (%c99-san-emit-null-check! ctx '%rax (c-typed-span lval-typed) "NULL pointer bitfield access")
                     (%c99-san-check-ptr-var-uaf! ctx base (c-typed-span lval-typed)))
                   (%c99-lower-lvalue-addr! ctx base))
               (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
               (list 'bf ptr-si fl))
             (begin
               (%c99-lower-lvalue-addr! ctx lval-typed)
               (if (and rhs-preserves-temps?
                        (pair? (lower-ctx-gpr-temps ctx)))
                   (let ((reg (%c99-lower-alloc-gpr-temp! ctx)))
                     (%c99-lower-emit! ctx (list '%mov reg '%rax))
                     (list 'addr-reg reg))
                   (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
                     (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
                     (list 'addr ptr-si)))))))
      (else
       (%c99-lower-lvalue-addr! ctx lval-typed)
       (if (and rhs-preserves-temps?
                (pair? (lower-ctx-gpr-temps ctx)))
           (let ((reg (%c99-lower-alloc-gpr-temp! ctx)))
             (%c99-lower-emit! ctx (list '%mov reg '%rax))
             (list 'addr-reg reg))
           (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
             (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
             (list 'addr ptr-si)))))))

(define (%c99-lower-capture-lvalue-target! ctx lval-typed)
  (%c99-lower-capture-lvalue-target-for-rhs! ctx lval-typed #f))

(define (%c99-lower-load-from-target! ctx target ty)
  (case (car target)
    ((var) (%c99-lower-load-var! ctx (cadr target)))
    ((bf)
     (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
     (%c99-lower-load-bitfield! ctx '%rdx 0 (caddr target)))
    ((addr-reg)
     (%c99-lower-load-from-mem! ctx (if (c-float-type? ty) '%xmm0 '%rax) (cadr target) 0 ty))
    ((addr)
     (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
     (%c99-lower-load-from-mem! ctx (if (c-float-type? ty) '%xmm0 '%rax) '%rdx 0 ty))))

(define (%c99-lower-store-to-target! ctx target ty)
  (case (car target)
    ((var) (%c99-lower-store-var! ctx (cadr target)))
    ((bf)  (%c99-lower-store-bitfield-rax! ctx (cadr target) (caddr target)))
    ((addr-reg)
     (if (c-float-type? ty)
         (%c99-lower-emit! ctx (list '%store-typed ty (cadr target) 0 '%xmm0))
         (begin
           (%c99-lower-emit-cast! ctx ty)
           (%c99-lower-store-to-mem! ctx (cadr target) 0 '%rax ty))))
    ((addr)
     (if (c-float-type? ty)
         (begin
           (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
           (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0)))
         (begin
           (%c99-lower-emit-cast! ctx ty)
           (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
           (%c99-lower-store-to-mem! ctx '%rdx 0 '%rax ty))))))

;;; -----------------------------------------------------------------------
;;; 5. Scalar Load / Store, Expressions & Aggregate Materialization
;;; -----------------------------------------------------------------------

(define (%c99-lower-load-var! ctx var-entry)
  (let* ((kind (car var-entry))
         (loc (cadr var-entry))
         (ty (caddr var-entry))
         (dst (if (c-float-type? ty) '%xmm0 '%rax)))
    (if (eq? kind 'local)
        (%c99-lower-load-from-mem! ctx dst '%rsp loc ty)
        (begin
          (%c99-lower-emit! ctx (list '%global-addr '%rdx loc))
          (%c99-lower-load-from-mem! ctx dst '%rdx 0 ty)))))

(define (%c99-lower-store-var! ctx var-entry)
  (let ((kind (car var-entry))
        (loc (cadr var-entry))
        (ty (caddr var-entry)))
    (if (c-float-type? ty)
        (if (eq? kind 'local)
            (%c99-lower-emit! ctx (list '%store-typed ty '%rsp loc '%xmm0))
            (begin
              (%c99-lower-emit! ctx (list '%global-addr '%rdx loc))
              (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0))))
        (begin
          (%c99-lower-emit-cast! ctx ty)
          (if (eq? kind 'local)
              (%c99-lower-store-to-mem! ctx '%rsp loc '%rax ty)
              (begin
                (%c99-lower-emit! ctx (list '%global-addr '%rdx loc))
                (%c99-lower-store-to-mem! ctx '%rdx 0 '%rax ty)))))))

(define (%c99-lower-init-plan-to-slot! ctx plan base-si)
  (let* ((inner (c-typed-inner plan))
         (target-ty (cadr inner))
         (entries (caddr inner))
         (total-sz (%c99-lower-type-size ctx target-ty)))
    (%c99-lower-memzero! ctx '%rsp base-si total-sz)
    (for-each
     (lambda (ent)
       (if (eq? (car ent) 'zero-range)
           (%c99-lower-memzero! ctx '%rsp (+ base-si (cadr ent)) (caddr ent))
           (let* ((byte-off (list-ref ent 1))
                  (bit-off  (list-ref ent 2))
                  (bit-w    (list-ref ent 3))
                  (su-off   (list-ref ent 4))
                  (su-ty    (list-ref ent 5))
                  (fty      (list-ref ent 6))
                  (val-expr (list-ref ent 7)))
             (cond
               (bit-w
                (let ((base-ptr-si (%c99-lower-alloc-slot! ctx))
                      (fl (%make-c-field-layout #f fty byte-off bit-off bit-w su-off su-ty #f)))
                  (%c99-lower-emit! ctx '(%mov %rax %rsp))
                  (%c99-lower-emit! ctx (list '%add '%rax base-si))
                  (%c99-lower-emit! ctx (list '%store '%rsp base-ptr-si '%rax))
                  (%c99-lower-expr! ctx val-expr)
                  (%c99-lower-store-bitfield-rax! ctx base-ptr-si fl)))
               ((%c99-lower-aggregate-like? fty)
                (%c99-lower-expr-to-stack-slot! ctx val-expr (+ base-si byte-off)))
               (else
                (%c99-lower-expr! ctx val-expr)
                (if (c-float-type? fty)
                    (%c99-lower-emit! ctx (list '%store-typed fty '%rsp (+ base-si byte-off) '%xmm0))
                    (begin
                      (%c99-lower-emit-cast! ctx fty)
                      (%c99-lower-store-to-mem! ctx '%rsp (+ base-si byte-off) '%rax fty))))))))
     entries)))

(define (%c99-lower-expr-to-ptr-slot! ctx node dst-ptr-si)
  (let* ((ty (c-typed-type node))
         (inner (c-typed-inner node))
         (tag (car inner))
         (sz (%c99-lower-type-size ctx ty)))
    (cond
      ((eq? tag 'c-init-plan)
       (let* ((al (%c99-lower-type-align ctx ty))
              (tmp-si (%c99-lower-alloc-bytes! ctx sz al)))
         (%c99-lower-init-plan-to-slot! ctx node tmp-si)
         (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
         (%c99-lower-memcpy-regs! ctx '%rdx 0 '%rsp tmp-si sz)))
      ((eq? tag 'c-compound-lit)
       (%c99-lower-expr-to-ptr-slot! ctx (caddr inner) dst-ptr-si))
      ((eq? tag 'c-call)
       (%c99-lower-call! ctx inner ty dst-ptr-si (c-typed-span node)))
      ((eq? tag 'c-va-arg)
       (%c99-lower-va-arg! ctx inner ty dst-ptr-si))
      ((eq? tag 'c-assign)
       (let ((lhs (caddr inner))
             (rhs (cadddr inner)))
         (%c99-lower-expr-to-ptr-slot! ctx rhs dst-ptr-si)
         (%c99-lower-lvalue-addr! ctx lhs)
         (%c99-lower-emit! ctx '(%mov %rdx %rax))
         (%c99-lower-emit! ctx (list '%load '%rcx '%rsp dst-ptr-si))
         (%c99-lower-memcpy-regs! ctx '%rdx 0 '%rcx 0 sz)))
      ((eq? tag 'c-ternary)
       (let ((e-lbl (%c99-lower-new-label ctx "ater_e"))
             (d-lbl (%c99-lower-new-label ctx "ater_d")))
         (%c99-lower-eval-cond! ctx (cadr inner))
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'je e-lbl))
         (%c99-lower-expr-to-ptr-slot! ctx (caddr inner) dst-ptr-si)
         (%c99-lower-emit! ctx (list '%direct-jump d-lbl))
         (%c99-lower-emit! ctx (list '%label e-lbl))
         (%c99-lower-expr-to-ptr-slot! ctx (cadddr inner) dst-ptr-si)
         (%c99-lower-emit! ctx (list '%label d-lbl))))
      ((eq? tag 'c-implicit-cast)
       (if (%c99-lower-aggregate-like? (c-typed-type (caddr inner)))
           (%c99-lower-expr-to-ptr-slot! ctx (caddr inner) dst-ptr-si)
           (begin
             (%c99-lower-expr! ctx node)
             (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
             (%c99-lower-store-to-mem! ctx '%rdx 0 (if (c-float-type? ty) '%xmm0 '%rax) ty))))
      ((%c99-lower-lvalue-has-addr? node)
       (%c99-lower-lvalue-addr! ctx node)
       (%c99-lower-emit! ctx '(%mov %rcx %rax))
       (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
       (%c99-lower-memcpy-regs! ctx '%rdx 0 '%rcx 0 sz))
      (else
       (%c99-lower-expr! ctx node)
       (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
       (%c99-lower-store-to-mem! ctx '%rdx 0 (if (c-float-type? ty) '%xmm0 '%rax) ty)))))

(define (%c99-lower-expr-to-stack-slot! ctx node dst-si)
  (let ((inner (c-typed-inner node)))
    (cond
      ((eq? (car inner) 'c-init-plan)
       (%c99-lower-init-plan-to-slot! ctx node dst-si))
      ((eq? (car inner) 'c-compound-lit)
       (%c99-lower-init-plan-to-slot! ctx (caddr inner) dst-si))
      (else
       (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
         (%c99-lower-emit! ctx '(%mov %rax %rsp))
         (%c99-lower-emit! ctx (list '%add '%rax dst-si))
         (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
         (%c99-lower-expr-to-ptr-slot! ctx node ptr-si))))))

(define (%c99-lower-emit-cmp-opnd! ctx cmp-op unsigned? opnd)
  (let ((cc (case cmp-op
              ((==) 'je)
              ((!=) 'jne)
              ((<)  (if unsigned? 'jb 'jl))
              ((<=) (if unsigned? 'jbe 'jle))
              ((>)  (if unsigned? 'ja 'jg))
              ((>=) (if unsigned? 'jae 'jge))))
        (t-lbl (%c99-lower-new-label ctx "cmp_t"))
        (end-lbl (%c99-lower-new-label ctx "cmp_e")))
    (%c99-lower-emit! ctx (list '%cmp '%rax opnd))
    (%c99-lower-emit! ctx (list '%jump-cond cc t-lbl))
    (%c99-lower-emit! ctx '(%mov %rax 0))
    (%c99-lower-emit! ctx (list '%direct-jump end-lbl))
    (%c99-lower-emit! ctx (list '%label t-lbl))
    (%c99-lower-emit! ctx '(%mov %rax 1))
    (%c99-lower-emit! ctx (list '%label end-lbl))))

(define (%c99-lower-emit-cmp! ctx cmp-op unsigned?)
  (%c99-lower-emit-cmp-opnd! ctx cmp-op unsigned? '%rcx))

(define (%c99-lower-emit-binop-imm! ctx op res-ty lhs-ty imm)
  (let ((unsigned? (or (c-unsigned-type? lhs-ty) (c-pointer-type? lhs-ty))))
    (case op
      ((+)       (%c99-lower-emit! ctx (list '%add '%rax imm)))
      ((-)       (%c99-lower-emit! ctx (list '%sub '%rax imm)))
      ((*)       (%c99-lower-emit! ctx (list '%imul '%rax imm)))
      ((bit-and) (%c99-lower-emit! ctx (list '%bit-and '%rax imm)))
      ((bit-or)  (%c99-lower-emit! ctx (list '%bit-or '%rax imm)))
      ((bit-xor) (%c99-lower-emit! ctx (list '%bit-xor '%rax imm)))
      ((== != < <= > >=)
       (%c99-lower-emit-cmp-opnd! ctx op unsigned? imm)))
    (if (not (memq op '(== != < <= > >=)))
        (%c99-lower-emit-cast! ctx res-ty))))

(define (%c99-lower-emit-ptr-binop! ctx op lt rt)
  (cond
    ((and (c-pointer-type? lt) (c-pointer-type? rt) (eq? op '-))
     (let ((psz (max 1 (%c99-lower-type-size ctx (c-ptr-target lt)))))
       (%c99-lower-emit! ctx '(%sub %rax %rcx))
       (if (> psz 1)
           (begin
             (%c99-lower-emit! ctx (list '%mov '%rcx psz))
             (%c99-lower-emit! ctx '(%cqo))
             (%c99-lower-emit! ctx '(%idiv %rcx))))))
    ((c-pointer-type? lt)
     (let ((psz (max 1 (%c99-lower-type-size ctx (c-ptr-target lt)))))
       (if (> psz 1) (%c99-lower-emit! ctx (list '%imul '%rcx psz)))
       (%c99-lower-emit! ctx (list (if (eq? op '+) '%add '%sub) '%rax '%rcx))))
    (else
     (let ((psz (max 1 (%c99-lower-type-size ctx (c-ptr-target rt)))))
       (if (> psz 1) (%c99-lower-emit! ctx (list '%imul '%rax psz)))
       (%c99-lower-emit! ctx '(%add %rax %rcx))))))

(define (%c99-lower-emit-fp-binop! ctx op res-ty)
  (case op
    ((+) (%c99-lower-emit! ctx '(%fadd %xmm0 %xmm1)))
    ((-) (%c99-lower-emit! ctx '(%fsub %xmm0 %xmm1)))
    ((*) (%c99-lower-emit! ctx '(%fmul %xmm0 %xmm1)))
    ((/) (%c99-lower-emit! ctx '(%fdiv %xmm0 %xmm1)))
    ((== != < <= > >=) (%c99-lower-emit-fcmp! ctx op)))
  (if (and (eq? res-ty 'f32) (memq op '(+ - * /)))
      (%c99-lower-emit! ctx '(%fptrunc f32 %xmm0 %xmm0))))

(define (%c99-lower-emit-fcmp! ctx cmp-op)
  (case cmp-op
    ((==) (%c99-lower-emit! ctx '(%fcmp-oeq %rax %xmm0 %xmm1)))
    ((!=) (%c99-lower-emit! ctx '(%fcmp-une %rax %xmm0 %xmm1)))
    ((<)  (%c99-lower-emit! ctx '(%fcmp-olt %rax %xmm0 %xmm1)))
    ((<=) (%c99-lower-emit! ctx '(%fcmp-ole %rax %xmm0 %xmm1)))
    ((>)  (%c99-lower-emit! ctx '(%fcmp-ogt %rax %xmm0 %xmm1)))
    ((>=) (%c99-lower-emit! ctx '(%fcmp-oge %rax %xmm0 %xmm1)))))

(define (%c99-lower-emit-binop! ctx op res-ty lhs-ty)
  (let ((unsigned? (or (c-unsigned-type? lhs-ty) (c-pointer-type? lhs-ty))))
    (case op
      ((+) (%c99-lower-emit! ctx '(%add %rax %rcx)))
      ((-) (%c99-lower-emit! ctx '(%sub %rax %rcx)))
      ((*) (%c99-lower-emit! ctx '(%imul %rax %rcx)))
      ((/)
       (if unsigned?
           (begin
             (%c99-lower-emit! ctx '(%mov %rdx 0))
             (%c99-lower-emit! ctx '(%udiv %rcx)))
           (begin
             (%c99-lower-emit! ctx '(%cqo))
             (%c99-lower-emit! ctx '(%idiv %rcx)))))
      ((rem)
       (if unsigned?
           (begin
             (%c99-lower-emit! ctx '(%mov %rdx 0))
             (%c99-lower-emit! ctx '(%urem %rcx)))
           (begin
             (%c99-lower-emit! ctx '(%cqo))
             (%c99-lower-emit! ctx '(%idiv %rcx))
             (%c99-lower-emit! ctx '(%mov %rax %rdx)))))
      ((bit-and) (%c99-lower-emit! ctx '(%bit-and %rax %rcx)))
      ((bit-or)  (%c99-lower-emit! ctx '(%bit-or %rax %rcx)))
      ((bit-xor) (%c99-lower-emit! ctx '(%bit-xor %rax %rcx)))
      ((<<)
       (%c99-lower-emit-var-shift! ctx '%shl (= (%c99-lower-type-size ctx res-ty) 8)))
      ((>>)
       (%c99-lower-emit-var-shift! ctx
                                   (if (c-unsigned-type? res-ty) '%shr '%sar)
                                   (= (%c99-lower-type-size ctx res-ty) 8)))
      ((== != < <= > >=)
       (%c99-lower-emit-cmp! ctx op unsigned?)))
    (if (not (memq op '(== != < <= > >=)))
        (%c99-lower-emit-cast! ctx res-ty))))

;;; -----------------------------------------------------------------------
;;; 7. Scalar & Aggregate Expression Lowering
;;; -----------------------------------------------------------------------

(define (%c99-lower-expr! ctx node)
  (let* ((ty (c-typed-type node))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (case tag
      ((c-const-val)
       (if (c-float-type? ty)
           (%c99-lower-emit-float-const! ctx (cadr inner) ty)
           (let ((v (cadr inner)))
             (if (and (>= v -2147483648) (<= v 2147483647))
                 (%c99-lower-emit! ctx (list '%mov '%rax v))
                 (%c99-lower-emit-u64-const! ctx '%rax (modulo v 18446744073709551616))))))

      ((c-enum-const)
       (%c99-lower-emit! ctx (list '%mov '%rax (cadr inner))))

      ((c-str-val)
       (let ((lbl (%c99-lower-intern-str! ctx (cadr inner))))
         (%c99-lower-emit! ctx (list '%str-ref '%rax lbl))
         (%c99-lower-emit! ctx '(%sub %rax 3))))

      ((c-fn-ref)
       (%c99-lower-emit! ctx (list '%code-ref '%rax (%c99-lower-resolve-runtime-fn! ctx (cadr inner)))))

      ((c-var-ref)
       (if (c-array-type? ty)
           (%c99-lower-lvalue-addr! ctx node)
           (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
             (if (not ent)
                 (error "Unbound variable during LIR lowering" inner)
                 (%c99-lower-load-var! ctx ent)))))

      ((c-member)
       (let ((fl (%c99-lower-member-field-layout ctx inner))
             (base (cadr inner))
             (deref? (cadddr inner)))
         (cond
           ((c-array-type? ty)
            (%c99-lower-lvalue-addr! ctx node))
           ((c-field-layout-bit-width fl)
            (if deref?
                (begin
                  (%c99-lower-expr! ctx base)
                  (%c99-san-emit-null-check! ctx '%rax (c-typed-span node) "NULL pointer bitfield access")
