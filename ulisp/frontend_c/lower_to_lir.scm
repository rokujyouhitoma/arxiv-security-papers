             (%c99-lower-emit! ctx '(%mov %rdx %rax))
             (%c99-lower-load-from-mem! ctx (if (c-float-type? ty) '%xmm0 '%rax) '%rdx 0 ty))))

      ((c-call)
       (%c99-lower-call! ctx inner ty))

      ((c-va-start)
       (%c99-lower-va-start! ctx inner))

      ((c-va-copy)
       (%c99-lower-va-copy! ctx inner))

      ((c-va-end)
       (%c99-lower-va-end! ctx inner))

      ((c-va-arg)
       (if (%c99-lower-aggregate-like? ty)
           (let* ((sz (%c99-lower-type-size ctx ty))
                  (al (%c99-lower-type-align ctx ty))
                  (slot-si (%c99-lower-alloc-bytes! ctx sz al)))
             (%c99-lower-expr-to-stack-slot! ctx node slot-si)
             (%c99-lower-emit! ctx '(%mov %rax %rsp))
             (%c99-lower-emit! ctx (list '%add '%rax slot-si)))
           (%c99-lower-va-arg! ctx inner ty #f)))

      (else
       (error "Unsupported expression tag in lower_to_lir" tag)))))

;;; -----------------------------------------------------------------------
;;; 8. Statements & Function Prologue/Epilogue (Full SysV Aggregate ABI)
;;; -----------------------------------------------------------------------

(define (%c99-annotate-switch-body ctx stmt cases-box def-box)
  (if (not (pair? stmt))
      stmt
      (case (car stmt)
        ((c-switch)
         ;; Do not enter nested switch
         stmt)
        ((c-case)
         (let ((lbl (%c99-lower-new-label ctx "sw_case"))
               (val (cadr stmt))
               (sub (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)))
           (set-car! cases-box (cons (cons val lbl) (car cases-box)))
           (list 'c-case-labeled lbl sub)))
        ((c-default)
         (let ((lbl (%c99-lower-new-label ctx "sw_def"))
               (sub (%c99-annotate-switch-body ctx (cadr stmt) cases-box def-box)))
           (set-car! def-box lbl)
           (list 'c-case-labeled lbl sub)))
        ((c-block)
         (cons 'c-block
               (map (lambda (s) (%c99-annotate-switch-body ctx s cases-box def-box))
                    (cdr stmt))))
        ((c-if)
         (list 'c-if
               (cadr stmt)
               (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)
               (if (cadddr stmt)
                   (%c99-annotate-switch-body ctx (cadddr stmt) cases-box def-box)
                   #f)))
        ((c-while)
         (list 'c-while
               (cadr stmt)
               (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)))
        ((c-do-while)
         (list 'c-do-while
               (%c99-annotate-switch-body ctx (cadr stmt) cases-box def-box)
               (caddr stmt)))
        ((c-for)
         (list 'c-for
               (list-ref stmt 1)
               (list-ref stmt 2)
               (list-ref stmt 3)
               (%c99-annotate-switch-body ctx (list-ref stmt 4) cases-box def-box)))
        ((c-label)
         (list 'c-label
               (cadr stmt)
               (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)))
        (else stmt))))

(define (%c99-lower-stmt! ctx stmt)
  (let ((tag (car stmt)))
    (case tag
      ((c-typed-decls)
       (for-each
        (lambda (d)
          (let* ((u-sym (list-ref d 1))
                 (ty (list-ref d 3))
                 (linkage (list-ref d 4))
                 (init (list-ref d 5)))
            (if (eq? linkage 'extern)
                (%c99-lower-bind-data-global! ctx u-sym ty)
                (let ((si (%c99-lower-bind-local! ctx u-sym ty)))
                  (if init
                      (cond
                        ((%c99-lower-aggregate-like? ty)
                         (%c99-lower-expr-to-stack-slot! ctx init si))
                        ((c-float-type? ty)
                         (%c99-lower-expr! ctx init)
                         (%c99-lower-emit! ctx (list '%store-typed ty '%rsp si '%xmm0)))
                        (else
                         (%c99-lower-expr! ctx init)
                         (%c99-lower-store-var! ctx (cdr (assq u-sym (lower-ctx-vars ctx)))))))))))
        (cdr stmt)))

      ((c-block)
       (for-each (lambda (it) (%c99-lower-stmt! ctx it)) (cdr stmt)))

      ((c-expr-stmt)
       (let ((expr (cadr stmt)))
         (if expr
             (let ((ty (c-typed-type expr)))
               (if (%c99-lower-aggregate-like? ty)
                   (let* ((saved-si (lower-ctx-next-si ctx))
                          (slot-si (%c99-lower-alloc-bytes! ctx (%c99-lower-type-size ctx ty) (%c99-lower-type-align ctx ty))))
                     (%c99-lower-expr-to-stack-slot! ctx expr slot-si)
                     (lower-ctx-next-si-set! ctx saved-si))
                   (%c99-lower-expr! ctx expr))))))

      ((c-return)
       (let ((expr (cadr stmt))
             (rplan (lower-ctx-ret-plan ctx)))
         (cond
           ((not expr) #f)
           ((eq? (car rplan) 'sret)
            (%c99-lower-expr-to-ptr-slot! ctx expr (lower-ctx-sret-si ctx))
            (%c99-lower-emit! ctx (list '%load '%rax '%rsp (lower-ctx-sret-si ctx))))
           ((and (memq (car rplan) '(regs empty))
                 (%c99-lower-aggregate-like? (c-typed-type expr)))
            (let* ((ty (c-typed-type expr))
                   (sz (%c99-lower-type-size ctx ty))
                   (al (%c99-lower-type-align ctx ty))
                   (buf-si (%c99-lower-alloc-bytes! ctx sz al)))
              (%c99-lower-expr-to-stack-slot! ctx expr buf-si)
              (if (eq? (car rplan) 'regs)
                  (for-each
                   (lambda (pc)
                     (let ((kind (list-ref pc 0))
                           (reg (list-ref pc 1))
                           (off (list-ref pc 2))
                           (csz (list-ref pc 3)))
                       (if (eq? kind 'gpr)
                           (%c99-lower-load-chunk-gpr! ctx reg '%rsp (+ buf-si off) csz)
                           (%c99-lower-emit! ctx (list '%load-typed (if (<= csz 4) 'f32 'f64) reg '%rsp (+ buf-si off))))))
                   (cadr rplan)))))
           (else
            (%c99-lower-expr! ctx expr)
            (if (not (c-float-type? (c-typed-type expr)))
                (%c99-lower-emit-cast! ctx (c-typed-type expr)))))
         (%c99-lower-emit! ctx (list '%direct-jump (lower-ctx-ret-lbl ctx)))))

      ((c-if)
       (let ((cnd (cadr stmt))
             (thn (caddr stmt))
             (els (cadddr stmt))
             (e-lbl (%c99-lower-new-label ctx "if_else"))
             (done-lbl (%c99-lower-new-label ctx "if_end")))
         (%c99-lower-eval-cond! ctx cnd)
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'je (if els e-lbl done-lbl)))
         (%c99-lower-stmt! ctx thn)
         (if els
             (begin
               (%c99-lower-emit! ctx (list '%direct-jump done-lbl))
               (%c99-lower-emit! ctx (list '%label e-lbl))
               (%c99-lower-stmt! ctx els)))
         (%c99-lower-emit! ctx (list '%label done-lbl))))

      ((c-while)
       (let ((head-lbl (%c99-lower-new-label ctx "while_h"))
             (end-lbl (%c99-lower-new-label ctx "while_e"))
             (prev-brk (lower-ctx-break-lbl ctx))
             (prev-cont (lower-ctx-continue-lbl ctx)))
         (%c99-lower-emit! ctx (list '%label head-lbl))
         (%c99-lower-eval-cond! ctx (cadr stmt))
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'je end-lbl))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (lower-ctx-continue-lbl-set! ctx head-lbl)
         (%c99-lower-stmt! ctx (caddr stmt))
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (lower-ctx-continue-lbl-set! ctx prev-cont)
         (%c99-lower-emit! ctx (list '%direct-jump head-lbl))
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-do-while)
       (let ((body-lbl (%c99-lower-new-label ctx "do_b"))
             (cond-lbl (%c99-lower-new-label ctx "do_c"))
             (end-lbl (%c99-lower-new-label ctx "do_e"))
             (prev-brk (lower-ctx-break-lbl ctx))
             (prev-cont (lower-ctx-continue-lbl ctx)))
         (%c99-lower-emit! ctx (list '%label body-lbl))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (lower-ctx-continue-lbl-set! ctx cond-lbl)
         (%c99-lower-stmt! ctx (cadr stmt))
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (lower-ctx-continue-lbl-set! ctx prev-cont)
         (%c99-lower-emit! ctx (list '%label cond-lbl))
         (%c99-lower-eval-cond! ctx (caddr stmt))
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'jne body-lbl))
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-for)
       (let ((init (list-ref stmt 1))
             (cnd  (list-ref stmt 2))
             (step (list-ref stmt 3))
             (body (list-ref stmt 4))
             (cond-lbl (%c99-lower-new-label ctx "for_c"))
             (step-lbl (%c99-lower-new-label ctx "for_s"))
             (end-lbl  (%c99-lower-new-label ctx "for_e"))
             (prev-brk (lower-ctx-break-lbl ctx))
             (prev-cont (lower-ctx-continue-lbl ctx)))
         (if init
             (if (c-typed? init)
                 (%c99-lower-expr! ctx init)
                 (%c99-lower-stmt! ctx init)))
         (%c99-lower-emit! ctx (list '%label cond-lbl))
         (if cnd
             (begin
               (%c99-lower-eval-cond! ctx cnd)
               (%c99-lower-emit! ctx '(%cmp %rax 0))
               (%c99-lower-emit! ctx (list '%jump-cond 'je end-lbl))))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (lower-ctx-continue-lbl-set! ctx step-lbl)
         (%c99-lower-stmt! ctx body)
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (lower-ctx-continue-lbl-set! ctx prev-cont)
         (%c99-lower-emit! ctx (list '%label step-lbl))
         (if step (%c99-lower-expr! ctx step))
         (%c99-lower-emit! ctx (list '%direct-jump cond-lbl))
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-switch)
       (let* ((cnd (cadr stmt))
              (cases-box (cons '() '()))
              (def-box (cons #f '()))
              (ann-body (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box))
              (end-lbl (%c99-lower-new-label ctx "sw_end"))
              (prev-brk (lower-ctx-break-lbl ctx))
              (cases (reverse (car cases-box)))
              (def-lbl (or (car def-box) end-lbl))
              (case-entries (map (lambda (cv) (list (car cv) (cdr cv) '())) cases)))
         (%c99-lower-expr! ctx cnd)
         (if (null? case-entries)
             (%c99-lower-emit! ctx (list '%direct-jump def-lbl))
             (%c99-lower-emit! ctx (list '%switch '%rax def-lbl '() case-entries)))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (%c99-lower-stmt! ctx ann-body)
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-case-labeled)
       (%c99-lower-emit! ctx (list '%label (cadr stmt)))
       (%c99-lower-stmt! ctx (caddr stmt)))

      ((c-break)
       (%c99-lower-emit! ctx (list '%direct-jump (lower-ctx-break-lbl ctx))))

      ((c-continue)
       (%c99-lower-emit! ctx (list '%direct-jump (lower-ctx-continue-lbl ctx))))

      ((c-goto)
       (%c99-lower-emit! ctx (list '%direct-jump (%c99-lower-user-label ctx (cadr stmt)))))

      ((c-label)
       (%c99-lower-emit! ctx (list '%label (%c99-lower-user-label ctx (cadr stmt))))
       (%c99-lower-stmt! ctx (caddr stmt)))

      ((c-typed-asm)
       (%c99-lower-inline-asm! ctx stmt))

      (else
       (error "Unsupported statement tag in lower_to_lir" tag)))))

;;; -----------------------------------------------------------------------
;;; 8.0 AT&T -> Intel Inline / Top-Level Asm Translation & %inline-asm Lowering
;;; -----------------------------------------------------------------------

(define (%c99-asm-trim s)
  (let* ((n (string-length s)))
    (let loop-l ((i 0))
      (if (and (< i n) (char-whitespace? (string-ref s i)))
          (loop-l (+ i 1))
          (let loop-r ((j n))
            (if (and (> j i) (char-whitespace? (string-ref s (- j 1))))
                (loop-r (- j 1))
                (substring s i j)))))))

(define (%c99-asm-downcase s)
  (let* ((n (string-length s))
         (cs (let loop ((i 0) (acc '()))
               (if (>= i n)
                   (reverse acc)
                   (loop (+ i 1) (cons (char-downcase (string-ref s i)) acc))))))
    (list->string cs)))

(define (%c99-asm-str-contains? s sub)
  (let ((n (string-length s))
        (m (string-length sub)))
    (if (= m 0) #t
        (let loop ((i 0))
          (cond
            ((> (+ i m) n) #f)
            ((string=? (substring s i (+ i m)) sub) #t)
            (else (loop (+ i 1))))))))

(define (%c99-asm-strip-comments s)
  (let ((n (string-length s))
        (cr (integer->char 13)))
    (let loop ((i 0) (in-str? #f) (acc '()))
      (if (>= i n)
          (list->string (reverse acc))
          (let ((ch (string-ref s i)))
            (cond
              ((and in-str? (char=? ch #\\) (< (+ i 1) n))
               (loop (+ i 2) #t (cons (string-ref s (+ i 1)) (cons ch acc))))
              ((char=? ch #\")
               (loop (+ i 1) (not in-str?) (cons ch acc)))
              ((and (not in-str?) (< (+ i 1) n)
                    (char=? ch #\/) (char=? (string-ref s (+ i 1)) #\*))
               (let skip-blk ((j (+ i 2)))
                 (cond
                   ((>= j n) (loop n #f acc))
                   ((and (< (+ j 1) n) (char=? (string-ref s j) #\*) (char=? (string-ref s (+ j 1)) #\/))
                    (loop (+ j 2) #f (cons #\space acc)))
                   ((char=? (string-ref s j) #\newline)
                    (skip-blk (+ j 1)))
                   (else (skip-blk (+ j 1))))))
              ((and (not in-str?) (< (+ i 1) n)
                    (char=? ch #\/) (char=? (string-ref s (+ i 1)) #\/))
               (let skip-ln ((j (+ i 2)))
                 (if (or (>= j n) (char=? (string-ref s j) #\newline) (char=? (string-ref s j) cr))
                     (loop j #f acc)
                     (skip-ln (+ j 1)))))
              (else
               (loop (+ i 1) in-str? (cons ch acc)))))))))

(define (%c99-asm-split-statements raw-tpl-str)
  (let* ((tpl-str (%c99-asm-strip-comments raw-tpl-str))
         (n (string-length tpl-str))
         (cr (integer->char 13))
         (raw-segs
          (let loop ((i 0) (start 0) (in-str? #f) (acc '()))
            (if (>= i n)
                (let ((tail (%c99-asm-trim (substring tpl-str start n))))
                  (reverse (if (> (string-length tail) 0) (cons tail acc) acc)))
                (let ((ch (string-ref tpl-str i)))
                  (cond
                    ((and in-str? (char=? ch #\\) (< (+ i 1) n))
                     (loop (+ i 2) start #t acc))
                    ((char=? ch #\")
                     (loop (+ i 1) start (not in-str?) acc))
                    ((and (not in-str?) (or (char=? ch #\newline) (char=? ch cr) (char=? ch #\;)))
                     (let ((seg (%c99-asm-trim (substring tpl-str start i))))
                       (loop (+ i 1) (+ i 1) #f
                             (if (> (string-length seg) 0) (cons seg acc) acc))))
                    (else
                     (loop (+ i 1) start in-str? acc))))))))
    ;; Merge standalone prefix segments ("lock", "rep", "repe", "repz", "repne", "repnz") with following inst
    ;; and split inline "label: inst" into two segments
    (let* ((split-lbls
            (let sl ((xs raw-segs) (acc '()))
              (if (null? xs)
                  (reverse acc)
                  (let* ((s (car xs))
                         (len (string-length s))
                         (colon-idx
                          (if (and (> len 0) (not (char=? (string-ref s 0) #\.)))
                              (let find-c ((k 0))
                                (cond
                                  ((>= k (- len 1)) #f)
                                  ((or (char-whitespace? (string-ref s k))
                                       (char=? (string-ref s k) #\,)
                                       (char=? (string-ref s k) #\[)
                                       (char=? (string-ref s k) #\()) #f)
                                  ((char=? (string-ref s k) #\:)
                                   (if (and (< (+ k 1) len) (char-whitespace? (string-ref s (+ k 1)))) k #f))
                                  (else (find-c (+ k 1)))))
                              #f)))
                    (if colon-idx
                        (let ((lbl (substring s 0 (+ colon-idx 1)))
                              (rest (%c99-asm-trim (substring s (+ colon-idx 1) len))))
                          (sl (cdr xs) (if (> (string-length rest) 0) (cons rest (cons lbl acc)) (cons lbl acc))))
                        (sl (cdr xs) (cons s acc))))))))
      (let merge ((xs split-lbls) (acc '()))
        (cond
          ((null? xs) (reverse acc))
          ((and (pair? (cdr xs))
                (member (%c99-asm-downcase (car xs)) '("lock" "rep" "repe" "repz" "repne" "repnz")))
           (merge (cddr xs)
                  (cons (string-append (%c99-asm-downcase (car xs)) " " (cadr xs)) acc)))
          (else
           (merge (cdr xs) (cons (car xs) acc))))))))

(define (%c99-asm-split-args args-str)
  (let ((n (string-length args-str)))
    (let loop ((i 0) (start 0) (pdepth 0) (bdepth 0) (acc '()))
      (if (>= i n)
          (let ((tail (%c99-asm-trim (substring args-str start n))))
            (reverse (if (> (string-length tail) 0) (cons tail acc) acc)))
          (let ((ch (string-ref args-str i)))
            (cond
              ((char=? ch #\() (loop (+ i 1) start (+ pdepth 1) bdepth acc))
              ((char=? ch #\)) (loop (+ i 1) start (max 0 (- pdepth 1)) bdepth acc))
              ((char=? ch #\[) (loop (+ i 1) start pdepth (+ bdepth 1) acc))
              ((char=? ch #\]) (loop (+ i 1) start pdepth (max 0 (- bdepth 1)) acc))
              ((and (char=? ch #\,) (= pdepth 0) (= bdepth 0))
               (let ((seg (%c99-asm-trim (substring args-str start i))))
                 (loop (+ i 1) (+ i 1) 0 0 (if (> (string-length seg) 0) (cons seg acc) acc))))
              (else
               (loop (+ i 1) start pdepth bdepth acc))))))))

(define (%c99-asm-strip-reg-percent s top-level?)
  (let ((n (string-length s)))
    (cond
      ((and (>= n 2) (char=? (string-ref s 0) #\%) (char=? (string-ref s 1) #\%))
       (substring s 2 n))
      ((and top-level? (>= n 1) (char=? (string-ref s 0) #\%))
       (substring s 1 n))
      ((and (not top-level?) (>= n 2) (char=? (string-ref s 0) #\%)
            (not (or (and (char>=? (string-ref s 1) #\0) (char<=? (string-ref s 1) #\9))
                     (char=? (string-ref s 1) #\[)
                     (and (>= n 3) (memv (string-ref s 1) '(#\b #\w #\k #\q #\h #\l))
                          (or (and (char>=? (string-ref s 2) #\0) (char<=? (string-ref s 2) #\9))
                              (char=? (string-ref s 2) #\[))))))
       (substring s 1 n))
      (else s))))

(define (%c99-asm-placeholder-idx s)
  (let ((n (string-length s)))
    (if (and (>= n 2) (char=? (string-ref s 0) #\%))
        (let* ((start (if (and (>= n 3) (memv (string-ref s 1) '(#\b #\w #\k #\q #\h #\l))) 2 1))
               (rest (substring s start n)))
          (if (and (> (string-length rest) 0)
                   (let dloop ((k 0))
                     (if (>= k (string-length rest))
                         #t
                         (and (char>=? (string-ref rest k) #\0)
                              (char<=? (string-ref rest k) #\9)
                              (dloop (+ k 1))))))
              (string->number rest)
              #f))
        #f)))

(define (%c99-asm-convert-att-mem disp inner)
  (let* ((parts (map %c99-asm-trim (%c99-asm-split-args inner)))
         (raw-base (if (>= (length parts) 1) (%c99-asm-strip-reg-percent (list-ref parts 0) #t) ""))
         (raw-idx  (if (>= (length parts) 2) (%c99-asm-strip-reg-percent (list-ref parts 1) #t) ""))
         (raw-scl  (if (>= (length parts) 3) (list-ref parts 2) ""))
         (base (if (and (> (string-length raw-base) 0) (not (string=? raw-base "iz"))) raw-base ""))
         (idx  (if (and (> (string-length raw-idx) 0)  (not (string=? raw-idx "iz")))  raw-idx  ""))
         (terms
          (append
           (if (> (string-length base) 0) (list base) '())
           (append
            (if (> (string-length idx) 0)
                (list (if (and (> (string-length raw-scl) 0) (not (string=? raw-scl "1")))
                          (string-append idx "*" raw-scl)
                          idx))
                '())
            (if (and (> (string-length disp) 0) (not (string=? disp "0")))
                (list disp)
                '())))))
    (if (null? terms)
        "[0]"
        (let loop ((ts (cdr terms)) (s (car terms)))
          (if (null? ts)
              (string-append "[" s "]")
              (let ((t (car ts)))
                (if (and (> (string-length t) 0) (char=? (string-ref t 0) #\-))
                    (loop (cdr ts) (string-append s " - " (substring t 1 (string-length t))))
                    (loop (cdr ts) (string-append s " + " t)))))))))

(define (%c99-asm-convert-att-opnd op top-level? size-prefix)
  (let* ((t0 (%c99-asm-trim op))
         (t (if (and (> (string-length t0) 1) (char=? (string-ref t0 0) #\*))
                (%c99-asm-trim (substring t0 1 (string-length t0)))
                t0))
         (n (string-length t)))
    (cond
      ((= n 0) "")
      ;; Numeric local label forward/backward ref: 1f / 1b -> .L_asm_num_1
      ((and (= n 2)
            (char>=? (string-ref t 0) #\0) (char<=? (string-ref t 0) #\9)
            (or (char=? (string-ref t 1) #\f) (char=? (string-ref t 1) #\b)))
       (string-append ".L_asm_num_" (substring t 0 1)))
      ;; Immediate: $imm
      ((char=? (string-ref t 0) #\$)
       (substring t 1 n))
      ;; Already Intel bracket or ptr
      ((or (%c99-asm-str-contains? t "[")
           (%c99-asm-str-contains? (%c99-asm-downcase t) " ptr "))
       t)
      (else
       ;; Check segment prefix: %%fs: or %fs: or %%gs: or %gs:
       (let* ((seg-res
               (cond
                 ((and (>= n 5) (string=? (%c99-asm-downcase (substring t 0 5)) "%%fs:"))
                  (cons "fs:" (substring t 5 n)))
                 ((and (>= n 4) (string=? (%c99-asm-downcase (substring t 0 4)) "%fs:"))
                  (cons "fs:" (substring t 4 n)))
                 ((and (>= n 5) (string=? (%c99-asm-downcase (substring t 0 5)) "%%gs:"))
                  (cons "gs:" (substring t 5 n)))
                 ((and (>= n 4) (string=? (%c99-asm-downcase (substring t 0 4)) "%gs:"))
                  (cons "gs:" (substring t 4 n)))
                 (else (cons "" t))))
              (seg (car seg-res))
              (body (%c99-asm-trim (cdr seg-res)))
              (bn (string-length body)))
         (cond
           ;; Segment with bare disp, e.g. %%fs:0 -> fs:[0]
           ((and (> (string-length seg) 0)
                 (or (= bn 0) (not (char=? (string-ref body (- bn 1)) #\)))))
            (let ((addr (string-append seg "[" (if (= bn 0) "0" body) "]")))
              (if size-prefix (string-append size-prefix " " addr) addr)))
           ;; Memory with trailing (...): disp(base, idx, scale)
           ((and (> bn 0) (char=? (string-ref body (- bn 1)) #\)))
            (let find-lp ((k (- bn 2)))
              (if (< k 0)
                  body
                  (if (char=? (string-ref body k) #\()
                      (let* ((disp (%c99-asm-trim (substring body 0 k)))
                             (inner (substring body (+ k 1) (- bn 1)))
                             (addr (string-append seg (%c99-asm-convert-att-mem disp inner))))
                        (if size-prefix (string-append size-prefix " " addr) addr))
                      (find-lp (- k 1))))))
           (else
            (let ((reg-or-id (%c99-asm-strip-reg-percent body top-level?)))
              (if size-prefix
                  (string-append size-prefix " " reg-or-id)
                  reg-or-id)))))))))

(define (%c99-asm-normalize-mnem low-mnem has-xmm?)
  ;; Returns (list intel-mnem att-size-ptr-or-#f definite-att?)
  (let* ((exact-table
          '(("movq" . ("mov" "qword ptr" #t)) ("movl" . ("mov" "dword ptr" #t))
            ("movw" . ("mov" "word ptr" #t))  ("movb" . ("mov" "byte ptr" #t))
            ("addq" . ("add" "qword ptr" #t)) ("addl" . ("add" "dword ptr" #t))
            ("addw" . ("add" "word ptr" #t))  ("addb" . ("add" "byte ptr" #t))
            ("subq" . ("sub" "qword ptr" #t)) ("subl" . ("sub" "dword ptr" #t))
            ("subw" . ("sub" "word ptr" #t))  ("subb" . ("sub" "byte ptr" #t))
            ("andq" . ("and" "qword ptr" #t)) ("andl" . ("and" "dword ptr" #t))
            ("andw" . ("and" "word ptr" #t))  ("andb" . ("and" "byte ptr" #t))
            ("orq"  . ("or"  "qword ptr" #t)) ("orl"  . ("or"  "dword ptr" #t))
            ("orw"  . ("or"  "word ptr" #t))  ("orb"  . ("or"  "byte ptr" #t))
            ("xorq" . ("xor" "qword ptr" #t)) ("xorl" . ("xor" "dword ptr" #t))
            ("xorw" . ("xor" "word ptr" #t))  ("xorb" . ("xor" "byte ptr" #t))
            ("cmpq" . ("cmp" "qword ptr" #t)) ("cmpl" . ("cmp" "dword ptr" #t))
            ("cmpw" . ("cmp" "word ptr" #t))  ("cmpb" . ("cmp" "byte ptr" #t))
            ("testq" . ("test" "qword ptr" #t)) ("testl" . ("test" "dword ptr" #t))
            ("testw" . ("test" "word ptr" #t))  ("testb" . ("test" "byte ptr" #t))
            ("incq" . ("inc" "qword ptr" #t)) ("incl" . ("inc" "dword ptr" #t))
            ("incw" . ("inc" "word ptr" #t))  ("incb" . ("inc" "byte ptr" #t))
            ("decq" . ("dec" "qword ptr" #t)) ("decl" . ("dec" "dword ptr" #t))
            ("decw" . ("dec" "word ptr" #t))  ("decb" . ("dec" "byte ptr" #t))
            ("negq" . ("neg" "qword ptr" #t)) ("negl" . ("neg" "dword ptr" #t))
            ("notq" . ("not" "qword ptr" #t)) ("notl" . ("not" "dword ptr" #t))
            ("shlq" . ("shl" "qword ptr" #t)) ("shll" . ("shl" "dword ptr" #t))
            ("shrq" . ("shr" "qword ptr" #t)) ("shrl" . ("shr" "dword ptr" #t))
            ("sarq" . ("sar" "qword ptr" #t)) ("sarl" . ("sar" "dword ptr" #t))
            ("leaq" . ("lea" #f #t))          ("leal" . ("lea" #f #t))
            ("xchgq" . ("xchg" "qword ptr" #t)) ("xchgl" . ("xchg" "dword ptr" #t))
            ("cmpxchgq" . ("cmpxchg" "qword ptr" #t)) ("cmpxchgl" . ("cmpxchg" "dword ptr" #t))
            ("xaddq" . ("xadd" "qword ptr" #t)) ("xaddl" . ("xadd" "dword ptr" #t))
            ("bsfq" . ("bsf" #f #t)) ("bsfl" . ("bsf" #f #t))
            ("bsrq" . ("bsr" #f #t)) ("bsrl" . ("bsr" #f #t))
            ("btq"  . ("bt"  #f #t)) ("btl"  . ("bt"  #f #t))
            ("btsq" . ("bts" #f #t)) ("btsl" . ("bts" #f #t))
            ("btrq" . ("btr" #f #t)) ("btrl" . ("btr" #f #t))
            ("pushq" . ("push" #f #t)) ("popq" . ("pop" #f #t))
            ("callq" . ("call" #f #t)) ("jmpq" . ("jmp" #f #t)) ("retq" . ("ret" #f #t))
            ("movslq" . ("movsxd" #f #t)) ("cltq" . ("cdqe" #f #t)) ("cqto" . ("cqo" #f #t))))
         (hit (assoc low-mnem exact-table)))
    (cond
      ((and (string=? low-mnem "movq") has-xmm?)
       (list "movq" #f #t))
      (hit (cdr hit))
      (else (list low-mnem #f #f)))))

(define (%c99-asm-opnds-look-intel? opnds)
  (let loop ((xs opnds))
    (if (null? xs)
        #f
        (let* ((o (%c99-asm-trim (car xs)))
               (n (string-length o))
               (bare-int?
                (and (> n 0)
                     (or (and (char>=? (string-ref o 0) #\0) (char<=? (string-ref o 0) #\9))
                         (and (char=? (string-ref o 0) #\-) (> n 1)
                              (char>=? (string-ref o 1) #\0) (char<=? (string-ref o 1) #\9))))))
          (if (or bare-int?
                  (%c99-asm-str-contains? o "[")
                  (%c99-asm-str-contains? (%c99-asm-downcase o) " ptr "))
              #t
              (loop (cdr xs)))))))

(define (%c99-asm-opnds-look-att? opnds)
  (let loop ((xs opnds))
    (if (null? xs)
        #f
        (let ((o (%c99-asm-trim (car xs))))
          (if (or (%c99-asm-str-contains? o "%%")
                  (%c99-asm-str-contains? o "$")
                  (%c99-asm-str-contains? o "(%")
                  (%c99-asm-str-contains? o "*%")
                  (and (= (string-length o) 2)
                       (char>=? (string-ref o 0) #\0) (char<=? (string-ref o 0) #\9)
                       (or (char=? (string-ref o 1) #\f) (char=? (string-ref o 1) #\b)))
                  (and (>= (string-length o) 2)
                       (char=? (string-ref o 0) #\%)
                       (char-alphabetic? (string-ref o 1))))
              #t
              (loop (cdr xs)))))))

(define (%c99-asm-apply-width-modifier op-str op-types op-cstrs)
  (let ((idx (%c99-asm-placeholder-idx (%c99-asm-trim op-str))))
    (if (and idx (< idx (length op-types)))
        (let* ((ty (list-ref op-types idx))
               (cstr (if (< idx (length op-cstrs)) (list-ref op-cstrs idx) ""))
               (is-mem-cstr? (%c99-asm-str-contains? cstr "m"))
               (prefix-ch (and (not is-mem-cstr?)
                               (cond
                                 ((or (eq? ty 'i32) (eq? ty 'u32)) "k")
                                 ((or (eq? ty 'i16) (eq? ty 'u16)) "w")
                                 ((or (eq? ty 'i8) (eq? ty 'u8) (eq? ty 'bool)) "b")
                                 (else #f)))))
          (if (and prefix-ch (char=? (string-ref op-str 0) #\%)
                   (char>=? (string-ref op-str 1) #\0)
                   (char<=? (string-ref op-str 1) #\9))
              (string-append "%" prefix-ch (substring op-str 1 (string-length op-str)))
              op-str))
        op-str)))

(define (%c99-asm-mem-like? intel-op raw-op op-cstrs)
  (let ((t (%c99-asm-trim intel-op))
        (idx (%c99-asm-placeholder-idx (%c99-asm-trim raw-op))))
    (or (%c99-asm-str-contains? t "[")
        (%c99-asm-str-contains? (%c99-asm-downcase t) "fs:")
        (and idx (< idx (length op-cstrs)) (%c99-asm-str-contains? (list-ref op-cstrs idx) "m")))))

(define (%c99-asm-translate-line line top-level? op-types op-cstrs)
  (let ((t (%c99-asm-trim line)))
    (cond
      ((= (string-length t) 0) #f)
      ;; Assembler directive (.globl, .global, .weak, .hidden, .text, ...)
      ((char=? (string-ref t 0) #\.)
       (if (or (string=? t ".global")
               (and (> (string-length t) 8)
                    (string=? (substring t 0 8) ".global ")
                    #t)
               (and (> (string-length t) 8)
                    (string=? (substring t 0 8) ".global\t")))
           (string-append "    .globl" (substring t 7 (string-length t)))
           (string-append "    " t)))
      ;; Label definition (foo: or numeric 1:)
      ((char=? (string-ref t (- (string-length t) 1)) #\:)
       (if (and (= (string-length t) 2)
                (char>=? (string-ref t 0) #\0)
                (char<=? (string-ref t 0) #\9))
           (string-append ".L_asm_num_" (substring t 0 1) ":")
           t))
      (else
       ;; Peel lock/rep prefix if present
       (let* ((pfx-split
               (let loop ((i 0))
                 (if (or (>= i (string-length t)) (char-whitespace? (string-ref t i)))
                     (cons (%c99-asm-downcase (substring t 0 i))
                           (%c99-asm-trim (substring t i (string-length t))))
                     (loop (+ i 1)))))
              (has-pfx? (and (> (string-length (cdr pfx-split)) 0)
                             (member (car pfx-split) '("lock" "rep" "repe" "repz" "repne" "repnz"))))
              (pfx (if has-pfx? (car pfx-split) #f))
              (body (if has-pfx? (cdr pfx-split) t))
              (mnem-split
               (let loop ((i 0))
                 (if (or (>= i (string-length body)) (char-whitespace? (string-ref body i)))
                     (cons (%c99-asm-downcase (substring body 0 i))
                           (%c99-asm-trim (substring body i (string-length body))))
                     (loop (+ i 1)))))
              (raw-mnem (car mnem-split))
              (args-str (cdr mnem-split))
              (raw-opnds (if (= (string-length args-str) 0) '() (%c99-asm-split-args args-str)))
              (has-xmm?
               (or (%c99-asm-str-contains? (%c99-asm-downcase args-str) "xmm")
                   (let loop ((cs op-cstrs))
                     (if (null? cs) #f
                         (or (%c99-asm-str-contains? (car cs) "x") (loop (cdr cs)))))))
              (mnem-info (%c99-asm-normalize-mnem raw-mnem has-xmm?))
              (intel-mnem (car mnem-info))
              (size-hint (cadr mnem-info))
              (def-att? (caddr mnem-info))
              (is-att? (or def-att?
                           (%c99-asm-opnds-look-att? raw-opnds)
                           (and (not top-level?)
                                (not (%c99-asm-opnds-look-intel? raw-opnds)))))
              (need-mem-sz?
               (and size-hint
                    (or (= (length raw-opnds) 1)
                        (and (= (length raw-opnds) 2)
                             (or (char=? (string-ref (%c99-asm-trim (car raw-opnds)) 0) #\$)
                                 (let ((i0 (%c99-asm-placeholder-idx (car raw-opnds))))
                                   (and i0 (< i0 (length op-cstrs))
                                        (member (list-ref op-cstrs i0) '("i" "n" "I" "J" "K")))))))))
              (converted-opnds
               (if is-att?
                   (let ((rev-raw (if (>= (length raw-opnds) 2) (reverse raw-opnds) raw-opnds)))
                     (map (lambda (o)
                            (let* ((mem-sz (if (and need-mem-sz?
                                                    (%c99-asm-mem-like? (%c99-asm-convert-att-opnd o top-level? #f) o op-cstrs))
                                               size-hint
                                               #f))
                                   (intel-o (%c99-asm-convert-att-opnd o top-level? mem-sz)))
                              (if (and (not def-att?)
                                       (not top-level?)
                                       (member intel-mnem '("mov" "add" "sub" "and" "or" "xor" "cmp"
                                                            "test" "xchg" "xadd" "cmpxchg"
                                                            "inc" "dec" "neg" "not" "bsf" "bsr")))
                                  (%c99-asm-apply-width-modifier intel-o op-types op-cstrs)
                                  intel-o)))
                          rev-raw))
                   raw-opnds))
              (opnds-joined
               (if (null? converted-opnds)
                   ""
                   (let jloop ((os (cdr converted-opnds)) (s (car converted-opnds)))
                     (if (null? os) s (jloop (cdr os) (string-append s ", " (car os)))))))
              (inst-line
               (if (= (string-length opnds-joined) 0)
                   (if pfx (string-append pfx " " intel-mnem) intel-mnem)
                   (if pfx
                       (string-append pfx " " intel-mnem " " opnds-joined)
                       (string-append intel-mnem " " opnds-joined)))))
         (if top-level? (string-append "    " inst-line) inst-line))))))

(define (c99-att-asm->intel-asm tpl-str top-level? . maybe-meta)
  (let* ((op-types (if (and (pair? maybe-meta) (pair? (car maybe-meta))) (caar maybe-meta) '()))
         (op-cstrs (if (and (pair? maybe-meta) (pair? (car maybe-meta))) (cdar maybe-meta) '()))
         (segs (%c99-asm-split-statements tpl-str))
         (lines
          (let loop ((ss segs) (acc '()))
            (if (null? ss)
                (reverse acc)
                (let ((tr (%c99-asm-translate-line (car ss) top-level? op-types op-cstrs)))
                  (loop (cdr ss) (if tr (cons tr acc) acc)))))))
    (if top-level?
        lines
        (if (null? lines)
            "nop"
            (let jloop ((ls (cdr lines)) (s (car lines)))
              (if (null? ls) s (jloop (cdr ls) (string-append s "\n" (car ls)))))))))

(define (%c99-lower-asm-simple-local-var-si ctx texpr)
  (let ((inner (c-typed-inner texpr)))
    (if (and (pair? inner) (eq? (car inner) 'c-var-ref))
        (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
          (if (and ent (eq? (car ent) 'local) (not (%c99-lower-aggregate-like? (c-typed-type texpr))))
              (cadr ent)
              #f))
        #f)))

(define (%c99-lower-asm-mem-reg-pool clobs all-cstrs)
  (let ((bad '(%rax %r10 %r11 %rsp)))
    (let* ((bad1
            (let cl ((xs clobs) (acc bad))
              (if (null? xs) acc
                  (let* ((s (%c99-asm-downcase (if (symbol? (car xs)) (symbol->string (car xs)) (car xs))))
                         (rs (string->symbol (string-append "%" s))))
                    (cl (cdr xs) (cons rs acc))))))
           (bad2
            (let cs ((xs all-cstrs) (acc bad1))
              (if (null? xs) acc
                  (let ((c (car xs)))
                    (cond
                      ((%c99-asm-str-contains? c "a") (cs (cdr xs) (cons '%rax acc)))
                      ((%c99-asm-str-contains? c "b") (cs (cdr xs) (cons '%rbx acc)))
                      ((%c99-asm-str-contains? c "c") (cs (cdr xs) (cons '%rcx acc)))
                      ((%c99-asm-str-contains? c "d") (cs (cdr xs) (cons '%rdx acc)))
                      ((%c99-asm-str-contains? c "S") (cs (cdr xs) (cons '%rsi acc)))
                      ((%c99-asm-str-contains? c "D") (cs (cdr xs) (cons '%rdi acc)))
                      (else (cs (cdr xs) acc))))))))
      (let loop ((cand '(%r9 %r8 %rsi %rdi %rdx %rcx %rbx %r13 %r14 %r15 %r12)) (free '()))
        (if (null? cand)
            (reverse free)
            (if (memq (car cand) bad2)
                (loop (cdr cand) free)
                (loop (cdr cand) (cons (car cand) free))))))))

(define (%c99-lower-inline-asm! ctx stmt)
  (let* ((vol? (cadr stmt))
         (tpl-str (caddr stmt))
         (outs (cadddr stmt))
         (ins (list-ref stmt 4))
         (clobs (list-ref stmt 5))
         (all-ops (append outs ins))
         (op-types (map (lambda (op) (c-typed-type (caddr op))) all-ops))
         (op-cstrs (map cadr all-ops))
         (intel-tpl (c99-att-asm->intel-asm tpl-str #f (cons op-types op-cstrs)))
         (saved-si (lower-ctx-next-si ctx))
         (mem-pool (%c99-lower-asm-mem-reg-pool clobs op-cstrs))
         (pool-box (cons mem-pool '()))
         (mem-loads-box (cons '() '()))
         (writebacks-box (cons '() '()))
         (alloc-mem-reg!
          (lambda ()
            (let ((p (car pool-box)))
              (if (null? p) '%rbx (begin (set-car! pool-box (cdr p)) (car p))))))
         (prep-mem-operand!
          (lambda (texpr)
            (let ((si (%c99-lower-asm-simple-local-var-si ctx texpr)))
              (if si
                  (list '%stack si)
                  (let* ((ptr-si (%c99-lower-alloc-slot! ctx))
                         (mreg (alloc-mem-reg!)))
                    (%c99-lower-lvalue-addr! ctx texpr)
                    (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
                    (set-car! mem-loads-box (cons (cons ptr-si mreg) (car mem-loads-box)))
                    (list '%mem mreg 0))))))
         (lir-outs
          (map (lambda (o)
                 (let* ((oname (car o))
                        (ocstr (cadr o))
                        (oexpr (caddr o))
                        (oty (c-typed-type oexpr))
                        (is-mem? (%c99-asm-str-contains? ocstr "m"))
                        (is-rw? (and (> (string-length ocstr) 0) (char=? (string-ref ocstr 0) #\+)))
                        (si (%c99-lower-asm-simple-local-var-si ctx oexpr))
                        (opnd
                         (cond
                           (is-mem? (prep-mem-operand! oexpr))
                           (si (list '%stack si))
                           (else
                            (let ((tmp-si (%c99-lower-alloc-slot! ctx)))
                              (if is-rw?
                                  (begin
                                    (%c99-lower-expr! ctx oexpr)
                                    (if (c-float-type? oty)
                                        (%c99-lower-emit! ctx (list '%store-typed oty '%rsp tmp-si '%xmm0))
                                        (%c99-lower-emit! ctx (list '%store '%rsp tmp-si '%rax)))))
                              (set-car! writebacks-box (cons (list oexpr tmp-si oty) (car writebacks-box)))
                              (list '%stack tmp-si))))))
                   (if oname
                       (list oname ocstr opnd)
                       (list opnd ocstr))))
               outs))
         (lir-ins
          (map (lambda (in-op)
                 (let* ((iname (car in-op))
                        (icstr (cadr in-op))
                        (iexpr (caddr in-op))
                        (ity (c-typed-type iexpr))
                        (is-mem? (%c99-asm-str-contains? icstr "m"))
                        (is-imm? (member icstr '("i" "n" "I" "J" "K")))
                        (inner (c-typed-inner iexpr))
                        (si (%c99-lower-asm-simple-local-var-si ctx iexpr))
                        (opnd
                         (cond
                           (is-mem? (prep-mem-operand! iexpr))
                           ((and is-imm? (eq? (car inner) 'c-const-val) (integer? (cadr inner)))
                            (cadr inner))
                           ((and si (c-integer-type? ity) (= (%c99-lower-type-size ctx ity) 8))
                            (list '%stack si))
                           (else
                            (let ((tmp-si (%c99-lower-alloc-slot! ctx)))
                              (%c99-lower-expr! ctx iexpr)
                              (if (c-float-type? ity)
                                  (%c99-lower-emit! ctx (list '%store-typed ity '%rsp tmp-si '%xmm0))
                                  (%c99-lower-emit! ctx (list '%store '%rsp tmp-si '%rax)))
                              (list '%stack tmp-si))))))
                   (if iname
                       (list iname icstr opnd)
                       (list opnd icstr))))
               ins)))
    ;; Load computed pointer addresses into non-conflicting base registers right before %inline-asm
    (for-each
     (lambda (ml)
       (%c99-lower-emit! ctx (list '%load (cdr ml) '%rsp (car ml))))
     (reverse (car mem-loads-box)))
    (%c99-lower-emit! ctx
                      (list '%inline-asm
                            intel-tpl
                            (list ':outputs lir-outs)
                            (list ':inputs lir-ins)
                            (list ':clobbers clobs)
                            (list ':volatile? (if vol? #t #f))))
    ;; Perform deferred writebacks for non-local scalar outputs
    (for-each
     (lambda (wb)
       (let ((dst-expr (car wb))
             (tmp-si (cadr wb))
             (ty (caddr wb)))
         (let ((addr-si (%c99-lower-alloc-slot! ctx)))
           (%c99-lower-lvalue-addr! ctx dst-expr)
           (%c99-lower-emit! ctx (list '%store '%rsp addr-si '%rax))
           (if (c-float-type? ty)
               (begin
                 (%c99-lower-emit! ctx (list '%load-typed ty '%xmm0 '%rsp tmp-si))
                 (%c99-lower-emit! ctx (list '%load '%rdx '%rsp addr-si))
                 (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0)))
               (begin
                 (%c99-lower-emit! ctx (list '%load '%rax '%rsp tmp-si))
                 (%c99-lower-emit! ctx (list '%load '%rdx '%rsp addr-si))
                 (%c99-lower-store-to-mem! ctx '%rdx 0 '%rax ty))))))
     (reverse (car writebacks-box)))
    (lower-ctx-next-si-set! ctx saved-si)))

;;; -----------------------------------------------------------------------
;;; 8.1 Escape Analysis & mem2reg Candidate Promotion (Issue #919)
;;; -----------------------------------------------------------------------

(define (c99-find-root-lvalue-var node)
  (let* ((unwrapped (if (c-typed? node) (c-typed-inner node) node))
         (tag (and (pair? unwrapped) (car unwrapped))))
    (case tag
      ((c-var-ref) (cadr unwrapped))
      ((c-member)
       (let ((base (cadr unwrapped))
             (deref? (cadddr unwrapped)))
         (if (not deref?) (c99-find-root-lvalue-var base) #f)))
      ((c-index)
       (c99-find-root-lvalue-var (cadr unwrapped)))
      ((c-cast c-implicit-cast)
       (c99-find-root-lvalue-var (caddr unwrapped)))
      (else #f))))

(define (c99-fn-has-setjmp? fn-node)
  (letrec
      ((scan
        (lambda (node)
          (cond
            ((not (pair? node)) #f)
            (else
             (let* ((inner (if (c-typed? node) (c-typed-inner node) node))
                    (tag (and (pair? inner) (car inner))))
               (case tag
                 ((c-fn-ref)
                  (c99-setjmp-fn-sym? (cadr inner)))
                 ((c-call)
                  (let* ((callee (ast-strip-span (cadr inner)))
                         (c-inner (if (c-typed? callee) (c-typed-inner callee) callee)))
                    (or (and (pair? c-inner)
                             (memq (car c-inner) '(c-fn-ref c-var-ref))
                             (c99-setjmp-fn-sym? (cadr c-inner)))
                        (let loop ((items (cdr inner)))
                          (if (not (pair? items))
                              #f
                              (or (scan (car items)) (loop (cdr items))))))))
                 (else
                  (let loop ((items inner))
                    (if (not (pair? items))
                        #f
                        (or (scan (car items)) (loop (cdr items)))))))))))))
    (let ((body (if (and (pair? fn-node)
                         (eq? (car fn-node) 'c-typed-fn)
                         (>= (length fn-node) 6))
                    (list-ref fn-node 5)
                    fn-node)))
      (scan body))))

(define (c99-collect-escaped-bindings fn-node)
  (let ((has-sj? (c99-fn-has-setjmp? fn-node)))
    (letrec
        ((walk
          (lambda (node acc)
            (cond
              ((not (pair? node)) acc)
              (else
               (let* ((inner (if (c-typed? node) (c-typed-inner node) node))
                      (tag (and (pair? inner) (car inner))))
                 (case tag
                   ((c-unop)
                    (let* ((op (cadr inner))
                           (sub (caddr inner))
                           (root (and (eq? op 'addr) (c99-find-root-lvalue-var sub)))
                           (acc2 (if (and root (not (memq root acc)))
                                     (cons root acc)
                                     acc)))
                      (walk sub acc2)))
                   ((c-typed-decls c-typed-decl)
                    (let dloop ((ds (if (eq? tag 'c-typed-decls) (cdr inner) (list inner)))
                                (dacc acc))
                      (if (null? ds) dacc
                          (let* ((d (car ds))
                                 (u-sym (list-ref d 1))
                                 (ty (list-ref d 3))
                                 (init (list-ref d 5))
                                 (force-spill? (or has-sj? (c-array-type? ty) (c-aggregate-ref-type? ty)))
                                 (dacc2 (if (and force-spill? (not (memq u-sym dacc)))
                                            (cons u-sym dacc)
                                            dacc))
                                 (dacc3 (if init (walk init dacc2) dacc2)))
                            (dloop (cdr ds) dacc3)))))
                   (else
                    (let loop ((items inner) (cur-acc acc))
                      (if (null? items) cur-acc
                          (loop (cdr items) (walk (car items) cur-acc))))))))))))
      (let* ((params (if (>= (length fn-node) 5) (list-ref fn-node 4) '()))
             (body   (if (>= (length fn-node) 6) (list-ref fn-node 5) '()))
             (init-acc
              (let ploop ((ps params) (pacc '()))
                (if (null? ps) pacc
                    (let* ((p (car ps))
                           (u-sym (car p))
                           (pty (caddr p)))
                      (if (or has-sj? (c-array-type? pty) (c-aggregate-ref-type? pty))
                          (ploop (cdr ps) (if (memq u-sym pacc) pacc (cons u-sym pacc)))
                          (ploop (cdr ps) pacc)))))))
        (walk body init-acc)))))

(define (c99-function-candidate-mem2reg-offsets fn-node vars)
  (if (c99-fn-has-setjmp? fn-node)
      '()
      (let ((escaped (c99-collect-escaped-bindings fn-node)))
        (let loop ((vs vars) (acc '()))
          (if (null? vs) (reverse acc)
              (let* ((entry (car vs))
                     (u-sym (car entry))
                     (kind (cadr entry))
                     (si (caddr entry))
                     (ty (cadddr entry)))
                (if (and (eq? kind 'local)
                         (c-scalar-type? ty)
                         (not (memq u-sym escaped)))
                    (loop (cdr vs) (cons si acc))
                    (loop (cdr vs) acc))))))))

;;; -----------------------------------------------------------------------
;;; 8.2 Flat C99 LIR -> Pass 132 Braun SSA CFG Bridge (Issue #920)
;;; -----------------------------------------------------------------------

(define (%c99-ssa-cond-branch-target inst)
  (case (car inst)
    ((%jump-cond %jump-if-false) (caddr inst))
    ((%jump-if-zero) (cadr inst))
    (else #f)))

(define (%c99-ssa-rewrite-cond-branch inst new-tgt)
  (case (car inst)
    ((%jump-cond) (list '%jump-cond (cadr inst) new-tgt))
    ((%jump-if-false) (list '%jump-if-false (cadr inst) new-tgt))
    ((%jump-if-zero) (list '%jump-if-zero new-tgt))
    (else inst)))

(define (c99-lir-fn->braun-cfg fn-lir candidate-offsets)
  (let* ((fn-sym (list-ref fn-lir 1))
         (body-clause (assq 'body (cddr fn-lir)))
         (body-insts (if body-clause (cdr body-clause) '()))
         (entry-lbl (string->symbol (string-append (symbol->string fn-sym) "__entry")))
         (lbl-cnt-box (cons 0 '()))
         (next-cfg-lbl!
          (lambda (prefix)
            (let ((n (car lbl-cnt-box)))
              (set-car! lbl-cnt-box (+ n 1))
              (string->symbol
               (string-append ".L_ssa_" (symbol->string fn-sym) "_" prefix "_" (number->string n))))))
         (blocks-box (cons '() '()))
         (tramps-box (cons '() '()))
         (emit-blk! (lambda (lbl rev-insts term extra-edges)
                      (set-car! blocks-box
                                (cons (list lbl (reverse rev-insts) term (reverse extra-edges))
                                      (car blocks-box))))))
    ;; Pass 0: Split flat LIR into basic blocks with taken-edge trampolines for conditional jumps
    (let scan ((rest body-insts) (cur-lbl entry-lbl) (cur-insts '()) (cur-extra '()))
      (if (null? rest)
          (if cur-lbl
              (emit-blk! cur-lbl cur-insts '(%return) cur-extra))
          (let ((inst (car rest)))
            (cond
              ((not cur-lbl)
               ;; Inside unreachable code after an unconditional terminator: wait for next %label
               (if (and (pair? inst) (eq? (car inst) '%label))
                   (scan (cdr rest) (cadr inst) '() '())
                   (scan (cdr rest) #f '() '())))
              ((not (pair? inst))
               (scan (cdr rest) cur-lbl cur-insts cur-extra))
              ((eq? (car inst) '%label)
               (let ((next-lbl (cadr inst)))
                 (emit-blk! cur-lbl cur-insts (list '%jump next-lbl) cur-extra)
                 (scan (cdr rest) next-lbl '() '())))
              ((memq (car inst) '(%jump %direct-jump))
               (emit-blk! cur-lbl cur-insts (list '%jump (cadr inst)) cur-extra)
               (scan (cdr rest) #f '() '()))
              ((memq (car inst) '(%switch %return))
               (emit-blk! cur-lbl cur-insts inst cur-extra)
               (scan (cdr rest) #f '() '()))
              ((memq (car inst) '(%jump-cond %jump-if-zero %jump-if-false))
               (let* ((orig-tgt (%c99-ssa-cond-branch-target inst))
                      (tramp-lbl (next-cfg-lbl! "tramp"))
                      (rewritten (%c99-ssa-rewrite-cond-branch inst tramp-lbl))
                      (has-next-label? (and (pair? (cdr rest))
                                            (pair? (cadr rest))
                                            (eq? (caadr rest) '%label)))
                      (next-lbl (if has-next-label?
                                    (cadr (cadr rest))
                                    (next-cfg-lbl! "fall"))))
                 (emit-blk! cur-lbl
                            (cons rewritten cur-insts)
                            (list '%jump next-lbl)
                            (cons tramp-lbl cur-extra))
                 (set-car! tramps-box
                           (cons (list tramp-lbl '() (list '%jump orig-tgt) '())
                                 (car tramps-box)))
                 (if has-next-label?
                     (scan (cdr rest) #f '() '())
                     (scan (cdr rest) next-lbl '() '()))))
              (else
               (scan (cdr rest) cur-lbl (cons inst cur-insts) cur-extra))))))
    (let* ((main-blocks (reverse (car blocks-box)))
           (tramp-blocks (reverse (car tramps-box)))
           (all-blocks (append main-blocks tramp-blocks))
           (cfg (make-braun-cfg)))
      ;; Pass 1: Pre-create ALL basic blocks before emitting any instructions or edges
      (for-each (lambda (b) (braun-new-block! cfg (list-ref b 0))) all-blocks)
      ;; Pass 2: Emit non-terminator instructions, set terminators, and register extra edges
      (for-each
       (lambda (b)
         (let ((lbl (list-ref b 0))
               (insts (list-ref b 1))
               (term (list-ref b 2))
               (extras (list-ref b 3)))
           (for-each (lambda (ins) (braun-emit-inst! cfg lbl ins)) insts)
           (if term
               (begin
                 (braun-set-terminator! cfg lbl term)
                 (braun-auto-add-terminator-edges! cfg lbl term)))
           (for-each (lambda (ex) (braun-add-edge! cfg lbl ex)) extras)))
       all-blocks)
      ;; Selective mem2reg on non-escaped scalar stack offsets + delayed seal-block
      ;; Bypass promotion completely if function calls setjmp/returns_twice (ISO C99 §7.13.2.1)
      (if (and (pair? candidate-offsets)
               (pair? main-blocks)
               (not (braun-cfg-has-returns-twice? cfg)))
          (let ((first-lbl (list-ref (car main-blocks) 0)))
            (for-each
             (lambda (off)
               (let ((var (string->symbol (string-append "stk_" (number->string off)))))
                 (braun-write-variable! cfg var first-lbl 0)))
             candidate-offsets)
            (braun-promote-alloca-to-ssa cfg candidate-offsets)))
      (braun-seal-all-blocks! cfg)
      (braun-verify-cfg cfg)
      cfg)))

(define (c99-braun-ssa-transform-fn fn-lir candidate-offsets)
  (let* ((fn-sym (list-ref fn-lir 1))
         (params-clause (list-ref fn-lir 2))
         (frame-clause (list-ref fn-lir 3))
         (cfg (c99-lir-fn->braun-cfg fn-lir candidate-offsets))
         (ssa-blocks (braun-cfg->lir cfg)))
    (list '%lir-function
          fn-sym
          params-clause
          frame-clause
          (cons 'body ssa-blocks))))

(define (%c99-count-abi-reg-pieces ret-plan param-plans kind)
  (+ (if (and (eq? kind 'gpr) (eq? (car ret-plan) 'sret)) 1 0)
     (let loop ((ps param-plans) (k 0))
       (if (null? ps)
           k
           (let ((p (car ps)))
             (if (eq? (car p) 'regs)
                 (let ploop ((pcs (cadr p)) (kk k))
                   (if (null? pcs)
                       (loop (cdr ps) kk)
                       (ploop (cdr pcs) (if (eq? (caar pcs) kind) (+ kk 1) kk))))
                 (loop (cdr ps) k)))))))

(define (%c99-lower-function ctx fn-node globals)
  (let* ((fn-sym (list-ref fn-node 1))
         (ret-ty  (list-ref fn-node 2))
         (variadic? (list-ref fn-node 3))
         (params  (list-ref fn-node 4))
         (body    (list-ref fn-node 5))
         (param-tys (map caddr params))
         (abi (c99-plan-sysv-abi (lower-ctx-layout-env ctx) ret-ty param-tys))
         (ret-plan (car abi))
         (param-plans (cadr abi))
         (named-stack-bytes (caddr abi))
         (ret-lbl (%c99-lower-new-label ctx "ret")))
    (lower-ctx-vars-set! ctx '())
    (lower-ctx-insts-set! ctx '())
    (lower-ctx-cold-insts-set! ctx '())
    (lower-ctx-next-si-set! ctx -16)
    (lower-ctx-min-si-set! ctx -16)
    (lower-ctx-user-labels-set! ctx '())
    (lower-ctx-ret-lbl-set! ctx ret-lbl)
    (lower-ctx-ret-plan-set! ctx ret-plan)
    (lower-ctx-va-meta-set! ctx #f)
    (lower-ctx-gpr-temps-set! ctx *c99-gpr-temp-pool*)
    (lower-ctx-xmm-temps-set! ctx *c99-xmm-temp-pool*)
    (for-each
     (lambda (g)
       (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
     globals)
    ;; Variadic System V AMD64 Register Save Area prologue (176B at entry before sret/param spills)
    (if variadic?
        (let ((rsa-si (%c99-lower-alloc-bytes! ctx *sysv-va-reg-save-area-size* 16))
              (skip-xmm-lbl (%c99-lower-new-label ctx "va_skip_xmm"))
              (used-gpr (%c99-count-abi-reg-pieces ret-plan param-plans 'gpr))
              (used-xmm (%c99-count-abi-reg-pieces ret-plan param-plans 'sse)))
          (let sloop-g ((regs *sysv-gpr-arg-registers*) (off 0))
            (if (pair? regs)
                (begin
                  (%c99-lower-emit! ctx (list '%store '%rsp (+ rsa-si off) (car regs)))
                  (sloop-g (cdr regs) (+ off 8)))))
          (%c99-lower-emit! ctx '(%bit-and %rax 255))
          (%c99-lower-emit! ctx '(%cmp %rax 0))
          (%c99-lower-emit! ctx (list '%jump-cond 'je skip-xmm-lbl))
          (let sloop-x ((xregs *sysv-xmm-arg-registers*) (off *sysv-va-fp-base*))
            (if (pair? xregs)
                (begin
                  (%c99-lower-emit! ctx (list '%store-typed 'f64 '%rsp (+ rsa-si off) (car xregs)))
                  (sloop-x (cdr xregs) (+ off 16)))))
          (%c99-lower-emit! ctx (list '%label skip-xmm-lbl))
          (lower-ctx-va-meta-set!
           ctx
           (list rsa-si
                 (* 8 (min 6 used-gpr))
                 (+ *sysv-va-fp-base* (* 16 (min 8 used-xmm)))
                 (+ 8 named-stack-bytes)))))
    ;; Save hidden sret pointer if returning >16B struct
    (if (eq? (car ret-plan) 'sret)
        (let ((s-si (%c99-lower-alloc-slot! ctx)))
          (lower-ctx-sret-si-set! ctx s-si)
          (%c99-lower-emit! ctx (list '%store '%rsp s-si '%rdi)))
        (lower-ctx-sret-si-set! ctx #f))
    ;; Allocate local parameter slots & save incoming SysV args
    (let ((param-slots
           (%c99-map2
            (lambda (p plan)
              (let* ((u-sym (list-ref p 0))
                     (pty (list-ref p 2))
                     (si (%c99-lower-bind-local! ctx u-sym pty)))
                (if (eq? (car plan) 'regs)
                    (for-each
                     (lambda (pc)
                       (let ((kind (list-ref pc 0))
                             (reg (list-ref pc 1))
                             (off (list-ref pc 2))
                             (csz (list-ref pc 3)))
                         (if (eq? kind 'gpr)
                             (%c99-lower-store-chunk-gpr! ctx '%rsp (+ si off) reg csz)
                             (%c99-lower-emit! ctx (list '%store-typed (if (<= csz 4) 'f32 'f64) '%rsp (+ si off) reg)))))
                     (cadr plan)))
                (list si plan)))
            params param-plans)))
      ;; Copy stack-passed incoming args (callee sees caller arg at [rsp + 8 + st_off])
      (for-each
       (lambda (ps)
         (let ((si (car ps))
               (plan (cadr ps)))
           (if (eq? (car plan) 'stack)
               (let ((st-off (cadr plan))
                     (psz (caddr plan)))
                 (%c99-lower-memcpy-regs! ctx '%rsp si '%rsp (+ 8 st-off) psz)))))
       param-slots))
    (%c99-lower-stmt! ctx body)
    (%c99-lower-emit! ctx '(%mov %rax 0))
    (%c99-lower-emit! ctx (list '%label ret-lbl))
    (%c99-lower-emit! ctx '(%return))
    (let* ((used (- 0 (lower-ctx-min-si ctx)))
           (frame-sz (c-type-align-up (max 16 used) 16))
           (param-names (map cadr params))
           (cold (lower-ctx-cold-insts ctx))
           (full-body (if (null? cold)
                          (reverse (lower-ctx-insts ctx))
                          (append (reverse (lower-ctx-insts ctx)) (reverse cold)))))
      (list '%lir-function
            fn-sym
            (list 'params param-names)
            (list 'frame-size frame-sz)
            (cons 'body full-body)))))

;;; -----------------------------------------------------------------------
;;; 9. Static Global Initializer Serialization (.data / .bss / reloc)
;;; -----------------------------------------------------------------------

(define (%c99-eval-static-addr ctx node)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (case tag
      ((c-var-ref)
       (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
         (if (and ent (eq? (car ent) 'data-global))
             (list 'reloc (cadr ent) 0)
             #f)))
      ((c-fn-ref)
       (list 'reloc (%c99-lower-resolve-runtime-fn! ctx (cadr inner)) 0))
      ((c-str-val)
       (list 'reloc (%c99-lower-intern-str! ctx (cadr inner)) 0))
      ((c-member)
       (let* ((base (cadr inner))
              (deref? (cadddr inner))
              (fl (%c99-lower-member-field-layout ctx inner)))
         (if (or deref? (not fl) (c-field-layout-bit-width fl))
             #f
             (let ((baddr (%c99-eval-static-addr ctx base)))
               (if baddr
                   (list 'reloc (cadr baddr) (+ (caddr baddr) (c-field-layout-offset fl)))
                   #f)))))
      ((c-index)
       (let* ((arr (cadr inner))
              (idx-expr (caddr inner))
              (idx (%c99-lower-extract-const-int idx-expr))
              (elem-sz (c-type-size-in lenv (c-typed-type node)))
              (baddr (if (c-array-type? (c-typed-type arr))
                         (%c99-eval-static-addr ctx arr)
                         #f)))
         (if (and baddr idx)
             (list 'reloc (cadr baddr) (+ (caddr baddr) (* idx elem-sz)))
             #f)))
      ((c-compound-lit)
       ;; Serialize anonymous static compound literal to .data / .bss label
       (let* ((cl-ty (cadr inner))
              (plan (caddr inner))
              (lbl (%c99-lower-new-label ctx "s_clit")))
         (if (%c99-lower-emit-static-data-object! ctx lbl cl-ty plan)
             (list 'reloc lbl 0)
             #f)))
      ((c-implicit-cast c-cast)
       (%c99-eval-static-addr ctx (caddr inner)))
      (else #f))))

(define (%c99-static-fp? v)
  (and (pair? v) (eq? (car v) 'c-static-fp)))

(define (%c99-static-fp->inexact sfp)
  (if (eq? (cadr sfp) 'f32)
      (c99-ieee754-f32-bits->inexact (caddr sfp))
      (c99-ieee754-f64-bits->inexact (caddr sfp))))

(define (%c99-static-fp-zero? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (mask (if (eq? fty 'f32) #x7fffffff #x7fffffffffffffff)))
    (= (bitwise-and bits mask) 0)))

(define (%c99-static-fp-neg? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (shift (if (eq? fty 'f32) -31 -63)))
    (= (bitwise-and (arithmetic-shift bits shift) 1) 1)))

(define (%c99-static-fp-nan? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (exp (if (eq? fty 'f32)
                  (bitwise-and (arithmetic-shift bits -23) #xff)
                  (bitwise-and (arithmetic-shift bits -52) #x7ff)))
         (frac (if (eq? fty 'f32)
                   (bitwise-and bits #x7fffff)
                   (bitwise-and bits #xfffffffffffff))))
    (and (= exp (if (eq? fty 'f32) 255 2047))
         (not (= frac 0)))))

(define (%c99-static-fp-inf? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (exp (if (eq? fty 'f32)
                  (bitwise-and (arithmetic-shift bits -23) #xff)
                  (bitwise-and (arithmetic-shift bits -52) #x7ff)))
         (frac (if (eq? fty 'f32)
                   (bitwise-and bits #x7fffff)
                   (bitwise-and bits #xfffffffffffff))))
    (and (= exp (if (eq? fty 'f32) 255 2047))
         (= frac 0))))

(define (%c99-static-fp-div l r fty)
  (let ((lnan (%c99-static-fp-nan? l))
        (rnan (%c99-static-fp-nan? r))
        (lzero (%c99-static-fp-zero? l))
        (rzero (%c99-static-fp-zero? r))
        (lsgn (if (%c99-static-fp-neg? l) 1 0))
        (rsgn (if (%c99-static-fp-neg? r) 1 0))
        (f64? (eq? fty 'f64)))
    (let ((sgn (if (= lsgn rsgn) 0 1)))
      (cond
        ((or lnan rnan)
         (list 'c-static-fp fty (if f64? *c99-f64-qnan* *c99-f32-qnan*)))
        (rzero
         (if (or lzero (%c99-static-fp-inf? l))
             (if lzero
                 (list 'c-static-fp fty (if f64? *c99-f64-qnan* *c99-f32-qnan*))
                 (list 'c-static-fp fty (c99-ieee754-signed-inf sgn f64?)))
             (list 'c-static-fp fty (c99-ieee754-signed-inf sgn f64?))))
        ((and (%c99-static-fp-inf? l) (%c99-static-fp-inf? r))
         (list 'c-static-fp fty (if f64? *c99-f64-qnan* *c99-f32-qnan*)))
        (else
         (let ((res (/ (%c99-static-fp->inexact l) (%c99-static-fp->inexact r))))
           (list 'c-static-fp fty (if f64? (vm-f64->ieee754-u64 res) (vm-f32->ieee754-u32 res)))))))))

(define (%c99-eval-static-val ctx typed-expr)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (ty (c-typed-type typed-expr))
         (inner (c-typed-inner typed-expr))
         (tag (car inner)))
    (case tag
      ((c-const-val)
       (let ((v (cadr inner)))
         (if (and (pair? v) (eq? (car v) 'c-float-bits))
             (list 'c-static-fp ty (cadr v))
             v)))
      ((c-enum-const) (cadr inner))
      ((c-str-val)
       (list 'reloc (%c99-lower-intern-str! ctx (cadr inner)) 0))
      ((c-fn-ref)
       (list 'reloc (%c99-lower-resolve-runtime-fn! ctx (cadr inner)) 0))
      ((c-var-ref)
       (if (c-array-type? ty)
           (%c99-eval-static-addr ctx typed-expr)
           #f))
      ((c-implicit-cast c-cast)
       (let* ((target-ty (cadr inner))
              (sub (caddr inner))
              (src-ty (c-typed-type sub)))
         (cond
           ((and (c-pointer-type? target-ty) (or (c-array-type? src-ty) (c-function-type? src-ty)))
            (%c99-eval-static-addr ctx sub))
           (else
            (let ((sv (%c99-eval-static-val ctx sub)))
              (cond
                ((not sv) #f)
                ((and (pair? sv) (eq? (car sv) 'reloc)) sv) ; reloc pointer preserved across casts
                ((%c99-static-fp? sv)
                 (cond
                   ((c-float-type? target-ty)
                    (let ((sf-ty (cadr sv))
                          (sbits (caddr sv)))
                      (cond
                        ((eq? sf-ty target-ty) sv)
                        ((and (eq? sf-ty 'f32) (eq? target-ty 'f64))
                         (list 'c-static-fp 'f64 (c99-ieee754-f32-bits->f64-bits sbits)))
                        (else
                         (list 'c-static-fp 'f32 (c99-ieee754-f64-bits->f32-bits sbits))))))
                   ((eq? target-ty 'bool)
                    (if (%c99-static-fp-zero? sv) 0 1))
                   ((c-integer-type? target-ty)
                    (if (or (%c99-static-fp-nan? sv) (%c99-static-fp-inf? sv))
                        #f
                        (let ((iv (exact (truncate (%c99-static-fp->inexact sv)))))
                          (cond
                            ((c-type-size-in lenv target-ty)
                             => (lambda (nb)
                                  (let ((mask (arithmetic-shift 1 (* 8 nb))))
                                    (modulo iv mask))))
                            (else iv)))))
                   (else sv)))
                ((c-float-type? target-ty)
                 (if (integer? sv)
                     (let ((norm (if (c-unsigned-type? src-ty)
                                     (cond
                                       ((c-type-size-in lenv src-ty)
                                        => (lambda (nb) (modulo sv (arithmetic-shift 1 (* 8 nb)))))
                                       (else sv))
                                     sv)))
                       (list 'c-static-fp target-ty
                             (if (eq? target-ty 'f32)
                                 (c99-ieee754-int->f32-bits norm)
                                 (c99-ieee754-int->f64-bits norm))))
                     #f))
                ((c-integer-type? target-ty)
                 (let ((iv (if (inexact? sv) (exact (truncate sv)) sv)))
                   (cond
                     ((eq? target-ty 'bool) (if (= iv 0) 0 1))
                     ((c-type-size-in lenv target-ty)
                      => (lambda (nb)
                           (let ((mask (arithmetic-shift 1 (* 8 nb))))
                             (modulo iv mask))))
                     (else iv))))
                (else sv)))))))
      ((c-unop)
       (case (cadr inner)
         ((addr) (%c99-eval-static-addr ctx (caddr inner)))
         ((uplus) (%c99-eval-static-val ctx (caddr inner)))
         ((neg)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (cond
              ((%c99-static-fp? v)
               (list 'c-static-fp (cadr v)
                     (if (eq? (cadr v) 'f32)
                         (c99-ieee754-f32-bits-neg (caddr v))
                         (c99-ieee754-f64-bits-neg (caddr v)))))
              ((number? v) (- 0 v))
              (else #f))))
         ((bit-not)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (if (integer? v) (bitwise-not v) #f)))
         ((lnot)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (cond ((%c99-static-fp? v) (if (%c99-static-fp-zero? v) 1 0))
                  ((pair? v) 0)
                  ((number? v) (if (= v 0) 1 0))
                  (else #f))))
         (else #f)))
      ((c-binop)
       (let ((op (cadr inner))
             (l (%c99-eval-static-val ctx (caddr inner)))
             (r (%c99-eval-static-val ctx (cadddr inner)))
             (lty (c-typed-type (caddr inner)))
             (rty (c-typed-type (cadddr inner))))
         (cond
           ((and (pair? l) (eq? (car l) 'reloc) (integer? r) (memq op '(+ -)) (c-pointer-type? lty))
            (let ((sc (max 1 (c-type-size-in lenv (c-ptr-target lty)))))
              (list 'reloc (cadr l) (+ (caddr l) (* (if (eq? op '+) r (- 0 r)) sc)))))
           ((and (integer? l) (pair? r) (eq? (car r) 'reloc) (eq? op '+) (c-pointer-type? rty))
            (let ((sc (max 1 (c-type-size-in lenv (c-ptr-target rty)))))
              (list 'reloc (cadr r) (+ (caddr r) (* l sc)))))
           ((and (%c99-static-fp? l) (%c99-static-fp? r))
            (let ((fty (if (or (eq? (cadr l) 'f64) (eq? (cadr r) 'f64)) 'f64 'f32)))
              (cond
                ((eq? op '/) (%c99-static-fp-div l r fty))
                ((memq op '(== != < <= > >=))
                 (if (or (%c99-static-fp-nan? l) (%c99-static-fp-nan? r))
                     (if (eq? op '!=) 1 0)
                     (let ((f1 (%c99-static-fp->inexact l))
                           (f2 (%c99-static-fp->inexact r)))
                       (case op
                         ((==) (if (= f1 f2) 1 0))
                         ((!=) (if (= f1 f2) 0 1))
                         ((<)  (if (< f1 f2) 1 0))
                         ((<=) (if (<= f1 f2) 1 0))
                         ((>)  (if (> f1 f2) 1 0))
                         ((>=) (if (>= f1 f2) 1 0))))))
                ((memq op '(+ - *))
                 (let* ((f1 (%c99-static-fp->inexact l))
                        (f2 (%c99-static-fp->inexact r))
                        (res (case op ((+) (+ f1 f2)) ((-) (- f1 f2)) ((*) (* f1 f2)))))
                   (list 'c-static-fp fty
                         (if (eq? fty 'f64) (vm-f64->ieee754-u64 res) (vm-f32->ieee754-u32 res)))))
                (else #f))))
           ((and (number? l) (number? r))
            (case op
              ((+) (+ l r))
              ((-) (- l r))
              ((*) (* l r))
              ((/) (if (= r 0) #f (if (and (integer? l) (integer? r)) (quotient l r) (/ l r))))
              ((rem) (if (or (= r 0) (not (integer? l)) (not (integer? r))) #f (remainder l r)))
              ((<<) (arithmetic-shift l r))
              ((>>) (arithmetic-shift l (- 0 r)))
              ((bit-and) (bitwise-and l r))
              ((bit-or) (bitwise-ior l r))
              ((bit-xor) (bitwise-xor l r))
              ((==) (if (= l r) 1 0))
              ((!=) (if (= l r) 0 1))
              ((<) (if (< l r) 1 0))
              ((<=) (if (<= l r) 1 0))
              ((>) (if (> l r) 1 0))
              ((>=) (if (>= l r) 1 0))
              (else #f)))
           (else #f))))
      ((c-ternary)
       (let ((c (%c99-eval-static-val ctx (cadr inner))))
         (cond
           ((not c) #f)
           ((or (and (%c99-static-fp? c) (not (%c99-static-fp-zero? c)))
                (and (pair? c) (eq? (car c) 'reloc))
                (and (number? c) (not (= c 0))))
            (%c99-eval-static-val ctx (caddr inner)))
           (else
            (%c99-eval-static-val ctx (cadddr inner))))))
      (else #f))))

(define (%c99-bv-write-bytes! bv off byte-list)
  (let loop ((i 0) (bs byte-list))
    (if (pair? bs)
        (begin
          (bytevector-u8-set! bv (+ off i) (modulo (car bs) 256))
          (loop (+ i 1) (cdr bs))))))

(define (%c99-bv-write-bitfield! bv su-off su-bytes bit-off bit-w val)
  (if (> bit-w 0)
      (let ((cur (let rloop ((k (- su-bytes 1)) (acc 0))
                   (if (< k 0) acc (rloop (- k 1) (+ (* acc 256) (bytevector-u8-ref bv (+ su-off k)))))))
            (mask (- (arithmetic-shift 1 bit-w) 1)))
        (let* ((f-bits (modulo (if (inexact? val) (exact (truncate val)) val) (+ mask 1)))
               (cleared (bitwise-and cur (bitwise-not (arithmetic-shift mask bit-off))))
               (updated (bitwise-ior cleared (arithmetic-shift f-bits bit-off))))
          (%c99-bv-write-bytes! bv su-off (c99-int->le-bytes updated su-bytes))))))

(define (%c99-serialize-bv-to-chunks bv sz relocs)
  (let* ((all-zero? (and (null? relocs)
                         (let zc ((i 0))
                           (cond ((>= i sz) #t)
                                 ((not (= (bytevector-u8-ref bv i) 0)) #f)
                                 (else (zc (+ i 1))))))))
    (if all-zero?
        'bss
        (let loop ((i 0) (chunks '()))
          (cond
            ((>= i sz) (reverse chunks))
            ((assv i relocs)
             => (lambda (slot)
                  (loop (+ i 8) (cons (cdr slot) chunks))))
            ((= (bytevector-u8-ref bv i) 0)
             (let zscan ((j i))
               (if (and (< j sz)
                        (not (assv j relocs))
                        (= (bytevector-u8-ref bv j) 0))
                   (zscan (+ j 1))
                   (let ((zlen (- j i)))
                     (if (>= zlen 4)
                         (loop j (cons (list 'zero zlen) chunks))
                         (let eloop ((k i) (acc chunks))
                           (if (>= k j)
                               (loop j acc)
                               (eloop (+ k 1) (cons 0 acc)))))))))
            (else
             (loop (+ i 1) (cons (bytevector-u8-ref bv i) chunks))))))))

(define (%c99-filter-relocs-out relocs lo hi)
  (let loop ((rs relocs) (acc '()))
    (if (null? rs)
        (reverse acc)
        (let ((pos (caar rs)))
          (if (and (>= pos lo) (< pos hi))
              (loop (cdr rs) acc)
              (loop (cdr rs) (cons (car rs) acc)))))))

(define (%c99-lower-emit-static-data-object! ctx lbl ty init-node)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (sz (max 1 (c-type-size-in lenv ty)))
         (al (max 1 (c-type-align-in lenv ty))))
    (if (not init-node)
        (begin
          (%c99-lower-add-data-entry! ctx (list 'bss lbl al sz))
          #t)
        (let* ((bv (make-bytevector sz 0))
               (relocs-box (cons '() '()))
               (ok-box (cons #t '()))
               (inner (c-typed-inner init-node))
               (entries (if (eq? (car inner) 'c-init-plan)
                            (caddr inner)
                            (list (list 'set 0 #f #f #f #f ty init-node)))))
          (for-each
           (lambda (ent)
             (if (car ok-box)
                 (if (eq? (car ent) 'zero-range)
                     (let ((zoff (cadr ent))
                           (zsz (caddr ent)))
                       (set-car! relocs-box (%c99-filter-relocs-out (car relocs-box) zoff (+ zoff zsz)))
                       (let zl ((k 0))
                         (if (< k zsz)
                             (begin (bytevector-u8-set! bv (+ zoff k) 0) (zl (+ k 1))))))
                     (let* ((byte-off (list-ref ent 1))
                            (bit-off  (list-ref ent 2))
                            (bit-w    (list-ref ent 3))
                            (su-off   (list-ref ent 4))
                            (su-ty    (list-ref ent 5))
                            (fty      (list-ref ent 6))
                            (val-expr (list-ref ent 7))
                            (sval     (%c99-eval-static-val ctx val-expr)))
                       (cond
                         ((not sval)
                          (set-car! ok-box #f))
                         (bit-w
                          (let ((su-bytes (c-type-size-in lenv su-ty)))
                            (if (integer? sval)
                                (%c99-bv-write-bitfield! bv su-off su-bytes bit-off bit-w sval)
                                (set-car! ok-box #f))))
                         ((and (pair? sval) (eq? (car sval) 'reloc))
                          (set-car! relocs-box (cons (cons byte-off sval)
                                                     (%c99-filter-relocs-out (car relocs-box) byte-off (+ byte-off 8)))))
                         ((c-float-type? fty)
                          (%c99-bv-write-bytes! bv byte-off
                                                (if (eq? fty 'f32)
                                                    (c99-f32->le-bytes sval)
                                                    (c99-f64->le-bytes sval))))
                         (else
                          (let ((nb (max 1 (c-type-size-in lenv fty))))
                            (%c99-bv-write-bytes! bv byte-off (c99-int->le-bytes (exact (truncate sval)) nb)))))))))
           entries)
          (if (not (car ok-box))
              #f
              (let ((chunks (%c99-serialize-bv-to-chunks bv sz (car relocs-box))))
                (if (eq? chunks 'bss)
                    (%c99-lower-add-data-entry! ctx (list 'bss lbl al sz))
                    (%c99-lower-add-data-entry! ctx (cons 'bytes (cons lbl (cons al chunks)))))
                #t))))))

;;; -----------------------------------------------------------------------
;;; 10. Top-Level Lowering Entrypoint -> L_lir_core %lir-program
;;; -----------------------------------------------------------------------

(define (c99-lower-to-lir typed-unit . maybe-opts)
  (let* ((opts (if (pair? maybe-opts) (car maybe-opts) '()))
         (san? (cond
                 ((boolean? opts) opts)
                 ((pair? opts)
                  (let ((hit (assq 'sanitize-bounds? opts)))
                    (if (and hit (cdr hit)) #t #f)))
                 (else #f)))
         (globals (cadr typed-unit))
         (funcs   (caddr typed-unit))
         (layout-env (if (pair? (cdddr typed-unit)) (list-ref typed-unit 3) #f))
         (ext-meta (if (>= (length typed-unit) 5) (list-ref typed-unit 4) '()))
         (fn-names (map (lambda (f) (list-ref f 1)) funcs))
         (ctx (make-c99-lower-ctx fn-names layout-env san?)))
    ;; Pre-bind globals so static address-of (&g) initializers resolve forward/mutual refs
    (lower-ctx-vars-set! ctx '())
    (for-each
     (lambda (g)
       (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
     globals)
    ;; Serialize static/global definitions into (data ...), deferring any non-constant init
    (let ((deferred-box (cons '() '())))
      (for-each
       (lambda (g)
         (let ((u-sym (list-ref g 1))
               (ty    (list-ref g 3))
               (link  (list-ref g 4))
               (init  (list-ref g 5)))
           (if (not (eq? link 'extern))
               (if (not (%c99-lower-emit-static-data-object! ctx u-sym ty init))
                   (begin
                     (%c99-lower-emit-static-data-object! ctx u-sym ty #f)
                     (set-car! deferred-box (cons g (car deferred-box))))))))
       globals)
      ;; Lower functions (functions also collect any string literals & static compound lits)
      (let ((lir-funcs (map (lambda (f) (%c99-lower-function ctx f globals)) funcs)))
        ;; Build %lir-main for deferred runtime global inits + C main() invocation
        (lower-ctx-vars-set! ctx '())
        (lower-ctx-insts-set! ctx '())
        (lower-ctx-cold-insts-set! ctx '())
        (lower-ctx-next-si-set! ctx -16)
        (lower-ctx-min-si-set! ctx -16)
        (lower-ctx-ret-plan-set! ctx '(gpr %rax 0 8))
        (lower-ctx-gpr-temps-set! ctx *c99-gpr-temp-pool*)
        (lower-ctx-xmm-temps-set! ctx *c99-xmm-temp-pool*)
        (for-each
         (lambda (g)
           (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
         globals)
        (for-each
         (lambda (g)
           (let ((u-sym (list-ref g 1))
                 (ty    (list-ref g 3))
                 (init  (list-ref g 5)))
             (cond
               ((%c99-lower-aggregate-like? ty)
                (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
                  (%c99-lower-emit! ctx (list '%global-addr '%rax u-sym))
                  (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
                  (%c99-lower-expr-to-ptr-slot! ctx init ptr-si)))
               ((c-float-type? ty)
                (%c99-lower-expr! ctx init)
                (%c99-lower-emit! ctx (list '%global-addr '%rdx u-sym))
                (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0)))
               (else
                (%c99-lower-expr! ctx init)
                (%c99-lower-store-var! ctx (cdr (assq u-sym (lower-ctx-vars ctx))))))))
         (reverse (car deferred-box)))
        (if (memq 'main fn-names)
            (begin
              (%c99-lower-emit! ctx '(%mov %rdi 0))
              (%c99-lower-emit! ctx '(%mov %rsi 0))
              (%c99-lower-emit! ctx '(%direct-call main 8)))
            (%c99-lower-emit! ctx '(%mov %rax 0)))
        (%c99-lower-emit! ctx '(%return %rax))
        (let* ((main-frame (c-type-align-up (max 16 (- 0 (lower-ctx-min-si ctx))) 16))
               (data-list (reverse (lower-ctx-data-entries ctx)))
               (str-list (reverse (lower-ctx-strings ctx)))
               (builtin-fns
                (append
                 (if (and (lower-ctx-needs-setjmp? ctx) (not (memq '__ulisp_setjmp fn-names)))
                     (list (make-c99-builtin-setjmp-lir))
                     '())
                 (append
                  (if (and (lower-ctx-needs-longjmp? ctx) (not (memq '__ulisp_longjmp fn-names)))
                      (list (make-c99-builtin-longjmp-lir))
                      '())
                  (if (and (lower-ctx-needs-san-trap? ctx) (not (memq '__ulisp_san_trap fn-names)))
                      (list (make-c99-builtin-san-trap-lir))
                      '()))))
               (funcs-clause (cons '%lir-functions (append lir-funcs builtin-fns)))
               (main-cold (lower-ctx-cold-insts ctx))
               (main-body (if (null? main-cold)
                              (reverse (lower-ctx-insts ctx))
                              (append (reverse (lower-ctx-insts ctx)) (reverse main-cold))))
               (main-clause (list '%lir-main
                                  (list 'frame-size main-frame)
                                  (cons 'body main-body)))
               (wf-hit (assq 'weak-fns ext-meta))
               (wd-hit (assq 'weak-data ext-meta))
               (al-hit (assq 'aliases ext-meta))
               (ta-hit (assq 'top-asm ext-meta))
               (wf-list (if (and wf-hit (pair? (cdr wf-hit))) (cdr wf-hit) '()))
               (wd-list (if (and wd-hit (pair? (cdr wd-hit))) (cdr wd-hit) '()))
               (al-list (if (and al-hit (pair? (cdr al-hit))) (cdr al-hit) '()))
               (ta-raws (if (and ta-hit (pair? (cdr ta-hit))) (cdr ta-hit) '()))
               (ta-lines
                (let tloop ((xs ta-raws) (acc '()))
                  (if (null? xs)
                      acc
                      (tloop (cdr xs) (append acc (c99-att-asm->intel-asm (car xs) #t))))))
               (meta-clauses
                (append
                 (if (pair? wf-list) (list (list 'weak-fns wf-list)) '())
                 (append
                  (if (pair? wd-list) (list (list 'weak-data wd-list)) '())
                  (append
                   (if (pair? al-list) (list (list 'aliases al-list)) '())
                   (if (pair? ta-lines) (list (list 'top-asm ta-lines)) '())))))
               (base-prog
                (if (null? data-list)
                    (list '%lir-program (list 'strings str-list) '(stackmaps ()) funcs-clause main-clause)
                    (list '%lir-program (list 'strings str-list) (list 'data data-list) '(stackmaps ()) funcs-clause main-clause))))
          (append base-prog meta-clauses))))))

(define (c99-compile-string-to-lir src-text . maybe-opts)
  (let* ((fname (if (and (pair? maybe-opts) (string? (car maybe-opts)))
                    (car maybe-opts)
                    "<c99-input>"))
         (lower-opts (if (and (pair? maybe-opts) (pair? (cdr maybe-opts)))
                         (cadr maybe-opts)
                         '()))
         (ast (parse-c99-preprocessed-string src-text fname))
         (typed (c99-analyze-program ast)))
    (c99-lower-to-lir typed lower-opts)))
