;;; =======================================================================
;;; ULisp C99 Frontend: L_c_typed -> Core Machine LIR Lowering Engine
;;; Conforms to DSN-33-11 §4.3, DSN-33-13 §2.1/§3.2/§4.1, DSN-33-32,
;;; Issue #916 and Issue #918 (Struct/Union/Enum/Bitfield/SysV ABI).
;;; Emits pure Core Machine LIR (L_lir_core) verified by lir_verifier.scm
;;; and executable on Reference VM (#834), x86-64 ELF, and C backends.
;;; Zero local `set!` (ULisp AOT safe).
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. Lowering Context (<c99-lower-ctx>)
;;; -----------------------------------------------------------------------

(define-record-type <c99-lower-ctx>
  (%make-lower-ctx vars strings data-entries str-cnt lbl-cnt insts next-si min-si
                   internal-fns layout-env ret-lbl ret-plan sret-si
                   break-lbl continue-lbl user-labels)
  c99-lower-ctx?
  (vars         lower-ctx-vars         lower-ctx-vars-set!)
  (strings      lower-ctx-strings      lower-ctx-strings-set!)
  (data-entries lower-ctx-data-entries lower-ctx-data-entries-set!)
  (str-cnt      lower-ctx-str-cnt      lower-ctx-str-cnt-set!)
  (lbl-cnt      lower-ctx-lbl-cnt      lower-ctx-lbl-cnt-set!)
  (insts        lower-ctx-insts        lower-ctx-insts-set!)
  (next-si      lower-ctx-next-si      lower-ctx-next-si-set!)
  (min-si       lower-ctx-min-si       lower-ctx-min-si-set!)
  (internal-fns lower-ctx-internal-fns lower-ctx-internal-fns-set!)
  (layout-env   lower-ctx-layout-env   lower-ctx-layout-env-set!)
  (ret-lbl      lower-ctx-ret-lbl      lower-ctx-ret-lbl-set!)
  (ret-plan     lower-ctx-ret-plan     lower-ctx-ret-plan-set!)
  (sret-si      lower-ctx-sret-si      lower-ctx-sret-si-set!)
  (break-lbl    lower-ctx-break-lbl    lower-ctx-break-lbl-set!)
  (continue-lbl lower-ctx-continue-lbl lower-ctx-continue-lbl-set!)
  (user-labels  lower-ctx-user-labels  lower-ctx-user-labels-set!))

(define (make-c99-lower-ctx internal-fns layout-env)
  (%make-lower-ctx '() '() '() 0 0 '() -16 -16 internal-fns
                   (or layout-env (make-c99-layout-env))
                   #f '(void) #f #f #f '()))

(define (%c99-lower-emit! ctx inst)
  (lower-ctx-insts-set! ctx (cons inst (lower-ctx-insts ctx))))

(define (%c99-lower-new-label ctx prefix)
  (let ((n (lower-ctx-lbl-cnt ctx)))
    (lower-ctx-lbl-cnt-set! ctx (+ n 1))
    (string->symbol (string-append ".L_c99_" prefix "_" (number->string n)))))

(define (%c99-lower-user-label ctx c-lbl)
  (let ((slot (assq c-lbl (lower-ctx-user-labels ctx))))
    (if slot
        (cdr slot)
        (let ((lbl (%c99-lower-new-label ctx (string-append "u_" (symbol->string c-lbl)))))
          (lower-ctx-user-labels-set! ctx (cons (cons c-lbl lbl) (lower-ctx-user-labels ctx)))
          lbl))))

(define (%c99-lower-alloc-slot! ctx)
  (let ((si (lower-ctx-next-si ctx)))
    (lower-ctx-next-si-set! ctx (- si 8))
    (if (< si (lower-ctx-min-si ctx))
        (lower-ctx-min-si-set! ctx si))
    si))

(define (%c99-lower-alloc-bytes! ctx sz align)
  (let* ((alloc-sz (max 8 (c-type-align-up (max 1 sz) 8)))
         (a (max 8 align))
         (free-top (+ (lower-ctx-next-si ctx) 8))
         (raw-start (- free-top alloc-sz))
         (rem (modulo raw-start a))
         (base-si (if (= rem 0) raw-start (- raw-start rem))))
    (lower-ctx-next-si-set! ctx (- base-si 8))
    (if (< base-si (lower-ctx-min-si ctx))
        (lower-ctx-min-si-set! ctx base-si))
    base-si))

(define (%c99-list-tail ls k)
  (if (or (<= k 0) (not (pair? ls)))
      ls
      (%c99-list-tail (cdr ls) (- k 1))))

(define (%c99-lower-intern-str! ctx str-val)
  (let ((n (lower-ctx-str-cnt ctx)))
    (lower-ctx-str-cnt-set! ctx (+ n 1))
    (let ((lbl (string->symbol (string-append ".L_cstr_" (number->string n)))))
      (lower-ctx-strings-set! ctx (cons (list lbl str-val) (lower-ctx-strings ctx)))
      lbl)))

(define (%c99-lower-add-data-entry! ctx entry)
  (lower-ctx-data-entries-set! ctx (cons entry (lower-ctx-data-entries ctx))))

(define (%c99-lower-bind-local! ctx u-sym ty)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (sz (c-type-size-in lenv ty))
         (al (c-type-align-in lenv ty))
         (si (%c99-lower-alloc-bytes! ctx sz al)))
    (lower-ctx-vars-set! ctx (cons (list u-sym 'local si ty) (lower-ctx-vars ctx)))
    si))

(define (%c99-lower-bind-data-global! ctx u-sym ty)
  (lower-ctx-vars-set! ctx (cons (list u-sym 'data-global u-sym ty) (lower-ctx-vars ctx))))

(define (%c99-lower-lookup-var ctx u-sym)
  (let ((slot (assq u-sym (lower-ctx-vars ctx))))
    (if slot (cdr slot) #f)))

;;; -----------------------------------------------------------------------
;;; 2. Type Size/Width Normalization, Shifts, Memory & Float Helpers
;;; -----------------------------------------------------------------------

(define (%c99-lower-type-size ctx ty)
  (c-type-size-in (lower-ctx-layout-env ctx) ty))

(define (%c99-lower-type-align ctx ty)
  (max 1 (c-type-align-in (lower-ctx-layout-env ctx) ty)))

(define (%c99-lower-aggregate-like? ty)
  (or (c-struct-ref-type? ty)
      (c-union-ref-type? ty)
      (c-array-type? ty)))

(define (%c99-lower-emit-cast! ctx to-ty)
  (case to-ty
    ((bool)
     (let ((l-zero (%c99-lower-new-label ctx "bool_z"))
           (l-done (%c99-lower-new-label ctx "bool_d")))
       (%c99-lower-emit! ctx '(%cmp %rax 0))
       (%c99-lower-emit! ctx (list '%jump-cond 'je l-zero))
       (%c99-lower-emit! ctx '(%mov %rax 1))
       (%c99-lower-emit! ctx (list '%direct-jump l-done))
       (%c99-lower-emit! ctx (list '%label l-zero))
       (%c99-lower-emit! ctx '(%mov %rax 0))
       (%c99-lower-emit! ctx (list '%label l-done))))
    ((i8)  (%c99-lower-emit! ctx '(%sext i8 %rax %rax)))
    ((u8)  (%c99-lower-emit! ctx '(%zext u8 %rax %rax)))
    ((i16) (%c99-lower-emit! ctx '(%sext i16 %rax %rax)))
    ((u16) (%c99-lower-emit! ctx '(%zext u16 %rax %rax)))
    ((i32) (%c99-lower-emit! ctx '(%sext i32 %rax %rax)))
    ((u32) (%c99-lower-emit! ctx '(%zext u32 %rax %rax)))
    (else #f)))

(define (%c99-lower-emit-u64-const! ctx dst-reg uval)
  (let ((lo (modulo uval 4294967296))
        (hi (modulo (quotient uval 4294967296) 4294967296)))
    (if (and (= hi 0) (< lo 2147483648))
        (%c99-lower-emit! ctx (list '%mov dst-reg lo))
        (let ((tmp (%c99-lower-alloc-slot! ctx)))
          (%c99-lower-emit! ctx (list '%mov dst-reg (modulo lo 4294967296)))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 '%rsp tmp dst-reg))
          (%c99-lower-emit! ctx (list '%mov dst-reg (modulo hi 4294967296)))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 '%rsp (+ tmp 4) dst-reg))
          (%c99-lower-emit! ctx (list '%load dst-reg '%rsp tmp))))))

(define (%c99-lower-emit-float-const! ctx flt ty)
  (let ((tmp (%c99-lower-alloc-slot! ctx)))
    (if (eq? ty 'f32)
        (let ((bits (vm-f32->ieee754-u32 flt)))
          (%c99-lower-emit! ctx (list '%mov '%rax bits))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 '%rsp tmp '%rax))
          (%c99-lower-emit! ctx (list '%load-typed 'f32 '%xmm0 '%rsp tmp)))
        (let* ((bits (vm-f64->ieee754-u64 flt))
               (lo (modulo bits 4294967296))
               (hi (quotient bits 4294967296)))
          (%c99-lower-emit! ctx (list '%mov '%rax lo))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 '%rsp tmp '%rax))
          (%c99-lower-emit! ctx (list '%mov '%rax hi))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 '%rsp (+ tmp 4) '%rax))
          (%c99-lower-emit! ctx (list '%load-typed 'f64 '%xmm0 '%rsp tmp))))))

(define (%c99-lower-load-from-mem! ctx dst-reg base-reg disp ty)
  (cond
    ((c-float-type? ty)
     (%c99-lower-emit! ctx (list '%load-typed ty dst-reg base-reg disp)))
    ((memq ty '(bool i8 u8 i16 u16 i32 u32))
     (%c99-lower-emit! ctx (list '%load-typed (c-type->lir-ty ty) dst-reg base-reg disp)))
    ((c-enum-type? ty)
     (%c99-lower-emit! ctx (list '%load-typed 'i32 dst-reg base-reg disp)))
    (else
     (%c99-lower-emit! ctx (list '%load dst-reg base-reg disp)))))

(define (%c99-lower-store-to-mem! ctx base-reg disp src-reg ty)
  (cond
    ((c-float-type? ty)
     (%c99-lower-emit! ctx (list '%store-typed ty base-reg disp src-reg)))
    ((memq ty '(bool i8 u8 i16 u16 i32 u32))
     (%c99-lower-emit! ctx (list '%store-typed (c-type->lir-ty ty) base-reg disp src-reg)))
    ((c-enum-type? ty)
     (%c99-lower-emit! ctx (list '%store-typed 'i32 base-reg disp src-reg)))
    (else
     (%c99-lower-emit! ctx (list '%store base-reg disp src-reg)))))

(define (%c99-lower-memzero! ctx base-reg base-off sz)
  (cond
    ((<= sz 0) #f)
    ((> sz 64)
     (let ((qwords (quotient sz 8))
           (rem (modulo sz 8))
           (loop-lbl (%c99-lower-new-label ctx "mz_l"))
           (done-lbl (%c99-lower-new-label ctx "mz_d")))
       (if (not (eq? base-reg '%rdx))
           (%c99-lower-emit! ctx (list '%mov '%rdx base-reg)))
       (if (not (= base-off 0))
           (%c99-lower-emit! ctx (list '%add '%rdx base-off)))
       (%c99-lower-emit! ctx (list '%mov '%rcx qwords))
       (%c99-lower-emit! ctx '(%mov %rax 0))
       (%c99-lower-emit! ctx (list '%label loop-lbl))
       (%c99-lower-emit! ctx '(%cmp %rcx 0))
       (%c99-lower-emit! ctx (list '%jump-cond 'je done-lbl))
       (%c99-lower-emit! ctx '(%store %rdx 0 %rax))
       (%c99-lower-emit! ctx '(%add %rdx 8))
       (%c99-lower-emit! ctx '(%sub %rcx 1))
       (%c99-lower-emit! ctx (list '%direct-jump loop-lbl))
       (%c99-lower-emit! ctx (list '%label done-lbl))
       (%c99-lower-memzero! ctx '%rdx 0 rem)))
    (else
     (%c99-lower-emit! ctx '(%mov %rax 0))
     (let loop ((off base-off) (rem sz))
       (cond
         ((>= rem 8)
          (%c99-lower-emit! ctx (list '%store base-reg off '%rax))
          (loop (+ off 8) (- rem 8)))
         ((>= rem 4)
          (%c99-lower-emit! ctx (list '%store-typed 'u32 base-reg off '%rax))
          (loop (+ off 4) (- rem 4)))
         ((>= rem 2)
          (%c99-lower-emit! ctx (list '%store-typed 'u16 base-reg off '%rax))
          (loop (+ off 2) (- rem 2)))
         ((>= rem 1)
          (%c99-lower-emit! ctx (list '%store-typed 'u8 base-reg off '%rax))
          (loop (+ off 1) (- rem 1))))))))

;; Copies sz bytes from [src-reg + src-off] into [dst-reg + dst-off].
;; May clobber %rax, %r8, %r9, %r10, %r11. Preserves/reloads if >64 via ptr slots.
(define (%c99-lower-memcpy-regs! ctx dst-reg dst-off src-reg src-off sz)
  (cond
    ((<= sz 0) #f)
    ((> sz 64)
     (let ((dst-si (%c99-lower-alloc-slot! ctx))
           (src-si (%c99-lower-alloc-slot! ctx))
           (qwords (quotient sz 8))
           (rem (modulo sz 8))
           (loop-lbl (%c99-lower-new-label ctx "mc_l"))
           (done-lbl (%c99-lower-new-label ctx "mc_d")))
       (%c99-lower-emit! ctx (list '%mov '%rax dst-reg))
       (if (not (= dst-off 0)) (%c99-lower-emit! ctx (list '%add '%rax dst-off)))
       (%c99-lower-emit! ctx (list '%store '%rsp dst-si '%rax))
       (%c99-lower-emit! ctx (list '%mov '%rax src-reg))
       (if (not (= src-off 0)) (%c99-lower-emit! ctx (list '%add '%rax src-off)))
       (%c99-lower-emit! ctx (list '%store '%rsp src-si '%rax))
       (%c99-lower-emit! ctx (list '%load '%r8 '%rsp dst-si))
       (%c99-lower-emit! ctx (list '%load '%r9 '%rsp src-si))
       (%c99-lower-emit! ctx (list '%mov '%r10 qwords))
       (%c99-lower-emit! ctx (list '%label loop-lbl))
       (%c99-lower-emit! ctx '(%cmp %r10 0))
       (%c99-lower-emit! ctx (list '%jump-cond 'je done-lbl))
       (%c99-lower-emit! ctx '(%load %rax %r9 0))
       (%c99-lower-emit! ctx '(%store %r8 0 %rax))
       (%c99-lower-emit! ctx '(%add %r9 8))
       (%c99-lower-emit! ctx '(%add %r8 8))
       (%c99-lower-emit! ctx '(%sub %r10 1))
       (%c99-lower-emit! ctx (list '%direct-jump loop-lbl))
       (%c99-lower-emit! ctx (list '%label done-lbl))
       (%c99-lower-memcpy-regs! ctx '%r8 0 '%r9 0 rem)))
    (else
     (let loop ((k 0) (rem sz))
       (cond
         ((>= rem 8)
          (%c99-lower-emit! ctx (list '%load '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store dst-reg (+ dst-off k) '%rax))
          (loop (+ k 8) (- rem 8)))
         ((>= rem 4)
          (%c99-lower-emit! ctx (list '%load-typed 'u32 '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store-typed 'u32 dst-reg (+ dst-off k) '%rax))
          (loop (+ k 4) (- rem 4)))
         ((>= rem 2)
          (%c99-lower-emit! ctx (list '%load-typed 'u16 '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store-typed 'u16 dst-reg (+ dst-off k) '%rax))
          (loop (+ k 2) (- rem 2)))
         ((>= rem 1)
          (%c99-lower-emit! ctx (list '%load-typed 'u8 '%rax src-reg (+ src-off k)))
          (%c99-lower-emit! ctx (list '%store-typed 'u8 dst-reg (+ dst-off k) '%rax))
          (loop (+ k 1) (- rem 1))))))))

;; Load 1..8 bytes from [base-reg + base-off] into dst-gpr (exact byte count, never OOB).
(define (%c99-lower-load-chunk-gpr! ctx dst-reg base-reg base-off csz)
  (cond
    ((= csz 8) (%c99-lower-emit! ctx (list '%load dst-reg base-reg base-off)))
    ((= csz 4) (%c99-lower-emit! ctx (list '%load-typed 'u32 dst-reg base-reg base-off)))
    ((= csz 2) (%c99-lower-emit! ctx (list '%load-typed 'u16 dst-reg base-reg base-off)))
    ((= csz 1) (%c99-lower-emit! ctx (list '%load-typed 'u8 dst-reg base-reg base-off)))
    (else
     (let ((safe-base (if (or (eq? base-reg dst-reg) (eq? base-reg '%rax) (eq? base-reg '%r10))
                          (begin
                            (%c99-lower-emit! ctx (list '%mov '%r11 base-reg))
                            '%r11)
                          base-reg)))
       (%c99-lower-emit! ctx '(%mov %rax 0))
       (let loop ((k (- csz 1)))
         (if (>= k 0)
             (begin
               (if (< k (- csz 1))
                   (%c99-lower-emit! ctx '(%shl %rax 8)))
               (%c99-lower-emit! ctx (list '%load-typed 'u8 '%r10 safe-base (+ base-off k)))
               (%c99-lower-emit! ctx '(%bit-or %rax %r10))
               (loop (- k 1)))))
       (if (not (eq? dst-reg '%rax))
           (%c99-lower-emit! ctx (list '%mov dst-reg '%rax)))))))

;; Store 1..8 bytes from src-gpr into [base-reg + base-off] (never OOB). Clobbers %rax, %r11.
(define (%c99-lower-store-chunk-gpr! ctx base-reg base-off src-reg csz)
  (cond
    ((= csz 8) (%c99-lower-emit! ctx (list '%store base-reg base-off src-reg)))
    ((= csz 4) (%c99-lower-emit! ctx (list '%store-typed 'u32 base-reg base-off src-reg)))
    ((= csz 2) (%c99-lower-emit! ctx (list '%store-typed 'u16 base-reg base-off src-reg)))
    ((= csz 1) (%c99-lower-emit! ctx (list '%store-typed 'u8 base-reg base-off src-reg)))
    (else
     (let ((safe-base (if (eq? base-reg '%rax)
                          (begin
                            (%c99-lower-emit! ctx '(%mov %r11 %rax))
                            '%r11)
                          base-reg)))
       (if (not (eq? src-reg '%rax))
           (%c99-lower-emit! ctx (list '%mov '%rax src-reg)))
       (let loop ((k 0))
         (if (< k csz)
             (begin
               (%c99-lower-emit! ctx (list '%store-typed 'u8 safe-base (+ base-off k) '%rax))
               (if (< (+ k 1) csz)
                   (%c99-lower-emit! ctx '(%shr %rax 8)))
               (loop (+ k 1)))))))))

(define (%c99-lower-extract-const-int typed-expr)
  (let ((inner (c-typed-inner typed-expr)))
    (cond
      ((and (pair? inner) (eq? (car inner) 'c-const-val) (integer? (cadr inner)))
       (cadr inner))
      ((and (pair? inner) (eq? (car inner) 'c-enum-const))
       (cadr inner))
      ((and (pair? inner) (eq? (car inner) 'c-implicit-cast))
       (%c99-lower-extract-const-int (caddr inner)))
      (else #f))))

(define (%c99-lower-emit-var-shift! ctx shift-op mask-64?)
  (let loop ((bit-val 1) (limit (if mask-64? 32 16)))
    (if (<= bit-val limit)
        (let ((skip-lbl (%c99-lower-new-label ctx "sh_skip")))
          (%c99-lower-emit! ctx '(%mov %rdx %rcx))
          (%c99-lower-emit! ctx (list '%bit-and '%rdx bit-val))
          (%c99-lower-emit! ctx '(%cmp %rdx 0))
          (%c99-lower-emit! ctx (list '%jump-cond 'je skip-lbl))
          (%c99-lower-emit! ctx (list shift-op '%rax bit-val))
          (%c99-lower-emit! ctx (list '%label skip-lbl))
          (loop (* bit-val 2) limit)))))

;;; -----------------------------------------------------------------------
;;; 3. Field Resolution & Bit-Field Read/Write Helpers
;;; -----------------------------------------------------------------------

(define (%c99-lower-member-field-layout ctx member-inner)
  (let* ((base (cadr member-inner))
         (fsym (caddr member-inner))
         (deref? (cadddr member-inner))
         (bty (c-typed-type base))
         (agg-ty (if deref? (c-ptr-target bty) bty)))
    (c-struct-layout-find-field (lower-ctx-layout-env ctx) agg-ty fsym)))

(define (%c99-lower-load-bitfield! ctx base-reg base-disp fl)
  (let* ((su-off (c-field-layout-storage-unit-offset fl))
         (su-ty (c-field-layout-storage-unit-type fl))
         (bit-off (c-field-layout-bit-offset fl))
         (w (c-field-layout-bit-width fl))
         (fty (c-field-layout-ctype fl))
         (unsigned? (or (c-unsigned-type? fty) (eq? fty 'bool))))
    (%c99-lower-load-from-mem! ctx '%rax base-reg (+ base-disp su-off) su-ty)
    (cond
      ((<= w 0)
       (%c99-lower-emit! ctx '(%mov %rax 0)))
      (unsigned?
       (if (> bit-off 0)
           (%c99-lower-emit! ctx (list '%shr '%rax bit-off)))
       (if (< w 64)
           (begin
             (if (<= w 31)
                 (%c99-lower-emit! ctx (list '%mov '%rcx (- (arithmetic-shift 1 w) 1)))
                 (%c99-lower-emit-u64-const! ctx '%rcx (- (arithmetic-shift 1 w) 1)))
             (%c99-lower-emit! ctx '(%bit-and %rax %rcx)))))
      (else
       (let ((left (- 64 (+ bit-off w)))
             (right (- 64 w)))
         (if (> left 0) (%c99-lower-emit! ctx (list '%shl '%rax left)))
         (if (> right 0) (%c99-lower-emit! ctx (list '%sar '%rax right))))))))

;; Expects new value in %rax and enclosing struct pointer in [%rsp + base-ptr-si].
;; Leaves normalized stored value in %rax.
(define (%c99-lower-store-bitfield-rax! ctx base-ptr-si fl)
  (let* ((su-off (c-field-layout-storage-unit-offset fl))
         (su-ty (c-field-layout-storage-unit-type fl))
         (bit-off (c-field-layout-bit-offset fl))
         (w (c-field-layout-bit-width fl))
         (fty (c-field-layout-ctype fl))
         (unsigned? (or (c-unsigned-type? fty) (eq? fty 'bool)))
         (ret-si (%c99-lower-alloc-slot! ctx))
         (ins-si (%c99-lower-alloc-slot! ctx)))
    (if (eq? fty 'bool)
        (%c99-lower-emit-cast! ctx 'bool))
    ;; Compute unsigned w-bit mask in %rcx
    (cond
      ((>= w 64)
       (%c99-lower-emit! ctx '(%mov %rcx -1)))
      ((<= w 31)
       (%c99-lower-emit! ctx (list '%mov '%rcx (- (arithmetic-shift 1 w) 1))))
      (else
       (%c99-lower-emit-u64-const! ctx '%rcx (- (arithmetic-shift 1 w) 1))))
    (%c99-lower-emit! ctx '(%bit-and %rax %rcx))
    ;; Save shifted insertion value
    (%c99-lower-emit! ctx '(%mov %r8 %rax))
    (if (> bit-off 0)
        (%c99-lower-emit! ctx (list '%shl '%r8 bit-off)))
    (%c99-lower-emit! ctx (list '%store '%rsp ins-si '%r8))
    ;; Sign-extend / preserve normalized return value in ret-si
    (if (and (not unsigned?) (< w 64))
        (let ((shift-amt (- 64 w)))
          (%c99-lower-emit! ctx (list '%shl '%rax shift-amt))
          (%c99-lower-emit! ctx (list '%sar '%rax shift-amt))))
    (%c99-lower-emit! ctx (list '%store '%rsp ret-si '%rax))
    ;; Read-Modify-Write storage unit
    (%c99-lower-emit! ctx (list '%load '%rdx '%rsp base-ptr-si))
    (%c99-lower-load-from-mem! ctx '%rax '%rdx su-off su-ty)
    (if (< w 64)
        (begin
          (if (<= w 31)
              (%c99-lower-emit! ctx (list '%mov '%rcx (- (arithmetic-shift 1 w) 1)))
              (%c99-lower-emit-u64-const! ctx '%rcx (- (arithmetic-shift 1 w) 1)))
          (if (> bit-off 0)
              (%c99-lower-emit! ctx (list '%shl '%rcx bit-off)))
          (%c99-lower-emit! ctx '(%bit-xor %rcx -1))
          (%c99-lower-emit! ctx '(%bit-and %rax %rcx))
          (%c99-lower-emit! ctx (list '%load '%r8 '%rsp ins-si))
          (%c99-lower-emit! ctx '(%bit-or %rax %r8)))
        (%c99-lower-emit! ctx (list '%load '%rax '%rsp ins-si)))
    (%c99-lower-store-to-mem! ctx '%rdx su-off '%rax su-ty)
    (%c99-lower-emit! ctx (list '%load '%rax '%rsp ret-si))))

;;; -----------------------------------------------------------------------
;;; 4. Address & Target Computation (Single-Evaluation Lvalues)
;;; -----------------------------------------------------------------------

(define (%c99-lower-emit-var-addr! ctx var-entry dst-reg)
  (let ((kind (car var-entry))
        (loc (cadr var-entry)))
    (if (eq? kind 'local)
        (begin
          (%c99-lower-emit! ctx (list '%mov dst-reg '%rsp))
          (%c99-lower-emit! ctx (list '%add dst-reg loc)))
        (%c99-lower-emit! ctx (list '%global-addr dst-reg loc)))))

(define (%c99-lower-lvalue-addr! ctx lval-typed)
  (let* ((inner (c-typed-inner lval-typed))
         (tag (car inner)))
    (case tag
      ((c-var-ref)
       (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
         (if (not ent)
             (error "Unbound variable in lvalue-addr" inner)
             (%c99-lower-emit-var-addr! ctx ent '%rax))))
      ((c-fn-ref)
       (%c99-lower-emit! ctx (list '%code-ref '%rax (cadr inner))))
      ((c-unop)
       ;; deref: evaluate pointer expr directly
       (%c99-lower-expr! ctx (caddr inner)))
      ((c-index)
       (let* ((arr (cadr inner))
              (idx (caddr inner))
              (elem-sz (max 1 (%c99-lower-type-size ctx (c-typed-type lval-typed))))
              (base-si (%c99-lower-alloc-slot! ctx)))
         (if (c-array-type? (c-typed-type arr))
             (%c99-lower-lvalue-addr! ctx arr)
             (%c99-lower-expr! ctx arr))
         (%c99-lower-emit! ctx (list '%store '%rsp base-si '%rax))
         (%c99-lower-expr! ctx idx)
         (if (> elem-sz 1)
             (%c99-lower-emit! ctx (list '%imul '%rax elem-sz)))
         (%c99-lower-emit! ctx (list '%load '%rcx '%rsp base-si))
         (%c99-lower-emit! ctx '(%add %rax %rcx))))
      ((c-member)
       (let* ((base (cadr inner))
              (deref? (cadddr inner))
              (fl (%c99-lower-member-field-layout ctx inner))
              (off (c-field-layout-offset fl)))
         (if deref?
             (%c99-lower-expr! ctx base)
             (if (%c99-lower-lvalue-has-addr? base)
                 (%c99-lower-lvalue-addr! ctx base)
                 ;; Rvalue aggregate expression (e.g. make_pt().x): materialize into scratch slot
                 (let* ((bsz (%c99-lower-type-size ctx (c-typed-type base)))
                        (bal (%c99-lower-type-align ctx (c-typed-type base)))
                        (slot-si (%c99-lower-alloc-bytes! ctx bsz bal)))
                   (%c99-lower-expr-to-stack-slot! ctx base slot-si)
                   (%c99-lower-emit! ctx '(%mov %rax %rsp))
                   (%c99-lower-emit! ctx (list '%add '%rax slot-si)))))
         (if (not (= off 0))
             (%c99-lower-emit! ctx (list '%add '%rax off)))))
      ((c-compound-lit)
       (let* ((ty (cadr inner))
              (plan (caddr inner))
              (sz (%c99-lower-type-size ctx ty))
              (al (%c99-lower-type-align ctx ty))
              (slot-si (%c99-lower-alloc-bytes! ctx sz al)))
         (%c99-lower-expr-to-stack-slot! ctx plan slot-si)
         (%c99-lower-emit! ctx '(%mov %rax %rsp))
         (%c99-lower-emit! ctx (list '%add '%rax slot-si))))
      ((c-implicit-cast c-cast)
       (let ((sub (caddr inner)))
         (if (%c99-lower-lvalue-has-addr? sub)
             (%c99-lower-lvalue-addr! ctx sub)
             (%c99-lower-expr! ctx lval-typed))))
      (else
       (%c99-lower-expr! ctx lval-typed)))))

(define (%c99-lower-lvalue-has-addr? typed-expr)
  (let ((tag (car (c-typed-inner typed-expr))))
    (memq tag '(c-var-ref c-index c-member c-compound-lit c-fn-ref c-unop))))

;; Captures evaluation of an lvalue's location ONCE (returns '(var ent) | '(bf ptr-si fl) | '(addr ptr-si))
(define (%c99-lower-capture-lvalue-target! ctx lval-typed)
  (let ((inner (c-typed-inner lval-typed)))
    (cond
      ((eq? (car inner) 'c-var-ref)
       (list 'var (%c99-lower-lookup-var ctx (cadr inner))))
      ((eq? (car inner) 'c-member)
       (let ((fl (%c99-lower-member-field-layout ctx inner)))
         (if (c-field-layout-bit-width fl)
             (let ((ptr-si (%c99-lower-alloc-slot! ctx))
                   (base (cadr inner))
                   (deref? (cadddr inner)))
               (if deref?
                   (%c99-lower-expr! ctx base)
                   (%c99-lower-lvalue-addr! ctx base))
               (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
               (list 'bf ptr-si fl))
             (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
               (%c99-lower-lvalue-addr! ctx lval-typed)
               (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
               (list 'addr ptr-si)))))
      (else
       (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
         (%c99-lower-lvalue-addr! ctx lval-typed)
         (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
         (list 'addr ptr-si))))))

(define (%c99-lower-load-from-target! ctx target ty)
  (case (car target)
    ((var) (%c99-lower-load-var! ctx (cadr target)))
    ((bf)
     (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
     (%c99-lower-load-bitfield! ctx '%rdx 0 (caddr target)))
    ((addr)
     (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
     (%c99-lower-load-from-mem! ctx (if (c-float-type? ty) '%xmm0 '%rax) '%rdx 0 ty))))

(define (%c99-lower-store-to-target! ctx target ty)
  (case (car target)
    ((var) (%c99-lower-store-var! ctx (cadr target)))
    ((bf)  (%c99-lower-store-bitfield-rax! ctx (cadr target) (caddr target)))
    ((addr)
     (let ((src-reg (if (c-float-type? ty) '%xmm0 '%rax)))
       (if (c-float-type? ty)
           (begin
             (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
             (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0)))
           (let ((val-si (%c99-lower-alloc-slot! ctx)))
             (%c99-lower-emit-cast! ctx ty)
             (%c99-lower-emit! ctx (list '%store '%rsp val-si '%rax))
             (%c99-lower-emit! ctx (list '%load '%rdx '%rsp (cadr target)))
             (%c99-lower-emit! ctx (list '%load '%rax '%rsp val-si))
             (%c99-lower-store-to-mem! ctx '%rdx 0 '%rax ty)))))))

;;; -----------------------------------------------------------------------
;;; 5. Scalar Load / Store, Expressions & Aggregate Materialization
;;; -----------------------------------------------------------------------

(define (%c99-lower-load-var! ctx var-entry)
  (let* ((kind (car var-entry))
         (loc (cadr var-entry))
         (ty (caddr var-entry))
         (dst (if (c-float-type? ty) '%xmm0 '%rax)))
    (if (eq? kind 'local)
        (%c99-lower-load-from-mem! ctx dst '%rsp loc ty)
        (begin
          (%c99-lower-emit! ctx (list '%global-addr '%rdx loc))
          (%c99-lower-load-from-mem! ctx dst '%rdx 0 ty)))))

(define (%c99-lower-store-var! ctx var-entry)
  (let ((kind (car var-entry))
        (loc (cadr var-entry))
        (ty (caddr var-entry)))
    (if (c-float-type? ty)
        (if (eq? kind 'local)
            (%c99-lower-emit! ctx (list '%store-typed ty '%rsp loc '%xmm0))
            (begin
              (%c99-lower-emit! ctx (list '%global-addr '%rdx loc))
              (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0))))
        (begin
          (%c99-lower-emit-cast! ctx ty)
          (if (eq? kind 'local)
              (%c99-lower-store-to-mem! ctx '%rsp loc '%rax ty)
              (let ((val-si (%c99-lower-alloc-slot! ctx)))
                (%c99-lower-emit! ctx (list '%store '%rsp val-si '%rax))
                (%c99-lower-emit! ctx (list '%global-addr '%rdx loc))
                (%c99-lower-emit! ctx (list '%load '%rax '%rsp val-si))
                (%c99-lower-store-to-mem! ctx '%rdx 0 '%rax ty)))))))

(define (%c99-lower-init-plan-to-slot! ctx plan base-si)
  (let* ((inner (c-typed-inner plan))
         (target-ty (cadr inner))
         (entries (caddr inner))
         (total-sz (%c99-lower-type-size ctx target-ty)))
    (%c99-lower-memzero! ctx '%rsp base-si total-sz)
    (for-each
     (lambda (ent)
       (if (eq? (car ent) 'zero-range)
           (%c99-lower-memzero! ctx '%rsp (+ base-si (cadr ent)) (caddr ent))
           (let* ((byte-off (list-ref ent 1))
                  (bit-off  (list-ref ent 2))
                  (bit-w    (list-ref ent 3))
                  (su-off   (list-ref ent 4))
                  (su-ty    (list-ref ent 5))
                  (fty      (list-ref ent 6))
                  (val-expr (list-ref ent 7)))
             (cond
               (bit-w
                (let ((base-ptr-si (%c99-lower-alloc-slot! ctx))
                      (fl (%make-c-field-layout #f fty byte-off bit-off bit-w su-off su-ty #f)))
                  (%c99-lower-emit! ctx '(%mov %rax %rsp))
                  (%c99-lower-emit! ctx (list '%add '%rax base-si))
                  (%c99-lower-emit! ctx (list '%store '%rsp base-ptr-si '%rax))
                  (%c99-lower-expr! ctx val-expr)
                  (%c99-lower-store-bitfield-rax! ctx base-ptr-si fl)))
               ((%c99-lower-aggregate-like? fty)
                (%c99-lower-expr-to-stack-slot! ctx val-expr (+ base-si byte-off)))
               (else
                (%c99-lower-expr! ctx val-expr)
                (if (c-float-type? fty)
                    (%c99-lower-emit! ctx (list '%store-typed fty '%rsp (+ base-si byte-off) '%xmm0))
                    (begin
                      (%c99-lower-emit-cast! ctx fty)
                      (%c99-lower-store-to-mem! ctx '%rsp (+ base-si byte-off) '%rax fty))))))))
     entries)))

(define (%c99-lower-expr-to-ptr-slot! ctx node dst-ptr-si)
  (let* ((ty (c-typed-type node))
         (inner (c-typed-inner node))
         (tag (car inner))
         (sz (%c99-lower-type-size ctx ty)))
    (cond
      ((eq? tag 'c-init-plan)
       (let* ((al (%c99-lower-type-align ctx ty))
              (tmp-si (%c99-lower-alloc-bytes! ctx sz al)))
         (%c99-lower-init-plan-to-slot! ctx node tmp-si)
         (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
         (%c99-lower-memcpy-regs! ctx '%rdx 0 '%rsp tmp-si sz)))
      ((eq? tag 'c-compound-lit)
       (%c99-lower-expr-to-ptr-slot! ctx (caddr inner) dst-ptr-si))
      ((eq? tag 'c-call)
       (%c99-lower-call! ctx inner ty dst-ptr-si))
      ((eq? tag 'c-assign)
       (let ((lhs (caddr inner))
             (rhs (cadddr inner)))
         (%c99-lower-expr-to-ptr-slot! ctx rhs dst-ptr-si)
         (let ((lhs-si (%c99-lower-alloc-slot! ctx)))
           (%c99-lower-lvalue-addr! ctx lhs)
           (%c99-lower-emit! ctx (list '%store '%rsp lhs-si '%rax))
           (%c99-lower-emit! ctx (list '%load '%rdx '%rsp lhs-si))
           (%c99-lower-emit! ctx (list '%load '%rcx '%rsp dst-ptr-si))
           (%c99-lower-memcpy-regs! ctx '%rdx 0 '%rcx 0 sz))))
      ((eq? tag 'c-ternary)
       (let ((e-lbl (%c99-lower-new-label ctx "ater_e"))
             (d-lbl (%c99-lower-new-label ctx "ater_d")))
         (%c99-lower-expr! ctx (cadr inner))
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'je e-lbl))
         (%c99-lower-expr-to-ptr-slot! ctx (caddr inner) dst-ptr-si)
         (%c99-lower-emit! ctx (list '%direct-jump d-lbl))
         (%c99-lower-emit! ctx (list '%label e-lbl))
         (%c99-lower-expr-to-ptr-slot! ctx (cadddr inner) dst-ptr-si)
         (%c99-lower-emit! ctx (list '%label d-lbl))))
      ((eq? tag 'c-implicit-cast)
       (if (%c99-lower-aggregate-like? (c-typed-type (caddr inner)))
           (%c99-lower-expr-to-ptr-slot! ctx (caddr inner) dst-ptr-si)
           (begin
             (%c99-lower-expr! ctx node)
             (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
             (%c99-lower-store-to-mem! ctx '%rdx 0 (if (c-float-type? ty) '%xmm0 '%rax) ty))))
      ((%c99-lower-lvalue-has-addr? node)
       (let ((src-si (%c99-lower-alloc-slot! ctx)))
         (%c99-lower-lvalue-addr! ctx node)
         (%c99-lower-emit! ctx (list '%store '%rsp src-si '%rax))
         (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
         (%c99-lower-emit! ctx (list '%load '%rcx '%rsp src-si))
         (%c99-lower-memcpy-regs! ctx '%rdx 0 '%rcx 0 sz)))
      (else
       (%c99-lower-expr! ctx node)
       (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
       (%c99-lower-store-to-mem! ctx '%rdx 0 (if (c-float-type? ty) '%xmm0 '%rax) ty)))))

(define (%c99-lower-expr-to-stack-slot! ctx node dst-si)
  (let ((inner (c-typed-inner node)))
    (cond
      ((eq? (car inner) 'c-init-plan)
       (%c99-lower-init-plan-to-slot! ctx node dst-si))
      ((eq? (car inner) 'c-compound-lit)
       (%c99-lower-init-plan-to-slot! ctx (caddr inner) dst-si))
      (else
       (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
         (%c99-lower-emit! ctx '(%mov %rax %rsp))
         (%c99-lower-emit! ctx (list '%add '%rax dst-si))
         (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
         (%c99-lower-expr-to-ptr-slot! ctx node ptr-si))))))

(define (%c99-lower-emit-cmp! ctx cmp-op unsigned?)
  (let ((cc (case cmp-op
              ((==) 'je)
              ((!=) 'jne)
              ((<)  (if unsigned? 'jb 'jl))
              ((<=) (if unsigned? 'jbe 'jle))
              ((>)  (if unsigned? 'ja 'jg))
              ((>=) (if unsigned? 'jae 'jge))))
        (t-lbl (%c99-lower-new-label ctx "cmp_t"))
        (end-lbl (%c99-lower-new-label ctx "cmp_e")))
    (%c99-lower-emit! ctx '(%cmp %rax %rcx))
    (%c99-lower-emit! ctx (list '%jump-cond cc t-lbl))
    (%c99-lower-emit! ctx '(%mov %rax 0))
    (%c99-lower-emit! ctx (list '%direct-jump end-lbl))
    (%c99-lower-emit! ctx (list '%label t-lbl))
    (%c99-lower-emit! ctx '(%mov %rax 1))
    (%c99-lower-emit! ctx (list '%label end-lbl))))

(define (%c99-lower-emit-fcmp! ctx cmp-op)
  (let ((cc (case cmp-op
              ((==) 'je)
              ((!=) 'jne)
              ((<)  'jb)
              ((<=) 'jbe)
              ((>)  'ja)
              ((>=) 'jae)))
        (t-lbl (%c99-lower-new-label ctx "fcmp_t"))
        (end-lbl (%c99-lower-new-label ctx "fcmp_e")))
    (%c99-lower-emit! ctx '(%fcmp %xmm0 %xmm1))
    (%c99-lower-emit! ctx (list '%jump-cond cc t-lbl))
    (%c99-lower-emit! ctx '(%mov %rax 0))
    (%c99-lower-emit! ctx (list '%direct-jump end-lbl))
    (%c99-lower-emit! ctx (list '%label t-lbl))
    (%c99-lower-emit! ctx '(%mov %rax 1))
    (%c99-lower-emit! ctx (list '%label end-lbl))))

(define (%c99-lower-emit-binop! ctx op res-ty lhs-ty)
  (let ((unsigned? (or (c-unsigned-type? lhs-ty) (c-pointer-type? lhs-ty))))
    (case op
      ((+) (%c99-lower-emit! ctx '(%add %rax %rcx)))
      ((-) (%c99-lower-emit! ctx '(%sub %rax %rcx)))
      ((*) (%c99-lower-emit! ctx '(%imul %rax %rcx)))
      ((/)
       (if unsigned?
           (begin
             (%c99-lower-emit! ctx '(%mov %rdx 0))
             (%c99-lower-emit! ctx '(%udiv %rcx)))
           (begin
             (%c99-lower-emit! ctx '(%cqo))
             (%c99-lower-emit! ctx '(%idiv %rcx)))))
      ((rem)
       (if unsigned?
           (begin
             (%c99-lower-emit! ctx '(%mov %rdx 0))
             (%c99-lower-emit! ctx '(%urem %rcx)))
           (begin
             (%c99-lower-emit! ctx '(%cqo))
             (%c99-lower-emit! ctx '(%idiv %rcx))
             (%c99-lower-emit! ctx '(%mov %rax %rdx)))))
      ((bit-and) (%c99-lower-emit! ctx '(%bit-and %rax %rcx)))
      ((bit-or)  (%c99-lower-emit! ctx '(%bit-or %rax %rcx)))
      ((bit-xor) (%c99-lower-emit! ctx '(%bit-xor %rax %rcx)))
      ((<<)
       (%c99-lower-emit-var-shift! ctx '%shl (= (%c99-lower-type-size ctx res-ty) 8)))
      ((>>)
       (%c99-lower-emit-var-shift! ctx
                                   (if (c-unsigned-type? res-ty) '%shr '%sar)
                                   (= (%c99-lower-type-size ctx res-ty) 8)))
      ((== != < <= > >=)
       (%c99-lower-emit-cmp! ctx op unsigned?)))
    (if (not (memq op '(== != < <= > >=)))
        (%c99-lower-emit-cast! ctx res-ty))))

;;; -----------------------------------------------------------------------
;;; 6. Full SysV AMD64 Call & Aggregate Return/Parameter Passing
;;; -----------------------------------------------------------------------

(define (%c99-map2 f xs ys)
  (let loop ((a xs) (b ys) (acc '()))
    (if (or (null? a) (null? b))
        (reverse acc)
        (loop (cdr a) (cdr b) (cons (f (car a) (car b)) acc)))))

(define (%c99-for-each2 f xs ys)
  (let loop ((a xs) (b ys))
    (if (and (pair? a) (pair? b))
        (begin
          (f (car a) (car b))
          (loop (cdr a) (cdr b))))))

(define (%c99-lower-store-ret-pieces! ctx pieces dst-ptr-si)
  ;; Snapshot return registers immediately before touching %rdx/%rax
  (let ((saved-pieces
         (map (lambda (pc)
                (let* ((kind (car pc))
                       (reg (cadr pc))
                       (off (caddr pc))
                       (csz (cadddr pc))
                       (tmp-si (%c99-lower-alloc-slot! ctx)))
                  (if (eq? kind 'gpr)
                      (%c99-lower-emit! ctx (list '%store '%rsp tmp-si reg))
                      (%c99-lower-emit! ctx (list '%store-typed (if (<= csz 4) 'f32 'f64) '%rsp tmp-si reg)))
                  (list kind tmp-si off csz)))
              pieces)))
    (for-each
     (lambda (sp)
       (let ((kind (list-ref sp 0))
             (tmp-si (list-ref sp 1))
             (off (list-ref sp 2))
             (csz (list-ref sp 3)))
         (%c99-lower-emit! ctx (list '%load '%rdx '%rsp dst-ptr-si))
         (if (eq? kind 'gpr)
             (begin
               (%c99-lower-emit! ctx (list '%load '%rcx '%rsp tmp-si))
               (%c99-lower-store-chunk-gpr! ctx '%rdx off '%rcx csz))
             (begin
               (%c99-lower-emit! ctx (list '%load-typed (if (<= csz 4) 'f32 'f64) '%xmm0 '%rsp tmp-si))
               (%c99-lower-emit! ctx (list '%store-typed (if (<= csz 4) 'f32 'f64) '%rdx off '%xmm0))))))
     saved-pieces)))

(define (%c99-extract-direct-fn-sym node)
  (let loop ((n node))
    (let ((in (c-typed-inner n)))
      (cond
        ((eq? (car in) 'c-fn-ref) (cadr in))
        ((eq? (car in) 'c-implicit-cast) (loop (caddr in)))
        ((and (eq? (car in) 'c-unop) (memq (cadr in) '(addr deref)))
         (loop (caddr in)))
        (else #f)))))

(define (%c99-lower-call! ctx inner call-ret-ty . maybe-dst-ptr-si)
  (let* ((fn-node (cadr inner))
         (arg-nodes (cddr inner))
         (direct-fn-sym (%c99-extract-direct-fn-sym fn-node))
         (raw-fty (c-typed-type fn-node))
         (fty (if (and (c-pointer-type? raw-fty) (c-function-type? (c-ptr-target raw-fty)))
                  (c-ptr-target raw-fty)
                  raw-fty))
         (proto-ret-ty (if (c-function-type? fty) (c-fn-ret fty) call-ret-ty))
         (decl-params (if (c-function-type? fty) (c-fn-params fty) '()))
         (arg-tys (map c-typed-type arg-nodes))
         (all-param-tys (let loop ((ps decl-params) (as arg-tys) (acc '()))
                          (cond
                            ((pair? ps) (loop (cdr ps) (if (pair? as) (cdr as) '()) (cons (car ps) acc)))
                            ((pair? as) (loop '() (cdr as) (cons (car as) acc)))
                            (else (reverse acc)))))
         (abi (c99-plan-sysv-abi (lower-ctx-layout-env ctx) proto-ret-ty all-param-tys))
         (ret-plan (car abi))
         (param-plans (cadr abi))
         (stack-arg-bytes (caddr abi))
         (saved-si (lower-ctx-next-si ctx))
         ;; Evaluate indirect function pointer expression BEFORE arguments
         (fn-ptr-si (if direct-fn-sym
                        #f
                        (let ((psi (%c99-lower-alloc-slot! ctx)))
                          (%c99-lower-expr! ctx fn-node)
                          (%c99-lower-emit! ctx (list '%store '%rsp psi '%rax))
                          psi)))
         ;; If returning via sret without destination buffer supplied, allocate caller scratch slot
         (sret-ptr-si (if (eq? (car ret-plan) 'sret)
                          (if (and (pair? maybe-dst-ptr-si) (car maybe-dst-ptr-si))
                              (car maybe-dst-ptr-si)
                              (let* ((buf-si (%c99-lower-alloc-bytes! ctx (cadr ret-plan) (caddr ret-plan)))
                                     (p-si (%c99-lower-alloc-slot! ctx)))
                                (%c99-lower-emit! ctx '(%mov %rax %rsp))
                                (%c99-lower-emit! ctx (list '%add '%rax buf-si))
                                (%c99-lower-emit! ctx (list '%store '%rsp p-si '%rax))
                                p-si))
                          (and (pair? maybe-dst-ptr-si) (car maybe-dst-ptr-si))))
         ;; Evaluate each argument right-to-left or left-to-right into temp stack buffers
         (arg-slots
          (%c99-map2
           (lambda (arg pty)
             (let* ((sz (max 8 (%c99-lower-type-size ctx pty)))
                    (al (max 8 (%c99-lower-type-align ctx pty)))
                    (slot-si (%c99-lower-alloc-bytes! ctx sz al)))
               (cond
                 ((%c99-lower-aggregate-like? pty)
                  (%c99-lower-expr-to-stack-slot! ctx arg slot-si))
                 ((c-float-type? pty)
                  (%c99-lower-expr! ctx arg)
                  (%c99-lower-emit! ctx (list '%store-typed pty '%rsp slot-si '%xmm0)))
                 (else
                  (%c99-lower-expr! ctx arg)
                  (%c99-lower-emit-cast! ctx pty)
                  (%c99-lower-emit! ctx (list '%store '%rsp slot-si '%rax))))
               slot-si))
           arg-nodes all-param-tys))
         (min-after-args (lower-ctx-next-si ctx))
         (needed (+ (- 0 min-after-args) stack-arg-bytes))
         (shift (align-frame-shift needed))
         (min-touch (- 0 shift))
         (xmm-used (let count-x ((ps param-plans) (k 0))
                     (if (null? ps)
                         k
                         (let ((p (car ps)))
                           (if (eq? (car p) 'regs)
                               (let count-p ((pcs (cadr p)) (kk k))
                                 (if (null? pcs)
                                     (count-x (cdr ps) kk)
                                     (count-p (cdr pcs)
                                              (if (eq? (caar pcs) 'sse) (+ kk 1) kk))))
                               (count-x (cdr ps) k)))))))
    (if (< min-touch (lower-ctx-min-si ctx))
        (lower-ctx-min-si-set! ctx min-touch))
    ;; Copy stack-passed arguments first
    (%c99-for-each2
     (lambda (plan slot-si)
       (if (eq? (car plan) 'stack)
           (let ((st-off (cadr plan))
                 (psz (caddr plan)))
             (%c99-lower-memcpy-regs! ctx '%rsp (+ (- 0 shift) st-off) '%rsp slot-si psz))))
     param-plans arg-slots)
    ;; Load register-passed arguments
    (%c99-for-each2
     (lambda (plan slot-si)
       (if (eq? (car plan) 'regs)
           (for-each
            (lambda (pc)
              (let ((kind (list-ref pc 0))
                    (reg (list-ref pc 1))
                    (off (list-ref pc 2))
                    (csz (list-ref pc 3)))
                (if (eq? kind 'gpr)
                    (%c99-lower-load-chunk-gpr! ctx reg '%rsp (+ slot-si off) csz)
                    (%c99-lower-emit! ctx (list '%load-typed (if (<= csz 4) 'f32 'f64) reg '%rsp (+ slot-si off))))))
            (cadr plan))))
     param-plans arg-slots)
    ;; Hidden sret argument passed in %rdi
    (if (eq? (car ret-plan) 'sret)
        (%c99-lower-emit! ctx (list '%load '%rdi '%rsp sret-ptr-si)))
    (if direct-fn-sym
        (let ((internal? (memq direct-fn-sym (lower-ctx-internal-fns ctx))))
          (if internal?
              (%c99-lower-emit! ctx (list '%direct-call direct-fn-sym shift))
              (%c99-lower-emit! ctx (list '%c-call (symbol->string direct-fn-sym) shift (min 8 xmm-used)))))
        (begin
          (%c99-lower-emit! ctx (list '%load '%r11 '%rsp fn-ptr-si))
          (%c99-lower-emit! ctx (list '%call-indirect '%r11 shift (min 8 xmm-used)))))
    ;; Handle aggregate or scalar return value
    (cond
      ((and (%c99-lower-aggregate-like? call-ret-ty)
            (eq? (car ret-plan) 'regs)
            sret-ptr-si)
       (%c99-lower-store-ret-pieces! ctx (cadr ret-plan) sret-ptr-si))
      ((and (%c99-lower-aggregate-like? call-ret-ty)
            (eq? (car ret-plan) 'empty)
            sret-ptr-si)
       #f)
      ((not (%c99-lower-aggregate-like? call-ret-ty))
       (if (and (not (eq? call-ret-ty 'void)) (not (c-float-type? call-ret-ty)))
           (%c99-lower-emit-cast! ctx call-ret-ty))))
    (lower-ctx-next-si-set! ctx saved-si)))

;;; -----------------------------------------------------------------------
;;; 7. Scalar & Aggregate Expression Lowering
;;; -----------------------------------------------------------------------

(define (%c99-lower-expr! ctx node)
  (let* ((ty (c-typed-type node))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (case tag
      ((c-const-val)
       (if (c-float-type? ty)
           (%c99-lower-emit-float-const! ctx (cadr inner) ty)
           (let ((v (cadr inner)))
             (if (and (>= v -2147483648) (<= v 2147483647))
                 (%c99-lower-emit! ctx (list '%mov '%rax v))
                 (%c99-lower-emit-u64-const! ctx '%rax (modulo v 18446744073709551616))))))

      ((c-enum-const)
       (%c99-lower-emit! ctx (list '%mov '%rax (cadr inner))))

      ((c-str-val)
       (let ((lbl (%c99-lower-intern-str! ctx (cadr inner))))
         (%c99-lower-emit! ctx (list '%str-ref '%rax lbl))
         (%c99-lower-emit! ctx '(%sub %rax 3))))

      ((c-fn-ref)
       (%c99-lower-emit! ctx (list '%code-ref '%rax (cadr inner))))

      ((c-var-ref)
       (if (c-array-type? ty)
           (%c99-lower-lvalue-addr! ctx node)
           (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
             (if (not ent)
                 (error "Unbound variable during LIR lowering" inner)
                 (%c99-lower-load-var! ctx ent)))))

      ((c-member)
       (let ((fl (%c99-lower-member-field-layout ctx inner))
             (base (cadr inner))
             (deref? (cadddr inner)))
         (cond
           ((c-array-type? ty)
            (%c99-lower-lvalue-addr! ctx node))
           ((c-field-layout-bit-width fl)
            (if deref?
                (%c99-lower-expr! ctx base)
                (%c99-lower-lvalue-addr! ctx base))
            (%c99-lower-emit! ctx '(%mov %rdx %rax))
            (%c99-lower-load-bitfield! ctx '%rdx 0 fl))
           (else
            (%c99-lower-lvalue-addr! ctx node)
            (%c99-lower-emit! ctx '(%mov %rdx %rax))
            (%c99-lower-load-from-mem! ctx (if (c-float-type? ty) '%xmm0 '%rax) '%rdx 0 ty)))))

      ((c-compound-lit c-init-plan)
       (let* ((sz (%c99-lower-type-size ctx ty))
              (al (%c99-lower-type-align ctx ty))
              (slot-si (%c99-lower-alloc-bytes! ctx sz al)))
         (%c99-lower-expr-to-stack-slot! ctx node slot-si)
         (%c99-lower-emit! ctx '(%mov %rax %rsp))
         (%c99-lower-emit! ctx (list '%add '%rax slot-si))))

      ((c-implicit-cast c-cast)
       (let* ((target-ty (cadr inner))
              (sub (caddr inner))
              (src-ty (c-typed-type sub)))
         (cond
           ((eq? target-ty 'void)
            (if (%c99-lower-aggregate-like? src-ty)
                (let ((slot-si (%c99-lower-alloc-bytes! ctx (%c99-lower-type-size ctx src-ty) (%c99-lower-type-align ctx src-ty))))
                  (%c99-lower-expr-to-stack-slot! ctx sub slot-si))
                (%c99-lower-expr! ctx sub)))
           ;; Array-to-pointer or Function-to-pointer decay
           ((and (c-pointer-type? target-ty) (c-array-type? src-ty))
            (%c99-lower-lvalue-addr! ctx sub))
           ((and (c-pointer-type? target-ty) (c-function-type? src-ty))
            (%c99-lower-lvalue-addr! ctx sub))
           ;; Float -> Bool
           ((and (eq? target-ty 'bool) (c-float-type? src-ty))
            (let ((l-zero (%c99-lower-new-label ctx "fbool_z"))
                  (l-done (%c99-lower-new-label ctx "fbool_d")))
              (%c99-lower-expr! ctx sub)
              (if (eq? src-ty 'f32)
                  (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
              (%c99-lower-emit! ctx '(%mov %rax 0))
              (%c99-lower-emit! ctx '(%sitofp %xmm1 %rax))
              (%c99-lower-emit! ctx '(%fcmp %xmm0 %xmm1))
              (%c99-lower-emit! ctx (list '%jump-cond 'je l-zero))
              (%c99-lower-emit! ctx '(%mov %rax 1))
              (%c99-lower-emit! ctx (list '%direct-jump l-done))
              (%c99-lower-emit! ctx (list '%label l-zero))
              (%c99-lower-emit! ctx '(%mov %rax 0))
              (%c99-lower-emit! ctx (list '%label l-done))))
           ;; Int -> Float
           ((and (c-float-type? target-ty) (not (c-float-type? src-ty)))
            (%c99-lower-expr! ctx sub)
            (if (c-unsigned-type? src-ty)
                (%c99-lower-emit-cast! ctx src-ty))
            (if (eq? src-ty 'u64)
                (let ((l-nonneg (%c99-lower-new-label ctx "u64f_p"))
                      (l-done (%c99-lower-new-label ctx "u64f_d")))
                  (%c99-lower-emit! ctx '(%cmp %rax 0))
                  (%c99-lower-emit! ctx (list '%jump-cond 'jge l-nonneg))
                  (%c99-lower-emit! ctx '(%mov %rcx %rax))
                  (%c99-lower-emit! ctx '(%shr %rax 1))
                  (%c99-lower-emit! ctx '(%bit-and %rcx 1))
                  (%c99-lower-emit! ctx '(%bit-or %rax %rcx))
                  (%c99-lower-emit! ctx '(%sitofp %xmm0 %rax))
                  (%c99-lower-emit! ctx '(%fadd %xmm0 %xmm0))
                  (%c99-lower-emit! ctx (list '%direct-jump l-done))
                  (%c99-lower-emit! ctx (list '%label l-nonneg))
                  (%c99-lower-emit! ctx '(%sitofp %xmm0 %rax))
                  (%c99-lower-emit! ctx (list '%label l-done)))
                (%c99-lower-emit! ctx '(%sitofp %xmm0 %rax)))
            (if (eq? target-ty 'f32)
                (%c99-lower-emit! ctx '(%trunc f32 %xmm0 %xmm0))))
           ;; Float -> Int
           ((and (c-float-type? src-ty) (not (c-float-type? target-ty)))
            (%c99-lower-expr! ctx sub)
            (if (eq? src-ty 'f32)
                (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
            (%c99-lower-emit! ctx '(%fptosi %rax %xmm0))
            (%c99-lower-emit-cast! ctx target-ty))
           ;; Float <-> Float
           ((and (c-float-type? src-ty) (c-float-type? target-ty))
            (%c99-lower-expr! ctx sub)
            (cond
              ((and (eq? src-ty 'f32) (eq? target-ty 'f64))
               (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
              ((and (eq? src-ty 'f64) (eq? target-ty 'f32))
               (%c99-lower-emit! ctx '(%trunc f32 %xmm0 %xmm0)))))
           ;; Int/Ptr -> Int/Ptr
           (else
            (%c99-lower-expr! ctx sub)
            (cond
              ((eq? target-ty 'bool)
               (%c99-lower-emit-cast! ctx 'bool))
              ((and (memq src-ty '(i8 i16 i32)) (memq target-ty '(u32 u64)))
               (if (eq? target-ty 'u32)
                   (%c99-lower-emit! ctx '(%zext u32 %rax %rax))))
              ((memq target-ty '(i8 u8 i16 u16 i32 u32))
               (%c99-lower-emit-cast! ctx target-ty)))))))

      ((c-unop)
       (let ((op (cadr inner))
             (sub (caddr inner)))
         (case op
           ((uplus)
            (%c99-lower-expr! ctx sub))
           ((neg)
            (%c99-lower-expr! ctx sub)
            (if (c-float-type? ty)
                (begin
                  (if (eq? ty 'f32)
                      (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
                  (%c99-lower-emit! ctx '(%fmov %xmm1 %xmm0))
                  (%c99-lower-emit! ctx '(%mov %rax 0))
                  (%c99-lower-emit! ctx '(%sitofp %xmm0 %rax))
                  (%c99-lower-emit! ctx '(%fsub %xmm0 %xmm1))
                  (if (eq? ty 'f32)
                      (%c99-lower-emit! ctx '(%trunc f32 %xmm0 %xmm0))))
                (begin
                  (%c99-lower-emit! ctx '(%neg %rax))
                  (%c99-lower-emit-cast! ctx ty))))
           ((bit-not)
            (%c99-lower-expr! ctx sub)
            (%c99-lower-emit! ctx '(%bit-xor %rax -1))
            (%c99-lower-emit-cast! ctx ty))
           ((lnot)
            (if (c-float-type? (c-typed-type sub))
                (let ((l-one (%c99-lower-new-label ctx "flnot_t"))
                      (l-end (%c99-lower-new-label ctx "flnot_e")))
                  (%c99-lower-expr! ctx sub)
                  (if (eq? (c-typed-type sub) 'f32)
                      (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
                  (%c99-lower-emit! ctx '(%mov %rax 0))
                  (%c99-lower-emit! ctx '(%sitofp %xmm1 %rax))
                  (%c99-lower-emit! ctx '(%fcmp %xmm0 %xmm1))
                  (%c99-lower-emit! ctx (list '%jump-cond 'je l-one))
                  (%c99-lower-emit! ctx '(%mov %rax 0))
                  (%c99-lower-emit! ctx (list '%direct-jump l-end))
                  (%c99-lower-emit! ctx (list '%label l-one))
                  (%c99-lower-emit! ctx '(%mov %rax 1))
                  (%c99-lower-emit! ctx (list '%label l-end)))
                (let ((l-zero (%c99-lower-new-label ctx "lnot_z"))
                      (l-end (%c99-lower-new-label ctx "lnot_e")))
                  (%c99-lower-expr! ctx sub)
                  (%c99-lower-emit! ctx '(%cmp %rax 0))
                  (%c99-lower-emit! ctx (list '%jump-cond 'je l-zero))
                  (%c99-lower-emit! ctx '(%mov %rax 0))
                  (%c99-lower-emit! ctx (list '%direct-jump l-end))
                  (%c99-lower-emit! ctx (list '%label l-zero))
                  (%c99-lower-emit! ctx '(%mov %rax 1))
                  (%c99-lower-emit! ctx (list '%label l-end)))))
           ((addr)
            (%c99-lower-lvalue-addr! ctx sub))
           ((deref)
            (%c99-lower-expr! ctx sub)
            (if (not (or (%c99-lower-aggregate-like? ty)
                         (c-function-type? ty)))
                (begin
                  (%c99-lower-emit! ctx '(%mov %rdx %rax))
                  (%c99-lower-load-from-mem! ctx (if (c-float-type? ty) '%xmm0 '%rax) '%rdx 0 ty))))
           ((pre++ pre--)
            (let* ((delta (if (c-pointer-type? ty) (max 1 (%c99-lower-type-size ctx (c-ptr-target ty))) 1))
                   (saved-si (lower-ctx-next-si ctx))
                   (tgt (%c99-lower-capture-lvalue-target! ctx sub)))
              (%c99-lower-load-from-target! ctx tgt ty)
              (%c99-lower-emit! ctx (list (if (eq? op 'pre++) '%add '%sub) '%rax delta))
              (%c99-lower-emit-cast! ctx ty)
              (%c99-lower-store-to-target! ctx tgt ty)
              (lower-ctx-next-si-set! ctx saved-si)))
           ((post++ post--)
            (let* ((delta (if (c-pointer-type? ty) (max 1 (%c99-lower-type-size ctx (c-ptr-target ty))) 1))
                   (saved-si (lower-ctx-next-si ctx))
                   (tgt (%c99-lower-capture-lvalue-target! ctx sub))
                   (old-si (%c99-lower-alloc-slot! ctx)))
              (%c99-lower-load-from-target! ctx tgt ty)
              (%c99-lower-emit! ctx (list '%store '%rsp old-si '%rax))
              (%c99-lower-emit! ctx (list (if (eq? op 'post++) '%add '%sub) '%rax delta))
              (%c99-lower-emit-cast! ctx ty)
              (%c99-lower-store-to-target! ctx tgt ty)
              (%c99-lower-emit! ctx (list '%load '%rax '%rsp old-si))
              (lower-ctx-next-si-set! ctx saved-si)))
           (else
            (error "Unsupported unary op in lower_to_lir" inner)))))

      ((c-binop)
       (let ((op (cadr inner))
             (lhs (caddr inner))
             (rhs (cadddr inner)))
         (cond
           ((eq? op 'comma)
            (if (%c99-lower-aggregate-like? (c-typed-type lhs))
                (let ((slot-si (%c99-lower-alloc-bytes! ctx (%c99-lower-type-size ctx (c-typed-type lhs)) (%c99-lower-type-align ctx (c-typed-type lhs)))))
                  (%c99-lower-expr-to-stack-slot! ctx lhs slot-si))
                (%c99-lower-expr! ctx lhs))
            (%c99-lower-expr! ctx rhs))
           ((eq? op 'land)
            (let ((f-lbl (%c99-lower-new-label ctx "land_f"))
                  (e-lbl (%c99-lower-new-label ctx "land_e")))
              (%c99-lower-expr! ctx lhs)
              (%c99-lower-emit! ctx '(%cmp %rax 0))
              (%c99-lower-emit! ctx (list '%jump-cond 'je f-lbl))
              (%c99-lower-expr! ctx rhs)
              (%c99-lower-emit! ctx '(%cmp %rax 0))
              (%c99-lower-emit! ctx (list '%jump-cond 'je f-lbl))
              (%c99-lower-emit! ctx '(%mov %rax 1))
              (%c99-lower-emit! ctx (list '%direct-jump e-lbl))
              (%c99-lower-emit! ctx (list '%label f-lbl))
              (%c99-lower-emit! ctx '(%mov %rax 0))
              (%c99-lower-emit! ctx (list '%label e-lbl))))
           ((eq? op 'lor)
            (let ((t-lbl (%c99-lower-new-label ctx "lor_t"))
                  (e-lbl (%c99-lower-new-label ctx "lor_e")))
              (%c99-lower-expr! ctx lhs)
              (%c99-lower-emit! ctx '(%cmp %rax 0))
              (%c99-lower-emit! ctx (list '%jump-cond 'jne t-lbl))
              (%c99-lower-expr! ctx rhs)
              (%c99-lower-emit! ctx '(%cmp %rax 0))
              (%c99-lower-emit! ctx (list '%jump-cond 'jne t-lbl))
              (%c99-lower-emit! ctx '(%mov %rax 0))
              (%c99-lower-emit! ctx (list '%direct-jump e-lbl))
              (%c99-lower-emit! ctx (list '%label t-lbl))
              (%c99-lower-emit! ctx '(%mov %rax 1))
              (%c99-lower-emit! ctx (list '%label e-lbl))))
           ((and (memq op '(<< >>)) (%c99-lower-extract-const-int rhs))
            => (lambda (k)
                 (let ((amt (bitwise-and k (if (= (%c99-lower-type-size ctx ty) 8) 63 31))))
                   (%c99-lower-expr! ctx lhs)
                   (if (> amt 0)
                       (%c99-lower-emit! ctx
                                         (list (if (eq? op '<<) '%shl
                                                   (if (c-unsigned-type? ty) '%shr '%sar))
                                               '%rax amt)))
                   (%c99-lower-emit-cast! ctx ty))))
           ;; Pointer arithmetic scaling by pointee size
           ((and (memq op '(+ -))
                 (or (c-pointer-type? (c-typed-type lhs)) (c-pointer-type? (c-typed-type rhs))))
            (let* ((lt (c-typed-type lhs))
                   (rt (c-typed-type rhs))
                   (saved-si (lower-ctx-next-si ctx))
                   (tmp-si (%c99-lower-alloc-slot! ctx)))
              (%c99-lower-expr! ctx lhs)
              (%c99-lower-emit! ctx (list '%store '%rsp tmp-si '%rax))
              (%c99-lower-expr! ctx rhs)
              (%c99-lower-emit! ctx '(%mov %rcx %rax))
              (%c99-lower-emit! ctx (list '%load '%rax '%rsp tmp-si))
              (lower-ctx-next-si-set! ctx saved-si)
              (cond
                ((and (c-pointer-type? lt) (c-pointer-type? rt) (eq? op '-))
                 (let ((psz (max 1 (%c99-lower-type-size ctx (c-ptr-target lt)))))
                   (%c99-lower-emit! ctx '(%sub %rax %rcx))
                   (if (> psz 1)
                       (begin
                         (%c99-lower-emit! ctx (list '%mov '%rcx psz))
                         (%c99-lower-emit! ctx '(%cqo))
                         (%c99-lower-emit! ctx '(%idiv %rcx))))))
                ((c-pointer-type? lt)
                 (let ((psz (max 1 (%c99-lower-type-size ctx (c-ptr-target lt)))))
                   (if (> psz 1) (%c99-lower-emit! ctx (list '%imul '%rcx psz)))
                   (%c99-lower-emit! ctx (list (if (eq? op '+) '%add '%sub) '%rax '%rcx))))
                (else
                 (let ((psz (max 1 (%c99-lower-type-size ctx (c-ptr-target rt)))))
                   (if (> psz 1) (%c99-lower-emit! ctx (list '%imul '%rax psz)))
                   (%c99-lower-emit! ctx '(%add %rax %rcx)))))))
           ;; Floating-point arithmetic & comparisons
           ((or (c-float-type? (c-typed-type lhs)) (c-float-type? (c-typed-type rhs)))
            (let* ((saved-si (lower-ctx-next-si ctx))
                   (tmp-si (%c99-lower-alloc-slot! ctx)))
              (%c99-lower-expr! ctx lhs)
              (if (eq? (c-typed-type lhs) 'f32)
                  (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
              (%c99-lower-emit! ctx (list '%store-typed 'f64 '%rsp tmp-si '%xmm0))
              (%c99-lower-expr! ctx rhs)
              (if (eq? (c-typed-type rhs) 'f32)
                  (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
              (%c99-lower-emit! ctx '(%fmov %xmm1 %xmm0))
              (%c99-lower-emit! ctx (list '%load-typed 'f64 '%xmm0 '%rsp tmp-si))
              (lower-ctx-next-si-set! ctx saved-si)
              (case op
                ((+) (%c99-lower-emit! ctx '(%fadd %xmm0 %xmm1)))
                ((-) (%c99-lower-emit! ctx '(%fsub %xmm0 %xmm1)))
                ((*) (%c99-lower-emit! ctx '(%fmul %xmm0 %xmm1)))
                ((/) (%c99-lower-emit! ctx '(%fdiv %xmm0 %xmm1)))
                ((== != < <= > >=) (%c99-lower-emit-fcmp! ctx op)))
              (if (and (eq? ty 'f32) (memq op '(+ - * /)))
                  (%c99-lower-emit! ctx '(%trunc f32 %xmm0 %xmm0)))))
           (else
            (let* ((saved-si (lower-ctx-next-si ctx))
                   (tmp-si (%c99-lower-alloc-slot! ctx)))
              (%c99-lower-expr! ctx lhs)
              (%c99-lower-emit! ctx (list '%store '%rsp tmp-si '%rax))
              (%c99-lower-expr! ctx rhs)
              (%c99-lower-emit! ctx '(%mov %rcx %rax))
              (%c99-lower-emit! ctx (list '%load '%rax '%rsp tmp-si))
              (lower-ctx-next-si-set! ctx saved-si)
              (%c99-lower-emit-binop! ctx op ty (c-typed-type lhs)))))))

      ((c-assign)
       (let ((op (cadr inner))
             (lhs (caddr inner))
             (rhs (cadddr inner)))
         (if (%c99-lower-aggregate-like? ty)
             (let ((saved-si (lower-ctx-next-si ctx))
                   (dst-si (%c99-lower-alloc-slot! ctx)))
               (%c99-lower-lvalue-addr! ctx lhs)
               (%c99-lower-emit! ctx (list '%store '%rsp dst-si '%rax))
               (%c99-lower-expr-to-ptr-slot! ctx rhs dst-si)
               (%c99-lower-emit! ctx (list '%load '%rax '%rsp dst-si))
               (lower-ctx-next-si-set! ctx saved-si))
             (let* ((saved-si (lower-ctx-next-si ctx))
                    (tgt (%c99-lower-capture-lvalue-target! ctx lhs)))
               (if (eq? op '=)
                   (begin
                     (%c99-lower-expr! ctx rhs)
                     (%c99-lower-store-to-target! ctx tgt ty))
                   (let* ((base-op (case op
                                     ((+=) '+) ((-=) '-) ((*=) '*) ((/=) '/) ((rem=) 'rem)
                                     ((<<=) '<<) ((>>=) '>>) ((bit-and=) 'bit-and)
                                     ((bit-xor=) 'bit-xor) ((bit-or=) 'bit-or)
                                     (else '+)))
                          (comp-ty (c-typed-type rhs)))
                     (cond
                       ((c-float-type? ty)
                        (let ((lval-si (%c99-lower-alloc-slot! ctx)))
                          (%c99-lower-load-from-target! ctx tgt ty)
                          (if (eq? ty 'f32)
                              (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
                          (%c99-lower-emit! ctx (list '%store-typed 'f64 '%rsp lval-si '%xmm0))
                          (%c99-lower-expr! ctx rhs)
                          (if (eq? (c-typed-type rhs) 'f32)
                              (%c99-lower-emit! ctx '(%zext f64 %xmm0 %xmm0)))
                          (%c99-lower-emit! ctx '(%fmov %xmm1 %xmm0))
                          (%c99-lower-emit! ctx (list '%load-typed 'f64 '%xmm0 '%rsp lval-si))
                          (case base-op
                            ((+) (%c99-lower-emit! ctx '(%fadd %xmm0 %xmm1)))
                            ((-) (%c99-lower-emit! ctx '(%fsub %xmm0 %xmm1)))
                            ((*) (%c99-lower-emit! ctx '(%fmul %xmm0 %xmm1)))
                            ((/) (%c99-lower-emit! ctx '(%fdiv %xmm0 %xmm1))))
                          (if (eq? ty 'f32)
                              (%c99-lower-emit! ctx '(%trunc f32 %xmm0 %xmm0)))
                          (%c99-lower-store-to-target! ctx tgt ty)))
                       (else
                        (let ((lval-si (%c99-lower-alloc-slot! ctx)))
                          (%c99-lower-load-from-target! ctx tgt ty)
                          (%c99-lower-emit! ctx (list '%store '%rsp lval-si '%rax))
                          (%c99-lower-expr! ctx rhs)
                          (%c99-lower-emit! ctx '(%mov %rcx %rax))
                          (%c99-lower-emit! ctx (list '%load '%rax '%rsp lval-si))
                          (if (and (memq base-op '(+ -)) (c-pointer-type? ty))
                              (let ((psz (max 1 (%c99-lower-type-size ctx (c-ptr-target ty)))))
                                (if (> psz 1) (%c99-lower-emit! ctx (list '%imul '%rcx psz)))
                                (%c99-lower-emit! ctx (list (if (eq? base-op '+) '%add '%sub) '%rax '%rcx)))
                              (%c99-lower-emit-binop! ctx base-op comp-ty comp-ty))
                          (%c99-lower-store-to-target! ctx tgt ty))))))
               (lower-ctx-next-si-set! ctx saved-si)))))

      ((c-ternary)
       (let ((e-lbl (%c99-lower-new-label ctx "tern_e"))
             (done-lbl (%c99-lower-new-label ctx "tern_d")))
         (%c99-lower-expr! ctx (cadr inner))
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'je e-lbl))
         (%c99-lower-expr! ctx (caddr inner))
         (%c99-lower-emit! ctx (list '%direct-jump done-lbl))
         (%c99-lower-emit! ctx (list '%label e-lbl))
         (%c99-lower-expr! ctx (cadddr inner))
         (%c99-lower-emit! ctx (list '%label done-lbl))))

      ((c-index)
       (%c99-lower-lvalue-addr! ctx node)
       (if (not (c-array-type? ty))
           (begin
             (%c99-lower-emit! ctx '(%mov %rdx %rax))
             (%c99-lower-load-from-mem! ctx (if (c-float-type? ty) '%xmm0 '%rax) '%rdx 0 ty))))

      ((c-call)
       (%c99-lower-call! ctx inner ty))

      (else
       (error "Unsupported expression tag in lower_to_lir" tag)))))

;;; -----------------------------------------------------------------------
;;; 8. Statements & Function Prologue/Epilogue (Full SysV Aggregate ABI)
;;; -----------------------------------------------------------------------

(define (%c99-annotate-switch-body ctx stmt cases-box def-box)
  (if (not (pair? stmt))
      stmt
      (case (car stmt)
        ((c-switch)
         ;; Do not enter nested switch
         stmt)
        ((c-case)
         (let ((lbl (%c99-lower-new-label ctx "sw_case"))
               (val (cadr stmt))
               (sub (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)))
           (set-car! cases-box (cons (cons val lbl) (car cases-box)))
           (list 'c-case-labeled lbl sub)))
        ((c-default)
         (let ((lbl (%c99-lower-new-label ctx "sw_def"))
               (sub (%c99-annotate-switch-body ctx (cadr stmt) cases-box def-box)))
           (set-car! def-box lbl)
           (list 'c-case-labeled lbl sub)))
        ((c-block)
         (cons 'c-block
               (map (lambda (s) (%c99-annotate-switch-body ctx s cases-box def-box))
                    (cdr stmt))))
        ((c-if)
         (list 'c-if
               (cadr stmt)
               (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)
               (if (cadddr stmt)
                   (%c99-annotate-switch-body ctx (cadddr stmt) cases-box def-box)
                   #f)))
        ((c-while)
         (list 'c-while
               (cadr stmt)
               (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)))
        ((c-do-while)
         (list 'c-do-while
               (%c99-annotate-switch-body ctx (cadr stmt) cases-box def-box)
               (caddr stmt)))
        ((c-for)
         (list 'c-for
               (list-ref stmt 1)
               (list-ref stmt 2)
               (list-ref stmt 3)
               (%c99-annotate-switch-body ctx (list-ref stmt 4) cases-box def-box)))
        ((c-label)
         (list 'c-label
               (cadr stmt)
               (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box)))
        (else stmt))))

(define (%c99-lower-stmt! ctx stmt)
  (let ((tag (car stmt)))
    (case tag
      ((c-typed-decls)
       (for-each
        (lambda (d)
          (let* ((u-sym (list-ref d 1))
                 (ty (list-ref d 3))
                 (linkage (list-ref d 4))
                 (init (list-ref d 5)))
            (if (eq? linkage 'extern)
                (%c99-lower-bind-data-global! ctx u-sym ty)
                (let ((si (%c99-lower-bind-local! ctx u-sym ty)))
                  (if init
                      (cond
                        ((%c99-lower-aggregate-like? ty)
                         (%c99-lower-expr-to-stack-slot! ctx init si))
                        ((c-float-type? ty)
                         (%c99-lower-expr! ctx init)
                         (%c99-lower-emit! ctx (list '%store-typed ty '%rsp si '%xmm0)))
                        (else
                         (%c99-lower-expr! ctx init)
                         (%c99-lower-store-var! ctx (cdr (assq u-sym (lower-ctx-vars ctx)))))))))))
        (cdr stmt)))

      ((c-block)
       (for-each (lambda (it) (%c99-lower-stmt! ctx it)) (cdr stmt)))

      ((c-expr-stmt)
       (let ((expr (cadr stmt)))
         (if expr
             (let ((ty (c-typed-type expr)))
               (if (%c99-lower-aggregate-like? ty)
                   (let* ((saved-si (lower-ctx-next-si ctx))
                          (slot-si (%c99-lower-alloc-bytes! ctx (%c99-lower-type-size ctx ty) (%c99-lower-type-align ctx ty))))
                     (%c99-lower-expr-to-stack-slot! ctx expr slot-si)
                     (lower-ctx-next-si-set! ctx saved-si))
                   (%c99-lower-expr! ctx expr))))))

      ((c-return)
       (let ((expr (cadr stmt))
             (rplan (lower-ctx-ret-plan ctx)))
         (cond
           ((not expr) #f)
           ((eq? (car rplan) 'sret)
            (%c99-lower-expr-to-ptr-slot! ctx expr (lower-ctx-sret-si ctx))
            (%c99-lower-emit! ctx (list '%load '%rax '%rsp (lower-ctx-sret-si ctx))))
           ((and (memq (car rplan) '(regs empty))
                 (%c99-lower-aggregate-like? (c-typed-type expr)))
            (let* ((ty (c-typed-type expr))
                   (sz (%c99-lower-type-size ctx ty))
                   (al (%c99-lower-type-align ctx ty))
                   (buf-si (%c99-lower-alloc-bytes! ctx sz al)))
              (%c99-lower-expr-to-stack-slot! ctx expr buf-si)
              (if (eq? (car rplan) 'regs)
                  (for-each
                   (lambda (pc)
                     (let ((kind (list-ref pc 0))
                           (reg (list-ref pc 1))
                           (off (list-ref pc 2))
                           (csz (list-ref pc 3)))
                       (if (eq? kind 'gpr)
                           (%c99-lower-load-chunk-gpr! ctx reg '%rsp (+ buf-si off) csz)
                           (%c99-lower-emit! ctx (list '%load-typed (if (<= csz 4) 'f32 'f64) reg '%rsp (+ buf-si off))))))
                   (cadr rplan)))))
           (else
            (%c99-lower-expr! ctx expr)
            (if (not (c-float-type? (c-typed-type expr)))
                (%c99-lower-emit-cast! ctx (c-typed-type expr)))))
         (%c99-lower-emit! ctx (list '%direct-jump (lower-ctx-ret-lbl ctx)))))

      ((c-if)
       (let ((cnd (cadr stmt))
             (thn (caddr stmt))
             (els (cadddr stmt))
             (e-lbl (%c99-lower-new-label ctx "if_else"))
             (done-lbl (%c99-lower-new-label ctx "if_end")))
         (%c99-lower-expr! ctx cnd)
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'je (if els e-lbl done-lbl)))
         (%c99-lower-stmt! ctx thn)
         (if els
             (begin
               (%c99-lower-emit! ctx (list '%direct-jump done-lbl))
               (%c99-lower-emit! ctx (list '%label e-lbl))
               (%c99-lower-stmt! ctx els)))
         (%c99-lower-emit! ctx (list '%label done-lbl))))

      ((c-while)
       (let ((head-lbl (%c99-lower-new-label ctx "while_h"))
             (end-lbl (%c99-lower-new-label ctx "while_e"))
             (prev-brk (lower-ctx-break-lbl ctx))
             (prev-cont (lower-ctx-continue-lbl ctx)))
         (%c99-lower-emit! ctx (list '%label head-lbl))
         (%c99-lower-expr! ctx (cadr stmt))
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'je end-lbl))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (lower-ctx-continue-lbl-set! ctx head-lbl)
         (%c99-lower-stmt! ctx (caddr stmt))
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (lower-ctx-continue-lbl-set! ctx prev-cont)
         (%c99-lower-emit! ctx (list '%direct-jump head-lbl))
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-do-while)
       (let ((body-lbl (%c99-lower-new-label ctx "do_b"))
             (cond-lbl (%c99-lower-new-label ctx "do_c"))
             (end-lbl (%c99-lower-new-label ctx "do_e"))
             (prev-brk (lower-ctx-break-lbl ctx))
             (prev-cont (lower-ctx-continue-lbl ctx)))
         (%c99-lower-emit! ctx (list '%label body-lbl))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (lower-ctx-continue-lbl-set! ctx cond-lbl)
         (%c99-lower-stmt! ctx (cadr stmt))
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (lower-ctx-continue-lbl-set! ctx prev-cont)
         (%c99-lower-emit! ctx (list '%label cond-lbl))
         (%c99-lower-expr! ctx (caddr stmt))
         (%c99-lower-emit! ctx '(%cmp %rax 0))
         (%c99-lower-emit! ctx (list '%jump-cond 'jne body-lbl))
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-for)
       (let ((init (list-ref stmt 1))
             (cnd  (list-ref stmt 2))
             (step (list-ref stmt 3))
             (body (list-ref stmt 4))
             (cond-lbl (%c99-lower-new-label ctx "for_c"))
             (step-lbl (%c99-lower-new-label ctx "for_s"))
             (end-lbl  (%c99-lower-new-label ctx "for_e"))
             (prev-brk (lower-ctx-break-lbl ctx))
             (prev-cont (lower-ctx-continue-lbl ctx)))
         (if init
             (if (c-typed? init)
                 (%c99-lower-expr! ctx init)
                 (%c99-lower-stmt! ctx init)))
         (%c99-lower-emit! ctx (list '%label cond-lbl))
         (if cnd
             (begin
               (%c99-lower-expr! ctx cnd)
               (%c99-lower-emit! ctx '(%cmp %rax 0))
               (%c99-lower-emit! ctx (list '%jump-cond 'je end-lbl))))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (lower-ctx-continue-lbl-set! ctx step-lbl)
         (%c99-lower-stmt! ctx body)
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (lower-ctx-continue-lbl-set! ctx prev-cont)
         (%c99-lower-emit! ctx (list '%label step-lbl))
         (if step (%c99-lower-expr! ctx step))
         (%c99-lower-emit! ctx (list '%direct-jump cond-lbl))
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-switch)
       (let* ((cnd (cadr stmt))
              (cases-box (cons '() '()))
              (def-box (cons #f '()))
              (ann-body (%c99-annotate-switch-body ctx (caddr stmt) cases-box def-box))
              (end-lbl (%c99-lower-new-label ctx "sw_end"))
              (prev-brk (lower-ctx-break-lbl ctx))
              (cases (reverse (car cases-box)))
              (def-lbl (or (car def-box) end-lbl))
              (case-entries (map (lambda (cv) (list (car cv) (cdr cv) '())) cases)))
         (%c99-lower-expr! ctx cnd)
         (if (null? case-entries)
             (%c99-lower-emit! ctx (list '%direct-jump def-lbl))
             (%c99-lower-emit! ctx (list '%switch '%rax def-lbl '() case-entries)))
         (lower-ctx-break-lbl-set! ctx end-lbl)
         (%c99-lower-stmt! ctx ann-body)
         (lower-ctx-break-lbl-set! ctx prev-brk)
         (%c99-lower-emit! ctx (list '%label end-lbl))))

      ((c-case-labeled)
       (%c99-lower-emit! ctx (list '%label (cadr stmt)))
       (%c99-lower-stmt! ctx (caddr stmt)))

      ((c-break)
       (%c99-lower-emit! ctx (list '%direct-jump (lower-ctx-break-lbl ctx))))

      ((c-continue)
       (%c99-lower-emit! ctx (list '%direct-jump (lower-ctx-continue-lbl ctx))))

      ((c-goto)
       (%c99-lower-emit! ctx (list '%direct-jump (%c99-lower-user-label ctx (cadr stmt)))))

      ((c-label)
       (%c99-lower-emit! ctx (list '%label (%c99-lower-user-label ctx (cadr stmt))))
       (%c99-lower-stmt! ctx (caddr stmt)))

      (else
       (error "Unsupported statement tag in lower_to_lir" tag)))))

;;; -----------------------------------------------------------------------
;;; 8.1 Escape Analysis & mem2reg Candidate Promotion (Issue #919)
;;; -----------------------------------------------------------------------

(define (c99-find-root-lvalue-var node)
  (let* ((unwrapped (if (c-typed? node) (c-typed-inner node) node))
         (tag (and (pair? unwrapped) (car unwrapped))))
    (case tag
      ((c-var-ref) (cadr unwrapped))
      ((c-member)
       (let ((base (cadr unwrapped))
             (deref? (cadddr unwrapped)))
         (if (not deref?) (c99-find-root-lvalue-var base) #f)))
      ((c-index)
       (c99-find-root-lvalue-var (cadr unwrapped)))
      ((c-cast c-implicit-cast)
       (c99-find-root-lvalue-var (caddr unwrapped)))
      (else #f))))

(define (c99-collect-escaped-bindings fn-node)
  (letrec
      ((walk
        (lambda (node acc)
          (cond
            ((not (pair? node)) acc)
            (else
             (let* ((inner (if (c-typed? node) (c-typed-inner node) node))
                    (tag (and (pair? inner) (car inner))))
               (case tag
                 ((c-unop)
                  (let* ((op (cadr inner))
                         (sub (caddr inner))
                         (root (and (eq? op 'addr) (c99-find-root-lvalue-var sub)))
                         (acc2 (if (and root (not (memq root acc)))
                                   (cons root acc)
                                   acc)))
                    (walk sub acc2)))
                 ((c-decl)
                  (let dloop ((ds (cdr inner)) (dacc acc))
                    (if (null? ds) dacc
                        (let* ((d (car ds))
                               (u-sym (list-ref d 1))
                               (ty (list-ref d 3))
                               (init (list-ref d 5))
                               (agg? (or (c-array-type? ty) (c-aggregate-ref-type? ty)))
                               (dacc2 (if (and agg? (not (memq u-sym dacc)))
                                          (cons u-sym dacc)
                                          dacc))
                               (dacc3 (if init (walk init dacc2) dacc2)))
                          (dloop (cdr ds) dacc3)))))
                 (else
                  (let loop ((items inner) (cur-acc acc))
                    (if (null? items) cur-acc
                        (loop (cdr items) (walk (car items) cur-acc))))))))))))
    (let* ((params (if (>= (length fn-node) 5) (list-ref fn-node 4) '()))
           (body   (if (>= (length fn-node) 6) (list-ref fn-node 5) '()))
           (init-acc
            (let ploop ((ps params) (pacc '()))
              (if (null? ps) pacc
                  (let* ((p (car ps))
                         (u-sym (car p))
                         (pty (caddr p)))
                    (if (or (c-array-type? pty) (c-aggregate-ref-type? pty))
                        (ploop (cdr ps) (if (memq u-sym pacc) pacc (cons u-sym pacc)))
                        (ploop (cdr ps) pacc)))))))
      (walk body init-acc))))

(define (c99-function-candidate-mem2reg-offsets fn-node vars)
  (let ((escaped (c99-collect-escaped-bindings fn-node)))
    (let loop ((vs vars) (acc '()))
      (if (null? vs) (reverse acc)
          (let* ((entry (car vs))
                 (u-sym (car entry))
                 (kind (cadr entry))
                 (si (caddr entry))
                 (ty (cadddr entry)))
            (if (and (eq? kind 'local)
                     (c-scalar-type? ty)
                     (not (memq u-sym escaped)))
                (loop (cdr vs) (cons si acc))
                (loop (cdr vs) acc)))))))

;;; -----------------------------------------------------------------------
;;; 8.2 Flat C99 LIR -> Pass 132 Braun SSA CFG Bridge (Issue #920)
;;; -----------------------------------------------------------------------

(define (%c99-ssa-cond-branch-target inst)
  (case (car inst)
    ((%jump-cond %jump-if-false) (caddr inst))
    ((%jump-if-zero) (cadr inst))
    (else #f)))

(define (%c99-ssa-rewrite-cond-branch inst new-tgt)
  (case (car inst)
    ((%jump-cond) (list '%jump-cond (cadr inst) new-tgt))
    ((%jump-if-false) (list '%jump-if-false (cadr inst) new-tgt))
    ((%jump-if-zero) (list '%jump-if-zero new-tgt))
    (else inst)))

(define (c99-lir-fn->braun-cfg fn-lir candidate-offsets)
  (let* ((fn-sym (list-ref fn-lir 1))
         (body-clause (assq 'body (cddr fn-lir)))
         (body-insts (if body-clause (cdr body-clause) '()))
         (entry-lbl (string->symbol (string-append (symbol->string fn-sym) "__entry")))
         (lbl-cnt-box (cons 0 '()))
         (next-cfg-lbl!
          (lambda (prefix)
            (let ((n (car lbl-cnt-box)))
              (set-car! lbl-cnt-box (+ n 1))
              (string->symbol
               (string-append ".L_ssa_" (symbol->string fn-sym) "_" prefix "_" (number->string n))))))
         (blocks-box (cons '() '()))
         (tramps-box (cons '() '()))
         (emit-blk! (lambda (lbl rev-insts term extra-edges)
                      (set-car! blocks-box
                                (cons (list lbl (reverse rev-insts) term (reverse extra-edges))
                                      (car blocks-box))))))
    ;; Pass 0: Split flat LIR into basic blocks with taken-edge trampolines for conditional jumps
    (let scan ((rest body-insts) (cur-lbl entry-lbl) (cur-insts '()) (cur-extra '()))
      (if (null? rest)
          (if cur-lbl
              (emit-blk! cur-lbl cur-insts '(%return) cur-extra))
          (let ((inst (car rest)))
            (cond
              ((not cur-lbl)
               ;; Inside unreachable code after an unconditional terminator: wait for next %label
               (if (and (pair? inst) (eq? (car inst) '%label))
                   (scan (cdr rest) (cadr inst) '() '())
                   (scan (cdr rest) #f '() '())))
              ((not (pair? inst))
               (scan (cdr rest) cur-lbl cur-insts cur-extra))
              ((eq? (car inst) '%label)
               (let ((next-lbl (cadr inst)))
                 (emit-blk! cur-lbl cur-insts (list '%jump next-lbl) cur-extra)
                 (scan (cdr rest) next-lbl '() '())))
              ((memq (car inst) '(%jump %direct-jump))
               (emit-blk! cur-lbl cur-insts (list '%jump (cadr inst)) cur-extra)
               (scan (cdr rest) #f '() '()))
              ((memq (car inst) '(%switch %return))
               (emit-blk! cur-lbl cur-insts inst cur-extra)
               (scan (cdr rest) #f '() '()))
              ((memq (car inst) '(%jump-cond %jump-if-zero %jump-if-false))
               (let* ((orig-tgt (%c99-ssa-cond-branch-target inst))
                      (tramp-lbl (next-cfg-lbl! "tramp"))
                      (rewritten (%c99-ssa-rewrite-cond-branch inst tramp-lbl))
                      (has-next-label? (and (pair? (cdr rest))
                                            (pair? (cadr rest))
                                            (eq? (caadr rest) '%label)))
                      (next-lbl (if has-next-label?
                                    (cadr (cadr rest))
                                    (next-cfg-lbl! "fall"))))
                 (emit-blk! cur-lbl
                            (cons rewritten cur-insts)
                            (list '%jump next-lbl)
                            (cons tramp-lbl cur-extra))
                 (set-car! tramps-box
                           (cons (list tramp-lbl '() (list '%jump orig-tgt) '())
                                 (car tramps-box)))
                 (if has-next-label?
                     (scan (cdr rest) #f '() '())
                     (scan (cdr rest) next-lbl '() '()))))
              (else
               (scan (cdr rest) cur-lbl (cons inst cur-insts) cur-extra))))))
    (let* ((main-blocks (reverse (car blocks-box)))
           (tramp-blocks (reverse (car tramps-box)))
           (all-blocks (append main-blocks tramp-blocks))
           (cfg (make-braun-cfg)))
      ;; Pass 1: Pre-create ALL basic blocks before emitting any instructions or edges
      (for-each (lambda (b) (braun-new-block! cfg (list-ref b 0))) all-blocks)
      ;; Pass 2: Emit non-terminator instructions, set terminators, and register extra edges
      (for-each
       (lambda (b)
         (let ((lbl (list-ref b 0))
               (insts (list-ref b 1))
               (term (list-ref b 2))
               (extras (list-ref b 3)))
           (for-each (lambda (ins) (braun-emit-inst! cfg lbl ins)) insts)
           (if term
               (begin
                 (braun-set-terminator! cfg lbl term)
                 (braun-auto-add-terminator-edges! cfg lbl term)))
           (for-each (lambda (ex) (braun-add-edge! cfg lbl ex)) extras)))
       all-blocks)
      ;; Selective mem2reg on non-escaped scalar stack offsets + delayed seal-block
      (if (and (pair? candidate-offsets) (pair? main-blocks))
          (let ((first-lbl (list-ref (car main-blocks) 0)))
            (for-each
             (lambda (off)
               (let ((var (string->symbol (string-append "stk_" (number->string off)))))
                 (braun-write-variable! cfg var first-lbl 0)))
             candidate-offsets)
            (braun-promote-alloca-to-ssa cfg candidate-offsets)))
      (braun-seal-all-blocks! cfg)
      (braun-verify-cfg cfg)
      cfg)))

(define (c99-braun-ssa-transform-fn fn-lir candidate-offsets)
  (let* ((fn-sym (list-ref fn-lir 1))
         (params-clause (list-ref fn-lir 2))
         (frame-clause (list-ref fn-lir 3))
         (cfg (c99-lir-fn->braun-cfg fn-lir candidate-offsets))
         (ssa-blocks (braun-cfg->lir cfg)))
    (list '%lir-function
          fn-sym
          params-clause
          frame-clause
          (cons 'body ssa-blocks))))

(define (%c99-lower-function ctx fn-node globals)
  (let* ((fn-sym (list-ref fn-node 1))
         (ret-ty  (list-ref fn-node 2))
         (params  (list-ref fn-node 4))
         (body    (list-ref fn-node 5))
         (param-tys (map caddr params))
         (abi (c99-plan-sysv-abi (lower-ctx-layout-env ctx) ret-ty param-tys))
         (ret-plan (car abi))
         (param-plans (cadr abi))
         (ret-lbl (%c99-lower-new-label ctx "ret")))
    (lower-ctx-vars-set! ctx '())
    (lower-ctx-insts-set! ctx '())
    (lower-ctx-next-si-set! ctx -16)
    (lower-ctx-min-si-set! ctx -16)
    (lower-ctx-user-labels-set! ctx '())
    (lower-ctx-ret-lbl-set! ctx ret-lbl)
    (lower-ctx-ret-plan-set! ctx ret-plan)
    (for-each
     (lambda (g)
       (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
     globals)
    ;; Save hidden sret pointer if returning >16B struct
    (if (eq? (car ret-plan) 'sret)
        (let ((s-si (%c99-lower-alloc-slot! ctx)))
          (lower-ctx-sret-si-set! ctx s-si)
          (%c99-lower-emit! ctx (list '%store '%rsp s-si '%rdi)))
        (lower-ctx-sret-si-set! ctx #f))
    ;; Allocate local parameter slots & save incoming SysV args
    (let ((param-slots
           (%c99-map2
            (lambda (p plan)
              (let* ((u-sym (list-ref p 0))
                     (pty (list-ref p 2))
                     (si (%c99-lower-bind-local! ctx u-sym pty)))
                (if (eq? (car plan) 'regs)
                    (for-each
                     (lambda (pc)
                       (let ((kind (list-ref pc 0))
                             (reg (list-ref pc 1))
                             (off (list-ref pc 2))
                             (csz (list-ref pc 3)))
                         (if (eq? kind 'gpr)
                             (%c99-lower-store-chunk-gpr! ctx '%rsp (+ si off) reg csz)
                             (%c99-lower-emit! ctx (list '%store-typed (if (<= csz 4) 'f32 'f64) '%rsp (+ si off) reg)))))
                     (cadr plan)))
                (list si plan)))
            params param-plans)))
      ;; Copy stack-passed incoming args (callee sees caller arg at [rsp + 8 + st_off])
      (for-each
       (lambda (ps)
         (let ((si (car ps))
               (plan (cadr ps)))
           (if (eq? (car plan) 'stack)
               (let ((st-off (cadr plan))
                     (psz (caddr plan)))
                 (%c99-lower-memcpy-regs! ctx '%rsp si '%rsp (+ 8 st-off) psz)))))
       param-slots))
    (%c99-lower-stmt! ctx body)
    (%c99-lower-emit! ctx '(%mov %rax 0))
    (%c99-lower-emit! ctx (list '%label ret-lbl))
    (%c99-lower-emit! ctx '(%return))
    (let* ((used (- 0 (lower-ctx-min-si ctx)))
           (frame-sz (c-type-align-up (max 16 used) 16))
           (param-names (map cadr params)))
      (list '%lir-function
            fn-sym
            (list 'params param-names)
            (list 'frame-size frame-sz)
            (cons 'body (reverse (lower-ctx-insts ctx)))))))

;;; -----------------------------------------------------------------------
;;; 9. Static Global Initializer Serialization (.data / .bss / reloc)
;;; -----------------------------------------------------------------------

(define (%c99-eval-static-addr ctx node)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (case tag
      ((c-var-ref)
       (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
         (if (and ent (eq? (car ent) 'data-global))
             (list 'reloc (cadr ent) 0)
             #f)))
      ((c-fn-ref)
       (list 'reloc (cadr inner) 0))
      ((c-str-val)
       (list 'reloc (%c99-lower-intern-str! ctx (cadr inner)) 0))
      ((c-member)
       (let* ((base (cadr inner))
              (deref? (cadddr inner))
              (fl (%c99-lower-member-field-layout ctx inner)))
         (if (or deref? (not fl) (c-field-layout-bit-width fl))
             #f
             (let ((baddr (%c99-eval-static-addr ctx base)))
               (if baddr
                   (list 'reloc (cadr baddr) (+ (caddr baddr) (c-field-layout-offset fl)))
                   #f)))))
      ((c-index)
       (let* ((arr (cadr inner))
              (idx-expr (caddr inner))
              (idx (%c99-lower-extract-const-int idx-expr))
              (elem-sz (c-type-size-in lenv (c-typed-type node)))
              (baddr (if (c-array-type? (c-typed-type arr))
                         (%c99-eval-static-addr ctx arr)
                         #f)))
         (if (and baddr idx)
             (list 'reloc (cadr baddr) (+ (caddr baddr) (* idx elem-sz)))
             #f)))
      ((c-compound-lit)
       ;; Serialize anonymous static compound literal to .data / .bss label
       (let* ((cl-ty (cadr inner))
              (plan (caddr inner))
              (lbl (%c99-lower-new-label ctx "s_clit")))
         (if (%c99-lower-emit-static-data-object! ctx lbl cl-ty plan)
             (list 'reloc lbl 0)
             #f)))
      ((c-implicit-cast c-cast)
       (%c99-eval-static-addr ctx (caddr inner)))
      (else #f))))

(define (%c99-eval-static-val ctx typed-expr)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (ty (c-typed-type typed-expr))
         (inner (c-typed-inner typed-expr))
         (tag (car inner)))
    (case tag
      ((c-const-val) (cadr inner))
      ((c-enum-const) (cadr inner))
      ((c-str-val)
       (list 'reloc (%c99-lower-intern-str! ctx (cadr inner)) 0))
      ((c-fn-ref)
       (list 'reloc (cadr inner) 0))
      ((c-var-ref)
       (if (c-array-type? ty)
           (%c99-eval-static-addr ctx typed-expr)
           #f))
      ((c-implicit-cast c-cast)
       (let* ((target-ty (cadr inner))
              (sub (caddr inner))
              (src-ty (c-typed-type sub)))
         (cond
           ((and (c-pointer-type? target-ty) (or (c-array-type? src-ty) (c-function-type? src-ty)))
            (%c99-eval-static-addr ctx sub))
           (else
            (let ((sv (%c99-eval-static-val ctx sub)))
              (cond
                ((not sv) #f)
                ((pair? sv) sv) ; reloc pointer preserved across casts
                ((c-float-type? target-ty) (exact->inexact sv))
                ((c-integer-type? target-ty)
                 (let ((iv (if (inexact? sv) (exact (truncate sv)) sv)))
                   (cond
                     ((eq? target-ty 'bool) (if (= iv 0) 0 1))
                     ((c-type-size-in lenv target-ty)
                      => (lambda (nb)
                           (let ((mask (arithmetic-shift 1 (* 8 nb))))
                             (modulo iv mask))))
                     (else iv))))
                (else sv)))))))
      ((c-unop)
       (case (cadr inner)
         ((addr) (%c99-eval-static-addr ctx (caddr inner)))
         ((uplus) (%c99-eval-static-val ctx (caddr inner)))
         ((neg)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (if (number? v) (- 0 v) #f)))
         ((bit-not)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (if (integer? v) (bitwise-not v) #f)))
         ((lnot)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (cond ((pair? v) 0)
                  ((number? v) (if (= v 0) 1 0))
                  (else #f))))
         (else #f)))
      ((c-binop)
       (let ((op (cadr inner))
             (l (%c99-eval-static-val ctx (caddr inner)))
             (r (%c99-eval-static-val ctx (cadddr inner)))
             (lty (c-typed-type (caddr inner)))
             (rty (c-typed-type (cadddr inner))))
         (cond
           ((and (pair? l) (integer? r) (memq op '(+ -)) (c-pointer-type? lty))
            (let ((sc (max 1 (c-type-size-in lenv (c-ptr-target lty)))))
              (list 'reloc (cadr l) (+ (caddr l) (* (if (eq? op '+) r (- 0 r)) sc)))))
           ((and (integer? l) (pair? r) (eq? op '+) (c-pointer-type? rty))
            (let ((sc (max 1 (c-type-size-in lenv (c-ptr-target rty)))))
              (list 'reloc (cadr r) (+ (caddr r) (* l sc)))))
           ((and (number? l) (number? r))
            (case op
              ((+) (+ l r))
              ((-) (- l r))
              ((*) (* l r))
              ((/) (if (= r 0) #f (if (and (integer? l) (integer? r)) (quotient l r) (/ l r))))
              ((rem) (if (or (= r 0) (not (integer? l)) (not (integer? r))) #f (remainder l r)))
              ((<<) (arithmetic-shift l r))
              ((>>) (arithmetic-shift l (- 0 r)))
              ((bit-and) (bitwise-and l r))
              ((bit-or) (bitwise-ior l r))
              ((bit-xor) (bitwise-xor l r))
              ((==) (if (= l r) 1 0))
              ((!=) (if (= l r) 0 1))
              ((<) (if (< l r) 1 0))
              ((<=) (if (<= l r) 1 0))
              ((>) (if (> l r) 1 0))
              ((>=) (if (>= l r) 1 0))
              (else #f)))
           (else #f))))
      ((c-ternary)
       (let ((c (%c99-eval-static-val ctx (cadr inner))))
         (cond
           ((not c) #f)
           ((or (pair? c) (and (number? c) (not (= c 0))))
            (%c99-eval-static-val ctx (caddr inner)))
           (else
            (%c99-eval-static-val ctx (cadddr inner))))))
      (else #f))))

(define (%c99-bv-write-bytes! bv off byte-list)
  (let loop ((i 0) (bs byte-list))
    (if (pair? bs)
        (begin
          (bytevector-u8-set! bv (+ off i) (modulo (car bs) 256))
          (loop (+ i 1) (cdr bs))))))

(define (%c99-bv-write-bitfield! bv su-off su-bytes bit-off bit-w val)
  (if (> bit-w 0)
      (let ((cur (let rloop ((k (- su-bytes 1)) (acc 0))
                   (if (< k 0) acc (rloop (- k 1) (+ (* acc 256) (bytevector-u8-ref bv (+ su-off k)))))))
            (mask (- (arithmetic-shift 1 bit-w) 1)))
        (let* ((f-bits (modulo (if (inexact? val) (exact (truncate val)) val) (+ mask 1)))
               (cleared (bitwise-and cur (bitwise-not (arithmetic-shift mask bit-off))))
               (updated (bitwise-ior cleared (arithmetic-shift f-bits bit-off))))
          (%c99-bv-write-bytes! bv su-off (c99-int->le-bytes updated su-bytes))))))

(define (%c99-serialize-bv-to-chunks bv sz relocs)
  (let* ((all-zero? (and (null? relocs)
                         (let zc ((i 0))
                           (cond ((>= i sz) #t)
                                 ((not (= (bytevector-u8-ref bv i) 0)) #f)
                                 (else (zc (+ i 1))))))))
    (if all-zero?
        'bss
        (let loop ((i 0) (chunks '()))
          (cond
            ((>= i sz) (reverse chunks))
            ((assv i relocs)
             => (lambda (slot)
                  (loop (+ i 8) (cons (cdr slot) chunks))))
            ((= (bytevector-u8-ref bv i) 0)
             (let zscan ((j i))
               (if (and (< j sz)
                        (not (assv j relocs))
                        (= (bytevector-u8-ref bv j) 0))
                   (zscan (+ j 1))
                   (let ((zlen (- j i)))
                     (if (>= zlen 4)
                         (loop j (cons (list 'zero zlen) chunks))
                         (let eloop ((k i) (acc chunks))
                           (if (>= k j)
                               (loop j acc)
                               (eloop (+ k 1) (cons 0 acc)))))))))
            (else
             (loop (+ i 1) (cons (bytevector-u8-ref bv i) chunks))))))))

(define (%c99-filter-relocs-out relocs lo hi)
  (let loop ((rs relocs) (acc '()))
    (if (null? rs)
        (reverse acc)
        (let ((pos (caar rs)))
          (if (and (>= pos lo) (< pos hi))
              (loop (cdr rs) acc)
              (loop (cdr rs) (cons (car rs) acc)))))))

(define (%c99-lower-emit-static-data-object! ctx lbl ty init-node)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (sz (max 1 (c-type-size-in lenv ty)))
         (al (max 1 (c-type-align-in lenv ty))))
    (if (not init-node)
        (begin
          (%c99-lower-add-data-entry! ctx (list 'bss lbl al sz))
          #t)
        (let* ((bv (make-bytevector sz 0))
               (relocs-box (cons '() '()))
               (ok-box (cons #t '()))
               (inner (c-typed-inner init-node))
               (entries (if (eq? (car inner) 'c-init-plan)
                            (caddr inner)
                            (list (list 'set 0 #f #f #f #f ty init-node)))))
          (for-each
           (lambda (ent)
             (if (car ok-box)
                 (if (eq? (car ent) 'zero-range)
                     (let ((zoff (cadr ent))
                           (zsz (caddr ent)))
                       (set-car! relocs-box (%c99-filter-relocs-out (car relocs-box) zoff (+ zoff zsz)))
                       (let zl ((k 0))
                         (if (< k zsz)
                             (begin (bytevector-u8-set! bv (+ zoff k) 0) (zl (+ k 1))))))
                     (let* ((byte-off (list-ref ent 1))
                            (bit-off  (list-ref ent 2))
                            (bit-w    (list-ref ent 3))
                            (su-off   (list-ref ent 4))
                            (su-ty    (list-ref ent 5))
                            (fty      (list-ref ent 6))
                            (val-expr (list-ref ent 7))
                            (sval     (%c99-eval-static-val ctx val-expr)))
                       (cond
                         ((not sval)
                          (set-car! ok-box #f))
                         (bit-w
                          (let ((su-bytes (c-type-size-in lenv su-ty)))
                            (if (integer? sval)
                                (%c99-bv-write-bitfield! bv su-off su-bytes bit-off bit-w sval)
                                (set-car! ok-box #f))))
                         ((and (pair? sval) (eq? (car sval) 'reloc))
                          (set-car! relocs-box (cons (cons byte-off sval)
                                                     (%c99-filter-relocs-out (car relocs-box) byte-off (+ byte-off 8)))))
                         ((c-float-type? fty)
                          (%c99-bv-write-bytes! bv byte-off
                                                (if (eq? fty 'f32)
                                                    (c99-f32->le-bytes sval)
                                                    (c99-f64->le-bytes sval))))
                         (else
                          (let ((nb (max 1 (c-type-size-in lenv fty))))
                            (%c99-bv-write-bytes! bv byte-off (c99-int->le-bytes (exact (truncate sval)) nb)))))))))
           entries)
          (if (not (car ok-box))
              #f
              (let ((chunks (%c99-serialize-bv-to-chunks bv sz (car relocs-box))))
                (if (eq? chunks 'bss)
                    (%c99-lower-add-data-entry! ctx (list 'bss lbl al sz))
                    (%c99-lower-add-data-entry! ctx (cons 'bytes (cons lbl (cons al chunks)))))
                #t))))))

;;; -----------------------------------------------------------------------
;;; 10. Top-Level Lowering Entrypoint -> L_lir_core %lir-program
;;; -----------------------------------------------------------------------

(define (c99-lower-to-lir typed-unit)
  (let* ((globals (cadr typed-unit))
         (funcs   (caddr typed-unit))
         (layout-env (if (pair? (cdddr typed-unit)) (list-ref typed-unit 3) #f))
         (fn-names (map (lambda (f) (list-ref f 1)) funcs))
         (ctx (make-c99-lower-ctx fn-names layout-env)))
    ;; Pre-bind globals so static address-of (&g) initializers resolve forward/mutual refs
    (lower-ctx-vars-set! ctx '())
    (for-each
     (lambda (g)
       (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
     globals)
    ;; Serialize static/global definitions into (data ...), deferring any non-constant init
    (let ((deferred-box (cons '() '())))
      (for-each
       (lambda (g)
         (let ((u-sym (list-ref g 1))
               (ty    (list-ref g 3))
               (link  (list-ref g 4))
               (init  (list-ref g 5)))
           (if (not (eq? link 'extern))
               (if (not (%c99-lower-emit-static-data-object! ctx u-sym ty init))
                   (begin
                     (%c99-lower-emit-static-data-object! ctx u-sym ty #f)
                     (set-car! deferred-box (cons g (car deferred-box))))))))
       globals)
      ;; Lower functions (functions also collect any string literals & static compound lits)
      (let ((lir-funcs (map (lambda (f) (%c99-lower-function ctx f globals)) funcs)))
        ;; Build %lir-main for deferred runtime global inits + C main() invocation
        (lower-ctx-vars-set! ctx '())
        (lower-ctx-insts-set! ctx '())
        (lower-ctx-next-si-set! ctx -16)
        (lower-ctx-min-si-set! ctx -16)
        (lower-ctx-ret-plan-set! ctx '(gpr %rax 0 8))
        (for-each
         (lambda (g)
           (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
         globals)
        (for-each
         (lambda (g)
           (let ((u-sym (list-ref g 1))
                 (ty    (list-ref g 3))
                 (init  (list-ref g 5)))
             (cond
               ((%c99-lower-aggregate-like? ty)
                (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
                  (%c99-lower-emit! ctx (list '%global-addr '%rax u-sym))
                  (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
                  (%c99-lower-expr-to-ptr-slot! ctx init ptr-si)))
               ((c-float-type? ty)
                (%c99-lower-expr! ctx init)
                (%c99-lower-emit! ctx (list '%global-addr '%rdx u-sym))
                (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0)))
               (else
                (%c99-lower-expr! ctx init)
                (%c99-lower-store-var! ctx (cdr (assq u-sym (lower-ctx-vars ctx))))))))
         (reverse (car deferred-box)))
        (if (memq 'main fn-names)
            (begin
              (%c99-lower-emit! ctx '(%mov %rdi 0))
              (%c99-lower-emit! ctx '(%mov %rsi 0))
              (%c99-lower-emit! ctx '(%direct-call main 8)))
            (%c99-lower-emit! ctx '(%mov %rax 0)))
        (%c99-lower-emit! ctx '(%return %rax))
        (let* ((main-frame (c-type-align-up (max 16 (- 0 (lower-ctx-min-si ctx))) 16))
               (data-list (reverse (lower-ctx-data-entries ctx)))
               (str-list (reverse (lower-ctx-strings ctx)))
               (funcs-clause (cons '%lir-functions lir-funcs))
               (main-clause (list '%lir-main
                                  (list 'frame-size main-frame)
                                  (cons 'body (reverse (lower-ctx-insts ctx))))))
          (if (null? data-list)
              (list '%lir-program (list 'strings str-list) '(stackmaps ()) funcs-clause main-clause)
              (list '%lir-program (list 'strings str-list) (list 'data data-list) '(stackmaps ()) funcs-clause main-clause)))))))

(define (c99-compile-string-to-lir src-text . maybe-filename)
  (let* ((fname (if (pair? maybe-filename) (car maybe-filename) "<c99-input>"))
         (ast (parse-c99-preprocessed-string src-text fname))
         (typed (c99-analyze-program ast)))
    (c99-lower-to-lir typed)))
