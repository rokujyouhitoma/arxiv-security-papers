;;; =======================================================================
;;; ULisp C99 Frontend: Static Data Serialization & Top-Level LIR/MIR Entrypoint
;;; Modularized orchestrator (Issue #967) working with:
;;;   c99_lower_mir.scm, c99_lower_abi.scm, c99_lower_inline_asm.scm.
;;; Zero local `set!` (ULisp AOT safe).
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 9. Static Global Initializer Serialization (.data / .bss / reloc)
;;; -----------------------------------------------------------------------

(define (%c99-eval-static-addr ctx node)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (inner (c-typed-inner node))
         (tag (car inner)))
    (case tag
      ((c-var-ref)
       (let ((ent (%c99-lower-lookup-var ctx (cadr inner))))
         (if (and ent (eq? (car ent) 'data-global))
             (list 'reloc (cadr ent) 0)
             #f)))
      ((c-fn-ref)
       (list 'reloc (%c99-lower-resolve-runtime-fn! ctx (cadr inner)) 0))
      ((c-str-val)
       (list 'reloc (%c99-lower-intern-str! ctx (cadr inner)) 0))
      ((c-member)
       (let* ((base (cadr inner))
              (deref? (cadddr inner))
              (fl (%c99-lower-member-field-layout ctx inner)))
         (if (or deref? (not fl) (c-field-layout-bit-width fl))
             #f
             (let ((baddr (%c99-eval-static-addr ctx base)))
               (if baddr
                   (list 'reloc (cadr baddr) (+ (caddr baddr) (c-field-layout-offset fl)))
                   #f)))))
      ((c-index)
       (let* ((arr (cadr inner))
              (idx-expr (caddr inner))
              (idx (%c99-lower-extract-const-int idx-expr))
              (elem-sz (c-type-size-in lenv (c-typed-type node)))
              (baddr (if (c-array-type? (c-typed-type arr))
                         (%c99-eval-static-addr ctx arr)
                         #f)))
         (if (and baddr idx)
             (list 'reloc (cadr baddr) (+ (caddr baddr) (* idx elem-sz)))
             #f)))
      ((c-compound-lit)
       ;; Serialize anonymous static compound literal to .data / .bss label
       (let* ((cl-ty (cadr inner))
              (plan (caddr inner))
              (lbl (%c99-lower-new-label ctx "s_clit")))
         (if (%c99-lower-emit-static-data-object! ctx lbl cl-ty plan)
             (list 'reloc lbl 0)
             #f)))
      ((c-implicit-cast c-cast)
       (%c99-eval-static-addr ctx (caddr inner)))
      (else #f))))

(define (%c99-static-fp? v)
  (and (pair? v) (eq? (car v) 'c-static-fp)))

(define (%c99-static-fp->inexact sfp)
  (if (eq? (cadr sfp) 'f32)
      (c99-ieee754-f32-bits->inexact (caddr sfp))
      (c99-ieee754-f64-bits->inexact (caddr sfp))))

(define (%c99-static-fp-zero? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (mask (if (eq? fty 'f32) #x7fffffff #x7fffffffffffffff)))
    (= (bitwise-and bits mask) 0)))

(define (%c99-static-fp-neg? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (shift (if (eq? fty 'f32) -31 -63)))
    (= (bitwise-and (arithmetic-shift bits shift) 1) 1)))

(define (%c99-static-fp-nan? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (exp (if (eq? fty 'f32)
                  (bitwise-and (arithmetic-shift bits -23) #xff)
                  (bitwise-and (arithmetic-shift bits -52) #x7ff)))
         (frac (if (eq? fty 'f32)
                   (bitwise-and bits #x7fffff)
                   (bitwise-and bits #xfffffffffffff))))
    (and (= exp (if (eq? fty 'f32) 255 2047))
         (not (= frac 0)))))

(define (%c99-static-fp-inf? sfp)
  (let* ((fty (cadr sfp))
         (bits (caddr sfp))
         (exp (if (eq? fty 'f32)
                  (bitwise-and (arithmetic-shift bits -23) #xff)
                  (bitwise-and (arithmetic-shift bits -52) #x7ff)))
         (frac (if (eq? fty 'f32)
                   (bitwise-and bits #x7fffff)
                   (bitwise-and bits #xfffffffffffff))))
    (and (= exp (if (eq? fty 'f32) 255 2047))
         (= frac 0))))

(define (%c99-static-fp-div l r fty)
  (let ((lnan (%c99-static-fp-nan? l))
        (rnan (%c99-static-fp-nan? r))
        (lzero (%c99-static-fp-zero? l))
        (rzero (%c99-static-fp-zero? r))
        (lsgn (if (%c99-static-fp-neg? l) 1 0))
        (rsgn (if (%c99-static-fp-neg? r) 1 0))
        (f64? (eq? fty 'f64)))
    (let ((sgn (if (= lsgn rsgn) 0 1)))
      (cond
        ((or lnan rnan)
         (list 'c-static-fp fty (if f64? *c99-f64-qnan* *c99-f32-qnan*)))
        (rzero
         (if (or lzero (%c99-static-fp-inf? l))
             (if lzero
                 (list 'c-static-fp fty (if f64? *c99-f64-qnan* *c99-f32-qnan*))
                 (list 'c-static-fp fty (c99-ieee754-signed-inf sgn f64?)))
             (list 'c-static-fp fty (c99-ieee754-signed-inf sgn f64?))))
        ((and (%c99-static-fp-inf? l) (%c99-static-fp-inf? r))
         (list 'c-static-fp fty (if f64? *c99-f64-qnan* *c99-f32-qnan*)))
        (else
         (let ((res (/ (%c99-static-fp->inexact l) (%c99-static-fp->inexact r))))
           (list 'c-static-fp fty (if f64? (vm-f64->ieee754-u64 res) (vm-f32->ieee754-u32 res)))))))))

(define (%c99-eval-static-val ctx typed-expr)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (ty (c-typed-type typed-expr))
         (inner (c-typed-inner typed-expr))
         (tag (car inner)))
    (case tag
      ((c-const-val)
       (let ((v (cadr inner)))
         (if (and (pair? v) (eq? (car v) 'c-float-bits))
             (list 'c-static-fp ty (cadr v))
             v)))
      ((c-enum-const) (cadr inner))
      ((c-str-val)
       (list 'reloc (%c99-lower-intern-str! ctx (cadr inner)) 0))
      ((c-fn-ref)
       (list 'reloc (%c99-lower-resolve-runtime-fn! ctx (cadr inner)) 0))
      ((c-var-ref)
       (if (c-array-type? ty)
           (%c99-eval-static-addr ctx typed-expr)
           #f))
      ((c-implicit-cast c-cast)
       (let* ((target-ty (cadr inner))
              (sub (caddr inner))
              (src-ty (c-typed-type sub)))
         (cond
           ((and (c-pointer-type? target-ty) (or (c-array-type? src-ty) (c-function-type? src-ty)))
            (%c99-eval-static-addr ctx sub))
           (else
            (let ((sv (%c99-eval-static-val ctx sub)))
              (cond
                ((not sv) #f)
                ((and (pair? sv) (eq? (car sv) 'reloc)) sv) ; reloc pointer preserved across casts
                ((%c99-static-fp? sv)
                 (cond
                   ((c-float-type? target-ty)
                    (let ((sf-ty (cadr sv))
                          (sbits (caddr sv)))
                      (cond
                        ((eq? sf-ty target-ty) sv)
                        ((and (eq? sf-ty 'f32) (eq? target-ty 'f64))
                         (list 'c-static-fp 'f64 (c99-ieee754-f32-bits->f64-bits sbits)))
                        (else
                         (list 'c-static-fp 'f32 (c99-ieee754-f64-bits->f32-bits sbits))))))
                   ((eq? target-ty 'bool)
                    (if (%c99-static-fp-zero? sv) 0 1))
                   ((c-integer-type? target-ty)
                    (if (or (%c99-static-fp-nan? sv) (%c99-static-fp-inf? sv))
                        #f
                        (let ((iv (exact (truncate (%c99-static-fp->inexact sv)))))
                          (cond
                            ((c-type-size-in lenv target-ty)
                             => (lambda (nb)
                                  (let ((mask (arithmetic-shift 1 (* 8 nb))))
                                    (modulo iv mask))))
                            (else iv)))))
                   (else sv)))
                ((c-float-type? target-ty)
                 (if (integer? sv)
                     (let ((norm (if (c-unsigned-type? src-ty)
                                     (cond
                                       ((c-type-size-in lenv src-ty)
                                        => (lambda (nb) (modulo sv (arithmetic-shift 1 (* 8 nb)))))
                                       (else sv))
                                     sv)))
                       (list 'c-static-fp target-ty
                             (if (eq? target-ty 'f32)
                                 (c99-ieee754-int->f32-bits norm)
                                 (c99-ieee754-int->f64-bits norm))))
                     #f))
                ((c-integer-type? target-ty)
                 (let ((iv (if (inexact? sv) (exact (truncate sv)) sv)))
                   (cond
                     ((eq? target-ty 'bool) (if (= iv 0) 0 1))
                     ((c-type-size-in lenv target-ty)
                      => (lambda (nb)
                           (let ((mask (arithmetic-shift 1 (* 8 nb))))
                             (modulo iv mask))))
                     (else iv))))
                (else sv)))))))
      ((c-unop)
       (case (cadr inner)
         ((addr) (%c99-eval-static-addr ctx (caddr inner)))
         ((uplus) (%c99-eval-static-val ctx (caddr inner)))
         ((neg)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (cond
              ((%c99-static-fp? v)
               (list 'c-static-fp (cadr v)
                     (if (eq? (cadr v) 'f32)
                         (c99-ieee754-f32-bits-neg (caddr v))
                         (c99-ieee754-f64-bits-neg (caddr v)))))
              ((number? v) (- 0 v))
              (else #f))))
         ((bit-not)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (if (integer? v) (bitwise-not v) #f)))
         ((lnot)
          (let ((v (%c99-eval-static-val ctx (caddr inner))))
            (cond ((%c99-static-fp? v) (if (%c99-static-fp-zero? v) 1 0))
                  ((pair? v) 0)
                  ((number? v) (if (= v 0) 1 0))
                  (else #f))))
         (else #f)))
      ((c-binop)
       (let ((op (cadr inner))
             (l (%c99-eval-static-val ctx (caddr inner)))
             (r (%c99-eval-static-val ctx (cadddr inner)))
             (lty (c-typed-type (caddr inner)))
             (rty (c-typed-type (cadddr inner))))
         (cond
           ((and (pair? l) (eq? (car l) 'reloc) (integer? r) (memq op '(+ -)) (c-pointer-type? lty))
            (let ((sc (max 1 (c-type-size-in lenv (c-ptr-target lty)))))
              (list 'reloc (cadr l) (+ (caddr l) (* (if (eq? op '+) r (- 0 r)) sc)))))
           ((and (integer? l) (pair? r) (eq? (car r) 'reloc) (eq? op '+) (c-pointer-type? rty))
            (let ((sc (max 1 (c-type-size-in lenv (c-ptr-target rty)))))
              (list 'reloc (cadr r) (+ (caddr r) (* l sc)))))
           ((and (%c99-static-fp? l) (%c99-static-fp? r))
            (let ((fty (if (or (eq? (cadr l) 'f64) (eq? (cadr r) 'f64)) 'f64 'f32)))
              (cond
                ((eq? op '/) (%c99-static-fp-div l r fty))
                ((memq op '(== != < <= > >=))
                 (if (or (%c99-static-fp-nan? l) (%c99-static-fp-nan? r))
                     (if (eq? op '!=) 1 0)
                     (let ((f1 (%c99-static-fp->inexact l))
                           (f2 (%c99-static-fp->inexact r)))
                       (case op
                         ((==) (if (= f1 f2) 1 0))
                         ((!=) (if (= f1 f2) 0 1))
                         ((<)  (if (< f1 f2) 1 0))
                         ((<=) (if (<= f1 f2) 1 0))
                         ((>)  (if (> f1 f2) 1 0))
                         ((>=) (if (>= f1 f2) 1 0))))))
                ((memq op '(+ - *))
                 (let* ((f1 (%c99-static-fp->inexact l))
                        (f2 (%c99-static-fp->inexact r))
                        (res (case op ((+) (+ f1 f2)) ((-) (- f1 f2)) ((*) (* f1 f2)))))
                   (list 'c-static-fp fty
                         (if (eq? fty 'f64) (vm-f64->ieee754-u64 res) (vm-f32->ieee754-u32 res)))))
                (else #f))))
           ((and (number? l) (number? r))
            (case op
              ((+) (+ l r))
              ((-) (- l r))
              ((*) (* l r))
              ((/) (if (= r 0) #f (if (and (integer? l) (integer? r)) (quotient l r) (/ l r))))
              ((rem) (if (or (= r 0) (not (integer? l)) (not (integer? r))) #f (remainder l r)))
              ((<<) (arithmetic-shift l r))
              ((>>) (arithmetic-shift l (- 0 r)))
              ((bit-and) (bitwise-and l r))
              ((bit-or) (bitwise-ior l r))
              ((bit-xor) (bitwise-xor l r))
              ((==) (if (= l r) 1 0))
              ((!=) (if (= l r) 0 1))
              ((<) (if (< l r) 1 0))
              ((<=) (if (<= l r) 1 0))
              ((>) (if (> l r) 1 0))
              ((>=) (if (>= l r) 1 0))
              (else #f)))
           (else #f))))
      ((c-ternary)
       (let ((c (%c99-eval-static-val ctx (cadr inner))))
         (cond
           ((not c) #f)
           ((or (and (%c99-static-fp? c) (not (%c99-static-fp-zero? c)))
                (and (pair? c) (eq? (car c) 'reloc))
                (and (number? c) (not (= c 0))))
            (%c99-eval-static-val ctx (caddr inner)))
           (else
            (%c99-eval-static-val ctx (cadddr inner))))))
      (else #f))))

(define (%c99-bv-write-bytes! bv off byte-list)
  (let loop ((i 0) (bs byte-list))
    (if (pair? bs)
        (begin
          (bytevector-u8-set! bv (+ off i) (modulo (car bs) 256))
          (loop (+ i 1) (cdr bs))))))

(define (%c99-bv-write-bitfield! bv su-off su-bytes bit-off bit-w val)
  (if (> bit-w 0)
      (let ((cur (let rloop ((k (- su-bytes 1)) (acc 0))
                   (if (< k 0) acc (rloop (- k 1) (+ (* acc 256) (bytevector-u8-ref bv (+ su-off k)))))))
            (mask (- (arithmetic-shift 1 bit-w) 1)))
        (let* ((f-bits (modulo (if (inexact? val) (exact (truncate val)) val) (+ mask 1)))
               (cleared (bitwise-and cur (bitwise-not (arithmetic-shift mask bit-off))))
               (updated (bitwise-ior cleared (arithmetic-shift f-bits bit-off))))
          (%c99-bv-write-bytes! bv su-off (c99-int->le-bytes updated su-bytes))))))

(define (%c99-serialize-bv-to-chunks bv sz relocs)
  (let* ((all-zero? (and (null? relocs)
                         (let zc ((i 0))
                           (cond ((>= i sz) #t)
                                 ((not (= (bytevector-u8-ref bv i) 0)) #f)
                                 (else (zc (+ i 1))))))))
    (if all-zero?
        'bss
        (let loop ((i 0) (chunks '()))
          (cond
            ((>= i sz) (reverse chunks))
            ((assv i relocs)
             => (lambda (slot)
                  (loop (+ i 8) (cons (cdr slot) chunks))))
            ((= (bytevector-u8-ref bv i) 0)
             (let zscan ((j i))
               (if (and (< j sz)
                        (not (assv j relocs))
                        (= (bytevector-u8-ref bv j) 0))
                   (zscan (+ j 1))
                   (let ((zlen (- j i)))
                     (if (>= zlen 4)
                         (loop j (cons (list 'zero zlen) chunks))
                         (let eloop ((k i) (acc chunks))
                           (if (>= k j)
                               (loop j acc)
                               (eloop (+ k 1) (cons 0 acc)))))))))
            (else
             (loop (+ i 1) (cons (bytevector-u8-ref bv i) chunks))))))))

(define (%c99-filter-relocs-out relocs lo hi)
  (let loop ((rs relocs) (acc '()))
    (if (null? rs)
        (reverse acc)
        (let ((pos (caar rs)))
          (if (and (>= pos lo) (< pos hi))
              (loop (cdr rs) acc)
              (loop (cdr rs) (cons (car rs) acc)))))))

(define (%c99-lower-emit-static-data-object! ctx lbl ty init-node)
  (let* ((lenv (lower-ctx-layout-env ctx))
         (sz (max 1 (c-type-size-in lenv ty)))
         (al (max 1 (c-type-align-in lenv ty))))
    (if (not init-node)
        (begin
          (%c99-lower-add-data-entry! ctx (list 'bss lbl al sz))
          #t)
        (let* ((bv (make-bytevector sz 0))
               (relocs-box (cons '() '()))
               (ok-box (cons #t '()))
               (inner (c-typed-inner init-node))
               (entries (if (eq? (car inner) 'c-init-plan)
                            (caddr inner)
                            (list (list 'set 0 #f #f #f #f ty init-node)))))
          (for-each
           (lambda (ent)
             (if (car ok-box)
                 (if (eq? (car ent) 'zero-range)
                     (let ((zoff (cadr ent))
                           (zsz (caddr ent)))
                       (set-car! relocs-box (%c99-filter-relocs-out (car relocs-box) zoff (+ zoff zsz)))
                       (let zl ((k 0))
                         (if (< k zsz)
                             (begin (bytevector-u8-set! bv (+ zoff k) 0) (zl (+ k 1))))))
                     (let* ((byte-off (list-ref ent 1))
                            (bit-off  (list-ref ent 2))
                            (bit-w    (list-ref ent 3))
                            (su-off   (list-ref ent 4))
                            (su-ty    (list-ref ent 5))
                            (fty      (list-ref ent 6))
                            (val-expr (list-ref ent 7))
                            (sval     (%c99-eval-static-val ctx val-expr)))
                       (cond
                         ((not sval)
                          (set-car! ok-box #f))
                         (bit-w
                          (let ((su-bytes (c-type-size-in lenv su-ty)))
                            (if (integer? sval)
                                (%c99-bv-write-bitfield! bv su-off su-bytes bit-off bit-w sval)
                                (set-car! ok-box #f))))
                         ((and (pair? sval) (eq? (car sval) 'reloc))
                          (set-car! relocs-box (cons (cons byte-off sval)
                                                     (%c99-filter-relocs-out (car relocs-box) byte-off (+ byte-off 8)))))
                         ((c-float-type? fty)
                          (%c99-bv-write-bytes! bv byte-off
                                                (if (eq? fty 'f32)
                                                    (c99-f32->le-bytes sval)
                                                    (c99-f64->le-bytes sval))))
                         (else
                          (let ((nb (max 1 (c-type-size-in lenv fty))))
                            (%c99-bv-write-bytes! bv byte-off (c99-int->le-bytes (exact (truncate sval)) nb)))))))))
           entries)
          (if (not (car ok-box))
              #f
              (let ((chunks (%c99-serialize-bv-to-chunks bv sz (car relocs-box))))
                (if (eq? chunks 'bss)
                    (%c99-lower-add-data-entry! ctx (list 'bss lbl al sz))
                    (%c99-lower-add-data-entry! ctx (cons 'bytes (cons lbl (cons al chunks)))))
                #t))))))

;;; -----------------------------------------------------------------------
;;; 10. Top-Level Lowering Entrypoint -> L_lir_core %lir-program
;;; -----------------------------------------------------------------------

(define (c99-lower-to-lir typed-unit . maybe-opts)
  (let* ((opts (if (pair? maybe-opts) (car maybe-opts) '()))
         (san? (cond
                 ((boolean? opts) opts)
                 ((pair? opts)
                  (let ((hit (assq 'sanitize-bounds? opts)))
                    (if (and hit (cdr hit)) #t #f)))
                 (else #f)))
         (globals (cadr typed-unit))
         (funcs   (caddr typed-unit))
         (layout-env (if (pair? (cdddr typed-unit)) (list-ref typed-unit 3) #f))
         (ext-meta (if (>= (length typed-unit) 5) (list-ref typed-unit 4) '()))
         (fn-names (map (lambda (f) (list-ref f 1)) funcs))
         (ctx (make-c99-lower-ctx fn-names layout-env san?)))
    ;; Pre-bind globals so static address-of (&g) initializers resolve forward/mutual refs
    (lower-ctx-vars-set! ctx '())
    (for-each
     (lambda (g)
       (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
     globals)
    ;; Serialize static/global definitions into (data ...), deferring any non-constant init
    (let ((deferred-box (cons '() '())))
      (for-each
       (lambda (g)
         (let ((u-sym (list-ref g 1))
               (ty    (list-ref g 3))
               (link  (list-ref g 4))
               (init  (list-ref g 5)))
           (if (not (eq? link 'extern))
               (if (not (%c99-lower-emit-static-data-object! ctx u-sym ty init))
                   (begin
                     (%c99-lower-emit-static-data-object! ctx u-sym ty #f)
                     (set-car! deferred-box (cons g (car deferred-box))))))))
       globals)
      ;; Lower functions (functions also collect any string literals & static compound lits)
      (let ((lir-funcs (map (lambda (f) (%c99-lower-function ctx f globals)) funcs)))
        ;; Build %lir-main for deferred runtime global inits + C main() invocation
        (lower-ctx-vars-set! ctx '())
        (lower-ctx-insts-set! ctx '())
        (lower-ctx-cold-insts-set! ctx '())
        (lower-ctx-next-si-set! ctx -16)
        (lower-ctx-min-si-set! ctx -16)
        (lower-ctx-ret-plan-set! ctx '(gpr %rax 0 8))
        (lower-ctx-gpr-temps-set! ctx *c99-gpr-temp-pool*)
        (lower-ctx-xmm-temps-set! ctx *c99-xmm-temp-pool*)
        (lower-ctx-san-ptr-meta-set! ctx '())
        (lower-ctx-san-last-cap-si-set! ctx
          (if (lower-ctx-sanitize-bounds? ctx) (%c99-lower-alloc-slot! ctx) #f))
        (for-each
         (lambda (g)
           (%c99-lower-bind-data-global! ctx (list-ref g 1) (list-ref g 3)))
         globals)
        (for-each
         (lambda (g)
           (let ((u-sym (list-ref g 1))
                 (ty    (list-ref g 3))
                 (init  (list-ref g 5)))
             (cond
               ((%c99-lower-aggregate-like? ty)
                (let ((ptr-si (%c99-lower-alloc-slot! ctx)))
                  (%c99-lower-emit! ctx (list '%global-addr '%rax u-sym))
                  (%c99-lower-emit! ctx (list '%store '%rsp ptr-si '%rax))
                  (%c99-lower-expr-to-ptr-slot! ctx init ptr-si)))
               ((c-float-type? ty)
                (%c99-lower-expr! ctx init)
                (%c99-lower-emit! ctx (list '%global-addr '%rdx u-sym))
                (%c99-lower-emit! ctx (list '%store-typed ty '%rdx 0 '%xmm0)))
               (else
                (%c99-lower-expr! ctx init)
                (%c99-lower-store-var! ctx (cdr (assq u-sym (lower-ctx-vars ctx))))))))
         (reverse (car deferred-box)))
        (if (memq 'main fn-names)
            (begin
              (%c99-lower-emit! ctx '(%mov %rdi 0))
              (%c99-lower-emit! ctx '(%mov %rsi 0))
              (%c99-lower-emit! ctx '(%direct-call main 8)))
            (%c99-lower-emit! ctx '(%mov %rax 0)))
        (%c99-lower-emit! ctx '(%return %rax))
        (let* ((main-frame (c-type-align-up (max 16 (- 0 (lower-ctx-min-si ctx))) 16))
               (data-list (reverse (lower-ctx-data-entries ctx)))
               (str-list (reverse (lower-ctx-strings ctx)))
               (builtin-fns
                (append
                 (if (and (lower-ctx-needs-setjmp? ctx) (not (memq '__ulisp_setjmp fn-names)))
                     (list (make-c99-builtin-setjmp-lir))
                     '())
                 (append
                  (if (and (lower-ctx-needs-longjmp? ctx) (not (memq '__ulisp_longjmp fn-names)))
                      (list (make-c99-builtin-longjmp-lir))
                      '())
                  (if (and (lower-ctx-needs-san-trap? ctx) (not (memq '__ulisp_san_trap fn-names)))
                      (list (make-c99-builtin-san-trap-lir))
                      '()))))
               (funcs-clause (cons '%lir-functions (append lir-funcs builtin-fns)))
               (main-cold (lower-ctx-cold-insts ctx))
               (main-body (if (null? main-cold)
                              (reverse (lower-ctx-insts ctx))
                              (append (reverse (lower-ctx-insts ctx)) (reverse main-cold))))
               (main-clause (list '%lir-main
                                  (list 'frame-size main-frame)
                                  (cons 'body main-body)))
               (wf-hit (assq 'weak-fns ext-meta))
               (wd-hit (assq 'weak-data ext-meta))
               (al-hit (assq 'aliases ext-meta))
               (ta-hit (assq 'top-asm ext-meta))
               (wf-list (if (and wf-hit (pair? (cdr wf-hit))) (cdr wf-hit) '()))
               (wd-list (if (and wd-hit (pair? (cdr wd-hit))) (cdr wd-hit) '()))
               (al-list (if (and al-hit (pair? (cdr al-hit))) (cdr al-hit) '()))
               (ta-raws (if (and ta-hit (pair? (cdr ta-hit))) (cdr ta-hit) '()))
               (ta-lines
                (let tloop ((xs ta-raws) (acc '()))
                  (if (null? xs)
                      acc
                      (tloop (cdr xs) (append acc (c99-att-asm->intel-asm (car xs) #t))))))
               (meta-clauses
                (append
                 (if (pair? wf-list) (list (list 'weak-fns wf-list)) '())
                 (append
                  (if (pair? wd-list) (list (list 'weak-data wd-list)) '())
                  (append
                   (if (pair? al-list) (list (list 'aliases al-list)) '())
                   (if (pair? ta-lines) (list (list 'top-asm ta-lines)) '())))))
               (base-prog
                (if (null? data-list)
                    (list '%lir-program (list 'strings str-list) '(stackmaps ()) funcs-clause main-clause)
                    (list '%lir-program (list 'strings str-list) (list 'data data-list) '(stackmaps ()) funcs-clause main-clause))))
          (append base-prog meta-clauses))))))

(define (c99-compile-string-to-lir src-text . maybe-opts)
  (let* ((fname (if (and (pair? maybe-opts) (string? (car maybe-opts)))
                    (car maybe-opts)
                    "<c99-input>"))
         (lower-opts (if (and (pair? maybe-opts) (pair? (cdr maybe-opts)))
                         (cadr maybe-opts)
                         '()))
         (ast (parse-c99-preprocessed-string src-text fname))
         (typed (c99-analyze-program ast)))
    (c99-lower-to-lir typed lower-opts)))

(define (c99-lower-to-mir-ssa typed-unit . maybe-opts)
  (let* ((opts (if (pair? maybe-opts) (car maybe-opts) '()))
         (core-lir (c99-lower-to-lir typed-unit opts)))
    (lir-to-mir-ssa core-lir)))

(define (c99-compile-string-to-mir-ssa src-text . maybe-opts)
  (let* ((fname (if (and (pair? maybe-opts) (string? (car maybe-opts)))
                    (car maybe-opts)
                    "<c99-input>"))
         (lower-opts (if (and (pair? maybe-opts) (pair? (cdr maybe-opts)))
                         (cadr maybe-opts)
                         '()))
         (ast (parse-c99-preprocessed-string src-text fname))
         (typed (c99-analyze-program ast)))
    (c99-lower-to-mir-ssa typed lower-opts)))
