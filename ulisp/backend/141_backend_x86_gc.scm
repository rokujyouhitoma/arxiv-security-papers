;;; =======================================================================
;;; ULisp Compiler Pass 141: Native x86-64 Garbage Collector Code Generator
;;; Conforms to DSN-33 Architecture Specification & Issue #569
;;; Emits inline copying/mark-sweep GC collector and OOM panic routines.
;;; =======================================================================

(define (emit-oom-panic)
  (emit "    .globl ulisp_oom_panic")
  (emit "    .weak ulisp_oom_panic")
  (emit "    .type ulisp_oom_panic, @function")
  (emit "    .p2align 4")
  (emit "ulisp_oom_panic:")
  (emit "    lea rsi, [rip + .L_str_oom_panic]")
  (emit "    mov rdx, 46")                      ; string length
  (emit "    mov rax, 1")                       ; sys_write
  (emit "    mov rdi, 2")                       ; stderr
  (emit "    syscall")
  (emit "    mov rax, 60")                      ; sys_exit
  (emit "    mov rdi, 1")                       ; exit code 1
  (emit "    syscall")
  (emit ".L_str_oom_panic:")
  (emit "    .asciz \"Fatal Error: ULisp Heap Limit Exhausted (OOM)\\n\"")
  (emit "    .p2align 3")
  (emit "")
  (emit "    .globl ulisp_gc_write_barrier")
  (emit "    .weak ulisp_gc_write_barrier")
  (emit "    .type ulisp_gc_write_barrier, @function")
  (emit "    .p2align 4")
  (emit "ulisp_gc_write_barrier:")
  (emit "    test al, 1")
  (emit "    jz .L_wb_done")
  (emit "    push rcx")
  (emit "    push r8")
  (emit "    push r9")
  (emit "    push r11")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    cmp qword ptr [r11 + 88], 1")
  (emit "    jne .L_wb_restore")
  (emit "    mov r8, rax")
  (emit "    and r8, -8")
  (emit "    mov r9, [r11 + 0]")
  (emit "    cmp r8, r9")
  (emit "    jb .L_wb_restore")
  (emit "    add r9, [r11 + 8]")
  (emit "    cmp r8, r9")
  (emit "    jae .L_wb_restore")
  (emit "    mov r9, [r11 + 16]")
  (emit "    cmp rdx, r9")
  (emit "    jb .L_wb_restore")
  (emit "    add r9, [r11 + 32]")
  (emit "    cmp rdx, r9")
  (emit "    jae .L_wb_restore")
  (emit "    mov rcx, [r11 + 72]")
  (emit "    test rcx, rcx")
  (emit "    jz .L_wb_restore")
  (emit "    mov r8, [r11 + 80]")
  (emit "    xor r9, r9")
  (emit ".L_wb_dedup_loop:")
  (emit "    cmp r9, r8")
  (emit "    jae .L_wb_insert")
  (emit "    cmp [rcx + r9*8], rdx")
  (emit "    je .L_wb_restore")
  (emit "    inc r9")
  (emit "    jmp .L_wb_dedup_loop")
  (emit ".L_wb_insert:")
  (emit "    cmp r8, 4096")
  (emit "    jae .L_wb_restore")
  (emit "    mov [rcx + r8*8], rdx")
  (emit "    inc r8")
  (emit "    mov [r11 + 80], r8")
  (emit ".L_wb_restore:")
  (emit "    pop r11")
  (emit "    pop r9")
  (emit "    pop r8")
  (emit "    pop rcx")
  (emit ".L_wb_done:")
  (emit "    ret"))

(define (emit-gc-collector)
  (emit "    .globl ulisp_alloc_slow_trampoline")
  (emit "    .weak ulisp_alloc_slow_trampoline")
  (emit "    .type ulisp_alloc_slow_trampoline, @function")
  (emit "    .p2align 4")
  (emit "ulisp_alloc_slow_trampoline:")
  ;; Caller already shifted rsp by shift (16-byte aligned).
  ;; The call pushed an 8-byte return address, so rsp is (16k + 8).
  ;; Subtract 88 bytes: (16k + 8 - 88) = 16(k - 5), perfectly 16-byte aligned.
  (emit "    sub rsp, 88")
  (emit "    mov [rsp + 0], rax")
  (emit "    mov [rsp + 8], rcx")
  (emit "    mov [rsp + 16], rdx")
  (emit "    mov [rsp + 24], rsi")
  (emit "    mov [rsp + 32], rdi")
  (emit "    mov [rsp + 40], r8")
  (emit "    mov [rsp + 48], r9")
  (emit "    mov [rsp + 56], r10")
  (emit "    mov [rsp + 64], r11")
  (emit "    mov qword ptr [rsp + 72], 0")
  (emit "    mov qword ptr [rsp + 80], 0")
  (emit "    mov rdi, rsp")
  (emit "    call ulisp_gc_collect")
  (emit "    mov rax, [rsp + 0]")
  (emit "    mov rcx, [rsp + 8]")
  (emit "    mov rdx, [rsp + 16]")
  (emit "    mov rsi, [rsp + 24]")
  (emit "    mov rdi, [rsp + 32]")
  (emit "    mov r8,  [rsp + 40]")
  (emit "    mov r9,  [rsp + 48]")
  (emit "    mov r10, [rsp + 56]")
  (emit "    mov r11, [rsp + 64]")
  (emit "    add rsp, 88")
  (emit "    ret")
  (emit "")

  (emit "    .globl ulisp_gc_collect")
  (emit "    .weak ulisp_gc_collect")
  (emit "    .type ulisp_gc_collect, @function")
  (emit "    .p2align 4")
  (emit "ulisp_gc_collect:")
  (emit "    push rbx")
  (emit "    push rbp")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    push r15")
  (emit "    sub rsp, 48")
  (emit "    mov [rsp], rdi")                   ; preserve deepest_sp (Issue #568)
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    cmp qword ptr [r11 + 160], 0")
  (emit "    je .L_gc_start_no_stats")
  (emit "    mov rax, r12")
  (emit "    sub rax, [r11 + 0]")               ; r12 - nursery_base / from
  (emit "    test rax, rax")
  (emit "    jle .L_gc_start_rec_time")
  (emit "    add [r11 + 136], rax")             ; add to total_alloc_bytes
  (emit ".L_gc_start_rec_time:")
  (emit "    mov rax, 228")                     ; sys_clock_gettime
  (emit "    mov rdi, 1")                       ; CLOCK_MONOTONIC
  (emit "    lea rsi, [rsp + 16]")
  (emit "    syscall")
  (emit ".L_gc_start_no_stats:")
  (emit "    mov rax, [r11 + 88]")              ; gen_mode
  (emit "    cmp rax, 1")
  (emit "    je .L_gc_minor_start")
  ;; --- Dual-Space GC ---
  (emit ".L_gc_dual_start:")
  (emit "    mov rax, [r11 + 8]")               ; to
  (emit "    mov [rsp + 8], rax")               ; save initial to for survived bytes
  (emit "    mov [r11 + 40], rax")              ; free_ptr = to
  (emit "    mov rbx, rax")                     ; scan_start = to
  (emit "    mov rsi, [r11 + 24]")              ; bottom
  (emit "    test rsi, rsi")
  (emit "    jnz .L_gc_dual_has_bottom")
  (emit "    lea rax, [rip + ulisp_stack_base]")
  (emit "    mov rsi, [rax]")
  (emit "    test rsi, rsi")
  (emit "    jnz .L_gc_dual_has_bottom")
  (emit "    mov rsi, rdi")
  (emit ".L_gc_dual_has_bottom:")
  (emit "    mov rdx, rdi")                     ; curr_sp = deepest_sp
  (emit "    lea rax, [rip + __ulisp_stackmap_table]")
  (emit "    mov rcx, [rax]")                   ; safepoints count
  (emit "    test rcx, rcx")
  (emit "    jz .L_gc_dual_conserv_loop")
  (emit ".L_gc_dual_sm_walk:")
  (emit "    cmp rdx, rsi")
  (emit "    jae .L_gc_dual_sm_done")
  (emit "    mov r8, [rdx]")
  (emit "    xor r9, r9")
  (emit ".L_gc_dual_sm_search:")
  (emit "    cmp r9, rcx")
  (emit "    jae .L_gc_dual_sm_not_found")
  (emit "    imul r11, r9, 24")
  (emit "    mov r10, [rax + 8 + r11]")
  (emit "    cmp r10, r8")
  (emit "    je .L_gc_dual_sm_found")
  (emit "    inc r9")
  (emit "    jmp .L_gc_dual_sm_search")
  (emit ".L_gc_dual_sm_found:")
  (emit "    imul r11, r9, 24")
  (emit "    mov r10, [rax + 16 + r11]")      ; frame_size
  (emit "    mov rbp, [rax + 24 + r11]")      ; bitmap
  (emit "    lea r13, [rdx + 8]")               ; frame_base
  (emit "    mov r14, r10")
  (emit "    shr r14, 3")
  (emit "    xor r15, r15")
  (emit ".L_gc_dual_sm_slot_loop:")
  (emit "    cmp r15, r14")
  (emit "    jae .L_gc_dual_sm_frame_done")
  (emit "    cmp r15, 60")
  (emit "    jae .L_gc_dual_sm_slot_copy")
  (emit "    bt rbp, r15")
  (emit "    jnc .L_gc_dual_sm_slot_next")
  (emit ".L_gc_dual_sm_slot_copy:")
  (emit "    lea rcx, [r13 + r15*8]")
  (emit "    mov rdi, [rcx]")
  (emit "    push rdx")
  (emit "    push rcx")
  (emit "    push rax")
  (emit "    push r11")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rax")
  (emit "    pop rcx")
  (emit "    pop rdx")
  (emit "    mov [rcx], r11")
  (emit ".L_gc_dual_sm_slot_next:")
  (emit "    inc r15")
  (emit "    jmp .L_gc_dual_sm_slot_loop")
  (emit ".L_gc_dual_sm_frame_done:")
  (emit "    add rdx, 8")
  (emit "    add rdx, r10")
  (emit "    lea rax, [rip + __ulisp_stackmap_table]")
  (emit "    mov rcx, [rax]")
  (emit "    jmp .L_gc_dual_sm_walk")
  (emit ".L_gc_dual_sm_not_found:")
  (emit "    mov rdi, [rdx]")
  (emit "    push rdx")
  (emit "    push rsi")
  (emit "    push rax")
  (emit "    push rcx")
  (emit "    push r11")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rcx")
  (emit "    pop rax")
  (emit "    pop rsi")
  (emit "    pop rdx")
  (emit "    mov [rdx], r11")
  (emit "    add rdx, 8")
  (emit "    jmp .L_gc_dual_sm_walk")
  (emit ".L_gc_dual_sm_done:")
  (emit "    mov rdx, [rsp]")                   ; restore rdx = deepest_sp (Issue #568)
  (emit ".L_gc_dual_conserv_loop:")
  (emit "    cmp rdx, rsi")
  (emit "    jae .L_gc_dual_scan_globals")
  (emit "    mov rdi, [rdx]")
  (emit "    push rdx")
  (emit "    push rsi")
  (emit "    push r11")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r11")
  (emit "    pop rsi")
  (emit "    pop rdx")
  (emit "    cmp rax, [rdx]")
  (emit "    je .L_gc_dual_conserv_no_rescue")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    add qword ptr [r11 + 120], 2")     ; increment rescued unmapped pointer count
  (emit ".L_gc_dual_conserv_no_rescue:")
  (emit "    mov [rdx], rax")
  (emit "    add rdx, 8")
  (emit "    jmp .L_gc_dual_conserv_loop")
  ;; Scan globals across all linked modules
  (emit ".L_gc_dual_scan_globals:")
  (emit "    lea r8, [rip + __start_ulisp_globals_sec]")
  (emit "    lea r9, [rip + __stop_ulisp_globals_sec]")
  (emit ".L_gc_dual_globals_loop:")
  (emit "    cmp r8, r9")
  (emit "    jae .L_gc_dual_cheney")
  (emit "    mov r10, [r8]")
  (emit "    mov rdi, [r10]")
  (emit "    push r8")
  (emit "    push r9")
  (emit "    push r10")
  (emit "    push r11")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop r10")
  (emit "    pop r9")
  (emit "    pop r8")
  (emit "    mov [r10], r11")
  (emit "    add r8, 8")
  (emit "    jmp .L_gc_dual_globals_loop")
  ;; Cheney scan To-space
  (emit ".L_gc_dual_cheney:")
  (emit ".L_gc_dual_cheney_loop:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    cmp rbx, [r11 + 40]")
  (emit "    jae .L_gc_dual_finish")
  (emit "    mov r10, [rbx]")
  (emit "    mov rax, r10")
  (emit "    shr rax, 2")
  (emit "    mov rdx, rax")
  (emit "    and rdx, 255")                     ; type
  (emit "    mov r13, rax")
  (emit "    shr r13, 16")
  (emit "    add r13, 8")                       ; total_bytes
  (emit "    lea r14, [rbx + 8]")
  (emit "    cmp rdx, 1")                       ; Type 1: Pair
  (emit "    jne .L_gc_dual_check_closure")
  (emit "    mov rdi, [r14]")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    pop rbx")
  (emit "    mov [r14], rax")
  (emit "    mov rdi, [r14 + 8]")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    pop rbx")
  (emit "    mov [r14 + 8], rax")
  (emit "    jmp .L_gc_dual_cheney_next")
  (emit ".L_gc_dual_check_closure:")
  (emit "    cmp rdx, 2")
  (emit "    jne .L_gc_dual_check_vector")
  (emit "    mov rax, r10")
  (emit "    shr rax, 2")
  (emit "    shr rax, 8")
  (emit "    and rax, 255")
  (emit "    cmp rax, 1")
  (emit "    jle .L_gc_dual_cheney_next")
  (emit "    mov r15, 1")
  (emit ".L_gc_dual_closure_fields:")
  (emit "    cmp r15, rax")
  (emit "    jae .L_gc_dual_cheney_next")
  (emit "    mov rdi, [r14 + r15*8]")
  (emit "    push rax")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    push r15")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r15")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rbx")
  (emit "    pop rax")
  (emit "    mov [r14 + r15*8], r11")
  (emit "    inc r15")
  (emit "    jmp .L_gc_dual_closure_fields")
  (emit ".L_gc_dual_check_vector:")
  (emit "    cmp rdx, 5")
  (emit "    jne .L_gc_dual_cheney_next")
  (emit "    mov rax, [r14]")
  (emit "    shr rax, 2")
  (emit "    test rax, rax")
  (emit "    jle .L_gc_dual_cheney_next")
  (emit "    xor r15, r15")
  (emit ".L_gc_dual_vector_elems:")
  (emit "    cmp r15, rax")
  (emit "    jae .L_gc_dual_cheney_next")
  (emit "    mov rdi, [r14 + 8 + r15*8]")
  (emit "    push rax")
  (emit "    push rbx")
  (emit "    push r11")
  (emit "    push r13")
  (emit "    push r14")
  (emit "    push r15")
  (emit "    call .L_gc_copy_if_heap_dual")
  (emit "    pop r15")
  (emit "    pop r14")
  (emit "    pop r13")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rbx")
  (emit "    pop rax")
  (emit "    mov [r14 + 8 + r15*8], r11")
  (emit "    inc r15")
  (emit "    jmp .L_gc_dual_vector_elems")
  (emit ".L_gc_dual_cheney_next:")
  (emit "    add rbx, r13")
  (emit "    jmp .L_gc_dual_cheney_loop")
  (emit ".L_gc_dual_finish:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov rax, [r11 + 0]")
  (emit "    mov rcx, [r11 + 8]")
  (emit "    mov [r11 + 0], rcx")
  (emit "    mov [r11 + 8], rax")
  (emit "    inc qword ptr [r11 + 32]")
  (emit "    mov rax, [r11 + 40]")              ; free_ptr
  (emit "    sub rax, [rsp + 8]")               ; free_ptr - initial_to
  (emit "    add [r11 + 144], rax")             ; total_survived_bytes += survived
  (emit "    mov r12, [r11 + 40]")              ; r12 = free_ptr
  (emit "    mov rax, [r11 + 0]")
  (emit "    add rax, [r11 + 16]")
  (emit "    lea rdx, [rip + ulisp_heap_limit]")
  (emit "    mov [rdx], rax")
  (emit "    jmp .L_gc_exit")

  ;; --- Generational Minor GC ---
  (emit ".L_gc_minor_start:")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    mov rax, [r11 + 40]")              ; mature_free
  (emit "    mov [rsp + 8], rax")               ; save mature_free_start
  (emit "    mov rbx, rax")                     ; scan_start = mature_free
  (emit "    mov rsi, [r11 + 48]")              ; bottom
  (emit "    test rsi, rsi")
  (emit "    jnz .L_gc_minor_has_bottom")
  (emit "    lea rax, [rip + ulisp_stack_base]")
  (emit "    mov rsi, [rax]")
  (emit "    test rsi, rsi")
  (emit "    jnz .L_gc_minor_has_bottom")
  (emit "    mov rsi, rdi")
  (emit ".L_gc_minor_has_bottom:")
  (emit "    mov rdx, rdi")
  (emit "    lea rax, [rip + __ulisp_stackmap_table]")
  (emit "    mov rcx, [rax]")
  (emit "    test rcx, rcx")
  (emit "    jz .L_gc_minor_conserv_loop")
  (emit ".L_gc_minor_sm_walk:")
  (emit "    cmp rdx, rsi")
  (emit "    jae .L_gc_minor_sm_done")
  (emit "    mov r8, [rdx]")
  (emit "    xor r9, r9")
  (emit ".L_gc_minor_sm_search:")
  (emit "    cmp r9, rcx")
  (emit "    jae .L_gc_minor_sm_not_found")
  (emit "    imul r11, r9, 24")
  (emit "    mov r10, [rax + 8 + r11]")
  (emit "    cmp r10, r8")
  (emit "    je .L_gc_minor_sm_found")
  (emit "    inc r9")
  (emit "    jmp .L_gc_minor_sm_search")
  (emit ".L_gc_minor_sm_found:")
  (emit "    imul r11, r9, 24")
  (emit "    mov r10, [rax + 16 + r11]")
  (emit "    mov rbp, [rax + 24 + r11]")
  (emit "    lea r13, [rdx + 8]")
  (emit "    mov r14, r10")
  (emit "    shr r14, 3")
  (emit "    xor r15, r15")
  (emit ".L_gc_minor_sm_slot_loop:")
  (emit "    cmp r15, r14")
  (emit "    jae .L_gc_minor_sm_frame_done")
  (emit "    cmp r15, 60")
  (emit "    jae .L_gc_minor_sm_slot_copy")
  (emit "    bt rbp, r15")
  (emit "    jnc .L_gc_minor_sm_slot_next")
  (emit ".L_gc_minor_sm_slot_copy:")
  (emit "    lea rcx, [r13 + r15*8]")
  (emit "    mov rdi, [rcx]")
  (emit "    push rdx")
  (emit "    push rcx")
  (emit "    push rax")
  (emit "    push r11")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rax")
  (emit "    pop rcx")
  (emit "    pop rdx")
  (emit "    mov [rcx], r11")
  (emit ".L_gc_minor_sm_slot_next:")
  (emit "    inc r15")
  (emit "    jmp .L_gc_minor_sm_slot_loop")
  (emit ".L_gc_minor_sm_frame_done:")
  (emit "    add rdx, 8")
  (emit "    add rdx, r10")
  (emit "    lea rax, [rip + __ulisp_stackmap_table]")
  (emit "    mov rcx, [rax]")
  (emit "    jmp .L_gc_minor_sm_walk")
  (emit ".L_gc_minor_sm_not_found:")
  (emit "    mov rdi, [rdx]")
  (emit "    push rdx")
  (emit "    push rsi")
  (emit "    push rax")
  (emit "    push rcx")
  (emit "    push r11")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop r11")
  (emit "    mov r11, rax")
  (emit "    pop rcx")
  (emit "    pop rax")
  (emit "    pop rsi")
  (emit "    pop rdx")
  (emit "    mov [rdx], r11")
  (emit "    add rdx, 8")
  (emit "    jmp .L_gc_minor_sm_walk")
  (emit ".L_gc_minor_sm_done:")
  (emit "    mov rdx, [rsp]")                   ; restore rdx = deepest_sp (Issue #568)
  (emit ".L_gc_minor_conserv_loop:")
  (emit "    cmp rdx, rsi")
  (emit "    jae .L_gc_minor_scan_globals")
  (emit "    mov rdi, [rdx]")
  (emit "    push rdx")
  (emit "    push rsi")
  (emit "    push r11")
  (emit "    call .L_gc_promote_if_nursery")
  (emit "    pop r11")
  (emit "    pop rsi")
  (emit "    pop rdx")
  (emit "    cmp rax, [rdx]")
  (emit "    je .L_gc_minor_conserv_no_rescue")
  (emit "    lea r11, [rip + ulisp_gc_state]")
  (emit "    add qword ptr [r11 + 120], 2")     ; increment rescued unmapped pointer count
  (emit ".L_gc_minor_conserv_no_rescue:")
  (emit "    mov [rdx], rax")
  (emit "    add rdx, 8")
  (emit "    jmp .L_gc_minor_conserv_loop")
  ;; Scan globals across all linked modules
  (emit ".L_gc_minor_scan_globals:")
  (emit "    lea r8, [rip + __start_ulisp_globals_sec]")
  (emit "    lea r9, [rip + __stop_ulisp_globals_sec]")
  (emit ".L_gc_minor_globals_loop:")
  (emit "    cmp r8, r9")
  (emit "    jae .L_gc_minor_scan_remset")
  (emit "    mov r10, [r8]")
  (emit "    mov rdi, [r10]")
