                  (list '%raw-asm (string-append "    setne " d8-str))
                  (list '%raw-asm (string-append "    setp " t1-8))
                  (list '%raw-asm (string-append "    movzx " d-str ", " d8-str))
                  (list '%raw-asm (string-append "    movzx " t1 ", " t1-8))
                  (list '%raw-asm (string-append "    or " d-str ", " t1)))))))

      ((%bitcast-f64-to-i64)
