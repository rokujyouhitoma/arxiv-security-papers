                  (list '%raw-asm (string-append "    movzx " d-str ", " d8-str))))
           ((%fcmp-oge)
            (list (list '%raw-asm (string-append "    ucomisd " l-str ", " r-str))
                  (list '%raw-asm (string-append "    setae " d8-str))
                  (list '%raw-asm (string-append "    movzx " d-str ", " d8-str))))
           ((%fcmp-olt)
