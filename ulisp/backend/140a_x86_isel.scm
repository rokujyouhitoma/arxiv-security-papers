;;; =======================================================================
;;; ULisp Compiler Pass 140: Native x86-64 Backend Code Generator
;;; Conforms to DSN-33 Architecture Specification & Issue #596
;;; Implements 2-stage backend: Instruction Selection (LIR -> L_asm_x86)
;;; and Assembly Code Emission (L_asm_x86 -> GNU x86-64 Intel Syntax).
;;; =======================================================================

(define *emit-line-sink* (cons #f '()))

(define (set-emit-line-sink! sink)
  (set-car! *emit-line-sink* sink))

(define (get-emit-line-sink)
  (car *emit-line-sink*))

(define (emit line)
  (let ((sink (car *emit-line-sink*)))
    (if sink
        (sink line)
        (begin
          (write-string line)
          (write-char #\newline)))))

(define (emit-inst2 op a1)
  (let ((sink (car *emit-line-sink*)))
    (if sink
        (sink (string-append "    " op " " a1))
        (begin
          (write-string "    ")
          (write-string op)
          (write-char #\space)
          (write-string a1)
          (write-char #\newline)))))

(define (emit-inst3 op a1 a2)
  (let ((sink (car *emit-line-sink*)))
    (if sink
        (sink (string-append "    " op " " a1 ", " a2))
        (begin
          (write-string "    ")
          (write-string op)
          (write-char #\space)
          (write-string a1)
          (write-string ", ")
          (write-string a2)
          (write-char #\newline)))))

(define *small-int-cache* (make-vector 1024 #f))
(define (small-int->string n)
  (if (and (>= n 0) (< n 1024))
      (let ((cached (vector-ref *small-int-cache* n)))
        (if cached
            cached
            (let ((s (number->string n)))
              (vector-set! *small-int-cache* n s)
              s)))
      (number->string n)))

(define *stack-opnd-cache* (make-vector 256 #f))
(define (get-stack-opnd-str off)
  (if (and (<= off 0) (>= off -2040) (= (modulo off 8) 0))
      (let* ((idx (- 0 (quotient off 8)))
             (cached (vector-ref *stack-opnd-cache* idx)))
        (if cached
            cached
            (let ((s (string-append "[rsp " (offset->string off) "]")))
              (vector-set! *stack-opnd-cache* idx s)
              s)))
      (string-append "[rsp " (offset->string off) "]")))

(define (backend-append-2 l1 l2)
  (if (null? l1)
      l2
      (cons (car l1) (backend-append-2 (cdr l1) l2))))

(define (backend-concat lists)
  (let loop ((rest lists))
    (cond
      ((null? rest) '())
      ((null? (cdr rest)) (car rest))
      (else (backend-append-2 (car rest) (loop (cdr rest)))))))

(define (reg->str reg)
  (case reg
    ((%rax rax) "rax")
    ((%rbx rbx) "rbx")
    ((%rcx rcx) "rcx")
    ((%rdx rdx) "rdx")
    ((%rsi rsi) "rsi")
    ((%rdi rdi) "rdi")
    ((%rbp rbp) "rbp")
    ((%rsp rsp) "rsp")
    ((%r8  r8)  "r8")
    ((%r9  r9)  "r9")
    ((%r10 r10) "r10")
    ((%r11 r11) "r11")
    ((%r12 r12) "r12")
    ((%r13 r13) "r13")
    ((%r14 r14) "r14")
    ((%r15 r15) "r15")
    ((%eax eax) "eax") ((%ebx ebx) "ebx") ((%ecx ecx) "ecx") ((%edx edx) "edx")
    ((%esi esi) "esi") ((%edi edi) "edi") ((%ebp ebp) "ebp") ((%esp esp) "esp")
    ((%r8d r8d) "r8d") ((%r9d r9d) "r9d") ((%r10d r10d) "r10d") ((%r11d r11d) "r11d")
    ((%r12d r12d) "r12d") ((%r13d r13d) "r13d") ((%r14d r14d) "r14d") ((%r15d r15d) "r15d")
    ((%al  al)  "al")  ((%bl  bl)  "bl")  ((%cl  cl)  "cl")  ((%dl  dl)  "dl")
    ((%sil sil) "sil") ((%dil dil) "dil") ((%bpl bpl) "bpl") ((%spl spl) "spl")
    ((%r8b r8b) "r8b") ((%r9b r9b) "r9b") ((%r10b r10b) "r10b") ((%r11b r11b) "r11b")
    ((%r12b r12b) "r12b") ((%r13b r13b) "r13b") ((%r14b r14b) "r14b") ((%r15b r15b) "r15b")
    ((%xmm0 xmm0) "xmm0")
    ((%xmm1 xmm1) "xmm1")
    ((%xmm2 xmm2) "xmm2")
    ((%xmm3 xmm3) "xmm3")
    ((%xmm4 xmm4) "xmm4")
    ((%xmm5 xmm5) "xmm5")
    ((%xmm6 xmm6) "xmm6")
    ((%xmm7 xmm7) "xmm7")
    ((%xmm8 xmm8) "xmm8")
    ((%xmm9 xmm9) "xmm9")
    ((%xmm10 xmm10) "xmm10")
    ((%xmm11 xmm11) "xmm11")
    ((%xmm12 xmm12) "xmm12")
    ((%xmm13 xmm13) "xmm13")
    ((%xmm14 xmm14) "xmm14")
    ((%xmm15 xmm15) "xmm15")
    (else
     (cond
       ((and (pair? reg) (eq? (car reg) '%reg))
        (if (and (pair? (cdr reg)) (pair? (cddr reg)))
            (reg->str (caddr reg))
            (reg->str (cadr reg))))
       ((and (pair? reg) (eq? (car reg) '%freg))
        (reg->str (cadr reg)))
       ((symbol? reg) (asm-label->str reg))
       (else reg)))))

(define (reg8->str reg)
  (case reg
    ((%rax rax) "al")
    ((%rbx rbx) "bl")
    ((%rcx rcx) "cl")
    ((%rdx rdx) "dl")
    ((%rsi rsi) "sil")
    ((%rdi rdi) "dil")
    ((%rbp rbp) "bpl")
    ((%rsp rsp) "spl")
    ((%r8  r8)  "r8b")
    ((%r9  r9)  "r9b")
    ((%r10 r10) "r10b")
    ((%r11 r11) "r11b")
    ((%r12 r12) "r12b")
    ((%r13 r13) "r13b")
    ((%r14 r14) "r14b")
    ((%r15 r15) "r15b")
    ((%al  al)  "al")
    ((%cl  cl)  "cl")
    (else (reg->str reg))))

(define (reg16->str reg)
  (case reg
    ((%rax rax) "ax")
    ((%rbx rbx) "bx")
    ((%rcx rcx) "cx")
    ((%rdx rdx) "dx")
    ((%rsi rsi) "si")
    ((%rdi rdi) "di")
    ((%rbp rbp) "bp")
    ((%rsp rsp) "sp")
    ((%r8  r8)  "r8w")
    ((%r9  r9)  "r9w")
    ((%r10 r10) "r10w")
    ((%r11 r11) "r11w")
    ((%r12 r12) "r12w")
    ((%r13 r13) "r13w")
    ((%r14 r14) "r14w")
    ((%r15 r15) "r15w")
    (else (reg->str reg))))

(define (reg32->str reg)
  (case reg
    ((%rax rax) "eax")
    ((%rbx rbx) "ebx")
    ((%rcx rcx) "ecx")
    ((%rdx rdx) "edx")
    ((%rsi rsi) "esi")
    ((%rdi rdi) "edi")
    ((%rbp rbp) "ebp")
    ((%rsp rsp) "esp")
    ((%r8  r8)  "r8d")
    ((%r9  r9)  "r9d")
    ((%r10 r10) "r10d")
    ((%r11 r11) "r11d")
    ((%r12 r12) "r12d")
    ((%r13 r13) "r13d")
    ((%r14 r14) "r14d")
    ((%r15 r15) "r15d")
    (else (reg->str reg))))

(define (mem-op->str base offset)
  (cond
    ((and (or (eq? base 'rax) (eq? base '%rax)) (eq? offset -1)) "[rax - 1]")
    ((and (or (eq? base 'rax) (eq? base '%rax)) (eq? offset 7)) "[rax + 7]")
    (else
     (let ((base-str (reg->str base)))
       (cond
         ((and (pair? offset) (eq? (car offset) '%sib))
          (let* ((idx (reg->str (cadr offset)))
                 (scale (small-int->string (caddr offset)))
                 (disp (cadddr offset))
                 (disp-str (cond ((= disp 0) "")
                                 ((> disp 0) (string-append " + " (small-int->string disp)))
                                 (else (string-append " - " (small-int->string (- 0 disp)))))))
            (string-append "[" base-str " + " idx "*" scale disp-str "]")))
         ((symbol? offset)
          (string-append "[" base-str " + " (reg->str offset) "]"))
         (else
          (string-append "[" base-str " " (offset->string offset) "]")))))))

(define (operand->str opnd)
  (cond
    ((string? opnd)
     opnd)
    ((symbol? opnd)
     (reg->str opnd))
    ((integer? opnd)
     (small-int->string opnd))
    ((pair? opnd)
     (let ((tag (car opnd)))
       (case tag
         ((%reg)
          (reg->str (cadr opnd)))
         ((%stack)
          (get-stack-opnd-str (cadr opnd)))
         ((%disp)
          (mem-op->str (caddr opnd) (cadr opnd)))
         ((%imm)
          (small-int->string (cadr opnd)))
         ((%mem)
          (mem-op->str (cadr opnd) (caddr opnd)))
         (else
          (error "Unknown operand in x86-64 backend:" opnd)))))
    (else
     (error "Invalid operand type in x86-64 backend:" opnd))))

(define (asm-opnd->str opnd)
  (operand->str opnd))

;;; Block Arguments tracking and parallel copy for SSA LIR
(define *x86-block-params* (cons '() '()))
(define *backend-gc-mode* (cons 'all '()))
(define *alloc-counter* (cons 0 '()))
(define *x86-cold-asm-insts* (cons #f '()))
(define *c-tu-globals* (cons '() '()))
(define *c-tu-has-init?* (cons #f '()))
(define *x86-switch-jump-tables* (cons '() '()))
(define *x86-switch-jt-counter* (cons 0 '()))
(define *x86-c-tu-hoist-frame* (cons 0 '()))
(define *x86-c-tu-delta-calls* (cons '() '()))
(define *x86-c-tu-call-ordinal* (cons 0 '()))

(define *inline-asm-frame-size* (cons 0 '()))
(define *c-tu-weak-fns* (cons '() '()))
(define *c-tu-weak-data* (cons '() '()))

;;; -----------------------------------------------------------------------
;;; Stage 1: Instruction Selection (LIR -> L_asm_x86 AST)
;;; -----------------------------------------------------------------------

(define (lower-lir-reg r)
  (case r
    ((%rax) 'rax) ((%rbx) 'rbx) ((%rcx) 'rcx) ((%rdx) 'rdx)
    ((%rsi) 'rsi) ((%rdi) 'rdi) ((%rbp) 'rbp) ((%rsp) 'rsp)
    ((%r8)  'r8)  ((%r9)  'r9)  ((%r10) 'r10) ((%r11) 'r11)
    ((%r12) 'r12) ((%r13) 'r13) ((%r14) 'r14) ((%r15) 'r15)
    ((%al)  'al)
    (else r)))

(define (lower-lir-opnd opnd)
  (cond
    ((symbol? opnd)
     (lower-lir-reg opnd))
    ((integer? opnd)
     (list '%imm opnd))
    ((pair? opnd)
     (let ((tag (car opnd)))
       (case tag
         ((%reg)
          (lower-lir-reg (cadr opnd)))
         ((%stack)
          (list '%disp (x86-hoist-rsp-disp (cadr opnd)) 'rsp))
         ((%disp)
          (if (x86-rsp-sym? (caddr opnd))
              (list '%disp (x86-hoist-rsp-disp (cadr opnd)) (lower-lir-reg (caddr opnd)))
              opnd))
         ((%imm)
          opnd)
         ((%mem)
          (let ((b (lower-lir-reg (cadr opnd))))
            (list '%disp (x86-hoist-mem-offset b (caddr opnd)) b)))
         (else
          opnd))))
    (else opnd)))

(define (lower-lir-reg8 r)
  (let ((sym (if (and (pair? r) (eq? (car r) '%reg)) (cadr r) r)))
    (case sym
      ((%rax rax %al al) 'al)
      ((%rbx rbx %bl bl) 'bl)
      ((%rcx rcx %cl cl) 'cl)
      ((%rdx rdx %dl dl) 'dl)
      ((%rsi rsi %sil sil) 'sil)
      ((%rdi rdi %dil dil) 'dil)
      ((%rbp rbp %bpl bpl) 'bpl)
      ((%rsp rsp %spl spl) 'spl)
      ((%r8  r8  %r8b r8b) 'r8b)
      ((%r9  r9  %r9b r9b) 'r9b)
      ((%r10 r10 %r10b r10b) 'r10b)
      ((%r11 r11 %r11b r11b) 'r11b)
      ((%r12 r12 %r12b r12b) 'r12b)
      ((%r13 r13 %r13b r13b) 'r13b)
      ((%r14 r14 %r14b r14b) 'r14b)
      ((%r15 r15 %r15b r15b) 'r15b)
      (else 'al))))

(define (canonical-x86-set-cc cc)
  (let ((s (if (symbol? cc) (symbol->string cc) (if (string? cc) cc "e"))))
    (cond
      ((or (string=? s "sete") (string=? s "e")) 'e)
      ((or (string=? s "setne") (string=? s "ne")) 'ne)
      ((or (string=? s "setl") (string=? s "l")) 'l)
      ((or (string=? s "setle") (string=? s "le")) 'le)
      ((or (string=? s "setg") (string=? s "g")) 'g)
      ((or (string=? s "setge") (string=? s "ge")) 'ge)
      ((or (string=? s "seta") (string=? s "a")) 'a)
      ((or (string=? s "setae") (string=? s "ae")) 'ae)
      ((or (string=? s "setb") (string=? s "b")) 'b)
      ((or (string=? s "setbe") (string=? s "be")) 'be)
      ((or (string=? s "sets") (string=? s "s")) 's)
      ((or (string=? s "setns") (string=? s "ns")) 'ns)
      ((or (string=? s "setp") (string=? s "p")) 'p)
      ((or (string=? s "setnp") (string=? s "np")) 'np)
      ((or (string=? s "seto") (string=? s "o")) 'o)
      ((or (string=? s "setno") (string=? s "no")) 'no)
      ((or (string=? s "setc") (string=? s "c")) 'c)
      ((or (string=? s "setnc") (string=? s "nc")) 'nc)
      ((or (string=? s "setz") (string=? s "z")) 'z)
      ((or (string=? s "setnz") (string=? s "nz")) 'nz)
      (else (string->symbol s)))))

(define (canonical-x86-cc cond-op)
  (cond
    ((string? cond-op) (string->symbol cond-op))
    ((eq? cond-op 'equal) 'je)
    ((eq? cond-op 'not-equal) 'jne)
    ((eq? cond-op 'less) 'jl)
    ((eq? cond-op 'less-equal) 'jle)
    ((eq? cond-op 'greater) 'jg)
    ((eq? cond-op 'greater-equal) 'jge)
    ((eq? cond-op 'zero) 'je)
    ((eq? cond-op 'not-zero) 'jne)
    ((symbol? cond-op) cond-op)
    (else 'je)))

(define (x86-loop-header-label? lbl)
  (and (not (eq? (car *backend-gc-mode*) 'c-tu))
       (let ((s (asm-label->str lbl)))
         (or (string-starts-with? s ".L_loop_head_")
             (string-starts-with? s "L_loop_head_")
             (string-starts-with? s ".L_loop_body_")
             (string-starts-with? s "L_loop_body_")
             (string-starts-with? s ".L_cont_entry_")
             (string-starts-with? s "L_cont_entry_")
             (string-starts-with? s ".strlen_loop_")
             (string-starts-with? s "strlen_loop_")
             (string-starts-with? s ".vec_init_loop_")
             (string-starts-with? s "vec_init_loop_")
             (string-starts-with? s ".bv_zero_loop_")
             (string-starts-with? s "bv_zero_loop_")))))

(define (lower-lir-instruction inst)
  (let ((op (car inst)))
    (case op
      ((%loc)
       (list (list '%loc (cadr inst) (caddr inst) (cadddr inst))))

      ((%label)
       (let ((lbl (cadr inst)))
         (if (x86-loop-header-label? lbl)
             (list (list '%p2align 4)
                   (list '%label lbl))
             (list (list '%label lbl)))))

      ((%block)
       (let ((lbl (cadr inst))
             (params (caddr inst))
             (body (cdddr inst)))
         (record-x86-block-params! lbl params)
         (let loop ((rest body)
                    (acc (if (x86-loop-header-label? lbl)
                             (list (list '%label lbl) (list '%p2align 4))
                             (list (list '%label lbl)))))
           (if (null? rest)
               (reverse acc)
               (let ((lowered (lower-lir-instruction (car rest))))
                 (loop (cdr rest) (append (reverse lowered) acc)))))))

      ((%jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (append (select-x86-parallel-copy lbl args)
                 (list (list 'jmp (lower-lir-opnd lbl))))))

      ((%jump-if-false)
       (let* ((reg (cadr inst))
              (lbl (caddr inst))
              (args (if (pair? (cdddr inst)) (cadddr inst) '())))
         (if (null? args)
             (list (list 'cmp (lower-lir-opnd reg) (list '%imm 47))
                   (list 'jcc 'je lbl))
             (let ((cont-lbl (unique-label-sym "L_cont_")))
               (backend-concat
                (list (list (list 'cmp (lower-lir-opnd reg) (list '%imm 47))
                            (list 'jcc 'jne cont-lbl))
                      (select-x86-parallel-copy lbl args)
                      (list (list 'jmp (lower-lir-opnd lbl))
                            (list '%label cont-lbl))))))))

      ((%jump-cond)
       (let* ((cond-op (cadr inst))
              (lbl (caddr inst)))
         (list (list 'jcc (canonical-x86-cc cond-op) lbl))))

      ((%jump-if)
       (let* ((reg (cadr inst))
              (then-lbl (caddr inst))
              (then-args (cadddr inst))
              (rest-else (cdr (cdddr inst)))
              (else-lbl (car rest-else))
              (else-args (cadr rest-else))
              (else-tramline (unique-label-sym "L_else_tramline_")))
         (backend-concat
          (list (list (list 'cmp (lower-lir-opnd reg) (list '%imm 47))
                      (list 'jcc 'je else-tramline))
                (if (pair? then-args) (select-x86-parallel-copy then-lbl then-args) '())
                (list (list 'jmp (lower-lir-opnd then-lbl))
                      (list '%label else-tramline))
                (if (pair? else-args) (select-x86-parallel-copy else-lbl else-args) '())
                (list (list 'jmp (lower-lir-opnd else-lbl)))))))

      ((%jump-if-zero)
       (let ((lbl (cadr inst)))
         (list (list 'jcc 'je lbl))))

      ((%direct-jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (append (if (pair? args) (select-x86-parallel-copy lbl args) '())
                 (list (list 'jmp (lower-lir-opnd lbl))))))

      ((%switch)
       ;; (%switch val def-lbl [def-args] cases)
       (let* ((val (cadr inst))
              (def-lbl (caddr inst))
              (has-def-args? (= (length inst) 5))
              (def-args (if (and has-def-args? (list? (cadddr inst))) (cadddr inst) '()))
              (raw-cases (cond (has-def-args? (car (cddddr inst)))
                               ((pair? (cdddr inst)) (cadddr inst))
                               (else '())))
              (trampolines-box (cons '() '()))
              (def-target (x86-switch-target-lbl def-lbl def-args trampolines-box))
              (norm-cases
               (map (lambda (c)
                      (let* ((c-val (car c))
                             (c-lbl (cadr c))
                             (c-args (if (and (pair? (cddr c)) (list? (caddr c))) (caddr c) '())))
                        (cons c-val (x86-switch-target-lbl c-lbl c-args trampolines-box))))
                    raw-cases))
              (n (length norm-cases))
              (all-ints? (let loop ((cs norm-cases))
                           (cond ((null? cs) #t)
                                 ((integer? (caar cs)) (loop (cdr cs)))
                                 (else #f))))
              (val-opnd (lower-lir-opnd val))
              (load-r10 (if (eq? val-opnd 'r10)
                            '()
                            (list (list '%raw-asm (string-append "    mov r10, " (hoist-operand->str val))))))
              (dispatch-insts
               (cond
                 ((= n 0)
                  (list (list 'jmp (lower-lir-opnd def-target))))
                 ((or (< n 8) (not all-ints?))
                  (let loop ((cs norm-cases) (acc '()))
                    (if (null? cs)
                        (backend-concat
                         (list load-r10
                               (backend-concat (reverse acc))
                               (list (list 'jmp (lower-lir-opnd def-target)))))
                        (let ((c-val (caar cs))
                              (c-tgt (cdar cs)))
                          (loop (cdr cs)
                                (cons (append (x86-switch-emit-cmp-r10 c-val)
                                              (list (list 'jcc 'je c-tgt)))
                                      acc))))))
                 (else
                  (let* ((sorted (x86-switch-sort-cases norm-cases))
                         (min-v (caar sorted))
                         (max-v (car (list-ref sorted (- n 1))))
                         (span (+ (- max-v min-v) 1)))
                    (if (and (<= span 4096) (<= span (* 2 n)))
                        ;; Tier 2: Dense PIE-safe .rodata PC-relative jump table O(1)
                        (let* ((id (next-x86-switch-jt-id!))
                               (jt-lbl (string->symbol (string-append ".L_jt_" (number->string id))))
                               (base-lbl (string->symbol (string-append ".L_jt_base_" (number->string id))))
                               (entries (x86-switch-build-jt-entries min-v max-v sorted def-target))
                               (sub-insts
                                (cond
                                  ((= min-v 0) '())
                                  ((and (> min-v 0) (<= min-v 2147483647))
                                   (list (list '%raw-asm (string-append "    sub r10, " (number->string min-v)))))
                                  ((and (< min-v 0) (<= (- 0 min-v) 2147483647))
                                   (list (list '%raw-asm (string-append "    add r10, " (number->string (- 0 min-v))))))
                                  (else
                                   (list (list '%raw-asm (string-append "    mov r11, " (number->string min-v)))
                                         (list '%raw-asm "    sub r10, r11")))))
                               (bounds-limit (- span 1)))
                          (set-car! *x86-switch-jump-tables*
                                    (cons (list jt-lbl base-lbl entries) (car *x86-switch-jump-tables*)))
                          (backend-concat
                           (list load-r10
                                 sub-insts
                                 (list (list '%raw-asm (string-append "    cmp r10, " (number->string bounds-limit)))
                                       (list 'jcc 'ja def-target)
                                       (list '%raw-asm (string-append "    lea r11, [rip + " (asm-label->str jt-lbl) "]"))
                                       (list '%raw-asm "    movsxd r10, dword ptr [r11 + r10*4]")
                                       (list '%raw-asm (string-append "    lea r11, [rip + " (asm-label->str base-lbl) "]"))
                                       (list '%raw-asm "    add r11, r10")
                                       (list '%raw-asm "    jmp r11")
                                       (list '%label base-lbl)))))
                        ;; Tier 3: Sparse large switch -> balanced Binary Search Tree O(log N)
                        (append load-r10
                                (x86-switch-emit-bst (list->vector sorted) 0 (- n 1) def-target)))))))
              (tramp-insts (x86-switch-emit-trampolines (car trampolines-box)))
              (switch-end (unique-label-sym "L_switch_end_")))
         (if (null? tramp-insts)
             dispatch-insts
             (backend-concat
              (list dispatch-insts
                    tramp-insts
                    (list (list '%label switch-end)))))))

      ((%return)
       (let ((f (car *x86-c-tu-hoist-frame*)))
         (if (> f 0)
             (list (list 'add 'rsp (list '%imm f))
                   (list 'ret))
             (list (list 'ret)))))

      ((%push)
       (let ((src (cadr inst)))
         (list (list 'push (lower-lir-opnd src)))))

      ((%pop)
       (let ((dst (cadr inst)))
         (list (list 'pop (lower-lir-opnd dst)))))

      ((%syscall)
       (if (pair? (cdr inst))
           (let ((si (cadr inst)))
             (list
              (list 'mov (lower-lir-opnd '%rax) (list '%disp si (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%rdi) (list '%disp (- si 8) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%rsi) (list '%disp (- si 16) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%rdx) (list '%disp (- si 24) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%r10) (list '%disp (- si 32) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%r8) (list '%disp (- si 40) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%r9) (list '%disp (- si 48) (lower-lir-reg '%rsp)))
              (list 'syscall)))
           (list (list 'syscall))))

      ((%memory-fence)
       (list (list '%raw-asm "    mfence")))

      ((%safepoint-poll)
       (let* ((done-lbl (unique-label "L_sp_done"))
              (raw-fs (car *inline-asm-frame-size*))
              (needed (if (> raw-fs 0) (+ raw-fs 8) 16))
              (rem (modulo needed 16))
              (shift (if (= rem 0) needed (+ needed (- 16 rem)))))
         (list (list '%raw-asm "    cmp byte ptr [rip + ulisp_safepoint_flag], 0")
               (list '%raw-asm (string-append "    je " done-lbl))
               (list '%raw-asm (string-append "    sub rsp, " (number->string shift)))
               (list '%raw-asm "    call ulisp_safepoint_slow_trampoline")
               (list '%raw-asm (string-append "    add rsp, " (number->string shift)))
               (list '%label (string->symbol done-lbl)))))

      ((%atomic-cas!)
       (let ((dst (cadr inst))
             (box (caddr inst))
             (new (cadddr inst)))
         (let ((cas-insts
                (list (list '%raw-asm (string-append "    lock cmpxchg qword ptr [" (reg->str box) " + 11], " (reg->str new)))
                      (list 'set 'e 'al)
                      (list 'movzx 'eax 'al)
                      (list '%raw-asm "    shl rax, 6")
                      (list '%raw-asm "    add rax, 0x2F"))))
           (if (and (not (eq? (car *backend-gc-mode*) 'none))
                    (not (eq? (car *backend-gc-mode*) 'c-tu)))
               (append cas-insts
                       (list (list '%raw-asm "    mov r10, rax")
                             (list '%raw-asm (string-append "    lea rdx, [" (reg->str box) " + 11]"))
                             (list '%raw-asm (string-append "    mov rax, " (reg->str new)))
                             (list '%raw-asm "    sub rsp, 512")
                             (list '%raw-asm "    call ulisp_gc_write_barrier")
                             (list '%raw-asm "    add rsp, 512")
                             (list '%raw-asm "    mov rax, r10")))
               cas-insts))))

      ((%mov)
       (let ((dst (cadr inst))
             (src (caddr inst))
             (f (car *x86-c-tu-hoist-frame*)))
         (if (and (> f 0) (x86-rsp-sym? src))
             (list (list 'lea (lower-lir-opnd dst) (list '%disp f 'rsp)))
             (list (list 'mov (lower-lir-opnd dst) (lower-lir-opnd src))))))

      ((%load)
       (let* ((dst (cadr inst))
              (base (caddr inst))
              (offset (x86-hoist-mem-offset base (cadddr inst))))
         (list (list 'mov (lower-lir-opnd dst) (list '%disp offset (lower-lir-reg base))))))

      ((%store)
       (let* ((base (cadr inst))
              (offset (x86-hoist-mem-offset base (caddr inst)))
              (src (cadddr inst)))
         (let ((store-inst
                (if (integer? src)
                    (list (list '%raw-asm (string-append "    mov qword ptr " (mem-op->str base offset) ", " (number->string src))))
                    (list (list 'mov (list '%disp offset (lower-lir-reg base)) (lower-lir-opnd src))))))
           (if (and (not (integer? src))
                    (not (eq? (car *backend-gc-mode*) 'none))
                    (not (eq? (car *backend-gc-mode*) 'c-tu))
                    (eq? base '%rdx)
                    (or (equal? offset -1) (equal? offset 7) (eq? offset '%rcx)
                        (and (pair? offset) (eq? (car offset) '%sib))))
               (append store-inst
                       (cond
                         ((equal? offset -1)
                          (list (list '%raw-asm "    lea rdx, [rdx - 1]")
                                (list '%raw-asm "    sub rsp, 512")
                                (list '%raw-asm "    call ulisp_gc_write_barrier")
                                (list '%raw-asm "    add rsp, 512")))
                         ((equal? offset 7)
                          (list (list '%raw-asm "    lea rdx, [rdx + 7]")
                                (list '%raw-asm "    sub rsp, 512")
                                (list '%raw-asm "    call ulisp_gc_write_barrier")
                                (list '%raw-asm "    add rsp, 512")))
                         (else
                          (list (list '%raw-asm (string-append "    lea rdx, " (mem-op->str base offset)))
                                (list '%raw-asm "    mov rax, r10")
                                (list '%raw-asm "    sub rsp, 512")
                                (list '%raw-asm "    call ulisp_gc_write_barrier")
                                (list '%raw-asm "    add rsp, 512")))))
               store-inst))))

      ((%store-byte)
       (let* ((base (cadr inst))
              (offset (x86-hoist-mem-offset base (caddr inst)))
              (src (cadddr inst)))
         (let ((src-str (if (number? src) (number->string src) (reg->str src))))
           (list (list '%raw-asm (string-append "    mov byte ptr " (mem-op->str base offset) ", " src-str))))))

      ((%load-byte-zx)
       (let* ((dst (cadr inst))
              (base (caddr inst))
              (offset (x86-hoist-mem-offset base (cadddr inst))))
         (list (list '%raw-asm (string-append "    movzx " (reg->str dst) ", byte ptr " (mem-op->str base offset))))))

      ((%add %raw-add)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (list (list 'add (lower-lir-opnd dst) (lower-lir-opnd src)))))

      ((%sub %raw-sub)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (list (list 'sub (lower-lir-opnd dst) (lower-lir-opnd src)))))

      ((%neg)
       (let ((dst (cadr inst)))
         (list (list 'neg (lower-lir-opnd dst)))))

      ((%not)
       (let ((dst (cadr inst)))
         (list (list 'not (lower-lir-opnd dst)))))

      ((%imul %raw-mul)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (list (list 'imul (lower-lir-opnd dst) (lower-lir-opnd src)))))

      ((%box-fixnum)
       (let ((dst (cadr inst))
