      ((%unbox-fixnum)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (if (equal? dst src)
             (list (list 'sar (lower-lir-opnd dst) 2))
             (list (list 'mov (lower-lir-opnd dst) (lower-lir-opnd src))
                   (list 'sar (lower-lir-opnd dst) 2)))))

      ;; Typed Machine LIR: Memory Access, FP & Conversions (Issue #826)
      ((%load-typed)
       (let* ((mty (cadr inst))
              (dst (caddr inst))
              (base (cadddr inst))
              (offset (x86-hoist-mem-offset base (car (cddddr inst)))))
         (let ((dst-str (reg->str dst))
               (mem-str (mem-op->str base offset)))
           (case mty
             ((i8)  (list (list '%raw-asm (string-append "    movsx " dst-str ", byte ptr " mem-str))))
             ((u8)  (list (list '%raw-asm (string-append "    movzx " dst-str ", byte ptr " mem-str))))
             ((i16) (list (list '%raw-asm (string-append "    movsx " dst-str ", word ptr " mem-str))))
             ((u16) (list (list '%raw-asm (string-append "    movzx " dst-str ", word ptr " mem-str))))
             ((i32) (list (list '%raw-asm (string-append "    movsxd " dst-str ", dword ptr " mem-str))))
             ((u32) (list (list '%raw-asm (string-append "    mov " (reg32->str dst) ", dword ptr " mem-str))))
             ((f32) (list (list '%raw-asm (string-append "    movss " dst-str ", dword ptr " mem-str))))
             ((f64) (list (list '%raw-asm (string-append "    movsd " dst-str ", qword ptr " mem-str))))
             (else  (list (list '%raw-asm (string-append "    mov " dst-str ", qword ptr " mem-str))))))))

      ((%store-typed)
       (let* ((mty (cadr inst))
              (base (caddr inst))
              (offset (x86-hoist-mem-offset base (cadddr inst)))
              (src (car (cddddr inst))))
         (let ((src-str (if (number? src) (number->string src) (reg->str src)))
               (mem-str (mem-op->str base offset)))
           (case mty
             ((i8 u8)   (list (list '%raw-asm (string-append "    mov byte ptr " mem-str ", " (if (number? src) src-str (reg8->str src))))))
             ((i16 u16) (list (list '%raw-asm (string-append "    mov word ptr " mem-str ", " (if (number? src) src-str (reg16->str src))))))
             ((i32 u32) (list (list '%raw-asm (string-append "    mov dword ptr " mem-str ", " (if (number? src) src-str (reg32->str src))))))
             ((f32)     (list (list '%raw-asm (string-append "    movss dword ptr " mem-str ", " src-str))))
             ((f64)     (list (list '%raw-asm (string-append "    movsd qword ptr " mem-str ", " src-str))))
             (else      (list (list '%raw-asm (string-append "    mov qword ptr " mem-str ", " src-str))))))))

      ((%fmov)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (list (list '%raw-asm (string-append "    movsd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fadd)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (list (list '%raw-asm (string-append "    addsd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fsub)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (list (list '%raw-asm (string-append "    subsd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fmul)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (list (list '%raw-asm (string-append "    mulsd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fdiv)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (list (list '%raw-asm (string-append "    divsd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fcmp)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (list (list '%raw-asm (string-append "    ucomisd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fneg)
       (let* ((mty (cadr inst))
              (dst (caddr inst))
              (src (cadddr inst))
              (bit-pos (if (eq? mty 'f32) 31 63))
              (d-str (reg->str dst))
              (s-str (if (pair? src) (hoist-operand->str src) (reg->str src))))
         (list (list '%raw-asm (string-append "    movq r11, " s-str))
               (list '%raw-asm "    mov r10d, 1")
               (list '%raw-asm (string-append "    shl r10, " (number->string bit-pos)))
               (list '%raw-asm "    xor r11, r10")
               (list '%raw-asm (string-append "    movq " d-str ", r11")))))

      ((%fpext)
       (let ((dst (caddr inst)) (src (cadddr inst)))
         (list (list '%raw-asm (string-append "    cvtss2sd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fptrunc)
       (let ((dst (caddr inst)) (src (cadddr inst)))
         (list (list '%raw-asm (string-append "    cvtsd2ss " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%sitofp)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (list (list '%raw-asm (string-append "    cvtsi2sd " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%uitofp)
       (let* ((dst (cadr inst))
              (src (caddr inst))
              (d-str (reg->str dst))
              (s-raw (if (pair? src) #f (reg->str src)))
              (s-str (or s-raw (hoist-operand->str src)))
              (t1 (cond ((not (equal? s-raw "r11")) "r11") (else "r10")))
              (t2 (cond ((and (not (equal? s-raw "r10")) (not (equal? t1 "r10"))) "r10")
                        ((not (equal? s-raw "rcx")) "rcx")
                        (else "r9")))
              (l-hi (unique-label-sym "L_uitofp_hi_"))
              (l-done (unique-label-sym "L_uitofp_dn_"))
              (prep (if s-raw '() (list (list '%raw-asm (string-append "    mov " t1 ", " s-str)))))
              (src-reg (or s-raw t1)))
         (append
          prep
          (list (list '%raw-asm (string-append "    test " src-reg ", " src-reg))
                (list 'jcc 'js l-hi)
                (list '%raw-asm (string-append "    cvtsi2sd " d-str ", " src-reg))
                (list 'jmp l-done)
                (list '%label l-hi)
                (list '%raw-asm (string-append "    mov " t1 ", " src-reg))
                (list '%raw-asm (string-append "    mov " t2 ", " src-reg))
                (list '%raw-asm (string-append "    shr " t1 ", 1"))
                (list '%raw-asm (string-append "    and " t2 ", 1"))
                (list '%raw-asm (string-append "    or " t1 ", " t2))
                (list '%raw-asm (string-append "    cvtsi2sd " d-str ", " t1))
                (list '%raw-asm (string-append "    addsd " d-str ", " d-str))
                (list '%label l-done)))))

      ((%fptosi)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (list (list '%raw-asm (string-append "    cvttsd2si " (reg->str dst) ", " (if (pair? src) (hoist-operand->str src) (reg->str src)))))))

      ((%fptoui)
       (let* ((dst (cadr inst))
              (src (caddr inst))
              (d-str (reg->str dst))
              (s-str (if (pair? src) (hoist-operand->str src) (reg->str src)))
              (t1 (if (equal? d-str "r11") "r10" "r11"))
              (x1 (if (equal? s-str "xmm15") "xmm14" "xmm15"))
              (x2 (cond ((and (not (equal? s-str "xmm13")) (not (equal? x1 "xmm13"))) "xmm13")
                        ((not (equal? s-str "xmm12")) "xmm12")
                        (else "xmm11")))
              (l-big (unique-label-sym "L_fptoui_big_"))
              (l-done (unique-label-sym "L_fptoui_dn_")))
         (list (list '%raw-asm (string-append "    mov " t1 ", 1138753536"))
               (list '%raw-asm (string-append "    shl " t1 ", 32"))
               (list '%raw-asm (string-append "    movq " x1 ", " t1))
               (list '%raw-asm (string-append "    ucomisd " s-str ", " x1))
               (list 'jcc 'jae l-big)
               (list '%raw-asm (string-append "    cvttsd2si " d-str ", " s-str))
               (list 'jmp l-done)
               (list '%label l-big)
               (list '%raw-asm (string-append "    movsd " x2 ", " s-str))
               (list '%raw-asm (string-append "    subsd " x2 ", " x1))
               (list '%raw-asm (string-append "    cvttsd2si " d-str ", " x2))
               (list '%raw-asm (string-append "    mov " t1 ", 1"))
               (list '%raw-asm (string-append "    shl " t1 ", 63"))
               (list '%raw-asm (string-append "    xor " d-str ", " t1))
               (list '%label l-done))))

      ((%fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge)
       (let* ((dst (cadr inst))
              (lhs (caddr inst))
              (rhs (cadddr inst))
              (d-str (reg->str dst))
              (d8-str (reg8->str dst))
              (l-str (reg->str lhs))
              (r-mem? (pair? rhs))
              (r-str (if r-mem? (hoist-operand->str rhs) (reg->str rhs)))
              (t1 (if (equal? d-str "r11") "r10" "r11"))
              (t1-8 (if (equal? t1 "r10") "r10b" "r11b"))
              (tx (if (equal? l-str "xmm15") "xmm14" "xmm15")))
