                      (list '%raw-asm (string-append "    ucomisd " tx ", " l-str))
                      (list '%raw-asm (string-append "    seta " d8-str))
                      (list '%raw-asm (string-append "    movzx " d-str ", " d8-str)))
                (list (list '%raw-asm (string-append "    ucomisd " r-str ", " l-str))
                      (list '%raw-asm (string-append "    seta " d8-str))
                      (list '%raw-asm (string-append "    movzx " d-str ", " d8-str)))))
           ((%fcmp-ole)
            (if r-mem?
                (list (list '%raw-asm (string-append "    movsd " tx ", " r-str))
                      (list '%raw-asm (string-append "    ucomisd " tx ", " l-str))
                      (list '%raw-asm (string-append "    setae " d8-str))
                      (list '%raw-asm (string-append "    movzx " d-str ", " d8-str)))
                (list (list '%raw-asm (string-append "    ucomisd " r-str ", " l-str))
                      (list '%raw-asm (string-append "    setae " d8-str))
                      (list '%raw-asm (string-append "    movzx " d-str ", " d8-str)))))
           ((%fcmp-oeq)
            (list (list '%raw-asm (string-append "    ucomisd " l-str ", " r-str))
                  (list '%raw-asm (string-append "    sete " d8-str))
                  (list '%raw-asm (string-append "    setnp " t1-8))
                  (list '%raw-asm (string-append "    movzx " d-str ", " d8-str))
                  (list '%raw-asm (string-append "    movzx " t1 ", " t1-8))
                  (list '%raw-asm (string-append "    and " d-str ", " t1))))
