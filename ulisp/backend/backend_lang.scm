;;; =======================================================================
;;; ULisp Compiler: Backend Architecture Intermediate Languages
;;; Conforms to DSN-33 Architecture Specification & Issue #596
;;; =======================================================================
;;; Formal intermediate language definition for Target Machine Assembly (L_asm_x86)
;;; using Nanopass DSL (define-language). Serves as the declarative contract
;;; between instruction selection (LIR -> L_asm) and code emission (L_asm -> text).
;;; =======================================================================

(define-language L_asm_x86
  (entry Program)
  (terminals
    (symbol (lbl var op cc align))
    (integer (n disp imm scale bitmap frame_size bytes))
    (string (str)))
  (Register (reg)
    rax rbx rcx rdx rsi rdi rbp rsp
    r8  r9  r10 r11 r12 r13 r14 r15 al
    (%reg var))
  (Memory (mem)
    (%disp disp reg)
    (%index reg reg scale disp)
    (%mem reg disp))
  (Operand (opnd)
    reg
    mem
    (%imm imm)
    imm
    lbl)
  (Inst (inst)
    (%label lbl)
    (%p2align align)
    (%align align)
    (%raw-asm str)
    (mov opnd1 opnd2)
    (movzx opnd1 opnd2)
    (lea opnd1 opnd2)
    (add opnd1 opnd2)
    (sub opnd1 opnd2)
    (imul opnd1 opnd2)
    (and opnd1 opnd2)
    (or opnd1 opnd2)
    (xor opnd1 opnd2)
    (shl opnd1 opnd2)
    (shr opnd1 opnd2)
    (sar opnd1 opnd2)
    (neg opnd)
    (not opnd)
    (cmp opnd1 opnd2)
    (test opnd1 opnd2)
    (set cc opnd)
    (jmp lbl)
    (jcc cc lbl)
    (call opnd)
    (ret)
    (push opnd)
    (pop opnd)
    (cqo)
    (idiv opnd)
    (inc opnd)
    (syscall)
    (cld)
    (rep-movsb))
  (StringEntry (se)
    (lbl str))
  (SafepointEntry (sm)
    (lbl frame_size bitmap))
  (FunctionDecl (f)
    (%asm-function lbl (frame-size n) (body inst ...)))
  (MainDecl (m)
    (%asm-main (frame-size n) (body inst ...)))
  (Program (p)
    (%asm-program (strings (se ...)) (stackmaps (sm ...)) (%asm-functions f ...) m)))

;;; -----------------------------------------------------------------------
;;; L_asm_aarch64: Target Machine Assembly for AArch64 (ARM64)
;;; -----------------------------------------------------------------------
(define-language L_asm_aarch64
  (entry Program)
  (terminals
    (symbol (lbl var op cc align))
    (integer (n disp imm shift bitmap frame_size bytes))
    (string (str)))
  (Register (reg)
    x0  x1  x2  x3  x4  x5  x6  x7  x8  x9  x10 x11 x12 x13 x14 x15
    x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 x29 x30 sp xzr
    w0  w1  w2  w3  w4  w5  w6  w7  w8  w9  w10 w11 w12 w13 w14 w15
    w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 wzr
    (%reg var))
  (Memory (mem)
    (%mem reg disp)
    (%mem reg reg)
    (%stack disp))
  (Operand (opnd)
    reg
    mem
    (%imm imm)
    imm
    lbl)
  (Inst (inst)
    (%label lbl)
    (%p2align align)
    (%align align)
    (%raw-asm str)
    (mov opnd1 opnd2)
    (movz opnd1 opnd2)
    (movk opnd1 opnd2)
    (adr opnd1 lbl)
    (add opnd1 opnd2 opnd3)
    (sub opnd1 opnd2 opnd3)
    (mul opnd1 opnd2 opnd3)
    (sdiv opnd1 opnd2 opnd3)
    (msub opnd1 opnd2 opnd3 opnd4)
    (and opnd1 opnd2 opnd3)
    (orr opnd1 opnd2 opnd3)
    (eor opnd1 opnd2 opnd3)
    (lsl opnd1 opnd2 opnd3)
    (lsr opnd1 opnd2 opnd3)
    (asr opnd1 opnd2 opnd3)
    (neg opnd1 opnd2)
    (cmp opnd1 opnd2)
    (cset opnd cc)
    (b lbl)
    (b.cc cc lbl)
    (cbz opnd lbl)
    (cbnz opnd lbl)
    (bl lbl)
    (blr opnd)
    (ret)
    (stp opnd1 opnd2 mem)
    (ldp opnd1 opnd2 mem)
    (str opnd mem)
    (ldr opnd mem)
    (strb opnd mem)
    (ldrb opnd mem)
    (svc imm)
    (dmb op))
  (StringEntry (se)
    (lbl str))
  (SafepointEntry (sm)
    (lbl frame_size bitmap))
  (FunctionDecl (f)
    (%asm-function lbl (frame-size n) (body inst ...)))
  (MainDecl (m)
    (%asm-main (frame-size n) (body inst ...)))
  (Program (p)
    (%asm-program (strings (se ...)) (stackmaps (sm ...)) (%asm-functions f ...) m)))
