         (if (number? al-val)
             (emit (string-append "    reg_rax = " (number->string al-val) ";")))
         (emit (string-append "    reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit (string-append "    ((void (*)(void))(uintptr_t)" (c-reg->str target-reg) ")();"))
         (emit (string-append "    reg_rsp += " (number->string (+ frame-shift 8)) ";"))))

      ((%call-closure)
       (let ((frame-shift (cadr inst)))
         (emit "    reg_r11 = *(uint64_t *)((char *)(uintptr_t)reg_r10 - 1);")
         (emit (string-append "    reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit "    ((void (*)(void))(uintptr_t)reg_r11)();")
         (emit (string-append "    reg_rsp += " (number->string (+ frame-shift 8)) ";"))))

      ((%direct-call)
       (let ((label (cadr inst))
             (frame-shift (caddr inst)))
         (if (and (car *c-backend-c-tu*) (eq? label '__ulisp_setjmp))
             (begin
               (emit "    {")
               (emit "        uint64_t _env = reg_rdi;")
               (emit "        uint64_t *_jb = (uint64_t *)(uintptr_t)_env;")
               (emit "        uint32_t _idx;")
               (emit "        if (_jb[0] == ULISP_C99_JMP_MAGIC && _jb[1] < 1024U &&")
               (emit "            ulisp_c99_jmp_pool[_jb[1]].magic == ULISP_C99_JMP_MAGIC &&")
               (emit "            ulisp_c99_jmp_pool[_jb[1]].env_addr == _env) {")
               (emit "            _idx = (uint32_t)_jb[1];")
               (emit "        } else {")
               (emit "            _idx = (ulisp_c99_jmp_next++) & 1023U;")
               (emit "        }")
               (emit "        UlispC99JmpSlot * volatile _slot = &ulisp_c99_jmp_pool[_idx];")
               (emit "        _slot->magic = ULISP_C99_JMP_MAGIC;")
               (emit "        _slot->env_addr = _env;")
               (emit "        _slot->saved_rsp = reg_rsp;")
               (emit "        _slot->saved_rbx = reg_rbx;")
               (emit "        _slot->saved_r12 = reg_r12;")
               (emit "        _slot->saved_r13 = reg_r13;")
               (emit "        _slot->saved_r14 = reg_r14;")
               (emit "        _slot->saved_r15 = reg_r15;")
               (emit "        _jb[0] = ULISP_C99_JMP_MAGIC;")
               (emit "        _jb[1] = (uint64_t)_idx;")
               (emit "        _jb[6] = (uint64_t)(uintptr_t)reg_rsp;")
               (emit "        int _sj = setjmp(_slot->host_jb);")
               (emit "        if (_sj != 0) {")
               (emit "            reg_rsp = _slot->saved_rsp;")
               (emit "            reg_rbx = _slot->saved_rbx;")
               (emit "            reg_r12 = _slot->saved_r12;")
               (emit "            reg_r13 = _slot->saved_r13;")
               (emit "            reg_r14 = _slot->saved_r14;")
               (emit "            reg_r15 = _slot->saved_r15;")
               (emit "            reg_rax = (uint64_t)(int64_t)_sj;")
               (emit "        } else {")
               (emit "            reg_rax = 0;")
               (emit "        }")
               (emit "    }"))
             (let ((fn-name (c-backend-fn-label label)))
               (emit "    reg_r10 = 0;")
               (emit (string-append "    reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
               (emit (string-append "    " fn-name "();"))
               (emit (string-append "    reg_rsp += " (number->string (+ frame-shift 8)) ";"))))))

      ((%global-ref)
       (let ((reg (cadr inst))
             (var (caddr inst)))
         (let ((g-lbl (mangle-gvar-label var)))
           (emit (string-append "    " (c-reg->str reg) " = " g-lbl ";")))))

      ((%global-addr)
       (let* ((reg (cadr inst))
              (var (caddr inst))
              (expr-str (cond
                          ((memq var (car *c-backend-data-syms*)) (c-data-label var))
                          ((memq var (car *c-backend-fn-syms*)) (c-backend-fn-label var))
                          (else (c-sanitize-label var)))))
         (emit (string-append "    " (c-reg->str reg) " = (uint64_t)(uintptr_t)" expr-str ";"))))

      ((%global-set!)
       (let ((var (cadr inst))
             (reg (caddr inst)))
         (let ((g-lbl (mangle-gvar-label var)))
           (emit (string-append "    " g-lbl " = " (c-reg->str reg) ";")))))

      ((%push-handler)
       (let ((catch-lbl (cadr inst))
             (frame-si (caddr inst))
             (handler-si (cadddr inst)))
         (let ((lbl-str (c-sanitize-label catch-lbl)))
           (emit (string-append "    *(void **)(reg_rsp + (" (number->string frame-si) ")) = ulisp_handler_chain;"))
           (emit (string-append "    *(char **)(reg_rsp + (" (number->string (+ frame-si 8)) ")) = reg_rsp;"))
            (emit (string-append "    *(void **)(reg_rsp + (" (number->string (+ frame-si 24)) ")) = &&" lbl-str ";"))
           (emit (string-append "    *(uint64_t *)(reg_rsp + (" (number->string (+ frame-si 32)) ")) = *(uint64_t *)(reg_rsp + (" (number->string handler-si) "));"))
           (emit (string-append "    ulisp_handler_chain = (void *)(reg_rsp + (" (number->string frame-si) "));")))))

      ((%pop-handler)
       (let ((frame-si (cadr inst)))
         (emit (string-append "    ulisp_handler_chain = *(void **)(reg_rsp + (" (number->string frame-si) "));"))))

      ((%raise)
        (emit "    if (!ulisp_handler_chain) { ulisp_unhandled_exception(reg_rax); }")
        (emit "    reg_rdi = reg_rax;")
        (emit "    reg_rsp = *(char **)((char *)ulisp_handler_chain + 8);")
        (emit "    {")
        (emit "        void *catch_target = *(void **)((char *)ulisp_handler_chain + 24);")
        (emit "        reg_rax = *(uint64_t *)((char *)ulisp_handler_chain + 32);")
        (emit "        ulisp_handler_chain = *(void **)ulisp_handler_chain;")
        (emit "        reg_r10 = reg_rax;")
        (emit "        goto *catch_target;")
        (emit "    }"))
      ((%set-values-count)
       (let ((cnt (cadr inst)))
         (emit (string-append "    ulisp_values_count = " (number->string cnt) ";"))))

      ((%store-values-buf)
       (let ((base-si (cadr inst))
             (count (caddr inst)))
         (let loop ((i 0))
           (if (< i count)
               (let ((offset (+ base-si (* -8 i))))
                 (emit (string-append "    ulisp_values_buf[" (number->string i) "] = *(uint64_t *)(reg_rsp + (" (number->string offset) "));"))
                 (loop (+ i 1)))))))

      ((%dispatch-consumer)
       (let ((consumer-si (cadr inst))
             (aligned-si (caddr inst))
             (frame-shift (cadddr inst)))
         (emit (string-append "    reg_r10 = *(uint64_t *)(reg_rsp + (" (number->string consumer-si) "));"))
         (emit "    reg_r11 = *(uint64_t *)((char *)(uintptr_t)reg_r10 - 1);")
         (emit "    switch (ulisp_values_count) {")
         (emit "        case 0:")
         (emit "            reg_rax = 0;")
         (emit (string-append "            reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit "            ((void (*)(void))(uintptr_t)reg_r11)();")
         (emit (string-append "            reg_rsp += " (number->string (+ frame-shift 8)) ";"))
         (emit "            break;")
         (emit "        case 1:")
         (emit (string-append "            *(uint64_t *)(reg_rsp + (" (number->string aligned-si) ")) = reg_rax;"))
         (emit "            reg_rdi = reg_rax;")
         (emit "            reg_rax = 4;")
         (emit (string-append "            reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit "            ((void (*)(void))(uintptr_t)reg_r11)();")
         (emit (string-append "            reg_rsp += " (number->string (+ frame-shift 8)) ";"))
         (emit "            break;")
         (emit "        case 2:")
         (emit (string-append "            *(uint64_t *)(reg_rsp + (" (number->string aligned-si) ")) = ulisp_values_buf[0];"))
         (emit (string-append "            *(uint64_t *)(reg_rsp + (" (number->string (- aligned-si 8)) ")) = ulisp_values_buf[1];"))
         (emit "            reg_rdi = ulisp_values_buf[0];")
         (emit "            reg_rsi = ulisp_values_buf[1];")
         (emit "            reg_rax = 8;")
         (emit (string-append "            reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit "            ((void (*)(void))(uintptr_t)reg_r11)();")
         (emit (string-append "            reg_rsp += " (number->string (+ frame-shift 8)) ";"))
         (emit "            break;")
         (emit "        case 3:")
         (emit (string-append "            *(uint64_t *)(reg_rsp + (" (number->string aligned-si) ")) = ulisp_values_buf[0];"))
         (emit (string-append "            *(uint64_t *)(reg_rsp + (" (number->string (- aligned-si 8)) ")) = ulisp_values_buf[1];"))
         (emit (string-append "            *(uint64_t *)(reg_rsp + (" (number->string (- aligned-si 16)) ")) = ulisp_values_buf[2];"))
         (emit "            reg_rdi = ulisp_values_buf[0];")
         (emit "            reg_rsi = ulisp_values_buf[1];")
         (emit "            reg_rdx = ulisp_values_buf[2];")
         (emit "            reg_rax = 12;")
         (emit (string-append "            reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit "            ((void (*)(void))(uintptr_t)reg_r11)();")
         (emit (string-append "            reg_rsp += " (number->string (+ frame-shift 8)) ";"))
         (emit "            break;")
         (emit "        default:")
         (emit "            for (int vi = 0; vi < (int)ulisp_values_count; vi++) {")
         (emit (string-append "                *(uint64_t *)(reg_rsp + (" (number->string aligned-si) " - vi*8)) = ulisp_values_buf[vi];"))
         (emit "            }")
         (emit "            if (ulisp_values_count > 0) reg_rdi = ulisp_values_buf[0];")
         (emit "            if (ulisp_values_count > 1) reg_rsi = ulisp_values_buf[1];")
         (emit "            if (ulisp_values_count > 2) reg_rdx = ulisp_values_buf[2];")
         (emit "            if (ulisp_values_count > 3) reg_rcx = ulisp_values_buf[3];")
         (emit "            if (ulisp_values_count > 4) reg_r8  = ulisp_values_buf[4];")
         (emit "            if (ulisp_values_count > 5) reg_r9  = ulisp_values_buf[5];")
         (emit "            reg_rax = ulisp_values_count * 4;")
         (emit (string-append "            reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit "            ((void (*)(void))(uintptr_t)reg_r11)();")
         (emit (string-append "            reg_rsp += " (number->string (+ frame-shift 8)) ";"))
         (emit "            break;")
         (emit "    }")
         (emit "    ulisp_values_count = 1;")))

      ((%capture-cc)
       (let* ((ret-lbl (cadr inst))
              (k-si (caddr inst))
              (lbl-str (c-sanitize-label ret-lbl)))
         (emit "    {")
         (emit "        uint64_t size = (uint64_t)((stack_mem + sizeof(stack_mem)) - (reg_rsp - 256));")
         (emit "        uint64_t alloc_size = (size + 111) & ~15ULL;")
         (let ((pos-k-si (if (< k-si 0) (- 0 k-si) k-si)))
           (emit (string-append "        char *obj = (char *)(uintptr_t)ulisp_alloc(alloc_size, 0, " (number->string pos-k-si) ");")))
         (emit "        *(uint64_t *)obj = (uint64_t)(uintptr_t)ulisp_continuation_invoke;")
         (emit "        *(uint64_t *)(obj + 8) = size;")
         (emit "        *(uint64_t *)(obj + 16) = (uint64_t)(uintptr_t)reg_rsp;")
         (emit "        *(void **)(obj + 80) = ulisp_handler_chain;")
         (emit "        memcpy(obj + 96, reg_rsp - 256, size);")
         (emit (string-append "        if (setjmp(*(jmp_buf *)(obj + 24)) != 0) goto " lbl-str ";"))
         (emit "        reg_rax = (uint64_t)(uintptr_t)obj | 1;")
         (emit (string-append "        *(uint64_t *)(reg_rsp + (" (number->string k-si) ")) = reg_rax;"))
         (emit "    }")))

      (else
       (error "Unknown LIR opcode in C backend:" inst)))))

;;; Emits C code for a single %lir-function
(define (emit-c-function fn)
  (let* ((label (cadr fn))
         (label-str (c-backend-fn-label label))
         (body (cdr (assq 'body (cddr fn)))))
    (cond
      ((and (car *c-backend-c-tu*) (eq? label '__ulisp_setjmp))
       (emit (string-append "static void " label-str "(void) ULISP_UNUSED;"))
       (emit (string-append "static void " label-str "(void) {"))
       (emit "    fprintf(stderr, \"Fatal Error: indirect call to setjmp is undefined (ISO C99 7.13.1.1)\\n\");")
       (emit "    abort();")
       (emit "}")
       (emit ""))
      ((and (car *c-backend-c-tu*) (eq? label '__ulisp_longjmp))
       (emit (string-append "static void " label-str "(void) ULISP_UNUSED;"))
       (emit (string-append "static void " label-str "(void) {"))
       (emit "    uint64_t _env = reg_rdi;")
       (emit "    uint64_t *_jb = (uint64_t *)(uintptr_t)_env;")
       (emit "    if (!_env || _jb[0] != ULISP_C99_JMP_MAGIC || _jb[1] >= 1024U ||")
       (emit "        ulisp_c99_jmp_pool[_jb[1]].magic != ULISP_C99_JMP_MAGIC ||")
       (emit "        ulisp_c99_jmp_pool[_jb[1]].env_addr != _env) {")
       (emit "        fprintf(stderr, \"Fatal Error: invalid or uninitialized jmp_buf in longjmp\\n\");")
       (emit "        abort();")
       (emit "    }")
       (emit "    int _val = (int)(int32_t)reg_rsi;")
       (emit "    if (_val == 0) _val = 1;")
       (emit "    longjmp(ulisp_c99_jmp_pool[_jb[1]].host_jb, _val);")
       (emit "}")
       (emit ""))
      (else
       (scan-c-blocks! body)
       (emit (string-append "static void " label-str "(void) ULISP_UNUSED;"))
       (emit (string-append "static void " label-str "(void) {"))
       (if (not (car *c-backend-c-tu*))
           (emit "    *(uint64_t *)(reg_rsp - 8) = reg_r10;"))
       (for-each emit-c-instruction body)
       (emit "}")
       (emit "")))))

(define (c99-flatten-data-chunks lbl chunks relocs-box)
  (let loop ((cs chunks) (pos 0) (rev-bytes '()))
    (if (null? cs)
        (reverse rev-bytes)
        (let ((c (car cs)))
          (cond
            ((integer? c)
             (loop (cdr cs) (+ pos 1) (cons (modulo c 256) rev-bytes)))
            ((and (pair? c) (eq? (car c) 'zero))
             (let ((cnt (cadr c)))
               (let zloop ((k 0) (acc rev-bytes))
                 (if (< k cnt)
                     (zloop (+ k 1) (cons 0 acc))
                     (loop (cdr cs) (+ pos cnt) acc)))))
            ((and (pair? c) (eq? (car c) 'reloc))
             (set-car! relocs-box (cons (list lbl pos (cadr c) (caddr c)) (car relocs-box)))
             (let zloop ((k 0) (acc rev-bytes))
               (if (< k 8)
                   (zloop (+ k 1) (cons 0 acc))
                   (loop (cdr cs) (+ pos 8) acc))))
            (else
             (loop (cdr cs) pos rev-bytes)))))))

(define (c99-emit-c-byte-array! c-name align byte-list)
  (let* ((total (length byte-list))
         (arr-len (if (> total 0) total 1))
         (all-zero? (let loop ((bs byte-list))
                      (cond ((null? bs) #t)
                            ((= (car bs) 0) (loop (cdr bs)))
                            (else #f)))))
    (if all-zero?
        (emit (string-append "static uint8_t " c-name "[" (number->string arr-len) "] ULISP_UNUSED __attribute__((aligned(" (number->string align) "))) = {0};"))
        (begin
          (emit (string-append "static uint8_t " c-name "[" (number->string arr-len) "] ULISP_UNUSED __attribute__((aligned(" (number->string align) "))) = {"))
          (let loop ((bs byte-list) (col 0) (line-parts '()))
            (cond
              ((null? bs)
               (if (pair? line-parts)
                   (emit (string-append "    " (apply string-append (reverse line-parts))))))
              ((= col 16)
               (emit (string-append "    " (apply string-append (reverse line-parts))))
               (loop bs 0 '()))
              (else
               (let ((item (string-append (number->string (car bs)) (if (pair? (cdr bs)) "," ""))))
                 (loop (cdr bs) (+ col 1) (cons (if (> col 0) (string-append " " item) item) line-parts))))))
          (emit "};")))))

;;; Pass 7b Entrypoint: Takes %lir-program and emits complete ANSI C99 source
(define (emit-c prog gc-mode)
  (set-car! *c-backend-c-tu* (eq? gc-mode 'c-tu))
  (let* ((data-clause (assq 'data (cdr prog)))
         (data-entries (if (and data-clause (pair? (cdr data-clause))) (cadr data-clause) '()))
         (funcs-clause (assq '%lir-functions (cdr prog)))
         (funcs (if funcs-clause (cdr funcs-clause) '()))
         (main-clause (assq '%lir-main (cdr prog)))
         (main-body (cdr (assq 'body (cdr main-clause)))))
    (set-car! *c-backend-data-syms* (map cadr data-entries))
    (set-car! *c-backend-fn-syms* (map cadr funcs))
    (let* ((pstr-clause (assq 'strings (cdr prog)))
           (pstrs (if (and pstr-clause (pair? (cdr pstr-clause))) (cadr pstr-clause) '())))
      (set-car! *c-backend-ext-code-refs*
                (c99-collect-ext-code-refs prog (car *c-backend-fn-syms*) (car *c-backend-data-syms*) pstrs)))
