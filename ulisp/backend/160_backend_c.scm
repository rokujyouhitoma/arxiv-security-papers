         (emit (string-append "            *(uint64_t *)(reg_rsp + (" (number->string (- aligned-si 8)) ")) = ulisp_values_buf[1];"))
         (emit (string-append "            reg_rsp -= " (number->string (+ frame-shift 8)) ";"))
         (emit "            ((void (*)(void))(uintptr_t)reg_rdx)();")
         (emit (string-append "            reg_rsp += " (number->string (+ frame-shift 8)) ";"))
         (emit "            break;")
         (emit "        case 3:")
