;;; =======================================================================
;;; ULisp Compiler Pass 7b: Portable C / WebAssembly Backend Code Generator
;;; Conforms to DSN-33 Architecture Specification & Issue #504
;;; Consumes Pass 6 %lir-program and emits ANSI C99 source code.
;;; =======================================================================

(define *c-backend-c-tu* (cons #f '()))
(define *c-backend-data-syms* (cons '() '()))
(define *c-backend-fn-syms* (cons '() '()))
(define *c-backend-ext-code-refs* (cons '() '()))

(define (c-data-label lbl)
  (string-append "ulisp_data_" (c-sanitize-label lbl)))

(define (c99-collect-global-addr-vars prog)
  (let ((seen-box (cons '() '())))
    (let ((add-var! (lambda (v)
                      (if (and (symbol? v) (not (memq v (car seen-box))))
                          (set-car! seen-box (cons v (car seen-box)))))))
      (let ((scan-insts (lambda (insts)
                          (for-each (lambda (inst)
                                      (if (and (pair? inst) (eq? (car inst) '%global-addr))
                                          (add-var! (caddr inst))))
                                    insts)))
            (funcs-clause (assq '%lir-functions (cdr prog)))
            (main-clause (assq '%lir-main (cdr prog))))
        (if funcs-clause
            (for-each (lambda (fn)
                        (let ((b (assq 'body (cddr fn))))
                          (if b (scan-insts (cdr b)))))
                      (cdr funcs-clause)))
        (if main-clause
            (let ((b (assq 'body (cdr main-clause))))
              (if b (scan-insts (cdr b)))))
        (reverse (car seen-box))))))

(define (%c99-escape-c-string-bytes s)
  (let ((n (string-length s)))
    (let loop ((i 0) (parts '()))
      (if (>= i n)
          (apply string-append (reverse parts))
          (let* ((ch (string-ref s i))
                 (code (modulo (char->integer ch) 256))
                 (seg (cond
                        ((= code 10) "\\n")
                        ((= code 9)  "\\t")
                        ((= code 13) "\\r")
                        ((= code 92) "\\\\")
                        ((= code 34) "\\\"")
                        ((or (< code 32) (>= code 127))
                         (let* ((d2 (quotient code 64))
                                (r2 (modulo code 64))
                                (d1 (quotient r2 8))
                                (d0 (modulo r2 8)))
                           (string #\\
                                   (integer->char (+ 48 d2))
                                   (integer->char (+ 48 d1))
                                   (integer->char (+ 48 d0)))))
                        (else (string ch)))))
            (loop (+ i 1) (cons seg parts)))))))

(define (c-backend-fn-label lbl)
  (let ((s (c-sanitize-label lbl)))
    (if (car *c-backend-c-tu*)
        (string-append "ulisp_c99_fn_" s)
        s)))

(define (c99-backend-known-libm-fn? name)
  (let loop ((xs '("acos" "asin" "atan" "atan2" "cos" "sin" "tan"
                   "cosh" "sinh" "tanh" "exp" "frexp" "ldexp"
                   "log" "log10" "log2" "modf" "pow" "sqrt"
                   "ceil" "fabs" "floor" "fmod" "trunc" "round" "hypot" "copysign"
                   "acosf" "asinf" "atanf" "atan2f" "cosf" "sinf" "tanf"
                   "coshf" "sinhf" "tanhf" "expf" "frexpf" "ldexpf"
                   "logf" "log10f" "log2f" "modff" "powf" "sqrtf"
                   "ceilf" "fabsf" "floorf" "fmodf" "truncf" "roundf" "hypotf" "copysignf")))
    (cond
      ((null? xs) #f)
      ((string=? (car xs) name) #t)
      (else (loop (cdr xs))))))

(define (c99-backend-known-libc-fn? name)
  (or (c99-backend-known-libm-fn? name)
      (let loop ((xs '("puts" "putchar" "printf" "fprintf" "sprintf" "snprintf"
                       "vprintf" "vfprintf" "vsprintf" "vsnprintf"
                       "exit" "abort" "malloc" "calloc" "realloc" "free"
                       "strlen" "strcmp" "strncmp" "memcpy" "memmove" "memset"
                       "memcmp" "strchr" "strstr" "atoi" "atol" "abs"
                       "ulisp_read_char" "ulisp_peek_char" "ulisp_write_char" "ulisp_write_string")))
        (cond
          ((null? xs) #f)
          ((string=? (car xs) name) #t)
          (else (loop (cdr xs)))))))

(define (c99-collect-c-calls prog)
  (let ((seen-box (cons '() '())))
    (let ((add-fn! (lambda (fn)
                     (let ((fname (if (symbol? fn) (symbol->raw-name fn) fn)))
                       (if (and (string? fname)
                                (> (string-length fname) 0)
                                (not (c99-backend-known-libc-fn? fname))
                                (not (member fname (car seen-box))))
                           (set-car! seen-box (cons fname (car seen-box))))))))
      (let ((scan-insts (lambda (insts)
                          (for-each (lambda (inst)
                                      (if (and (pair? inst)
                                               (memq (car inst) '(%c-call %call-foreign)))
                                          (add-fn! (cadr inst))))
                                    insts)))
            (funcs-clause (assq '%lir-functions (cdr prog)))
            (main-clause (assq '%lir-main (cdr prog))))
        (if funcs-clause
            (for-each (lambda (fn)
                        (let ((b (assq 'body (cddr fn))))
                          (if b (scan-insts (cdr b)))))
                      (cdr funcs-clause)))
        (if main-clause
            (let ((b (assq 'body (cdr main-clause))))
              (if b (scan-insts (cdr b)))))
        (reverse (car seen-box))))))

(define (c99-collect-ext-code-refs prog fn-syms data-syms str-syms)
  (let ((seen-box (cons '() '())))
    (let ((add-sym! (lambda (s)
                      (if (and (symbol? s)
                               (not (memq s fn-syms))
                               (not (memq s data-syms))
                               (not (assq s str-syms))
                               (not (memq s (car seen-box))))
                          (set-car! seen-box (cons s (car seen-box)))))))
      (let ((scan-insts (lambda (insts)
                          (let loop ((xs insts))
                            (if (pair? xs)
                                (let ((inst (car xs)))
                                  (if (pair? inst)
                                      (cond
                                        ((eq? (car inst) '%block)
                                         (loop (cdddr inst)))
                                        ((eq? (car inst) '%code-ref)
                                         (add-sym! (caddr inst)))))
                                  (loop (cdr xs)))))))
            (funcs-clause (assq '%lir-functions (cdr prog)))
            (main-clause (assq '%lir-main (cdr prog)))
            (data-clause (assq 'data (cdr prog))))
        (if funcs-clause
            (for-each (lambda (fn)
                        (let ((b (assq 'body (cddr fn))))
                          (if b (scan-insts (cdr b)))))
                      (cdr funcs-clause)))
        (if main-clause
            (let ((b (assq 'body (cdr main-clause))))
              (if b (scan-insts (cdr b)))))
        (if (and data-clause (pair? (cdr data-clause)))
            (for-each (lambda (de)
                        (if (eq? (car de) 'bytes)
                            (for-each (lambda (c)
                                        (if (and (pair? c) (eq? (car c) 'reloc))
                                            (let ((t (cadr c)))
                                              (if (and (symbol? t)
                                                       (c99-backend-known-libc-fn? (c-sanitize-label t)))
                                                  (add-sym! t)))))
                                      (cdddr de))))
                      (cadr data-clause)))
        (reverse (car seen-box))))))

(define (c99-emit-ext-c-call-stmt! fname)
  (cond
    ((string=? fname "puts")
     (emit "    reg_rax = (uint64_t)(int64_t)puts((const char *)(uintptr_t)reg_rdi);"))
    ((string=? fname "putchar")
     (emit "    reg_rax = (uint64_t)(int64_t)putchar((int)reg_rdi);"))
    ((string=? fname "printf")
     (emit "#if defined(__x86_64__) || defined(_M_X64)")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(const char *, ...))printf)((const char *)(uintptr_t)reg_rdi, (uintptr_t)reg_rsi, (uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9, reg_xmm0, reg_xmm1, reg_xmm2, reg_xmm3, reg_xmm4, reg_xmm5, reg_xmm6, reg_xmm7);")
     (emit "#else")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(const char *, ...))printf)((const char *)(uintptr_t)reg_rdi, (uintptr_t)reg_rsi, (uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9);")
     (emit "#endif"))
    ((string=? fname "fprintf")
     (emit "#if defined(__x86_64__) || defined(_M_X64)")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(FILE *, const char *, ...))fprintf)((FILE *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi, (uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9, reg_xmm0, reg_xmm1, reg_xmm2, reg_xmm3, reg_xmm4, reg_xmm5, reg_xmm6, reg_xmm7);")
     (emit "#else")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(FILE *, const char *, ...))fprintf)((FILE *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi, (uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9);")
     (emit "#endif"))
    ((string=? fname "sprintf")
     (emit "#if defined(__x86_64__) || defined(_M_X64)")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(char *, const char *, ...))sprintf)((char *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi, (uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9, reg_xmm0, reg_xmm1, reg_xmm2, reg_xmm3, reg_xmm4, reg_xmm5, reg_xmm6, reg_xmm7);")
     (emit "#else")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(char *, const char *, ...))sprintf)((char *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi, (uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9);")
     (emit "#endif"))
    ((string=? fname "snprintf")
     (emit "#if defined(__x86_64__) || defined(_M_X64)")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(char *, size_t, const char *, ...))snprintf)((char *)(uintptr_t)reg_rdi, (size_t)reg_rsi, (const char *)(uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9, reg_xmm0, reg_xmm1, reg_xmm2, reg_xmm3, reg_xmm4, reg_xmm5, reg_xmm6, reg_xmm7);")
     (emit "#else")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(char *, size_t, const char *, ...))snprintf)((char *)(uintptr_t)reg_rdi, (size_t)reg_rsi, (const char *)(uintptr_t)reg_rdx, (uintptr_t)reg_rcx, (uintptr_t)reg_r8, (uintptr_t)reg_r9);")
     (emit "#endif"))
    ((string=? fname "vprintf")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(const char *, va_list))vprintf)((const char *)(uintptr_t)reg_rdi, (void *)(uintptr_t)reg_rsi);"))
    ((string=? fname "vfprintf")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(FILE *, const char *, va_list))vfprintf)((FILE *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi, (void *)(uintptr_t)reg_rdx);"))
    ((string=? fname "vsprintf")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(char *, const char *, va_list))vsprintf)((char *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi, (void *)(uintptr_t)reg_rdx);"))
    ((string=? fname "vsnprintf")
     (emit "    reg_rax = (uint64_t)(int64_t)((int (*)(char *, size_t, const char *, va_list))vsnprintf)((char *)(uintptr_t)reg_rdi, (size_t)reg_rsi, (const char *)(uintptr_t)reg_rdx, (void *)(uintptr_t)reg_rcx);"))
    ((string=? fname "exit")
     (emit "    exit((int)reg_rdi);"))
    ((string=? fname "malloc")
     (emit "    reg_rax = (uint64_t)(uintptr_t)malloc((size_t)reg_rdi);"))
    ((string=? fname "calloc")
     (emit "    reg_rax = (uint64_t)(uintptr_t)calloc((size_t)reg_rdi, (size_t)reg_rsi);"))
    ((string=? fname "realloc")
     (emit "    reg_rax = (uint64_t)(uintptr_t)realloc((void *)(uintptr_t)reg_rdi, (size_t)reg_rsi);"))
    ((string=? fname "free")
     (emit "    free((void *)(uintptr_t)reg_rdi); reg_rax = 0;"))
    ((string=? fname "memcpy")
     (emit "    reg_rax = (uint64_t)(uintptr_t)memcpy((void *)(uintptr_t)reg_rdi, (const void *)(uintptr_t)reg_rsi, (size_t)reg_rdx);"))
    ((string=? fname "memmove")
     (emit "    reg_rax = (uint64_t)(uintptr_t)memmove((void *)(uintptr_t)reg_rdi, (const void *)(uintptr_t)reg_rsi, (size_t)reg_rdx);"))
    ((string=? fname "memset")
     (emit "    reg_rax = (uint64_t)(uintptr_t)memset((void *)(uintptr_t)reg_rdi, (int)reg_rsi, (size_t)reg_rdx);"))
    ((string=? fname "memcmp")
     (emit "    reg_rax = (uint64_t)(int64_t)memcmp((const void *)(uintptr_t)reg_rdi, (const void *)(uintptr_t)reg_rsi, (size_t)reg_rdx);"))
    ((string=? fname "strlen")
     (emit "    reg_rax = (uint64_t)strlen((const char *)(uintptr_t)reg_rdi);"))
    ((string=? fname "strcmp")
     (emit "    reg_rax = (uint64_t)(int64_t)strcmp((const char *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi);"))
    ((string=? fname "strncmp")
     (emit "    reg_rax = (uint64_t)(int64_t)strncmp((const char *)(uintptr_t)reg_rdi, (const char *)(uintptr_t)reg_rsi, (size_t)reg_rdx);"))
    ((string=? fname "abort")
     (emit "    abort();"))
    ((member fname '("acos" "asin" "atan" "cos" "sin" "tan"
                     "cosh" "sinh" "tanh" "exp"
                     "log" "log10" "log2" "sqrt"
                     "ceil" "fabs" "floor" "trunc" "round"))
     (emit (string-append "    reg_xmm0 = " fname "(reg_xmm0);")))
    ((member fname '("atan2" "pow" "fmod" "hypot" "copysign"))
     (emit (string-append "    reg_xmm0 = " fname "(reg_xmm0, reg_xmm1);")))
    ((string=? fname "ldexp")
     (emit "    reg_xmm0 = ldexp(reg_xmm0, (int)reg_rdi);"))
    ((string=? fname "frexp")
     (emit "    { int _exp = 0; reg_xmm0 = frexp(reg_xmm0, &_exp); memcpy((void *)(uintptr_t)reg_rdi, &_exp, 4); }"))
    ((string=? fname "modf")
     (emit "    { double _ip = 0.0; reg_xmm0 = modf(reg_xmm0, &_ip); memcpy((void *)(uintptr_t)reg_rdi, &_ip, 8); }"))
    ((member fname '("acosf" "asinf" "atanf" "cosf" "sinf" "tanf"
                     "coshf" "sinhf" "tanhf" "expf"
                     "logf" "log10f" "log2f" "sqrtf"
                     "ceilf" "fabsf" "floorf" "truncf" "roundf"))
     (emit (string-append "    reg_xmm0 = (double)" fname "((float)reg_xmm0);")))
    ((member fname '("atan2f" "powf" "fmodf" "hypotf" "copysignf"))
     (emit (string-append "    reg_xmm0 = (double)" fname "((float)reg_xmm0, (float)reg_xmm1);")))
    ((string=? fname "ldexpf")
     (emit "    reg_xmm0 = (double)ldexpf((float)reg_xmm0, (int)reg_rdi);"))
    ((string=? fname "frexpf")
     (emit "    { int _exp = 0; reg_xmm0 = (double)frexpf((float)reg_xmm0, &_exp); memcpy((void *)(uintptr_t)reg_rdi, &_exp, 4); }"))
    ((string=? fname "modff")
     (emit "    { float _ip = 0.0f; reg_xmm0 = (double)modff((float)reg_xmm0, &_ip); memcpy((void *)(uintptr_t)reg_rdi, &_ip, 4); }"))
    (else
     (emit (string-append "    reg_rax = ((uint64_t (*)(uint64_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t))" fname ")(reg_rdi, reg_rsi, reg_rdx, reg_rcx, reg_r8, reg_r9);")))))

(define (c-target-directive? form)
  (and (pair? form)
       (eq? (car form) '!target)
       (pair? (cdr form))
       (eq? (cadr form) 'c)))

(define (c-sanitize-label lbl)
  (let* ((str (if (symbol? lbl)
                  (let ((s (symbol->raw-name lbl)))
                    (if (or (string=? s "?") (string=? s ""))
                        (symbol->string lbl)
                        s))
                  (if (string? lbl) lbl (number->string lbl))))
         (clean (sanitize-label-str str))
         (len (string-length clean)))
    (if (and (> len 0) (char=? (string-ref clean 0) #\.))
        (let ((res (make-string (+ len 5))))
          (string-set! res 0 #\u)
          (string-set! res 1 #\l)
          (string-set! res 2 #\i)
          (string-set! res 3 #\s)
          (string-set! res 4 #\p)
          (string-set! res 5 #\_)
          (let loop ((i 1))
            (if (< i len)
                (let ((c (string-ref clean i)))
                  (string-set! res (+ i 5) (if (char=? c #\.) #\_ c))
                  (loop (+ i 1)))
                res)))
        clean)))

(define (c-reg->str reg)
  (case reg
    ((%rax) "reg_rax")
    ((%rbx) "reg_rbx")
    ((%rcx) "reg_rcx")
    ((%rdx) "reg_rdx")
    ((%rsi) "reg_rsi")
    ((%rdi) "reg_rdi")
    ((%r8)  "reg_r8")
    ((%r9)  "reg_r9")
    ((%r10) "reg_r10")
    ((%r11) "reg_r11")
    ((%r12) "reg_r12")
    ((%r13) "reg_r13")
    ((%r14) "reg_r14")
    ((%r15) "reg_r15")
    ((%rsp) "reg_rsp")
    ((%al)  "((uint8_t)reg_rax)")
    ((%xmm0) "reg_xmm0")
    ((%xmm1) "reg_xmm1")
    ((%xmm2) "reg_xmm2")
    ((%xmm3) "reg_xmm3")
    ((%xmm4) "reg_xmm4")
    ((%xmm5) "reg_xmm5")
    ((%xmm6) "reg_xmm6")
    ((%xmm7) "reg_xmm7")
    ((%xmm8) "reg_xmm8")
    ((%xmm9) "reg_xmm9")
    ((%xmm10) "reg_xmm10")
    ((%xmm11) "reg_xmm11")
    ((%xmm12) "reg_xmm12")
    ((%xmm13) "reg_xmm13")
    ((%xmm14) "reg_xmm14")
    ((%xmm15) "reg_xmm15")
    (else
     (cond
       ((and (pair? reg) (eq? (car reg) '%reg))
        (if (and (pair? (cdr reg)) (pair? (cddr reg)))
            (c-reg->str (caddr reg))
            (c-reg->str (cadr reg))))
       ((and (pair? reg) (eq? (car reg) '%freg))
        (c-reg->str (cadr reg)))
       (else (c-sanitize-label reg))))))

(define (c-base-ptr-str base)
  (case base
    ((%rsp) "reg_rsp")
    ((%r12) "reg_r12")
    (else (string-append "((char *)(uintptr_t)" (c-reg->str base) ")"))))

(define (c-offset->str offset)
  (cond
    ((and (pair? offset) (eq? (car offset) '%sib))
     (let* ((idx (c-reg->str (cadr offset)))
            (scale (number->string (caddr offset)))
            (disp (cadddr offset)))
       (string-append "(" idx " * " scale " + (" (number->string disp) "))")))
    ((number? offset) (number->string offset))
    (else (c-reg->str offset))))

(define (c-mem-ref base offset)
  (let ((base-str (c-base-ptr-str base))
        (off-str (c-offset->str offset)))
    (string-append "(*(uint64_t *)(" base-str " + (" off-str ")))")))

(define (c-mem-byte-ref base offset)
  (let ((base-str (c-base-ptr-str base))
        (off-str (c-offset->str offset)))
    (string-append "(*(uint8_t *)(" base-str " + (" off-str ")))")))

(define (c-operand->str opnd)
  (cond
    ((symbol? opnd)
     (c-reg->str opnd))
    ((integer? opnd)
     (let ((s (number->string opnd)))
       (if (string=? s "-9223372036854775808")
           "(-9223372036854775807LL - 1LL)"
           (string-append s "LL"))))
    ((pair? opnd)
     (let ((tag (car opnd)))
       (case tag
         ((%reg)
          (c-reg->str (cadr opnd)))
         ((%stack)
          (c-mem-ref '%rsp (cadr opnd)))
         ((%mem)
          (c-mem-ref (cadr opnd) (caddr opnd)))
         (else
          (error "Unknown operand in C backend:" opnd)))))
    (else
     (error "Invalid operand type in C backend:" opnd))))

;;; Block Arguments tracking and parallel copy for SSA LIR (C Backend)
(define *c-block-params* (cons '() '()))

(define (reset-c-block-params!)
  (set-car! *c-block-params* '()))

(define (record-c-block-params! lbl params)
  (let ((entry (assq lbl (car *c-block-params*))))
    (if entry
        (set-cdr! entry params)
        (set-car! *c-block-params* (cons (cons lbl params) (car *c-block-params*))))))

(define (get-c-block-params lbl)
  (let ((entry (assq lbl (car *c-block-params*))))
    (if entry (cdr entry) '())))

(define (scan-c-blocks! insts)
  (reset-c-block-params!)
  (let loop ((is insts))
    (for-each
     (lambda (inst)
       (if (pair? inst)
           (cond
             ((eq? (car inst) '%block)
              (record-c-block-params! (cadr inst) (caddr inst))
              (if (pair? (cdddr inst))
                  (loop (cdddr inst))))
             ((eq? (car inst) '%label)
              (record-c-block-params! (cadr inst) '())))))
     is)))

(define (c-param-location idx param)
  (cond
    ((memq param '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15))
     param)
    ((and (pair? param) (eq? (car param) '%reg))
     (cadr param))
    ((and (pair? param) (eq? (car param) '%stack)) param)
    (else
     (list '%stack (* -8 (+ idx 2))))))

(define (emit-c-parallel-copy target-lbl args)
  (let ((params (get-c-block-params target-lbl)))
    (let loop ((ps params) (as args) (i 0))
      (if (and (pair? ps) (pair? as))
          (let* ((param (car ps))
                 (arg (car as))
                 (loc (c-param-location i param)))
            (cond
              ((equal? loc arg) #f)
              ((eq? loc '%rax)
               (emit (string-append "    reg_rax = " (c-operand->str arg) ";")))
              (else
               (emit (string-append "    " (c-operand->str loc) " = " (c-operand->str arg) ";"))))
            (loop (cdr ps) (cdr as) (+ i 1)))))))

(define (c-inline-asm-join strs sep)
  (if (null? strs)
      ""
      (let loop ((xs (cdr strs)) (acc (car strs)))
        (if (null? xs)
            acc
            (loop (cdr xs) (string-append acc sep (car xs)))))))

(define (c-inline-asm-escape str)
  (let ((len (string-length str)))
    (let loop ((i 0) (acc ""))
      (if (>= i len)
          acc
          (let ((ch (string-ref str i)))
            (cond
              ((char=? ch #\\) (loop (+ i 1) (string-append acc "\\\\")))
              ((char=? ch #\") (loop (+ i 1) (string-append acc "\\\"")))
              (else (loop (+ i 1) (string-append acc (string ch))))))))))

(define (c-inline-asm-addr-expr opnd)
  (cond
    ((and (pair? opnd) (eq? (car opnd) '%stack))
     (string-append "(uint64_t)(uintptr_t)(reg_rsp + (" (c-offset->str (cadr opnd)) "))"))
    ((and (pair? opnd) (eq? (car opnd) '%mem))
     (string-append "(uint64_t)(uintptr_t)(" (c-base-ptr-str (cadr opnd)) " + (" (c-offset->str (caddr opnd)) "))"))
    (else
     (string-append "(uint64_t)(" (c-operand->str opnd) ")"))))

(define (c-inline-asm-alloc-mem-ptrs out-plans in-plans init-used)
  (let loop-o ((os out-plans) (used init-used) (acc '()))
    (if (not (null? os))
        (let ((op (car os)))
          (if (eq? (list-ref op 4) 'mem)
              (let ((ptr (inline-asm-first-free-gpr used)))
                (if (not ptr)
                    (error "Exhausted GPRs allocating C inline-asm memory pointer:" op)
                    (loop-o (cdr os)
                            (cons ptr used)
                            (cons (list (list-ref op 0) ptr (list-ref op 2)) acc))))
              (loop-o (cdr os) used acc)))
        (let loop-i ((is in-plans) (used used) (acc acc))
          (if (null? is)
              (reverse acc)
              (let ((ip (car is)))
                (if (eq? (list-ref ip 3) 'mem)
                    (let ((ptr (inline-asm-first-free-gpr used)))
                      (if (not ptr)
                          (error "Exhausted GPRs allocating C inline-asm memory pointer:" ip)
                          (loop-i (cdr is)
                                  (cons ptr used)
                                  (cons (list (list-ref ip 0) ptr (list-ref ip 2)) acc))))
                    (loop-i (cdr is) used acc))))))))

(define (emit-c-inline-asm inst)
  (let* ((plan (inline-asm-allocate-plan inst))
         (template (car plan))
         (out-plans (cadr plan))
         (in-plans (caddr plan))
         (clobbers (cadddr plan))
         (volatile? (car (cddddr plan)))
         (used-regs (car (cdr (cddddr plan))))
         (mem-ptrs (c-inline-asm-alloc-mem-ptrs out-plans in-plans used-regs))
         (mem-ptr-map (map (lambda (e) (cons (car e) (cadr e))) mem-ptrs))
         (has-mem-opnd? (not (null? mem-ptrs)))
         (expanded (inline-asm-expand-template template out-plans in-plans 'c mem-ptr-map))
         (lines (inline-asm-split-lines expanded))
         (asm-body (if (null? lines)
                       "nop"
                       (c-inline-asm-join (map c-inline-asm-escape lines) "\\n\\t")))
         (asm-literal (string-append "\".intel_syntax noprefix\\n\\t" asm-body "\\n\\t.att_syntax prefix\\n\\t\""))
         ;; Build per-GPR descriptor list: (list reg written? init-expr-or-#f)
         ;; Collect all distinct carrier GPRs + mem-ptr GPRs
         (all-bound-regs
          (inline-asm-dedup-regs
           (append
            (let loop-o ((os out-plans) (acc '()))
              (if (null? os) (reverse acc)
                  (if (eq? (list-ref (car os) 4) 'reg)
                      (loop-o (cdr os) (cons (list-ref (car os) 5) acc))
                      (loop-o (cdr os) acc))))
            (append
             (let loop-i ((is in-plans) (acc '()))
               (if (null? is) (reverse acc)
                   (let ((k (list-ref (car is) 3))
                         (c (list-ref (car is) 4)))
                     (if (and (or (eq? k 'reg) (eq? k 'tied))
                              (inline-asm-normalize-reg-sym c))
                         (loop-i (cdr is) (cons c acc))
                         (loop-i (cdr is) acc)))))
             (map cadr mem-ptrs)))))
         (reg-specs
          (map
           (lambda (r)
             (let* ((out-match
                     (let loop ((os out-plans))
                       (cond
                         ((null? os) #f)
                         ((and (eq? (list-ref (car os) 4) 'reg)
                               (eq? (list-ref (car os) 5) r))
                          (car os))
                         (else (loop (cdr os))))))
                    (in-match
                     (let loop ((is in-plans))
                       (cond
                         ((null? is) #f)
                         ((and (or (eq? (list-ref (car is) 3) 'reg)
                                   (eq? (list-ref (car is) 3) 'tied))
                               (eq? (list-ref (car is) 4) r))
                          (car is))
                         (else (loop (cdr is))))))
                    (mem-match
                     (let loop ((ms mem-ptrs))
                       (cond
                         ((null? ms) #f)
                         ((eq? (cadr (car ms)) r) (car ms))
                         (else (loop (cdr ms))))))
                    (written? (or (and out-match #t) (memq r clobbers)))
                    (init-expr
                     (cond
                       (in-match (string-append "(uint64_t)(" (c-operand->str (list-ref in-match 2)) ")"))
                       ((and out-match (list-ref out-match 3))
                        (string-append "(uint64_t)(" (c-operand->str (list-ref out-match 2)) ")"))
                       (mem-match (c-inline-asm-addr-expr (caddr mem-match)))
                       (else #f))))
               (list r written? init-expr)))
           all-bound-regs)))
    (emit "    {")
    ;; Stage all initial expressions into C temporaries before pinning physical registers
    (let loop-init ((rs reg-specs) (i 0))
      (if (not (null? rs))
          (let ((init-expr (caddr (car rs))))
            (if init-expr
                (emit (string-append "        uint64_t __asm_init_" (number->string i) " = " init-expr ";")))
            (loop-init (cdr rs) (+ i 1)))))
    ;; Declare pinned physical register variables
    (let loop-decl ((rs reg-specs) (i 0))
      (if (not (null? rs))
          (let* ((r (car (car rs)))
                 (r-str (inline-asm-reg->sized-str r #f))
                 (init-expr (caddr (car rs))))
            (if init-expr
                (emit (string-append "        register uint64_t __asm_reg_" r-str " __asm__(\"" r-str "\") = __asm_init_" (number->string i) ";"))
                (emit (string-append "        register uint64_t __asm_reg_" r-str " __asm__(\"" r-str "\");")))
            (loop-decl (cdr rs) (+ i 1)))))
    ;; Build GCC output, input, and clobber operand lists
    (let* ((c-outputs
            (let loop ((rs reg-specs) (acc '()))
              (if (null? rs)
                  (reverse acc)
                  (let* ((spec (car rs))
                         (r (car spec))
                         (written? (cadr spec))
                         (init-expr (caddr spec))
                         (r-str (inline-asm-reg->sized-str r #f)))
                    (if written?
                        (loop (cdr rs)
                              (cons (string-append (if init-expr "\"+r\"" "\"=r\"") "(__asm_reg_" r-str ")") acc))
                        (loop (cdr rs) acc))))))
           (c-inputs
            (let loop ((rs reg-specs) (acc '()))
              (if (null? rs)
                  (reverse acc)
                  (let* ((spec (car rs))
                         (r (car spec))
                         (written? (cadr spec))
                         (r-str (inline-asm-reg->sized-str r #f)))
                    (if (not written?)
                        (loop (cdr rs)
                              (cons (string-append "\"r\"(__asm_reg_" r-str ")") acc))
                        (loop (cdr rs) acc))))))
           (raw-clobs
            (let loop ((cs clobbers) (has-mem? has-mem-opnd?) (acc '()))
              (if (null? cs)
                  (let ((with-mem (if (and has-mem? (not (member "\"memory\"" acc)))
                                      (cons "\"memory\"" acc)
                                      acc)))
                    (reverse with-mem))
                  (let ((c (car cs)))
                    (cond
                      ((eq? c 'cc)
                       (loop (cdr cs) has-mem?
                             (if (member "\"cc\"" acc) acc (cons "\"cc\"" acc))))
                      ((eq? c 'memory) (loop (cdr cs) #t acc))
                      ((memq c all-bound-regs) (loop (cdr cs) has-mem? acc))
                      (else
                       (let ((rc (string-append "\"" (inline-asm-reg->sized-str c #f) "\"")))
                         (loop (cdr cs) has-mem?
                               (if (member rc acc) acc (cons rc acc)))))))))))
      (emit (cond
              ((not (null? raw-clobs))
               (string-append "        __asm__ "
                              (if volatile? "volatile " "")
                              "(" asm-literal
                              " : " (c-inline-asm-join c-outputs ", ")
                              " : " (c-inline-asm-join c-inputs ", ")
                              " : " (c-inline-asm-join raw-clobs ", ")
                              ");"))
              ((not (null? c-inputs))
               (string-append "        __asm__ "
                              (if volatile? "volatile " "")
                              "(" asm-literal
                              " : " (c-inline-asm-join c-outputs ", ")
                              " : " (c-inline-asm-join c-inputs ", ")
                              ");"))
              ((not (null? c-outputs))
               (string-append "        __asm__ "
                              (if volatile? "volatile " "")
                              "(" asm-literal
                              " : " (c-inline-asm-join c-outputs ", ")
                              ");"))
              (else
               (string-append "        __asm__ "
                              (if volatile? "volatile " "")
                              "(" asm-literal ");")))))
    ;; Write back register outputs to LIR destinations
    (for-each
     (lambda (op)
       (if (eq? (list-ref op 4) 'reg)
           (let* ((dst (list-ref op 2))
                  (r-str (inline-asm-reg->sized-str (list-ref op 5) #f)))
             (emit (string-append "        " (c-operand->str dst) " = (int64_t)__asm_reg_" r-str ";")))))
     out-plans)
    (emit "    }")))

;;; Emits a single LIR instruction to ANSI C statement
(define (emit-c-instruction inst)
  (let ((op (car inst)))
    (case op
      ((%label)
       (let ((lbl (cadr inst)))
         (emit (string-append (c-sanitize-label lbl) ":;"))))

      ((%block)
       (let ((lbl (cadr inst))
             (params (caddr inst))
             (body (cdddr inst)))
         (record-c-block-params! lbl params)
         (emit (string-append (c-sanitize-label lbl) ":;"))
         (for-each emit-c-instruction body)))

      ((%jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (if (pair? args)
             (emit-c-parallel-copy lbl args))
         (cond
           ((or (eq? lbl '%rdx) (eq? lbl '%rax) (eq? lbl '%rcx) (eq? lbl '%r11))
            (emit (string-append "    ((void (*)(void))(uintptr_t)" (c-reg->str lbl) ")(); return;")))
           ((assq lbl (car *c-block-params*))
            (emit (string-append "    goto " (c-sanitize-label lbl) ";")))
           (else
            (emit "    reg_r10 = 0;")
            (emit (string-append "    " (c-sanitize-label lbl) "(); return;"))))))

      ((%jump-if-false)
       (let* ((reg (cadr inst))
              (lbl (caddr inst))
              (args (if (pair? (cdddr inst)) (cadddr inst) '())))
         (if (null? args)
             (emit (string-append "    if (" (c-reg->str reg) " == 0x2F) goto " (c-sanitize-label lbl) ";"))
             (begin
               (emit (string-append "    if (" (c-reg->str reg) " == 0x2F) {"))
               (emit-c-parallel-copy lbl args)
               (emit (string-append "        goto " (c-sanitize-label lbl) ";"))
               (emit "    }")))))

      ((%jump-cond)
       (let* ((raw-cc (cadr inst))
              (cc (if (symbol? raw-cc) (symbol->string raw-cc) raw-cc))
              (lbl (caddr inst))
              (cond-expr
               (cond
                 ((string=? cc "jne") "cmp_s1 != cmp_s2")
                 ((string=? cc "je")  "cmp_s1 == cmp_s2")
                 ((string=? cc "jge") "(int64_t)cmp_s1 >= (int64_t)cmp_s2")
                 ((string=? cc "jg")  "(int64_t)cmp_s1 > (int64_t)cmp_s2")
                 ((string=? cc "jle") "(int64_t)cmp_s1 <= (int64_t)cmp_s2")
                 ((string=? cc "jl")  "(int64_t)cmp_s1 < (int64_t)cmp_s2")
                 ((string=? cc "jb")  "(uint64_t)cmp_s1 < (uint64_t)cmp_s2")
                 ((string=? cc "jbe") "(uint64_t)cmp_s1 <= (uint64_t)cmp_s2")
                 ((string=? cc "ja")  "(uint64_t)cmp_s1 > (uint64_t)cmp_s2")
                 ((string=? cc "jae") "(uint64_t)cmp_s1 >= (uint64_t)cmp_s2")
                 ((or (string=? cc "jp") (string=? cc "jpe")) "cmp_pf != 0")
                 ((or (string=? cc "jnp") (string=? cc "jpo")) "cmp_pf == 0")
                 (else (error "Unknown jump-cond in C backend:" cc)))))
         (emit (string-append "    if (" cond-expr ") goto " (c-sanitize-label lbl) ";"))))

      ((%jump-if)
       (let* ((reg (cadr inst))
              (then-lbl (caddr inst))
              (then-args (cadddr inst))
              (rest-else (cdr (cdddr inst)))
              (else-lbl (car rest-else))
              (else-args (cadr rest-else)))
         (emit (string-append "    if (" (c-reg->str reg) " != 0x2F) {"))
         (if (pair? then-args)
             (emit-c-parallel-copy then-lbl then-args))
         (emit (string-append "        goto " (c-sanitize-label then-lbl) ";"))
         (emit "    } else {")
         (if (pair? else-args)
             (emit-c-parallel-copy else-lbl else-args))
         (emit (string-append "        goto " (c-sanitize-label else-lbl) ";"))
         (emit "    }")))

      ((%jump-if-zero)
       (let ((lbl (cadr inst)))
         (emit (string-append "    if (cmp_s1 == cmp_s2) goto " (c-sanitize-label lbl) ";"))))

      ((%direct-jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (if (pair? args)
             (emit-c-parallel-copy lbl args))
         (if (assq lbl (car *c-block-params*))
             (emit (string-append "    goto " (c-sanitize-label lbl) ";"))
             (begin
               (emit "    reg_r10 = 0;")
               (emit (string-append "    " (c-backend-fn-label lbl) "(); return;"))))))

      ((%switch)
       ;; (%switch val def-lbl [def-args] cases)
       (let* ((val (cadr inst))
              (def-lbl (caddr inst))
              (has-def-args? (= (length inst) 5))
              (def-args (if (and has-def-args? (list? (cadddr inst))) (cadddr inst) '()))
              (cases (cond (has-def-args? (car (cddddr inst)))
                           ((pair? (cdddr inst)) (cadddr inst))
                           (else '()))))
         (emit (string-append "    switch ((int64_t)(" (c-operand->str val) ")) {"))
         (for-each
          (lambda (c)
            (let* ((raw-c-val (car c))
                   (c-val (if (and (integer? raw-c-val) (> raw-c-val 9223372036854775807))
                              (- raw-c-val 18446744073709551616)
                              raw-c-val))
                   (c-lbl (cadr c))
                   (c-args (if (and (pair? (cddr c)) (list? (caddr c))) (caddr c) '())))
              (emit (string-append "    case " (c-operand->str c-val) ": {"))
              (if (pair? c-args) (emit-c-parallel-copy c-lbl c-args))
              (emit (string-append "        goto " (c-sanitize-label c-lbl) ";"))
              (emit "    }")))
          cases)
         (emit "    default: {")
         (if (pair? def-args) (emit-c-parallel-copy def-lbl def-args))
         (emit (string-append "        goto " (c-sanitize-label def-lbl) ";"))
         (emit "    }")
         (emit "    }")))

      ((%return)
       (emit "    return;"))

      ((%push)
       (let ((src (cadr inst)))
         (emit (string-append "    reg_rsp -= 8; *(uint64_t *)reg_rsp = " (c-operand->str src) ";"))))

      ((%pop)
       (let ((dst (cadr inst)))
         (emit (string-append "    " (c-operand->str dst) " = *(uint64_t *)reg_rsp; reg_rsp += 8;"))))

      ((%mov)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (cond
           ((eq? dst '%r12)
            (emit (string-append "    reg_r12 = (char *)(uintptr_t)(" (c-operand->str src) ");")))
           ((eq? dst '%rsp)
            (emit (string-append "    reg_rsp = (char *)(uintptr_t)(" (c-operand->str src) ");")))
           ((eq? src '%r12)
            (emit (string-append "    " (c-operand->str dst) " = (uint64_t)(uintptr_t)reg_r12;")))
           ((eq? src '%rsp)
            (emit (string-append "    " (c-operand->str dst) " = (uint64_t)(uintptr_t)reg_rsp;")))
           (else
            (emit (string-append "    " (c-operand->str dst) " = " (c-operand->str src) ";"))))))

      ((%load)
       (let ((dst (cadr inst))
             (base (caddr inst))
             (offset (cadddr inst)))
         (emit (string-append "    " (c-reg->str dst) " = " (c-mem-ref base offset) ";"))))

      ((%store)
       (let ((base (cadr inst))
             (offset (caddr inst))
             (src (cadddr inst)))
         (emit (string-append "    " (c-mem-ref base offset) " = " (c-operand->str src) ";"))))

      ((%memory-fence)
       (emit "    __sync_synchronize();"))

      ((%syscall)
       (if (pair? (cdr inst))
           (let ((si (cadr inst)))
             (emit (string-append "    reg_rax = syscall(*(int64_t*)(reg_rsp + (" (number->string si) ")), "
                                  "*(int64_t*)(reg_rsp + (" (number->string (- si 8)) ")), "
                                  "*(int64_t*)(reg_rsp + (" (number->string (- si 16)) ")), "
                                  "*(int64_t*)(reg_rsp + (" (number->string (- si 24)) ")), "
                                  "*(int64_t*)(reg_rsp + (" (number->string (- si 32)) ")), "
                                  "*(int64_t*)(reg_rsp + (" (number->string (- si 40)) ")), "
                                  "*(int64_t*)(reg_rsp + (" (number->string (- si 48)) ")));")))
           (emit "    reg_rax = syscall(reg_rax, reg_rdi, reg_rsi, reg_rdx, reg_r10, reg_r8, reg_r9);")))

      ((%atomic-cas!)
       (let ((dst (cadr inst))
             (box (caddr inst))
             (new (cadddr inst)))
         (emit (string-append "    " (c-reg->str dst) " = __sync_bool_compare_and_swap((uint64_t *)((char *)(uintptr_t)" (c-reg->str box) " + 11), " (c-reg->str dst) ", " (c-reg->str new) ") ? 0x6F : 0x2F;"))
         (emit (string-append "    ulisp_gc_write_barrier((uint64_t)((char *)(uintptr_t)" (c-reg->str box) " + 11), " (c-reg->str new) ");"))))

      ((%inline-asm)
       (emit-c-inline-asm inst))

      ((%store-byte)
       (let ((base (cadr inst))
             (offset (caddr inst))
             (src (cadddr inst)))
         (let ((src-str (if (number? src) (number->string src) (c-reg->str src))))
           (emit (string-append "    " (c-mem-byte-ref base offset) " = (uint8_t)(" src-str ");")))))

      ((%load-byte-zx)
       (let ((dst (cadr inst))
             (base (caddr inst))
             (offset (cadddr inst)))
         (emit (string-append "    " (c-reg->str dst) " = (uint64_t)(" (c-mem-byte-ref base offset) ");"))))

      ((%add)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (if (eq? dst '%r12)
             (emit (string-append "    reg_r12 += " (c-operand->str src) ";"))
             (emit (string-append "    " (c-operand->str dst) " += " (c-operand->str src) ";")))))

      ((%raw-add)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    " (c-operand->str dst) " += " (c-operand->str src) ";"))))

      ((%sub)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    " (c-operand->str dst) " -= " (c-operand->str src) ";"))))

      ((%raw-sub)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    " (c-operand->str dst) " -= " (c-operand->str src) ";"))))

      ((%neg)
       (let ((dst (cadr inst)))
         (emit (string-append "    " (c-operand->str dst) " = (uint64_t)(-(int64_t)" (c-operand->str dst) ");"))))

      ((%not)
       (let ((dst (cadr inst)))
         (emit (string-append "    " (c-operand->str dst) " = ~" (c-operand->str dst) ";"))))

      ((%imul)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    " (c-operand->str dst) " = (uint64_t)((int64_t)" (c-operand->str dst) " * (int64_t)" (c-operand->str src) ");"))))

      ((%raw-mul)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    " (c-operand->str dst) " = (uint64_t)((int64_t)" (c-operand->str dst) " * (int64_t)" (c-operand->str src) ");"))))

      ((%box-fixnum)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    " (c-operand->str dst) " = ((uint64_t)" (c-operand->str src) ") << 2;"))))

      ((%unbox-fixnum)
       (let ((dst (cadr inst))
             (src (caddr inst)))
         (emit (string-append "    " (c-operand->str dst) " = (uint64_t)(((int64_t)" (c-operand->str src) ") >> 2);"))))

      ;; Typed Machine LIR: Memory Access, FP & Conversions (Issue #826)
      ((%load-typed)
       (let ((mty (cadr inst))
             (dst (caddr inst))
             (base (cadddr inst))
             (offset (car (cddddr inst))))
         (let ((base-str (c-base-ptr-str base))
               (off-str (c-offset->str offset))
               (dst-str (c-operand->str dst)))
           (case mty
             ((i8)  (emit (string-append "    " dst-str " = (uint64_t)((int64_t)(*(int8_t *)(" base-str " + (" off-str "))));")))
             ((u8)  (emit (string-append "    " dst-str " = (uint64_t)(*(uint8_t *)(" base-str " + (" off-str ")));")))
             ((i16) (emit (string-append "    { int16_t _v = 0; memcpy(&_v, " base-str " + (" off-str "), 2); " dst-str " = (uint64_t)((int64_t)_v); }")))
             ((u16) (emit (string-append "    { uint16_t _v = 0; memcpy(&_v, " base-str " + (" off-str "), 2); " dst-str " = (uint64_t)_v; }")))
             ((i32) (emit (string-append "    { int32_t _v = 0; memcpy(&_v, " base-str " + (" off-str "), 4); " dst-str " = (uint64_t)((int64_t)_v); }")))
