;;; =======================================================================
;;; ULisp Compiler Pass 140e: Freestanding Runtime, GC & Startup Stubs
;;; Extracted from 140_backend_x86_64.scm (Issue #968).
;;; =======================================================================

(define (emit-x86-asm-program asm-prog gc-mode)
  (let* ((funcs-clause (assq '%asm-functions (cdr asm-prog)))
         (funcs (if funcs-clause (cdr funcs-clause) '()))
         (main-clause (assq '%asm-main (cdr asm-prog)))
         (main-body (cdr (assq 'body (cdr main-clause)))))
    (if (eq? gc-mode 'c-tu)
        (emit-c-tu-x86-asm-program asm-prog funcs main-body)
        (begin
          (emit "    .intel_syntax noprefix")
    (if (debug-symbols-enabled?)
        (for-each
          (lambda (entry)
            (let ((path (car entry))
                  (id (cdr entry)))
              (emit (string-append "    .file " (number->string id) " \"" path "\""))))
          (get-source-file-table)))
    (emit "    .text")
    (if (not (module-mode?))
        (begin
          (emit "    .globl _start")
          (emit "    .weak _start")
          (emit "    .type _start, @function")
          (emit "    .p2align 4")
          (emit "_start:")
    (emit "    mov rbp, rsp")
    (emit "    and rsp, -16")
    ;; Initialize TLS for Main Thread (Worker 0)
    (emit "    mov rax, 158")                     ; sys_arch_prctl
    (emit "    mov rdi, 0x1002")                  ; ARCH_SET_FS
    (emit "    lea rsi, [rip + ulisp_worker_tls_table]")
    (emit "    syscall")
    ;; Save argc, argv, envp
    (emit "    mov rcx, [rbp]")                 ; argc
    (emit "    mov r14, rcx")                   ; preserve argc in r14
    (emit "    lea rsi, [rbp + 8]")             ; &argv[0]
    (emit "    lea rdx, [rbp + 16]")            ; past argv NULL -> envp
    (emit "    lea rdx, [rdx + rcx*8]")
    (emit "    lea rax, [rip + ulisp_environ]")
    (emit "    mov [rax], rdx")                 ; ulisp_environ[0] = envp
    (emit "    mov [rax + 8], rcx")             ; ulisp_environ[1] = argc
    (emit "    mov [rax + 16], rsi")            ; ulisp_environ[2] = argv
    (emit "    lea rax, [rip + ulisp_symtab_bounds]")
    (emit "    lea r8, [rip + __start_ulisp_symtab_sec]")
    (emit "    lea r9, [rip + __stop_ulisp_symtab_sec]")
    (emit "    mov [rax], r8")
    (emit "    sub r9, r8")
    (emit "    shr r9, 4")
    (emit "    mov [rax + 8], r9")
    (emit "    lea rax, [rip + ulisp_argc]")
    (emit "    mov [rax], rcx")
    (emit "    lea rax, [rip + ulisp_argv]")
    (emit "    mov [rax], rsi")
    (emit ".L_flags_scan_loop:")
    (emit "    mov rsi, [rdx]")
    (emit "    test rsi, rsi")
    (emit "    jz .L_flags_scan_done")
    (emit "    add rdx, 8")
    ;; Check prefix "ULISP_PRINT_RESULT=" (19 chars: 8 + 8 + 3)
    (emit "    mov rax, [rsi]")
    (emit "    mov r8, [rip + .L_str_env_print_result]")
    (emit "    cmp rax, r8")
    (emit "    jne .L_check_quiet")
    (emit "    mov rax, [rsi + 8]")
    (emit "    mov r8, [rip + .L_str_env_print_result + 8]")
    (emit "    cmp rax, r8")
    (emit "    jne .L_check_quiet")
    (emit "    cmp byte ptr [rsi + 16], 'L'")
    (emit "    jne .L_check_quiet")
    (emit "    cmp byte ptr [rsi + 17], 'T'")
    (emit "    jne .L_check_quiet")
    (emit "    cmp byte ptr [rsi + 18], '='")
    (emit "    jne .L_check_quiet")
    (emit "    cmp byte ptr [rsi + 19], 0")
    (emit "    je .L_check_quiet")
    (emit "    cmp byte ptr [rsi + 19], '0'")
    (emit "    je .L_check_quiet")
    (emit "    lea rax, [rip + ulisp_print_result_mode]")
    (emit "    mov byte ptr [rax], 1")
    (emit ".L_check_quiet:")
    ;; Check prefix "ULISP_QUIET=" (12 chars: 8 bytes + 4 bytes)
    (emit "    mov rax, [rsi]")
    (emit "    mov r8, [rip + .L_str_env_quiet]")
    (emit "    cmp rax, r8")
    (emit "    jne .L_check_bench")
    (emit "    mov eax, [rsi + 8]")
    (emit "    mov r8d, [rip + .L_str_env_quiet + 8]")
    (emit "    cmp eax, r8d")
    (emit "    jne .L_check_bench")
    (emit "    cmp byte ptr [rsi + 12], 0")
    (emit "    je .L_check_bench")
    (emit "    cmp byte ptr [rsi + 12], '0'")
    (emit "    je .L_check_bench")
    (emit "    lea rax, [rip + ulisp_quiet_mode]")
    (emit "    mov byte ptr [rax], 1")
    (emit ".L_check_bench:")
    ;; Check prefix "ULISP_BENCH_PASSES=" (19 chars: 8 + 8 + 3)
    (emit "    mov rax, [rsi]")
    (emit "    mov r8, [rip + .L_str_env_bench]")
    (emit "    cmp rax, r8")
    (emit "    jne .L_check_gc_stats")
    (emit "    mov rax, [rsi + 8]")
    (emit "    mov r8, [rip + .L_str_env_bench + 8]")
    (emit "    cmp rax, r8")
    (emit "    jne .L_check_gc_stats")
    (emit "    cmp byte ptr [rsi + 16], 'E'")
    (emit "    jne .L_check_gc_stats")
    (emit "    cmp byte ptr [rsi + 17], 'S'")
    (emit "    jne .L_check_gc_stats")
    (emit "    cmp byte ptr [rsi + 18], '='")
    (emit "    jne .L_check_gc_stats")
    (emit "    cmp byte ptr [rsi + 19], 0")
    (emit "    je .L_check_gc_stats")
    (emit "    cmp byte ptr [rsi + 19], '0'")
    (emit "    je .L_check_gc_stats")
    (emit "    lea rax, [rip + ulisp_bench_passes_mode]")
    (emit "    mov byte ptr [rax], 1")
    (emit "    jmp .L_flags_scan_loop")
    (emit ".L_check_gc_stats:")
    ;; Check prefix "ULISP_GC_STATS=" (15 chars: 8 + 7)
    (emit "    mov rax, [rsi]")
    (emit "    mov r8, [rip + .L_str_env_gc_stats]")
    (emit "    cmp rax, r8")
    (emit "    jne .L_flags_scan_loop")
    (emit "    mov rax, [rsi + 8]")
    (emit "    mov r8, [rip + .L_str_env_gc_stats + 8]")
    (emit "    mov r9, 0x00ffffffffffffff")
    (emit "    and rax, r9")
    (emit "    and r8, r9")
    (emit "    cmp rax, r8")
    (emit "    jne .L_flags_scan_loop")
    (emit "    cmp byte ptr [rsi + 15], 0")
    (emit "    je .L_flags_scan_loop")
    (emit "    cmp byte ptr [rsi + 15], '0'")
    (emit "    je .L_flags_scan_loop")
    (emit "    lea rax, [rip + ulisp_gc_state]")
    (emit "    mov qword ptr [rax + 160], 1")
    (emit "    sub rsp, 16")
    (emit "    mov rax, 228")                     ; sys_clock_gettime
    (emit "    mov rdi, 1")                       ; CLOCK_MONOTONIC
    (emit "    mov rsi, rsp")
    (emit "    syscall")
    (emit "    lea rax, [rip + ulisp_gc_state]")
    (emit "    mov rcx, [rsp]")
    (emit "    mov [rax + 168], rcx")             ; start_time_sec
    (emit "    mov rcx, [rsp + 8]")
    (emit "    mov [rax + 176], rcx")             ; start_time_nsec
    (emit "    add rsp, 16")
    (emit "    jmp .L_flags_scan_loop")
    (emit ".L_flags_scan_done:")
    (cond
      ((eq? gc-mode 'none)
       (emit "    mov rax, 9")                     ; sys_mmap
       (emit "    xor rdi, rdi")                   ; addr = NULL
       (emit "    mov rsi, 34359738368")           ; 32GB virtual address space (0x800000000)
       (emit "    mov rdx, 3")                     ; PROT_READ|PROT_WRITE
       (emit "    mov r10, 16418")                 ; MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE (0x4022)
       (emit "    mov r8, -1")                     ; fd = -1
       (emit "    xor r9, r9")                     ; offset = 0
       (emit "    syscall")
       (emit "    test rax, rax")
       (emit "    jns .L_mmap_none_ok")
       ;; Fallback to BSS Demand-Paged Initial Heap (16MB) - Issue #905 / DSN-33-07
       (emit "    lea rax, [rip + ulisp_initial_heap]")
       (emit "    mov rdi, rax")                   ; rdi = heap_base
       (emit "    lea rcx, [rax + 16777216]")      ; limit = base + 16MB
       (emit "    lea rdx, [rip + ulisp_heap_limit]")
       (emit "    mov [rdx], rcx")
       (emit "    jmp .L_mmap_none_done")
       (emit ".L_mmap_none_ok:")
       (emit "    mov rdi, rax")                   ; rdi = heap_base
       (emit "    mov rcx, rax")
       (emit "    mov rdx, 34359738368")
       (emit "    add rcx, rdx")
       (emit "    lea rdx, [rip + ulisp_heap_limit]")
       (emit "    mov [rdx], rcx")
       (emit ".L_mmap_none_done:"))
      ((or (eq? gc-mode 'dual-space) (eq? gc-mode 'stress))
       (emit "    mov rax, 9")                     ; sys_mmap
       (emit "    xor rdi, rdi")                   ; addr = NULL
       (emit "    mov rsi, 134217728")             ; 128MB (2 x 64MB)
       (emit "    mov rdx, 3")                     ; PROT_READ|PROT_WRITE
       (emit "    mov r10, 34")                    ; MAP_PRIVATE|MAP_ANONYMOUS
       (emit "    mov r8, -1")                     ; fd = -1
       (emit "    xor r9, r9")                     ; offset = 0
       (emit "    syscall")
       (emit "    test rax, rax")
       (emit "    jns .L_mmap_dual_ok")
       ;; Fallback to BSS Demand-Paged Initial Heap (2 x 8MB = 16MB) - Issue #905
       (emit "    lea rax, [rip + ulisp_initial_heap]")
       (emit "    lea rbx, [rip + ulisp_gc_state]")
       (emit "    mov [rbx + 0], rax")             ; from
       (emit "    mov rdi, rax")                   ; rdi = from
       (emit "    lea rcx, [rax + 8388608]")       ; to (8MB)
       (emit "    mov [rbx + 8], rcx")
       (emit "    mov qword ptr [rbx + 16], 8388608") ; size = 8MB
       (emit "    mov [rbx + 24], rbp")            ; bottom
       (emit "    mov qword ptr [rbx + 32], 0")    ; count = 0
       (emit "    mov [rbx + 40], rcx")            ; free_ptr = to
       (emit "    mov qword ptr [rbx + 88], 0")    ; gen_mode = 0
       (emit "    mov qword ptr [rbx + 112], 4")   ; profile_id = 4 (stress)
       (emit "    mov qword ptr [rbx + 128], 1")   ; stress_mode = 1
       (emit "    lea rax, [rip + __start_ulisp_globals_sec]")
       (emit "    mov [rbx + 192], rax")
       (emit "    lea rax, [rip + __stop_ulisp_globals_sec]")
       (emit "    mov [rbx + 200], rax")
       (emit "    lea rdx, [rip + ulisp_heap_limit]")
       (emit "    mov [rdx], rcx")                 ; limit = from + 8MB
       (emit "    jmp .L_mmap_dual_done")
       (emit ".L_mmap_dual_ok:")
       (emit "    lea rbx, [rip + ulisp_gc_state]")
       (emit "    mov [rbx + 0], rax")             ; from
       (emit "    mov rdi, rax")                   ; rdi = from
       (emit "    lea rcx, [rax + 67108864]")
       (emit "    mov [rbx + 8], rcx")             ; to
       (emit "    mov qword ptr [rbx + 16], 67108864") ; size = 64MB
       (emit "    mov [rbx + 24], rbp")            ; bottom
       (emit "    mov qword ptr [rbx + 32], 0")    ; count = 0
       (emit "    mov [rbx + 40], rcx")            ; free_ptr = to
       (emit "    mov qword ptr [rbx + 88], 0")    ; gen_mode = 0 (0: dual-space, 1: generational)
       (emit "    mov qword ptr [rbx + 112], 4")   ; profile_id = 4 (stress)
       (emit "    mov qword ptr [rbx + 128], 1")   ; stress_mode = 1
       (emit "    lea rax, [rip + __start_ulisp_globals_sec]")
       (emit "    mov [rbx + 192], rax")
       (emit "    lea rax, [rip + __stop_ulisp_globals_sec]")
       (emit "    mov [rbx + 200], rax")
       (emit "    lea rdx, [rip + ulisp_heap_limit]")
       (emit "    mov [rdx], rcx")
       (emit ".L_mmap_dual_done:"))
      (else
       ;; Generational Collector initialization (Pass 141)
       (emit "    mov rax, 9")                     ; sys_mmap
       (emit "    xor rdi, rdi")                   ; addr = NULL
       (emit "    mov rsi, 17179869184")           ; 16GB total address space reservation (Issue #779)
       (emit "    mov rdx, 3")                     ; PROT_READ|PROT_WRITE
       (emit "    mov r10, 16418")                 ; MAP_PRIVATE|MAP_ANONYMOUS|MAP_NORESERVE (0x4022)
       (emit "    mov r8, -1")                     ; fd = -1
       (emit "    xor r9, r9")                     ; offset = 0
       (emit "    syscall")
       (emit "    test rax, rax")
       (emit "    js .L_start_exit")
       (emit "    lea rbx, [rip + ulisp_gc_state]")
       (emit "    mov [rbx + 0], rax")             ; save mmap base address before env scan
       ;; Scan env var ULISP_GC_PROFILE (Pass 141 Profile Detection)
       (emit "    mov rcx, [rbp]")                 ; argc
       (emit "    lea rdx, [rbp + 16]")            ; &argv[0]
       (emit "    lea rdx, [rdx + rcx*8]")         ; past argv NULL -> envp
       (emit "    xor r10, r10")                   ; r10 = profile_id (0: standard, 1: compiler, 2: server, 4: stress)
       (emit ".L_env_scan_loop:")
       (emit "    mov rsi, [rdx]")
       (emit "    test rsi, rsi")
       (emit "    jz .L_env_scan_done")
       (emit "    add rdx, 8")
       ;; Check prefix "ULISP_GC_PROFILE=" (17 chars)
       (emit "    mov rax, [rsi]")
       (emit "    mov r8, 0x435f5053494c55")       ; "ULISP_C" (reversed little-endian prefix)
       (emit "    mov r8, [rip + .L_str_env_prefix]")
       (emit "    cmp rax, r8")
       (emit "    jne .L_env_scan_loop")
       (emit "    mov rax, [rsi + 8]")
       (emit "    mov r8, [rip + .L_str_env_prefix + 8]")
       (emit "    cmp rax, r8")
       (emit "    jne .L_env_scan_loop")
       (emit "    mov al, [rsi + 16]")
       (emit "    cmp al, 61")                     ; '='
       (emit "    jne .L_env_scan_loop")
       ;; Match profile value
       (emit "    mov al, [rsi + 17]")
       (emit "    cmp al, 'c'")                    ; compiler
       (emit "    je .L_env_set_compiler")
       (emit "    cmp al, 'C'")
       (emit "    je .L_env_set_compiler")
       (emit "    cmp al, 's'")                    ; server
       (emit "    je .L_env_set_server")
       (emit "    cmp al, 'S'")
       (emit "    je .L_env_set_server")
       (emit "    cmp al, 'd'")                    ; default / standard
       (emit "    je .L_env_set_standard")
       (emit "    cmp al, 'D'")
       (emit "    je .L_env_set_standard")
       (emit "    jmp .L_env_scan_loop")
       (emit ".L_env_set_compiler:")
       (emit "    mov r10, 1")
       (emit "    jmp .L_env_scan_done")
       (emit ".L_env_set_server:")
       (emit "    mov r10, 2")
       (emit "    jmp .L_env_scan_done")
       (emit ".L_env_set_standard:")
       (emit "    mov r10, 0")
       (emit "    jmp .L_env_scan_done")
       (emit ".L_env_scan_done:")
       (cond
         ((eq? gc-mode 'compiler)
          (emit "    test r10, r10")
          (emit "    jnz .L_profile_decided")
          (emit "    mov r10, 1")                  ; compile-time default: compiler
          (emit ".L_profile_decided:"))
         ((eq? gc-mode 'server)
          (emit "    test r10, r10")
          (emit "    jnz .L_profile_decided")
          (emit "    mov r10, 2")                  ; compile-time default: server
          (emit ".L_profile_decided:"))
         (else
          (emit ".L_profile_decided:")))
       (emit "    cmp r10, 4")
       (emit "    je .L_profile_stress")
       (emit "    cmp r10, 1")
       (emit "    je .L_profile_compiler")
       (emit "    cmp r10, 2")
       (emit "    je .L_profile_server")
       ;; Standard Profile (4MB Nursery, 64MB Mature, 1GB Max)
       (emit "    mov r12, 4194304")               ; nursery_size = 4MB
       (emit "    mov r13, 67108864")              ; mature_size = 64MB
       (emit "    mov rsi, 138444800")             ; total_mmap = ~132MB
       (emit "    mov r8, 1073741824")             ; max_mature = 1GB
       (emit "    xor r10, r10")                   ; profile_id = 0
       (emit "    jmp .L_profile_setup")
       ;; Stress Profile (Dual-Space Semi-Space 64MB + 64MB = 128MB)
       (emit ".L_profile_stress:")
       (emit "    mov r12, 67108864")              ; size = 64MB
       (emit "    mov rsi, 134217728")             ; total = 128MB
       (emit "    jmp .L_gc_state_stress_setup")
       ;; Compiler Profile (2GB Nursery, 2GB Mature, 8GB Max; overridable via ULISP_COMPILER_ARENA_MB)
       (emit ".L_profile_compiler:")
       (emit "    mov r12, 2147483648")            ; nursery_size = 2GB (default)
       (emit "    mov r13, 2147483648")            ; mature_size = 2GB (default)
       (emit "    mov rcx, [rbp]")                 ; argc
       (emit "    lea rdx, [rbp + 16]")            ; &argv[0]
       (emit "    lea rdx, [rdx + rcx*8]")         ; past argv NULL -> envp
       (emit ".L_arena_env_loop:")
       (emit "    mov rsi, [rdx]")
       (emit "    test rsi, rsi")
       (emit "    jz .L_arena_env_done")
       (emit "    add rdx, 8")
       (emit "    mov rax, [rsi]")
       (emit "    mov r8, [rip + .L_str_env_arena_mb]")
       (emit "    cmp rax, r8")
       (emit "    jne .L_arena_env_loop")
       (emit "    mov rax, [rsi + 8]")
       (emit "    mov r8, [rip + .L_str_env_arena_mb + 8]")
       (emit "    cmp rax, r8")
       (emit "    jne .L_arena_env_loop")
       (emit "    mov rax, [rsi + 16]")
       (emit "    mov r8, [rip + .L_str_env_arena_mb + 16]")
       (emit "    cmp rax, r8")
       (emit "    jne .L_arena_env_loop")
       (emit "    add rsi, 24")
       (emit "    xor rax, rax")
       (emit "    movzx rcx, byte ptr [rsi]")
       (emit "    sub rcx, 48")
       (emit "    cmp rcx, 9")
       (emit "    ja .L_arena_env_done")
       (emit ".L_arena_parse_loop:")
       (emit "    imul rax, rax, 10")
       (emit "    add rax, rcx")
       (emit "    cmp rax, 4096")
       (emit "    jle .L_arena_no_cap")
       (emit "    mov rax, 4096")
       (emit ".L_arena_no_cap:")
       (emit "    inc rsi")
       (emit "    movzx rcx, byte ptr [rsi]")
       (emit "    sub rcx, 48")
       (emit "    cmp rcx, 9")
       (emit "    jbe .L_arena_parse_loop")
       (emit "    cmp rax, 64")
       (emit "    jge .L_arena_min_ok")
       (emit "    mov rax, 64")
       (emit ".L_arena_min_ok:")
       (emit "    shl rax, 20")
       (emit "    mov r12, rax")
       (emit "    mov r13, rax")
       (emit ".L_arena_env_done:")
       (emit "    mov rsi, 6442516480")            ; total_mmap = ~6.4GB + 64KB remset
       (emit "    mov r8, 8589934592")             ; max_mature = 8GB
       (emit "    mov r10, 1")                     ; profile_id = 1
       (emit "    jmp .L_profile_setup")
       ;; Server Profile (16MB Nursery, 256MB Mature, 4GB Max)
       (emit ".L_profile_server:")
       (emit "    mov r12, 16777216")              ; nursery_size = 16MB
       (emit "    mov r13, 268435456")             ; mature_size = 256MB
       (emit "    mov rsi, 553713664")             ; total_mmap = ~553MB
       (emit "    mov r8, 4294967296")             ; max_mature = 4GB
       (emit "    mov r10, 2")                     ; profile_id = 2
       (emit ".L_profile_setup:")
       (emit "    mov rax, [rbx + 0]")             ; restore mmap base address
       (emit "    mov [rbx + 8], r12")             ; nursery_size
       (emit "    lea rdx, [rax + r12]")
       (emit "    mov [rbx + 16], rdx")            ; mature_base
       (emit "    lea rcx, [rdx + r13]")
       (emit "    mov [rbx + 24], rcx")            ; mature_to
       (emit "    mov [rbx + 32], r13")            ; mature_size
       (emit "    mov [rbx + 40], rdx")            ; mature_free = mature_from
       (emit "    mov [rbx + 48], rbp")            ; stack_bottom
       (emit "    mov qword ptr [rbx + 56], 0")    ; minor_count = 0
       (emit "    mov qword ptr [rbx + 64], 0")    ; major_count = 0
       (emit "    lea r9, [rcx + r13]")
       (emit "    mov [rbx + 72], r9")             ; remset_ptr
       (emit "    mov qword ptr [rbx + 80], 0")    ; remset_count = 0
       (emit "    mov qword ptr [rbx + 88], 1")    ; gen_mode = 1
       (emit "    mov [rbx + 96], r8")             ; max_size
       (emit "    mov qword ptr [rbx + 104], 0")   ; growth_count = 0
       (emit "    mov [rbx + 112], r10")           ; profile_id (0: standard, 1: compiler, 2: server)
       (emit "    mov rdi, rax")                   ; rdi = nursery_base
       (emit "    lea rcx, [rax + r12]")
       (emit "    lea rdx, [rip + ulisp_heap_limit]")
       (emit "    mov [rdx], rcx")                 ; limit = nursery_base + nursery_size
       (emit "    jmp .L_gc_state_setup_done")
       (emit ".L_gc_state_stress_setup:")
       (emit "    mov rax, [rbx + 0]")             ; restore mmap base address
       (emit "    mov rdi, rax")                   ; rdi = from
       (emit "    lea rcx, [rax + 67108864]")
       (emit "    mov [rbx + 8], rcx")             ; to
       (emit "    mov qword ptr [rbx + 16], 67108864") ; size = 64MB
       (emit "    mov [rbx + 24], rbp")            ; bottom
       (emit "    mov qword ptr [rbx + 32], 0")    ; count = 0
       (emit "    mov [rbx + 40], rcx")            ; free_ptr = to
       (emit "    mov qword ptr [rbx + 88], 0")    ; gen_mode = 0
       (emit "    mov qword ptr [rbx + 112], 4")   ; profile_id = 4
       (emit "    mov qword ptr [rbx + 128], 1")   ; stress_mode = 1
       (emit "    lea rdx, [rip + ulisp_heap_limit]")
       (emit "    mov [rdx], rcx")                 ; limit = from + 64MB
       (emit ".L_gc_state_setup_done:")
       (emit "    lea rax, [rip + __start_ulisp_globals_sec]")
       (emit "    mov [rbx + 192], rax")
