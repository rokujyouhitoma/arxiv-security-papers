            (list (list '%raw-asm "    mov r11, [r10 - 1]")
                  (list '%raw-asm "    mov rax, 16")
                  (list '%raw-asm "    call r11"))
            add-shift
            (list (list '%raw-asm (string-append "    jmp " exit-str))
                  (list '%raw-asm (string-append exit-str ":"))))))))

      ((%capture-cc)
       (let* ((ret-lbl (cadr inst))
              (k-si (caddr inst))
              (lbl-str (if (symbol? ret-lbl) (symbol->string ret-lbl) ret-lbl)))
         (list (list '%raw-asm "    lea rcx, [rip + ulisp_stack_base]")
               (list '%raw-asm "    mov rcx, [rcx]")
               (list '%raw-asm "    sub rcx, rsp")
               (list '%raw-asm "    add rcx, 256")
               (list '%raw-asm "    test rcx, rcx")
               (list '%raw-asm "    jle .L_cap_fallback_size")
               (list '%raw-asm "    cmp rcx, 8388608")
               (list '%raw-asm "    jbe .L_cap_size_ok")
               (list '%raw-asm ".L_cap_fallback_size:")
               (list '%raw-asm "    mov rcx, 65536")
               (list '%raw-asm ".L_cap_size_ok:")
               (list '%raw-asm "    mov r8, rcx")
               (list '%raw-asm "    add r8, 111")
               (list '%raw-asm "    and r8, -16")
               (list '%raw-asm "    mov rax, r12")
               (list '%raw-asm "    add r12, r8")
               (list '%raw-asm "    lea r9, [rip + ulisp_continuation_invoke]")
               (list '%raw-asm "    mov [rax], r9")
               (list '%raw-asm "    mov [rax + 8], rcx")
               (list '%raw-asm "    mov [rax + 16], rsp")
               (list '%raw-asm "    mov [rax + 24], rbp")
               (list '%raw-asm "    mov [rax + 32], rbx")
               (list '%raw-asm "    mov [rax + 40], r12")
               (list '%raw-asm "    mov [rax + 48], r13")
               (list '%raw-asm "    mov [rax + 56], r14")
               (list '%raw-asm "    mov [rax + 64], r15")
               (list '%raw-asm (string-append "    lea r9, [rip + " lbl-str "]"))
               (list '%raw-asm "    mov [rax + 72], r9")
                (list '%raw-asm "    mov r8, fs:0")
                (list '%raw-asm "    and r8, 63")
                (list '%raw-asm "    shl r8, 3")
                (list '%raw-asm "    lea r9, [rip + ulisp_handler_chain]")
                (list '%raw-asm "    add r9, r8")
               (list '%raw-asm "    mov r8, [r9]")
               (list '%raw-asm "    mov [rax + 80], r8")
               (list '%raw-asm "    lea rdx, [rax + 1]")
               (list '%raw-asm (string-append "    mov [rsp " (offset->string k-si) "], rdx"))
               (list '%raw-asm "    lea rdi, [rax + 96]")
               (list '%raw-asm "    lea rsi, [rsp - 256]")
               (list '%raw-asm "    cld")
               (list '%raw-asm "    rep movsb")
               (list '%raw-asm "    mov rax, rdx"))))

      ((%inline-asm)
       (lower-lir-inline-asm inst))
      (else
       (error (string-append "Unknown LIR opcode in x86-64 backend: "
                             (if (symbol? (car inst)) (symbol->string (car inst)) "?"))
              inst)))))

(define *inline-asm-frame-size* (cons 0 '()))

(define (inline-asm-raw line)
  (list '%raw-asm (string-append "    " line)))

(define (inline-asm-x86-reg-str reg)
  (inline-asm-reg->sized-str reg #f))

(define (inline-asm-x86-slot-str off)
  (string-append "[rsp"
                 (cond
                   ((= off 0) "")
                   ((> off 0) (string-append " + " (number->string off)))
                   (else (string-append " - " (number->string (- 0 off)))))
                 "]"))

(define (inline-asm-x86-opnd-str opnd)
  (cond
    ((symbol? opnd) (inline-asm-x86-reg-str opnd))
    ((integer? opnd) (number->string opnd))
    ((pair? opnd)
     (case (car opnd)
       ((%reg) (inline-asm-x86-reg-str (cadr opnd)))
       ((%stack) (inline-asm-x86-slot-str (cadr opnd)))
       ((%mem) (inline-asm-format-mem-opnd opnd #f #f -1))
       (else (operand->str opnd))))
    (else (operand->str opnd))))

(define (inline-asm-x86-min-stack-off out-plans in-plans init)
  (let loop-o ((os out-plans) (m init))
    (if (not (null? os))
        (let ((dst (list-ref (car os) 2)))
          (if (and (pair? dst) (eq? (car dst) '%stack) (integer? (cadr dst)) (< (cadr dst) m))
              (loop-o (cdr os) (cadr dst))
              (loop-o (cdr os) m)))
        (let loop-i ((is in-plans) (m m))
          (if (null? is)
              m
              (let ((src (list-ref (car is) 2)))
                (if (and (pair? src) (eq? (car src) '%stack) (integer? (cadr src)) (< (cadr src) m))
                    (loop-i (cdr is) (cadr src))
                    (loop-i (cdr is) m))))))))

(define *c-tu-weak-fns* (cons '() '()))
(define *c-tu-weak-data* (cons '() '()))

(define (inline-asm-x86-xmm-reg? reg)
  (and (symbol? reg)
       (let ((s (symbol->string reg)))
         (or (and (>= (string-length s) 4) (string=? (substring s 0 4) "%xmm"))
             (and (>= (string-length s) 3) (string=? (substring s 0 3) "xmm"))))))

(define (inline-asm-x86-mov-op dst-xmm? src-xmm?)
  (cond
    ((and dst-xmm? src-xmm?) "movsd ")
    ((or dst-xmm? src-xmm?) "movsd ")
    (else "mov ")))

(define (inline-asm-x86-mov-reg-reg-op dst-xmm? src-xmm?)
  (cond
    ((and dst-xmm? src-xmm?) "movsd ")
    ((or dst-xmm? src-xmm?) "movq ")
    (else "mov ")))

(define (inline-asm-x86-move-to-reg-acc dst-reg src tmp-reg tmp-save-off acc)
  (let* ((src-reg (inline-asm-canonical-gpr src))
         (dst-s (inline-asm-x86-reg-str dst-reg))
         (dst-xmm? (inline-asm-x86-xmm-reg? dst-reg))
         (src-xmm? (and src-reg (inline-asm-x86-xmm-reg? src-reg))))
    (cond
      (src-reg
       (cond
         ((eq? src-reg dst-reg) acc)
         ((and tmp-save-off (eq? src-reg tmp-reg))
          (cons (inline-asm-raw (string-append (if dst-xmm? "movsd " "mov ") dst-s ", " (inline-asm-x86-slot-str tmp-save-off))) acc))
         (else
          (cons (inline-asm-raw (string-append (inline-asm-x86-mov-reg-reg-op dst-xmm? src-xmm?) dst-s ", " (inline-asm-x86-reg-str src-reg))) acc))))
      ((integer? src)
       (cons (inline-asm-raw (string-append "mov " dst-s ", " (number->string src))) acc))
      ((and (pair? src) (eq? (car src) '%mem)
            tmp-save-off
            (eq? (inline-asm-canonical-gpr (cadr src)) tmp-reg))
       (cons (inline-asm-raw (string-append (if dst-xmm? "movsd " "mov ") dst-s ", " (inline-asm-x86-opnd-str src)))
             (cons (inline-asm-raw (string-append "mov " (inline-asm-x86-reg-str tmp-reg) ", " (inline-asm-x86-slot-str tmp-save-off)))
                   acc)))
      (else
       (cons (inline-asm-raw (string-append (if dst-xmm? "movsd " "mov ") dst-s ", " (inline-asm-x86-opnd-str src))) acc)))))

(define (inline-asm-x86-store-acc dst src-reg acc)
  (let ((src-xmm? (inline-asm-x86-xmm-reg? src-reg)))
    (cond
      ((inline-asm-canonical-gpr dst)
       (let* ((dg (inline-asm-canonical-gpr dst))
              (dg-xmm? (inline-asm-x86-xmm-reg? dg)))
         (if (eq? dg src-reg)
             acc
             (cons (inline-asm-raw (string-append (inline-asm-x86-mov-reg-reg-op dg-xmm? src-xmm?) (inline-asm-x86-reg-str dg) ", " (inline-asm-x86-reg-str src-reg))) acc))))
      ((and (pair? dst) (eq? (car dst) '%stack))
       (cons (inline-asm-raw (string-append (if src-xmm? "movsd " "mov ") (inline-asm-x86-slot-str (cadr dst)) ", " (inline-asm-x86-reg-str src-reg))) acc))
      ((and (pair? dst) (eq? (car dst) '%mem))
       (cons (inline-asm-raw (string-append (if src-xmm? "movsd " "mov ") (inline-asm-format-mem-opnd dst #f #f -1) ", " (inline-asm-x86-reg-str src-reg))) acc))
      (else
       (cons (inline-asm-raw (string-append (if src-xmm? "movsd " "mov ") (inline-asm-x86-opnd-str dst) ", " (inline-asm-x86-reg-str src-reg))) acc)))))

(define (inline-asm-x86-has-tied-input? out-idx in-plans)
  (let loop ((is in-plans))
    (if (null? is)
        #f
        (let ((ip (car is)))
          (if (and (eq? (list-ref ip 3) 'tied) (eqv? (list-ref ip 5) out-idx))
              #t
              (loop (cdr is)))))))

(define (inline-asm-x86-collect-moves out-plans in-plans)
  (let loop-rw ((ops out-plans) (val-moves '()) (imm-moves '()))
    (if (not (null? ops))
        (let ((op (car ops)))
          (if (and (list-ref op 3)
                   (eq? (list-ref op 4) 'reg)
                   (not (inline-asm-x86-has-tied-input? (car op) in-plans)))
              (let ((c-reg (list-ref op 5))
                    (dst (list-ref op 2)))
                (if (integer? dst)
                    (loop-rw (cdr ops) val-moves (cons (cons c-reg dst) imm-moves))
                    (loop-rw (cdr ops) (cons (cons c-reg dst) val-moves) imm-moves)))
              (loop-rw (cdr ops) val-moves imm-moves)))
        (let loop-in ((ips in-plans) (vms (reverse val-moves)) (ims (reverse imm-moves)))
          (if (null? ips)
              (cons vms ims)
              (let* ((ip (car ips))
                     (src (list-ref ip 2))
                     (kind (list-ref ip 3))
                     (carrier (list-ref ip 4)))
                (cond
                  ((or (eq? kind 'reg)
                       (and (eq? kind 'tied) (inline-asm-normalize-reg-sym carrier)))
                   (if (integer? src)
                       (loop-in (cdr ips) vms (cons (cons carrier src) ims))
                       (loop-in (cdr ips) (cons (cons carrier src) vms) ims)))
                  (else
                   (loop-in (cdr ips) vms ims)))))))))

(define (lower-lir-inline-asm inst)
  (let* ((plan (inline-asm-allocate-plan inst))
         (template (car plan))
         (out-plans (cadr plan))
         (in-plans (caddr plan))
         (used-regs (car (cdr (cddddr plan))))
         (final-dst-regs
          (let loop ((ops out-plans) (acc '()))
            (if (null? ops)
                acc
                (let* ((dst (list-ref (car ops) 2))
                       (dg (inline-asm-canonical-gpr dst)))
                  (if (and dg (not (eq? dg '%rsp)) (not (memq dg acc)))
                      (loop (cdr ops) (cons dg acc))
                      (loop (cdr ops) acc))))))
         (moves (inline-asm-x86-collect-moves out-plans in-plans))
         (val-moves (car moves))
         (imm-moves (cdr moves))
         (multi-stage? (> (length val-moves) 1))
         (protected-stage-regs
          (let loop ((ms val-moves) (acc '()))
            (if (null? ms)
                acc
                (let* ((s (cdr (car ms)))
                       (sr (inline-asm-canonical-gpr s))
                       (acc1 (if (and sr (not (eq? sr '%rsp)) (not (memq sr acc))) (cons sr acc) acc))
                       (acc2 (inline-asm-collect-mem-bases s acc1)))
                  (loop (cdr ms) acc2)))))
         (stage-tmp
          (if multi-stage?
              (or (inline-asm-first-free-gpr (append used-regs (append protected-stage-regs final-dst-regs)))
                  (inline-asm-first-free-gpr protected-stage-regs)
                  '%r11)
              #f))
         (save-regs
          (let* ((cand (if stage-tmp (inline-asm-dedup-regs (cons stage-tmp used-regs)) used-regs)))
            (let filter ((rs cand) (acc '()))
              (if (null? rs)
                  (reverse acc)
                  (if (memq (car rs) final-dst-regs)
                      (filter (cdr rs) acc)
                      (filter (cdr rs) (cons (car rs) acc)))))))
         (min-stack (inline-asm-x86-min-stack-off out-plans in-plans (- 0 (car *inline-asm-frame-size*))))
         (scratch-base (- min-stack 64))
         (num-saves (length save-regs))
         (save-pairs
          (let loop ((rs save-regs) (off scratch-base) (acc '()))
            (if (null? rs)
                (reverse acc)
                (loop (cdr rs) (- off 8) (cons (cons (car rs) off) acc)))))
         (snap-base (- scratch-base (* num-saves 8)))
         (num-snaps (if multi-stage? (length val-moves) 0))
         (out-tmp-base (- snap-base (* (+ num-snaps (if stage-tmp 1 0)) 8)))
         (stage-tmp-save-off
          (if stage-tmp
              (let ((e (assq stage-tmp save-pairs)))
                (if e (cdr e) (- snap-base (* num-snaps 8))))
              #f))
         ;; 1. Save non-output clobbered / carrier / staging registers
         (acc1
          (let loop ((sp save-pairs) (acc '()))
            (if (null? sp)
                acc
                (let* ((p (car sp))
                       (op-mv (if (inline-asm-x86-xmm-reg? (car p)) "movsd " "mov ")))
                  (loop (cdr sp)
                        (cons (inline-asm-raw (string-append op-mv (inline-asm-x86-slot-str (cdr p)) ", " (inline-asm-x86-reg-str (car p)))) acc))))))
         (acc2
          (if (and stage-tmp (not (assq stage-tmp save-pairs)))
              (cons (inline-asm-raw (string-append (if (inline-asm-x86-xmm-reg? stage-tmp) "movsd " "mov ") (inline-asm-x86-slot-str stage-tmp-save-off) ", " (inline-asm-x86-reg-str stage-tmp))) acc1)
              acc1))
         ;; 2. Cycle-free parallel input/rw staging
         (acc3
          (cond
            ((null? val-moves) acc2)
            ((not multi-stage?)
             (inline-asm-x86-move-to-reg-acc (car (car val-moves)) (cdr (car val-moves)) #f #f acc2))
            (else
             (let* ((a-s1
                     (let s1 ((ms val-moves) (off snap-base) (acc acc2))
                       (if (null? ms)
                           acc
                           (let* ((src (cdr (car ms)))
                                  (a1 (inline-asm-x86-move-to-reg-acc stage-tmp src stage-tmp stage-tmp-save-off acc))
                                  (a2 (cons (inline-asm-raw (string-append "mov " (inline-asm-x86-slot-str off) ", " (inline-asm-x86-reg-str stage-tmp))) a1)))
                             (s1 (cdr ms) (- off 8) a2)))))
                    (a-s2
                     (let s2 ((ms val-moves) (off snap-base) (acc a-s1))
                       (if (null? ms)
                           acc
                           (let ((dreg (car (car ms))))
                             (s2 (cdr ms) (- off 8)
                                 (cons (inline-asm-raw (string-append "mov " (inline-asm-x86-reg-str dreg) ", " (inline-asm-x86-slot-str off))) acc)))))))
               a-s2))))
         (acc4
          (let loop ((ims imm-moves) (acc acc3))
            (if (null? ims)
                acc
                (let ((im (car ims)))
                  (loop (cdr ims)
                        (cons (inline-asm-raw (string-append "mov " (inline-asm-x86-reg-str (car im)) ", " (number->string (cdr im)))) acc))))))
         ;; 3. Emit expanded inline-asm lines
         (acc5
          (let* ((expanded (inline-asm-expand-template template out-plans in-plans 'x86 #f))
                 (lines (inline-asm-split-lines expanded)))
            (let loop ((ls lines) (acc acc4))
              (if (null? ls)
                  acc
                  (loop (cdr ls) (cons (inline-asm-raw (car ls)) acc))))))
         ;; 4. Write back outputs & restore saved registers safely
         (epilogue
          (let loop ((ops out-plans) (off out-tmp-base) (acc acc5) (def-acc '()))
            (if (not (null? ops))
                (let* ((op (car ops))
                       (kind (list-ref op 4))
                       (dst (list-ref op 2))
                       (carrier (list-ref op 5)))
                  (if (not (eq? kind 'reg))
                      (loop (cdr ops) off acc def-acc)
                      (let ((dg (inline-asm-canonical-gpr dst)))
                        (cond
                          ((and dg (eq? dg carrier))
                           (loop (cdr ops) off acc def-acc))
                          ((or (and (pair? dst) (eq? (car dst) '%stack))
                               (and (pair? dst) (eq? (car dst) '%mem)
                                    (not (memq (inline-asm-canonical-gpr (cadr dst)) save-regs))))
                           (loop (cdr ops) off (inline-asm-x86-store-acc dst carrier acc) def-acc))
                          (else
                           (let ((op-mv (if (inline-asm-x86-xmm-reg? carrier) "movsd " "mov ")))
                             (loop (cdr ops)
                                   (- off 8)
                                   (cons (inline-asm-raw (string-append op-mv (inline-asm-x86-slot-str off) ", " (inline-asm-x86-reg-str carrier))) acc)
                                   (cons (list dst off carrier) def-acc))))))))
                ;; Phase E2: restore saved registers
                (let* ((acc-restored
                        (let rloop ((sp save-pairs) (a acc))
                          (if (null? sp)
                              a
                              (let* ((p (car sp))
                                     (op-mv (if (inline-asm-x86-xmm-reg? (car p)) "movsd " "mov ")))
                                (rloop (cdr sp)
                                       (cons (inline-asm-raw (string-append op-mv (inline-asm-x86-reg-str (car p)) ", " (inline-asm-x86-slot-str (cdr p)))) a))))))
                       ;; Phase E3: store deferred outputs
                       (acc-final
                        (let dloop ((ds (reverse def-acc)) (a acc-restored))
                          (if (null? ds)
                              a
                              (let* ((d (car ds))
                                     (dst (car d))
                                     (doff (cadr d))
                                     (carrier (caddr d))
                                     (dg (inline-asm-canonical-gpr dst))
                                     (c-xmm? (inline-asm-x86-xmm-reg? carrier)))
                                (cond
                                  (dg
                                   (dloop (cdr ds)
                                          (cons (inline-asm-raw (string-append (if (inline-asm-x86-xmm-reg? dg)
                                                                                   (if c-xmm? "movsd " "movq ")
                                                                                   (if c-xmm? "movsd " "mov "))
                                                                               (inline-asm-x86-reg-str dg) ", " (inline-asm-x86-slot-str doff))) a)))
                                  ((and (pair? dst) (eq? (car dst) '%mem))
                                   (let* ((c-save (- out-tmp-base (* (+ (length def-acc) 2) 8)))
                                          (op-mv (if c-xmm? "movsd " "mov "))
                                          (a1 (cons (inline-asm-raw (string-append op-mv (inline-asm-x86-slot-str c-save) ", " (inline-asm-x86-reg-str carrier))) a))
                                          (a2 (cons (inline-asm-raw (string-append op-mv (inline-asm-x86-reg-str carrier) ", " (inline-asm-x86-slot-str doff))) a1))
                                          (a3 (cons (inline-asm-raw (string-append op-mv (inline-asm-format-mem-opnd dst #f #f -1) ", " (inline-asm-x86-reg-str carrier))) a2))
                                          (a4 (cons (inline-asm-raw (string-append op-mv (inline-asm-x86-reg-str carrier) ", " (inline-asm-x86-slot-str c-save))) a3)))
                                     (dloop (cdr ds) a4)))
                                  (else
                                   (dloop (cdr ds) (inline-asm-x86-store-acc dst carrier a)))))))))
                  acc-final)))))
    (reverse epilogue)))

(define (has-dynamic-num-args? insts)
  (let loop ((is insts))
    (if (or (null? is) (not (pair? is)))
        #f
        (let ((i (car is)))
          (if (and (pair? i)
                   (or (and (eq? (car i) '%load)
                            (eq? (cadr i) '%rax)
                            (eq? (caddr i) '%rsp)
                            (pair? (cdddr i))
                            (= (cadddr i) -16))
                       (eq? (car i) '%num-args)))
              #t
              (loop (cdr is)))))))

(define (prepend-lowered-instructions is acc)
  (let loop ((cur is) (res acc))
    (if (null? cur)
        res
        (loop (cdr cur) (cons (car cur) res)))))

(define (select-instructions-function fn)
  (let* ((c-tu? (eq? (car *backend-gc-mode*) 'c-tu))
         (label (cadr fn))
         (label-str (asm-label->str label))
         (is-exported? (or (and c-tu? (%c99-exported-asm-label? label-str))
                           (string-starts-with? label-str "ulisp_fn_")))
         (frame-size-entry (assq 'frame-size (cddr fn)))
         (frame-size (if frame-size-entry (cadr frame-size-entry) 0))
         (params-entry (assq 'params (cddr fn)))
         (params (if params-entry (cadr params-entry) '()))
         (body (cdr (assq 'body (cddr fn))))
         (hoist-plan (if c-tu? (c-tu-analyze-hoist-frame body) #f))
         (hoist-f (if hoist-plan (car hoist-plan) 0))
         (delta-ords (if hoist-plan (cdr hoist-plan) '()))
         (out-frame-size (if (> hoist-f frame-size) hoist-f frame-size))
         (expected-args (if (and (not c-tu?) (list? params) (not (has-dynamic-num-args? body)))
                            (length params)
                            #f)))
    (set-car! *inline-asm-frame-size* frame-size)
    (set-car! *x86-c-tu-hoist-frame* hoist-f)
    (set-car! *x86-c-tu-delta-calls* delta-ords)
    (set-car! *x86-c-tu-call-ordinal* 0)
    (scan-x86-blocks! body)
    (let* ((guard-insts
            (if expected-args
                (list (list 'jcc 'jne "ulisp_arity_error")
                      (list 'cmp 'rax (* expected-args 4)))
                '()))
           (init-acc (append guard-insts
                             (if c-tu?
                                 (list (list '%label label)
                                       (list '%p2align 4))
                                 (list (list 'mov (list '%disp -8 'rsp) 'r10)
                                       (list '%label label)
                                       (list '%p2align 4)))))
           (base-acc (if is-exported?
                         (if c-tu?
                             (if (or (memq label '(__ulisp_setjmp __ulisp_longjmp __ulisp_san_trap))
                                     (memq label (car *c-tu-weak-fns*)))
                                 (append init-acc
                                         (list (list '%raw-asm (string-append "    .type " label-str ", @function"))
                                               (list '%raw-asm (string-append "    .weak " label-str))
                                               (list '%raw-asm (string-append "    .globl " label-str))))
                                 (append init-acc
                                         (list (list '%raw-asm (string-append "    .type " label-str ", @function"))
                                               (list '%raw-asm (string-append "    .globl " label-str)))))
                             (append init-acc
                                     (list (list '%raw-asm (string-append "    .type " label-str ", @function"))
                                           (list '%raw-asm (string-append "    .weak " label-str))
                                           (list '%raw-asm (string-append "    .globl " label-str)))))
                         (if c-tu?
                             (append init-acc
                                     (list (list '%raw-asm (string-append "    .type " label-str ", @function"))))
                             init-acc)))
           (hoist-base-acc (if (> hoist-f 0)
                               (cons (list 'sub 'rsp (list '%imm hoist-f)) base-acc)
                               base-acc)))
      (let loop ((rest body) (acc hoist-base-acc))
        (if (null? rest)
            (begin
              (set-car! *x86-c-tu-hoist-frame* 0)
              (set-car! *x86-c-tu-delta-calls* '())
              (set-car! *x86-c-tu-call-ordinal* 0)
              (list '%asm-function label (list 'frame-size out-frame-size) (cons 'body (reverse acc))))
            (let ((lowered (lower-lir-instruction (car rest))))
              (loop (cdr rest) (prepend-lowered-instructions lowered acc))))))))

(define (select-instructions-main main-clause)
  (let* ((c-tu? (eq? (car *backend-gc-mode*) 'c-tu))
         (frame-size-entry (assq 'frame-size (cdr main-clause)))
         (frame-size (if frame-size-entry (cadr frame-size-entry) 0))
         (raw-body (cdr (assq 'body (cdr main-clause))))
         (main-body (if c-tu? (c99-extract-global-init-insts raw-body) raw-body)))
    (set-car! *inline-asm-frame-size* frame-size)
    (set-car! *x86-c-tu-hoist-frame* 0)
    (set-car! *x86-c-tu-delta-calls* '())
    (set-car! *x86-c-tu-call-ordinal* 0)
    (set-car! *c-tu-has-init?* (and c-tu? (pair? main-body)))
    (scan-x86-blocks! main-body)
    (let loop ((rest main-body) (acc '()))
      (if (null? rest)
          (list '%asm-main
                (list 'frame-size frame-size)
                (cons 'body (if c-tu?
                                (if (null? main-body)
                                    '()
                                    (append (reverse acc) (list (list 'ret))))
                                (append (reverse acc)
                                        (if (module-mode?)
                                            (list (list 'add 'rsp 8)
                                                  (list 'ret))
                                            (list (list '%raw-asm "    lea r11, [rip + ulisp_final_r12]")
                                                  (list '%raw-asm "    mov [r11], r12")
                                                  (list 'add 'rsp 8)
                                                  (list 'pop 'r12)
                                                  (list 'ret)))))))
          (let ((inst (car rest)))
            (if (eq? (car inst) '%return)
                (loop (cdr rest) acc)
                (let ((lowered (lower-lir-instruction inst)))
                  (loop (cdr rest) (prepend-lowered-instructions lowered acc)))))))))

(define (select-instructions-x86 prog)
  (reset-x86-switch-tables!)
  (set-car! *x86-c-tu-hoist-frame* 0)
  (set-car! *x86-c-tu-delta-calls* '())
  (set-car! *x86-c-tu-call-ordinal* 0)
  (let* ((strings (assq 'strings (cdr prog)))
         (data-clause (assq 'data (cdr prog)))
         (stackmaps (assq 'stackmaps (cdr prog)))
         (weak-fns-clause (assq 'weak-fns (cdr prog)))
         (weak-data-clause (assq 'weak-data (cdr prog)))
         (aliases-clause (assq 'aliases (cdr prog)))
         (top-asm-clause (assq 'top-asm (cdr prog)))
         (funcs-clause (assq '%lir-functions (cdr prog)))
         (funcs (if funcs-clause (cdr funcs-clause) '()))
         (main-clause (assq '%lir-main (cdr prog))))
    (set-car! *c-tu-weak-fns* (if (and weak-fns-clause (pair? (cdr weak-fns-clause))) (cadr weak-fns-clause) '()))
    (set-car! *c-tu-weak-data* (if (and weak-data-clause (pair? (cdr weak-data-clause))) (cadr weak-data-clause) '()))
    (if (eq? (car *backend-gc-mode*) 'c-tu)
        (set-car! *c-tu-globals* (c99-collect-lir-globals prog))
        (set-car! *c-tu-globals* '()))
    (let* ((extra-clauses
            (append
             (if weak-fns-clause (list weak-fns-clause) '())
             (append
              (if weak-data-clause (list weak-data-clause) '())
              (append
               (if aliases-clause (list aliases-clause) '())
               (if top-asm-clause (list top-asm-clause) '())))))
           (res
            (if data-clause
                (append
                 (list '%asm-program
                       (if strings strings '(strings ()))
                       data-clause
                       (if stackmaps stackmaps '(stackmaps ()))
                       (cons '%asm-functions (map select-instructions-function funcs))
                       (select-instructions-main main-clause))
                 extra-clauses)
                (append
                 (list '%asm-program
                       (if strings strings '(strings ()))
                       (if stackmaps stackmaps '(stackmaps ()))
                       (cons '%asm-functions (map select-instructions-function funcs))
                       (select-instructions-main main-clause))
                 extra-clauses))))
      (set-car! *c-tu-weak-fns* '())
      (set-car! *c-tu-weak-data* '())
      (set-car! *x86-c-tu-hoist-frame* 0)
      (set-car! *x86-c-tu-delta-calls* '())
      (set-car! *x86-c-tu-call-ordinal* 0)
      res)))

;;; -----------------------------------------------------------------------
;;; Stage 2: Code Emission (L_asm_x86 AST -> GNU x86-64 Intel Syntax)
;;; -----------------------------------------------------------------------

(define (emit-x86-asm-inst inst)
  (let ((op (car inst)))
    (case op
      ((%loc)
       (emit (string-append "    .loc "
                            (number->string (cadr inst))
                            " "
                            (number->string (caddr inst))
                            " "
                            (number->string (cadddr inst)))))
      ((%label)
       (let ((lbl (cadr inst)))
         (let ((sink (car *emit-line-sink*)))
           (if sink
               (sink (string-append (asm-label->str lbl) ":"))
               (begin
                 (write-string (asm-label->str lbl))
                 (write-char #\:)
                 (write-char #\newline))))))
      ((%p2align)
       (emit-inst2 ".p2align" (small-int->string (cadr inst))))
      ((%align)
       (emit-inst2 ".align" (small-int->string (cadr inst))))
      ((%raw-asm)
       (emit (cadr inst)))
      ((mov)
       (let ((dst-str (asm-opnd->str (cadr inst)))
             (src-str (asm-opnd->str (caddr inst))))
         (if (and (not (eq? (car *backend-gc-mode*) 'c-tu))
                  (string=? dst-str "rax")
                  (or (string=? src-str "[rax - 1]")
                      (string=? src-str "[rax + 7]")))
             (begin
               (emit "    mov rcx, rax")
               (emit "    and rcx, 7")
               (emit "    cmp rcx, 1")
               (emit "    jne ulisp_pair_type_error")
               (emit-inst3 "mov" dst-str src-str))
             (emit-inst3 "mov" dst-str src-str))))
      ((movzx)
       (emit-inst3 "movzx" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((lea)
       (emit-inst3 "lea" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((add)
       (emit-inst3 "add" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((sub)
       (emit-inst3 "sub" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((imul)
       (emit-inst3 "imul" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((and)
       (emit-inst3 "and" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((or)
       (emit-inst3 "or" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((xor)
       (emit-inst3 "xor" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((shl)
       (let ((cnt (caddr inst)))
         (emit-inst3 "shl"
                     (asm-opnd->str (cadr inst))
                     (cond ((integer? cnt) (small-int->string cnt))
                           ((memq cnt '(cl %cl rcx %rcx)) "cl")
                           (else (asm-opnd->str cnt))))))
      ((shr)
       (let ((cnt (caddr inst)))
         (emit-inst3 "shr"
                     (asm-opnd->str (cadr inst))
                     (cond ((integer? cnt) (small-int->string cnt))
                           ((memq cnt '(cl %cl rcx %rcx)) "cl")
                           (else (asm-opnd->str cnt))))))
      ((sar)
       (let ((cnt (caddr inst)))
         (emit-inst3 "sar"
                     (asm-opnd->str (cadr inst))
                     (cond ((integer? cnt) (small-int->string cnt))
                           ((memq cnt '(cl %cl rcx %rcx)) "cl")
                           (else (asm-opnd->str cnt))))))
      ((neg)
       (emit-inst2 "neg" (asm-opnd->str (cadr inst))))
      ((not)
       (emit-inst2 "not" (asm-opnd->str (cadr inst))))
      ((cmp)
       (emit-inst3 "cmp" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((test)
       (emit-inst3 "test" (asm-opnd->str (cadr inst)) (asm-opnd->str (caddr inst))))
      ((set)
       (let ((cc (cadr inst))
             (dst (caddr inst)))
         (let ((cc-str (cond
                         ((string? cc) cc)
                         ((eq? cc 'e) "e")
                         ((eq? cc 'ne) "ne")
                         ((eq? cc 'l) "l")
                         ((eq? cc 'le) "le")
                         ((eq? cc 'g) "g")
                         ((eq? cc 'ge) "ge")
                         ((eq? cc 'a) "a")
                         ((eq? cc 'ae) "ae")
                         ((eq? cc 'b) "b")
                         ((eq? cc 'be) "be")
                         ((eq? cc 's) "s")
                         ((eq? cc 'ns) "ns")
                         ((eq? cc 'p) "p")
                         ((eq? cc 'np) "np")
                         ((eq? cc 'o) "o")
                         ((eq? cc 'no) "no")
                         ((eq? cc 'c) "c")
                         ((eq? cc 'nc) "nc")
                         ((eq? cc 'z) "z")
                         ((eq? cc 'nz) "nz")
                         ((eq? cc 'sete) "e")
                         ((eq? cc 'setne) "ne")
                         ((eq? cc 'setl) "l")
                         ((eq? cc 'setle) "le")
                         ((eq? cc 'setg) "g")
                         ((eq? cc 'setge) "ge")
                         ((eq? cc 'seta) "a")
                         ((eq? cc 'setae) "ae")
                         ((eq? cc 'setb) "b")
                         ((eq? cc 'setbe) "be")
                         ((eq? cc 'sets) "s")
                         ((eq? cc 'setns) "ns")
                         ((eq? cc 'setp) "p")
                         ((eq? cc 'setnp) "np")
                         ((eq? cc 'seto) "o")
                         ((eq? cc 'setno) "no")
                         ((eq? cc 'setc) "c")
                         ((eq? cc 'setnc) "nc")
                         ((eq? cc 'setz) "z")
                         ((eq? cc 'setnz) "nz")
                         ((symbol? cc)
                          (let ((s (symbol->raw-name cc)))
                            (if (string=? s "?") "e" s)))
                         (else "e"))))
           (emit-inst2 (string-append "set" cc-str) (asm-opnd->str dst)))))
      ((jmp)
       (let ((target (cadr inst)))
         (cond
           ((string? target)
            (emit-inst2 "jmp" target))
           ((and (symbol? target)
                 (let ((s (symbol->raw-name target)))
                   (and (> (string-length s) 0)
                        (char=? (string-ref s 0) #\.))))
            (emit-inst2 "jmp" (asm-label->str target)))
           ((case target
              ((%rax rax %rbx rbx %rcx rcx %rdx rdx
                %rsi rsi %rdi rdi %rbp rbp %rsp rsp
                %r8  r8  %r9  r9  %r10 r10 %r11 r11
                %r12 r12 %r13 r13 %r14 r14 %r15 r15)
               #t)
              (else #f))
            (emit-inst2 "jmp" (asm-opnd->str target)))
           (else
            (emit-inst2 "jmp" (asm-label->str target))))))
      ((jcc)
       (let ((cc (cadr inst))
             (lbl (caddr inst)))
         (let ((cc-str (cond
                         ((string? cc) cc)
                         ((eq? cc 'je) "je")
                         ((eq? cc 'jne) "jne")
                         ((eq? cc 'jl) "jl")
                         ((eq? cc 'jle) "jle")
                         ((eq? cc 'jg) "jg")
                         ((eq? cc 'jge) "jge")
                         ((eq? cc 'ja) "ja")
                         ((eq? cc 'jae) "jae")
                         ((eq? cc 'jb) "jb")
                         ((eq? cc 'jbe) "jbe")
                         ((eq? cc 'js) "js")
                         ((eq? cc 'jns) "jns")
                         ((eq? cc 'jp) "jp")
                         ((eq? cc 'jnp) "jnp")
                         ((eq? cc 'jo) "jo")
                         ((eq? cc 'jno) "jno")
                         ((eq? cc 'jc) "jc")
                         ((eq? cc 'jnc) "jnc")
                         ((eq? cc 'jz) "jz")
                         ((eq? cc 'jnz) "jnz")
                         ((symbol? cc)
                          (let ((s (symbol->raw-name cc)))
                            (if (string=? s "?") "je" s)))
                         (else "je"))))
           (emit-inst2 cc-str (asm-label->str lbl)))))
      ((call)
       (let ((target (cadr inst)))
         (cond
           ((string? target)
            (emit-inst2 "call" target))
           ((case target
              ((%rax rax %rbx rbx %rcx rcx %rdx rdx
                %rsi rsi %rdi rdi %rbp rbp %rsp rsp
                %r8  r8  %r9  r9  %r10 r10 %r11 r11
                %r12 r12 %r13 r13 %r14 r14 %r15 r15)
               #t)
              (else #f))
            (emit-inst2 "call" (asm-opnd->str target)))
           (else
            (emit-inst2 "call" (asm-label->str target))))))
      ((ret)
       (emit "    ret"))
      ((push)
       (emit-inst2 "push" (asm-opnd->str (cadr inst))))
      ((pop)
       (emit-inst2 "pop" (asm-opnd->str (cadr inst))))
      ((cqo)
       (emit "    cqo"))
      ((idiv)
       (emit-inst2 "idiv" (asm-opnd->str (cadr inst))))
      ((div)
       (emit-inst2 "div" (asm-opnd->str (cadr inst))))
      ((inc)
       (emit-inst2 "inc" (asm-opnd->str (cadr inst))))
      ((syscall)
       (emit "    syscall"))
      ((cld)
       (emit "    cld"))
      ((rep-movsb)
       (emit "    rep movsb"))
      (else
       (error "Unknown x86 assembly instruction:" inst)))))

(define (emit-lir-instruction inst)
  (for-each emit-x86-asm-inst (lower-lir-instruction inst)))

(define (emit-x86-function fn)
  (let* ((label (cadr fn))
         (label-str (asm-label->str label))
         (body (cdr (assq 'body (cddr fn)))))
    (scan-x86-blocks! body)
    (emit "    .p2align 4")
    (emit (string-append label-str ":"))
    (emit "    mov [rsp - 8], r10")
    (for-each emit-lir-instruction body)))

(define (emit-x86-asm-function fn)
  (let* ((body-entry (assq 'body (cddr fn)))
         (body (if body-entry (cdr body-entry) '())))
    (for-each emit-x86-asm-inst body)))

(define (%c99-exported-asm-label? lbl-str)
  (not (string-starts-with? lbl-str ".L_")))

(define (%c99-string-needs-raw-bytes? s)
  (let ((n (string-length s)))
    (let loop ((i 0))
      (if (>= i n)
          #f
          (let ((c (char->integer (string-ref s i))))
            (if (or (< c 32) (>= c 127))
                #t
                (loop (+ i 1))))))))

(define (%c99-string->cstr-bytes s)
  (let loop ((i (- (string-length s) 1)) (bs '(0)))
    (if (< i 0)
        bs
        (loop (- i 1) (cons (modulo (char->integer (string-ref s i)) 256) bs)))))

(define (%c99-emit-x86-byte-group bs)
  (if (pair? bs)
      (let loop ((xs (cdr bs)) (s (string-append "    .byte " (number->string (car bs)))))
        (if (null? xs)
            (emit s)
            (loop (cdr xs) (string-append s ", " (number->string (car xs))))))))

(define (%c99-emit-x86-data-chunks chunks)
  (let loop ((cs chunks) (pending '()))
    (cond
      ((null? cs)
       (if (pair? pending) (%c99-emit-x86-byte-group (reverse pending))))
      ((integer? (car cs))
       (let ((next (cons (car cs) pending)))
         (if (>= (length next) 16)
             (begin
               (%c99-emit-x86-byte-group (reverse next))
               (loop (cdr cs) '()))
             (loop (cdr cs) next))))
      (else
       (if (pair? pending) (%c99-emit-x86-byte-group (reverse pending)))
       (let ((c (car cs)))
         (cond
           ((and (pair? c) (eq? (car c) 'zero))
            (if (> (cadr c) 0)
                (emit (string-append "    .zero " (number->string (cadr c))))))
           ((and (pair? c) (eq? (car c) 'reloc))
            (let ((t-str (asm-label->str (cadr c)))
                  (off (caddr c)))
              (emit (cond
                      ((= off 0) (string-append "    .quad " t-str))
                      ((> off 0) (string-append "    .quad " t-str " + " (number->string off)))
                      (else (string-append "    .quad " t-str " - " (number->string (- 0 off))))))))))
       (loop (cdr cs) '())))))

(define (emit-c-tu-x86-asm-program asm-prog funcs main-body)
  (emit "    .intel_syntax noprefix")
  (if (debug-symbols-enabled?)
      (for-each
        (lambda (entry)
          (let ((path (car entry))
                (id (cdr entry)))
            (emit (string-append "    .file " (number->string id) " \"" path "\""))))
        (get-source-file-table)))
  (let* ((weak-fns-clause (assq 'weak-fns (cdr asm-prog)))
         (weak-fns-syms (if (and weak-fns-clause (pair? (cdr weak-fns-clause))) (cadr weak-fns-clause) '()))
         (weak-data-clause (assq 'weak-data (cdr asm-prog)))
         (weak-data-syms (if (and weak-data-clause (pair? (cdr weak-data-clause))) (cadr weak-data-clause) '()))
         (aliases-clause (assq 'aliases (cdr asm-prog)))
         (aliases-list (if (and aliases-clause (pair? (cdr aliases-clause))) (cadr aliases-clause) '()))
         (top-asm-clause (assq 'top-asm (cdr asm-prog)))
         (top-asm-lines (if (and top-asm-clause (pair? (cdr top-asm-clause))) (cadr top-asm-clause) '())))
    (set-car! *c-tu-weak-data* weak-data-syms)
    (emit "    .text")
    (let top-loop ((ls top-asm-lines))
      (if (pair? ls)
          (begin
            (emit (car ls))
            (top-loop (cdr ls)))))
    (for-each emit-x86-asm-function funcs)
    (if (pair? aliases-list)
        (begin
          (emit "    .text")
          (let al-loop ((as aliases-list))
            (if (pair? as)
                (let* ((entry (car as))
                       (alias-str (asm-label->str (car entry)))
                       (tgt-str (asm-label->str (cadr entry)))
                       (weak? (caddr entry)))
                  (emit (string-append (if weak? "    .weak " "    .globl ") alias-str))
                  (emit (string-append "    .set " alias-str ", " tgt-str))
                  (al-loop (cdr as))))))))
  (if (and (car *c-tu-has-init?*) (pair? main-body))
      (begin
        (emit "    .p2align 4")
        (emit ".L_c99_tu_init:")
        (for-each emit-x86-asm-inst main-body)
        (emit "    .section .init_array, \"aw\"")
        (emit "    .p2align 3")
        (emit "    .quad .L_c99_tu_init")))
  (let* ((strings-clause (assq 'strings (cdr asm-prog)))
         (str-entries (if (and strings-clause (pair? (cdr strings-clause)))
                          (cadr strings-clause)
                          '())))
    (if (pair? str-entries)
        (begin
          (emit "    .section .rodata")
          (for-each (lambda (entry)
                      (let* ((lbl-str (asm-label->str (car entry)))
                             (raw-str (cadr entry)))
                        (emit "    .p2align 3")
                        (emit (string-append lbl-str ":"))
                        (cond
                          ((and (pair? raw-str) (eq? (car raw-str) 'bytes))
                           (%c99-emit-x86-data-chunks (append (cdr raw-str) '(0))))
                          ((%c99-string-needs-raw-bytes? raw-str)
                           (%c99-emit-x86-data-chunks (%c99-string->cstr-bytes raw-str)))
                          (else
                           (emit (string-append "    .asciz \"" (escape-gas-string raw-str) "\""))))))
                    str-entries))))
  (emit-x86-switch-jump-tables!)
  (let* ((data-clause (assq 'data (cdr asm-prog)))
         (data-entries (if (and data-clause (pair? (cdr data-clause)))
                           (cadr data-clause)
                           '()))
         (ro-bytes-entries (let loop ((es data-entries) (acc '()))
                             (cond ((null? es) (reverse acc))
                                   ((and (eq? (caar es) 'bytes)
                                         (let ((s (asm-label->str (cadar es))))
                                           (and (>= (string-length s) 9)
                                                (string=? (substring s 0 9) ".L_c99_fp"))))
                                    (loop (cdr es) (cons (car es) acc)))
                                   (else (loop (cdr es) acc)))))
         (bytes-entries (let loop ((es data-entries) (acc '()))
                          (cond ((null? es) (reverse acc))
                                ((and (eq? (caar es) 'bytes)
                                      (not (let ((s (asm-label->str (cadar es))))
                                             (and (>= (string-length s) 9)
                                                  (string=? (substring s 0 9) ".L_c99_fp")))))
                                 (loop (cdr es) (cons (car es) acc)))
                                (else (loop (cdr es) acc)))))
         (bss-entries (let loop ((es data-entries) (acc '()))
                        (cond ((null? es) (reverse acc))
                              ((eq? (caar es) 'bss) (loop (cdr es) (cons (car es) acc)))
                              (else (loop (cdr es) acc)))))
         (gvs (car *c-tu-globals*)))
    (if (pair? ro-bytes-entries)
        (begin
          (emit "    .section .rodata")
          (for-each (lambda (de)
                      (let* ((lbl-str (asm-label->str (cadr de)))
                             (al (caddr de))
                             (chunks (cdddr de)))
                        (if (> al 1)
                            (emit (string-append "    .align " (number->string al))))
                        (emit (string-append lbl-str ":"))
                        (%c99-emit-x86-data-chunks chunks)))
                    ro-bytes-entries)))
    (if (pair? bytes-entries)
        (begin
          (emit "    .section .data")
          (for-each (lambda (de)
                      (let* ((lbl-str (asm-label->str (cadr de)))
                             (al (caddr de))
                             (chunks (cdddr de)))
                        (if (> al 1)
                            (emit (string-append "    .align " (number->string al))))
                        (if (%c99-exported-asm-label? lbl-str)
                            (begin
                              (if (memq (cadr de) (car *c-tu-weak-data*))
                                  (emit (string-append "    .weak " lbl-str))
                                  (emit (string-append "    .globl " lbl-str)))
                              (emit (string-append "    .type " lbl-str ", @object"))))
                        (emit (string-append lbl-str ":"))
                        (%c99-emit-x86-data-chunks chunks)))
                    bytes-entries)))
    (if (or (pair? bss-entries) (pair? gvs))
        (begin
          (emit "    .section .bss")
          (for-each (lambda (de)
                      (let* ((lbl-str (asm-label->str (cadr de)))
                             (al (caddr de))
                             (sz (cadddr de)))
                        (if (> al 1)
                            (emit (string-append "    .align " (number->string al))))
                        (if (%c99-exported-asm-label? lbl-str)
                            (begin
                              (if (memq (cadr de) (car *c-tu-weak-data*))
                                  (emit (string-append "    .weak " lbl-str))
                                  (emit (string-append "    .globl " lbl-str)))
                              (emit (string-append "    .type " lbl-str ", @object"))))
                        (emit (string-append lbl-str ":"))
                        (if (> sz 0)
                            (emit (string-append "    .zero " (number->string sz))))))
                    bss-entries)
          (for-each (lambda (v)
                      (let ((g-lbl (mangle-gvar-label v)))
                        (emit "    .align 8")
                        (emit (string-append "    .globl " g-lbl))
                        (emit (string-append "    .weak " g-lbl))
                        (emit (string-append g-lbl ":"))
                        (emit "    .quad 0")))
                    gvs))))
  (let* ((wf-clause (assq 'weak-fns (cdr asm-prog)))
