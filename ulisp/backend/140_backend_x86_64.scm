;;; =======================================================================
;;; ULisp Compiler Pass 140: Native x86-64 Backend Code Generator
;;; Conforms to DSN-33 Architecture Specification & Issue #596
;;; Implements 2-stage backend: Instruction Selection (LIR -> L_asm_x86)
;;; and Assembly Code Emission (L_asm_x86 -> GNU x86-64 Intel Syntax).
;;; =======================================================================

(define *emit-line-sink* (cons #f '()))

(define (set-emit-line-sink! sink)
  (set-car! *emit-line-sink* sink))

(define (get-emit-line-sink)
  (car *emit-line-sink*))

(define (emit line)
  (let ((sink (car *emit-line-sink*)))
    (if sink
        (sink line)
        (begin
          (write-string line)
          (write-char #\newline)))))

(define (emit-inst2 op a1)
  (let ((sink (car *emit-line-sink*)))
    (if sink
        (sink (string-append "    " op " " a1))
        (begin
          (write-string "    ")
          (write-string op)
          (write-char #\space)
          (write-string a1)
          (write-char #\newline)))))

(define (emit-inst3 op a1 a2)
  (let ((sink (car *emit-line-sink*)))
    (if sink
        (sink (string-append "    " op " " a1 ", " a2))
        (begin
          (write-string "    ")
          (write-string op)
          (write-char #\space)
          (write-string a1)
          (write-string ", ")
          (write-string a2)
          (write-char #\newline)))))

(define *small-int-cache* (make-vector 1024 #f))
(define (small-int->string n)
  (if (and (>= n 0) (< n 1024))
      (let ((cached (vector-ref *small-int-cache* n)))
        (if cached
            cached
            (let ((s (number->string n)))
              (vector-set! *small-int-cache* n s)
              s)))
      (number->string n)))

(define *stack-opnd-cache* (make-vector 256 #f))
(define (get-stack-opnd-str off)
  (if (and (<= off 0) (>= off -2040) (= (modulo off 8) 0))
      (let* ((idx (- 0 (quotient off 8)))
             (cached (vector-ref *stack-opnd-cache* idx)))
        (if cached
            cached
            (let ((s (string-append "[rsp " (offset->string off) "]")))
              (vector-set! *stack-opnd-cache* idx s)
              s)))
      (string-append "[rsp " (offset->string off) "]")))

(define (backend-append-2 l1 l2)
  (if (null? l1)
      l2
      (cons (car l1) (backend-append-2 (cdr l1) l2))))

(define (backend-concat lists)
  (let loop ((rest lists))
    (cond
      ((null? rest) '())
      ((null? (cdr rest)) (car rest))
      (else (backend-append-2 (car rest) (loop (cdr rest)))))))

(define (reg->str reg)
  (case reg
    ((%rax rax) "rax")
    ((%rbx rbx) "rbx")
    ((%rcx rcx) "rcx")
    ((%rdx rdx) "rdx")
    ((%rsi rsi) "rsi")
    ((%rdi rdi) "rdi")
    ((%rbp rbp) "rbp")
    ((%rsp rsp) "rsp")
    ((%r8  r8)  "r8")
    ((%r9  r9)  "r9")
    ((%r10 r10) "r10")
    ((%r11 r11) "r11")
    ((%r12 r12) "r12")
    ((%r13 r13) "r13")
    ((%r14 r14) "r14")
    ((%r15 r15) "r15")
    ((%al  al)  "al")
    ((%cl  cl)  "cl")
    ((%xmm0 xmm0) "xmm0")
    ((%xmm1 xmm1) "xmm1")
    ((%xmm2 xmm2) "xmm2")
    ((%xmm3 xmm3) "xmm3")
    ((%xmm4 xmm4) "xmm4")
    ((%xmm5 xmm5) "xmm5")
    ((%xmm6 xmm6) "xmm6")
    ((%xmm7 xmm7) "xmm7")
    ((%xmm8 xmm8) "xmm8")
    ((%xmm9 xmm9) "xmm9")
    ((%xmm10 xmm10) "xmm10")
    ((%xmm11 xmm11) "xmm11")
    ((%xmm12 xmm12) "xmm12")
    ((%xmm13 xmm13) "xmm13")
    ((%xmm14 xmm14) "xmm14")
    ((%xmm15 xmm15) "xmm15")
    (else
     (cond
       ((and (pair? reg) (eq? (car reg) '%reg))
        (if (and (pair? (cdr reg)) (pair? (cddr reg)))
            (reg->str (caddr reg))
            (reg->str (cadr reg))))
       ((and (pair? reg) (eq? (car reg) '%freg))
        (reg->str (cadr reg)))
       ((symbol? reg) (asm-label->str reg))
       (else reg)))))

(define (reg8->str reg)
  (case reg
    ((%rax rax) "al")
    ((%rbx rbx) "bl")
    ((%rcx rcx) "cl")
    ((%rdx rdx) "dl")
    ((%rsi rsi) "sil")
    ((%rdi rdi) "dil")
    ((%rbp rbp) "bpl")
    ((%rsp rsp) "spl")
    ((%r8  r8)  "r8b")
    ((%r9  r9)  "r9b")
    ((%r10 r10) "r10b")
    ((%r11 r11) "r11b")
    ((%r12 r12) "r12b")
    ((%r13 r13) "r13b")
    ((%r14 r14) "r14b")
    ((%r15 r15) "r15b")
    ((%al  al)  "al")
    ((%cl  cl)  "cl")
    (else (reg->str reg))))

(define (reg16->str reg)
  (case reg
    ((%rax rax) "ax")
    ((%rbx rbx) "bx")
    ((%rcx rcx) "cx")
    ((%rdx rdx) "dx")
    ((%rsi rsi) "si")
    ((%rdi rdi) "di")
    ((%rbp rbp) "bp")
    ((%rsp rsp) "sp")
    ((%r8  r8)  "r8w")
    ((%r9  r9)  "r9w")
    ((%r10 r10) "r10w")
    ((%r11 r11) "r11w")
    ((%r12 r12) "r12w")
    ((%r13 r13) "r13w")
    ((%r14 r14) "r14w")
    ((%r15 r15) "r15w")
    (else (reg->str reg))))

(define (reg32->str reg)
  (case reg
    ((%rax rax) "eax")
    ((%rbx rbx) "ebx")
    ((%rcx rcx) "ecx")
    ((%rdx rdx) "edx")
    ((%rsi rsi) "esi")
    ((%rdi rdi) "edi")
    ((%rbp rbp) "ebp")
    ((%rsp rsp) "esp")
    ((%r8  r8)  "r8d")
    ((%r9  r9)  "r9d")
    ((%r10 r10) "r10d")
    ((%r11 r11) "r11d")
    ((%r12 r12) "r12d")
    ((%r13 r13) "r13d")
    ((%r14 r14) "r14d")
    ((%r15 r15) "r15d")
    (else (reg->str reg))))

(define (mem-op->str base offset)
  (cond
    ((and (or (eq? base 'rax) (eq? base '%rax)) (eq? offset -1)) "[rax - 1]")
    ((and (or (eq? base 'rax) (eq? base '%rax)) (eq? offset 7)) "[rax + 7]")
    (else
     (let ((base-str (reg->str base)))
       (cond
         ((and (pair? offset) (eq? (car offset) '%sib))
          (let* ((idx (reg->str (cadr offset)))
                 (scale (small-int->string (caddr offset)))
                 (disp (cadddr offset))
                 (disp-str (cond ((= disp 0) "")
                                 ((> disp 0) (string-append " + " (small-int->string disp)))
                                 (else (string-append " - " (small-int->string (- 0 disp)))))))
            (string-append "[" base-str " + " idx "*" scale disp-str "]")))
         ((symbol? offset)
          (string-append "[" base-str " + " (reg->str offset) "]"))
         (else
          (string-append "[" base-str " " (offset->string offset) "]")))))))

(define (operand->str opnd)
  (cond
    ((string? opnd)
     opnd)
    ((symbol? opnd)
     (reg->str opnd))
    ((integer? opnd)
     (small-int->string opnd))
    ((pair? opnd)
     (let ((tag (car opnd)))
       (case tag
         ((%reg)
          (reg->str (cadr opnd)))
         ((%stack)
          (get-stack-opnd-str (cadr opnd)))
         ((%disp)
          (mem-op->str (caddr opnd) (cadr opnd)))
         ((%imm)
          (small-int->string (cadr opnd)))
         ((%mem)
          (mem-op->str (cadr opnd) (caddr opnd)))
         (else
          (error "Unknown operand in x86-64 backend:" opnd)))))
    (else
     (error "Invalid operand type in x86-64 backend:" opnd))))

(define (asm-opnd->str opnd)
  (operand->str opnd))

;;; Block Arguments tracking and parallel copy for SSA LIR
(define *x86-block-params* (cons '() '()))
(define *backend-gc-mode* (cons 'all '()))
(define *alloc-counter* (cons 0 '()))
(define *c-tu-globals* (cons '() '()))
(define *c-tu-has-init?* (cons #f '()))
(define *x86-switch-jump-tables* (cons '() '()))
(define *x86-switch-jt-counter* (cons 0 '()))
(define *x86-c-tu-hoist-frame* (cons 0 '()))
(define *x86-c-tu-delta-calls* (cons '() '()))
(define *x86-c-tu-call-ordinal* (cons 0 '()))

(define (x86-align-frame-16k+8 n)
  (let* ((base (if (< n 8) 8 n))
         (rem (modulo base 16)))
    (cond
      ((= rem 8) base)
      ((< rem 8) (+ base (- 8 rem)))
      (else (+ base (- 24 rem))))))

(define (x86-int-memq? x xs)
  (let loop ((cur xs))
    (cond
      ((null? cur) #f)
      ((and (integer? (car cur)) (= x (car cur))) #t)
      (else (loop (cdr cur))))))

(define (x86-int-remove x xs)
  (let loop ((cur xs) (acc '()))
    (cond
      ((null? cur) (reverse acc))
      ((and (integer? (car cur)) (= x (car cur))) (loop (cdr cur) acc))
      (else (loop (cdr cur) (cons (car cur) acc))))))

(define (x86-rsp-sym? x)
  (or (eq? x '%rsp)
      (eq? x 'rsp)
      (and (pair? x) (eq? (car x) '%reg) (pair? (cdr x))
           (or (eq? (cadr x) '%rsp) (eq? (cadr x) 'rsp)))))

(define (x86-safe-non-rsp-gpr? x)
  (let ((r (if (and (pair? x) (eq? (car x) '%reg) (pair? (cdr x)))
               (cadr x)
               x)))
    (and (symbol? r)
         (case r
           ((%rax rax %rbx rbx %rcx rcx %rdx rdx
             %rsi rsi %rdi rdi %rbp rbp
             %r8 r8 %r9 r9 %r10 r10 %r11 r11
             %r12 r12 %r13 r13 %r14 r14 %r15 r15)
            #t)
           (else #f)))))

(define (x86-tree-has-rsp-or-stack? x)
  (cond
    ((or (eq? x '%rsp) (eq? x 'rsp) (eq? x '%stack)) #t)
    ((pair? x) (or (x86-tree-has-rsp-or-stack? (car x))
                   (x86-tree-has-rsp-or-stack? (cdr x))))
    (else #f)))

(define (x86-safe-rsp-offset? off)
  (or (integer? off)
      (and (pair? off)
           (eq? (car off) '%sib)
           (= (length off) 4)
           (not (x86-rsp-sym? (cadr off)))
           (integer? (cadddr off)))))

(define (x86-rsp-offset-neg-depth off)
  (cond
    ((and (integer? off) (< off 0)) (- 0 off))
    ((and (pair? off) (eq? (car off) '%sib) (= (length off) 4) (integer? (cadddr off)) (< (cadddr off) 0))
     (- 0 (cadddr off)))
    (else 0)))

(define (x86-scan-safe-stack-opnds x cur-max)
  (cond
    ((not cur-max) #f)
    ((not (x86-tree-has-rsp-or-stack? x)) cur-max)
    ((or (eq? x '%rsp) (eq? x 'rsp) (eq? x '%stack)) #f)
    ((pair? x)
     (cond
       ((eq? (car x) '%stack)
        (if (and (= (length x) 2) (integer? (cadr x)))
            (let ((off (cadr x)))
              (if (< off 0) (max cur-max (- 0 off)) cur-max))
            #f))
       ((eq? (car x) '%disp)
        (if (and (= (length x) 3) (integer? (cadr x)) (x86-rsp-sym? (caddr x)))
            (let ((off (cadr x)))
              (if (< off 0) (max cur-max (- 0 off)) cur-max))
            (and (= (length x) 3)
                 (not (x86-tree-has-rsp-or-stack? (cadr x)))
                 (not (x86-tree-has-rsp-or-stack? (caddr x)))
                 cur-max)))
       ((eq? (car x) '%mem)
        (if (and (= (length x) 3) (x86-rsp-sym? (cadr x)) (integer? (caddr x)))
            (let ((off (caddr x)))
              (if (< off 0) (max cur-max (- 0 off)) cur-max))
            (and (= (length x) 3)
                 (not (x86-tree-has-rsp-or-stack? (cadr x)))
                 (not (x86-tree-has-rsp-or-stack? (caddr x)))
                 cur-max)))
       (else
        (let ((left (x86-scan-safe-stack-opnds (car x) cur-max)))
          (and left (x86-scan-safe-stack-opnds (cdr x) left))))))
    (else cur-max)))

(define (x86-flatten-lir-body body)
  (let loop ((xs body) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((inst (car xs)))
          (if (and (pair? inst) (eq? (car inst) '%block))
              (let ((lbl (cadr inst))
                    (b-insts (cdddr inst)))
                (let bloop ((bs b-insts) (acc1 (cons (list '%label lbl) acc)))
                  (if (null? bs)
                      (loop (cdr xs) acc1)
                      (bloop (cdr bs) (cons (car bs) acc1)))))
              (loop (cdr xs) (cons inst acc)))))))

(define (x86-collect-local-labels flat)
  (let loop ((xs flat) (lbls '()))
    (if (null? xs)
        lbls
        (let ((inst (car xs)))
          (if (and (pair? inst) (eq? (car inst) '%label))
              (loop (cdr xs) (cons (cadr inst) lbls))
              (loop (cdr xs) lbls))))))

(define (c-tu-analyze-hoist-frame body)
  (let* ((flat (x86-flatten-lir-body body))
         (local-lbls (x86-collect-local-labels flat)))
    (let loop ((xs flat)
               (call-ord 0)
               (max-call-shift 0)
               (max-neg 0)
               (unread-stores '())
               (rsp-addr-offs '())
               (calls-info '()))
      (if (null? xs)
          (if (or (= call-ord 0) (<= max-call-shift 0))
              #f
              (let* ((hoist-f (x86-align-frame-16k+8 (max max-call-shift max-neg)))
                     (deltas
                      (let dloop ((cs calls-info) (acc '()))
                        (if (null? cs)
                            (reverse acc)
                            (let* ((c (car cs))
                                   (ord (list-ref c 0))
                                   (sh (list-ref c 1))
                                   (ust (list-ref c 2))
                                   (raos (list-ref c 3))
                                   (neg-sh (- 0 sh)))
                              (if (and (< sh hoist-f)
                                       (or (x86-int-memq? neg-sh ust)
                                           (x86-int-memq? neg-sh raos)
                                           (memq 'any raos)))
                                  (dloop (cdr cs) (cons ord acc))
                                  (dloop (cdr cs) acc)))))))
                (cons hoist-f deltas)))
          (let ((inst (car xs))
                (rest (cdr xs)))
            (if (not (pair? inst))
                #f
                (let ((op (car inst)))
                  (cond
                    ((memq op '(%inline-asm %push %pop %alloc %alloc-stack
                                %managed-alloc %managed-alloc-stack %syscall
                                %capture-cc %push-handler %pop-handler %raise
                                %store-values-buf %dispatch-consumer %call-closure
                                %atomic-cas!))
                     #f)
                    ((memq op '(%jump %direct-jump))
                     (let* ((lbl (cadr inst))
                            (args (if (and (pair? (cddr inst)) (list? (caddr inst))) (caddr inst) '()))
                            (next-neg (x86-scan-safe-stack-opnds args max-neg)))
                       (if (or (not (memq lbl local-lbls)) (not next-neg))
                           #f
                           (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))
                    ((memq op '(%direct-call %c-call %call-foreign %call-indirect))
                     (let ((sh (and (pair? (cddr inst)) (caddr inst))))
                       (if (or (not (integer? sh)) (<= sh 0) (not (= (modulo sh 16) 8)))
                           #f
                           (loop rest
                                 (+ call-ord 1)
                                 (max max-call-shift sh)
                                 max-neg
                                 '()
                                 '()
                                 (cons (list call-ord sh unread-stores rsp-addr-offs) calls-info)))))
                    ((eq? op '%mov)
                     (let ((dst (cadr inst))
                           (src (caddr inst)))
                       (cond
                         ((x86-rsp-sym? dst) #f)
                         ((x86-rsp-sym? src)
                          (if (not (x86-safe-non-rsp-gpr? dst))
                              #f
                              (let* ((nxt (if (pair? rest) (car rest) #f))
                                     (nxt-int (and (pair? nxt)
                                                   (memq (car nxt) '(%add %raw-add))
                                                   (= (length nxt) 3)
                                                   (equal? (cadr nxt) dst)
                                                   (integer? (caddr nxt))
                                                   (caddr nxt)))
                                     (next-neg (if (and nxt-int (< nxt-int 0))
                                                   (max max-neg (- 0 nxt-int))
                                                   max-neg))
                                     (next-raos (if nxt-int
                                                    (cons nxt-int rsp-addr-offs)
                                                    (cons 'any rsp-addr-offs))))
                                (loop rest call-ord max-call-shift next-neg unread-stores next-raos calls-info))))
                         (else
                          (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                            (and next-neg
                                 (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info)))))))
                    ((memq op '(%load %load-byte-zx))
                     (let ((dst (cadr inst))
                           (base (caddr inst))
                           (off (cadddr inst)))
                       (if (x86-rsp-sym? dst)
                           #f
                           (if (x86-rsp-sym? base)
                               (if (not (x86-safe-rsp-offset? off))
                                   #f
                                   (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                         (next-ust (if (and (integer? off) (< off 0))
                                                       (x86-int-remove off unread-stores)
                                                       unread-stores)))
                                     (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                               (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                                 (and next-neg
                                      (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info)))))))
                    ((eq? op '%load-typed)
                     (let ((dst (caddr inst))
                           (base (cadddr inst))
                           (off (car (cddddr inst))))
                       (if (x86-rsp-sym? dst)
                           #f
                           (if (x86-rsp-sym? base)
                               (if (not (x86-safe-rsp-offset? off))
                                   #f
                                   (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                         (next-ust (if (and (integer? off) (< off 0))
                                                       (x86-int-remove off unread-stores)
                                                       unread-stores)))
                                     (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                               (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                                 (and next-neg
                                      (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info)))))))
                    ((memq op '(%store %store-byte))
                     (let ((base (cadr inst))
                           (off (caddr inst))
                           (src (cadddr inst)))
                       (if (x86-rsp-sym? base)
                           (if (or (not (x86-safe-rsp-offset? off))
                                   (x86-tree-has-rsp-or-stack? src))
                               #f
                               (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                     (next-ust (if (and (integer? off) (< off 0) (not (x86-int-memq? off unread-stores)))
                                                   (cons off unread-stores)
                                                   unread-stores)))
                                 (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                           (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                             (and next-neg
                                  (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))))
                    ((eq? op '%store-typed)
                     (let ((base (caddr inst))
                           (off (cadddr inst))
                           (src (car (cddddr inst))))
                       (if (x86-rsp-sym? base)
                           (if (or (not (x86-safe-rsp-offset? off))
                                   (x86-tree-has-rsp-or-stack? src))
                               #f
                               (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                     (next-ust (if (and (integer? off) (< off 0) (not (x86-int-memq? off unread-stores)))
                                                   (cons off unread-stores)
                                                   unread-stores)))
                                 (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                           (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                             (and next-neg
                                  (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))))
                    (else
                     (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                       (and next-neg
                            (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))))))))))

(define (x86-hoist-rsp-disp disp)
  (+ disp (car *x86-c-tu-hoist-frame*)))

(define (x86-hoist-mem-offset base offset)
  (let ((f (car *x86-c-tu-hoist-frame*)))
    (if (and (> f 0) (x86-rsp-sym? base))
        (cond
          ((integer? offset) (+ offset f))
          ((and (pair? offset) (eq? (car offset) '%sib) (= (length offset) 4) (integer? (cadddr offset)))
           (list '%sib (cadr offset) (caddr offset) (+ (cadddr offset) f)))
          (else offset))
        offset)))

(define (x86-hoist-opnd opnd)
  (let ((f (car *x86-c-tu-hoist-frame*)))
    (if (and (> f 0) (pair? opnd))
        (case (car opnd)
          ((%stack)
           (if (and (= (length opnd) 2) (integer? (cadr opnd)))
               (list '%stack (+ (cadr opnd) f))
               opnd))
          ((%disp)
           (if (and (= (length opnd) 3) (integer? (cadr opnd)) (x86-rsp-sym? (caddr opnd)))
               (list '%disp (+ (cadr opnd) f) (caddr opnd))
               opnd))
          ((%mem)
           (if (and (= (length opnd) 3) (x86-rsp-sym? (cadr opnd)) (integer? (caddr opnd)))
               (list '%mem (cadr opnd) (+ (caddr opnd) f))
               opnd))
          (else opnd))
        opnd)))

(define (hoist-operand->str opnd)
  (operand->str (x86-hoist-opnd opnd)))

(define (x86-call-frame-adjustments frame-shift)
  (let ((hoist-f (car *x86-c-tu-hoist-frame*)))
    (if (> hoist-f 0)
        (let* ((ord (car *x86-c-tu-call-ordinal*))
               (deltas (car *x86-c-tu-delta-calls*))
               (need-delta? (and (pair? deltas)
                                 (< frame-shift hoist-f)
                                 (x86-int-memq? ord deltas))))
          (set-car! *x86-c-tu-call-ordinal* (+ ord 1))
          (if need-delta?
              (let ((delta (- hoist-f frame-shift)))
                (cons (list (list 'add 'rsp (list '%imm delta)))
                      (list (list 'sub 'rsp (list '%imm delta)))))
              (cons '() '())))
        (if (> frame-shift 0)
            (let ((shift-str (small-int->string frame-shift)))
              (cons (list (list '%raw-asm (string-append "    sub rsp, " shift-str)))
                    (list (list '%raw-asm (string-append "    add rsp, " shift-str)))))
            (cons '() '())))))

(define (reset-x86-switch-tables!)
  (set-car! *x86-switch-jump-tables* '())
  (set-car! *x86-switch-jt-counter* 0))

(define (next-x86-switch-jt-id!)
  (let ((n (car *x86-switch-jt-counter*)))
    (set-car! *x86-switch-jt-counter* (+ n 1))
    n))

(define (x86-switch-imm32? v)
  (and (integer? v) (>= v -2147483648) (<= v 2147483647)))

(define (x86-switch-emit-cmp-r10 v)
  (if (x86-switch-imm32? v)
      (list (list '%raw-asm (string-append "    cmp r10, " (number->string v))))
      (let ((op-str (if (integer? v) (number->string v) (operand->str v))))
        (list (list '%raw-asm (string-append "    mov r11, " op-str))
              (list '%raw-asm "    cmp r10, r11")))))

(define (x86-switch-target-lbl base-lbl args-list trampolines-box)
  (if (null? args-list)
      base-lbl
      (let ((t-lbl (unique-label-sym "L_sw_tramp_")))
        (set-car! trampolines-box (cons (list t-lbl base-lbl args-list) (car trampolines-box)))
        t-lbl)))

(define (x86-switch-emit-trampolines trampolines)
  (if (null? trampolines)
      '()
      (backend-concat
       (map (lambda (tr)
              (let ((t-lbl (car tr))
                    (base-lbl (cadr tr))
                    (args (caddr tr)))
                (backend-concat
                 (list (list (list '%label t-lbl))
                       (select-x86-parallel-copy base-lbl args)
                       (list (list 'jmp (lower-lir-opnd base-lbl)))))))
            (reverse trampolines)))))

(define (x86-switch-merge-sorted a b)
  (let loop ((xs a) (ys b) (acc '()))
    (cond
      ((null? xs) (append (reverse acc) ys))
      ((null? ys) (append (reverse acc) xs))
      ((<= (caar xs) (caar ys)) (loop (cdr xs) ys (cons (car xs) acc)))
      (else (loop xs (cdr ys) (cons (car ys) acc))))))

(define (x86-switch-sort-cases cases)
  (let ((n (length cases)))
    (if (<= n 1)
        cases
        (let ((half (quotient n 2)))
          (let split ((xs cases) (k half) (left '()))
            (if (<= k 0)
                (x86-switch-merge-sorted (x86-switch-sort-cases (reverse left))
                                         (x86-switch-sort-cases xs))
                (split (cdr xs) (- k 1) (cons (car xs) left))))))))

(define (x86-switch-build-jt-entries min-v max-v sorted-cases def-target)
  (let loop ((cur min-v) (cs sorted-cases) (acc '()))
    (cond
      ((> cur max-v) (reverse acc))
      ((and (pair? cs) (< (caar cs) cur)) (loop cur (cdr cs) acc))
      ((and (pair? cs) (= (caar cs) cur))
       (loop (+ cur 1) (cdr cs) (cons (cdar cs) acc)))
      (else
       (loop (+ cur 1) cs (cons def-target acc))))))

(define (x86-switch-emit-bst vec lo hi def-target)
  (cond
    ((> lo hi)
     (list (list 'jmp (lower-lir-opnd def-target))))
    ((= lo hi)
     (let* ((p (vector-ref vec lo))
            (v (car p))
            (t (cdr p)))
       (append (x86-switch-emit-cmp-r10 v)
               (list (list 'jcc 'je t)
                     (list 'jmp (lower-lir-opnd def-target))))))
    ((= (+ lo 1) hi)
     (let* ((p0 (vector-ref vec lo))
            (p1 (vector-ref vec hi)))
       (append (x86-switch-emit-cmp-r10 (car p0))
               (append (list (list 'jcc 'je (cdr p0)))
                       (append (x86-switch-emit-cmp-r10 (car p1))
                               (list (list 'jcc 'je (cdr p1))
                                     (list 'jmp (lower-lir-opnd def-target))))))))
    (else
     (let* ((mid (quotient (+ lo hi) 2))
            (p (vector-ref vec mid))
            (v (car p))
            (t (cdr p))
            (left-lbl (unique-label-sym "L_sw_bst_l_")))
       (backend-concat
        (list (x86-switch-emit-cmp-r10 v)
              (list (list 'jcc 'je t)
                    (list 'jcc 'jl left-lbl))
              (x86-switch-emit-bst vec (+ mid 1) hi def-target)
              (list (list '%label left-lbl))
              (x86-switch-emit-bst vec lo (- mid 1) def-target)))))))

(define (emit-x86-switch-jump-tables!)
  (let ((jts (reverse (car *x86-switch-jump-tables*))))
    (if (pair? jts)
        (begin
          (emit "    .section .rodata")
          (emit "    .p2align 2")
          (for-each
           (lambda (jt)
             (let* ((jt-lbl (asm-label->str (list-ref jt 0)))
                    (base-lbl (asm-label->str (list-ref jt 1)))
                    (targets (list-ref jt 2)))
               (emit (string-append jt-lbl ":"))
               (for-each
                (lambda (t)
                  (emit (string-append "    .long " (asm-label->str t) " - " base-lbl)))
                targets)))
           jts)))))

(define (c99-collect-lir-globals prog)
  (let ((seen-box (cons '() '())))
    (let ((add-var! (lambda (v)
                      (if (not (memq v (car seen-box)))
                          (set-car! seen-box (cons v (car seen-box)))))))
      (let ((scan-insts
             (lambda (insts)
               (for-each (lambda (inst)
                           (if (pair? inst)
                               (case (car inst)
                                 ((%global-ref) (add-var! (caddr inst)))
                                 ((%global-set!) (add-var! (cadr inst))))))
                         insts)))
            (funcs-clause (assq '%lir-functions (cdr prog)))
            (main-clause (assq '%lir-main (cdr prog))))
        (if funcs-clause
            (for-each (lambda (fn)
                        (let ((b (assq 'body (cddr fn))))
                          (if b (scan-insts (cdr b)))))
                      (cdr funcs-clause)))
        (if main-clause
            (let ((b (assq 'body (cdr main-clause))))
              (if b (scan-insts (cdr b)))))
        (reverse (car seen-box))))))

(define (c99-extract-global-init-insts main-body)
  (let loop ((xs main-body) (idx 0) (last-set -1))
    (if (null? xs)
        (if (< last-set 0)
            '()
            (let take ((ys main-body) (k (+ last-set 1)) (acc '()))
              (if (or (<= k 0) (null? ys))
                  (reverse acc)
                  (take (cdr ys) (- k 1) (cons (car ys) acc)))))
        (let ((inst (car xs)))
          (loop (cdr xs)
                (+ idx 1)
                (if (and (pair? inst)
                         (memq (car inst) '(%global-set! %store %store-typed %direct-jump %label)))
                    idx
                    last-set))))))

(define (new-alloc-id!)
  (let ((cnt (+ (car *alloc-counter*) 1)))
    (set-car! *alloc-counter* cnt)
    cnt))

(define (reset-x86-block-params!)
  (set-car! *x86-block-params* '()))

(define (record-x86-block-params! lbl params)
  (let ((entry (assq lbl (car *x86-block-params*))))
    (if entry
        (set-cdr! entry params)
        (set-car! *x86-block-params* (cons (cons lbl params) (car *x86-block-params*))))))

(define (get-x86-block-params lbl)
  (let ((entry (assq lbl (car *x86-block-params*))))
    (if entry (cdr entry) '())))

(define (scan-x86-blocks! insts)
  (reset-x86-block-params!)
  (for-each
   (lambda (inst)
     (if (and (pair? inst) (eq? (car inst) '%block))
         (let ((lbl (cadr inst))
               (params (caddr inst)))
           (record-x86-block-params! lbl params))))
   insts))

(define (x86-param-location idx param)
  (cond
    ((case param
       ((%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15
         rax rbx rcx rdx rsi rdi rbp rsp r8 r9 r10 r11 r12 r13 r14 r15)
        #t)
       (else #f))
     param)
    ((and (pair? param) (eq? (car param) '%reg))
     (cadr param))
    ((and (pair? param) (eq? (car param) '%stack)) param)
    (else
     (list '%stack (* -8 (+ idx 2))))))

(define (select-x86-parallel-copy target-lbl args)
  (let ((params (get-x86-block-params target-lbl)))
    (let loop ((ps params) (as args) (i 0) (acc '()))
      (if (and (pair? ps) (pair? as))
          (let* ((param (car ps))
                 (arg (car as))
                 (loc (x86-param-location i param)))
            (cond
              ((equal? loc arg)
               (loop (cdr ps) (cdr as) (+ i 1) acc))
              ((or (eq? loc '%rax) (eq? loc 'rax))
               (loop (cdr ps) (cdr as) (+ i 1)
                     (cons (list 'mov 'rax (lower-lir-opnd arg)) acc)))
              ((and (pair? loc) (eq? (car loc) '%stack))
               (let ((stk-disp (list '%disp (x86-hoist-rsp-disp (cadr loc)) 'rsp)))
                 (cond
                   ((pair? arg)
                    (loop (cdr ps) (cdr as) (+ i 1)
                          (cons (list 'mov stk-disp 'r10)
                                (cons (list 'mov 'r10 (lower-lir-opnd arg)) acc))))
                   ((integer? arg)
                    (loop (cdr ps) (cdr as) (+ i 1)
                          (cons (list '%raw-asm (string-append "    mov qword ptr " (hoist-operand->str loc) ", " (number->string arg))) acc)))
                   (else
                    (loop (cdr ps) (cdr as) (+ i 1)
                          (cons (list 'mov stk-disp (lower-lir-opnd arg)) acc))))))
              (else
               (loop (cdr ps) (cdr as) (+ i 1)
                     (cons (list 'mov (lower-lir-opnd loc) (lower-lir-opnd arg)) acc)))))
          (reverse acc)))))

(define (emit-x86-parallel-copy target-lbl args)
  (for-each emit-x86-asm-inst (select-x86-parallel-copy target-lbl args)))

;;; -----------------------------------------------------------------------
;;; Stage 1: Instruction Selection (LIR -> L_asm_x86 AST)
;;; -----------------------------------------------------------------------

(define (lower-lir-reg r)
  (case r
    ((%rax) 'rax) ((%rbx) 'rbx) ((%rcx) 'rcx) ((%rdx) 'rdx)
    ((%rsi) 'rsi) ((%rdi) 'rdi) ((%rbp) 'rbp) ((%rsp) 'rsp)
    ((%r8)  'r8)  ((%r9)  'r9)  ((%r10) 'r10) ((%r11) 'r11)
    ((%r12) 'r12) ((%r13) 'r13) ((%r14) 'r14) ((%r15) 'r15)
    ((%al)  'al)
    (else r)))

(define (lower-lir-opnd opnd)
  (cond
    ((symbol? opnd)
     (lower-lir-reg opnd))
    ((integer? opnd)
     (list '%imm opnd))
    ((pair? opnd)
     (let ((tag (car opnd)))
       (case tag
         ((%reg)
          (lower-lir-reg (cadr opnd)))
         ((%stack)
          (list '%disp (x86-hoist-rsp-disp (cadr opnd)) 'rsp))
         ((%disp)
          (if (x86-rsp-sym? (caddr opnd))
              (list '%disp (x86-hoist-rsp-disp (cadr opnd)) (lower-lir-reg (caddr opnd)))
              opnd))
         ((%imm)
          opnd)
         ((%mem)
          (let ((b (lower-lir-reg (cadr opnd))))
            (list '%disp (x86-hoist-mem-offset b (caddr opnd)) b)))
         (else
          opnd))))
    (else opnd)))

(define (canonical-x86-cc cond-op)
  (cond
    ((string? cond-op) (string->symbol cond-op))
    ((eq? cond-op 'equal) 'je)
    ((eq? cond-op 'not-equal) 'jne)
    ((eq? cond-op 'less) 'jl)
    ((eq? cond-op 'less-equal) 'jle)
    ((eq? cond-op 'greater) 'jg)
    ((eq? cond-op 'greater-equal) 'jge)
    ((eq? cond-op 'zero) 'je)
    ((eq? cond-op 'not-zero) 'jne)
    ((symbol? cond-op) cond-op)
    (else 'je)))

(define (lower-lir-instruction inst)
  (let ((op (car inst)))
    (case op
      ((%loc)
       (list (list '%loc (cadr inst) (caddr inst) (cadddr inst))))

      ((%label)
       (let ((lbl (cadr inst)))
         (if (eq? (car *backend-gc-mode*) 'c-tu)
             (list (list '%label lbl))
             (list (list '%p2align 4)
                   (list '%label lbl)))))

      ((%block)
       (let ((lbl (cadr inst))
             (params (caddr inst))
             (body (cdddr inst)))
         (record-x86-block-params! lbl params)
         (let loop ((rest body)
                    (acc (if (eq? (car *backend-gc-mode*) 'c-tu)
                             (list (list '%label lbl))
                             (list (list '%label lbl) (list '%p2align 4)))))
           (if (null? rest)
               (reverse acc)
               (let ((lowered (lower-lir-instruction (car rest))))
                 (loop (cdr rest) (append (reverse lowered) acc)))))))

      ((%jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (append (select-x86-parallel-copy lbl args)
                 (list (list 'jmp (lower-lir-opnd lbl))))))

      ((%jump-if-false)
       (let* ((reg (cadr inst))
              (lbl (caddr inst))
              (args (if (pair? (cdddr inst)) (cadddr inst) '())))
         (if (null? args)
             (list (list 'cmp (lower-lir-opnd reg) (list '%imm 47))
                   (list 'jcc 'je lbl))
             (let ((cont-lbl (unique-label-sym "L_cont_")))
               (backend-concat
                (list (list (list 'cmp (lower-lir-opnd reg) (list '%imm 47))
                            (list 'jcc 'jne cont-lbl))
                      (select-x86-parallel-copy lbl args)
                      (list (list 'jmp (lower-lir-opnd lbl))
                            (list '%label cont-lbl))))))))

      ((%jump-cond)
       (let* ((cond-op (cadr inst))
              (lbl (caddr inst)))
         (list (list 'jcc (canonical-x86-cc cond-op) lbl))))

      ((%jump-if)
       (let* ((reg (cadr inst))
              (then-lbl (caddr inst))
              (then-args (cadddr inst))
              (rest-else (cdr (cdddr inst)))
              (else-lbl (car rest-else))
              (else-args (cadr rest-else))
              (else-tramline (unique-label-sym "L_else_tramline_")))
         (backend-concat
          (list (list (list 'cmp (lower-lir-opnd reg) (list '%imm 47))
                      (list 'jcc 'je else-tramline))
                (if (pair? then-args) (select-x86-parallel-copy then-lbl then-args) '())
                (list (list 'jmp (lower-lir-opnd then-lbl))
                      (list '%label else-tramline))
                (if (pair? else-args) (select-x86-parallel-copy else-lbl else-args) '())
                (list (list 'jmp (lower-lir-opnd else-lbl)))))))

      ((%jump-if-zero)
       (let ((lbl (cadr inst)))
         (list (list 'jcc 'je lbl))))

      ((%direct-jump)
       (let* ((lbl (cadr inst))
              (args (if (pair? (cddr inst)) (caddr inst) '())))
         (append (if (pair? args) (select-x86-parallel-copy lbl args) '())
                 (list (list 'jmp (lower-lir-opnd lbl))))))

      ((%switch)
       ;; (%switch val def-lbl [def-args] cases)
       (let* ((val (cadr inst))
              (def-lbl (caddr inst))
              (has-def-args? (= (length inst) 5))
              (def-args (if (and has-def-args? (list? (cadddr inst))) (cadddr inst) '()))
              (raw-cases (cond (has-def-args? (car (cddddr inst)))
                               ((pair? (cdddr inst)) (cadddr inst))
                               (else '())))
              (trampolines-box (cons '() '()))
              (def-target (x86-switch-target-lbl def-lbl def-args trampolines-box))
              (norm-cases
               (map (lambda (c)
                      (let* ((c-val (car c))
                             (c-lbl (cadr c))
                             (c-args (if (and (pair? (cddr c)) (list? (caddr c))) (caddr c) '())))
                        (cons c-val (x86-switch-target-lbl c-lbl c-args trampolines-box))))
                    raw-cases))
              (n (length norm-cases))
              (all-ints? (let loop ((cs norm-cases))
                           (cond ((null? cs) #t)
                                 ((integer? (caar cs)) (loop (cdr cs)))
                                 (else #f))))
              (val-opnd (lower-lir-opnd val))
              (load-r10 (if (eq? val-opnd 'r10)
                            '()
                            (list (list '%raw-asm (string-append "    mov r10, " (hoist-operand->str val))))))
              (dispatch-insts
               (cond
                 ((= n 0)
                  (list (list 'jmp (lower-lir-opnd def-target))))
                 ((or (< n 8) (not all-ints?))
                  (let loop ((cs norm-cases) (acc '()))
                    (if (null? cs)
                        (backend-concat
                         (list load-r10
                               (backend-concat (reverse acc))
                               (list (list 'jmp (lower-lir-opnd def-target)))))
                        (let ((c-val (caar cs))
                              (c-tgt (cdar cs)))
                          (loop (cdr cs)
                                (cons (append (x86-switch-emit-cmp-r10 c-val)
                                              (list (list 'jcc 'je c-tgt)))
                                      acc))))))
                 (else
                  (let* ((sorted (x86-switch-sort-cases norm-cases))
                         (min-v (caar sorted))
                         (max-v (car (list-ref sorted (- n 1))))
                         (span (+ (- max-v min-v) 1)))
                    (if (and (<= span 4096) (<= span (* 2 n)))
                        ;; Tier 2: Dense PIE-safe .rodata PC-relative jump table O(1)
                        (let* ((id (next-x86-switch-jt-id!))
                               (jt-lbl (string->symbol (string-append ".L_jt_" (number->string id))))
                               (base-lbl (string->symbol (string-append ".L_jt_base_" (number->string id))))
                               (entries (x86-switch-build-jt-entries min-v max-v sorted def-target))
                               (sub-insts
                                (cond
                                  ((= min-v 0) '())
                                  ((and (> min-v 0) (<= min-v 2147483647))
                                   (list (list '%raw-asm (string-append "    sub r10, " (number->string min-v)))))
                                  ((and (< min-v 0) (<= (- 0 min-v) 2147483647))
                                   (list (list '%raw-asm (string-append "    add r10, " (number->string (- 0 min-v))))))
                                  (else
                                   (list (list '%raw-asm (string-append "    mov r11, " (number->string min-v)))
                                         (list '%raw-asm "    sub r10, r11")))))
                               (bounds-limit (- span 1)))
                          (set-car! *x86-switch-jump-tables*
                                    (cons (list jt-lbl base-lbl entries) (car *x86-switch-jump-tables*)))
                          (backend-concat
                           (list load-r10
                                 sub-insts
                                 (list (list '%raw-asm (string-append "    cmp r10, " (number->string bounds-limit)))
                                       (list 'jcc 'ja def-target)
                                       (list '%raw-asm (string-append "    lea r11, [rip + " (asm-label->str jt-lbl) "]"))
                                       (list '%raw-asm "    movsxd r10, dword ptr [r11 + r10*4]")
                                       (list '%raw-asm (string-append "    lea r11, [rip + " (asm-label->str base-lbl) "]"))
                                       (list '%raw-asm "    add r11, r10")
                                       (list '%raw-asm "    jmp r11")
                                       (list '%label base-lbl)))))
                        ;; Tier 3: Sparse large switch -> balanced Binary Search Tree O(log N)
                        (append load-r10
                                (x86-switch-emit-bst (list->vector sorted) 0 (- n 1) def-target)))))))
              (tramp-insts (x86-switch-emit-trampolines (car trampolines-box)))
              (switch-end (unique-label-sym "L_switch_end_")))
         (if (null? tramp-insts)
             dispatch-insts
             (backend-concat
              (list dispatch-insts
                    tramp-insts
                    (list (list '%label switch-end)))))))

      ((%return)
       (let ((f (car *x86-c-tu-hoist-frame*)))
         (if (> f 0)
             (list (list 'add 'rsp (list '%imm f))
                   (list 'ret))
             (list (list 'ret)))))

      ((%push)
       (let ((src (cadr inst)))
         (list (list 'push (lower-lir-opnd src)))))

      ((%pop)
       (let ((dst (cadr inst)))
         (list (list 'pop (lower-lir-opnd dst)))))

      ((%syscall)
       (if (pair? (cdr inst))
           (let ((si (cadr inst)))
             (list
              (list 'mov (lower-lir-opnd '%rax) (list '%disp si (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%rdi) (list '%disp (- si 8) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%rsi) (list '%disp (- si 16) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%rdx) (list '%disp (- si 24) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%r10) (list '%disp (- si 32) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%r8) (list '%disp (- si 40) (lower-lir-reg '%rsp)))
              (list 'mov (lower-lir-opnd '%r9) (list '%disp (- si 48) (lower-lir-reg '%rsp)))
              (list 'syscall)))
           (list (list 'syscall))))

      ((%memory-fence)
       (list (list '%raw-asm "    mfence")))

      ((%atomic-cas!)
       (let ((dst (cadr inst))
             (box (caddr inst))
             (new (cadddr inst)))
         (let ((cas-insts
                (list (list '%raw-asm (string-append "    lock cmpxchg qword ptr [" (reg->str box) " + 11], " (reg->str new)))
                      (list '%raw-asm "    sete al")
                      (list '%raw-asm "    movzx eax, al")
                      (list '%raw-asm "    shl rax, 6")
                      (list '%raw-asm "    add rax, 0x2F"))))
           (if (and (not (eq? (car *backend-gc-mode*) 'none))
                    (not (eq? (car *backend-gc-mode*) 'c-tu)))
               (append cas-insts
                       (list (list '%raw-asm "    mov r10, rax")
                             (list '%raw-asm (string-append "    lea rdx, [" (reg->str box) " + 11]"))
                             (list '%raw-asm (string-append "    mov rax, " (reg->str new)))
                             (list '%raw-asm "    sub rsp, 512")
                             (list '%raw-asm "    call ulisp_gc_write_barrier")
                             (list '%raw-asm "    add rsp, 512")
                             (list '%raw-asm "    mov rax, r10")))
               cas-insts))))

      ((%mov)
       (let ((dst (cadr inst))
             (src (caddr inst))
             (f (car *x86-c-tu-hoist-frame*)))
         (if (and (> f 0) (x86-rsp-sym? src))
             (list (list 'lea (lower-lir-opnd dst) (list '%disp f 'rsp)))
             (list (list 'mov (lower-lir-opnd dst) (lower-lir-opnd src))))))

      ((%load)
