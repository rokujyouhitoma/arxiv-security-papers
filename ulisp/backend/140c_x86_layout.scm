;;; =======================================================================
;;; ULisp Compiler Pass 140c: Native x86-64 Block Layout, Hoisting & Switch
;;; Extracted from 140_backend_x86_64.scm (Issue #968).
;;; =======================================================================

(define (x86-align-frame-16k+8 n)
  (let* ((base (if (< n 8) 8 n))
         (rem (modulo base 16)))
    (cond
      ((= rem 8) base)
      ((< rem 8) (+ base (- 8 rem)))
      (else (+ base (- 24 rem))))))

(define (x86-int-memq? x xs)
  (let loop ((cur xs))
    (cond
      ((null? cur) #f)
      ((and (integer? (car cur)) (= x (car cur))) #t)
      (else (loop (cdr cur))))))

(define (x86-int-remove x xs)
  (let loop ((cur xs) (acc '()))
    (cond
      ((null? cur) (reverse acc))
      ((and (integer? (car cur)) (= x (car cur))) (loop (cdr cur) acc))
      (else (loop (cdr cur) (cons (car cur) acc))))))

(define (x86-rsp-sym? x)
  (or (eq? x '%rsp)
      (eq? x 'rsp)
      (and (pair? x) (eq? (car x) '%reg) (pair? (cdr x))
           (or (eq? (cadr x) '%rsp) (eq? (cadr x) 'rsp)))))

(define (x86-safe-non-rsp-gpr? x)
  (let ((r (if (and (pair? x) (eq? (car x) '%reg) (pair? (cdr x)))
               (cadr x)
               x)))
    (and (symbol? r)
         (case r
           ((%rax rax %rbx rbx %rcx rcx %rdx rdx
             %rsi rsi %rdi rdi %rbp rbp
             %r8 r8 %r9 r9 %r10 r10 %r11 r11
             %r12 r12 %r13 r13 %r14 r14 %r15 r15)
            #t)
           (else #f)))))

(define (x86-tree-has-rsp-or-stack? x)
  (cond
    ((or (eq? x '%rsp) (eq? x 'rsp) (eq? x '%stack)) #t)
    ((pair? x) (or (x86-tree-has-rsp-or-stack? (car x))
                   (x86-tree-has-rsp-or-stack? (cdr x))))
    (else #f)))

(define (x86-safe-rsp-offset? off)
  (or (integer? off)
      (and (pair? off)
           (eq? (car off) '%sib)
           (= (length off) 4)
           (not (x86-rsp-sym? (cadr off)))
           (integer? (cadddr off)))))

(define (x86-rsp-offset-neg-depth off)
  (cond
    ((and (integer? off) (< off 0)) (- 0 off))
    ((and (pair? off) (eq? (car off) '%sib) (= (length off) 4) (integer? (cadddr off)) (< (cadddr off) 0))
     (- 0 (cadddr off)))
    (else 0)))

(define (x86-scan-safe-stack-opnds x cur-max)
  (cond
    ((not cur-max) #f)
    ((not (x86-tree-has-rsp-or-stack? x)) cur-max)
    ((or (eq? x '%rsp) (eq? x 'rsp) (eq? x '%stack)) #f)
    ((pair? x)
     (cond
       ((eq? (car x) '%stack)
        (if (and (= (length x) 2) (integer? (cadr x)))
            (let ((off (cadr x)))
              (if (< off 0) (max cur-max (- 0 off)) cur-max))
            #f))
       ((eq? (car x) '%disp)
        (if (and (= (length x) 3) (integer? (cadr x)) (x86-rsp-sym? (caddr x)))
            (let ((off (cadr x)))
              (if (< off 0) (max cur-max (- 0 off)) cur-max))
            (and (= (length x) 3)
                 (not (x86-tree-has-rsp-or-stack? (cadr x)))
                 (not (x86-tree-has-rsp-or-stack? (caddr x)))
                 cur-max)))
       ((eq? (car x) '%mem)
        (if (and (= (length x) 3) (x86-rsp-sym? (cadr x)) (integer? (caddr x)))
            (let ((off (caddr x)))
              (if (< off 0) (max cur-max (- 0 off)) cur-max))
            (and (= (length x) 3)
                 (not (x86-tree-has-rsp-or-stack? (cadr x)))
                 (not (x86-tree-has-rsp-or-stack? (caddr x)))
                 cur-max)))
       (else
        (let ((left (x86-scan-safe-stack-opnds (car x) cur-max)))
          (and left (x86-scan-safe-stack-opnds (cdr x) left))))))
    (else cur-max)))

(define (x86-flatten-lir-body body)
  (let loop ((xs body) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((inst (car xs)))
          (if (and (pair? inst) (eq? (car inst) '%block))
              (let ((lbl (cadr inst))
                    (b-insts (cdddr inst)))
                (let bloop ((bs b-insts) (acc1 (cons (list '%label lbl) acc)))
                  (if (null? bs)
                      (loop (cdr xs) acc1)
                      (bloop (cdr bs) (cons (car bs) acc1)))))
              (loop (cdr xs) (cons inst acc)))))))

(define (x86-collect-local-labels flat)
  (let loop ((xs flat) (lbls '()))
    (if (null? xs)
        lbls
        (let ((inst (car xs)))
          (if (and (pair? inst) (eq? (car inst) '%label))
              (loop (cdr xs) (cons (cadr inst) lbls))
              (loop (cdr xs) lbls))))))

(define (c-tu-analyze-hoist-frame body)
  (let* ((flat (x86-flatten-lir-body body))
         (local-lbls (x86-collect-local-labels flat)))
    (let loop ((xs flat)
               (call-ord 0)
               (max-call-shift 0)
               (max-neg 0)
               (unread-stores '())
               (rsp-addr-offs '())
               (calls-info '()))
      (if (null? xs)
          (if (or (= call-ord 0) (<= max-call-shift 0))
              #f
              (let* ((hoist-f (x86-align-frame-16k+8 (max max-call-shift max-neg)))
                     (deltas
                      (let dloop ((cs calls-info) (acc '()))
                        (if (null? cs)
                            (reverse acc)
                            (let* ((c (car cs))
                                   (ord (list-ref c 0))
                                   (sh (list-ref c 1))
                                   (ust (list-ref c 2))
                                   (raos (list-ref c 3))
                                   (neg-sh (- 0 sh)))
                              (if (and (< sh hoist-f)
                                       (or (x86-int-memq? neg-sh ust)
                                           (x86-int-memq? neg-sh raos)
                                           (memq 'any raos)))
                                  (dloop (cdr cs) (cons ord acc))
                                  (dloop (cdr cs) acc)))))))
                (cons hoist-f deltas)))
          (let ((inst (car xs))
                (rest (cdr xs)))
            (if (not (pair? inst))
                #f
                (let ((op (car inst)))
                  (cond
                    ((memq op '(%inline-asm %push %pop %alloc %alloc-stack
                                %managed-alloc %managed-alloc-stack %syscall
                                %capture-cc %push-handler %pop-handler %raise
                                %store-values-buf %dispatch-consumer %call-closure
                                %atomic-cas!))
                     #f)
                    ((memq op '(%jump %direct-jump))
                     (let* ((lbl (cadr inst))
                            (args (if (and (pair? (cddr inst)) (list? (caddr inst))) (caddr inst) '()))
                            (next-neg (x86-scan-safe-stack-opnds args max-neg)))
                       (if (or (not (memq lbl local-lbls)) (not next-neg))
                           #f
                           (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))
                    ((memq op '(%direct-call %c-call %call-foreign %call-indirect))
                     (let ((sh (and (pair? (cddr inst)) (caddr inst))))
                       (if (or (not (integer? sh)) (<= sh 0) (not (= (modulo sh 16) 8)))
                           #f
                           (loop rest
                                 (+ call-ord 1)
                                 (max max-call-shift sh)
                                 max-neg
                                 '()
                                 '()
                                 (cons (list call-ord sh unread-stores rsp-addr-offs) calls-info)))))
                    ((eq? op '%mov)
                     (let ((dst (cadr inst))
                           (src (caddr inst)))
                       (cond
                         ((x86-rsp-sym? dst) #f)
                         ((x86-rsp-sym? src)
                          (if (not (x86-safe-non-rsp-gpr? dst))
                              #f
                              (let* ((nxt (if (pair? rest) (car rest) #f))
                                     (nxt-int (and (pair? nxt)
                                                   (memq (car nxt) '(%add %raw-add))
                                                   (= (length nxt) 3)
                                                   (equal? (cadr nxt) dst)
                                                   (integer? (caddr nxt))
                                                   (caddr nxt)))
                                     (next-neg (if (and nxt-int (< nxt-int 0))
                                                   (max max-neg (- 0 nxt-int))
                                                   max-neg))
                                     (next-raos (if nxt-int
                                                    (cons nxt-int rsp-addr-offs)
                                                    (cons 'any rsp-addr-offs))))
                                (loop rest call-ord max-call-shift next-neg unread-stores next-raos calls-info))))
                         (else
                          (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                            (and next-neg
                                 (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info)))))))
                    ((memq op '(%load %load-byte-zx))
                     (let ((dst (cadr inst))
                           (base (caddr inst))
                           (off (cadddr inst)))
                       (if (x86-rsp-sym? dst)
                           #f
                           (if (x86-rsp-sym? base)
                               (if (not (x86-safe-rsp-offset? off))
                                   #f
                                   (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                         (next-ust (if (and (integer? off) (< off 0))
                                                       (x86-int-remove off unread-stores)
                                                       unread-stores)))
                                     (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                               (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                                 (and next-neg
                                      (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info)))))))
                    ((eq? op '%load-typed)
                     (let ((dst (caddr inst))
                           (base (cadddr inst))
                           (off (car (cddddr inst))))
                       (if (x86-rsp-sym? dst)
                           #f
                           (if (x86-rsp-sym? base)
                               (if (not (x86-safe-rsp-offset? off))
                                   #f
                                   (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                         (next-ust (if (and (integer? off) (< off 0))
                                                       (x86-int-remove off unread-stores)
                                                       unread-stores)))
                                     (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                               (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                                 (and next-neg
                                      (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info)))))))
                    ((memq op '(%store %store-byte))
                     (let ((base (cadr inst))
                           (off (caddr inst))
                           (src (cadddr inst)))
                       (if (x86-rsp-sym? base)
                           (if (or (not (x86-safe-rsp-offset? off))
                                   (x86-tree-has-rsp-or-stack? src))
                               #f
                               (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                     (next-ust (if (and (integer? off) (< off 0) (not (x86-int-memq? off unread-stores)))
                                                   (cons off unread-stores)
                                                   unread-stores)))
                                 (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                           (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                             (and next-neg
                                  (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))))
                    ((eq? op '%store-typed)
                     (let ((base (caddr inst))
                           (off (cadddr inst))
                           (src (car (cddddr inst))))
                       (if (x86-rsp-sym? base)
                           (if (or (not (x86-safe-rsp-offset? off))
                                   (x86-tree-has-rsp-or-stack? src))
                               #f
                               (let ((next-neg (max max-neg (x86-rsp-offset-neg-depth off)))
                                     (next-ust (if (and (integer? off) (< off 0) (not (x86-int-memq? off unread-stores)))
                                                   (cons off unread-stores)
                                                   unread-stores)))
                                 (loop rest call-ord max-call-shift next-neg next-ust rsp-addr-offs calls-info)))
                           (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                             (and next-neg
                                  (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))))
                    (else
                     (let ((next-neg (x86-scan-safe-stack-opnds (cdr inst) max-neg)))
                       (and next-neg
                            (loop rest call-ord max-call-shift next-neg unread-stores rsp-addr-offs calls-info))))))))))))

(define (x86-hoist-rsp-disp disp)
  (+ disp (car *x86-c-tu-hoist-frame*)))

(define (x86-hoist-mem-offset base offset)
  (let ((f (car *x86-c-tu-hoist-frame*)))
    (if (and (> f 0) (x86-rsp-sym? base))
        (cond
          ((integer? offset) (+ offset f))
          ((and (pair? offset) (eq? (car offset) '%sib) (= (length offset) 4) (integer? (cadddr offset)))
           (list '%sib (cadr offset) (caddr offset) (+ (cadddr offset) f)))
          (else offset))
        offset)))

(define (x86-hoist-opnd opnd)
  (let ((f (car *x86-c-tu-hoist-frame*)))
    (if (and (> f 0) (pair? opnd))
        (case (car opnd)
          ((%stack)
           (if (and (= (length opnd) 2) (integer? (cadr opnd)))
               (list '%stack (+ (cadr opnd) f))
               opnd))
          ((%disp)
           (if (and (= (length opnd) 3) (integer? (cadr opnd)) (x86-rsp-sym? (caddr opnd)))
               (list '%disp (+ (cadr opnd) f) (caddr opnd))
               opnd))
          ((%mem)
           (if (and (= (length opnd) 3) (x86-rsp-sym? (cadr opnd)) (integer? (caddr opnd)))
               (list '%mem (cadr opnd) (+ (caddr opnd) f))
               opnd))
          (else opnd))
        opnd)))

(define (hoist-operand->str opnd)
  (operand->str (x86-hoist-opnd opnd)))

(define (x86-call-frame-adjustments frame-shift)
  (let ((hoist-f (car *x86-c-tu-hoist-frame*)))
    (if (> hoist-f 0)
        (let* ((ord (car *x86-c-tu-call-ordinal*))
               (deltas (car *x86-c-tu-delta-calls*))
               (need-delta? (and (pair? deltas)
                                 (< frame-shift hoist-f)
                                 (x86-int-memq? ord deltas))))
          (set-car! *x86-c-tu-call-ordinal* (+ ord 1))
          (if need-delta?
              (let ((delta (- hoist-f frame-shift)))
                (cons (list (list 'add 'rsp (list '%imm delta)))
                      (list (list 'sub 'rsp (list '%imm delta)))))
              (cons '() '())))
        (if (> frame-shift 0)
            (let ((shift-str (small-int->string frame-shift)))
              (cons (list (list '%raw-asm (string-append "    sub rsp, " shift-str)))
                    (list (list '%raw-asm (string-append "    add rsp, " shift-str)))))
            (cons '() '())))))

(define (reset-x86-switch-tables!)
  (set-car! *x86-switch-jump-tables* '())
  (set-car! *x86-switch-jt-counter* 0))

(define (next-x86-switch-jt-id!)
  (let ((n (car *x86-switch-jt-counter*)))
    (set-car! *x86-switch-jt-counter* (+ n 1))
    n))

(define (x86-switch-imm32? v)
  (and (integer? v) (>= v -2147483648) (<= v 2147483647)))

(define (x86-switch-emit-cmp-r10 v)
  (if (x86-switch-imm32? v)
      (list (list '%raw-asm (string-append "    cmp r10, " (number->string v))))
      (let ((op-str (if (integer? v) (number->string v) (operand->str v))))
        (list (list '%raw-asm (string-append "    mov r11, " op-str))
              (list '%raw-asm "    cmp r10, r11")))))

(define (x86-switch-target-lbl base-lbl args-list trampolines-box)
  (if (null? args-list)
      base-lbl
      (let ((t-lbl (unique-label-sym "L_sw_tramp_")))
        (set-car! trampolines-box (cons (list t-lbl base-lbl args-list) (car trampolines-box)))
        t-lbl)))

(define (x86-switch-emit-trampolines trampolines)
  (if (null? trampolines)
      '()
      (backend-concat
       (map (lambda (tr)
              (let ((t-lbl (car tr))
                    (base-lbl (cadr tr))
                    (args (caddr tr)))
                (backend-concat
                 (list (list (list '%label t-lbl))
                       (select-x86-parallel-copy base-lbl args)
                       (list (list 'jmp (lower-lir-opnd base-lbl)))))))
            (reverse trampolines)))))

(define (x86-switch-merge-sorted a b)
  (let loop ((xs a) (ys b) (acc '()))
    (cond
      ((null? xs) (append (reverse acc) ys))
      ((null? ys) (append (reverse acc) xs))
      ((<= (caar xs) (caar ys)) (loop (cdr xs) ys (cons (car xs) acc)))
      (else (loop xs (cdr ys) (cons (car ys) acc))))))

(define (x86-switch-sort-cases cases)
  (let ((n (length cases)))
    (if (<= n 1)
        cases
        (let ((half (quotient n 2)))
          (let split ((xs cases) (k half) (left '()))
            (if (<= k 0)
                (x86-switch-merge-sorted (x86-switch-sort-cases (reverse left))
                                         (x86-switch-sort-cases xs))
                (split (cdr xs) (- k 1) (cons (car xs) left))))))))

(define (x86-switch-build-jt-entries min-v max-v sorted-cases def-target)
  (let loop ((cur min-v) (cs sorted-cases) (acc '()))
    (cond
      ((> cur max-v) (reverse acc))
      ((and (pair? cs) (< (caar cs) cur)) (loop cur (cdr cs) acc))
      ((and (pair? cs) (= (caar cs) cur))
       (loop (+ cur 1) (cdr cs) (cons (cdar cs) acc)))
      (else
       (loop (+ cur 1) cs (cons def-target acc))))))

(define (x86-switch-emit-bst vec lo hi def-target)
  (cond
    ((> lo hi)
     (list (list 'jmp (lower-lir-opnd def-target))))
    ((= lo hi)
     (let* ((p (vector-ref vec lo))
            (v (car p))
            (t (cdr p)))
       (append (x86-switch-emit-cmp-r10 v)
               (list (list 'jcc 'je t)
                     (list 'jmp (lower-lir-opnd def-target))))))
    ((= (+ lo 1) hi)
     (let* ((p0 (vector-ref vec lo))
            (p1 (vector-ref vec hi)))
       (append (x86-switch-emit-cmp-r10 (car p0))
               (append (list (list 'jcc 'je (cdr p0)))
                       (append (x86-switch-emit-cmp-r10 (car p1))
                               (list (list 'jcc 'je (cdr p1))
                                     (list 'jmp (lower-lir-opnd def-target))))))))
    (else
     (let* ((mid (quotient (+ lo hi) 2))
            (p (vector-ref vec mid))
            (v (car p))
            (t (cdr p))
            (left-lbl (unique-label-sym "L_sw_bst_l_")))
       (backend-concat
        (list (x86-switch-emit-cmp-r10 v)
              (list (list 'jcc 'je t)
                    (list 'jcc 'jl left-lbl))
              (x86-switch-emit-bst vec (+ mid 1) hi def-target)
              (list (list '%label left-lbl))
              (x86-switch-emit-bst vec lo (- mid 1) def-target)))))))

(define (emit-x86-switch-jump-tables!)
  (let ((jts (reverse (car *x86-switch-jump-tables*))))
    (if (pair? jts)
        (begin
          (emit "    .section .rodata")
          (emit "    .p2align 2")
          (for-each
           (lambda (jt)
             (let* ((jt-lbl (asm-label->str (list-ref jt 0)))
                    (base-lbl (asm-label->str (list-ref jt 1)))
                    (targets (list-ref jt 2)))
               (emit (string-append jt-lbl ":"))
               (for-each
                (lambda (t)
                  (emit (string-append "    .long " (asm-label->str t) " - " base-lbl)))
                targets)))
           jts)))))

(define (c99-collect-lir-globals prog)
  (let ((seen-box (cons '() '())))
    (let ((add-var! (lambda (v)
                      (if (not (memq v (car seen-box)))
                          (set-car! seen-box (cons v (car seen-box)))))))
      (let ((scan-insts
             (lambda (insts)
               (for-each (lambda (inst)
                           (if (pair? inst)
                               (case (car inst)
                                 ((%global-ref) (add-var! (caddr inst)))
                                 ((%global-set!) (add-var! (cadr inst))))))
                         insts)))
            (funcs-clause (assq '%lir-functions (cdr prog)))
            (main-clause (assq '%lir-main (cdr prog))))
        (if funcs-clause
            (for-each (lambda (fn)
                        (let ((b (assq 'body (cddr fn))))
                          (if b (scan-insts (cdr b)))))
                      (cdr funcs-clause)))
        (if main-clause
            (let ((b (assq 'body (cdr main-clause))))
              (if b (scan-insts (cdr b)))))
        (reverse (car seen-box))))))

(define (c99-extract-global-init-insts main-body)
  (let loop ((xs main-body) (idx 0) (last-set -1))
    (if (null? xs)
        (if (< last-set 0)
            '()
            (let take ((ys main-body) (k (+ last-set 1)) (acc '()))
              (if (or (<= k 0) (null? ys))
                  (reverse acc)
                  (take (cdr ys) (- k 1) (cons (car ys) acc)))))
        (let ((inst (car xs)))
          (loop (cdr xs)
                (+ idx 1)
                (if (and (pair? inst)
                         (memq (car inst) '(%global-set! %store %store-typed %direct-jump %label)))
                    idx
                    last-set))))))

(define (new-alloc-id!)
  (let ((cnt (+ (car *alloc-counter*) 1)))
    (set-car! *alloc-counter* cnt)
    cnt))

(define (reset-x86-block-params!)
  (set-car! *x86-block-params* '()))

(define (record-x86-block-params! lbl params)
  (let ((entry (assq lbl (car *x86-block-params*))))
    (if entry
        (set-cdr! entry params)
        (set-car! *x86-block-params* (cons (cons lbl params) (car *x86-block-params*))))))

(define (get-x86-block-params lbl)
  (let ((entry (assq lbl (car *x86-block-params*))))
    (if entry (cdr entry) '())))

(define (scan-x86-blocks! insts)
  (reset-x86-block-params!)
  (for-each
   (lambda (inst)
     (if (and (pair? inst) (eq? (car inst) '%block))
         (let ((lbl (cadr inst))
               (params (caddr inst)))
           (record-x86-block-params! lbl params))))
   insts))

(define (x86-param-location idx param)
  (cond
    ((case param
       ((%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15
         rax rbx rcx rdx rsi rdi rbp rsp r8 r9 r10 r11 r12 r13 r14 r15
         %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
         %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15
         xmm0 xmm1 xmm2 xmm3 xmm4 xmm5 xmm6 xmm7
         xmm8 xmm9 xmm10 xmm11 xmm12 xmm13 xmm14 xmm15)
        #t)
       (else #f))
     param)
    ((and (pair? param) (eq? (car param) '%reg))
     (if (and (pair? (cdr param)) (pair? (cddr param))) (caddr param) (cadr param)))
    ((and (pair? param) (eq? (car param) '%freg))
     (cadr param))
    ((and (pair? param) (eq? (car param) '%stack)) param)
    (else
     (list '%stack (* -8 (+ idx 2))))))

(define (select-x86-parallel-copy target-lbl args)
  (let* ((params (get-x86-block-params target-lbl))
         (pairs (let collect ((ps params) (as args) (i 0) (acc '()))
                  (if (and (pair? ps) (pair? as))
                      (collect (cdr ps) (cdr as) (+ i 1)
                               (cons (cons (x86-param-location i (car ps)) (car as)) acc))
                      (reverse acc))))
         (plan (lir-parallel-move-plan pairs *lir-pmov-gpr-scratch-pool* *lir-pmov-fpr-scratch-pool* #f)))
    (let emit-loop ((steps plan) (acc '()))
      (if (null? steps)
          (reverse acc)
          (let* ((step (car steps))
                 (dst (car step))
                 (src (cdr step)))
            (cond
              ((or (lir-pmov-float-loc? dst) (lir-pmov-float-loc? src))
               (cond
                 ((and (lir-pmov-float-loc? dst) (lir-pmov-float-loc? src))
                  (emit-loop (cdr steps)
                             (cons (list '%raw-asm (string-append "    movsd " (reg->str dst) ", " (reg->str src))) acc)))
                 ((lir-pmov-float-loc? dst)
                  (emit-loop (cdr steps)
                             (cons (list '%raw-asm (string-append "    movsd " (reg->str dst) ", qword ptr " (hoist-operand->str src))) acc)))
                 (else
                  (emit-loop (cdr steps)
                             (cons (list '%raw-asm (string-append "    movsd qword ptr " (hoist-operand->str dst) ", " (reg->str src))) acc)))))
              ((and (pair? dst) (eq? (car dst) '%stack))
               (let ((stk-disp (list '%disp (x86-hoist-rsp-disp (cadr dst)) 'rsp)))
                 (cond
                   ((pair? src)
                    (let ((mem-tmp (lower-lir-reg (lir-pmov-select-scratch *lir-pmov-gpr-scratch-pool* steps #f))))
                      (emit-loop (cdr steps)
                                 (cons (list 'mov stk-disp mem-tmp)
                                       (cons (list 'mov mem-tmp (lower-lir-opnd src)) acc)))))
                   ((integer? src)
                    (if (x86-switch-imm32? src)
                        (emit-loop (cdr steps)
                                   (cons (list '%raw-asm (string-append "    mov qword ptr " (hoist-operand->str dst) ", " (number->string src))) acc))
                        (let ((mem-tmp (lower-lir-reg (lir-pmov-select-scratch *lir-pmov-gpr-scratch-pool* steps #f))))
                          (emit-loop (cdr steps)
                                     (cons (list 'mov stk-disp mem-tmp)
                                           (cons (list 'mov mem-tmp (lower-lir-opnd src)) acc))))))
                   (else
                    (emit-loop (cdr steps)
                               (cons (list 'mov stk-disp (lower-lir-opnd src)) acc))))))
              (else
               (emit-loop (cdr steps)
                          (cons (list 'mov (lower-lir-opnd dst) (lower-lir-opnd src)) acc)))))))))

(define (emit-x86-parallel-copy target-lbl args)
  (for-each emit-x86-asm-inst (select-x86-parallel-copy target-lbl args)))

(define (has-dynamic-num-args? insts)
  (let loop ((is insts))
    (if (or (null? is) (not (pair? is)))
        #f
        (let ((i (car is)))
          (if (and (pair? i)
                   (or (and (eq? (car i) '%load)
                            (eq? (cadr i) '%rax)
                            (eq? (caddr i) '%rsp)
                            (pair? (cdddr i))
                            (= (cadddr i) -16))
                       (eq? (car i) '%num-args)))
              #t
              (loop (cdr is)))))))

(define (prepend-lowered-instructions is acc)
  (let loop ((cur is) (res acc))
    (if (null? cur)
        res
        (loop (cdr cur) (cons (car cur) res)))))

(define (select-instructions-function fn)
  (let* ((c-tu? (eq? (car *backend-gc-mode*) 'c-tu))
         (label (cadr fn))
         (label-str (asm-label->str label))
         (is-exported? (or (and c-tu? (%c99-exported-asm-label? label-str))
                           (string-starts-with? label-str "ulisp_fn_")))
         (frame-size-entry (assq 'frame-size (cddr fn)))
         (frame-size (if frame-size-entry (cadr frame-size-entry) 0))
         (params-entry (assq 'params (cddr fn)))
         (params (if params-entry (cadr params-entry) '()))
         (body (cdr (assq 'body (cddr fn))))
         (is-unboxed-fn? (or (unboxed-fn? label)
                             (and (string? label) (unboxed-fn? (string->symbol label)))))
         (hoist-plan (if (or c-tu? is-unboxed-fn?) (c-tu-analyze-hoist-frame body) #f))
         (hoist-f (if hoist-plan (car hoist-plan) 0))
         (delta-ords (if hoist-plan (cdr hoist-plan) '()))
         (out-frame-size (if (> hoist-f frame-size) hoist-f frame-size))
         (expected-args (if (and (not c-tu?)
                                 (not is-unboxed-fn?)
                                 (list? params)
                                 (not (has-dynamic-num-args? body)))
                            (length params)
                            #f)))
    (set-car! *inline-asm-frame-size* frame-size)
    (set-car! *x86-c-tu-hoist-frame* hoist-f)
    (set-car! *x86-c-tu-delta-calls* delta-ords)
    (set-car! *x86-c-tu-call-ordinal* 0)
    (set-car! *x86-cold-asm-insts* '())
    (scan-x86-blocks! body)
    (let* ((guard-insts
            (if expected-args
                (list (list 'jcc 'jne "ulisp_arity_error")
                      (list 'cmp 'rax (* expected-args 4)))
                '()))
           (init-acc (append guard-insts
                             (list (list '%label label)
                                   (list '%p2align 4))))
           (base-acc (if is-exported?
                         (if c-tu?
                             (if (or (memq label '(__ulisp_setjmp __ulisp_longjmp __ulisp_san_trap))
                                     (memq label (car *c-tu-weak-fns*)))
                                 (append init-acc
                                         (list (list '%raw-asm (string-append "    .type " label-str ", @function"))
                                               (list '%raw-asm (string-append "    .weak " label-str))
                                               (list '%raw-asm (string-append "    .globl " label-str))))
                                 (append init-acc
                                         (list (list '%raw-asm (string-append "    .type " label-str ", @function"))
                                               (list '%raw-asm (string-append "    .globl " label-str)))))
                             (append init-acc
                                     (list (list '%raw-asm (string-append "    .type " label-str ", @function"))
                                           (list '%raw-asm (string-append "    .weak " label-str))
                                           (list '%raw-asm (string-append "    .globl " label-str))
                                           (list '%raw-asm (string-append "    .section .text." label-str ",\"ax\",@progbits")))))
                         (if c-tu?
                             (append init-acc
                                     (list (list '%raw-asm (string-append "    .type " label-str ", @function"))))
                             (append init-acc
                                     (list (list '%raw-asm (string-append "    .section .text." label-str ",\"ax\",@progbits")))))))
           (hoist-base-acc (if (> hoist-f 0)
                               (cons (list 'sub 'rsp (list '%imm hoist-f)) base-acc)
                               base-acc)))
      (let loop ((rest body) (acc hoist-base-acc))
        (if (null? rest)
            (let* ((cold-raw (car *x86-cold-asm-insts*))
                   (cold-allocs (if (and (list? cold-raw) (pair? cold-raw))
                                    (backend-concat (reverse cold-raw))
                                    '()))
                   (hot-insts (reverse acc))
                   (final-insts (if (pair? cold-allocs)
                                    (append hot-insts cold-allocs)
                                    hot-insts)))
              (set-car! *x86-cold-asm-insts* #f)
              (set-car! *x86-c-tu-hoist-frame* 0)
              (set-car! *x86-c-tu-delta-calls* '())
              (set-car! *x86-c-tu-call-ordinal* 0)
              (list '%asm-function label (list 'frame-size out-frame-size) (cons 'body final-insts)))
            (let ((lowered (lower-lir-instruction (car rest))))
              (loop (cdr rest) (prepend-lowered-instructions lowered acc))))))))

(define (select-instructions-main main-clause)
  (let* ((c-tu? (eq? (car *backend-gc-mode*) 'c-tu))
         (frame-size-entry (assq 'frame-size (cdr main-clause)))
         (frame-size (if frame-size-entry (cadr frame-size-entry) 0))
         (raw-body (cdr (assq 'body (cdr main-clause))))
         (main-body (if c-tu? (c99-extract-global-init-insts raw-body) raw-body)))
    (set-car! *inline-asm-frame-size* frame-size)
    (set-car! *x86-c-tu-hoist-frame* 0)
    (set-car! *x86-c-tu-delta-calls* '())
    (set-car! *x86-c-tu-call-ordinal* 0)
    (set-car! *c-tu-has-init?* (and c-tu? (pair? main-body)))
    (set-car! *x86-cold-asm-insts* '())
    (scan-x86-blocks! main-body)
    (let loop ((rest main-body) (acc '()))
      (if (null? rest)
          (let* ((cold-raw (car *x86-cold-asm-insts*))
                 (cold-allocs (if (and (list? cold-raw) (pair? cold-raw))
                                  (backend-concat (reverse cold-raw))
                                  '()))
                 (base-body (if c-tu?
                                (if (null? main-body)
                                    '()
                                    (append (reverse acc) (list (list 'ret))))
                                (append (reverse acc)
                                        (if (module-mode?)
                                            (list (list 'add 'rsp 8)
                                                  (list 'ret))
                                            (list (list '%raw-asm "    lea r11, [rip + ulisp_final_r12]")
                                                  (list '%raw-asm "    mov [r11], r12")
                                                  (list 'add 'rsp 8)
                                                  (list 'pop 'r12)
                                                  (list 'ret))))))
                 (final-body (if (and (pair? base-body) (pair? cold-allocs))
                                 (append base-body cold-allocs)
                                 base-body)))
            (set-car! *x86-cold-asm-insts* #f)
            (list '%asm-main
                  (list 'frame-size frame-size)
                  (cons 'body final-body)))
          (let ((inst (car rest)))
            (if (eq? (car inst) '%return)
                (loop (cdr rest) acc)
                (let ((lowered (lower-lir-instruction inst)))
                  (loop (cdr rest) (prepend-lowered-instructions lowered acc)))))))))

(define (select-instructions-x86 prog)
  (reset-x86-switch-tables!)
  (set-car! *x86-cold-asm-insts* #f)
  (set-car! *x86-c-tu-hoist-frame* 0)
  (set-car! *x86-c-tu-delta-calls* '())
  (set-car! *x86-c-tu-call-ordinal* 0)
  (let* ((strings (assq 'strings (cdr prog)))
         (data-clause (assq 'data (cdr prog)))
         (stackmaps (assq 'stackmaps (cdr prog)))
         (weak-fns-clause (assq 'weak-fns (cdr prog)))
         (weak-data-clause (assq 'weak-data (cdr prog)))
         (aliases-clause (assq 'aliases (cdr prog)))
         (top-asm-clause (assq 'top-asm (cdr prog)))
         (funcs-clause (assq '%lir-functions (cdr prog)))
         (funcs (if funcs-clause (cdr funcs-clause) '()))
         (main-clause (assq '%lir-main (cdr prog))))
    (set-car! *c-tu-weak-fns* (if (and weak-fns-clause (pair? (cdr weak-fns-clause))) (cadr weak-fns-clause) '()))
    (set-car! *c-tu-weak-data* (if (and weak-data-clause (pair? (cdr weak-data-clause))) (cadr weak-data-clause) '()))
    (if (eq? (car *backend-gc-mode*) 'c-tu)
        (set-car! *c-tu-globals* (c99-collect-lir-globals prog))
        (set-car! *c-tu-globals* '()))
    (let* ((extra-clauses
            (append
             (if weak-fns-clause (list weak-fns-clause) '())
             (append
              (if weak-data-clause (list weak-data-clause) '())
              (append
               (if aliases-clause (list aliases-clause) '())
               (if top-asm-clause (list top-asm-clause) '())))))
           (res
            (if data-clause
                (append
                 (list '%asm-program
                       (if strings strings '(strings ()))
                       data-clause
                       (if stackmaps stackmaps '(stackmaps ()))
                       (cons '%asm-functions (map select-instructions-function funcs))
                       (select-instructions-main main-clause))
                 extra-clauses)
                (append
                 (list '%asm-program
                       (if strings strings '(strings ()))
                       (if stackmaps stackmaps '(stackmaps ()))
                       (cons '%asm-functions (map select-instructions-function funcs))
                       (select-instructions-main main-clause))
                 extra-clauses))))
      (set-car! *c-tu-weak-fns* '())
      (set-car! *c-tu-weak-data* '())
      (set-car! *x86-c-tu-hoist-frame* 0)
      (set-car! *x86-c-tu-delta-calls* '())
      (set-car! *x86-c-tu-call-ordinal* 0)
      res)))

