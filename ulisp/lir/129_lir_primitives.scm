;;; =======================================================================
;;; ULisp Compiler Pass 129: LIR Primitive Instruction Selection
;;; =======================================================================
;;; Extracts primitive operator compilation (zero-arg, unary, binary,
;;; ternary, and raw syscall) out of the monolithic 130_lir.scm pass.
;;; =======================================================================

(define (lir-compile-zero-arg op si env)
  (let ((frame-shift (align-frame-shift (- si))))
    (case op
      ((%get-rsp)
       (emit-lir! '(%mov %rax %rsp)))
      ((%get-heap-ptr)
       (emit-lir! '(%mov %rax %r12)))
      ((%get-gc-state-ptr)
       (emit-lir! (list '%code-ref '%rax "ulisp_gc_state")))
      ((%get-environ-ptr)
       (emit-lir! (list '%code-ref '%rax "ulisp_environ")))
      ((%get-heap-limit-ptr)
       (emit-lir! (list '%code-ref '%rax "ulisp_heap_limit")))
      ((%get-stackmap-table)
       (emit-lir! (list '%code-ref '%rax "__ulisp_stackmap_table")))
      ((eof-object)
       (emit-lir! '(%mov %rax 79)))
      ((%num-args)
       (emit-lir! '(%load %rax %rsp -16)))
      ((read-char %read-char)
       (emit-lir! (list '%c-call "ulisp_read_char" frame-shift)))
      ((peek-char %peek-char)
       (emit-lir! (list '%c-call "ulisp_peek_char" frame-shift)))
      ((flush-output-port ulisp-flush)
       (emit-lir! (list '%c-call "ulisp_flush" frame-shift))))))

(define (lir-compile-unary op arg si env)
  (if (and (eq? op '%unbox-fixnum) (integer? arg))
      (emit-lir! (list '%mov '%rax arg))
      (if (and (eq? op '%unbox-fixnum) (symbol? arg) (memq arg (get-raw-vars env)))
          (lir-compile-expr arg si env #f)
          (begin
            (lir-compile-expr arg si env #f)
            (case op
    ((-)
     (emit-lir! '(%neg %rax)))
    ((fxadd1)
     (emit-lir! '(%add %rax 4)))
    ((fxsub1)
     (emit-lir! '(%sub %rax 4)))
    ((fixnum->char integer->char)
     (emit-lir! '(%shl %rax 6))
     (emit-lir! '(%bit-or %rax 14)))
    ((char->fixnum char->integer)
     (emit-lir! '(%sar %rax 6)))
    ((integer->symbol)
     (emit-lir! '(%shl %rax 6))
     (emit-lir! '(%bit-or %rax 2)))
    ((symbol->integer)
     (emit-lir! '(%sar %rax 6)))
    ((zero?)
     (emit-lir! '(%cmp %rax 0))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((fixnum? integer? number? exact? exact-integer? real? rational? complex?)
     (emit-lir! '(%bit-and %rax 3))
     (emit-lir! '(%cmp %rax 0))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((inexact?)
     (emit-lir! '(%mov %rax 47)))
    ((boolean?)
     (emit-lir! '(%mov %rdx %rax))
     (emit-lir! '(%bit-xor %rdx 47))
     (emit-lir! '(%bit-and %rdx -65))
     (emit-lir! '(%cmp %rdx 0))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((char?)
     (emit-lir! '(%bit-and %rax 255))
     (emit-lir! '(%cmp %rax 14))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((null?)
     (emit-lir! '(%cmp %rax 63))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((not)
     (emit-lir! '(%cmp %rax 47))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((symbol?)
     (emit-lir! '(%bit-and %rax 255))
     (emit-lir! '(%cmp %rax 2))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((car)
     (emit-lir! '(%load %rax %rax -1)))
    ((cdr)
     (emit-lir! '(%load %rax %rax 7)))
    ((pair? procedure?)
     (emit-lir! '(%bit-and %rax 3))
     (emit-lir! '(%cmp %rax 1))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((string?)
     (emit-lir! '(%bit-and %rax 7))
     (emit-lir! '(%cmp %rax 3))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((bytevector?)
     (emit-lir! '(%bit-and %rax 7))
     (emit-lir! '(%cmp %rax 7))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((vector?)
     (emit-lir! '(%bit-and %rax 7))
     (emit-lir! '(%cmp %rax 5))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((write-char %write-char write-byte write-u8)
     (let ((frame-shift (align-frame-shift (- si))))
       (emit-lir! '(%mov %rdi %rax))
       (emit-lir! (list '%c-call "ulisp_write_char" frame-shift))))
    ((write-string %write-string)
     (let ((frame-shift (align-frame-shift (- si))))
       (emit-lir! '(%mov %rdi %rax))
       (emit-lir! (list '%c-call "ulisp_write_string" frame-shift))))
    ((flush-output-port ulisp-flush)
     (let ((frame-shift (align-frame-shift (- si))))
       (emit-lir! (list '%c-call "ulisp_flush" frame-shift))))
    ((raise %raise)
     (emit-lir! '(%raise)))
    ((eof-object?)
     (emit-lir! '(%cmp %rax 79))
     (emit-lir! '(%set-boolean %rax "sete")))
    ((%set-heap-ptr!)
     (emit-lir! '(%mov %r12 %rax)))
    ((%ptr-tag)
     (emit-lir! '(%bit-and %rax 7))
     (emit-lir! '(%shl %rax 2)))
    ((%ptr-untag)
     (emit-lir! '(%bit-and %rax -8)))
    ((%to-raw)
     (emit-lir! '(%sar %rax 2)))
    ((%to-fixnum)
     (emit-lir! '(%shl %rax 2)))
    ((%box-fixnum)
     (emit-lir! '(%box-fixnum %rax %rax)))
    ((%unbox-fixnum)
     (emit-lir! '(%unbox-fixnum %rax %rax)))
    ((make-string)
     (emit-lir! '(%sar %rax 2))
     (emit-lir! '(%mov %rcx %rax))
     (emit-lir! '(%add %rax 8))
     (emit-lir! '(%bit-and %rax -8))
     (emit-lir! '(%mov %rdx %rax))
     (emit-lir! '(%shl %rdx 16))
     (emit-lir! '(%bit-or %rdx 3))
     (emit-lir! '(%shl %rdx 2))
     (emit-lir! '(%store %r12 0 %rdx))
     (emit-lir! '(%mov %rdx %r12))
     (emit-lir! '(%add %rdx 8))
     (emit-lir! '(%add %rax 8))
     (emit-lir! '(%add %r12 %rax))
     (emit-lir! '(%store-byte %rdx %rcx 0))
     (emit-lir! '(%add %rdx 3))
     (emit-lir! '(%mov %rax %rdx)))
    ((string-length)
     (let ((l-loop (unique-label-sym "strlen_loop"))
           (l-done (unique-label-sym "strlen_done")))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! '(%sub %rdx 3))
       (emit-lir! '(%mov %rax 0))
       (emit-lir! (list '%label l-loop))
       (emit-lir! '(%load-byte-zx %rcx %rdx %rax))
       (emit-lir! '(%cmp %rcx 0))
       (emit-lir! (list '%jump-if-zero l-done))
       (emit-lir! '(%inc %rax))
       (emit-lir! (list '%jump l-loop))
       (emit-lir! (list '%label l-done))
       (emit-lir! '(%shl %rax 2))))
    ((bytevector-length)
     (emit-lir! '(%sub %rax 7))
     (emit-lir! '(%load %rax %rax 0)))
    ((make-bytevector %make-bytevector)
     (let ((l-loop (unique-label-sym "bv_zero_loop"))
           (l-done (unique-label-sym "bv_zero_done")))
       (emit-lir! '(%sar %rax 2))
       (emit-lir! '(%mov %rcx %rax))
       (emit-lir! '(%add %rax 15))
       (emit-lir! '(%bit-and %rax -8))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! '(%shl %rdx 16))
       (emit-lir! '(%bit-or %rdx 4))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 0 %rdx))
       (emit-lir! '(%mov %rdx %rcx))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 8 %rdx))
       (emit-lir! '(%mov %r10 0))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%label l-loop))
       (emit-lir! (list '%cmp '%rdx 8))
       (emit-lir! (list '%jump-if-zero l-done))
       (emit-lir! '(%store %r12 %rdx %r10))
       (emit-lir! '(%sub %rdx 8))
       (emit-lir! (list '%jump l-loop))
       (emit-lir! (list '%label l-done))
       (emit-lir! '(%mov %rcx %r12))
       (emit-lir! '(%add %rcx 15))
       (emit-lir! '(%add %rax 8))
       (emit-lir! '(%add %r12 %rax))
       (emit-lir! '(%mov %rax %rcx))))
    ((vector-length)
     (emit-lir! '(%sub %rax 5))
     (emit-lir! '(%load %rax %rax 0)))
    ((make-vector %make-vector)
     (let ((l-loop (unique-label-sym "vec_init_loop"))
           (l-done (unique-label-sym "vec_init_done")))
       (emit-lir! '(%sar %rax 2))
       (emit-lir! '(%mov %rcx %rax))
       (emit-lir! '(%shl %rax 3))
       (emit-lir! '(%add %rax 8))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! '(%shl %rdx 16))
       (emit-lir! '(%bit-or %rdx 5))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 0 %rdx))
       (emit-lir! '(%mov %rdx %rcx))
       (emit-lir! '(%shl %rdx 2))
       (emit-lir! '(%store %r12 8 %rdx))
       (emit-lir! '(%mov %r10 47))
       (emit-lir! '(%mov %rdx %rax))
       (emit-lir! (list '%label l-loop))
       (emit-lir! (list '%cmp '%rdx 8))
       (emit-lir! (list '%jump-if-zero l-done))
       (emit-lir! '(%store %r12 %rdx %r10))
       (emit-lir! '(%sub %rdx 8))
       (emit-lir! (list '%jump l-loop))
       (emit-lir! (list '%label l-done))
       (emit-lir! '(%mov %rcx %r12))
       (emit-lir! '(%add %rcx 13))
       (emit-lir! '(%add %rax 8))
       (emit-lir! '(%add %r12 %rax))
       (emit-lir! '(%mov %rax %rcx)))))))))

(define (lir-compile-operand-for-op op e si env)
  (if (and (integer? e) (memq op '(%raw-add %raw-sub %raw-mul %raw-cmp)))
      (emit-lir! (list '%mov '%rax e))
      (lir-compile-expr e si env #f)))

(define (env-reg-var? e env)
  (and (symbol? e)
       (let ((b (assq e env)))
         (and b
              (let ((info (cdr b)))
                (cond
                  ((and (pair? info) (eq? (car info) 'reg)) (cdr info))
                  ((memq info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15)) info)
                  (else #f)))))))

(define (env-stack-slot? e env)
  (and (symbol? e)
       (let ((b (assq e env)))
         (and b
              (let ((info (cdr b)))
                (cond
                  ((number? info) info)
                  ((and (pair? info) (eq? (car info) 'param)) (cdr info))
                  (else #f)))))))

(define (lir-compile-binop op e1 e2 si env)
  (let ((r1 (env-reg-var? e1 env))
        (r2 (env-reg-var? e2 env))
        (s2 (env-stack-slot? e2 env))
        (lir-op (case op
                  ((+) '%add)
                  ((-) '%sub)
                  (else op))))
    (cond
      ;; Fast path: op is + or %raw-add and e2 is a register variable
      ((and (memq op '(+ %raw-add)) r2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list lir-op '%rax r2)))
      ;; Fast path: op is + or %raw-add and e1 is a register variable
      ((and (memq op '(+ %raw-add)) r1)
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list lir-op '%rax r1)))
      ;; Fast path: op is - or %raw-sub and e2 is a register variable
      ((and (memq op '(- %raw-sub)) r2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list lir-op '%rax r2)))
      ;; Fast path: op is %raw-add and e2 is an integer constant
      ((and (eq? op '%raw-add) (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%raw-add '%rax e2)))
      ;; Fast path: op is %raw-add and e1 is an integer constant
      ((and (eq? op '%raw-add) (integer? e1) (>= e1 -268435456) (<= e1 268435455))
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list '%raw-add '%rax e1)))
      ;; Fast path: op is %raw-sub and e2 is an integer constant
      ((and (eq? op '%raw-sub) (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%raw-sub '%rax e2)))
      ;; Fast path: op is + and e2 is an integer constant
      ((and (eq? op '+) (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%add '%rax (* e2 4))))
      ;; Fast path: op is + and e1 is an integer constant
      ((and (eq? op '+) (integer? e1) (>= e1 -268435456) (<= e1 268435455))
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list '%add '%rax (* e1 4))))
      ;; Fast path: op is - and e2 is an integer constant
      ((and (eq? op '-) (integer? e2) (>= e2 -268435456) (<= e2 268435455))
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%sub '%rax (* e2 4))))
      ;; Fast path: op is + / %raw-add / - / %raw-sub and e2 is a stack variable
      ((and (memq op '(+ %raw-add - %raw-sub)) s2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list lir-op '%rax (list '%stack s2))))
      ;; Fast path: op is * and e2 is a register variable
      ((and (eq? op '*) r2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! '(%sar %rax 2))
       (emit-lir! (list '%imul '%rax r2)))
      ;; Fast path: op is = and e1 is a register variable
      ((and (eq? op '=) r1)
       (lir-compile-operand-for-op op e2 si env)
       (emit-lir! (list '%cmp r1 '%rax))
       (emit-lir! '(%set-boolean %rax "sete")))
      ;; Fast path: op is = and e2 is a register variable
      ((and (eq? op '=) r2)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%cmp '%rax r2))
       (emit-lir! '(%set-boolean %rax "sete")))
      (else
       ;; Standard stack-based path
       (track-lir-si! si)
       (lir-compile-operand-for-op op e1 si env)
       (emit-lir! (list '%store '%rsp si '%rax))
       (track-lir-si! (- si 8))
       (lir-compile-operand-for-op op e2 (- si 8) env)
       (case op
         ((+)
          (emit-lir! (list '%add '%rax (list '%stack si))))
         ((-)
          (emit-lir! (list '%mov '%rdx (list '%stack si)))
          (emit-lir! '(%sub %rdx %rax))
          (emit-lir! '(%mov %rax %rdx)))
         ((*)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%imul '%rax (list '%stack si))))
         ((%raw-add)
          (emit-lir! (list '%raw-add '%rax (list '%stack si))))
         ((%raw-sub)
          (emit-lir! (list '%mov '%rdx (list '%stack si)))
          (emit-lir! '(%raw-sub %rdx %rax))
          (emit-lir! '(%mov %rax %rdx)))
         ((%raw-mul)
          (emit-lir! (list '%raw-mul '%rax (list '%stack si))))
         ((%raw-cmp)
          (emit-lir! (list '%raw-cmp (list '%stack si) '%rax)))
         ((modulo)
          (emit-lir! '(%mov %rcx %rax))
          (emit-lir! (list '%load '%rax '%rsp si))
          (emit-lir! '(%sar %rax 2))
          (emit-lir! '(%sar %rcx 2))
          (emit-lir! '(%cqo))
          (emit-lir! '(%idiv %rcx))
          (let ((l-done (unique-label-sym "mod_done")))
            (emit-lir! (list '%cmp '%rdx 0))
            (emit-lir! (list '%jump-if-zero l-done))
            (emit-lir! '(%mov %r10 %rdx))
            (emit-lir! '(%bit-xor %r10 %rcx))
            (emit-lir! (list '%cmp '%r10 0))
            (emit-lir! (list '%jump-cond "jge" l-done))
            (emit-lir! '(%add %rdx %rcx))
            (emit-lir! (list '%label l-done)))
          (emit-lir! '(%mov %rax %rdx))
          (emit-lir! '(%shl %rax 2)))
         ((quotient /)
          (emit-lir! '(%mov %rcx %rax))
          (emit-lir! (list '%load '%rax '%rsp si))
          (emit-lir! '(%sar %rax 2))
          (emit-lir! '(%sar %rcx 2))
          (emit-lir! '(%cqo))
          (emit-lir! '(%idiv %rcx))
          (emit-lir! '(%shl %rax 2)))
         ((string-ref)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%sub %rdx 3))
          (emit-lir! (list '%load-byte-zx '%rax '%rdx '%rax))
          (emit-lir! '(%shl %rax 8))
          (emit-lir! '(%bit-or %rax 14)))
         ((bytevector-u8-ref)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%sub %rdx 7))
          (emit-lir! '(%add %rdx 8))
          (emit-lir! (list '%load-byte-zx '%rax '%rdx '%rax))
          (emit-lir! '(%shl %rax 2)))
         ((vector-ref)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! '(%shl %rax 3))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%sub %rdx 5))
          (emit-lir! '(%add %rdx 8))
          (emit-lir! (list '%load '%rax '%rdx '%rax)))
         ((=)
          (emit-lir! (list '%cmp (list '%stack si) '%rax))
          (emit-lir! '(%set-boolean %rax "sete")))
         ((<)
          (emit-lir! (list '%cmp (list '%stack si) '%rax))
          (emit-lir! '(%set-boolean %rax "setl")))
         ((<=)
          (emit-lir! (list '%cmp (list '%stack si) '%rax))
          (emit-lir! '(%set-boolean %rax "setle")))
         ((>)
          (emit-lir! (list '%cmp (list '%stack si) '%rax))
          (emit-lir! '(%set-boolean %rax "setg")))
         ((>=)
          (emit-lir! (list '%cmp (list '%stack si) '%rax))
          (emit-lir! '(%set-boolean %rax "setge")))
         ((bitwise-and)
          (emit-lir! (list '%bit-and '%rax (list '%stack si))))
         ((bitwise-ior)
          (emit-lir! (list '%bit-or '%rax (list '%stack si))))
         ((%raw-load)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%add %rdx %rax))
          (emit-lir! '(%load %rax %rdx 0)))
         ((%raw-load-u8)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! (list '%load-byte-zx '%rax '%rdx '%rax))
          (emit-lir! '(%shl %rax 2)))
         ((%ptr-add %ptr-tag-add)
          (emit-lir! '(%sar %rax 2))
          (emit-lir! (list '%add '%rax (list '%stack si))))
         ((cons)
          (emit-lir! (list '%store '%rsp (- si 8) '%rax))
          (emit-lir! (list '%alloc '%rax 24 9 (- si 8)))
          (emit-lir! '(%mov %rdx 4196356))
          (emit-lir! '(%store %rax -9 %rdx))
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%store %rax -1 %rdx))
          (emit-lir! (list '%load '%rdx '%rsp (- si 8)))
          (emit-lir! '(%store %rax 7 %rdx)))
         ((set-car!)
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%store %rdx -1 %rax))
          (emit-lir! '(%mov %rax 63)))
         ((set-cdr!)
          (emit-lir! (list '%load '%rdx '%rsp si))
          (emit-lir! '(%store %rdx 7 %rax))
          (emit-lir! '(%mov %rax 63)))
         ((eq? eqv? char=?)
          (emit-lir! (list '%cmp (list '%stack si) '%rax))
          (emit-lir! '(%set-boolean %rax "sete")))
         ((boolean=?)
          (emit-lir! (list '%mov '%rdx (list '%stack si)))
          (emit-lir! '(%bit-xor %rdx %rax))
          (emit-lir! '(%bit-xor %rax 47))
          (emit-lir! '(%bit-and %rax -65))
          (emit-lir! '(%bit-or %rax %rdx))
          (emit-lir! '(%cmp %rax 0))
          (emit-lir! '(%set-boolean %rax "sete")))
         ((symbol=?)
          (emit-lir! (list '%mov '%rdx (list '%stack si)))
          (emit-lir! '(%bit-xor %rdx %rax))
          (emit-lir! '(%bit-xor %rax 2))
          (emit-lir! '(%bit-and %rax 255))
          (emit-lir! '(%bit-or %rax %rdx))
          (emit-lir! '(%cmp %rax 0))
          (emit-lir! '(%set-boolean %rax "sete"))))))))

(define (lir-compile-triop op e1 e2 e3 si env)
  (track-lir-si! si)
  (lir-compile-expr e1 si env #f)
  (emit-lir! (list '%store '%rsp si '%rax))
  (track-lir-si! (- si 8))
  (lir-compile-expr e2 (- si 8) env #f)
  (emit-lir! (list '%store '%rsp (- si 8) '%rax))
  (track-lir-si! (- si 16))
  (lir-compile-expr e3 (- si 16) env #f)
  (case op
    ((string-set!)
     (emit-lir! '(%shr %rax 8))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%sub %rdx 3))
     (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
     (emit-lir! '(%sar %rcx 2))
     (emit-lir! '(%store-byte %rdx %rcx %al))
     (emit-lir! '(%mov %rax 63)))
    ((bytevector-u8-set!)
     (emit-lir! '(%sar %rax 2))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%sub %rdx 7))
     (emit-lir! '(%add %rdx 8))
     (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
     (emit-lir! '(%sar %rcx 2))
     (emit-lir! '(%store-byte %rdx %rcx %al))
     (emit-lir! '(%mov %rax 63)))
    ((vector-set!)
     (emit-lir! '(%mov %r10 %rax))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%sub %rdx 5))
     (emit-lir! '(%add %rdx 8))
     (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
     (emit-lir! '(%sar %rcx 2))
     (emit-lir! '(%shl %rcx 3))
     (emit-lir! '(%store %rdx %rcx %r10))
     (emit-lir! '(%mov %rax 63)))
    ((%raw-store!)
     (emit-lir! '(%mov %r10 %rax))
     (emit-lir! (list '%load '%rcx '%rsp (- si 8)))
     (emit-lir! '(%sar %rcx 2))
     (emit-lir! (list '%load '%rdx '%rsp si))
     (emit-lir! '(%add %rdx %rcx))
     (emit-lir! '(%store %rdx 0 %r10))
     (emit-lir! '(%mov %rax 63)))))

(define (lir-compile-raw-syscall args si env)
  (let ((num (car args))
        (a1 (car (cdr args)))
        (a2 (car (cdr (cdr args))))
        (a3 (car (cdr (cdr (cdr args)))))
        (a4 (car (cdr (cdr (cdr (cdr args))))))
        (a5 (car (cdr (cdr (cdr (cdr (cdr args)))))))
        (a6 (car (cdr (cdr (cdr (cdr (cdr (cdr args)))))))))
    (track-lir-si! si)
    (lir-compile-expr num si env #f)
    (emit-lir! (list '%store '%rsp si '%rax))
    (track-lir-si! (- si 8))
    (lir-compile-expr a1 (- si 8) env #f)
    (emit-lir! (list '%store '%rsp (- si 8) '%rax))
    (track-lir-si! (- si 16))
    (lir-compile-expr a2 (- si 16) env #f)
    (emit-lir! (list '%store '%rsp (- si 16) '%rax))
    (track-lir-si! (- si 24))
    (lir-compile-expr a3 (- si 24) env #f)
    (emit-lir! (list '%store '%rsp (- si 24) '%rax))
    (track-lir-si! (- si 32))
    (lir-compile-expr a4 (- si 32) env #f)
    (emit-lir! (list '%store '%rsp (- si 32) '%rax))
    (track-lir-si! (- si 40))
    (lir-compile-expr a5 (- si 40) env #f)
    (emit-lir! (list '%store '%rsp (- si 40) '%rax))
    (track-lir-si! (- si 48))
    (lir-compile-expr a6 (- si 48) env #f)
    (emit-lir! (list '%store '%rsp (- si 48) '%rax))
    (emit-lir! (list '%load '%rax '%rsp si))
    (emit-lir! (list '%load '%rdi '%rsp (- si 8)))
    (emit-lir! (list '%load '%rsi '%rsp (- si 16)))
    (emit-lir! (list '%load '%rdx '%rsp (- si 24)))
    (emit-lir! (list '%load '%r10 '%rsp (- si 32)))
    (emit-lir! (list '%load '%r8 '%rsp (- si 40)))
    (emit-lir! (list '%load '%r9 '%rsp (- si 48)))
    (emit-lir! '(%syscall))))
