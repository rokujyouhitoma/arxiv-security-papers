;;; =======================================================================
;;; ULisp Compiler Pass 133: LIR Peephole Optimization & Dead Code Elimination
;;; Conforms to DSN-33 Architecture Specification & Issues #595, #767
;;; Implements sliding-window local simplifications, unreachable code pruning,
;;; and distance-independent DAG Store-Reload forwarding.
;;; =======================================================================

(define (lir-peephole-reg? opnd)
  (and (symbol? opnd)
       (case opnd
         ((%rax %rcx %rdx %rbx %rsp %rbp %rsi %rdi
           %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15)
          #t)
         (else
          (let ((s (symbol->string opnd)))
            (and (> (string-length s) 1)
                 (char=? (string-ref s 0) #\%)))))))

(define (lir-unconditional-terminator? inst)
  (and (pair? inst)
       (case (car inst)
         ((%jump %direct-jump %switch %return) #t)
         (else #f))))

(define (lir-label-inst? inst)
  (and (pair? inst)
       (let ((op (car inst)))
         (or (eq? op '%label) (eq? op '%block)))))

;;; -----------------------------------------------------------------------
;;; First-Class LIR Peephole Picopass Rules (DSN-33-01 T5.3)
;;; -----------------------------------------------------------------------

;; Rule 1: Redundant Self-Move Elimination
;; (%mov reg reg) -> ()
(define-picopass rule-lir-self-mov-elim
  (InstWindow
    (((%mov ,r1 ,r2) . ,rest)
     (guard (equal? r1 r2))
     rest)))

;; Rule 2: Round-Trip Register Move Elimination
;; (%mov r1 r2) (%mov r2 r1) -> (%mov r1 r2)
(define-picopass rule-lir-roundtrip-mov-elim
  (InstWindow
    (((%mov ,r1 ,r2) (%mov ,r3 ,r4) . ,rest)
     (guard (and (equal? r1 r4)
                 (equal? r2 r3)
                 (lir-peephole-reg? r1)
                 (lir-peephole-reg? r2)))
     (cons (list '%mov r1 r2) rest))))

;; Rule 2b: Dead Register Overwrite Elimination (Issue #927)
;; (%mov r1 _any) (%mov r1 src) -> (%mov r1 src) when src does not reference r1
;; (%load r1 %rsp off) (%mov r1 src) -> (%mov r1 src) when src does not reference r1
(define-picopass rule-lir-dead-reg-overwrite-elim
  (InstWindow
    (((%mov ,r1 ,_src0) (%mov ,r2 ,src1) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? src1 r1))))
     (cons (list '%mov r2 src1) rest))
    (((%load ,r1 %rsp ,_off) (%mov ,r2 ,src1) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? src1 r1))))
     (cons (list '%mov r2 src1) rest))
    (((%load-typed ,_ty ,r1 %rsp ,_off) (%mov ,r2 ,src1) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? src1 r1))))
     (cons (list '%mov r2 src1) rest))
    (((%mov ,r1 ,_src0) (%load ,r2 ,base ,off) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? base r1))
                 (not (lir-dse-tree-contains-sym? off r1))))
     (cons (list '%load r2 base off) rest))
    (((%mov ,r1 ,_src0) (%load-typed ,mty ,r2 ,base ,off) . ,rest)
     (guard (and (equal? r1 r2)
                 (lir-peephole-reg? r1)
                 (not (eq? r1 '%rsp))
                 (not (lir-dse-tree-contains-sym? base r1))
                 (not (lir-dse-tree-contains-sym? off r1))))
     (cons (list '%load-typed mty r2 base off) rest))))

;; Rule 3: Redundant Jump to Next Immediate Label
;; (%jump L1) (%label L1) -> (%label L1)
(define-picopass rule-lir-jump-next-label-elim
  (InstWindow
    (((%jump ,l1) (%label ,l2) . ,rest)
     (guard (equal? l1 l2))
     (cons (list '%label l2) rest))
    (((%direct-jump ,l1) (%label ,l2) . ,rest)
     (guard (equal? l1 l2))
     (cons (list '%label l2) rest))))

;; Rule 4: Identity Arithmetic Simplification
;; (%add reg 0) / (%raw-add reg 0) / (%sub reg 0) / (%raw-sub reg 0) -> ()
(define-picopass rule-lir-identity-arith-elim
  (InstWindow
    (((%add ,r 0) . ,rest) rest)
    (((%raw-add ,r 0) . ,rest) rest)
    (((%sub ,r 0) . ,rest) rest)
    (((%raw-sub ,r 0) . ,rest) rest)))

;; Rule 5: Identity Multiplication Simplification
;; (%imul reg 1) / (%raw-mul reg 1) -> ()
(define-picopass rule-lir-identity-mul-elim
  (InstWindow
    (((%imul ,r 1) . ,rest) rest)
    (((%raw-mul ,r 1) . ,rest) rest)))

;; Rule 6: Unreachable Code Elimination (DCE)
;; (%jump L) / (%return) followed by non-label instructions up to next label
(define-picopass rule-lir-unreachable-dce
  (InstWindow
    (((%jump ,lbl) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons (list '%jump lbl) (lir-skip-to-next-label rest)))
    (((%direct-jump ,lbl) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons (list '%direct-jump lbl) (lir-skip-to-next-label rest)))
    (((%return) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons '(%return) (lir-skip-to-next-label rest)))
    (((%return ,opnd) ,next . ,rest)
     (guard (not (lir-label-inst? next)))
     (cons (list '%return opnd) (lir-skip-to-next-label rest)))))

;; Rule 7: Distance-Independent DAG Store-Reload Forwarding (DSN-33-01 T5.3)
;; Unifies Rule 2b (adjacent store-reload), Rule 2b-2/2b-3 (1-store gap),
;; and multi-instruction gaps across intervening straight-line instructions.
(define-picopass rule-lir-store-load-forward
  (InstWindow
    ;; Distance 0: Adjacent Store-Reload (Rule 2b)
    (((%store %rsp ,off ,src) (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) rest)
         (cons (list '%store '%rsp off src)
               (cons (list '%mov dst src) rest))))

    ;; Distance 1: 1 Intervening Instruction (Rule 2b-2, Rule 2b-3, or safe intervening inst)
    (((%store %rsp ,off ,src) ,i1 (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) (cons i1 rest))
         (cons (list '%store '%rsp off src) (cons i1 (cons (list '%mov dst src) rest)))))

    ;; Distance 2: 2 Intervening Instructions (test 11, test 15)
    (((%store %rsp ,off ,src) ,i1 ,i2 (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 rest)))
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 (cons (list '%mov dst src) rest))))))

    ;; Distance 3: 3 Intervening Instructions (test 12)
    (((%store %rsp ,off ,src) ,i1 ,i2 ,i3 (%load ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-terminates-block? i3))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-memory-barrier? i3))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-defines-reg? i3 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))
                 (not (lir-inst-may-alias-stack-slot? i3 off))))
     (if (equal? dst src)
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 (cons i3 rest))))
         (cons (list '%store '%rsp off src) (cons i1 (cons i2 (cons i3 (cons (list '%mov dst src) rest)))))))))

;; Rule 8: Redundant Box-Unbox Pair Elimination (Issue #826)
;; (%box-fixnum r1 r2) (%unbox-fixnum r3 r1) -> (%mov r3 r2)
;; (%unbox-fixnum r1 r2) (%box-fixnum r3 r1) -> (%mov r3 r2)
;; (%box-flonum r1 r2) (%unbox-flonum r3 r1) -> (%fmov r3 r2)
;; (%unbox-flonum r1 r2) (%box-flonum r3 r1) -> (%fmov r3 r2)
(define-picopass rule-lir-box-unbox-elim
  (InstWindow
    (((%box-fixnum ,d1 ,s1) (%unbox-fixnum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%mov d2 s1) rest)))
    (((%unbox-fixnum ,d1 ,s1) (%box-fixnum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%mov d2 s1) rest)))
    (((%box-flonum ,d1 ,s1) (%unbox-flonum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%fmov d2 s1) rest)))
    (((%unbox-flonum ,d1 ,s1) (%box-flonum ,d2 ,s2) . ,rest)
     (guard (equal? d1 s2))
     (if (equal? d2 s1)
         rest
         (cons (list '%fmov d2 s1) rest)))))

;; Rule 9: Redundant Source Location Elimination
;; (%loc fid line col1) (%loc fid line col2) -> (%loc fid line col2)
(define-picopass rule-lir-redundant-loc-elim
  (InstWindow
    (((%loc ,f1 ,l1 ,c1) (%loc ,f2 ,l2 ,c2) . ,rest)
     (guard (and (equal? f1 f2) (equal? l1 l2)))
     (cons (list '%loc f2 l2 c2) rest))))

;; Rule 10: Redundant Self Floating-Point Move Elimination (Issue #934)
;; (%fmov reg reg) -> ()
(define-picopass rule-lir-self-fmov-elim
  (InstWindow
    (((%fmov ,r1 ,r2) . ,rest)
     (guard (equal? r1 r2))
     rest)))

;; Rule 11: Distance-Independent f64 Store-Reload Forwarding (Issue #934)
;; Strictly restricted to f64 because 160_backend_c rounds f32 on %store-typed/%load-typed
;; whereas %fmov performs raw 64-bit IEEE-754 register transfer.
(define-picopass rule-lir-f64-store-load-forward
  (InstWindow
    ;; Distance 0: Adjacent f64 Store-Reload
    (((%store-typed f64 %rsp ,off ,src) (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) rest)
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons (list '%fmov dst src) rest))))

    ;; Distance 1
    (((%store-typed f64 %rsp ,off ,src) ,i1 (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) (cons i1 rest))
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons i1 (cons (list '%fmov dst src) rest)))))

    ;; Distance 2
    (((%store-typed f64 %rsp ,off ,src) ,i1 ,i2 (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) (cons i1 (cons i2 rest)))
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons i1 (cons i2 (cons (list '%fmov dst src) rest))))))

    ;; Distance 3
    (((%store-typed f64 %rsp ,off ,src) ,i1 ,i2 ,i3 (%load-typed f64 ,dst %rsp ,off) . ,rest)
     (guard (and (integer? off)
                 (lir-peephole-reg? src)
                 (lir-peephole-reg? dst)
                 (not (lir-inst-terminates-block? i1))
                 (not (lir-inst-terminates-block? i2))
                 (not (lir-inst-terminates-block? i3))
                 (not (lir-inst-memory-barrier? i1))
                 (not (lir-inst-memory-barrier? i2))
                 (not (lir-inst-memory-barrier? i3))
                 (not (lir-inst-defines-reg? i1 src))
                 (not (lir-inst-defines-reg? i2 src))
                 (not (lir-inst-defines-reg? i3 src))
                 (not (lir-inst-may-alias-stack-slot? i1 off))
                 (not (lir-inst-may-alias-stack-slot? i2 off))
                 (not (lir-inst-may-alias-stack-slot? i3 off))))
     (if (equal? dst src)
         (cons (list '%store-typed 'f64 '%rsp off src) (cons i1 (cons i2 (cons i3 rest))))
         (cons (list '%store-typed 'f64 '%rsp off src)
               (cons i1 (cons i2 (cons i3 (cons (list '%fmov dst src) rest)))))))))

;;; -----------------------------------------------------------------------
;;; Linear O(N) Backward-Liveness Stack Dead-Store Elimination (Issue #934)
;;; -----------------------------------------------------------------------

(define (lir-iv-insert ivs lo hi)
  (if (>= lo hi)
      ivs
      (let loop ((xs ivs) (cur-lo lo) (cur-hi hi) (acc '()))
        (cond
          ((null? xs)
           (reverse (cons (cons cur-lo cur-hi) acc)))
          ((< (cdar xs) cur-lo)
           (loop (cdr xs) cur-lo cur-hi (cons (car xs) acc)))
          ((> (caar xs) cur-hi)
           (let append-rest ((ys xs) (out (cons (cons cur-lo cur-hi) acc)))
             (if (null? ys)
                 (reverse out)
                 (append-rest (cdr ys) (cons (car ys) out)))))
          (else
           (loop (cdr xs)
                 (min cur-lo (caar xs))
                 (max cur-hi (cdar xs))
                 acc))))))

(define (lir-iv-remove ivs lo hi)
  (if (>= lo hi)
      ivs
      (let loop ((xs ivs) (acc '()))
        (if (null? xs)
            (reverse acc)
            (let ((xlo (caar xs))
                  (xhi (cdar xs)))
              (cond
                ((or (<= xhi lo) (>= xlo hi))
                 (loop (cdr xs) (cons (car xs) acc)))
                (else
                 (let* ((acc1 (if (< xlo lo) (cons (cons xlo lo) acc) acc))
                        (acc2 (if (< hi xhi) (cons (cons hi xhi) acc1) acc1)))
                   (loop (cdr xs) acc2)))))))))

(define (lir-iv-subsumed? ivs lo hi)
  (let loop ((xs ivs))
    (cond
      ((null? xs) #f)
      ((> (caar xs) lo) #f)
      ((<= (caar xs) lo)
       (if (>= (cdar xs) hi)
           #t
           (loop (cdr xs))))
      (else (loop (cdr xs))))))

(define (lir-iv-overlaps? ivs lo hi)
  (let loop ((xs ivs))
    (cond
      ((null? xs) #f)
      ((>= (caar xs) hi) #f)
      ((> (cdar xs) lo) #t)
      (else (loop (cdr xs))))))

(define (lir-dse-type-width ty)
  (case ty
    ((i8 u8 bool) 1)
    ((i16 u16) 2)
    ((i32 u32 f32) 4)
    (else 8)))

(define (lir-dse-tree-contains-sym? x sym)
  (cond
    ((eq? x sym) #t)
    ((pair? x) (or (lir-dse-tree-contains-sym? (car x) sym)
                   (lir-dse-tree-contains-sym? (cdr x) sym)))
    (else #f)))

(define (lir-dse-inst-escapes-rsp? inst)
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((case op
             ((%inline-asm %alloc-stack %managed-alloc-stack %capture-cc) #t)
             (else #f))
           #t)
          ((or (eq? op '%store) (eq? op '%store-byte))
           (and (>= (length inst) 4) (eq? (list-ref inst 3) '%rsp)))
          ((eq? op '%store-typed)
           (and (>= (length inst) 5) (eq? (list-ref inst 4) '%rsp)))
          ((or (eq? op '%load) (eq? op '%load-byte-zx))
           (and (>= (length inst) 4) (eq? (list-ref inst 3) '%rsp)))
          ((eq? op '%load-typed)
           (and (>= (length inst) 5) (eq? (list-ref inst 4) '%rsp)))
          ((case op
             ((%add %sub %raw-add %raw-sub) #t)
             (else #f))
           (and (>= (length inst) 3)
                (or (eq? (caddr inst) '%rsp)
                    (and (not (eq? (cadr inst) '%rsp))
                         (lir-dse-tree-contains-sym? (cdr inst) '%rsp)))))
          (else
           (lir-dse-tree-contains-sym? (cdr inst) '%rsp))))))

(define (lir-dse-inst-modifies-rsp? inst)
  (and (pair? inst) (lir-inst-defines-reg? inst '%rsp)))

(define (lir-dse-inst-indirect-read? inst)
  (and (pair? inst)
       (let ((op (car inst)))
         (or (and (or (eq? op '%load) (eq? op '%load-byte-zx))
                  (>= (length inst) 4)
                  (not (eq? (caddr inst) '%rsp)))
             (and (eq? op '%load-typed)
                  (>= (length inst) 5)
                  (not (eq? (cadddr inst) '%rsp)))
             (case op
               ((%unbox-flonum %unbox-fixnum %atomic-cas!
                 %managed-unbox %managed-write-barrier
                 %box-flonum %managed-box)
                #t)
               (else #f))))))

(define (lir-dse-neg-store-range inst)
  ;; Returns (lo . hi) if inst stores strictly into negative %rsp offset (< 0) with known integer width, else #f
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%store)
                (>= (length inst) 4)
                (eq? (cadr inst) '%rsp)
                (integer? (caddr inst)))
           (let ((off (caddr inst)))
             (if (and (< off 0) (<= (+ off 8) 0) (not (eq? (cadddr inst) '%rsp)))
                 (cons off (+ off 8))
                 #f)))
          ((and (eq? op '%store-byte)
                (>= (length inst) 4)
                (eq? (cadr inst) '%rsp)
                (integer? (caddr inst)))
           (let ((off (caddr inst)))
             (if (and (< off 0) (<= (+ off 1) 0) (not (eq? (cadddr inst) '%rsp)))
                 (cons off (+ off 1))
                 #f)))
          ((and (eq? op '%store-typed)
                (>= (length inst) 5)
                (eq? (caddr inst) '%rsp)
                (integer? (cadddr inst)))
           (let* ((off (cadddr inst))
                  (w (lir-dse-type-width (cadr inst))))
             (if (and (< off 0) (<= (+ off w) 0) (not (eq? (list-ref inst 4) '%rsp)))
                 (cons off (+ off w))
                 #f)))
          (else #f)))))

(define (lir-dse-rsp-load-range inst)
  ;; Returns (lo . hi) for direct %rsp load, 'unknown if non-const %rsp load, or #f if not a %rsp load
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%load) (>= (length inst) 4) (eq? (caddr inst) '%rsp))
           (let ((off (cadddr inst)))
             (if (integer? off) (cons off (+ off 8)) 'unknown)))
          ((and (eq? op '%load-byte-zx) (>= (length inst) 4) (eq? (caddr inst) '%rsp))
           (let ((off (cadddr inst)))
             (if (integer? off) (cons off (+ off 1)) 'unknown)))
          ((and (eq? op '%load-typed) (>= (length inst) 5) (eq? (cadddr inst) '%rsp))
           (let ((off (list-ref inst 4))
                 (w (lir-dse-type-width (cadr inst))))
             (if (integer? off) (cons off (+ off w)) 'unknown)))
          (else #f)))))

(define (lir-dse-live-dead? live lo hi)
  (if (eq? (car live) 'exact)
      (not (lir-iv-overlaps? (cdr live) lo hi))
      (lir-iv-subsumed? (cdr live) lo hi)))

(define (lir-dse-live-mark-read live lo hi)
  (if (eq? (car live) 'exact)
      (cons 'exact (lir-iv-insert (cdr live) lo hi))
      (cons 'all-except (lir-iv-remove (cdr live) lo hi))))

(define (lir-dse-live-mark-written live lo hi)
  (if (eq? (car live) 'exact)
      (cons 'exact (lir-iv-remove (cdr live) lo hi))
      (cons 'all-except (lir-iv-insert (cdr live) lo hi))))

(define (lir-dse-fold-stack-opnds tree live)
  ;; Records any (%stack off) operands anywhere in tree into liveness state.
  (cond
    ((not (pair? tree)) live)
    ((eq? (car tree) '%stack)
     (let ((off (and (pair? (cdr tree)) (cadr tree))))
       (if (integer? off)
           (lir-dse-live-mark-read live off (+ off 8))
           '(all-except))))
    (else
     (lir-dse-fold-stack-opnds (cdr tree)
                               (lir-dse-fold-stack-opnds (car tree) live)))))

(define (lir-dse-inst-cannot-have-stack-opnd? inst)
  (and (pair? inst)
       (case (car inst)
         ((%loc %label %load %load-byte-zx %store %store-byte
           %direct-jump %jump-cond %jump-if-zero %set-boolean
           %direct-call %call-closure %alloc)
          #t)
         (else #f))))

(define (lir-dse-fold-inst-stack-opnds inst live)
  (if (lir-dse-inst-cannot-have-stack-opnd? inst)
      live
      (lir-dse-fold-stack-opnds inst live)))

(define (lir-dse-collect-leaf-reads insts)
  ;; Scans all direct %rsp reads & (%stack off) reads in a function -> (unknown? . ivs)
  (let loop ((xs insts) (unk #f) (ivs '()))
    (if (or unk (null? xs))
        (cons unk ivs)
        (let* ((inst (car xs))
               (ld (lir-dse-rsp-load-range inst))
               (live0 (cons 'exact ivs))
               (live1 (lir-dse-fold-inst-stack-opnds inst live0)))
          (cond
            ((eq? ld 'unknown)
             (loop (cdr xs) #t '()))
            ((eq? (car live1) 'all-except)
             (loop (cdr xs) #t '()))
            (ld
             (loop (cdr xs) #f (lir-iv-insert (cdr live1) (car ld) (cdr ld))))
            (else
             (loop (cdr xs) #f (cdr live1))))))))

(define (%lir-make-filled-vector n init)
  (let ((v (make-vector n)))
    (let loop ((i 0))
      (if (< i n)
          (begin
            (vector-set! v i init)
            (loop (+ i 1)))
          v))))

(define (lir-has-nested-blocks? insts)
  (let loop ((xs insts))
    (if (null? xs)
        #f
        (let ((inst (car xs)))
          (if (and (pair? inst)
                   (eq? (car inst) '%block)
                   (pair? (cdr inst))
                   (pair? (cddr inst))
                   (pair? (cdddr inst)))
              #t
              (loop (cdr xs)))))))

(define (lir-peephole-stack-op-subst-safe? inst)
  (and (pair? inst)
       (case (car inst)
         ((%cmp %raw-cmp %bit-and %bit-or %bit-xor
           %add %raw-add %sub %raw-sub %imul %raw-mul
           %mov %add-overflow %sub-overflow %mul-overflow)
          #t)
         (else #f))))

(define (lir-peephole-replace-stack-in-opnd opnd off reg)
  (if (and (pair? opnd)
           (eq? (car opnd) '%stack)
           (pair? (cdr opnd))
           (null? (cddr opnd))
           (eqv? (cadr opnd) off))
      reg
      opnd))

(define (lir-peephole-subst-stack-read inst off reg)
  (let ((op (car inst)))
    (case op
      ((%cmp %raw-cmp)
       (if (= (length inst) 3)
           (let ((a1 (lir-peephole-replace-stack-in-opnd (cadr inst) off reg))
                 (a2 (lir-peephole-replace-stack-in-opnd (caddr inst) off reg)))
             (if (and (eq? a1 (cadr inst)) (eq? a2 (caddr inst)))
                 inst
                 (list op a1 a2)))
           inst))
      ((%bit-and %bit-or %bit-xor %add %raw-add %sub %raw-sub %imul %raw-mul %mov)
       (if (and (= (length inst) 3) (lir-peephole-reg? (cadr inst)))
           (let ((a2 (lir-peephole-replace-stack-in-opnd (caddr inst) off reg)))
             (if (eq? a2 (caddr inst))
                 inst
                 (list op (cadr inst) a2)))
           inst))
      ((%add-overflow %sub-overflow %mul-overflow)
       (if (= (length inst) 5)
           (let* ((d (cadr inst))
                  (f (caddr inst))
                  (s1 (cadddr inst))
                  (s2 (list-ref inst 4))
                  (ns1 (lir-peephole-replace-stack-in-opnd s1 off reg))
                  (ns2 (lir-peephole-replace-stack-in-opnd s2 off reg)))
             (if (and (eq? ns1 s1) (eq? ns2 s2))
                 inst
                 (list op d f ns1 ns2)))
           inst))
      (else inst))))

(define (lir-dse-linear-eliminate-dead-stack-stores insts)
  (let* ((has-escape?
          (let loop ((xs insts))
            (and (pair? xs)
                 (or (lir-dse-inst-escapes-rsp? (car xs))
                     (loop (cdr xs))))))
         (has-barrier?
          (let loop ((xs insts))
            (and (pair? xs)
                 (or (lir-inst-memory-barrier? (car xs))
                     (lir-dse-inst-modifies-rsp? (car xs))
                     (loop (cdr xs))))))
         (leaf-info (if (and (not has-escape?) (not has-barrier?))
                        (lir-dse-collect-leaf-reads insts)
                        (cons #t '())))
         (leaf-exact-reads? (not (car leaf-info)))
         (leaf-read-ivs (cdr leaf-info)))
    (let loop ((xs (reverse insts))
               (live '(all-except))
               (acc '())
               (changed? #f))
      (if (null? xs)
          (if changed? acc insts)
          (let* ((inst (car xs))
                 (st (let ((r (lir-dse-neg-store-range inst)))
                       (and r (not (lir-dse-tree-contains-sym? inst '%stack)) r))))
            (if st
                (let* ((lo (car st))
                       (hi (cdr st))
                       (dead? (or (and leaf-exact-reads?
                                       (not (lir-iv-overlaps? leaf-read-ivs lo hi)))
                                  (lir-dse-live-dead? live lo hi))))
                  (if dead?
                      (loop (cdr xs) live acc #t)
                      (loop (cdr xs) (lir-dse-live-mark-written live lo hi) (cons inst acc) changed?)))
                (let ((next-live
                       (cond
                         ((and (pair? inst) (eq? (car inst) '%return))
                          (lir-dse-fold-stack-opnds (cdr inst) '(exact)))
                         ((or (not (pair? inst))
                              (lir-inst-memory-barrier? inst)
                              (and (lir-inst-terminates-block? inst)
                                   (not (lir-label-inst? inst)))
                              (lir-dse-inst-modifies-rsp? inst))
                          '(all-except))
                         ((lir-dse-rsp-load-range inst)
                          => (lambda (ld)
                               (if (eq? ld 'unknown)
                                   '(all-except)
                                   (lir-dse-fold-inst-stack-opnds
                                    inst
                                    (lir-dse-live-mark-read live (car ld) (cdr ld))))))
                         ((and has-escape? (lir-dse-inst-indirect-read? inst))
                          '(all-except))
                         (else
                          (lir-dse-fold-inst-stack-opnds inst live)))))
                  (loop (cdr xs) next-live (cons inst acc) changed?))))))))

(define (lir-dse-cfg-hard-barrier? inst)
  (and (pair? inst)
       (or (lir-dse-inst-modifies-rsp? inst)
           (case (car inst)
             ((%push %pop %memory-fence %capture-cc %store-values-buf
               %push-handler %pop-handler %dispatch-consumer %syscall
               %c-call %call-foreign %call-indirect
               %safepoint-poll %managed-safepoint-poll)
              #t)
             (else #f))
           (and (eq? (car inst) '%inline-asm)
                (lir-inline-asm-memory-barrier? inst)))))

(define (lir-dse-call-read-ivs inst prev-nonloc)
  ;; Returns 'all-except or a list of (lo . hi) negative %rsp intervals read by call inst.
  (let ((op (car inst)))
    (cond
      ((eq? op '%direct-call)
       (let* ((lbl (if (pair? (cdr inst)) (cadr inst) #f))
              (frame-shift (if (and (pair? (cdr inst)) (pair? (cddr inst)) (integer? (caddr inst)))
                               (caddr inst)
                               #f))
              (lbl-str (cond ((symbol? lbl) (symbol->raw-name lbl))
                             ((string? lbl) lbl)
                             (else ""))))
         (cond
           ((not frame-shift) 'all-except)
           ((string-starts-with? lbl-str "__ulisp_slow_")
            (if (> frame-shift 0)
                (let ((len (string-length lbl-str)))
                  (cond
                    ((and (>= len 4)
                          (string=? (substring lbl-str (- len 4) len) "_a16")
                          (>= frame-shift 16))
                     (list (cons (+ (- 0 frame-shift) 8) (+ (- 0 frame-shift) 16))))
                    ((and (>= len 3)
                          (string=? (substring lbl-str (- len 3) len) "_a8"))
                     (list (cons (- 0 frame-shift) (+ (- 0 frame-shift) 8))))
                    (else
                     (list (cons (- 0 frame-shift) (+ (- 0 frame-shift) (if (< frame-shift 16) frame-shift 16)))))))
                '()))
           ((and (pair? prev-nonloc)
                 (eq? (car prev-nonloc) '%mov)
                 (pair? (cdr prev-nonloc))
                 (eq? (cadr prev-nonloc) '%rax)
                 (pair? (cddr prev-nonloc))
                 (integer? (caddr prev-nonloc))
                 (>= (caddr prev-nonloc) 0)
                 (= (modulo (caddr prev-nonloc) 4) 0))
            (let ((argc (quotient (caddr prev-nonloc) 4)))
              (if (<= argc 6)
                  '()
                  (let* ((stack-bytes (* 8 (- argc 6)))
                         (lo (- 0 frame-shift))
                         (hi (+ lo stack-bytes)))
                    (if (> hi 0)
                        (if (< lo 0) (list (cons lo 0)) '())
                        (list (cons lo hi)))))))
           (else
            ;; Unknown/unit-test %direct-call without mov rax arg count
            (if (> frame-shift 0)
                (let* ((lo (- 0 frame-shift))
                       (hi (+ lo (if (< frame-shift 64) frame-shift 64))))
                  (list (cons lo hi)))
                '())))))
      ((eq? op '%call-closure)
       (let ((frame-shift (if (and (pair? (cdr inst)) (integer? (cadr inst))) (cadr inst) #f)))
         (cond
           ((not frame-shift) 'all-except)
           ((and (pair? prev-nonloc)
                 (eq? (car prev-nonloc) '%mov)
                 (pair? (cdr prev-nonloc))
                 (eq? (cadr prev-nonloc) '%rax)
                 (pair? (cddr prev-nonloc))
                 (integer? (caddr prev-nonloc))
                 (>= (caddr prev-nonloc) 0)
                 (= (modulo (caddr prev-nonloc) 4) 0))
            (let ((argc (quotient (caddr prev-nonloc) 4)))
              (if (<= argc 6)
                  '()
                  (let* ((stack-bytes (* 8 (- argc 6)))
                         (lo (- 0 frame-shift))
                         (hi (+ lo stack-bytes)))
                    (if (> hi 0)
                        (if (< lo 0) (list (cons lo 0)) '())
                        (list (cons lo hi)))))))
           (else
            (if (> frame-shift 0)
                (let* ((lo (- 0 frame-shift))
                       (hi (+ lo (if (< frame-shift 64) frame-shift 64))))
                  (list (cons lo hi)))
                '())))))
      (else #f))))

(define (lir-dse-live-union l1 l2)
  (cond
    ((eq? l1 l2) l1)
    ((or (eq? (car l1) 'all-except) (eq? (car l2) 'all-except))
     (if (and (eq? (car l1) 'all-except) (eq? (car l2) 'all-except))
         (if (equal? (cdr l1) (cdr l2)) l1 '(all-except))
         '(all-except)))
    ((null? (cdr l1)) l2)
    ((null? (cdr l2)) l1)
    ((equal? l1 l2) l1)
    (else
     (let loop ((xs (cdr l2)) (acc (cdr l1)))
       (if (null? xs)
           (cons 'exact acc)
           (loop (cdr xs) (lir-iv-insert acc (caar xs) (cdar xs))))))))

(define (lir-dse-split-blocks insts)
  ;; Splits flat insts into a list of basic blocks, each block is a list of instructions.
  (let loop ((xs insts) (cur '()) (prev-term? #f) (blks '()))
    (if (null? xs)
        (let ((final-blks (if (null? cur) blks (cons (reverse cur) blks))))
          (reverse final-blks))
        (let ((inst (car xs)))
          (cond
            ((and (pair? cur) (or prev-term? (lir-label-inst? inst)))
             (let ((term? (and (pair? inst)
                               (not (lir-label-inst? inst))
                               (lir-inst-terminates-block? inst))))
               (loop (cdr xs) (list inst) term? (cons (reverse cur) blks))))
            (else
             (let ((term? (and (pair? inst)
                               (not (lir-label-inst? inst))
                               (lir-inst-terminates-block? inst))))
               (loop (cdr xs) (cons inst cur) term? blks))))))))

(define (lir-dse-block-succs insts b num-blks lbl-map)
  (if (null? insts)
      (if (< (+ b 1) num-blks) (list (+ b 1)) '())
      (let loop ((xs insts))
        (if (pair? (cdr xs))
            (loop (cdr xs))
            (let ((last (car xs)))
              (if (not (pair? last))
                  (if (< (+ b 1) num-blks) (list (+ b 1)) '())
                  (let ((op (car last)))
                    (cond
                      ((or (eq? op '%return) (eq? op '%raise))
                       '())
                      ((eq? op '%jump)
                       (let* ((lbl (and (pair? (cdr last)) (cadr last)))
                              (hit (and lbl (assq lbl lbl-map))))
                         (if hit (list (cdr hit)) '())))
                      ((eq? op '%direct-jump)
                       (let* ((lbl (and (pair? (cdr last)) (cadr last)))
                              (hit (and lbl (assq lbl lbl-map))))
                         (if hit (list (cdr hit)) '())))
                      ((or (eq? op '%jump-cond) (eq? op '%jump-if) (eq? op '%jump-if-false))
                       (let* ((lbl (and (pair? (cdr last)) (pair? (cddr last)) (caddr last)))
                              (hit (and lbl (assq lbl lbl-map)))
                              (ft (if (< (+ b 1) num-blks) (list (+ b 1)) '())))
                         (if hit
                             (if (memv (cdr hit) ft) ft (cons (cdr hit) ft))
                             ft)))
                      ((eq? op '%jump-if-zero)
                       (let* ((lbl (and (pair? (cdr last)) (cadr last)))
                              (hit (and lbl (assq lbl lbl-map)))
                              (ft (if (< (+ b 1) num-blks) (list (+ b 1)) '())))
                         (if hit
                             (if (memv (cdr hit) ft) ft (cons (cdr hit) ft))
                             ft)))
                      ((eq? op '%switch)
                       (if (and (pair? (cdr last)) (pair? (cddr last)))
                           (let* ((def-lbl (caddr last))
                                  (dhit (assq def-lbl lbl-map))
                                  (targets0 (if dhit (list (cdr dhit)) '())))
                             (let cloop ((cs (cdddr last)) (targets targets0))
                               (if (not (pair? cs))
                                   targets
                                   (let ((targets1
                                          (if (pair? (car cs))
                                              (let ((chit (assq (cdar cs) lbl-map)))
                                                (if (and chit (not (memv (cdr chit) targets)))
                                                    (cons (cdr chit) targets)
                                                    targets))
                                              targets)))
                                     (cloop (cdr cs) targets1)))))
                           '()))
                      (else
                       (if (< (+ b 1) num-blks) (list (+ b 1)) '()))))))))))

(define (lir-dse-build-prev-nonloc-list blk)
  ;; Returns list aligned with blk where each element is the previous non-%loc inst or #f
  (let loop ((xs blk) (prev #f) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((inst (car xs)))
          (loop (cdr xs)
                (if (and (pair? inst) (eq? (car inst) '%loc)) prev inst)
                (cons prev acc))))))

(define (lir-dse-step-live inst prev-nonloc live)
  (let ((st (let ((r (lir-dse-neg-store-range inst)))
              (and r (not (lir-dse-tree-contains-sym? inst '%stack)) r))))
    (cond
      (st
       (lir-dse-live-mark-written live (car st) (cdr st)))
      ((and (pair? inst) (eq? (car inst) '%return))
       (lir-dse-fold-stack-opnds (cdr inst) '(exact)))
      ((not (pair? inst))
       '(all-except))
      ((lir-dse-cfg-hard-barrier? inst)
       '(all-except))
      ((or (eq? (car inst) '%direct-call) (eq? (car inst) '%call-closure))
       (let ((creads (lir-dse-call-read-ivs inst prev-nonloc)))
         (if (eq? creads 'all-except)
             '(all-except)
             (let loop ((rs creads) (cur live))
               (if (null? rs)
                   (lir-dse-fold-inst-stack-opnds inst cur)
                   (loop (cdr rs) (lir-dse-live-mark-read cur (caar rs) (cdar rs))))))))
      ((lir-dse-rsp-load-range inst)
       => (lambda (ld)
            (if (eq? ld 'unknown)
                '(all-except)
                (lir-dse-fold-inst-stack-opnds
                 inst
                 (lir-dse-live-mark-read live (car ld) (cdr ld))))))
      (else
       (lir-dse-fold-inst-stack-opnds inst live)))))

(define (lir-sp-label-hash lbl)
  (cond
    ((symbol? lbl) (modulo (symbol->hash-idx lbl) 1024))
    ((string? lbl) (modulo (symbol-hash-str lbl) 1024))
    (else 0)))

(define (lir-dse-prune-safepoint-bitmap sp-lbl live sp-updates-box)
  (if (and sp-updates-box sp-lbl)
      (let* ((ht (cdr sp-updates-box))
             (entry (assoc sp-lbl (vector-ref ht (lir-sp-label-hash sp-lbl)))))
        (if entry
            (let* ((frame-shift (cadr entry))
                   (old-bm (caddr entry))
                   (slot-count (quotient frame-shift 8)))
              (cond
                ((= old-bm 0) #f)
                ((and (eq? (car live) 'exact) (null? (cdr live)))
                 (set-car! (cddr entry) 0)
                 (set-car! sp-updates-box #t))
                ((and (fixnum? old-bm) (<= slot-count 29))
                 (let loop ((k 0) (bm old-bm) (pw 1) (new-bm old-bm))
                   (if (or (= bm 0) (>= k slot-count))
                       (if (not (= new-bm old-bm))
                           (begin
                             (set-car! (cddr entry) new-bm)
                             (set-car! sp-updates-box #t)))
                       (let ((has-bit? (= (modulo bm 2) 1)))
                         (if has-bit?
                             (let ((slot-off (- (* k 8) frame-shift)))
                               (if (lir-dse-live-dead? live slot-off (+ slot-off 8))
                                   (loop (+ k 1) (quotient bm 2) (* pw 2) (- new-bm pw))
                                   (loop (+ k 1) (quotient bm 2) (* pw 2) new-bm)))
                             (loop (+ k 1) (quotient bm 2) (* pw 2) new-bm))))))))))))

(define (lir-cfg-eliminate-dead-stack-stores insts sp-table-box)
  (let* ((blk-list (lir-dse-split-blocks insts))
         (num-blks (length blk-list)))
    (if (= num-blks 0)
        insts
        (let* ((blk-vec (%lir-make-filled-vector num-blks '()))
               (rev-blk-vec (%lir-make-filled-vector num-blks '()))
               (prev-vec (%lir-make-filled-vector num-blks '()))
               (rev-prev-vec (%lir-make-filled-vector num-blks '()))
               (succ-vec (%lir-make-filled-vector num-blks '()))
               (live-in (%lir-make-filled-vector num-blks '(exact)))
               (live-out (%lir-make-filled-vector num-blks '(exact)))
               (lbl-map-box (cons '() '())))
          ;; 1. Populate block vectors and label map
          (let init-loop ((bs blk-list) (i 0))
            (if (pair? bs)
                (let* ((blk (car bs))
                       (pvs (lir-dse-build-prev-nonloc-list blk)))
                  (vector-set! blk-vec i blk)
                  (vector-set! rev-blk-vec i (reverse blk))
                  (vector-set! prev-vec i pvs)
                  (vector-set! rev-prev-vec i (reverse pvs))
                  (if (and (pair? blk) (lir-label-inst? (car blk)) (pair? (cdar blk)))
                      (set-car! lbl-map-box (cons (cons (cadar blk) i) (car lbl-map-box))))
                  (init-loop (cdr bs) (+ i 1)))))
          ;; 2. Compute CFG successors
          (let ((lbl-map (car lbl-map-box)))
            (let succ-loop ((i 0))
              (if (< i num-blks)
                  (begin
                    (vector-set! succ-vec i (lir-dse-block-succs (vector-ref blk-vec i) i num-blks lbl-map))
                    (succ-loop (+ i 1))))))
          ;; 3. Iterative backward dataflow fixpoint
          (if (not (and (= num-blks 1) (null? (vector-ref succ-vec 0))))
              (let ((blk0-labeled? (and (pair? (vector-ref blk-vec 0))
                                        (lir-label-inst? (car (vector-ref blk-vec 0))))))
                (let fix ((iter 0))
                  (if (< iter 64)
                      (let ((any-changed-box (cons #f '())))
                        (let blk-loop ((b (- num-blks 1)))
                          (if (>= b 0)
                              (let* ((succs (vector-ref succ-vec b))
                                     (out-l
                                      (if (null? succs)
                                          '(exact)
                                          (let uloop ((ss (cdr succs))
                                                      (acc (vector-ref live-in (car succs))))
                                            (if (null? ss)
                                                acc
                                                (uloop (cdr ss)
                                                       (lir-dse-live-union acc (vector-ref live-in (car ss))))))))
                                     (old-out (vector-ref live-out b))
                                     (out-same? (equal? out-l old-out)))
                                (if (not out-same?)
                                    (vector-set! live-out b out-l))
                                (if (and (or (> b 0) blk0-labeled?)
                                         (or (= iter 0) (not out-same?)))
                                    (let ((in-l
                                           (let iloop ((xs (vector-ref rev-blk-vec b))
                                                       (ps (vector-ref rev-prev-vec b))
                                                       (cur out-l))
                                             (if (null? xs)
                                                 cur
                                                 (iloop (cdr xs) (cdr ps)
                                                        (lir-dse-step-live (car xs) (car ps) cur))))))
                                      (if (not (equal? in-l (vector-ref live-in b)))
                                          (begin
                                            (vector-set! live-in b in-l)
                                            (set-car! any-changed-box #t)))))
                                (blk-loop (- b 1)))))
                        (if (car any-changed-box) (fix (+ iter 1))))))))
          ;; 4. Sweep blocks backwards and drop dead negative %rsp stores + prune stackmaps
          (let sweep-blk ((b (- num-blks 1)) (global-changed? #f) (out-blks '()))
            (if (< b 0)
                (if global-changed?
                    (let flatten ((rbs (reverse out-blks)) (acc '()))
                      (if (null? rbs)
                          acc
                          (flatten (cdr rbs) (append (car rbs) acc))))
                    insts)
                (let* ((blk (vector-ref blk-vec b))
                       (rblk (vector-ref rev-blk-vec b))
                       (rpvs (vector-ref rev-prev-vec b))
                       (out-l (vector-ref live-out b)))
                  (let iloop ((xs rblk)
                              (ps rpvs)
                              (live out-l)
                              (acc '())
                              (bchanged? #f))
                    (if (null? xs)
                        (sweep-blk (- b 1)
                                   (or global-changed? bchanged?)
                                   (cons (if bchanged? acc blk) out-blks))
                        (let* ((inst (car xs))
                               (pinst (car ps))
                               (st (let ((r (lir-dse-neg-store-range inst)))
                                     (and r (not (lir-dse-tree-contains-sym? inst '%stack)) r))))
                          (if st
                              (let ((lo (car st)) (hi (cdr st)))
                                (if (lir-dse-live-dead? live lo hi)
                                    (iloop (cdr xs) (cdr ps) live acc #t)
                                    (iloop (cdr xs) (cdr ps)
                                           (lir-dse-live-mark-written live lo hi)
                                           (cons inst acc)
                                           bchanged?)))
                              (begin
                                (if (and sp-table-box (pair? inst)
                                         (or (eq? (car inst) '%direct-call)
                                             (eq? (car inst) '%call-closure)))
                                    (let ((sp-lbl (cond
                                                    ((and (eq? (car inst) '%direct-call)
                                                          (>= (length inst) 4))
                                                     (cadddr inst))
                                                    ((and (eq? (car inst) '%call-closure)
                                                          (>= (length inst) 3))
                                                     (caddr inst))
                                                    (else #f))))
                                      (lir-dse-prune-safepoint-bitmap sp-lbl live sp-table-box)))
                                (iloop (cdr xs) (cdr ps)
                                       (lir-dse-step-live inst pinst live)
                                       (cons inst acc)
                                       bchanged?)))))))))))))

(define (lir-eliminate-dead-stack-stores-with-sp insts sp-table-box)
  (if (or (null? insts)
          (not (let has-neg? ((xs insts))
                 (and (pair? xs)
                      (or (let ((r (lir-dse-neg-store-range (car xs))))
                            (and r (not (lir-dse-tree-contains-sym? (car xs) '%stack))))
                          (has-neg? (cdr xs)))))))
      insts
      (if (or (not (lir-linear-scan-enabled?))
              (lir-has-nested-blocks? insts)
              (let loop ((xs insts))
                (and (pair? xs)
                     (or (lir-dse-inst-escapes-rsp? (car xs))
                         (lir-dse-inst-modifies-rsp? (car xs))
                         (loop (cdr xs))))))
          (lir-dse-linear-eliminate-dead-stack-stores insts)
          (lir-cfg-eliminate-dead-stack-stores insts sp-table-box))))

(define (lir-eliminate-dead-stack-stores insts)
  (lir-eliminate-dead-stack-stores-with-sp insts #f))

(define (%lir-map-keep-eq proc xs)
  (let loop ((rem xs) (acc '()) (changed? #f))
    (if (null? rem)
        (if changed? (reverse acc) xs)
        (let* ((orig (car rem))
               (mapped (proc orig)))
          (if (eq? mapped orig)
              (loop (cdr rem) (cons orig acc) changed?)
              (loop (cdr rem) (cons mapped acc) #t))))))

(define (%lir-transform-fn-body form body-fn)
  (if (not (pair? form))
      form
      (case (car form)
        ((%lir-function %lir-main)
         (let ((new-rest
                (%lir-map-keep-eq
                 (lambda (sub)
                   (if (and (pair? sub) (eq? (car sub) 'body))
                       (let* ((ob (cdr sub))
                              (nb (body-fn ob)))
                         (if (eq? nb ob) sub (cons 'body nb)))
                       sub))
                 (cdr form))))
           (if (eq? new-rest (cdr form))
               form
               (cons (car form) new-rest))))
        ((%lir-functions)
         (let ((new-fns (%lir-map-keep-eq (lambda (f) (%lir-transform-fn-body f body-fn)) (cdr form))))
           (if (eq? new-fns (cdr form))
               form
               (cons '%lir-functions new-fns))))
        (else form))))

(define (%lir-transform-ir-bodies ir body-fn transform-raw-list?)
  (cond
    ((null? ir) '())
    ((and (pair? ir) (eq? (car ir) '%lir-program))
     (let ((new-clauses (%lir-map-keep-eq (lambda (c) (%lir-transform-fn-body c body-fn)) (cdr ir))))
       (if (eq? new-clauses (cdr ir))
           ir
           (cons '%lir-program new-clauses))))
    ((pair? ir)
     (if (or (eq? (car ir) '%lir-function) (eq? (car ir) '%lir-main))
         (%lir-transform-fn-body ir body-fn)
         (if transform-raw-list? (body-fn ir) ir)))
    (else ir)))

(define (lir-dse-transform-clause form)
  (%lir-transform-fn-body form lir-eliminate-dead-stack-stores))

(define (lir-eliminate-dead-stack-stores-in-ir ir)
  (if (and (pair? ir) (eq? (car ir) '%lir-program) (lir-linear-scan-enabled?))
      (let* ((sp-clause (assq 'stackmaps (cdr ir)))
             (sp-copy (if (and sp-clause (pair? (cdr sp-clause)))
                          (map (lambda (e) (list (car e) (cadr e) (caddr e))) (cadr sp-clause))
                          '()))
             (sp-box (if (pair? sp-copy)
                         (let ((sp-ht (%lir-make-filled-vector 1024 '())))
                           (for-each
                            (lambda (e)
                              (let ((h (lir-sp-label-hash (car e))))
                                (vector-set! sp-ht h (cons e (vector-ref sp-ht h)))))
                            sp-copy)
                           (cons #f sp-ht))
                         #f))
             (dse-fn (lambda (body) (lir-eliminate-dead-stack-stores-with-sp body sp-box)))
             (new-clauses (%lir-map-keep-eq (lambda (c) (%lir-transform-fn-body c dse-fn)) (cdr ir))))
        (if (and (eq? new-clauses (cdr ir))
                 (or (not sp-box) (not (car sp-box))))
            ir
            (cons '%lir-program
                  (if (and sp-box (car sp-box))
                      (map (lambda (c)
                             (if (and (pair? c) (eq? (car c) 'stackmaps))
                                 (list 'stackmaps sp-copy)
                                 c))
                           new-clauses)
                      new-clauses))))
      (%lir-transform-ir-bodies ir lir-eliminate-dead-stack-stores #t)))

;;; -----------------------------------------------------------------------
;;; Linear O(N) Algebraic Zero/Sign-Extension Folding (Issue #935)
;;; -----------------------------------------------------------------------

(define (lir-ext-inst->kind inst)
  (and (pair? inst)
       (= (length inst) 4)
       (lir-peephole-reg? (caddr inst))
       (lir-peephole-reg? (cadddr inst))
       (let ((op (car inst))
             (mty (cadr inst)))
         (case op
           ((%trunc %zext)
            (case mty
              ((i8 u8) 'u8)
              ((i16 u16) 'u16)
              ((i32 u32) 'u32)
              (else #f)))
           ((%sext)
            (case mty
              ((i8) 'i8)
              ((i16) 'i16)
              ((i32) 'i32)
              (else #f)))
           (else #f)))))

(define (lir-ext-kind-width kind)
  (case kind
    ((u8 i8) 8)
    ((u16 i16) 16)
    ((u32 i32 u31) 32)
    (else #f)))

(define (lir-ext-normalize-const kind v)
  (case kind
    ((u8)  (modulo v 256))
    ((u16) (modulo v 65536))
    ((u32) (modulo v 4294967296))
    ((i8)  (let ((m (modulo v 256))) (if (>= m 128) (- m 256) m)))
    ((i16) (let ((m (modulo v 65536))) (if (>= m 32768) (- m 65536) m)))
    ((i32) (let ((m (modulo v 4294967296))) (if (>= m 2147483648) (- m 4294967296) m)))
    (else v)))

(define (lir-ext-fact-subsumes? fact target-kind)
  (cond
    ((not fact) #f)
    ((and (pair? fact) (eq? (car fact) 'const))
     (= (cdr fact) (lir-ext-normalize-const target-kind (cdr fact))))
    (else
     (case fact
       ((u8)  (case target-kind ((u8 u16 i16 u32 i32) #t) (else #f)))
       ((i8)  (case target-kind ((i8 i16 i32) #t) (else #f)))
       ((u16) (case target-kind ((u16 u32 i32) #t) (else #f)))
       ((i16) (or (eq? target-kind 'i16) (eq? target-kind 'i32)))
       ((u31) (or (eq? target-kind 'u32) (eq? target-kind 'i32)))
       ((u32) (eq? target-kind 'u32))
       ((i32) (eq? target-kind 'i32))
       (else #f)))))

(define (lir-ext-reg-overlaps? r1 r2)
  (or (equal? r1 r2)
      (lir-reg-aliases? r1 r2)
      (and (or (eq? r1 '%rax) (eq? r1 '%al)) (or (eq? r2 '%rax) (eq? r2 '%al)))
      (and (or (eq? r1 '%rcx) (eq? r1 '%cl)) (or (eq? r2 '%rcx) (eq? r2 '%cl)))))

(define (lir-ext-env-lookup env reg)
  (let ((hit (assoc reg env)))
    (and hit (cdr hit))))

(define (lir-ext-env-kill env reg)
  (let loop ((xs env) (acc '()))
    (if (null? xs)
        (reverse acc)
        (loop (cdr xs)
              (if (lir-ext-reg-overlaps? (caar xs) reg)
                  acc
                  (cons (car xs) acc))))))

(define (lir-ext-env-set env reg fact)
  (let ((cleaned (lir-ext-env-kill env reg)))
    (if fact
        (cons (cons reg fact) cleaned)
        cleaned)))

(define (lir-ext-env-kill-by-inst env inst)
  (let loop ((xs env) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let* ((r (caar xs))
               (killed?
                (or (lir-inst-defines-reg? inst r)
                    (and (eq? r '%rax) (lir-inst-defines-reg? inst '%al))
                    (and (eq? r '%al) (lir-inst-defines-reg? inst '%rax))
                    (and (eq? r '%rcx) (lir-inst-defines-reg? inst '%cl))
                    (and (eq? r '%cl) (lir-inst-defines-reg? inst '%rcx))
                    (and (pair? inst)
                         (or (eq? (car inst) '%push) (eq? (car inst) '%pop))
                         (eq? r '%rsp)))))
          (loop (cdr xs) (if killed? acc (cons (car xs) acc)))))))

(define (lir-ext-safe-intra-block-op? op)
  (case op
    ((%loc %mov %load %load-byte-zx %load-typed %store %store-byte %store-typed
      %add %raw-add %sub %raw-sub %imul %raw-mul %neg %inc
      %bit-and %bit-or %bit-xor %shl %shr %sar
      %cmp %raw-cmp %setb %setbe %seta %setae %set-boolean
      %cqo %idiv %udiv %urem %trunc %zext %sext
      %fmov %fadd %fsub %fmul %fdiv %fneg %fpext %fptrunc
      %fcmp %fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge
      %sitofp %uitofp %fptosi %fptoui %bitcast-f64-to-i64 %bitcast-i64-to-f64
      %global-addr %global-ref %global-set! %code-ref %str-ref %not %push %pop
      %add-overflow %sub-overflow %mul-overflow
      %box-fixnum %unbox-fixnum %box-flonum %unbox-flonum)
     #t)
    (else #f)))

(define (lir-ext-try-fold-imm-prev acc reg target-kind)
  (let loop ((xs acc) (locs '()))
    (cond
      ((null? xs) #f)
      ((and (pair? (car xs)) (eq? (caar xs) '%loc))
       (loop (cdr xs) (cons (car xs) locs)))
      ((and (pair? (car xs))
            (eq? (caar xs) '%mov)
            (= (length (car xs)) 3)
            (equal? (cadar xs) reg)
            (integer? (caddr (car xs))))
       (let ((nv (lir-ext-normalize-const target-kind (caddr (car xs)))))
         (if (and (not (= nv 0)) (>= nv -2147483648) (<= nv 2147483647))
             (cons nv (append (reverse locs) (cons (list '%mov reg nv) (cdr xs))))
             #f)))
      (else #f))))

(define (lir-ext-try-overwrite-prev acc reg target-w)
  (let loop ((xs acc) (locs '()))
    (cond
      ((null? xs) #f)
      ((and (pair? (car xs)) (eq? (caar xs) '%loc))
       (loop (cdr xs) (cons (car xs) locs)))
      (else
       (let ((pk (lir-ext-inst->kind (car xs))))
         (if (and pk
                  (equal? (caddr (car xs)) reg)
                  (equal? (cadddr (car xs)) reg)
                  (>= (lir-ext-kind-width pk) target-w))
             (append (reverse locs) (cdr xs))
             #f))))))

(define (lir-ext-shr-nonneg v cnt)
  (let loop ((x v) (k (modulo cnt 64)))
    (if (or (<= k 0) (= x 0))
        x
        (loop (quotient x 2) (- k 1)))))

(define (lir-ext-uint-range-fact n)
  (cond
    ((< n 0) #f)
    ((<= n 255) 'u8)
    ((<= n 65535) 'u16)
    ((<= n 2147483647) 'u31)
    ((<= n 4294967295) 'u32)
    (else #f)))

(define (lir-ext-post-inst-env env inst)
  (let ((op (car inst))
        (env1 (lir-ext-env-kill-by-inst env inst)))
    (case op
      ((%mov)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (cond
           ((and (lir-peephole-reg? dst) (integer? src))
            (lir-ext-env-set env1 dst (cons 'const src)))
           ((and (lir-peephole-reg? dst) (lir-peephole-reg? src))
            (lir-ext-env-set env1 dst (lir-ext-env-lookup env src)))
           (else env1))))
      ((%load-typed)
       (let ((mty (cadr inst)) (dst (caddr inst)))
         (if (and (lir-peephole-reg? dst)
                  (case mty ((i8 u8 i16 u16 i32 u32) #t) (else #f)))
             (lir-ext-env-set env1 dst mty)
             env1)))
      ((%load-byte-zx %setb %setbe %seta %setae %fcmp-oeq %fcmp-une %fcmp-olt %fcmp-ole %fcmp-ogt %fcmp-oge)
       (let ((dst (cadr inst)))
         (if (lir-peephole-reg? dst)
             (lir-ext-env-set env1 dst 'u8)
             env1)))
      ((%bit-and)
       (let ((dst (cadr inst)) (src (caddr inst)))
         (if (and (lir-peephole-reg? dst) (integer? src) (>= src 0) (<= src 2147483647))
             (lir-ext-env-set env1 dst (lir-ext-uint-range-fact src))
             env1)))
      ((%shr)
       (if (= (length inst) 4)
           (let* ((dst (cadr inst))
                  (src (caddr inst))
                  (cnt (cadddr inst))
                  (sf (and (lir-peephole-reg? src) (lir-ext-env-lookup env src))))
             (if (lir-peephole-reg? dst)
                 (cond
                   ((case sf ((u8 u16 u31 u32) #t) (else #f))
                    (lir-ext-env-set env1 dst sf))
                   ((and (pair? sf) (eq? (car sf) 'const) (>= (cdr sf) 0))
                    (if (integer? cnt)
                        (lir-ext-env-set env1 dst (cons 'const (lir-ext-shr-nonneg (cdr sf) cnt)))
                        (lir-ext-env-set env1 dst (lir-ext-uint-range-fact (cdr sf)))))
                   (else env1))
                 env1))
           (let* ((dst (cadr inst))
                  (cnt (caddr inst))
                  (df (and (lir-peephole-reg? dst) (lir-ext-env-lookup env dst))))
             (if (lir-peephole-reg? dst)
                 (cond
                   ((case df ((u8 u16 u31 u32) #t) (else #f))
                    (lir-ext-env-set env1 dst df))
                   ((and (pair? df) (eq? (car df) 'const) (>= (cdr df) 0))
                    (if (integer? cnt)
                        (lir-ext-env-set env1 dst (cons 'const (lir-ext-shr-nonneg (cdr df) cnt)))
                        (lir-ext-env-set env1 dst (lir-ext-uint-range-fact (cdr df)))))
                   (else env1))
                 env1))))
      ((%sar)
       (let* ((dst (cadr inst))
              (df (and (lir-peephole-reg? dst) (lir-ext-env-lookup env dst))))
         (if (and (lir-peephole-reg? dst)
                  (case df ((i8 i16 i32 u8 u16 u31 u32) #t) (else #f)))
             (lir-ext-env-set env1 dst df)
             env1)))
      (else env1))))

(define (%lir-copy-prefix insts stop-cell)
  (let loop ((p insts) (acc '()))
    (if (eq? p stop-cell)
        acc
        (loop (cdr p) (cons (car p) acc)))))

(define (lir-fold-redundant-extensions insts)
  (if (or (null? insts)
          (not (let has-ext? ((xs insts))
                 (and (pair? xs)
                      (or (lir-ext-inst->kind (car xs))
                          (has-ext? (cdr xs)))))))
      insts
      (let loop ((xs insts) (env '()) (acc '()) (changed? #f))
        (if (null? xs)
            (if changed? (reverse acc) insts)
            (let* ((inst (car xs))
                   (rest (cdr xs))
                   (tk (lir-ext-inst->kind inst)))
              (cond
                (tk
                 (let* ((dst (caddr inst))
                        (src (cadddr inst))
                        (sf (lir-ext-env-lookup env src)))
                   (cond
                     ((and sf (lir-ext-fact-subsumes? sf tk))
                      (let ((cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                        (if (equal? dst src)
                            (loop rest env cur-acc #t)
                            (loop rest
                                  (lir-ext-env-set env dst sf)
                                  (cons (list '%mov dst src) cur-acc)
                                  #t))))
                     ((equal? dst src)
                      (let* ((cur-acc (if changed? acc (%lir-copy-prefix insts xs)))
                             (imm-fold (lir-ext-try-fold-imm-prev cur-acc dst tk)))
                        (if imm-fold
                            (loop rest
                                  (lir-ext-env-set env dst (cons 'const (car imm-fold)))
                                  (cdr imm-fold)
                                  #t)
                            (let ((trimmed (lir-ext-try-overwrite-prev cur-acc dst (lir-ext-kind-width tk))))
                              (if trimmed
                                  (loop rest
                                        (lir-ext-env-set env dst tk)
                                        (cons inst trimmed)
                                        #t)
                                  (loop rest
                                        (lir-ext-env-set env dst tk)
                                        (if changed? (cons inst acc) acc)
                                        changed?))))))
                     (else
                      (loop rest
                            (lir-ext-env-set env dst tk)
                            (if changed? (cons inst acc) acc)
                            changed?)))))
                ((and (pair? inst) (lir-ext-safe-intra-block-op? (car inst)))
                 (loop rest
                       (lir-ext-post-inst-env env inst)
                       (if changed? (cons inst acc) acc)
                       changed?))
                (else
                 (loop rest '() (if changed? (cons inst acc) acc) changed?))))))))

(define (lir-ext-transform-clause form)
  (%lir-transform-fn-body form lir-fold-redundant-extensions))

(define (lir-fold-redundant-extensions-in-ir ir)
  (%lir-transform-ir-bodies ir lir-fold-redundant-extensions #t))

;;; -----------------------------------------------------------------------
;;; Nanopass DSL Pass: lir-peephole-window-pass (fuse-window-rules) + DSE
;;; -----------------------------------------------------------------------

;; Constants & Arithmetic Intra-Block Folding (Issue #927)
;; Strictly restricted to pure-fixnum imm32 range [-2147483648, 2147483647]
;; so self-hosted 62-bit ULisp bootstrap never allocates or emits bignums.
(define (lir-peephole-imm32? n)
  (and (integer? n) (>= n -2147483648) (<= n 2147483647)))

(define (lir-peephole-eval-unary-const op v)
  (if (not (lir-peephole-imm32? v))
      #f
      (let ((res (cond
                   ((eq? op '%neg) (- 0 v))
                   ((eq? op '%inc) (+ v 1))
                   (else #f))))
        (if (and res (lir-peephole-imm32? res)) res #f))))

(define (lir-peephole-eval-bin-const op v1 v2)
  (cond
    ((or (eq? op '%add) (eq? op '%raw-add))
     (if (and (lir-peephole-imm32? v1) (lir-peephole-imm32? v2))
         (let ((res (+ v1 v2)))
           (if (lir-peephole-imm32? res) res #f))
         #f))
    ((or (eq? op '%sub) (eq? op '%raw-sub))
     (if (and (lir-peephole-imm32? v1) (lir-peephole-imm32? v2))
         (let ((res (- v1 v2)))
           (if (lir-peephole-imm32? res) res #f))
         #f))
    ((or (eq? op '%imul) (eq? op '%raw-mul))
     (if (and (integer? v1) (integer? v2)
              (>= v1 -1000000) (<= v1 1000000)
              (>= v2 -1000000) (<= v2 1000000))
         (let ((res (* v1 v2)))
           (if (lir-peephole-imm32? res) res #f))
         #f))
    ((eq? op '%bit-and)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (<= v2 2147483647))
         (bitwise-and v1 v2)
         #f))
    ((eq? op '%bit-or)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (<= v2 2147483647))
         (bitwise-ior v1 v2)
         #f))
    ((eq? op '%bit-xor)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (<= v2 2147483647))
         (- (bitwise-ior v1 v2) (bitwise-and v1 v2))
         #f))
    ((eq? op '%shl)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (< v2 31))
         (let loop ((x v1) (i 0))
           (cond
             ((>= i v2) x)
             ((> x 1073741823) #f)
             (else (loop (* x 2) (+ i 1)))))
         #f))
    ((eq? op '%shr)
     (if (and (integer? v1) (>= v1 0) (<= v1 2147483647)
              (integer? v2) (>= v2 0) (< v2 32))
         (let loop ((x v1) (i 0))
           (if (>= i v2) x (loop (quotient x 2) (+ i 1))))
         #f))
    ((eq? op '%sar)
     (if (and (lir-peephole-imm32? v1)
              (integer? v2) (>= v2 0) (< v2 32))
         (let loop ((x v1) (i 0))
           (if (>= i v2)
               x
               (loop (if (< x 0)
                         (quotient (- x 1) 2)
                         (quotient x 2))
                     (+ i 1))))
         #f))
    (else #f)))

(define (lir-peephole-fold-int-const-ops insts)
  (if (null? insts)
      insts
      (let loop ((xs insts) (cenv '()) (acc '()) (changed? #f))
        (if (null? xs)
            (if changed? (reverse acc) insts)
            (let ((inst (car xs))
                  (rest (cdr xs)))
              (if (not (pair? inst))
                  (loop rest '() (if changed? (cons inst acc) acc) changed?)
                  (let ((op (car inst)))
                    (cond
                      ((and (eq? op '%mov)
                            (pair? (cdr inst)) (pair? (cddr inst)) (null? (cdddr inst))
                            (lir-peephole-reg? (cadr inst)))
                       (let* ((dst (cadr inst))
                              (src (caddr inst))
                              (c1 (if (null? cenv) '() (lir-ext-env-kill cenv dst))))
                         (cond
                           ((lir-peephole-imm32? src)
                            (loop rest (cons (cons dst src) c1)
                                  (if changed? (cons inst acc) acc) changed?))
                           ((and (pair? c1) (lir-peephole-reg? src) (assq src cenv))
                            => (lambda (h)
                                 (let ((kv (cdr h))
                                       (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                   (loop rest (cons (cons dst kv) c1)
                                         (cons (list '%mov dst kv) cur-acc) #t))))
                           ((and (null? c1) (lir-peephole-reg? src) (assq src cenv))
                            => (lambda (h)
                                 (let ((kv (cdr h))
                                       (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                   (loop rest (cons (cons dst kv) c1)
                                         (cons (list '%mov dst kv) cur-acc) #t))))
                           (else
                            (loop rest c1 (if changed? (cons inst acc) acc) changed?)))))
                      ((and (or (eq? op '%neg) (eq? op '%inc))
                            (pair? (cdr inst)) (null? (cddr inst))
                            (lir-peephole-reg? (cadr inst))
                            (pair? cenv)
                            (assq (cadr inst) cenv))
                       => (lambda (h)
                            (let ((nv (lir-peephole-eval-unary-const op (cdr h))))
                              (if nv
                                  (let ((c1 (cons (cons (cadr inst) nv) (lir-ext-env-kill cenv (cadr inst))))
                                        (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                    (loop rest c1 (cons (list '%mov (cadr inst) nv) cur-acc) #t))
                                  (loop rest (lir-ext-env-kill cenv (cadr inst))
                                        (if changed? (cons inst acc) acc) changed?)))))
                      ((and (case op
                              ((%add %raw-add %sub %raw-sub %imul %raw-mul
                                %bit-and %bit-or %bit-xor %shl %shr %sar)
                               #t)
                              (else #f))
                            (pair? (cdr inst)) (pair? (cddr inst)) (null? (cdddr inst))
                            (lir-peephole-reg? (cadr inst))
                            (pair? cenv)
                            (assq (cadr inst) cenv))
                       => (lambda (h)
                            (let* ((r (cadr inst))
                                   (rhs (caddr inst))
                                   (kv (cond ((integer? rhs) rhs)
                                             ((and (lir-peephole-reg? rhs) (assq rhs cenv))
                                              (cdr (assq rhs cenv)))
                                             (else #f)))
                                   (nv (if kv (lir-peephole-eval-bin-const op (cdr h) kv) #f)))
                              (if nv
                                  (let ((c1 (cons (cons r nv) (lir-ext-env-kill cenv r)))
                                        (cur-acc (if changed? acc (%lir-copy-prefix insts xs))))
                                    (loop rest c1 (cons (list '%mov r nv) cur-acc) #t))
                                  (loop rest (lir-ext-env-kill cenv r)
                                        (if changed? (cons inst acc) acc) changed?)))))
                      ((and (lir-ext-safe-intra-block-op? op)
                            (not (lir-label-inst? inst))
                            (not (lir-inst-terminates-block? inst)))
                       (loop rest
                             (if (null? cenv)
                                 '()
                                 (let kill ((es cenv) (ka '()))
                                   (if (null? es)
                                       (reverse ka)
                                       (kill (cdr es)
                                             (if (lir-inst-defines-reg? inst (caar es))
                                                 ka
                                                 (cons (car es) ka))))))
                             (if changed? (cons inst acc) acc)
                             changed?))
                      (else
                       (loop rest '() (if changed? (cons inst acc) acc) changed?))))))))))

(define (lir-peephole-fold-consts-in-ir ir)
  (%lir-transform-ir-bodies ir lir-peephole-fold-int-const-ops #f))

;;; -----------------------------------------------------------------------
;;; Distance-Independent Intra-Block Stack-Slot Forwarding (Issue #961)
;;; -----------------------------------------------------------------------

(define (lir-fwd-reg-overlaps? r1 r2)
  (or (eq? r1 r2) (lir-ext-reg-overlaps? r1 r2)))

(define (lir-fwd-kill-reg senv reg)
  (let loop ((xs senv) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((v (cdar xs)))
          (loop (cdr xs)
                (if (and (lir-peephole-reg? v) (lir-fwd-reg-overlaps? v reg))
                    acc
                    (cons (car xs) acc)))))))

(define (lir-fwd-kill-slot-range senv lo hi)
  (let loop ((xs senv) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((soff (caar xs)))
          (loop (cdr xs)
                (if (and (< soff hi) (> (+ soff 8) lo))
                    acc
                    (cons (car xs) acc)))))))

(define (lir-regalloc-inst-clobbers-rcx? inst)
  (and (pair? inst)
       (let ((op (car inst)))
         (or (and (eq? op '%load)
                  (= (length inst) 4)
                  (eq? (cadr inst) '%rax)
                  (eq? (caddr inst) '%rax)
                  (or (eqv? (cadddr inst) -1)
                      (eqv? (cadddr inst) 7)))
             (and (memq op '(%shl %shr %sar))
                  (= (length inst) 3)
                  (not (integer? (caddr inst))))
             (eq? op '%uitofp)))))

(define (lir-regalloc-inst-mentions-or-writes? inst reg)
  (or (lir-dse-tree-contains-sym? inst reg)
      (lir-inst-defines-reg? inst reg)
      (and (eq? reg '%rcx)
           (or (lir-dse-tree-contains-sym? inst '%cl)
               (lir-inst-defines-reg? inst '%cl)
               (lir-regalloc-inst-clobbers-rcx? inst)))
      (and (eq? reg '%r9)
           (pair? inst)
           (eq? (car inst) '%uitofp))
      (and (eq? reg '%rax)
           (or (lir-dse-tree-contains-sym? inst '%al)
               (lir-inst-defines-reg? inst '%al)))
      (and (eq? reg '%rdx)
           (pair? inst)
           (memq (car inst) '(%cqo %idiv %udiv %urem %mul-overflow %add-overflow %sub-overflow)))
      (and (eq? reg '%rdi)
           (eq? (current-target-arch) 'aarch64)
           (or (lir-dse-tree-contains-sym? inst '%rax)
               (lir-dse-tree-contains-sym? inst '%al)
               (lir-inst-defines-reg? inst '%rax)))))

(define (lir-fwd-kill-by-inst senv inst)
  (if (null? senv)
      '()
      (let loop ((xs senv) (acc '()))
        (if (null? xs)
            (reverse acc)
            (let ((v (cdar xs)))
              (loop (cdr xs)
                    (if (and (lir-peephole-reg? v)
                             (lir-regalloc-inst-mentions-or-writes? inst v))
                        acc
                        (cons (car xs) acc))))))))

(define (lir-fwd-subst-inst-stack-reads inst senv)
  (if (or (null? senv)
          (not (lir-peephole-stack-op-subst-safe? inst))
          (not (lir-dse-tree-contains-sym? inst '%stack)))
      inst
      (let loop ((xs senv) (cur inst))
        (if (null? xs)
            cur
            (let ((off (caar xs))
                  (val (cdar xs)))
              (if (and (lir-peephole-reg? val) (not (eq? val '%rsp)))
                  (loop (cdr xs) (lir-peephole-subst-stack-read cur off val))
                  (loop (cdr xs) cur)))))))

(define (lir-peephole-has-argc-prologue? insts)
  (let loop ((xs insts))
    (and (pair? xs)
         (let ((inst (car xs)))
           (or (and (pair? inst)
                    (or (and (eq? (car inst) '%store)
                             (= (length inst) 4)
                             (eq? (cadr inst) '%rsp)
                             (eqv? (caddr inst) -16)
                             (eq? (cadddr inst) '%rax))
                        (and (eq? (car inst) '%load)
                             (= (length inst) 4)
                             (eq? (cadr inst) '%rax)
                             (eq? (caddr inst) '%rsp)
                             (eqv? (cadddr inst) -16))))
               (loop (cdr xs)))))))

(define (lir-peephole-has-self-prologue? insts)
  (let loop ((xs insts))
    (and (pair? xs)
         (let ((inst (car xs)))
           (or (and (pair? inst)
                    (eq? (car inst) '%store)
                    (= (length inst) 4)
                    (eq? (cadr inst) '%rsp)
                    (eqv? (caddr inst) -8)
                    (eq? (cadddr inst) '%r10))
               (loop (cdr xs)))))))

(define (lir-forward-stack-slots insts)
  (if (or (null? insts)
          (not (lir-linear-scan-enabled?))
          (lir-has-nested-blocks? insts)
          (let has-mod? ((xs insts))
            (and (pair? xs)
                 (or (lir-dse-inst-modifies-rsp? (car xs))
                     (has-mod? (cdr xs))))))
      insts
      (let ((has-escape?
             (let loop ((xs insts))
               (and (pair? xs)
                    (or (lir-dse-inst-escapes-rsp? (car xs))
                        (loop (cdr xs))))))
            (keep-argc? (lir-peephole-has-argc-prologue? insts)))
        (let loop ((xs insts) (senv '()) (acc '()) (changed? #f))
          (if (null? xs)
              (if changed? (reverse acc) insts)
              (let ((inst (car xs))
                    (rest (cdr xs)))
                (cond
                  ((not (pair? inst))
                   (loop rest '() (if changed? (cons inst acc) acc) changed?))
                  ;; 1. Negative %rsp store
                  ((and (eq? (car inst) '%store)
                        (= (length inst) 4)
                        (eq? (cadr inst) '%rsp)
                        (integer? (caddr inst))
                        (< (caddr inst) 0)
                        (<= (+ (caddr inst) 8) 0))
                   (let* ((off (caddr inst))
                          (src (cadddr inst))
                          (hit (assv off senv)))
                     (if (and hit (equal? (cdr hit) src) (not (and keep-argc? (= off -16))))
                         (loop rest senv (if changed? acc (%lir-copy-prefix insts xs)) #t)
                         (let* ((k0 (lir-fwd-kill-slot-range senv off (+ off 8)))
                                (next-senv
                                 (if (and (not (and keep-argc? (= off -16)))
                                          (or (and (lir-peephole-reg? src) (not (eq? src '%rsp)))
                                              (lir-peephole-imm32? src)))
                                     (cons (cons off src) k0)
                                     k0)))
                           (loop rest next-senv (if changed? (cons inst acc) acc) changed?)))))
                  ;; 2. Negative %rsp load
                  ((and (eq? (car inst) '%load)
                        (= (length inst) 4)
                        (lir-peephole-reg? (cadr inst))
                        (not (eq? (cadr inst) '%rsp))
                        (eq? (caddr inst) '%rsp)
                        (integer? (cadddr inst))
                        (< (cadddr inst) 0)
                        (<= (+ (cadddr inst) 8) 0))
                   (let* ((dst (cadr inst))
                          (off (cadddr inst))
                          (hit (and (not (and keep-argc? (= off -16))) (assv off senv))))
                     (if hit
                         (let ((val (cdr hit)))
                           (if (eq? dst val)
                               (loop rest senv (if changed? acc (%lir-copy-prefix insts xs)) #t)
                               (let* ((cur-acc (if changed? acc (%lir-copy-prefix insts xs)))
                                      (k0 (lir-fwd-kill-reg senv dst))
                                      (next-senv
                                       (if (or (integer? val)
                                               (not (lir-fwd-reg-overlaps? dst val)))
                                           (if (assv off k0) k0 (cons (cons off val) k0))
                                           (cons (cons off dst) k0))))
                                 (loop rest next-senv (cons (list '%mov dst val) cur-acc) #t))))
                         (let* ((k0 (lir-fwd-kill-reg (lir-fwd-kill-slot-range senv off (+ off 8)) dst))
                                (next-senv (if (and keep-argc? (= off -16)) k0 (cons (cons off dst) k0))))
                           (loop rest next-senv (if changed? (cons inst acc) acc) changed?)))))
                  ;; 3. Control/barrier/alloc boundary resets senv
                  ((or (lir-label-inst? inst)
                       (lir-inst-terminates-block? inst)
                       (lir-inst-memory-barrier? inst)
                       (case (car inst)
                         ((%alloc %managed-alloc %box-flonum %inline-asm %atomic-cas! %managed-write-barrier
                           %store-values-buf %set-values-count %dispatch-consumer
                           %push-handler %pop-handler %capture-cc %syscall)
                          #t)
                         (else #f)))
                   (loop rest '() (if changed? (cons inst acc) acc) changed?))
                  ;; 4. General intra-block instruction
                  (else
                   (let* ((ninst (lir-fwd-subst-inst-stack-reads inst senv))
                          (sub-changed? (not (eq? ninst inst)))
                          (cur-acc (cond
                                     (changed? (cons ninst acc))
                                     (sub-changed? (cons ninst (%lir-copy-prefix insts xs)))
                                     (else acc)))
                          (s0 (cond
                                ((and (eq? (car inst) '%store-byte)
                                      (>= (length inst) 4)
                                      (eq? (cadr inst) '%rsp)
                                      (integer? (caddr inst)))
                                 (lir-fwd-kill-slot-range senv (caddr inst) (+ (caddr inst) 1)))
                                ((and (eq? (car inst) '%store-typed)
                                      (>= (length inst) 5)
                                      (eq? (caddr inst) '%rsp)
                                      (integer? (cadddr inst)))
                                 (lir-fwd-kill-slot-range senv (cadddr inst)
                                                          (+ (cadddr inst) (lir-dse-type-width (cadr inst)))))
                                ((and has-escape?
                                      (memq (car inst) '(%store %store-byte %store-typed)))
                                 '())
                                (else senv)))
                          (next-senv (lir-fwd-kill-by-inst s0 ninst)))
                     (loop rest next-senv cur-acc (or changed? sub-changed?)))))))))))

(define (lir-forward-stack-slots-in-ir ir)
  (%lir-transform-ir-bodies ir lir-forward-stack-slots #f))

;;; -----------------------------------------------------------------------
;;; LIR Linear-Scan Stack-Slot Register Allocator (Issue #961)
;;; -----------------------------------------------------------------------

(define (lir-regalloc-any-call-or-gc? inst)
  (and (pair? inst)
       (or (lir-inst-memory-barrier? inst)
           (case (car inst)
             ((%alloc %managed-alloc %box-flonum %inline-asm %atomic-cas!
               %managed-write-barrier %managed-box %managed-unbox
               %store-values-buf %set-values-count %dispatch-consumer
               %push-handler %pop-handler %capture-cc %syscall)
              #t)
             (else #f))
           (lir-dse-inst-modifies-rsp? inst))))

(define (lir-regalloc-caller-pool)
  (if (or (eq? (current-target-arch) 'aarch64)
          (eq? (current-target-arch) 'sbi))
      '(%r8 %r9 %rsi %rcx %rdx)
      '(%r8 %r9 %rsi %rcx %rdx %rdi)))

(define (lir-regalloc-slot-match inst)
  ;; Checks exact 8-byte aligned negative %rsp load/store or single safe (%stack off) ref.
  ;; Returns (kind off) where kind is 'store, 'load, or 'stack, or #f.
  (if (not (pair? inst))
      #f
      (let ((op (car inst)))
        (cond
          ((and (eq? op '%store)
                (= (length inst) 4)
                (eq? (cadr inst) '%rsp)
                (integer? (caddr inst))
                (< (caddr inst) 0)
                (= (modulo (- 0 (caddr inst)) 8) 0)
                (or (and (lir-peephole-reg? (cadddr inst)) (not (eq? (cadddr inst) '%rsp)))
                    (lir-peephole-imm32? (cadddr inst))))
           (list 'store (caddr inst)))
          ((and (eq? op '%load)
                (= (length inst) 4)
                (lir-peephole-reg? (cadr inst))
                (not (eq? (cadr inst) '%rsp))
                (eq? (caddr inst) '%rsp)
                (integer? (cadddr inst))
                (< (cadddr inst) 0)
                (= (modulo (- 0 (cadddr inst)) 8) 0))
           (list 'load (cadddr inst)))
          ((and (lir-peephole-stack-op-subst-safe? inst)
                (lir-dse-tree-contains-sym? inst '%stack))
           ;; Extract negative integer offset if only in read positions
           (let check-args ((as (if (memq op '(%cmp %raw-cmp))
                                    (cdr inst)
                                    (if (memq op '(%add-overflow %sub-overflow %mul-overflow))
                                        (cdddr inst)
                                        (if (= (length inst) 3) (cddr inst) '()))))
                            (offs '())
                            (ok? #t))
             (cond
               ((not ok?) #f)
               ((pair? as)
                (let ((a (car as)))
                  (if (and (pair? a) (eq? (car a) '%stack) (pair? (cdr a)) (null? (cddr a)))
                      (if (and (integer? (cadr a))
                               (< (cadr a) 0)
                               (= (modulo (- 0 (cadr a)) 8) 0))
                          (check-args (cdr as)
                                      (if (memv (cadr a) offs) offs (cons (cadr a) offs))
                                      #t)
                          (check-args (cdr as) offs #f))
                      (if (lir-dse-tree-contains-sym? a '%stack)
                          (check-args (cdr as) offs #f)
                          (check-args (cdr as) offs #t)))))
               ((and (= (length offs) 1)
                     (or (memq op '(%cmp %raw-cmp))
                         (not (lir-dse-tree-contains-sym? (cadr inst) '%stack))))
                (list 'stack (car offs)))
               (else #f))))
          (else #f)))))

(define (lir-regalloc-rewrite-inst inst off cand)
  (let ((op (car inst)))
    (cond
      ((and (eq? op '%store)
            (= (length inst) 4)
            (eq? (cadr inst) '%rsp)
            (eqv? (caddr inst) off))
       (let ((src (cadddr inst)))
         (if (eq? src cand) '() (list (list '%mov cand src)))))
      ((and (eq? op '%load)
            (= (length inst) 4)
            (eq? (caddr inst) '%rsp)
            (eqv? (cadddr inst) off))
       (let ((dst (cadr inst)))
         (if (eq? dst cand) '() (list (list '%mov dst cand)))))
      ((lir-peephole-stack-op-subst-safe? inst)
       (list (lir-peephole-subst-stack-read inst off cand)))
      (else (list inst)))))

(define (lir-regalloc-mark-unsafe-range lo hi unsafe-box)
  (if (and (integer? lo) (integer? hi))
      (set-car! unsafe-box (lir-iv-insert (car unsafe-box) lo hi))
      (set-car! unsafe-box 'all)))

(define (lir-regalloc-collect-unsafe-ivs-with-mode insts include-call-reads?)
  (let ((unsafe-box (cons '() '())))
    (if (lir-peephole-has-argc-prologue? insts)
        (lir-regalloc-mark-unsafe-range -16 -8 unsafe-box))
    (if (lir-peephole-has-self-prologue? insts)
        (lir-regalloc-mark-unsafe-range -8 0 unsafe-box))
    (let loop ((xs insts) (prev #f))
      (if (null? xs)
          (car unsafe-box)
          (let ((inst (car xs)))
            (cond
              ((eq? (car unsafe-box) 'all) 'all)
              ((not (pair? inst)) (loop (cdr xs) prev))
              ((or (lir-dse-inst-escapes-rsp? inst)
                   (lir-dse-inst-modifies-rsp? inst))
               'all)
              (else
               (let ((op (car inst)))
                 (cond
                   ((memq op '(%block %jump %return %inline-asm))
                    (let scan ((tree (cdr inst)))
                      (cond
                        ((not (pair? tree)) #f)
                        ((eq? (car tree) '%stack)
                         (if (and (pair? (cdr tree)) (integer? (cadr tree)))
                             (lir-regalloc-mark-unsafe-range (cadr tree) (+ (cadr tree) 8) unsafe-box)
                             (set-car! unsafe-box 'all)))
                        (else
                         (scan (car tree))
                         (if (not (eq? (car unsafe-box) 'all))
                             (scan (cdr tree)))))))
                   ((eq? op '%store-byte)
                    (if (and (>= (length inst) 4) (eq? (cadr inst) '%rsp))
                        (let ((o (caddr inst)))
                          (lir-regalloc-mark-unsafe-range o (and (integer? o) (+ o 1)) unsafe-box))))
                   ((eq? op '%store-typed)
                    (if (and (>= (length inst) 5) (eq? (caddr inst) '%rsp))
                        (let ((o (cadddr inst)))
                          (lir-regalloc-mark-unsafe-range o (and (integer? o) (+ o (lir-dse-type-width (cadr inst)))) unsafe-box))))
                   ((eq? op '%load-byte-zx)
                    (if (and (>= (length inst) 4) (eq? (caddr inst) '%rsp))
                        (let ((o (cadddr inst)))
                          (lir-regalloc-mark-unsafe-range o (and (integer? o) (+ o 1)) unsafe-box))))
                   ((eq? op '%load-typed)
                    (if (and (>= (length inst) 5) (eq? (cadddr inst) '%rsp))
                        (let ((o (list-ref inst 4)))
                          (lir-regalloc-mark-unsafe-range o (and (integer? o) (+ o (lir-dse-type-width (cadr inst)))) unsafe-box))))
                   ((eq? op '%store-values-buf)
                    (if (and (>= (length inst) 3) (integer? (cadr inst)) (integer? (caddr inst)) (> (caddr inst) 0))
                        (let* ((si (cadr inst))
                               (cnt (caddr inst))
                               (lo (- si (* (- cnt 1) 8)))
                               (hi (+ si 8)))
                          (lir-regalloc-mark-unsafe-range lo hi unsafe-box))
                        (set-car! unsafe-box 'all)))
                   ((eq? op '%dispatch-consumer)
                    (if (and (>= (length inst) 3) (integer? (cadr inst)) (integer? (caddr inst)))
                        (begin
                          (lir-regalloc-mark-unsafe-range (cadr inst) (+ (cadr inst) 8) unsafe-box)
                          (lir-regalloc-mark-unsafe-range (- (caddr inst) 32) (+ (caddr inst) 32) unsafe-box))
                        (set-car! unsafe-box 'all)))
                   ((eq? op '%syscall)
                    (if (and (>= (length inst) 2) (integer? (cadr inst)))
                        (lir-regalloc-mark-unsafe-range (- (cadr inst) 48) (+ (cadr inst) 8) unsafe-box)
                        (set-car! unsafe-box 'all)))
                   ((memq op '(%push-handler %pop-handler %capture-cc))
                    (set-car! unsafe-box 'all))
                   ((or (eq? op '%direct-call) (eq? op '%call-closure))
                    (let ((creads (lir-dse-call-read-ivs inst prev)))
                      (if (eq? creads 'all-except)
                          (set-car! unsafe-box 'all)
                          (if include-call-reads?
                              (for-each (lambda (iv) (lir-regalloc-mark-unsafe-range (car iv) (cdr iv) unsafe-box))
                                        creads)))))
                   ((lir-dse-tree-contains-sym? inst '%stack)
                    (if (not (lir-regalloc-slot-match inst))
                        (let scan2 ((tree inst))
                          (cond
                            ((not (pair? tree)) #f)
                            ((eq? (car tree) '%stack)
                             (if (and (pair? (cdr tree)) (integer? (cadr tree)))
                                 (lir-regalloc-mark-unsafe-range (cadr tree) (+ (cadr tree) 8) unsafe-box)
                                 (set-car! unsafe-box 'all)))
                            (else
                             (scan2 (car tree))
                             (if (not (eq? (car unsafe-box) 'all))
                                 (scan2 (cdr tree)))))))))
                 (loop (cdr xs) (if (eq? op '%loc) prev inst))))))))))

(define (lir-regalloc-collect-unsafe-ivs insts)
  (lir-regalloc-collect-unsafe-ivs-with-mode insts #t))

(define (lir-regalloc-slot-safe? off unsafe-ivs)
  (and (not (eq? unsafe-ivs 'all))
       (not (lir-iv-overlaps? unsafe-ivs off (+ off 8)))))

(cond-expand
  (gauche
   (define bitwise-ior logior)
   (define bitwise-and logand))
  (else))

(define (lir-regalloc-reg-bit r)
  (case r
    ((%r8) 1)
    ((%r9) 2)
    ((%rsi) 4)
    ((%rcx %cl) 8)
    ((%rdx) 16)
    ((%rdi) 32)
    ((%r13) 64)
    ((%r14) 128)
    ((%r15) 256)
    (else 0)))

(define (lir-regalloc-tree-reg-mask tree)
  (let ((aarch64? (eq? (current-target-arch) 'aarch64))
        (m-box (cons 0 '())))
    (let scan ((t tree))
      (cond
        ((symbol? t)
         (let ((b (lir-regalloc-reg-bit t)))
           (if (> b 0)
               (set-car! m-box (bitwise-ior (car m-box) b))
               (if (and aarch64? (or (eq? t '%rax) (eq? t '%al)))
                   (set-car! m-box (bitwise-ior (car m-box) 32))))))
        ((pair? t)
         (scan (car t))
         (scan (cdr t)))))
    (car m-box)))

(define (lir-regalloc-inst-reg-mask inst)
  ;; Single O(|inst|) scan returning bitmask of pool registers used/written by inst.
  (let* ((aarch64? (eq? (current-target-arch) 'aarch64))
         (m (lir-regalloc-tree-reg-mask inst))
         (m1 (if (lir-regalloc-inst-clobbers-rcx? inst) (bitwise-ior m 8) m))
         (op (and (pair? inst) (car inst)))
         (m2 (if (eq? op '%uitofp) (bitwise-ior m1 2) m1))
         (m3 (if (memq op '(%cqo %idiv %udiv %urem %mul-overflow %add-overflow %sub-overflow))
                 (bitwise-ior m2 16)
                 m2))
         (m4 (if (and aarch64? (eq? op '%set-boolean)) (bitwise-ior m3 32) m3)))
    m4))

(define (lir-regalloc-argc->mask argc)
  (cond
    ((<= argc 0) 0)
    ((= argc 1) 32)
    ((= argc 2) 36)
    ((= argc 3) 52)
    ((= argc 4) 60)
    ((= argc 5) 61)
    (else 63)))

(define (lir-regalloc-call-arg-use-mask inst prev-nonloc)
  (let ((op (car inst))
        (aarch64-rax (if (eq? (current-target-arch) 'aarch64) 32 0)))
    (cond
      ((eq? op '%direct-call)
       (let* ((lbl (and (pair? (cdr inst)) (cadr inst)))
              (lbl-str (cond ((symbol? lbl) (symbol->raw-name lbl))
                             ((string? lbl) lbl)
                             (else ""))))
         (cond
           ((string-starts-with? lbl-str "__ulisp_slow_")
            aarch64-rax)
           ((and (pair? prev-nonloc)
                 (eq? (car prev-nonloc) '%mov)
                 (pair? (cdr prev-nonloc))
                 (eq? (cadr prev-nonloc) '%rax)
                 (pair? (cddr prev-nonloc))
                 (integer? (caddr prev-nonloc))
                 (>= (caddr prev-nonloc) 0)
                 (= (modulo (caddr prev-nonloc) 4) 0))
            (lir-regalloc-argc->mask (quotient (caddr prev-nonloc) 4)))
           (else 63))))
      ((memq op '(%call-closure %direct-jump))
       (if (and (pair? prev-nonloc)
                (eq? (car prev-nonloc) '%mov)
                (pair? (cdr prev-nonloc))
                (eq? (cadr prev-nonloc) '%rax)
                (pair? (cddr prev-nonloc))
                (integer? (caddr prev-nonloc))
                (>= (caddr prev-nonloc) 0)
                (= (modulo (caddr prev-nonloc) 4) 0))
           (lir-regalloc-argc->mask (quotient (caddr prev-nonloc) 4))
           63))
      ((and (eq? op '%c-call) (pair? (cdr inst)))
       (let ((cname (cadr inst)))
         (cond
           ((or (equal? cname "ulisp_read_char")
                (equal? cname "ulisp_peek_char")
                (equal? cname "ulisp_flush"))
            0)
           ((or (equal? cname "ulisp_write_char")
                (equal? cname "ulisp_write_string"))
            32)
           (else 63))))
      (else 63))))

(define (lir-regalloc-inst-use-def-masks inst prev-nonloc lbl-map)
  ;; Returns (use-mask . def-mask) for backward register liveness.
  (if (not (pair? inst))
      (cons 0 0)
      (let* ((op (car inst))
             (aarch64? (eq? (current-target-arch) 'aarch64))
             (rax-bit (if aarch64? 32 0)))
        (cond
          ;; Pure-write 1st-operand instructions
          ((and (case op
                  ((%mov %load %load-byte-zx %code-ref %str-ref %global-ref %global-addr
                    %alloc-stack %box-fixnum %unbox-fixnum %fptosi %fptoui %bitcast-f64-to-i64
                    %setb %setbe %seta %setae %set-boolean)
                   #t)
                  (else #f))
                (pair? (cdr inst))
                (lir-peephole-reg? (cadr inst)))
           (let* ((dst (cadr inst))
                  (db0 (let ((b (lir-regalloc-reg-bit dst)))
                         (if (and (= b 0) (or (eq? dst '%rax) (eq? dst '%al))) rax-bit b)))
                  (db1 (if (lir-regalloc-inst-clobbers-rcx? inst) (bitwise-ior db0 8) db0))
                  (db2 (if (and aarch64? (eq? op '%set-boolean)) (bitwise-ior db1 32) db1))
                  (ub (lir-regalloc-tree-reg-mask (cddr inst))))
             (cons ub db2)))
          ;; Pure-write 2nd-operand instructions
          ((and (case op
                  ((%trunc %zext %sext %load-typed) #t)
                  (else #f))
                (pair? (cdr inst))
                (pair? (cddr inst))
                (lir-peephole-reg? (caddr inst)))
           (let* ((dst (caddr inst))
                  (db (let ((b (lir-regalloc-reg-bit dst)))
                        (if (and (= b 0) (or (eq? dst '%rax) (eq? dst '%al))) rax-bit b)))
                  (ub (lir-regalloc-tree-reg-mask (cdddr inst))))
             (cons ub db)))
          ;; 4-operand overflow instructions: (op dst flag s1 s2)
          ((and (memq op '(%add-overflow %sub-overflow %mul-overflow))
                (>= (length inst) 5))
           (let ((db (bitwise-ior 16
                                  (bitwise-ior (lir-regalloc-reg-bit (cadr inst))
                                               (lir-regalloc-reg-bit (caddr inst)))))
                 (ub (lir-regalloc-tree-reg-mask (cdddr inst))))
             (cons ub db)))
          ;; Calls & external tail jumps use exact ABI argument regs and clobber caller-saved (63)
          ((memq op '(%direct-call %call-closure %c-call %call-foreign %call-indirect
                      %dispatch-consumer %tail-call-closure))
           (cons (bitwise-ior (lir-regalloc-call-arg-use-mask inst prev-nonloc)
                              (lir-regalloc-tree-reg-mask inst))
                 63))
          ((eq? op '%direct-jump)
           (if (and (pair? (cdr inst)) (assq (cadr inst) lbl-map))
               (cons 0 0)
               (cons (bitwise-ior (lir-regalloc-call-arg-use-mask inst prev-nonloc)
                                  (lir-regalloc-tree-reg-mask inst))
                     63)))
          ((lir-regalloc-any-call-or-gc? inst)
           (cons (bitwise-ior (lir-regalloc-tree-reg-mask inst)
                              (if (lir-regalloc-inst-clobbers-rcx? inst) 8 0))
                 63))
          (else
           (let ((tm (lir-regalloc-tree-reg-mask inst)))
             (cons (bitwise-ior tm (if (lir-regalloc-inst-clobbers-rcx? inst) 8 0))
                   (lir-regalloc-inst-reg-mask inst))))))))

(define (lir-regalloc-compute-global-reg-masks ivec n lbl-idx)
  ;; Multi-pass backward register liveness across flat instruction vector -> mvec[i].
  (let* ((uvec (%lir-make-filled-vector n 0))
         (dvec (%lir-make-filled-vector n 0))
         (mvec (%lir-make-filled-vector n 0))
         (lbl-live-box (cons (map (lambda (e) (cons (car e) 0)) lbl-idx) '())))
    (let init ((i 0) (prev #f))
      (if (< i n)
          (let* ((inst (vector-ref ivec i))
                 (ud (lir-regalloc-inst-use-def-masks inst prev lbl-idx)))
            (vector-set! uvec i (car ud))
            (vector-set! dvec i (cdr ud))
            (init (+ i 1)
                  (if (and (pair? inst) (eq? (car inst) '%loc)) prev inst)))))
    (let pass-loop ((pass 0))
      (if (< pass 4)
          (let ((changed-box (cons #f '())))
            (let iloop ((i (- n 1)) (r-cur 0))
              (if (>= i 0)
                  (let* ((inst (vector-ref ivec i))
                         (op (if (pair? inst) (car inst) #f))
                         (r-after
                          (cond
                            ((or (eq? op '%return) (eq? op '%raise) (eq? op '%tail-call-closure))
                             0)
                            ((eq? op '%jump)
                             (let ((hit (and (pair? (cdr inst)) (assq (cadr inst) (car lbl-live-box)))))
                               (if hit (cdr hit) 0)))
                            ((eq? op '%direct-jump)
                             (let ((hit (and (pair? (cdr inst)) (assq (cadr inst) (car lbl-live-box)))))
                               (if hit (cdr hit) 0)))
                            ((or (eq? op '%jump-cond) (eq? op '%jump-if) (eq? op '%jump-if-false))
                             (let ((hit (and (pair? (cdr inst)) (pair? (cddr inst))
                                             (assq (caddr inst) (car lbl-live-box)))))
                               (if hit (bitwise-ior r-cur (cdr hit)) r-cur)))
                            ((eq? op '%jump-if-zero)
                             (let ((hit (and (pair? (cdr inst)) (assq (cadr inst) (car lbl-live-box)))))
                               (if hit (bitwise-ior r-cur (cdr hit)) r-cur)))
                            ((eq? op '%switch)
                             (if (and (pair? (cdr inst)) (pair? (cddr inst)))
                                 (let* ((dhit (assq (caddr inst) (car lbl-live-box)))
                                        (r0 (if dhit (bitwise-ior r-cur (cdr dhit)) r-cur)))
                                   (let sloop ((cs (cdddr inst)) (acc r0))
                                     (if (not (pair? cs))
                                         acc
                                         (let ((chit (and (pair? (car cs))
                                                          (assq (cdar cs) (car lbl-live-box)))))
                                           (sloop (cdr cs)
                                                  (if chit (bitwise-ior acc (cdr chit)) acc))))))
                                 r-cur))
                            (else r-cur)))
                         (u (vector-ref uvec i))
                         (d (vector-ref dvec i))
                         (r-in (bitwise-ior u (bitwise-and r-after (- 511 d)))))
                    (vector-set! mvec i (bitwise-ior r-after (bitwise-ior u d)))
                    (if (and (eq? op '%label) (pair? (cdr inst)))
                        (let ((le (assq (cadr inst) (car lbl-live-box))))
                          (if (and le (not (= (cdr le) r-in)))
                              (begin
                                (set-cdr! le r-in)
                                (set-car! changed-box #t)))))
                    (iloop (- i 1) r-in))))
            (if (car changed-box)
                (pass-loop (+ pass 1))))))
    mvec))

(define (lir-regalloc-pick-free-reg ivec mask-vec start end pool assigned-regs)
  (let* ((avail-init
          (let loop ((ps pool) (m 0))
            (if (null? ps)
                m
                (let ((r (car ps)))
                  (if (let aloop ((as assigned-regs))
                        (and (pair? as)
                             (let ((a (car as)))
                               (or (and (eq? (car a) r)
                                        (<= (cadr a) end)
                                        (<= start (caddr a)))
                                   (aloop (cdr as))))))
                      (loop (cdr ps) m)
                      (loop (cdr ps) (bitwise-ior m (lir-regalloc-reg-bit r))))))))
         (avail-rem
          (if (= avail-init 0)
              0
              (let cloop ((i start) (avail avail-init))
                (if (or (> i end) (= avail 0))
                    avail
                    (cloop (+ i 1)
                           (bitwise-and avail (- 511 (vector-ref mask-vec i)))))))))
    (if (= avail-rem 0)
        #f
        (let rloop ((ps pool))
          (if (null? ps)
              #f
              (if (not (= (bitwise-and avail-rem (lir-regalloc-reg-bit (car ps))) 0))
                  (car ps)
                  (rloop (cdr ps))))))))

(define (lir-regalloc-local-segments insts unsafe-ivs)
  ;; Promotes closed intra-block [store .. last-use] call-free segments of negative slots.
  (if (not (let has-safe-store? ((xs insts))
             (and (pair? xs)
                  (let ((m (lir-regalloc-slot-match (car xs))))
                    (or (and m (eq? (car m) 'store)
                             (lir-regalloc-slot-safe? (cadr m) unsafe-ivs))
                        (has-safe-store? (cdr xs)))))))
      insts
      (let* ((blk-list (lir-dse-split-blocks insts))
             (num-blks (length blk-list)))
        (if (= num-blks 0)
            insts
        (let* ((blk-vec (%lir-make-filled-vector num-blks '()))
               (rev-blk-vec (%lir-make-filled-vector num-blks '()))
               (prev-vec (%lir-make-filled-vector num-blks '()))
               (rev-prev-vec (%lir-make-filled-vector num-blks '()))
               (rev-ud-vec (%lir-make-filled-vector num-blks '()))
               (succ-vec (%lir-make-filled-vector num-blks '()))
               (live-in (%lir-make-filled-vector num-blks '(exact)))
               (live-out (%lir-make-filled-vector num-blks '(exact)))
               (reg-live-in (%lir-make-filled-vector num-blks 0))
               (reg-live-out (%lir-make-filled-vector num-blks 0))
               (lbl-map-box (cons '() '()))
               (pool (lir-regalloc-caller-pool))
               (any-changed-box (cons #f '()))
               (out-blks-box (cons '() '())))
          (let init ((bs blk-list) (i 0))
            (if (pair? bs)
                (let* ((blk (car bs))
                       (pvs (lir-dse-build-prev-nonloc-list blk)))
                  (vector-set! blk-vec i blk)
                  (vector-set! rev-blk-vec i (reverse blk))
                  (vector-set! prev-vec i pvs)
                  (vector-set! rev-prev-vec i (reverse pvs))
                  (if (and (pair? blk) (lir-label-inst? (car blk)) (pair? (cdar blk)))
                      (set-car! lbl-map-box (cons (cons (cadar blk) i) (car lbl-map-box))))
                  (init (cdr bs) (+ i 1)))))
          (let ((lbl-map (car lbl-map-box)))
            (let udloop ((i 0))
              (if (< i num-blks)
                  (begin
                    (vector-set! rev-ud-vec i
                                 (let udl ((xs (vector-ref rev-blk-vec i))
                                           (ps (vector-ref rev-prev-vec i))
                                           (acc '()))
                                   (if (null? xs)
                                       (reverse acc)
                                       (udl (cdr xs) (cdr ps)
                                            (cons (lir-regalloc-inst-use-def-masks (car xs) (car ps) lbl-map)
                                                  acc)))))
                    (vector-set! succ-vec i (lir-dse-block-succs (vector-ref blk-vec i) i num-blks lbl-map))
                    (udloop (+ i 1))))))
          (if (not (and (= num-blks 1) (null? (vector-ref succ-vec 0))))
              (let ((blk0-labeled? (and (pair? (vector-ref blk-vec 0))
                                        (lir-label-inst? (car (vector-ref blk-vec 0))))))
                (let fix ((iter 0))
                  (if (< iter 64)
                      (let ((chg-box (cons #f '())))
                        (let bloop ((b (- num-blks 1)))
                          (if (>= b 0)
                              (let* ((succs (vector-ref succ-vec b))
                                     (out-l
                                      (if (null? succs)
                                          '(exact)
                                          (let uloop ((ss (cdr succs))
                                                      (acc (vector-ref live-in (car succs))))
                                            (if (null? ss)
                                                acc
                                                (uloop (cdr ss)
                                                       (lir-dse-live-union acc (vector-ref live-in (car ss))))))))
                                     (r-out
                                      (if (null? succs)
                                          0
                                          (let ruloop ((ss succs) (racc 0))
                                            (if (null? ss)
                                                racc
                                                (ruloop (cdr ss) (bitwise-ior racc (vector-ref reg-live-in (car ss))))))))
                                     (old-out (vector-ref live-out b))
                                     (old-rout (vector-ref reg-live-out b))
                                     (out-same? (equal? out-l old-out))
                                     (rout-same? (= r-out old-rout)))
                                (if (not out-same?)
                                    (vector-set! live-out b out-l))
                                (if (not rout-same?)
                                    (vector-set! reg-live-out b r-out))
                                (if (and (or (> b 0) blk0-labeled?)
                                         (or (= iter 0) (not out-same?)))
                                    (let ((in-l
                                           (let iloop ((xs (vector-ref rev-blk-vec b))
                                                       (ps (vector-ref rev-prev-vec b))
                                                       (cur out-l))
                                             (if (null? xs)
                                                 cur
                                                 (iloop (cdr xs) (cdr ps)
                                                        (lir-dse-step-live (car xs) (car ps) cur))))))
                                      (if (not (equal? in-l (vector-ref live-in b)))
                                          (begin (vector-set! live-in b in-l) (set-car! chg-box #t)))))
                                (if (and (or (> b 0) blk0-labeled?)
                                         (or (= iter 0) (not rout-same?)))
                                    (let ((r-in
                                           (let riloop ((uds (vector-ref rev-ud-vec b))
                                                        (rcur r-out))
                                             (if (null? uds)
                                                 rcur
                                                 (let ((u (caar uds))
                                                       (d (cdar uds)))
                                                   (riloop (cdr uds)
                                                           (bitwise-ior u (bitwise-and rcur (- 511 d)))))))))
                                      (if (not (= r-in (vector-ref reg-live-in b)))
                                          (begin (vector-set! reg-live-in b r-in) (set-car! chg-box #t)))))
                                (bloop (- b 1)))))
                        (if (car chg-box) (fix (+ iter 1))))))))
          ;; Process each block for closed store-use segments
          (let bloop ((b (- num-blks 1)))
            (if (< b 0)
                (if (car any-changed-box)
                    (let flatten ((rbs (reverse (car out-blks-box))) (acc '()))
                      (if (null? rbs) acc (flatten (cdr rbs) (append (car rbs) acc))))
                    insts)
                (let* ((blk (vector-ref blk-vec b))
                       (rblk (vector-ref rev-blk-vec b))
                       (rpvs (vector-ref rev-prev-vec b))
                       (ruds (vector-ref rev-ud-vec b))
                       (m (length blk)))
                  (if (< m 2)
                      (begin
                        (set-car! out-blks-box (cons blk (car out-blks-box)))
                        (bloop (- b 1)))
                      (let* ((ivec (%lir-make-filled-vector m '()))
                             (mvec (%lir-make-filled-vector m 0))
                             (lvec (%lir-make-filled-vector m '(exact)))
                             (rev-lives
                              (let lloop ((xs rblk) (ps rpvs)
                                          (cur (vector-ref live-out b)) (acc '()))
                                (if (null? xs)
                                    acc
                                    (lloop (cdr xs) (cdr ps)
                                           (lir-dse-step-live (car xs) (car ps) cur)
                                           (cons cur acc)))))
                             (cands-box (cons '() '())))
                        (let fill ((xs blk) (ls rev-lives) (i 0))
                          (if (pair? xs)
                              (begin
                                (vector-set! ivec i (car xs))
                                (vector-set! lvec i (car ls))
                                (fill (cdr xs) (cdr ls) (+ i 1)))))
                        (let fill-m ((us ruds) (k (- m 1)) (rcur (vector-ref reg-live-out b)))
                          (if (>= k 0)
                              (let* ((u (caar us))
                                     (d (cdar us))
                                     (next-r (bitwise-ior u (bitwise-and rcur (- 511 d)))))
                                (vector-set! mvec k (bitwise-ior rcur (bitwise-ior u d)))
                                (fill-m (cdr us) (- k 1) next-r))))
                        ;; Find closed segments starting at (%store %rsp off src)
                        (let iloop ((i 0))
                          (if (< i m)
                              (begin
                                (let* ((inst (vector-ref ivec i))
                                       (mat (lir-regalloc-slot-match inst)))
                                  (if (and mat (eq? (car mat) 'store)
                                           (lir-regalloc-slot-safe? (cadr mat) unsafe-ivs))
                                      (let ((off (cadr mat)))
                                        (let scan ((j (+ i 1)) (last-use i) (cnt 1) (closed? #f) (aborted? #f))
                                          (if (or aborted? closed? (>= j m))
                                              (let ((ok-closed?
                                                     (and (not aborted?)
                                                          (> cnt 1)
                                                          (or closed?
                                                              (lir-dse-live-dead? (vector-ref lvec last-use) off (+ off 8))))))
                                                (if ok-closed?
                                                    (set-car! cands-box (cons (list off i last-use cnt) (car cands-box)))))
                                              (let ((jinst (vector-ref ivec j)))
                                                (cond
                                                  ((or (lir-label-inst? jinst)
                                                       (lir-inst-terminates-block? jinst)
                                                       (lir-regalloc-any-call-or-gc? jinst))
                                                   (if (lir-dse-live-dead? (vector-ref lvec last-use) off (+ off 8))
                                                       (scan (+ j 1) last-use cnt #t #f)
                                                       (scan (+ j 1) last-use cnt #f #t)))
                                                  (else
                                                   (let ((jmat (lir-regalloc-slot-match jinst)))
                                                     (cond
                                                       ((and jmat (eqv? (cadr jmat) off))
                                                        (if (eq? (car jmat) 'store)
                                                            (scan (+ j 1) last-use cnt #t #f)
                                                            (scan (+ j 1) j (+ cnt 1) #f #f)))
                                                       ((and (pair? jinst)
                                                             (lir-dse-tree-contains-sym? jinst '%rsp)
                                                             (let ((o (lir-dse-neg-store-range jinst)))
                                                               (and o (< (car o) (+ off 8)) (> (cdr o) off))))
                                                        (scan (+ j 1) last-use cnt #f #t))
                                                       (else
                                                        (scan (+ j 1) last-use cnt #f #f))))))))))))
                                (iloop (+ i 1)))))
                        ;; Allocate registers for segments in order of start index
                        (let* ((ordered (reverse (car cands-box)))
                               (assigned-box (cons '() '()))
                               (blk-changed-box (cons #f '()))
                               (rewrites (%lir-make-filled-vector m #f)))
                          (for-each
                           (lambda (seg)
                             (let* ((off (car seg))
                                    (start (cadr seg))
                                    (end (caddr seg))
                                    (cand (lir-regalloc-pick-free-reg ivec mvec start end pool (car assigned-box))))
                               (if cand
                                   (begin
                                     (set-car! blk-changed-box #t)
                                     (set-car! assigned-box (cons (list cand start end) (car assigned-box)))
                                     (let rloop ((k start))
                                       (if (<= k end)
                                           (begin
                                             (let ((km (lir-regalloc-slot-match (vector-ref ivec k))))
                                               (if (and km (eqv? (cadr km) off))
                                                   (vector-set! rewrites k (cons off cand))))
                                             (rloop (+ k 1)))))))))
                           ordered)
                          (if (car blk-changed-box)
                              (begin
                                (set-car! any-changed-box #t)
                                (let build ((k (- m 1)) (bacc '()))
                                  (if (< k 0)
                                      (set-car! out-blks-box (cons bacc (car out-blks-box)))
                                      (let ((rw (vector-ref rewrites k))
                                            (kinst (vector-ref ivec k)))
                                        (if rw
                                            (build (- k 1)
                                                   (append (lir-regalloc-rewrite-inst kinst (car rw) (cdr rw)) bacc))
                                            (build (- k 1) (cons kinst bacc)))))))
                              (set-car! out-blks-box (cons blk (car out-blks-box))))
                          (bloop (- b 1)))))))))))))

(define (lir-regalloc-global-callfree insts unsafe-ivs)
  ;; Promotes whole-function call-free intervals (across branches & leaf loops) into scratch regs.
  (let ((n (length insts)))
    (if (< n 2)
        insts
        (let ((ivec (%lir-make-filled-vector n '()))
              (lbl-idx-box (cons '() '()))
              (slots-box (cons '() '()))
              (has-any-call-box (cons #f '())))
          ;; 1. Index instructions and collect label positions + slots
          (let init ((xs insts) (i 0))
            (if (pair? xs)
                (let ((inst (car xs)))
                  (vector-set! ivec i inst)
                  (if (lir-label-inst? inst)
                      (if (pair? (cdr inst))
                          (set-car! lbl-idx-box (cons (cons (cadr inst) i) (car lbl-idx-box)))))
                  (if (lir-regalloc-any-call-or-gc? inst)
                      (set-car! has-any-call-box #t))
                  (let ((mat (lir-regalloc-slot-match inst)))
                    (if (and mat (lir-regalloc-slot-safe? (cadr mat) unsafe-ivs))
                        (let* ((off (cadr mat))
                               (kind (car mat))
                               (e (assv off (car slots-box))))
                          (if e
                              (begin
                                (set-car! (cddr e) i)
                                (set-car! (cdddr e) (+ (cadddr e) 1))
                                (if (eq? kind 'store)
                                    (set-car! (cddddr e) #t)))
                              ;; entry = (off first last count has-store? first-is-store?)
                              (set-car! slots-box
                                        (cons (list off i i 1 (eq? kind 'store) (eq? kind 'store))
                                              (car slots-box)))))))
                  (init (cdr xs) (+ i 1)))))
          (let ((slots (car slots-box))
                (lbl-idx (car lbl-idx-box))
                (has-any-call? (car has-any-call-box)))
            (if (null? slots)
                insts
                (begin
                  ;; 2. Extend intervals across backward jumps for loop-carried slots
                  (let jloop ((j 0))
                    (if (< j n)
                        (let ((inst (vector-ref ivec j)))
                          (if (pair? inst)
                              (let* ((op (car inst))
                                     (tgt (cond
                                            ((or (eq? op '%jump) (eq? op '%direct-jump) (eq? op '%jump-if-zero))
                                             (and (pair? (cdr inst)) (cadr inst)))
                                            ((or (eq? op '%jump-cond) (eq? op '%jump-if) (eq? op '%jump-if-false))
                                             (and (pair? (cdr inst)) (pair? (cddr inst)) (caddr inst)))
                                            (else #f)))
                                     (hit (and tgt (assq tgt lbl-idx))))
                                (if (and hit (<= (cdr hit) j))
                                    (let ((hdr (cdr hit)))
                                      (for-each
                                       (lambda (s)
                                         (let ((fst (cadr s))
                                               (lst (caddr s)))
                                           (if (and (<= fst j) (>= lst hdr) (< lst j))
                                               (set-car! (cddr s) j))))
                                       slots)))))
                          (jloop (+ j 1)))))
                  ;; Filter eligible call-free slots before computing mvec
                  (let ((eligible-slots
                         (let floop ((ss (reverse slots)) (acc '()))
                           (if (null? ss)
                               (reverse acc)
                               (let* ((s (car ss))
                                      (fst (cadr s))
                                      (lst (caddr s))
                                      (cnt (cadddr s))
                                      (first-store? (car (cdr (cddddr s)))))
                                 (floop (cdr ss)
                                        (if (and first-store? (>= cnt 2)
                                                 (not (let cloop ((k fst))
                                                        (and (<= k lst)
                                                             (or (lir-regalloc-any-call-or-gc? (vector-ref ivec k))
                                                                 (cloop (+ k 1)))))))
                                            (cons s acc)
                                            acc)))))))
                    (if (null? eligible-slots)
                        insts
                        (let ((mvec (lir-regalloc-compute-global-reg-masks ivec n lbl-idx)))
                          ;; 3. Allocate eligible call-free intervals
                          (let* ((caller-pool (lir-regalloc-caller-pool))
                                 (callee-pool '(%r13 %r14 %r15))
                                 (assigned-box (cons '() '()))
                                 (slot-reg-map-box (cons '() '()))
                                 (callee-saves-box (cons '() '())))
                            (for-each
                             (lambda (s)
                               (let* ((off (car s))
                                      (fst (cadr s))
                                      (lst (caddr s))
                                      (cnt (cadddr s))
                                      (cand (lir-regalloc-pick-free-reg ivec mvec fst lst caller-pool (car assigned-box))))
                                 (if cand
                                     (begin
                                       (set-car! assigned-box (cons (list cand fst lst) (car assigned-box)))
                                       (set-car! slot-reg-map-box (cons (cons off cand) (car slot-reg-map-box))))
                                     (if (and (not has-any-call?) (>= cnt 4))
                                         (let ((cs-cand (lir-regalloc-pick-free-reg ivec mvec 0 (- n 1) callee-pool (car assigned-box))))
                                           (if cs-cand
                                               (begin
                                                 (set-car! assigned-box (cons (list cs-cand 0 (- n 1)) (car assigned-box)))
                                                 (set-car! slot-reg-map-box (cons (cons off cs-cand) (car slot-reg-map-box)))
                                                 (set-car! callee-saves-box (cons (cons cs-cand off) (car callee-saves-box))))))))))
                             eligible-slots)
                    (let ((slot-reg-map (car slot-reg-map-box))
                          (callee-saves-used (car callee-saves-box)))
                      (if (null? slot-reg-map)
                          insts
                          (let ((rewritten
                                 (let rloop ((k (- n 1)) (acc '()))
                                   (if (< k 0)
                                       acc
                                       (let* ((inst (vector-ref ivec k))
                                              (mat (lir-regalloc-slot-match inst))
                                              (hit (and mat (assv (cadr mat) slot-reg-map))))
                                         (cond
                                           (hit
                                            (rloop (- k 1)
                                                   (append (lir-regalloc-rewrite-inst inst (car hit) (cdr hit)) acc)))
                                           ((and (pair? callee-saves-used)
                                                 (pair? inst)
                                                 (or (eq? (car inst) '%return)
                                                     (and (eq? (car inst) '%direct-jump)
                                                          (pair? (cdr inst))
                                                          (not (assq (cadr inst) lbl-idx)))))
                                            (let ((restores (map (lambda (cs) (list '%load (car cs) '%rsp (cdr cs)))
                                                                 callee-saves-used)))
                                              (rloop (- k 1) (append restores (cons inst acc)))))
                                           (else
                                            (rloop (- k 1) (cons inst acc)))))))))
                            (if (null? callee-saves-used)
                                rewritten
                                (let ((saves (map (lambda (cs) (list '%store '%rsp (cdr cs) (car cs)))
                                                  callee-saves-used)))
                                   ;; Insert prologue saves before first non-%loc/%label instruction or at entry
                                  (let ploop ((xs rewritten) (head '()))
                                    (if (or (null? xs)
                                            (and (pair? (car xs))
                                                 (not (eq? (caar xs) '%loc))
                                                 (not (lir-label-inst? (car xs)))))
                                        (append (reverse head) (append saves xs))
                                        (ploop (cdr xs) (cons (car xs) head))))))))))))))))))))

(define (lir-regalloc-cleanup-movs insts)
  (let loop ((xs insts) (acc '()))
    (if (null? xs)
        (reverse acc)
        (let ((i1 (car xs))
              (rest (cdr xs)))
          (cond
            ((and (pair? i1)
                  (eq? (car i1) '%mov)
                  (= (length i1) 3)
                  (eq? (cadr i1) (caddr i1)))
             (loop rest acc))
            ((and (pair? i1)
                  (eq? (car i1) '%mov)
                  (= (length i1) 3)
                  (lir-peephole-reg? (cadr i1))
                  (pair? rest)
                  (pair? (car rest))
                  (eq? (caar rest) '%mov)
                  (= (length (car rest)) 3))
             (let ((r1 (cadr i1))
                   (s1 (caddr i1))
                   (r2 (cadar rest))
                   (s2 (caddar rest)))
               (cond
                 ((and (eq? r1 s2) (eq? s1 r2) (lir-peephole-reg? s1))
                  (loop (cons i1 (cdr rest)) acc))
                 ((and (eq? r1 r2)
                       (not (eq? r1 '%rsp))
                       (not (lir-dse-tree-contains-sym? s2 r1)))
                  (loop rest acc))
                 (else
                  (loop rest (cons i1 acc))))))
            (else
             (loop rest (cons i1 acc))))))))

(define (lir-linear-scan-allocate-body insts)
  (if (or (null? insts)
          (not (lir-linear-scan-enabled?))
          (lir-has-nested-blocks? insts))
      insts
      (let ((local-unsafe (lir-regalloc-collect-unsafe-ivs-with-mode insts #f)))
        (if (eq? local-unsafe 'all)
            insts
            (let* ((s1 (lir-regalloc-local-segments insts local-unsafe))
                   (u2 (lir-regalloc-collect-unsafe-ivs-with-mode s1 #t))
                   (s2 (if (eq? u2 'all) s1 (lir-regalloc-global-callfree s1 u2))))
              (if (eq? s2 insts)
                  insts
                  (lir-regalloc-cleanup-movs s2)))))))

(define (lir-linear-scan-allocate-ir ir)
  (if (lir-linear-scan-enabled?)
      (%lir-transform-ir-bodies ir lir-linear-scan-allocate-body #f)
      ir))

(define-pass lir-peephole-window-pass : L_lir_canonical (ir) -> L_lir_canonical ()
  (fuse-window-rules
    rule-lir-self-mov-elim
    rule-lir-self-fmov-elim
    rule-lir-roundtrip-mov-elim
    rule-lir-dead-reg-overwrite-elim
    rule-lir-store-load-forward
    rule-lir-f64-store-load-forward
    rule-lir-jump-next-label-elim
    rule-lir-identity-arith-elim
    rule-lir-identity-mul-elim
    rule-lir-box-unbox-elim
    rule-lir-redundant-loc-elim
    rule-lir-unreachable-dce))

(define (%lir-all-eq? xs ys)
  (cond
    ((eq? xs ys) #t)
    ((and (pair? xs) (pair? ys))
     (and (eq? (car xs) (car ys))
          (%lir-all-eq? (cdr xs) (cdr ys))))
    (else (and (null? xs) (null? ys)))))

(define (%lir-program-bodies-unchanged? a b)
  (cond
    ((eq? a b) #t)
    ((and (pair? a) (pair? b) (eq? (car a) '%lir-program) (eq? (car b) '%lir-program))
     (let ((fa (assq '%lir-functions (cdr a)))
           (fb (assq '%lir-functions (cdr b)))
           (ma (assq '%lir-main (cdr a)))
           (mb (assq '%lir-main (cdr b)))
           (sa (assq 'stackmaps (cdr a)))
           (sb (assq 'stackmaps (cdr b))))
       (and (or (eq? sa sb) (equal? sa sb))
            (or (eq? ma mb) (equal? ma mb))
            (cond
              ((eq? fa fb) #t)
              ((and (pair? fa) (pair? fb))
               (%lir-all-eq? (cdr fa) (cdr fb)))
              (else #f)))))
    (else #f)))

(define (lir-post-window-optimize-program ir)
  (let* ((ls? (lir-linear-scan-enabled?))
         (sp-clause (and ls? (assq 'stackmaps (cdr ir))))
         (sp-copy (if (and sp-clause (pair? (cdr sp-clause)))
                      (map (lambda (e) (list (car e) (cadr e) (caddr e))) (cadr sp-clause))
                      '()))
         (sp-box (if (pair? sp-copy)
                     (let ((sp-ht (%lir-make-filled-vector 1024 '())))
                       (for-each
                        (lambda (e)
                          (let ((h (lir-sp-label-hash (car e))))
                            (vector-set! sp-ht h (cons e (vector-ref sp-ht h)))))
                        sp-copy)
                       (cons #f sp-ht))
                     #f))
         (body-fn (lambda (body)
                    (let* ((b1 (lir-fold-redundant-extensions body))
                           (b2 (lir-forward-stack-slots b1))
                           (b3 (lir-eliminate-dead-stack-stores-with-sp b2 sp-box)))
                      (lir-linear-scan-allocate-body b3))))
         (new-clauses (%lir-map-keep-eq (lambda (c) (%lir-transform-fn-body c body-fn)) (cdr ir))))
    (if (and (eq? new-clauses (cdr ir))
             (or (not sp-box) (not (car sp-box))))
        ir
        (cons '%lir-program
              (if (and sp-box (car sp-box))
                  (map (lambda (c)
                         (if (and (pair? c) (eq? (car c) 'stackmaps))
                             (list 'stackmaps sp-copy)
                             c))
                       new-clauses)
                  new-clauses)))))

(define (lir-peephole-optimize ir)
  (let* ((c1 (lir-peephole-fold-consts-in-ir ir))
         (w1 (lir-peephole-window-pass c1)))
    (if (and (pair? w1) (eq? (car w1) '%lir-program))
        (lir-post-window-optimize-program w1)
        (let* ((e1 (lir-fold-redundant-extensions-in-ir w1))
               (f1 (lir-forward-stack-slots-in-ir e1))
               (d1 (lir-eliminate-dead-stack-stores-in-ir f1))
               (r1 (lir-linear-scan-allocate-ir d1)))
          (if (or (eq? r1 ir) (%lir-program-bodies-unchanged? ir r1))
              ir
              (let* ((c2 (lir-peephole-fold-consts-in-ir r1))
                     (w2 (lir-peephole-window-pass c2))
                     (e2 (lir-fold-redundant-extensions-in-ir w2))
                     (f2 (lir-forward-stack-slots-in-ir e2))
                     (d2 (lir-eliminate-dead-stack-stores-in-ir f2)))
                (lir-peephole-window-pass d2)))))))

(define (optimize-peephole-fixpoint insts)
  (lir-peephole-optimize insts))
