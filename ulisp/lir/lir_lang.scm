;;; =======================================================================
;;; ULisp Compiler: Low-Level IR (LIR) Language Specifications
;;; Active Pipeline Dialects: L_lir_managed -> L_lir_core (Issues #835, #979)
;;; Legacy Schema Dialects:   L_lir_raw -> L_lir_canonical (Issue #593)
;;; Conforms to DSN-33, DSN-38 Architecture Specifications & Issues #593, #753, #826, #835, #979
;;; =======================================================================
;;; Formal intermediate language definitions using Nanopass DSL (define-language):
;;; - L_lir_core:      Active Pure Core Machine LIR without GC, tagging, or managed
;;;                    runtime opcodes. Target for C frontends and Pass 131 output,
;;;                    and the common IR for Pass 132 / Pass 128 / Pass 133.
;;; - L_lir_managed:   Active Managed Runtime Dialect LIR extending L_lir_core with
;;;                    GC allocation (%alloc / %managed-alloc), boxing (%box-*),
;;;                    write barriers, and continuation opcodes (Pass 130 output -> Pass 131 input).
;;; - L_lir_raw:       [Legacy / Deprecated] Pre-Issue #835 unseparated LIR grammar
;;;                    retained only for legacy unit tests and as parent of L_lir_canonical;
;;;                    excluded from Pass Manager pipeline compatibility (Issue #979).
;;; - L_lir_canonical: [Legacy Schema Dialect] L_lir_raw minus (%nop), retained for
;;;                    Tier-1 general LIR schema checks (L_lir_canonical? in lir_verifier.scm),
;;;                    internal define-pass catamorphisms, and serialization tests.
;;; =======================================================================

;;; -----------------------------------------------------------------------
;;; 1. L_lir_core: Pure Core Machine LIR (Issue #835)
;;; -----------------------------------------------------------------------
(define-language L_lir_core
  (entry Program)
  (terminals
    (symbol (x lbl var cond_op sp_lbl mty))
    (integer (n offset shift frame_size tag si cnt bitmap line col al_val))
    (string (str fn_name))
    (boolean (bool_val)))
  (Register (reg)
    %rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp
    %r8  %r9  %r10 %r11 %r12 %r13 %r14 %r15 %al
    %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
    %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15
    (%reg x)
    (%reg mty x)
    (%freg x))
  (StackSlot (stk)
    (%stack offset))
  (MemRef (mem)
    (%mem reg offset)
    (%mem reg reg))
  (LValue (lval)
    reg
    stk
    mem)
  (Operand (opnd)
    lval
    n
    lbl)
  (AsmOutSpec (asm_out)
    (lval str)
    (x str)
    (x str lval))
  (AsmInSpec (asm_in)
    (opnd str)
    (x str opnd))
  (AsmClobber (asm_clob)
    str
    x)
  (AsmClause (asm_clause)
    (:outputs (asm_out ...))
    (:inputs (asm_in ...))
    (:clobbers (asm_clob ...))
    (:volatile? bool_val))
  (Inst (inst)
    ;; Debug & Source Location
    (%loc n line col)

    ;; Control Flow
    (%label lbl)
    (%block lbl (x ...) inst ...)
    (%jump lbl)
    (%jump lbl (opnd ...))
    (%jump-if-false reg lbl)
    (%jump-if-false reg lbl (opnd ...))
    (%jump-if reg lbl1 (opnd1 ...) lbl2 (opnd2 ...))
    (%jump-cond cond_op lbl)
    (%jump-cond str lbl)
    (%jump-if-zero lbl)
    (%direct-jump lbl)
    (%switch opnd lbl (opnd ...) (sc ...))
    (%switch opnd lbl (sc ...))
    (%return)
    (%return opnd)

    ;; Calls & ABI
    (%c-call fn_name shift)
    (%c-call fn_name shift al_val)
    (%call-foreign fn_name shift)
    (%call-foreign fn_name shift al_val)
    (%call-indirect reg shift)
    (%call-indirect reg shift al_val)
    (%call-closure shift)
    (%call-closure shift sp_lbl)
    (%call-closure shift str)
    (%direct-call lbl shift)
    (%direct-call lbl shift sp_lbl)
    (%direct-call lbl shift str)
    (%dispatch-consumer si1 si2 shift)

    ;; Memory & Data Transfer
    (%mov lval opnd)
    (%load reg1 reg2 offset)
    (%store reg1 offset opnd)
    (%load-byte-zx reg1 reg2 offset)
    (%store-byte reg1 offset opnd)
    (%push reg)
    (%pop reg)
    (%code-ref reg lbl)
    (%code-ref reg str)
    (%str-ref reg lbl)
    (%str-ref reg str)
    (%global-ref reg var)
    (%global-addr reg var)
    (%global-set! var reg)

    ;; Arithmetic / Logic / Primitives
    (%add opnd1 opnd2)
    (%raw-add opnd1 opnd2)
    (%sub opnd1 opnd2)
    (%raw-sub opnd1 opnd2)
    (%imul opnd1 opnd2)
    (%raw-mul opnd1 opnd2)
    (%neg opnd)
    (%inc opnd)
    (%cqo)
    (%idiv opnd)
    (%shl opnd shift)
    (%shl opnd %rcx)
    (%shr opnd shift)
    (%shr opnd %rcx)
    (%shr reg opnd shift)
    (%shr reg opnd %rcx)
    (%sar opnd shift)
    (%sar opnd %rcx)
    (%bit-and opnd1 opnd2)
    (%bit-or opnd1 opnd2)
    (%bit-xor opnd1 opnd2)
    (%cmp opnd1 opnd2)
    (%raw-cmp opnd1 opnd2)
    (%set-boolean opnd cond_op)

    ;; Overflow-Checked Arithmetic & Unsigned Operations (Issue #828)
    (%add-overflow reg1 reg2 opnd1 opnd2)
    (%sub-overflow reg1 reg2 opnd1 opnd2)
    (%mul-overflow reg1 reg2 opnd1 opnd2)
    (%udiv opnd)
    (%udiv reg opnd1 opnd2)
    (%urem opnd)
    (%urem reg opnd1 opnd2)
    (%setb reg)
    (%setb reg opnd1 opnd2)
    (%setbe reg)
    (%setbe reg opnd1 opnd2)
    (%seta reg)
    (%seta reg opnd1 opnd2)
    (%setae reg)
    (%setae reg opnd1 opnd2)
    (%load-typed mty reg1 reg2 offset)
    (%store-typed mty reg1 offset opnd)
    (%fmov reg1 reg2)
    (%fadd opnd1 opnd2)
    (%fsub opnd1 opnd2)
    (%fmul opnd1 opnd2)
    (%fdiv opnd1 opnd2)
    (%fcmp opnd1 opnd2)
    (%fneg mty reg1 opnd2)
    (%fpext mty reg1 opnd2)
    (%fptrunc mty reg1 opnd2)
    (%sitofp reg1 opnd2)
    (%uitofp reg1 opnd2)
    (%fptosi reg1 opnd2)
    (%fptoui reg1 opnd2)
    (%fcmp-oeq reg1 opnd2 opnd3)
    (%fcmp-une reg1 opnd2 opnd3)
    (%fcmp-olt reg1 opnd2 opnd3)
    (%fcmp-ole reg1 opnd2 opnd3)
    (%fcmp-ogt reg1 opnd2 opnd3)
    (%fcmp-oge reg1 opnd2 opnd3)
    (%trunc mty reg1 opnd2)
    (%zext mty reg1 opnd2)
    (%sext mty reg1 opnd2)
    (%syscall)
    (%syscall si)
    (%memory-fence)
    (%safepoint-poll)
    (%atomic-cas! reg1 reg2 reg3)
    (%inline-asm str asm_clause ...))
  (StringEntry (se)
    (lbl str)
    (lbl (bytes n ...))
    (str1 str2))
  (DataChunk (dc)
    n
    (zero n)
    (reloc lbl offset))
  (DataEntry (de)
    (bss lbl al_val n)
    (bytes lbl al_val dc ...))
  (SafepointEntry (sm)
    (lbl frame_size bitmap)
    (str frame_size bitmap))
  (SwitchCase (sc)
    (opnd lbl)
    (opnd lbl (opnd ...)))
  (AliasEntry (ae)
    (lbl1 lbl2 bool_val))
  (MetaClause (mc)
    (weak-fns (lbl ...))
    (weak-data (lbl ...))
    (aliases (ae ...))
    (top-asm (str ...)))
  (FunctionDecl (f)
    (%lir-function lbl (params (x ...)) (frame-size frame_size) (body inst ...)))
  (MainDecl (m)
    (%lir-main (frame-size frame_size) (body inst ...)))
  (Program (p)
    (%lir-program (strings (se ...)) (stackmaps (sm ...)) (%lir-functions f ...) m mc ...)
    (%lir-program (strings (se ...)) (data (de ...)) (stackmaps (sm ...)) (%lir-functions f ...) m mc ...)))

;;; -----------------------------------------------------------------------
;;; 2. L_lir_managed: Managed Runtime Dialect LIR (Issue #835)
;;; -----------------------------------------------------------------------
(define-language L_lir_managed
  (extends L_lir_core)
  (entry Program)
  (Inst (inst)
    (+ (%alloc opnd n tag)
       (%alloc opnd n tag si)
       (%alloc-stack opnd offset tag)
       (%managed-alloc opnd n tag)
       (%managed-alloc opnd n tag si)
       (%managed-alloc-stack opnd offset tag)
       (%managed-safepoint-poll)
       (%managed-write-barrier opnd1 offset opnd2)
       (%managed-box mty opnd1 opnd2)
       (%managed-unbox mty opnd1 opnd2)
       (%box-fixnum opnd1 opnd2)
       (%unbox-fixnum opnd1 opnd2)
       (%box-flonum opnd1 opnd2)
       (%unbox-flonum opnd1 opnd2)
       (%capture-cc lbl si)
       (%push-handler lbl si1 si2)
       (%pop-handler si)
       (%raise)
       (%set-values-count cnt)
       (%store-values-buf si cnt))))

;;; -----------------------------------------------------------------------
;;; 2b. L_mir_ssa: Virtual-Register Braun SSA Middle-End IR (Issue #966)
;;; -----------------------------------------------------------------------
(define-language L_mir_ssa
  (extends L_lir_core)
  (entry Program))

;;; -----------------------------------------------------------------------
;;; 2c. L_lir_mach: Physical-Register Machine LIR (Issue #966)
;;; -----------------------------------------------------------------------
(define-language L_lir_mach
  (extends L_mir_ssa)
  (entry Program)
  (Register (reg)
    (- (%reg x)
       (%reg mty x)
       (%freg x))))

;;; -----------------------------------------------------------------------
;;; 3. L_lir_raw: [Legacy / Deprecated] Unseparated Low-Level IR Schema
;;;    Not used in active Pass Manager transitions (see L_lir_managed/L_lir_core).
;;; -----------------------------------------------------------------------
(define-language L_lir_raw
  (entry Program)
  (terminals
    (symbol (x lbl var cond_op sp_lbl mty))
    (integer (n offset shift frame_size tag si cnt bitmap line col al_val))
    (string (str fn_name))
    (boolean (bool_val)))
  (Register (reg)
    %rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp
    %r8  %r9  %r10 %r11 %r12 %r13 %r14 %r15 %al
    %xmm0 %xmm1 %xmm2 %xmm3 %xmm4 %xmm5 %xmm6 %xmm7
    %xmm8 %xmm9 %xmm10 %xmm11 %xmm12 %xmm13 %xmm14 %xmm15
    (%reg x)
    (%reg mty x)
    (%freg x))
  (StackSlot (stk)
    (%stack offset))
  (MemRef (mem)
    (%mem reg offset)
    (%mem reg reg))
  (LValue (lval)
    reg
    stk
    mem)
  (Operand (opnd)
    lval
    n
    lbl)
  (AsmOutSpec (asm_out)
    (lval str)
    (x str)
    (x str lval))
  (AsmInSpec (asm_in)
    (opnd str)
    (x str opnd))
  (AsmClobber (asm_clob)
    str
    x)
  (AsmClause (asm_clause)
    (:outputs (asm_out ...))
    (:inputs (asm_in ...))
    (:clobbers (asm_clob ...))
    (:volatile? bool_val))
  (Inst (inst)
    ;; Pseudo / Raw-Only Instructions
    (%nop)

    ;; Debug & Source Location
    (%loc n line col)

    ;; Control Flow
    (%label lbl)
    (%block lbl (x ...) inst ...)
    (%jump lbl)
    (%jump lbl (opnd ...))
    (%jump-if-false reg lbl)
    (%jump-if-false reg lbl (opnd ...))
    (%jump-if reg lbl1 (opnd1 ...) lbl2 (opnd2 ...))
    (%jump-cond cond_op lbl)
    (%jump-cond str lbl)
    (%jump-if-zero lbl)
    (%direct-jump lbl)
    (%switch opnd lbl (opnd ...) (sc ...))
    (%switch opnd lbl (sc ...))
    (%return)
    (%return opnd)

    ;; Calls & ABI
    (%c-call fn_name shift)
    (%c-call fn_name shift al_val)
    (%call-foreign fn_name shift)
    (%call-foreign fn_name shift al_val)
    (%call-indirect reg shift)
    (%call-indirect reg shift al_val)
    (%call-closure shift)
    (%call-closure shift sp_lbl)
    (%call-closure shift str)
    (%direct-call lbl shift)
    (%direct-call lbl shift sp_lbl)
    (%direct-call lbl shift str)
    (%dispatch-consumer si1 si2 shift)

    ;; Memory & Data Transfer
    (%mov lval opnd)
    (%load reg1 reg2 offset)
    (%store reg1 offset opnd)
    (%load-byte-zx reg1 reg2 offset)
    (%store-byte reg1 offset opnd)
    (%push reg)
    (%pop reg)
    (%code-ref reg lbl)
    (%code-ref reg str)
    (%str-ref reg lbl)
    (%str-ref reg str)
    (%global-ref reg var)
    (%global-addr reg var)
    (%global-set! var reg)

    ;; Arithmetic / Logic / Primitives
    (%add opnd1 opnd2)
    (%raw-add opnd1 opnd2)
    (%sub opnd1 opnd2)
    (%raw-sub opnd1 opnd2)
    (%imul opnd1 opnd2)
    (%raw-mul opnd1 opnd2)
    (%neg opnd)
    (%inc opnd)
    (%cqo)
    (%idiv opnd)
    (%shl opnd shift)
    (%shl opnd %rcx)
    (%shr opnd shift)
    (%shr opnd %rcx)
    (%shr reg opnd shift)
    (%shr reg opnd %rcx)
    (%sar opnd shift)
    (%sar opnd %rcx)
    (%bit-and opnd1 opnd2)
    (%bit-or opnd1 opnd2)
    (%bit-xor opnd1 opnd2)
    (%cmp opnd1 opnd2)
    (%raw-cmp opnd1 opnd2)
    (%set-boolean opnd cond_op)
    (%box-fixnum opnd1 opnd2)
    (%unbox-fixnum opnd1 opnd2)

    ;; Overflow-Checked Arithmetic & Unsigned Operations (Issue #828)
    (%add-overflow reg1 reg2 opnd1 opnd2)
    (%sub-overflow reg1 reg2 opnd1 opnd2)
    (%mul-overflow reg1 reg2 opnd1 opnd2)
    (%udiv opnd)
    (%udiv reg opnd1 opnd2)
    (%urem opnd)
    (%urem reg opnd1 opnd2)
    (%setb reg)
    (%setb reg opnd1 opnd2)
    (%setbe reg)
    (%setbe reg opnd1 opnd2)
    (%seta reg)
    (%seta reg opnd1 opnd2)
    (%setae reg)
    (%setae reg opnd1 opnd2)
    (%load-typed mty reg1 reg2 offset)
    (%store-typed mty reg1 offset opnd)
    (%fmov reg1 reg2)
    (%fadd opnd1 opnd2)
    (%fsub opnd1 opnd2)
    (%fmul opnd1 opnd2)
    (%fdiv opnd1 opnd2)
    (%fcmp opnd1 opnd2)
    (%box-flonum opnd1 opnd2)
    (%unbox-flonum opnd1 opnd2)
    (%fneg mty reg1 opnd2)
    (%fpext mty reg1 opnd2)
    (%fptrunc mty reg1 opnd2)
    (%sitofp reg1 opnd2)
    (%uitofp reg1 opnd2)
    (%fptosi reg1 opnd2)
    (%fptoui reg1 opnd2)
    (%fcmp-oeq reg1 opnd2 opnd3)
    (%fcmp-une reg1 opnd2 opnd3)
    (%fcmp-olt reg1 opnd2 opnd3)
    (%fcmp-ole reg1 opnd2 opnd3)
    (%fcmp-ogt reg1 opnd2 opnd3)
    (%fcmp-oge reg1 opnd2 opnd3)
    (%trunc mty reg1 opnd2)
    (%zext mty reg1 opnd2)
    (%sext mty reg1 opnd2)
    (%syscall)
    (%syscall si)
    (%memory-fence)
    (%safepoint-poll)
    (%atomic-cas! reg1 reg2 reg3)
    (%inline-asm str asm_clause ...)

    ;; Runtime / GC / CC / Values
    (%alloc opnd n tag)
    (%alloc opnd n tag si)
    (%alloc-stack opnd offset tag)
    (%capture-cc lbl si)
    (%push-handler lbl si1 si2)
    (%pop-handler si)
    (%raise)
    (%set-values-count cnt)
    (%store-values-buf si cnt))
  (StringEntry (se)
    (lbl str)
    (lbl (bytes n ...))
    (str1 str2))
  (DataChunk (dc)
    n
    (zero n)
    (reloc lbl offset))
  (DataEntry (de)
    (bss lbl al_val n)
    (bytes lbl al_val dc ...))
  (SafepointEntry (sm)
    (lbl frame_size bitmap)
    (str frame_size bitmap))
  (SwitchCase (sc)
    (opnd lbl)
    (opnd lbl (opnd ...)))
  (AliasEntry (ae)
    (lbl1 lbl2 bool_val))
  (MetaClause (mc)
    (weak-fns (lbl ...))
    (weak-data (lbl ...))
    (aliases (ae ...))
    (top-asm (str ...)))
  (FunctionDecl (f)
    (%lir-function lbl (params (x ...)) (frame-size frame_size) (body inst ...)))
  (MainDecl (m)
    (%lir-main (frame-size frame_size) (body inst ...)))
  (Program (p)
    (%lir-program (strings (se ...)) (stackmaps (sm ...)) (%lir-functions f ...) m mc ...)
    (%lir-program (strings (se ...)) (data (de ...)) (stackmaps (sm ...)) (%lir-functions f ...) m mc ...)))

;;; -----------------------------------------------------------------------
;;; 4. L_lir_canonical: [Legacy Schema Dialect] Post-Peephole Schema (L_lir_raw - %nop)
;;;    Retained for Tier-1 schema checks (L_lir_canonical?) and internal define-pass rules.
;;; -----------------------------------------------------------------------
(define-language L_lir_canonical
  (extends L_lir_raw)
  (entry Program)
  (Inst (inst)
    (- (%nop))))
