;;; =======================================================================
;;; ULisp Compiler Pass 130: Low-Level Intermediate Representation (LIR)
;;; Conforms to DSN-33 Architecture Specification & Issue #583
;;; =======================================================================
;;; Core LIR Orchestrator:
;;; - Accumulator and stack tracking state (*lir-instructions*, *lir-min-si*)
;;; - Environment and raw-variable tracking (get-raw-vars, set-raw-vars, raw-expr?)
;;; - Immediate and variable resolution (immediate?, lir-immediate, lir-compile-variable)
;;; - Expression compiler dispatcher (lir-compile-expr) orchestrating modular sub-passes:
;;;     * Pass 123: LIR Closures & Stack Allocation (passes/123_lir_closures.scm)
;;;     * Pass 124: LIR Procedure Invocations & Call ABI (passes/124_lir_call_abi.scm)
;;;     * Pass 125: LIR Continuation Transfer & Loop In-Place Shuffle (passes/125_lir_continuation.scm)
;;;     * Pass 126: LIR Control Flow & Join Path Splitting (passes/126_lir_control.scm)
;;;     * Pass 127: LIR Runtime & Advanced Features (passes/127_lir_runtime.scm)
;;;     * Pass 128: LIR Branch & Comparison Flag Fusion (passes/128_lir_branch_fusion.scm)
;;;     * Pass 129: LIR Primitive Instruction Selection (passes/129_lir_primitives.scm)
;;; - Function and Program level compilation entrypoints (lir-compile-function, generate-lir)
;;; =======================================================================

;;; Boxed accumulators for LIR instructions and stack tracking
(define *lir-instructions* (cons '() '()))
(define *lir-min-si* (cons 0 '()))
(define *enable-lir-linear-scan* (cons #t '()))
(define (lir-linear-scan-enabled?) (car *enable-lir-linear-scan*))
(define (set-lir-linear-scan-enabled! v) (set-car! *enable-lir-linear-scan* (if v #t #f)))
(define *stack-alloc-attr* (string->symbol ":stack-alloc"))
(define (stack-alloc-attr? attr)
  (or (eq? attr *stack-alloc-attr*)
      (eq? attr 'stack-alloc)
      (and (symbol? attr)
           (let ((s (symbol->string attr)))
             (or (string=? s ":stack-alloc")
                 (string=? s "#:stack-alloc")
                 (string=? s "stack-alloc"))))))
(define (get-raw-vars env)
  (let ((entry (assq '%raw-vars env)))
    (if entry (cdr entry) '())))

(define (set-raw-vars rvars env)
  (cons (cons '%raw-vars rvars) env))

(define (raw-expr? expr raw-env)
  (cond
    ((not (pair? expr))
     (and (symbol? expr) (memq expr raw-env)))
    ((memq (car expr) '(%raw-add %raw-sub %raw-mul %raw-cmp %raw-load %raw-syscall %to-raw %unbox-fixnum
                        %load-typed %fadd %fsub %fmul %fdiv %fcmp %unbox-flonum %sitofp %fptosi
                        %udiv %urem %shr %setb %setbe %seta %setae
                        %add-overflow %sub-overflow %mul-overflow %inline-asm))
     #t)
    ((and (eq? (car expr) '%direct-call)
          (pair? (cdr expr))
          (unboxed-ret-fn? (cadr expr)))
     #t)
    ((and (symbol? (car expr))
          (unboxed-ret-fn? (car expr)))
     #t)
    ((eq? (car expr) 'let)
     (raw-expr? (caddr expr) raw-env))
    ((eq? (car expr) 'if)
     (and (raw-expr? (caddr expr) raw-env)
          (pair? (cdddr expr))
          (raw-expr? (cadddr expr) raw-env)))
    (else #f)))

(define (reset-lir!)
  (set-car! *lir-instructions* '())
  (set-car! *lir-min-si* 0))

(define (emit-lir! inst)
  (set-car! *lir-instructions* (cons inst (car *lir-instructions*))))

(define (track-lir-si! si)
  (if (< si (car *lir-min-si*))
      (set-car! *lir-min-si* si)))

(define (immediate? expr)
  (or (integer? expr)
      (boolean? expr)
      (char? expr)
      (null? expr)
      (string? expr)))

(define (lir-immediate expr)
  (cond
    ((or (integer? expr) (boolean? expr) (char? expr) (null? expr))
     (repr-encode-immediate expr))
    ((string? expr)
     (let ((label (intern-string expr)))
       (list '%string-ref label)))))

(define (lir-compile-immediate expr)
  (if (and (integer? expr)
           (not (repr-nan-boxed-with? (current-value-repr)))
           (= (repr-fixnum-tag) 0)
           (> (repr-fixnum-shift) 0)
           (let ((q (quotient expr 1073741824)))
             (or (>= q 536870912) (<= q -536870912))))
      (begin
        (emit-lir! (list '%mov '%rax expr))
        (emit-lir! (list '%shl '%rax (repr-fixnum-shift))))
      (let ((val (lir-immediate expr)))
        (if (and (pair? val) (eq? (car val) '%string-ref))
            (emit-lir! (list '%str-ref '%rax (cadr val)))
            (emit-lir! (list '%mov '%rax val))))))

(define (lir-compile-variable var env)
  (let ((binding (assq var env)))
    (if (not binding)
        (if (or (allow-extern-symbols?) (stdlib-symbol? var))
            (emit-lir! (list '%global-ref '%rax var))
            (begin
              (dump-lir-unbound-variable-diagnostic var env)
              (error (string-append "Unbound variable in LIR: " (symbol->string var)) var)))
        (let ((info (cdr binding)))
          (cond
            ((number? info)
             (emit-lir! (list '%load '%rax '%rsp info)))
            ((and (pair? info) (eq? (car info) 'reg))
             (let ((reg (cdr info)))
               (if (not (eq? reg '%rax))
                   (emit-lir! (list '%mov '%rax reg)))))
            ((and (symbol? info) (memq info '(%rax %rbx %rcx %rdx %rsi %rdi %rbp %rsp %r8 %r9 %r10 %r11 %r12 %r13 %r14 %r15)))
             (if (not (eq? info '%rax))
                 (emit-lir! (list '%mov '%rax info))))
            ((and (pair? info) (eq? (car info) 'param))
             (emit-lir! (list '%load '%rax '%rsp (cdr info))))
            ((and (pair? info) (eq? (car info) 'self))
             (emit-lir! (list '%load '%rax '%rsp (cdr info))))
            (else
             (error "Invalid binding format in LIR:" binding)))))))

(define (lir-compile-expr expr si env tail?)
  (cond
    ((ast-has-span? expr)
     (let ((span (ast-source-span expr))
           (inner (ast-strip-span expr)))
       (if (and (debug-symbols-enabled?) span)
           (let* ((file (span-effective-file span))
                  (line (span-effective-line span))
                  (col (span-effective-col span)))
             (if (and (string? file) (integer? line) (> line 0))
                 (let ((fid (register-source-file! file)))
                   (emit-lir! (list '%loc fid line col))))))
       (lir-compile-expr inner si env tail?)))
    (else
     (if (pair? expr)
         (set-current-form! expr))
     (cond
       ((immediate? expr)
        (lir-compile-immediate expr))
       ((symbol? expr)
        (lir-compile-variable expr env))
       ((pair? expr)
        (let ((op (car expr)))
          (cond
            ((zero-arg-prim? op)
             (lir-compile-zero-arg op si env))
         ((eq? op '-)
          (if (null? (cddr expr))
              (lir-compile-unary '- (cadr expr) si env)
              (lir-compile-binop '- (cadr expr) (caddr expr) si env)))
         ((unary-prim? op)
          (lir-compile-unary op (cadr expr) si env))
         ((memq op '(%make-closure %make-closure-env))
          (lir-compile-make-closure expr si env))
         ((eq? op '%make-stack-closure)
          (lir-compile-make-stack-closure expr si env))
         ((eq? op '%stack-cons)
          (lir-compile-stack-cons expr si env))
         ((eq? op 'annotate)
          (let ((attr (cadr expr))
                (inner (caddr expr)))
            (cond
              ((stack-alloc-attr? attr)
               (cond
                 ((and (pair? inner) (memq (car inner) '(%make-closure %make-closure-env)))
                  (lir-compile-make-stack-closure inner si env))
                 ((and (pair? inner) (eq? (car inner) 'cons))
                  (lir-compile-stack-cons inner si env))
                 (else
                  (lir-compile-expr inner si env tail?))))
              (else
               (lir-compile-expr inner si env tail?)))))
         ((eq? op '%closure-ref)
          (let* ((idx (caddr expr))
                 (offset (- (* idx 8) 1)))
            (lir-compile-expr (cadr expr) si env #f)
            (emit-lir! (list '%load '%rax '%rax offset))))
         ((eq? op '%closure-set!)
          (let* ((c-expr (cadr expr))
                 (idx (caddr expr))
                 (val-expr (cadddr expr))
                 (offset (- (* idx 8) 1)))
            (track-lir-si! si)
            (lir-compile-expr c-expr si env #f)
            (emit-lir! (list '%store '%rsp si '%rax))
            (track-lir-si! (- si 8))
            (lir-compile-expr val-expr (- si 8) env #f)
            (emit-lir! (list '%load '%rdx '%rsp si))
            (emit-lir! (list '%store '%rdx offset '%rax))
            (emit-lir! '(%mov %rax 63))))
         ;; Typed Machine LIR: Memory Access, FP & Conversions (Issue #826)
         ((eq? op '%load-typed)
          (let ((mty (cadr expr))
                (base-expr (caddr expr))
                (off-expr (cadddr expr)))
            (lir-compile-expr base-expr si env #f)
            (let ((dst-reg (if (memq mty '(f32 f64)) '%xmm0 '%rax)))
              (emit-lir! (list '%load-typed mty dst-reg '%rax off-expr)))))
         ((eq? op '%store-typed)
          (let ((mty (cadr expr))
                (base-expr (caddr expr))
                (off-expr (cadddr expr))
                (val-expr (car (cddddr expr))))
            (track-lir-si! si)
            (lir-compile-expr base-expr si env #f)
            (emit-lir! (list '%store '%rsp si '%rax))
            (track-lir-si! (- si 8))
            (lir-compile-expr val-expr (- si 8) env #f)
            (emit-lir! (list '%load '%rdx '%rsp si))
            (let ((src-opnd (if (memq mty '(f32 f64)) '%xmm0 '%rax)))
              (emit-lir! (list '%store-typed mty '%rdx off-expr src-opnd))
              (emit-lir! '(%mov %rax 63)))))
         ((memq op '(%fadd %fsub %fmul %fdiv %fcmp))
          (let ((e1 (cadr expr))
                (e2 (caddr expr)))
            (track-lir-si! si)
            (lir-compile-expr e1 si env #f)
            (emit-lir! (list '%store '%rsp si '%rax))
            (track-lir-si! (- si 8))
            (lir-compile-expr e2 (- si 8) env #f)
            (emit-lir! '(%fmov %xmm1 %xmm0))
            (emit-lir! (list '%load '%rax '%rsp si))
            (emit-lir! (list op '%xmm0 '%xmm1))))
         ((eq? op '%fmov)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%fmov %xmm0 %xmm1)))
         ((eq? op '%sitofp)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%sitofp %xmm0 %rax)))
         ((eq? op '%fptosi)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%fptosi %rax %xmm0)))
         ((eq? op '%box-flonum)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%alloc %rax 16 3))
          (emit-lir! '(%store-typed f64 %rax 8 %xmm0)))
         ((eq? op '%unbox-flonum)
          (lir-compile-expr (cadr expr) si env #f)
          (emit-lir! '(%load-typed f64 %xmm0 %rax 8)))
         ((memq op '(%trunc %zext %sext))
          (let ((mty (cadr expr))
                (val-expr (caddr expr)))
            (lir-compile-expr val-expr si env #f)
            (emit-lir! (list op mty '%rax '%rax))))
         ((binop-prim? op)
          (lir-compile-binop op (cadr expr) (caddr expr) si env))
         ((triop-prim? op)
          (lir-compile-triop op (cadr expr) (caddr expr) (cadddr expr) si env))
         ((septop-prim? op)
          (lir-compile-raw-syscall (cdr expr) si env))
         ((eq? op '%cont-fun)
          (lir-compile-cont-fun (cadr expr) (caddr expr) (cadddr expr) (cadr (cdddr expr)) si env tail?))
         ((eq? op '%cont-call)
          (lir-compile-cont-call (cadr expr) (cddr expr) si env))
         ((eq? op '%with-handler)
          (lir-compile-with-handler (cadr expr) (caddr expr) si env tail?))
         ((eq? op '%raw-call/cc)
          (lir-compile-raw-call-cc (cadr expr) si env tail?))
         ((eq? op '%values)
          (lir-compile-values (cdr expr) si env))
         ((eq? op '%call-with-values)
          (lir-compile-call-with-values (cadr expr) (caddr expr) si env tail?))
         ((eq? op 'let)
          (lir-compile-let (cadr expr) (caddr expr) si env tail?))
         ;; Stage-Polymorphic Residual ANF Lowering (Issue #889 / DSN-33-03 §6.2)
         ((eq? op 'atom-value)
          (let ((v (cadr expr)))
            (cond
              ((immediate? v) (lir-compile-immediate v))
              ((symbol? v) (lir-compile-variable v env))
              ((pair? v) (lir-compile-expr v si env tail?))
              (else (error "Invalid atom-value in LIR:" v)))))
         ((eq? op 'let-anf)
          (lir-compile-let (cadr expr) (caddr expr) si env tail?))
         ((eq? op 'let-call)
          (let* ((bindings (cadr expr))
                 (body (caddr expr))
                 (b (car bindings))
                 (var (car b))
                 (call-expr (cadr b)))
            (if (and (pair? call-expr) (symbol? (car call-expr)))
                (let* ((callee (car call-expr))
                       (cargs (cdr call-expr)))
                  (if (assq callee env)
                      (lir-compile-let bindings body si env tail?)
                      (let ((direct-binding (list var (cons '%direct-call (cons callee cargs)))))
                        (lir-compile-let (list direct-binding) body si env tail?))))
                (lir-compile-let bindings body si env tail?))))
         ((eq? op 'if-anf)
          (lir-compile-if (cadr expr) (caddr expr) (cdddr expr) si env tail?))
         ((eq? op 'if)
          (lir-compile-if (cadr expr) (caddr expr) (cdddr expr) si env tail?))
         ((eq? op 'begin)
          (lir-compile-begin (cdr expr) si env tail?))
         ((eq? op 'quote)
          (let ((datum (cadr expr)))
            (cond
              ((symbol? datum)
               (let ((id (intern-symbol datum)))
                 (emit-lir! (list '%mov '%rax id))))
              ((immediate? datum)
               (lir-compile-immediate datum))
              ((and (or (pair? datum) (vector? datum))
                    (can-emit-static-quoted-datum? datum))
               (let ((lbl (intern-static-constant! datum)))
                 (emit-lir! (list '%code-ref '%rax lbl))))
              ((pair? datum)
               (lir-compile-expr (list 'cons
                                       (list 'quote (car datum))
                                       (list 'quote (cdr datum)))
                                 si env #f))
              ((vector? datum)
               (lir-compile-expr (desugar-vector
                                  (map (lambda (x) (list 'quote x))
                                       (vector->list datum)))
                                 si env #f))
              (else
               (error "Invalid quoted datum in LIR:" datum)))))
         ((eq? op '%direct-call)
          (lir-compile-direct-call (cadr expr) (cddr expr) si env tail?))
         ((eq? op '%c-call)
          (lir-compile-c-call expr si env tail?))
         ((eq? op '%call-foreign)
          (lir-compile-foreign-call-expr expr si env tail?))
         ((eq? op '%global-ref)
          (emit-lir! (list '%global-ref '%rax (cadr expr))))
         ((eq? op '%global-set!)
          (track-lir-si! si)
          (lir-compile-expr (caddr expr) si env #f)
          (emit-lir! (list '%global-set! (cadr expr) '%rax)))
         ((eq? op '%inline-asm)
          (lir-compile-inline-asm expr si env))
         (else
          ;; General procedure call
          (lir-compile-call op (cdr expr) si env tail?)))))
    (else
     (error "Invalid syntax in LIR compiler:" expr))))))

(define (lir-inline-asm-resolve-var var env)
  (let ((binding (assq var env)))
    (if (not binding)
        var
        (let ((info (cdr binding)))
          (cond
            ((number? info) (list '%stack info))
            ((and (pair? info) (memq (car info) '(param self))) (list '%stack (cdr info)))
            ((and (pair? info) (eq? (car info) 'reg)) (cdr info))
            ((symbol? info) info)
            (else var))))))

(define (lir-inline-asm-lir-operand? x)
  (or (integer? x)
      (symbol? x)
      (and (pair? x) (memq (car x) '(%stack %mem %reg)))))

(define (lir-compile-inline-asm expr si env)
  (let* ((parsed (inline-asm-extract-clauses expr))
         (template (car parsed))
         (raw-outs (cadr parsed))
         (raw-ins (caddr parsed))
         (clobs (cadddr parsed))
         (volatile? (car (cddddr parsed)))
         (cur-si-box (cons si '()))
         (resolved-ins
          (map
           (lambda (in-entry)
             (let ((ni (inline-asm-normalize-in-entry in-entry)))
               (if (not ni)
                   in-entry
                   (let* ((nm (car ni))
                          (src (cadr ni))
                          (cstr (caddr ni))
                          (final-src
                           (cond
                             ((symbol? src)
                              (lir-inline-asm-resolve-var src env))
                             ((lir-inline-asm-lir-operand? src)
                              src)
                             (else
                              (let ((slot (car cur-si-box)))
                                (set-car! cur-si-box (- slot 8))
                                (track-lir-si! slot)
                                (lir-compile-expr src slot env #f)
                                (emit-lir! (list '%mov (list '%stack slot) '%rax))
                                (list '%stack slot))))))
                     (if nm
                         (list nm cstr final-src)
                         (list final-src cstr))))))
           raw-ins))
         (resolved-outs
          (map
           (lambda (out-entry)
             (let ((no (inline-asm-normalize-out-entry out-entry)))
               (if (not no)
                   out-entry
                   (let* ((nm (car no))
                          (dst (cadr no))
                          (cstr (caddr no))
                          (final-dst
                           (if (symbol? dst)
                               (lir-inline-asm-resolve-var dst env)
                               dst)))
                     (if nm
                         (list nm cstr final-dst)
                         (list final-dst cstr))))))
           raw-outs))
         (lir-inst
          (list '%inline-asm template
                (list ':outputs resolved-outs)
                (list ':inputs resolved-ins)
                (list ':clobbers clobs)
                (list ':volatile? volatile?))))
    (emit-lir! lir-inst)
    (if (pair? resolved-outs)
        (let* ((no0 (inline-asm-normalize-out-entry (car resolved-outs)))
               (dst0 (and no0 (cadr no0))))
          (cond
            ((or (and (pair? dst0) (eq? (car dst0) '%stack))
                 (and (pair? dst0) (eq? (car dst0) '%mem)))
             (emit-lir! (list '%mov '%rax dst0)))
            ((and (pair? dst0) (eq? (car dst0) '%reg))
             (if (not (eq? (inline-asm-normalize-reg-sym (cadr dst0)) '%rax))
                 (emit-lir! (list '%mov '%rax (cadr dst0)))))
            ((and (symbol? dst0)
                  (let ((nr (inline-asm-normalize-reg-sym dst0)))
                    (and nr (not (eq? nr '%rax)))))
             (emit-lir! (list '%mov '%rax dst0))))))))

(define (lir-body-uses-symbol? target expr)
  (cond
    ((eq? expr target) #t)
    ((not (pair? expr)) #f)
    ((eq? (car expr) 'quote) #f)
    (else
     (or (lir-body-uses-symbol? target (car expr))
         (lir-body-uses-symbol? target (cdr expr))))))

;;; Compile a single lifted %function to LIR representation
(define (lir-compile-function fn-raw)
  (let* ((fn (if (ast-has-span? fn-raw) (ast-strip-span fn-raw) fn-raw))
         (label (cadr fn))
         (params (caddr fn))
         (body (cadddr fn))
         (num-params (length params))
         (num-reg-params (if (< num-params 6) num-params 6))
         (initial-raw-vars (if (unboxed-fn? label) params '()))
         (uses-self? (lir-body-uses-symbol? '%self body))
         (uses-num-args? (lir-body-uses-symbol? '%num-args body)))
    (set-current-toplevel-name! label)
    (with-call-frame label fn
      (lambda ()
        (reset-lir!)
        (let ((loc-info (lookup-function-source-loc label)))
          (if (and (debug-symbols-enabled?) loc-info)
              (let* ((file (car loc-info))
                     (line (cadr loc-info))
                     (col (caddr loc-info))
                     (fid (register-source-file! file)))
                (emit-lir! (list '%loc fid line col)))))
        ;; Build callee env:
        ;; %self at [rsp - 8] (only spilled & rooted when body references %self)
        ;; %num-args at [rsp - 16] (only spilled when body references %num-args)
        ;; params 0..5 in registers spilled to [rsp - 24 - 8*i]
        ;; params 6+ at [rsp + 8 * (num-params - i)]
        (let* ((self-env (if uses-self?
                             (list (cons '%self (cons 'self -8)))
                             '()))
               (param-env
                (let loop ((ps params) (i 0) (acc '()))
                  (if (null? ps) acc
                      (if (< i 6)
                          (let ((slot (- -24 (* 8 i))))
                            (loop (cdr ps) (+ i 1)
                                  (cons (cons (car ps) slot) acc)))
                          (let ((offset (* 8 (- num-params i))))
                            (loop (cdr ps) (+ i 1)
                                  (cons (cons (car ps) (cons 'param offset)) acc)))))))
               (callee-env (cons (cons '%num-params num-params)
                                 (cons (cons '%raw-vars initial-raw-vars)
                                       (cons (cons '%stack-vars '())
                                             (append self-env param-env)))))
               (callee-si (- -24 (* 8 num-reg-params))))
          (track-lir-si! -8)
          (track-lir-si! -16)
          ;; Track spilled parameter slots
          (let loop ((i 0))
            (if (< i num-reg-params)
                (begin
                  (track-lir-si! (- -24 (* 8 i)))
                  (loop (+ i 1)))))
          (track-lir-si! callee-si)
          (if uses-self?
              (emit-lir! '(%store %rsp -8 %r10)))
          (if uses-num-args?
              (emit-lir! '(%store %rsp -16 %rax)))
          (let ((loop-head-lbl (unique-label-sym (string-append "L_loop_head_" (if (symbol? label) (symbol->string label) "fn") "_"))))
            (emit-lir! (list '%label loop-head-lbl))
            ;; Store incoming argument registers into their callee stack slots
            (let loop ((i 0))
              (if (< i num-reg-params)
                  (begin
                    (emit-lir! (list '%store '%rsp (- -24 (* 8 i)) (list-ref *arg-registers* i)))
                    (loop (+ i 1)))))
            (let ((callee-env-with-self (cons (cons '%current-func label)
                                              (cons (cons '%self-loop-head loop-head-lbl)
                                                    callee-env))))
              (lir-compile-expr body callee-si callee-env-with-self #t)))
          (emit-lir! '(%return))
          (let* ((needed-frame (- 0 (car *lir-min-si*)))
                 (frame-size (align-frame-shift needed-frame))
                 (insts (reverse (car *lir-instructions*))))
            (list '%lir-function
                  label
                  (list 'params params)
                  (list 'frame-size frame-size)
                  (cons 'body insts))))))))

;;; Pass 6 Entrypoint: Transforms Pass 5 %program AST into %lir-program
(define (generate-lir prog-raw)
  (let* ((prog (if (ast-has-span? prog-raw) (ast-strip-span prog-raw) prog-raw)))
    (reset-safepoints!)
    (reset-symbol-table!)
    (let ((funcs (cadr prog))
          (main-expr (caddr prog)))
      (set-current-toplevel-name! '%main)
      (reset-lir!)
      (let ((main-loc (lookup-function-source-loc '%main)))
        (if (and (debug-symbols-enabled?) main-loc)
            (let* ((file (car main-loc))
                   (line (cadr main-loc))
                   (col (caddr main-loc))
                   (fid (register-source-file! file)))
              (emit-lir! (list '%loc fid line col)))))
      (track-lir-si! -8)
      (lir-compile-expr main-expr -8 (list (cons '%raw-vars '()) (cons '%stack-vars '())) #f)
      (emit-lir! '(%return))
      (let* ((main-insts (reverse (car *lir-instructions*)))
             (main-frame (align-frame-shift (- 0 (car *lir-min-si*))))
             (lir-main (list '%lir-main
                             (list 'frame-size main-frame)
                             (cons 'body main-insts)))
             (lir-funcs (map lir-compile-function funcs))
             (safepoints (reverse (car *lir-safepoints*))))
        (list '%lir-program
              (list 'strings (car *strings*))
              (list 'stackmaps safepoints)
              (cons '%lir-functions lir-funcs)
              lir-main)))))

