;;; Pass 130 Bridge: Lowering L-Residual-ANF to LIR (DSN-33-03 §6.2 & Issue #889)
;;; -----------------------------------------------------------------------

(define (residual-normalize-func def)
  (cond
    ((not (pair? def)) def)
    ((eq? (car def) '%function) def)
    ;; (define (name p ...) body ...)
    ((and (eq? (car def) 'define) (pair? (cdr def)) (pair? (cadr def)))
     (let* ((sig (cadr def))
            (name (car sig))
            (params (cdr sig))
            (body-forms (cddr def))
            (body (if (= (length body-forms) 1) (car body-forms) (cons 'begin body-forms))))
       (list '%function name params body)))
    ;; (define name (lambda (p ...) body ...))
    ((and (eq? (car def) 'define) (pair? (cdr def)) (symbol? (cadr def))
          (pair? (cddr def)) (pair? (caddr def)) (eq? (caaddr def) 'lambda))
     (let* ((name (cadr def))
            (lam (caddr def))
            (params (cadr lam))
            (lbody-forms (cddr lam))
            (lbody (if (= (length lbody-forms) 1) (car lbody-forms) (cons 'begin lbody-forms))))
       (list '%function name params lbody)))
    (else def)))

(define (lower-residual-anf-to-lir residual-ast)
  (cond
    ((null? residual-ast) '())
    ((and (pair? residual-ast) (eq? (car residual-ast) '%program))
     (let ((funcs (map residual-normalize-func (cadr residual-ast)))
           (main (caddr residual-ast)))
       (generate-lir (list '%program funcs main))))
    (else
     (generate-lir (list '%program '() residual-ast)))))

(define (lower-residual-anf-to-lir-insts expr)
  (reset-lir!)
  (track-lir-si! -8)
  (lir-compile-expr expr -8 (list (cons '%raw-vars '()) (cons '%stack-vars '())) #f)
  (reverse (car *lir-instructions*)))
