#!/usr/bin/env gosh
;;; =======================================================================
;;; ulisp-cogen: Direct Cogen Driver & Standalone Compiler CLI Generator
;;; Conforms to DSN-33-04 §4.1, DSN-33-03 §3, Issue #895 & #909
;;; Zero external dependencies. Zero shell execution.
;;; =======================================================================

(use srfi-9)
(use file.util)
(use gauche.process)

;; Resolve paths relative to ulisp root robustly
(define *ulisp-root*
  (cond
    ((file-exists? "workbench/frame.scm") ".")
    ((file-exists? "ulisp/workbench/frame.scm") "ulisp")
    (else
     (let* ((cmd (car (command-line)))
            (abs-cmd (sys-normalize-pathname cmd :absolute #t :canonicalize #t))
            (s-dir (sys-dirname abs-cmd)))
       (sys-dirname s-dir)))))

;; Add ulisp-root to load-path dynamically
(set! *load-path* (cons *ulisp-root* *load-path*))

;; Load workbench modules
(load "workbench/frame.scm")
(load "workbench/value_tagging.scm")
(load "workbench/nan_boxing.scm")
(load "workbench/cogen.scm")

(define (string-starts-with? s prefix)
  (let ((slen (string-length s))
        (plen (string-length prefix)))
    (if (< slen plen)
        #f
        (let loop ((i 0))
          (if (= i plen)
              #t
              (if (char=? (string-ref s i) (string-ref prefix i))
                  (loop (+ i 1))
                  #f))))))

(define (print-usage)
  (print "Usage: ulisp-cogen --interpreter <interp.scm> --grammar <grammar.peg> --output <bin/cli>")
  (print "")
  (print "Options:")
  (print "  --interpreter <path>       Guest interpreter definition (Scheme)")
  (print "  --grammar <path>           Guest PEG grammar definition (.peg)")
  (print "  --output <path>            Output executable standalone compiler CLI path")
  (print "  --runtime-model <model>    Runtime model: 'tagging' (default) or 'nanbox'")
  (print "  --entry-rule <rule>        PEG entry rule symbol (default: 'entry')")
  (print "  --opt-level <level>        Optimization level: O0, O1, O2 (default), O3")
  (print "  -h, --help                 Show this help message"))

(define (parse-args args)
  (let loop ((rem args)
             (interp #f)
             (grammar #f)
             (output #f)
             (model 'tagging)
             (entry 'entry)
             (opt 'O2))
    (cond
      ((null? rem)
       (values interp grammar output model entry opt))
      ((or (string=? (car rem) "-h") (string=? (car rem) "--help"))
       (print-usage)
       (exit 0))
      ((and (string=? (car rem) "--interpreter") (pair? (cdr rem)))
       (loop (cddr rem) (cadr rem) grammar output model entry opt))
      ((string-starts-with? (car rem) "--interpreter=")
       (loop (cdr rem) (substring (car rem) 14 (string-length (car rem))) grammar output model entry opt))
      ((and (string=? (car rem) "--grammar") (pair? (cdr rem)))
       (loop (cddr rem) interp (cadr rem) output model entry opt))
      ((string-starts-with? (car rem) "--grammar=")
       (loop (cdr rem) interp (substring (car rem) 10 (string-length (car rem))) output model entry opt))
      ((or (and (string=? (car rem) "--output") (pair? (cdr rem)))
           (and (string=? (car rem) "-o") (pair? (cdr rem))))
       (loop (cddr rem) interp grammar (cadr rem) model entry opt))
      ((string-starts-with? (car rem) "--output=")
       (loop (cdr rem) interp grammar (substring (car rem) 9 (string-length (car rem))) model entry opt))
      ((and (string=? (car rem) "--runtime-model") (pair? (cdr rem)))
       (let ((m (string->symbol (cadr rem))))
         (if (memq m '(tagging nanbox))
             (loop (cddr rem) interp grammar output m entry opt)
             (error "ulisp-cogen: invalid --runtime-model, must be 'tagging' or 'nanbox'" (cadr rem)))))
      ((string-starts-with? (car rem) "--runtime-model=")
       (let ((m (string->symbol (substring (car rem) 16 (string-length (car rem))))))
         (if (memq m '(tagging nanbox))
             (loop (cdr rem) interp grammar output m entry opt)
             (error "ulisp-cogen: invalid --runtime-model, must be 'tagging' or 'nanbox'" m))))
      ((and (string=? (car rem) "--entry-rule") (pair? (cdr rem)))
       (loop (cddr rem) interp grammar output model (string->symbol (cadr rem)) opt))
      ((string-starts-with? (car rem) "--entry-rule=")
       (loop (cdr rem) interp grammar output model (string->symbol (substring (car rem) 13 (string-length (car rem)))) opt))
      ((and (string=? (car rem) "--opt-level") (pair? (cdr rem)))
       (loop (cddr rem) interp grammar output model entry (string->symbol (cadr rem))))
      (else
       (error "ulisp-cogen: unknown argument" (car rem))))))

(define (main args)
  (receive (interp-path grammar-path output-path runtime-model entry-rule opt-level)
      (parse-args (cdr args))
    (unless (and interp-path grammar-path output-path)
      (print "Error: missing mandatory arguments.")
      (print-usage)
      (exit 1))
    ;; Unified Cogen execution
    (run-cogen-cli interp-path grammar-path output-path runtime-model entry-rule opt-level)
    (exit 0)))
