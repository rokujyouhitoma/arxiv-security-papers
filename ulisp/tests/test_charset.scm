;;; =======================================================================
;;; ULisp R7RS-large Red Edition: SRFI 14 (scheme charset) Test Suite
;;; Conforms to DSN-33 Architecture Specification & Issue #708
;;; =======================================================================

(define *test-count* (cons 0 '()))

(define (assert-equal label expected actual)
  (set-car! *test-count* (+ (car *test-count*) 1))
  (if (equal? expected actual)
      (begin
        (display "  [PASS] ")
        (display label)
        (newline)
        (flush-output-port))
      (begin
        (display "  [FAIL] ")
        (display label)
        (display " | expected: ")
        (write expected)
        (display " | actual: ")
        (write actual)
        (newline)
        (flush-output-port)
        (exit 1))))

(display "=============================================================\n")
(display " Starting SRFI 14 (scheme charset) Test Suite\n")
(display "=============================================================\n")

(display "--- 1. Predicates, Constructors & Queries ---\n")
(let ((cs1 (char-set #\a #\b #\c #\a))
      (cs2 (string->char-set "cba"))
      (cs3 (list->char-set '(#\a #\b))))
  (assert-equal "char-set? on char-set" #t (char-set? cs1))
  (assert-equal "char-set? on string" #f (char-set? "abc"))
  (assert-equal "char-set-size deduplicates" 3 (char-set-size cs1))
  (assert-equal "char-set= cs1 cs2" #t (char-set= cs1 cs2))
  (assert-equal "char-set<= cs3 cs1" #t (char-set<= cs3 cs1))
  (assert-equal "char-set<= cs1 cs3" #f (char-set<= cs1 cs3))
  (assert-equal "char-set-contains? a" #t (char-set-contains? cs1 #\a))
  (assert-equal "char-set-contains? z" #f (char-set-contains? cs1 #\z))
  (assert-equal "char-set->list ordered" '(#\a #\b #\c) (char-set->list cs1))
  (assert-equal "char-set->string" "abc" (char-set->string cs1))
  (assert-equal "char-set-hash equal for equal sets" #t (= (char-set-hash cs1) (char-set-hash cs2))))

(display "--- 2. Cursors, Fold, Map, Filter & Unfold ---\n")
(let* ((cs (string->char-set "12345"))
       (cur0 (char-set-cursor cs))
       (c0 (char-set-ref cs cur0))
       (cur1 (char-set-cursor-next cs cur0))
       (c1 (char-set-ref cs cur1))
       (folded (char-set-fold (lambda (ch acc) (+ acc 1)) 0 cs))
       (filtered (char-set-filter (lambda (ch) (char>=? ch #\3)) cs))
       (mapped (char-set-map (lambda (ch) (integer->char (+ (char->integer ch) 1))) (string->char-set "abc")))
       (unfolded (char-set-unfold (lambda (n) (> n 3))
                                  (lambda (n) (integer->char (+ 64 n)))
                                  (lambda (n) (+ n 1))
                                  1)))
  (assert-equal "cursor first char" #\1 c0)
  (assert-equal "cursor second char" #\2 c1)
  (assert-equal "char-set-fold count" 5 folded)
  (assert-equal "char-set-filter >= 3" "345" (char-set->string filtered))
  (assert-equal "char-set-map shift +1" "bcd" (char-set->string mapped))
  (assert-equal "char-set-unfold ABC" "ABC" (char-set->string unfolded)))

(display "--- 3. Set Algebra (Union, Intersection, Difference, Xor, Complement) ---\n")
(let* ((a (string->char-set "abcd"))
       (b (string->char-set "cdef"))
       (u (char-set-union a b))
       (inter (char-set-intersection a b))
       (diff (char-set-difference a b))
       (x (char-set-xor a b))
       (adj (char-set-adjoin a #\z))
       (del (char-set-delete a #\b #\d)))
  (assert-equal "char-set-union" "abcdef" (char-set->string u))
  (assert-equal "char-set-intersection" "cd" (char-set->string inter))
  (assert-equal "char-set-difference" "ab" (char-set->string diff))
  (assert-equal "char-set-xor" "abef" (char-set->string x))
  (assert-equal "char-set-adjoin" "abcdz" (char-set->string adj))
  (assert-equal "char-set-delete" "ac" (char-set->string del))
  (assert-equal "char-set-complement size" 252 (char-set-size (char-set-complement a)))
  (call-with-values
    (lambda () (char-set-diff+intersection a b))
    (lambda (d i)
      (assert-equal "diff+intersection diff" "ab" (char-set->string d))
      (assert-equal "diff+intersection inter" "cd" (char-set->string i)))))

(display "--- 4. Standard Predefined Character Sets ---\n")
(assert-equal "char-set:empty size" 0 (char-set-size char-set:empty))
(assert-equal "char-set:full size" 256 (char-set-size char-set:full))
(assert-equal "char-set:ascii size" 128 (char-set-size char-set:ascii))
(assert-equal "char-set:lower-case size" 26 (char-set-size char-set:lower-case))
(assert-equal "char-set:upper-case size" 26 (char-set-size char-set:upper-case))
(assert-equal "char-set:letter size" 52 (char-set-size char-set:letter))
(assert-equal "char-set:digit size" 10 (char-set-size char-set:digit))
(assert-equal "char-set:letter+digit size" 62 (char-set-size char-set:letter+digit))
(assert-equal "char-set:hex-digit size" 22 (char-set-size char-set:hex-digit))
(assert-equal "char-set:whitespace contains space" #t (char-set-contains? char-set:whitespace #\space))
(assert-equal "char-set:blank size" 2 (char-set-size char-set:blank))

(display "=============================================================\n")
(display " All ")
(display (car *test-count*))
(display " SRFI 14 (scheme charset) Tests Passed Successfully!\n")
(display "=============================================================\n")

