;;; ULisp R7RS-large Red Edition: SRFI 117 (list-queue) & SRFI 127 (lseq) Tests
;;; Conforms to DSN-33 Architecture Specification & Issue #707
;;; =======================================================================

(define *test-count* (cons 0 '()))

(define (assert-equal label expected actual)
  (set-car! *test-count* (+ (car *test-count*) 1))
  (if (equal? expected actual)
      (begin
        (display "  [PASS] ")
        (display label)
        (newline)
        (flush-output-port))
      (begin
        (display "  [FAIL] ")
        (display label)
        (display " | expected: ")
        (write expected)
        (display " | actual: ")
        (write actual)
        (newline)
        (flush-output-port)
        (exit 1))))

(display "=============================================================\n")
(display " Starting SRFI 117 (list-queue) & SRFI 127 (lseq) Test Suite\n")
(display "=============================================================\n")

;; --- Part 1: SRFI 117 List Queues ---
(display "--- 1. SRFI 117 Constructors, Predicates & Accessors ---\n")
(let ((q0 (list-queue))
      (q1 (list-queue 10 20 30)))
  (assert-equal "list-queue? q0" #t (list-queue? q0))
  (assert-equal "list-queue-empty? q0" #t (list-queue-empty? q0))
  (assert-equal "list-queue-empty? q1" #f (list-queue-empty? q1))
  (assert-equal "list-queue-front q1" 10 (list-queue-front q1))
  (assert-equal "list-queue-back q1" 30 (list-queue-back q1))
  (assert-equal "list-queue-list q1" '(10 20 30) (list-queue-list q1)))

(display "--- 2. SRFI 117 Mutators & Copy ---\n")
(let* ((q (list-queue 2 3))
       (qc (list-queue-copy q)))
  (list-queue-add-front! q 1)
  (list-queue-add-back! q 4)
  (assert-equal "add-front! and add-back!" '(1 2 3 4) (list-queue-list q))
  (assert-equal "copy independent" '(2 3) (list-queue-list qc))
  (assert-equal "remove-front!" 1 (list-queue-remove-front! q))
  (assert-equal "remove-back!" 4 (list-queue-remove-back! q))
  (assert-equal "remaining list" '(2 3) (list-queue-list q))
  (assert-equal "remove-all!" '(2 3) (list-queue-remove-all! q))
  (assert-equal "empty after remove-all!" #t (list-queue-empty? q)))

(display "--- 3. SRFI 117 Unfold, Append & Mapping ---\n")
(let* ((qu (list-queue-unfold (lambda (x) (> x 4))
                              (lambda (x) (* x 10))
                              (lambda (x) (+ x 1))
                              1))
       (qur (list-queue-unfold-right (lambda (x) (> x 4))
                                     (lambda (x) (* x 10))
                                     (lambda (x) (+ x 1))
                                     1))
       (qa (list-queue-append (list-queue 1 2) (list-queue 3 4)))
       (qm (list-queue-map (lambda (x) (* x 2)) qa)))
  (assert-equal "list-queue-unfold" '(10 20 30 40) (list-queue-list qu))
  (assert-equal "list-queue-unfold-right" '(40 30 20 10) (list-queue-list qur))
  (assert-equal "list-queue-append" '(1 2 3 4) (list-queue-list qa))
  (assert-equal "list-queue-map" '(2 4 6 8) (list-queue-list qm))
  (list-queue-map! (lambda (x) (+ x 1)) qm)
  (assert-equal "list-queue-map!" '(3 5 7 9) (list-queue-list qm)))

;; --- Part 2: SRFI 127 Lazy Sequences (lseq) ---
(display "--- 4. SRFI 127 Constructors, Selectors & Memoization ---\n")
(define (make-counting-gen calls)
  (lambda ()
    (let ((n (car calls)))
      (if (>= n 4)
          (eof-object)
          (begin
            (%lseq-set-car! calls (+ n 1))
            (* (+ n 1) 10))))))

(let* ((calls (%lseq-cell 0 '()))
       (g (make-counting-gen calls))
       (ls (generator->lseq g)))
  (assert-equal "lseq? on lazy sequence" #t (lseq? ls))
  (assert-equal "generator called once on creation" 1 (car calls))
  (assert-equal "lseq-car" 10 (lseq-car ls))
  (assert-equal "lseq-ref 2" 30 (lseq-ref ls 2))
  (assert-equal "generator called 3 times after ref 2" 3 (car calls))
  (assert-equal "lseq-ref 2 again (memoized)" 30 (lseq-ref ls 2))
  (assert-equal "generator still called 3 times" 3 (car calls))
  (assert-equal "lseq-realize" '(10 20 30 40) (lseq-realize ls))
  (assert-equal "lseq-length" 4 (lseq-length ls)))

(display "--- 5. SRFI 127 Transformations & Searching ---\n")
(let* ((s1 (generator->lseq (list->generator '(1 2 3 4 5 6))))
       (s2 (lseq-map (lambda (x) (* x 10)) s1))
       (s3 (lseq-filter (lambda (x) (> x 25)) s2))
       (s4 (lseq-take s1 3))
       (s5 (lseq-drop s1 3)))
  (assert-equal "lseq-map realize" '(10 20 30 40 50 60) (lseq-realize s2))
  (assert-equal "lseq-filter realize" '(30 40 50 60) (lseq-realize s3))
  (assert-equal "lseq-take 3" '(1 2 3) (lseq-realize s4))
  (assert-equal "lseq-drop 3" '(4 5 6) (lseq-realize s5))
  (assert-equal "lseq-append" '(1 2 3 4 5 6) (lseq-realize (lseq-append s4 s5)))
  (assert-equal "lseq-zip" '((1 4) (2 5) (3 6)) (lseq-realize (lseq-zip s4 s5)))
  (assert-equal "lseq-find" 4 (lseq-find (lambda (x) (> x 3)) s1))
  (assert-equal "lseq-any" #t (lseq-any (lambda (x) (= x 5)) s1))
  (assert-equal "lseq-every" #t (lseq-every (lambda (x) (> x 0)) s1))
  (assert-equal "lseq-index" 2 (lseq-index (lambda (x) (= x 3)) s1))
  (assert-equal "lseq=?" #t (lseq=? (lambda (a b) (= a b)) s1 '(1 2 3 4 5 6))))

