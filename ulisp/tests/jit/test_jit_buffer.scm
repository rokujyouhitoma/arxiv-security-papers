;;; =======================================================================
;;; MLisp Test Suite: JIT Buffer & In-Memory Native x86 Emitter (test_jit_buffer.scm)
;;; Conforms to DSN-33, DSN-34 & Issue #901
;;;
;;; Verifies:
;;; - Group 1: LIR to GNU Intel-syntax assembly lines generation
;;; - Group 2: Pure Scheme in-memory direct assembly to machine code bytevector
;;; - Group 3: JIT Buffer W^X lifecycle (WRITABLE -> EXECUTABLE -> INVALIDATED)
;;; - Group 4: Native x86-64 machine code validity & opcode patterns
;;; - Group 5: OSR Bailout Adapter assembly & exit sentinel encoding
;;; - Group 6: End-to-end JIT pipeline (Trace -> Native Bytevector -> JIT Buffer -> Dispatch)
;;; =======================================================================

(test-begin "MLisp JIT Buffer & Native x86 Emitter")

;;; Reset JIT runtime
(jit-runtime-reset!)

;;; Sample trace for loop computation:
;;; sum = 0; i = 0; loop: sum += i; i += 1; if i < 100 goto loop
(define sample-loop-trace
  '(%trace-loop
     (%pc loop-test-x86)
     (%body
       ((%trace-loop-entry loop-test-x86)
        (%mov reg-sum 0)
        (%mov reg-i 0)
        (%add reg-sum reg-sum reg-i)
        (%add reg-i reg-i 1)
        (%guard cmp-lt reg-i 100 bailout-exit-42)
        (%trace-loop-jump loop-test-x86)))))

;;; =======================================================================
;;; Group 1: LIR to x86 Assembly Lines Generation
;;; =======================================================================
(display "--- Group 1: LIR to Assembly Lines ---")
(newline)

(let* ((asm-lines (trace->x86-asm-lines sample-loop-trace)))
  (assert-true "1.1 Result is a list of lines" (pair? asm-lines))
  (assert-true "1.2 Intel syntax directive present" (member "    .intel_syntax noprefix" asm-lines))
  (assert-true "1.3 Text section directive present" (member "    .text" asm-lines))
  (assert-true "1.4 Function entry label present" (member "jit_entry:" asm-lines))
  (assert-true "1.5 Ret instruction present" (member "    ret" asm-lines)))

;;; =======================================================================
;;; Group 2: Pure Scheme In-Memory Assembly to Bytevector
;;; =======================================================================
(display "--- Group 2: Direct Machine Code Assembly ---")
(newline)

(let* ((mcode-bv (trace->x86-machine-code sample-loop-trace)))
  (assert-true "2.1 Machine code result is bytevector" (bytevector? mcode-bv))
  (assert-true "2.2 Machine code length > 0" (> (bytevector-length mcode-bv) 0))
  (assert-true "2.3 Machine code bounded by max buffer size"
               (<= (bytevector-length mcode-bv) *max-jit-buffer-size*)))

;;; =======================================================================
;;; Group 3: JIT Buffer W^X Lifecycle Management
;;; =======================================================================
(display "--- Group 3: W^X Lifecycle Management ---")
(newline)

(let* ((lir-prog (trace->lir-program sample-loop-trace))
       (mcode-bv (trace->x86-machine-code sample-loop-trace))
       (buf (make-jit-buffer 'pc-wx-test lir-prog mcode-bv)))
  ;; Newly created buffer must be in WRITABLE state
  (assert-equal "3.1 Initial buffer status is WRITABLE"
                *JIT-BUFFER-STATUS-WRITABLE*
                (jit-buffer-status buf))
  (assert-equal "3.2 Buffer records correct code size"
                (bytevector-length mcode-bv)
                (jit-buffer-code-size buf))
  (assert-true "3.3 Buffer machine-code accessor returns bytevector"
               (bytevector? (jit-buffer-machine-code buf)))

  ;; Transition to EXECUTABLE (W^X enforcement)
  (jit-buffer-make-executable! buf)
  (assert-equal "3.4 Transitioned to EXECUTABLE"
                *JIT-BUFFER-STATUS-EXECUTABLE*
                (jit-buffer-status buf))

  ;; Invalidation
  (jit-buffer-invalidate! buf)
  (assert-equal "3.5 Transitioned to INVALIDATED"
                *JIT-BUFFER-STATUS-INVALIDATED*
                (jit-buffer-status buf)))

;;; =======================================================================
;;; Group 4: Native x86-64 Machine Code Validity & Opcode Patterns
;;; =======================================================================
(display "--- Group 4: Machine Code Byte Pattern Verification ---")
(newline)

(let* ((simple-trace
        '(%trace-loop
           (%pc loop-ret)
           (%body
             ((%trace-loop-entry loop-ret)
              (%mov reg-a 42)
              (%trace-loop-jump loop-ret)))))
       (mcode (trace->x86-machine-code simple-trace))
       (len (bytevector-length mcode)))
  ;; The generated bytevector contains valid x86-64 instructions (e.g. mov reg, imm; ret = 0xc3)
  (assert-true "4.1 Simple trace assembled bytevector exists" (bytevector? mcode))
  (assert-true "4.2 Assembled machine code contains at least ret instruction (0xc3)"
               (let loop ((i 0))
                 (if (= i len)
                     #f
                     (if (= (bytevector-u8-ref mcode i) #xc3)
                         #t
                         (loop (+ i 1)))))))

;;; =======================================================================
;;; Group 5: OSR Bailout Adapter Assembly & Exit Sentinel
;;; =======================================================================
(display "--- Group 5: OSR Bailout Adapter Verification ---")
(newline)

(let* ((bailout-trace
        '(%trace-loop
           (%pc loop-bailout-test)
           (%body
             ((%trace-loop-entry loop-bailout-test)
              (%mov reg-x 10)
              (%guard type-fixnum reg-x fixnum target-bailout-lbl)
              (%trace-loop-jump loop-bailout-test)))))
       (asm-lines (trace->x86-asm-lines bailout-trace))
       (mcode (trace->x86-machine-code bailout-trace)))
  ;; Assembly lines must contain the OSR exit sentinel (mov rax, 255)
  (assert-true "5.1 OSR bailout label present in assembly"
               (member "target-bailout-lbl:" asm-lines))
  (assert-true "5.2 OSR sentinel assignment present in assembly"
               (member "    mov rax, 255" asm-lines))
  (assert-true "5.3 Machine code successfully assembled for bailout trace"
               (bytevector? mcode)))

;;; =======================================================================
;;; Group 6: End-to-End JIT Pipeline (Trace -> Native Buffer -> Dispatch)
;;; =======================================================================
(display "--- Group 6: End-to-End JIT Dispatch ---")
(newline)

(let* ((pc 'loop-e2e-dispatch)
       (lir-prog (trace->lir-program sample-loop-trace))
       (text-bv (trace->x86-machine-code sample-loop-trace))
       (installed-buf (install-jit-machine-code! pc lir-prog text-bv)))
  (assert-true "6.1 JIT buffer successfully installed" (pair? installed-buf))
  (assert-equal "6.2 Installed buffer status is EXECUTABLE"
                *JIT-BUFFER-STATUS-EXECUTABLE*
                (jit-buffer-status installed-buf))

  ;; Lookup installed buffer
  (let ((lookup-res (lookup-jit-buffer pc)))
    (assert-true "6.3 Lookup succeeds for executable buffer" (pair? lookup-res))
    (assert-equal "6.4 Lookup returns correct PC" pc (jit-buffer-pc lookup-res)))

  ;; Dispatch JIT loop
  (let ((dispatch-res (dispatch-jit-loop pc '((reg-sum . 0) (reg-i . 0))))
        (native-res (dispatch-jit-native pc '((reg-sum . 0) (reg-i . 0)))))
    (assert-true "6.5 Dispatch returns execution descriptor" (pair? dispatch-res))
    (assert-equal "6.6 Execution descriptor tag is jit-executed"
                  'jit-executed
                  (car dispatch-res))
    (assert-equal "6.7 Execution recorded matching PC" pc (cadr dispatch-res))
    (assert-equal "6.8 Native dispatch tag is jit-executed-native"
                  'jit-executed-native
                  (car native-res))
    (assert-true "6.9 Global executed stats incremented" (>= *jit-stats-executed* 2))))

(display "\n[PASS] All JIT Buffer & Native x86 Emitter tests passed successfully!\n")
(test-end "MLisp JIT Buffer & Native x86 Emitter")
