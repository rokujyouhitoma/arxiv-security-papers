{
  "bind_host": "0.0.0.0",
  "bind_port": 8000,
  "timeout": 30.0,
  "graceful_timeout": 30.0,
  "pools": [
    {
      "name": "web",
      "workers": 2,
      "worker_class": "sync",
      "threads": 1,
      "bind_host": "0.0.0.0",
      "bind_port": 8000,
      "backlog": 2048,
      "target_uri": "web.server:app",
      "timeout": 30.0,
      "graceful_timeout": 30.0,
      "dependencies": ["database", "search"]
    }
  ],
  "services": [
    {
      "name": "search",
      "workers": 1,
      "hook_uri": "search.server.service:SearchLifecycleHook",
      "sync_interval": 2.0,
      "timeout": 30.0,
      "dependencies": []
    },
    {
      "name": "database",
      "workers": 3,
      "hook_uri": "database.service:DatabaseLifecycleHook",
      "sync_interval": 2.0,
      "timeout": 30.0,
      "dependencies": []
    }
  ]
}
